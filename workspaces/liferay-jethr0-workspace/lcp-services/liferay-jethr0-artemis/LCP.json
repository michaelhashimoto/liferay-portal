{
  "kind": "Deployment",
  "id": "artemis",
  "image": "apache/activemq-artemis:2.30.0-alpine",
  "loadBalancer": {
    "targetPort": 8161
  },
  "ports": [
    {
      "port": 61616,
      "targetPort": 61616,
      "protocol": "TCP"
    },
    {
      "port": 8161,
      "targetPort": 8161,
      "protocol": "TCP",
      "external": false
    }
  ],
  "livenessProbe": {
    "exec": {
      "command": [
        "ls"
      ]
    },
    "initialDelaySeconds": 60,
    "timeoutSeconds": 10,
    "failureThreshold": 12
  },
  "readinessProbe": {
    "exec": {
      "command": [
        "ls"
      ]
    },
    "initialDelaySeconds": 60,
    "timeoutSeconds": 10,
    "failureThreshold": 12
  },
  "memory": 512,
  "cpu": 0.5
}