definition {

	property workspace.client.extensions.includes = "liferay-sample-workspace";

	setUp {
		Portal.TestCase.setUpPortalInstance();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			Portal.PortalInstances.tearDownCP();
		}
		else {
			Portal.PagesAdmin.tearDownCP();

			Portal.Site.tearDownCP();

			Portal.WebContent.tearDownCP();
		}
	}

	@priority = 5
	test Smoke {
		property testray.main.component.name = "Liferay Sample Workspace";

		Portal.SignIn.signInTestSetup();
	}

}