			<var name="bookmarkFolderName" value="${bookmarkFolderName}" />
			<var name="bookmarkName" value="${bookmarkName1}" />
			<var name="bookmarkURL" value="${bookmarkURL1}" />
		</execute>

		<execute macro="Page#gotoPG">
			<var name="pageName" value="Bookmarks Page" />
