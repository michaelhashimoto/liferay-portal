<definition>
	<set-up>
        <execute macro="User#firstLoginPG" />
	</set-up>

	<tear-down>
		<execute macro="BlogsEntry#tearDownCP" />

		<execute macro="BookmarksFolder#tearDownCP" />

		<execute macro="DMDocument#tearDownCP" />

		<execute macro="Event#tearDownCP" />

		<execute macro="MessageboardsCategory#tearDownCP" />

		<execute macro="WikiPage#tearDownCP" />

        <execute macro="Page#tearDownPG" />
    </tear-down>

	<command name="MarketplaceSmoke6120" priority="5">
		<var name="bookmarkFolderName" value="Bookmarks Folder Name" />
		<var name="bookmarkFolderDescription" value="Booksmarks Folder Description" />
		<var name="bookmarkDescription1" value="Bookmark1 Description" />
		<var name="bookmarkDescription2" value="Bookmark2 Description" />
		<var name="bookmarkDescription3" value="Bookmark3 Description" />
