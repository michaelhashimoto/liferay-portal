			<var name="bookmarkFolderName" value="${bookmarkFolderName}" />
			<var name="bookmarkName" value="${bookmarkName3}" />
			<var name="bookmarkURL" value="${bookmarkURL3}" />
		</execute>

		<execute macro="Page#gotoPG">
