			<var name="dmDocumentFile" value="${dmDocumentFile3}" />
			<var name="dmDocumentSize" value="${dmDocumentSize3}" />
			<var name="dmDocumentTitle" value="${dmDocumentTitle3}" />
			<var name="dmFolderName" value="${dmFolderName1}" />
