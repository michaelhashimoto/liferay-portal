			<var name="dmDocumentSize" value="${dmDocumentSize2}" />
			<var name="dmDocumentTitle" value="${dmDocumentTitle2}" />
			<var name="dmFolderName" value="${dmFolderName1}" />
		</execute>

		<execute macro="DMDocument#addPG">
