			<var name="dmDocumentSize" value="${dmDocumentSize1}" />
			<var name="dmDocumentTitle" value="${dmDocumentTitle1}" />
			<var name="dmDocumentDescription" value="${dmDocumentDescription1}" />
		</execute>

		<execute macro="Page#gotoPG">
