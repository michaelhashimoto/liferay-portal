<html>
<head>
<title>CPTags</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">CPTags</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>CPTags</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>SUCCESS_MESSAGE</td>
	<td>//div[@class='lfr-message-response alert alert-success']</td>
	<td></td>
</tr>
<tr>
	<td>CHECK_ALL_TAGS</td>
	<td>//input[@id='_99_checkAllTagsCheckbox']</td>
	<td></td>
</tr>
<tr>
	<td>ACTIONS</td>
	<td>//a[contains(text(),'Actions')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_TAG</td>
	<td>//a[contains(text(),'Add Tag')]</td>
	<td></td>
</tr>
<tr>
	<td>INFO_MESSAGE</td>
	<td>//div[@id='tagsMessages']</td>
	<td></td>
</tr>
<tr>
	<td>CONFIRMATION</td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--TAG_DETAILS-->
<tr>
	<td>TAG_DETAILS_HEADER</td>
	<td>//h3[@class='header-title']/span</td>
	<td></td>
</tr>
<tr>
	<td>TAG_DETAILS_EDIT</td>
	<td>//button[contains(text(),'Edit')]</td>
	<td></td>
</tr>
<tr>
	<td>TAG_DETAILS_DELETE</td>
	<td>//button[contains(text(),'Delete')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ADD_TAG-->
<tr>
	<td>ADD_TAG_NAME_FIELD</td>
	<td>//input[@id='_99_name']</td>
	<td></td>
</tr>
<tr>
	<td>ADD_TAG_SAVE</td>
	<td>//button[contains(text(),'Save')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--EDIT_TAG-->
<tr>
	<td>EDIT_TAG_NAME</td>
	<td>//input[@id='_99_name']</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_TAG_SAVE</td>
	<td>//button[contains(text(),'Save')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ENTRY_TAG-->
<tr>
	<td>ENTRY_TAG_1</td>
	<td>//div[3]/div/div/div/div/ul/li/a/span</td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_TAG_2</td>
	<td>//div[3]/div/div/div/div/ul/li[2]/a/span</td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_TAG_3</td>
	<td>//div[3]/div/div/div/div/ul/li[3]/a/span</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ACTION-->
<tr>
	<td>ACTION_DELETE</td>
	<td>//ul[@class='dropdown-menu']/li/a[contains(.,'Delete')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>