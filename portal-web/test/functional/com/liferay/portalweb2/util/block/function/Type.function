<definition>
	<command name="clickAtSendKeys">
		<execute selenium="waitForVisible" />

		<execute argument2="" selenium="type" />

		<execute selenium="clickAt" />

		<execute selenium="sendKeys" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>

	<command name="sendKeys">
		<execute selenium="waitForVisible" />

		<execute selenium="sendKeys" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>

	<command name="sendKeysAceEditor">
		<execute selenium="waitForElementPresent" />

		<execute selenium="mouseOver" />

		<execute selenium="sendKeysAceEditor" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>

	<command name="sendKeysAceEditorNoMouseOver">
		<execute selenium="waitForElementPresent" />

		<execute selenium="sendKeysAceEditor" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>

	<command name="sendKeysApplicationSearch">
		<execute argument1="//script[contains(@src,'/aui/aui-live-search/aui-live-search-min.js')]" selenium="waitForElementPresent" />

		<execute function="Type#sendKeys" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>

	<command name="sikuliType">
		<execute selenium="sikuliType" />

		<execute argument1="2000" selenium="pause" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>

	<command name="type">
		<execute selenium="waitForVisible" />

		<execute selenium="type" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>

	<command name="typeAceEditor">
		<execute selenium="waitForElementPresent" />

		<execute selenium="mouseOver" />

		<execute selenium="typeAceEditor" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>

	<command name="typeAceEditorNoMouseOver">
		<execute selenium="waitForElementPresent" />

		<execute selenium="typeAceEditor" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>

	<command name="typeFrame">
		<execute selenium="waitForVisible" />

		<execute selenium="typeFrame" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>

	<command name="typeFrameWaitForCKEditor">
		<execute selenium="waitForVisible" />

		<execute argument1="//a[@class='cke_button_cut cke_disabled']" selenium="waitForVisible" />

		<execute selenium="typeFrame" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>

	<command name="typeWaitForNotValueNull">
		<execute selenium="waitForNotValue" />

		<execute function="Type#type" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>
</definition>