<definition>
	<command name="selectFrame">
		<execute selenium="waitForVisible" />

		<execute selenium="selectFrame" />
	</command>

	<command name="selectFrameTop">
		<execute argument1="relative=top" selenium="selectFrame" />
	</command>

	<command name="selectFrameWaitForScript">
		<execute function="SelectFrame#selectFrame" />

		<execute argument1="//script[contains(@src,'/liferay/navigation_interaction.js')]" selenium="waitForElementPresent" />
	</command>
</definition>