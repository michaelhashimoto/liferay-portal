@component-name = "portal-smoke"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Smoke";

	setUp {
		User.firstLoginPG();
	}

	@priority = "5"
	test Smoke {
		property portal.acceptance = "true";
		property portal.smoke = "true";

		Smoke.runSmoke();
	}

	tearDown {
		Page.tearDownPG();
	}
}