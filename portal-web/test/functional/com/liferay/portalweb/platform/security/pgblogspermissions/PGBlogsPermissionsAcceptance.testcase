@component-name = "portal-security"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Security";
	var pageName = "Blogs Page";
	var portletName = "Blogs";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");
	}

	@priority = "5"
	test Guest_ViewPortletBlogsPermissionsNoTest {
		Page.gotoPG(pageName = "${pageName}");

		BlogsEntry.viewPortletPG();

		User.logoutPG();

		Page.gotoPG(pageName = "${pageName}");

		BlogsEntry.viewPortletPGasGuest();
	}

	tearDown {
		User.firstLoginPG();

		Page.tearDownPG();
	}
}