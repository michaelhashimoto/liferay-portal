@component-name = "portal-security"
definition {
	property hook.plugins.includes = "antisamy-hook";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Security";
	var pageName = "Antisamy Test Page";
	var portletName = "Wiki";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");
	}

	@priority = "5"
	test AddWikiFrontPageContentJavascript {

		var wikiPageContent = '''
<p id='demo'>PASS</p>

<script type='text/javascript'>
	document.getElementById('demo').innerHTML = 'FAIL';
</script>
''';
		var wikiPageText = "PASS";

		Page.gotoPG(pageName = "${pageName}");

		WikiPage.addFrontPagePGHTMLSource(
			wikiPageContent = "${wikiPageContent}",
			wikiPageText = "${wikiPageText}"
		);
	}

	tearDown {
		WikiNode.tearDownCP();

		WikiPage.tearDownCP();

		Page.tearDownPG();
	}
}