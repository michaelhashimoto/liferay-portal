definition {
	macro blogsEntryPG {
		Type(locator1 = "PGSearch#SEARCH_FIELD", value1 = "${entryTitle}");

		Click.clickAt(locator1 = "PGSearch#SEARCH_ICON");

		AssertTextEquals(
			locator1 = "PGSearchResults#ASSET_ENTRY_TABLE_TITLE_1",
			value1 = "${entryTitle}"
		);

		AssertTextEquals(
			locator1 = "PGSearchResults#ASSET_ENTRY_TABLE_TYPE_1",
			value1 = "Blogs Entry"
		);

		AssertTextEquals(
			locator1 = "PGSearchResults#ASSET_ENTRY_TABLE_SUMMARY_1",
			value1 = "${entryContent}"
		);

		AssertTextEquals(
			locator1 = "PGSearchResults#SEARCH_RESULTS",
			value1 = "Showing 1 - 1."
		);
	}

	macro messageboardsThreadPG {
		Type(locator1 = "PGSearch#SEARCH_FIELD", value1 = "${threadSubject}");

		Click.clickAt(locator1 = "PGSearch#SEARCH_ICON");

		AssertTextEquals(
			locator1 = "PGSearchResults#ASSET_ENTRY_TABLE_TITLE_1",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGSearchResults#ASSET_ENTRY_TABLE_TYPE_1",
			value1 = "Message Boards Message"
		);

		AssertTextEquals(
			locator1 = "PGSearchResults#ASSET_ENTRY_TABLE_SUMMARY_1",
			value1 = "${threadBody}"
		);

		AssertTextEquals(
			locator1 = "PGSearchResults#SEARCH_RESULTS",
			value1 = "Showing 1 - 1."
		);
	}

	macro userPG {
		Type(locator1 = "PGSearch#SEARCH_FIELD", value1 = "users*");

		Click.clickAt(locator1 = "PGSearch#SEARCH_ICON");

		AssertTextEquals(
			locator1 = "PGSearchResults#ASSET_ENTRY_TABLE_TITLE_1",
			value1 = "${userFirstName} ${userLastName}"
		);

		AssertTextEquals(
			locator1 = "PGSearchResults#ASSET_ENTRY_TABLE_TYPE_1",
			value1 = "User"
		);

		AssertTextEquals(
			locator1 = "PGSearchResults#SEARCH_RESULTS",
			value1 = "Showing 1 - 1."
		);

		Type(locator1 = "PGSearchResults#SEARCH_FIELD", value1 = "userf*");

		Click.clickAt(locator1 = "PGSearchResults#SEARCH_ICON");

		AssertTextEquals(
			locator1 = "PGSearchResults#ASSET_ENTRY_TABLE_TITLE_1",
			value1 = "${userFirstName} ${userLastName}"
		);

		AssertTextEquals(
			locator1 = "PGSearchResults#ASSET_ENTRY_TABLE_TYPE_1",
			value1 = "User"
		);

		AssertTextEquals(
			locator1 = "PGSearchResults#SEARCH_RESULTS",
			value1 = "Showing 1 - 1."
		);
	}

	macro wikiPagePG {
		Type(locator1 = "PGSearch#SEARCH_FIELD", value1 = "${wikiPageTitle}");

		Click.clickAt(locator1 = "PGSearch#SEARCH_ICON");

		AssertTextEquals(
			locator1 = "PGSearchResults#ASSET_ENTRY_TABLE_TITLE_1",
			value1 = "${wikiPageTitle}"
		);

		AssertTextEquals(
			locator1 = "PGSearchResults#ASSET_ENTRY_TABLE_TYPE_1",
			value1 = "Wiki Page"
		);

		AssertTextEquals(
			locator1 = "PGSearchResults#ASSET_ENTRY_TABLE_SUMMARY_1",
			value1 = "${wikiPageContent}"
		);

		AssertTextEquals(
			locator1 = "PGSearchResults#SEARCH_RESULTS",
			value1 = "Showing 1 - 1."
		);
	}
}