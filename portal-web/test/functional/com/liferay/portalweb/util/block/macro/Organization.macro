<definition>
	<var name="orgName" value="Organization*" />

	<command name="addCP">
		<execute action="CPUsersandorganizations#assertClick" locator1="ADD" value1="Add" />
		<execute action="CPUsersandorganizations#assertClick" locator1="ADD_REGULAR_ORGANIZATION" value1="Regular Organization" />

		<execute action="CPUsersandorganizationsAddorganization#type" locator1="DETAILS_NAME_FIELD" value1="${orgName}" />
		<execute action="CPUsersandorganizationsAddorganization#select" locator1="DETAILS_TYPE_SELECT" value1="${orgType}" />
		<execute action="CPUsersandorganizationsAddorganization#assertClick" locator1="SAVE_BUTTON" value1="Save" />

		<execute action="CPUsersandorganizationsOrganizationEdit#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="CPUsersandorganizationsOrganizationEdit#assertTextEquals" locator1="DETAILS_NAME_FIELD" value1="${orgName}" />
		<execute action="CPUsersandorganizationsOrganizationEdit#assertTextEquals" locator1="DETAILS_TYPE" value1="Type ${orgType}" />
	</command>

	<command name="addMemberCP">
		<execute action="CPUsersandorganizations#type" locator1="SEARCH_FIELD" value1="${orgName}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="SEARCH_BUTTON" value1="Search" />
		<execute action="CPUsersandorganizations#assertTextEquals" locator1="ORGANIZATION_TABLE_NAME_1" value1="${orgName}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="ORGANIZATION_TABLE_ACTIONS_1" value1="Actions" />
		<execute action="CPUsersandorganizations#assertClick" locator1="ORGANIZATION_MENULIST_ASSIGN_USERS" value1="Assign Users" />

		<execute action="CPUsersandorganizationsAssignmembers#assertClick" locator1="AVAILABLE" value1="Available" />
		<execute macro="CPUsersandorganizationsAssignmembers#showBasicSearch" />
		<execute action="CPUsersandorganizationsAssignmembers#type" locator1="BASIC_SEARCH_FIELD" value1="${userScreenName}" />
		<execute action="CPUsersandorganizationsAssignmembers#assertClick" locator1="BASIC_SEARCH_BUTTON" value1="Search" />
		<execute action="CPUsersandorganizationsAssignmembers#assertTextEquals" locator1="USER_TABLE_SCREEN_NAME_1" value1="${userScreenName}" />
		<execute action="CPUsersandorganizationsAssignmembers#check" locator1="USER_TABLE_CHECKBOX_1" />
		<execute action="CPUsersandorganizationsAssignmembers#assertClick" locator1="UPDATE_ASSOCIATIONS_BUTTON" value1="Update Associations" />
		<execute action="CPUsersandorganizationsAssignmembers#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<execute action="CPUsersandorganizationsAssignmembers#assertClick" locator1="CURRENT" value1="Current" />
		<execute action="CPUsersandorganizationsAssignmembers#assertChecked" locator1="USER_TABLE_CHECKBOX_1" />
		<execute action="CPUsersandorganizationsAssignmembers#assertTextEquals" locator1="USER_TABLE_USER_NAME_1" value1="${userFirstName} ${userLastName}" />
		<execute action="CPUsersandorganizationsAssignmembers#assertTextEquals" locator1="USER_TABLE_SCREEN_NAME_1" value1="${userScreenName}" />
	</command>

	<command name="addSiteCP">
		<execute action="CPUsersandorganizations#type" locator1="SEARCH_FIELD" value1="${orgName}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="SEARCH_BUTTON" value1="Search" />
		<execute action="CPUsersandorganizations#assertTextEquals" locator1="ORGANIZATION_TABLE_NAME_1" value1="${orgName}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="ORGANIZATION_TABLE_ACTIONS_1" value1="Actions" />
		<execute action="CPUsersandorganizations#assertClick" locator1="ORGANIZATION_MENULIST_EDIT" value1="Edit" />

		<execute action="CPUsersandorganizationsOrganizationEdit#assertClick" locator1="ORGANIZATION_INFORMATION_ORGANIZATION_SITE" value1="Organization Site" />
		<execute action="CPUsersandorganizationsOrganizationEdit#check" locator1="ORGANIZATION_SITE_CREATE_SITE_CHECKBOX" />
		<execute action="CPUsersandorganizationsOrganizationEdit#assertClick" locator1="SAVE_BUTTON" value1="Save" />
		<execute action="CPUsersandorganizationsOrganizationEdit#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="CPUsersandorganizationsOrganizationEdit#assertChecked" locator1="ORGANIZATION_SITE_CREATE_SITE_CHECKBOX" />
	</command>

	<command name="assignOrgRoleCP">
		<execute action="CPUsersandorganizations#type" locator1="SEARCH_FIELD" value1="${orgName}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="SEARCH_BUTTON" value1="Search" />
		<execute action="CPUsersandorganizations#assertTextEquals" locator1="ORGANIZATION_TABLE_NAME_1" value1="${orgName}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="ORGANIZATION_TABLE_ACTIONS_1" value1="Actions" />
		<execute action="CPUsersandorganizations#assertClick" locator1="ORGANIZATION_MENULIST_ASSIGN_ORGANIZATION_ROLES" value1="Assign Organization Roles" />

		<execute function="#assertTextEquals" locator1="//tr[contains(.,'${roleName}')]/td[1]/a" value1="${roleName}" />
		<execute function="#click" locator1="//tr[contains(.,'${roleName}')]/td[1]/a" value1="${roleName}" />

		<execute action="CPUsersandorganizationsAssignuserrolesUser#assertClick" locator1="AVAILABLE" value1="Available" />
		<execute action="CPUsersandorganizationsAssignuserrolesUser#type" locator1="BASIC_SEARCH_FIELD" value1="${userScreenName}" />
		<execute action="CPUsersandorganizationsAssignuserrolesUser#assertClick" locator1="BASIC_SEARCH_BUTTON" value1="Search" />
		<execute action="CPUsersandorganizationsAssignuserrolesUser#assertTextEquals" locator1="USER_TABLE_SCREEN_NAME_1" value1="${userScreenName}" />
		<execute action="CPUsersandorganizationsAssignuserrolesUser#check" locator1="USER_TABLE_CHECKBOX_1" />
		<execute action="CPUsersandorganizationsAssignuserrolesUser#assertClick" locator1="UPDATE_ASSOCIATIONS_BUTTON" value1="Update Associations" />
		<execute action="CPUsersandorganizationsAssignuserrolesUser#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<execute action="CPUsersandorganizationsAssignuserrolesUser#assertClick" locator1="CURRENT" value1="Current" />
		<execute action="CPUsersandorganizationsAssignuserrolesUser#assertChecked" locator1="USER_TABLE_CHECKBOX_1" />
		<execute action="CPUsersandorganizationsAssignuserrolesUser#assertTextEquals" locator1="USER_TABLE_USER_NAME_1" value1="${userFirstName} ${userLastName}" />
		<execute action="CPUsersandorganizationsAssignuserrolesUser#assertTextEquals" locator1="USER_TABLE_SCREEN_NAME_1" value1="${userScreenName}" />
	</command>

	<command name="deleteCP">
		<execute action="CPUsersandorganizations#type" locator1="SEARCH_FIELD" value1="${orgName}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="SEARCH_BUTTON" value1="Search" />
		<execute action="CPUsersandorganizations#assertClick" locator1="ORGANIZATION_TABLE_ACTIONS_1" value1="Actions" />

		<execute action="CPUsersandorganizations#assertClickNoError" locator1="ORGANIZATION_MENULIST_DELETE" value1="Delete" />
		<execute action="CPUsersandorganizations#confirm" locator1="CONFIRMATION" value1="Are you sure you want to delete this?" />
		<execute action="CPUsersandorganizations#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="CPUsersandorganizations#assertTextNotPresent" value1="${orgName}" />
	</command>

	<command name="isPresent">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Users and Organizations" />
		</execute>

		<execute action="CPUsersandorganizations#type" locator1="SEARCH_FIELD" value1="${orgName}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="SEARCH_BUTTON" value1="Search" />
		<execute action="CPUsersandorganizations#isElementPresent" locator1="ORGANIZATION_TABLE_NAME_1" />
	</command>

	<command name="removeMemberCP">
		<execute action="CPUsersandorganizations#type" locator1="SEARCH_FIELD" value1="${orgName}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="SEARCH_BUTTON" value1="Search" />
		<execute action="CPUsersandorganizations#assertTextEquals" locator1="ORGANIZATION_TABLE_NAME_1" value1="${orgName}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="ORGANIZATION_TABLE_ACTIONS_1" value1="Actions" />
		<execute action="CPUsersandorganizations#assertClick" locator1="ORGANIZATION_MENULIST_ASSIGN_USERS" value1="Assign Users" />

		<execute action="CPUsersandorganizationsAssignmembers#assertClick" locator1="AVAILABLE" value1="Available" />
		<execute macro="CPUsersandorganizationsAssignmembers#showBasicSearch" />
		<execute action="CPUsersandorganizationsAssignmembers#type" locator1="BASIC_SEARCH_FIELD" value1="${userScreenName}" />
		<execute action="CPUsersandorganizationsAssignmembers#assertClick" locator1="BASIC_SEARCH_BUTTON" value1="Search" />
		<execute action="CPUsersandorganizationsAssignmembers#assertTextEquals" locator1="USER_TABLE_SCREEN_NAME_1" value1="${userScreenName}" />
		<execute action="CPUsersandorganizationsAssignmembers#uncheck" locator1="USER_TABLE_CHECKBOX_1" />
		<execute action="CPUsersandorganizationsAssignmembers#assertClick" locator1="UPDATE_ASSOCIATIONS_BUTTON" value1="Update Associations" />
		<execute action="CPUsersandorganizationsAssignmembers#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="CPUsersandorganizationsAssignmembers#assertNotChecked" locator1="USER_TABLE_CHECKBOX_1" />
	</command>

	<command name="tearDownCP">
		<while>
			<condition macro="Organization#isPresent" />
			<then>
				<execute action="CPUsersandorganizations#click" locator1="ORGANIZATION_TABLE_NAME_1" />

				<execute action="CPUsersandorganizationsOrganization#assertClick" locator1="MENU_ASSIGN_USERS" value1="Assign Users" />

				<execute action="CPUsersandorganizationsAssignmembers#assertClick" locator1="CURRENT" value1="Current" />

				<if>
					<condition action="CPUsersandorganizationsAssignmembers#isElementPresent" locator1="USER_TABLE_ALL_CHECKBOX" />
					<then>
						<execute action="CPUsersandorganizationsAssignmembers#click" locator1="USER_TABLE_ALL_CHECKBOX" />
						<execute action="CPUsersandorganizationsAssignmembers#assertClick" locator1="UPDATE_ASSOCIATIONS_BUTTON" value1="Update Associations" />
						<execute action="CPUsersandorganizationsAssignmembers#assertTextEquals" locator1="INFO_MESSAGE" value1="No users were found." />
					</then>
				</if>

				<execute action="CPUsersandorganizationsAssignmembers#assertClick" locator1="BACK" value1="Back" />

				<execute action="CPUsersandorganizationsOrganization#assertClickNoError" locator1="MENU_DELETE" value1="Delete" />
				<execute action="CPUsersandorganizationsOrganization#confirm" locator1="CONFIRMATION" value1="Are you sure you want to delete this?" />
			</then>
		</while>
	</command>

	<command name="viewAssignMemberCP">
		<execute action="CPUsersandorganizations#type" locator1="SEARCH_FIELD" value1="${searchToken}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="SEARCH_BUTTON" value1="Search" />
		<execute action="CPUsersandorganizations#assertTextEquals" locator1="ORGANIZATION_TABLE_NAME_1" value1="${orgName}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="ORGANIZATION_TABLE_NAME_1" value1="${orgName}" />

		<execute action="CPUsersandorganizationsOrganization#assertTextEquals" locator1="USER_TABLE_FIRST_NAME_1" value1="${userFirstName}" />
		<execute action="CPUsersandorganizationsOrganization#assertTextEquals" locator1="USER_TABLE_LAST_NAME_1" value1="${userLastName}" />
		<execute action="CPUsersandorganizationsOrganization#assertTextEquals" locator1="USER_TABLE_SCREEN_NAME_1" value1="${userScreenName}" />
	</command>

	<command name="viewCP">
		<execute action="CPUsersandorganizations#type" locator1="SEARCH_FIELD" value1="${searchToken}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="SEARCH_BUTTON" value1="Search" />
		<execute action="CPUsersandorganizations#assertTextEquals" locator1="ORGANIZATION_TABLE_NAME_1" value1="${orgName}" />
		<execute action="CPUsersandorganizations#assertTextEquals" locator1="ORGANIZATION_TABLE_TYPE_1" value1="${orgType}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="ORGANIZATION_TABLE_ACTIONS_1" value1="Actions" />
		<execute action="CPUsersandorganizations#assertClick" locator1="ORGANIZATION_MENULIST_EDIT" value1="Edit" />

		<execute action="CPUsersandorganizationsOrganizationEdit#assertTextEquals" locator1="TITLE" value1="${orgName}" />
		<execute action="CPUsersandorganizationsOrganizationEdit#assertTextEquals" locator1="DETAILS_NAME_FIELD" value1="${orgName}" />
		<execute action="CPUsersandorganizationsOrganizationEdit#assertTextEquals" locator1="DETAILS_TYPE" value1="Type ${orgType}" />
		<execute action="CPUsersandorganizationsOrganizationEdit#assertTextEquals" locator1="ORGANIZATION_NAME" value1="${orgName}" />
	</command>

	<command name="viewRemoveMemberCP">
		<execute action="CPUsersandorganizations#type" locator1="SEARCH_FIELD" value1="${orgName}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="SEARCH_BUTTON" value1="Search" />
		<execute action="CPUsersandorganizations#assertTextEquals" locator1="ORGANIZATION_TABLE_NAME_1" value1="${orgName}" />
		<execute action="CPUsersandorganizations#assertClick" locator1="ORGANIZATION_TABLE_NAME_1" value1="${orgName}" />
		<execute action="CPUsersandorganizationsOrganization#assertTextNotPresent" value1="${userFirstName}" />
	</command>
</definition>