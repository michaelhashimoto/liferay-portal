@default = "assertElementNotPresent"
@summary = "Assert that '${locator1}' is not available"
definition {
	function assertElementNotPresent {
		selenium.waitForElementNotPresent();

		selenium.assertElementNotPresent();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertNotVisible {
		selenium.waitForNotVisible();

		selenium.assertNotVisible();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}
}