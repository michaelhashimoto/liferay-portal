definition {
	macro configureShowAllPG {
		Page.gotoPG(pageName = "${pageName}");

		Click.pauseClickAt(locator1 = "PGDocumentlibrarydisplay#OPTIONS_WRENCH_ICON");

		AssertClick.assertTextClickAt(
			locator1 = "PGDocumentlibrarydisplay#OPTIONS_MENULIST_CONFIGURATION",
			value1 = "Configuration"
		);

		SelectFrame.selectFrameWaitForScript(
			locator1 = "PGDocumentlibrarydisplayConfiguration#CONFIGURATION_IFRAME"
		);

		Check.clickAtConfiguration(
			locator1 = "PGDocumentlibrarydisplayConfiguration#SETUP_DISPLAY_SETTINGS_SHOW_ACTIONS_CHECKBOX"
		);

		Check.clickAtConfiguration(
			locator1 = "PGDocumentlibrarydisplayConfiguration#SETUP_DISPLAY_SETTINGS_SHOW_FOLDER_MENU_CHECKBOX"
		);

		Check.clickAtConfiguration(
			locator1 = "PGDocumentlibrarydisplayConfiguration#SETUP_DISPLAY_SETTINGS_SHOW_NAVIGATION_LINKS_CHECKBOX"
		);

		Check.clickAtConfiguration(
			locator1 = "PGDocumentlibrarydisplayConfiguration#SETUP_DISPLAY_SETTINGS_SHOW_SEARCH_CHECKBOX"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGDocumentlibrarydisplayAddfolder#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplayConfiguration#SUCCESS_MESSAGE",
			value1 = "You have successfully updated the setup."
		);

		AssertChecked(
			locator1 = "PGDocumentlibrarydisplayConfiguration#SETUP_DISPLAY_SETTINGS_SHOW_ACTIONS_CHECKBOX"
		);

		AssertChecked(
			locator1 = "PGDocumentlibrarydisplayConfiguration#SETUP_DISPLAY_SETTINGS_SHOW_FOLDER_MENU_CHECKBOX"
		);

		AssertChecked(
			locator1 = "PGDocumentlibrarydisplayConfiguration#SETUP_DISPLAY_SETTINGS_SHOW_NAVIGATION_LINKS_CHECKBOX"
		);

		AssertChecked(
			locator1 = "PGDocumentlibrarydisplayConfiguration#SETUP_DISPLAY_SETTINGS_SHOW_SEARCH_CHECKBOX"
		);

		SelectFrame();
	}
}