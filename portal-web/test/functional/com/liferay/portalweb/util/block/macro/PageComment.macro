definition {
	macro addPG {
		AssertClick(
			locator1 = "PGPageComments#BE_THE_FIRST_LINK",
			value1 = "Be the first."
		);

		Type(locator1 = "PGPageComments#COMMENT_FIELD", value1 = "${commentBody}");

		AssertClick(locator1 = "PGPageComments#REPLY_BUTTON", value1 = "Reply");

		var key_commentBody = "${commentBody}";

		AssertTextEquals(
			locator1 = "PGPageComments#SUCCESS_MESSAGE",
			value1 = "Your request processed successfully."
		);

		AssertTextEquals(
			locator1 = "PGPageComments#COMMENT_BODY",
			value1 = "${commentBody}"
		);

		AssertTextEquals(
			locator1 = "PGPageComments#COMMENT_USERNAME",
			value1 = "${commentUsername}"
		);
	}

	macro addPGWithWorkflow {
		AssertClick(
			locator1 = "PGPageComments#BE_THE_FIRST_LINK",
			value1 = "Be the first."
		);

		Type(locator1 = "PGPageComments#COMMENT_FIELD", value1 = "${commentBody}");

		AssertClick.assertValueClickAt(
			locator1 = "PGPageComments#SUBMIT_FOR_PUBLICATION_BUTTON",
			value1 = "Submit for Publication"
		);

		var key_commentBody = "${commentBody}";

		AssertTextEquals(
			locator1 = "PGPageComments#SUCCESS_MESSAGE",
			value1 = "Your request processed successfully."
		);

		AssertTextEquals(
			locator1 = "PGPageComments#COMMENT_WORKFLOW_STATUS",
			value1 = "Pending (Review)"
		);

		AssertTextEquals(
			locator1 = "PGPageComments#COMMENT_BODY",
			value1 = "${commentBody}"
		);

		AssertTextEquals(
			locator1 = "PGPageComments#COMMENT_USERNAME",
			value1 = "${commentUsername}"
		);
	}

	macro tearDownPG {
		Page.gotoPG(pageName = "${pageName}");

		while (IsElementPresent(locator1 = "PGPageComments#COMMENT_DELETE_GENERIC")) {
			ClickNoError(locator1 = "PGPageComments#COMMENT_DELETE_GENERIC");

			Confirm(value1 = "Are you sure you want to delete this?");

			AssertTextEquals(
				locator1 = "PGPageComments#SUCCESS_MESSAGE",
				value1 = "Your request processed successfully."
			);

			AssertTextEquals(
				locator1 = "PGPageComments#BE_THE_FIRST_LINK",
				value1 = "Be the first."
			);
		}
	}

	macro viewPG {
		var key_commentBody = "${commentBody}";

		AssertElementNotPresent(locator1 = "PGPageComments#COMMENT_WORKFLOW_STATUS");

		AssertTextEquals(
			locator1 = "PGPageComments#COMMENT_BODY",
			value1 = "${commentBody}"
		);

		AssertTextEquals(
			locator1 = "PGPageComments#COMMENT_USERNAME",
			value1 = "${commentUsername}"
		);
	}

	macro viewPGWithWorkflow {
		var key_commentBody = "${commentBody}";

		AssertTextEquals(
			locator1 = "PGPageComments#COMMENT_WORKFLOW_STATUS",
			value1 = "${commentStatus}"
		);

		AssertTextEquals(
			locator1 = "PGPageComments#COMMENT_BODY",
			value1 = "${commentBody}"
		);

		AssertTextEquals(
			locator1 = "PGPageComments#COMMENT_USERNAME",
			value1 = "${commentUsername}"
		);
	}
}