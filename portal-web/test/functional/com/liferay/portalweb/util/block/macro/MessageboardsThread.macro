definition {
	var userName = "Test Test";

	macro addInCategoryPG {
		var key_categoryName = "${categoryName}";

		AssertClick(
			locator1 = "PGMessageboards#CATEGORY_TABLE_CATEGORY",
			value1 = "${categoryName}"
		);

		MessageboardsThread.addPG(
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}"
		);
	}

	macro addPG {
		AssertClick.assertValueClickAt(
			locator1 = "PGMessageboards#POST_NEW_THREAD_BUTTON",
			value1 = "Post New Thread"
		);

		if (isSet(number)) {
			var number = "${number}";

			Type(
				locator1 = "PGMessageboardsPostthread#SUBJECT_FIELD",
				value1 = "${threadSubject}${number}"
			);

			SelectFrame(locator1 = "PGMessageboardsPostthread#BODY_FIELD");

			Type.typeCKEditor(
				locator1 = "PGMessageboardsPostthread#BODY_FIELD",
				value1 = "${threadBody}${number}"
			);
		}
		else {
			Type(
				locator1 = "PGMessageboardsPostthread#SUBJECT_FIELD",
				value1 = "${threadSubject}"
			);

			Type.typeCKEditor(
				locator1 = "PGMessageboardsPostthread#BODY_FIELD",
				value1 = "${threadBody}"
			);
		}

		AssertClick.assertValueClickAt(
			locator1 = "PGMessageboardsPostthread#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals(
			locator1 = "PGMessageboards#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro addPGWithWorkflow {
		AssertClick.assertValueClickAt(
			locator1 = "PGMessageboards#POST_NEW_THREAD_BUTTON",
			value1 = "Post New Thread"
		);

		Type(
			locator1 = "PGMessageboardsPostthread#SUBJECT_FIELD",
			value1 = "${threadSubject}"
		);

		Type.typeCKEditor(
			locator1 = "PGMessageboardsPostthread#BODY_FIELD",
			value1 = "${threadBody}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGMessageboardsPostthread#SUBMIT_FOR_PUBLICATION_BUTTON",
			value1 = "Submit for Publication"
		);

		AssertTextEquals(
			locator1 = "PGMessageboards#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#TITLE_HEADER",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_USERNAME_1",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_SUBJECT_1",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_WORKFLOW_STATUS_1",
			value1 = "Pending (Review)"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_BODY_1",
			value1 = "${threadBody}"
		);
	}

	macro deletePG {
		var key_threadSubject = "${threadSubject}";

		AssertTextEquals(
			locator1 = "PGMessageboards#THREAD_TABLE_THREAD",
			value1 = "${threadSubject}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "PGMessageboards#THREAD_TABLE_ACTIONS",
			value1 = "Actions"
		);

		AssertClickNoError(
			locator1 = "PGMessageboards#THREAD_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextEquals(
			locator1 = "PGMessageboards#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextNotPresent(value1 = "${threadSubject}");
	}

	macro editPG {
		var key_threadSubject = "${threadSubject}";

		AssertTextEquals(
			locator1 = "PGMessageboards#THREAD_TABLE_THREAD",
			value1 = "${threadSubject}"
		);

		AssertClick(
			locator1 = "PGMessageboards#THREAD_TABLE_THREAD",
			value1 = "${threadSubject}"
		);

		AssertClick(locator1 = "PGMessageboardsThread#MESSAGE_EDIT_1", value1 = "Edit");

		Type(
			locator1 = "PGMessageboardsPostthread#SUBJECT_FIELD",
			value1 = "${threadSubjectEdit}"
		);

		Type.typeCKEditor(
			locator1 = "PGMessageboardsPostthread#BODY_FIELD",
			value1 = "${threadBodyEdit}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGMessageboardsPostthread#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#TITLE_HEADER",
			value1 = "${threadSubjectEdit}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_SUBJECT_1",
			value1 = "${threadSubjectEdit}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_BODY_1",
			value1 = "${threadBodyEdit}"
		);
	}

	macro replyPG {
		var key_threadSubject = "${threadSubject}";

		AssertTextEquals(
			locator1 = "PGMessageboards#THREAD_TABLE_THREAD",
			value1 = "${threadSubject}"
		);

		AssertClick(
			locator1 = "PGMessageboards#THREAD_TABLE_THREAD",
			value1 = "${threadSubject}"
		);

		AssertClick(
			locator1 = "PGMessageboardsThread#MESSAGE_REPLY_1",
			value1 = "Reply"
		);

		Type.typeCKEditor(
			locator1 = "PGMessageboardsPostthread#BODY_FIELD",
			value1 = "${threadReplyBody}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGMessageboardsPostthread#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals(
			locator1 = "PGMessageboards#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Message Boards");

		if (IsElementPresent.isVisible(locator1 = "CPMessageboards#THREAD_TABLE_ALL_CHECKBOX")) {
			Click(locator1 = "CPMessageboards#THREAD_TABLE_ALL_CHECKBOX");

			AssertClickNoError(
				locator1 = "CPMessageboards#THREADS_DELETE_BUTTON",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete this?");
		}
	}

	macro tearDownPG {
		Page.gotoPG(pageName = "${pageName}");

		while (IsElementPresent(locator1 = "PGMessageboards#THREAD_TABLE_ACTIONS_GENERIC")) {
			AssertClick.pauseAssertTextClickAt(
				locator1 = "PGMessageboards#THREAD_TABLE_ACTIONS_GENERIC",
				value1 = "Actions"
			);

			AssertClickNoError(
				locator1 = "PGMessageboards#THREAD_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete this?");
		}

		AssertClick.assertTextClickAt(
			locator1 = "PGMessageboards#NAVIGATION_MY_POSTS",
			value1 = "My Posts"
		);

		while (IsElementPresent(locator1 = "PGMessageboardsMyposts#THREAD_TABLE_ACTIONS_GENERIC")) {
			AssertClick(
				locator1 = "PGMessageboardsMyposts#THREAD_TABLE_ACTIONS_GENERIC",
				value1 = "Actions"
			);

			AssertClickNoError(
				locator1 = "PGMessageboardsMyposts#THREAD_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete this?");
		}
	}

	macro viewInCategoryPG {
		var key_categoryName = "${categoryName}";

		AssertClick(
			locator1 = "PGMessageboards#CATEGORY_TABLE_CATEGORY",
			value1 = "${categoryName}"
		);

		MessageboardsThread.viewPG(
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}"
		);
	}

	macro viewPG {
		var key_threadSubject = "${threadSubject}";

		AssertTextEquals(
			locator1 = "PGMessageboards#THREAD_TABLE_THREAD",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboards#THREAD_TABLE_STARTED_BY",
			value1 = "${userName}"
		);

		AssertTextEquals(locator1 = "PGMessageboards#THREAD_TABLE_POSTS", value1 = "1");

		AssertTextEquals.assertPartialText(
			locator1 = "PGMessageboards#THREAD_TABLE_LAST_POST",
			value1 = "By: ${userName}"
		);

		AssertClick(
			locator1 = "PGMessageboards#THREAD_TABLE_THREAD",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#TITLE_HEADER",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_USERNAME_1",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_SUBJECT_1",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_BODY_1",
			value1 = "${threadBody}"
		);

		AssertElementNotPresent(
			locator1 = "PGMessageboardsThread#MESSAGE_WORKFLOW_STATUS_1"
		);
	}

	macro viewPGWithWorkflow {
		var key_threadSubject = "${threadSubject}";

		AssertElementNotPresent(locator1 = "PGMessageboards#THREAD_TABLE_THREAD");

		AssertElementNotPresent(locator1 = "PGMessageboards#THREAD_TABLE_STARTED_BY");

		AssertElementNotPresent(locator1 = "PGMessageboards#THREAD_TABLE_POSTS");

		AssertElementNotPresent(locator1 = "PGMessageboards#THREAD_TABLE_LAST_POST");

		AssertClick.assertTextClickAt(
			locator1 = "PGMessageboards#NAVIGATION_MY_POSTS",
			value1 = "My Posts"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsMyposts#THREAD_TABLE_THREAD",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsMyposts#THREAD_TABLE_STATUS",
			value1 = "Pending"
		);

		AssertClick.assertTextClickAt(
			locator1 = "PGMessageboardsMyposts#THREAD_TABLE_THREAD",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#TITLE_HEADER",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_USERNAME_1",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_SUBJECT_1",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_WORKFLOW_STATUS_1",
			value1 = "Pending (${workflowTask})"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_BODY_1",
			value1 = "${threadBody}"
		);
	}

	macro viewReplyPG {
		var key_threadSubject = "${threadSubject}";

		AssertTextEquals(
			locator1 = "PGMessageboards#THREAD_TABLE_THREAD",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboards#THREAD_TABLE_STARTED_BY",
			value1 = "${userName}"
		);

		AssertTextEquals(locator1 = "PGMessageboards#THREAD_TABLE_POSTS", value1 = "2");

		AssertTextEquals.assertPartialText(
			locator1 = "PGMessageboards#THREAD_TABLE_LAST_POST",
			value1 = "By: ${userName}"
		);

		AssertClick(
			locator1 = "PGMessageboards#THREAD_TABLE_THREAD",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#THREAD_TABLE_SUBJECT_1",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#THREAD_TABLE_SUBJECT_2",
			value1 = "RE: ${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_SUBJECT_1",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_BODY_1",
			value1 = "${threadBody}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_USERNAME_1",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_RATING_1",
			value1 = "0 (0 Votes)"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_SUBJECT_2",
			value1 = "RE: ${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_BODY_2",
			value1 = "${threadReplyBody}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_USERNAME_2",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_RATING_2",
			value1 = "0 (0 Votes)"
		);
	}
}