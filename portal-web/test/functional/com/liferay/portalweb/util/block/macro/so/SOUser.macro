definition {
	var password = "test";
	var userEmailAddress = "test@liferay.com";

	macro addUserWithSORole {
		SOUserBar.gotoCP(portletName = "Users and Organizations");

		User.addCP(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUserBar.gotoCP(portletName = "Roles");

		Role.assignRegRoleCP(
			roleName = "Social Office",
			userScreenName = "${userScreenName}"
		);

		SOUser.editPasswordCP(
			userEmailAddress = "${userEmailAddress}",
			userScreenName = "${userScreenName}"
		);
	}

	macro editPasswordCP {
		SOUserBar.gotoCP(portletName = "Users and Organizations");

		AssertClick.assertTextClickAt(
			locator1 = "CPUsersandorganizations#SEARCH_ALL_USERS",
			value1 = "Search All Users"
		);

		CPUsersandorganizationsViewusers.showBasicSearch();

		Type(
			locator1 = "CPUsersandorganizationsViewusers#BASIC_SEARCH_FIELD",
			value1 = "${userScreenName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPUsersandorganizationsViewusers#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsViewusers#USER_TABLE_SCREEN_NAME_1",
			value1 = "${userScreenName}"
		);

		Click(
			locator1 = "CPUsersandorganizationsViewusers#USER_TABLE_SCREEN_NAME_1",
			value1 = "${userScreenName}"
		);

		Click(locator1 = "CPUsersandorganizationsUser#PASSWORD");

		Type(
			locator1 = "CPUsersandorganizationsUser#PASSWORD_NEW_PASSWORD_FIELD",
			value1 = "password"
		);

		Type(
			locator1 = "CPUsersandorganizationsUser#PASSWORD_ENTER_AGAIN_FIELD",
			value1 = "password"
		);

		Click(locator1 = "CPUsersandorganizationsUser#SAVE_BUTTON");

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsUser#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "password", userEmailAddress = "${userEmailAddress}");

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "test@liferay.com");
	}

	macro firstLoginPG {
		if (IsElementPresent(locator1 = "SOUserBar#USER_NAME")) {
			if (IsTextNotEqual(locator1 = "SOUserBar#USER_NAME", value1 = "Joe Bloggs")) {
				SOUser.logoutPG();

				SOUser.loginPG(password = "test", userEmailAddress = "test@liferay.com");
			}
		}
		else if (IsElementPresent(locator1 = "Dockbar#USER_NAME")) {
			if (IsTextNotEqual(locator1 = "Dockbar#USER_NAME", value1 = "Joe Bloggs")) {
				User.logoutPG();

				SOUser.loginPG(password = "test", userEmailAddress = "test@liferay.com");
			}
		}
		else {
			SOUser.loginPG(password = "test", userEmailAddress = "test@liferay.com");
		}

		if (IsElementNotPresent(locator1 = "SOUserBar#USER_NAME")) {
			Page.gotoCP(portletName = "Roles");

			Role.assignRegRoleCP(roleName = "Social Office", userScreenName = "joebloggs");

			SOUserBar.dashboardPG(userName = "Joe Bloggs");

			AssertTextEquals(
				locator1 = "SODashboard#NAVIGATION_DASHBOARD",
				value1 = "Dashboard"
			);

			AssertTextEquals(
				locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
				value1 = "Contacts Center"
			);

			AssertTextEquals(
				locator1 = "SODashboard#NAVIGATION_MY_DOCUMENTS",
				value1 = "My Documents"
			);

			AssertTextEquals(
				locator1 = "SODashboard#NAVIGATION_MICROBLOGS",
				value1 = "Microblogs"
			);

			AssertTextEquals(
				locator1 = "SODashboard#NAVIGATION_MESSAGES",
				value1 = "Messages"
			);

			AssertTextEquals(locator1 = "SODashboard#NAVIGATION_TASKS", value1 = "Tasks");
		}
	}

	macro loginPG {
		Type(locator1 = "PGLogin#EMAIL_ADDRESS_FIELD", value1 = "${userEmailAddress}");

		Type(locator1 = "PGLogin#PASSWORD_FIELD", value1 = "${password}");

		Click(locator1 = "PGLogin#REMEMBER_ME_CHECKBOX");

		AssertClick.assertValueClickAt(
			locator1 = "PGLogin#SIGN_IN_BUTTON",
			value1 = "Sign In"
		);

		if (IsElementPresent(locator1 = "PGLoginNewpassword#PASSWORD_FIELD")) {
			Type(locator1 = "PGLoginNewpassword#PASSWORD_FIELD", value1 = "test");

			Type(locator1 = "PGLoginNewpassword#ENTER_AGAIN_FIELD", value1 = "test");

			AssertClick.assertValueClickAt(
				locator1 = "PGLoginNewpassword#SAVE_BUTTON",
				value1 = "Save"
			);
		}

		if (IsElementPresent(locator1 = "PGLoginPasswordreminder#ANSWER_FIELD")) {
			Type(locator1 = "PGLoginPasswordreminder#ANSWER_FIELD", value1 = "test");

			AssertClick.assertValueClickAt(
				locator1 = "PGLoginPasswordreminder#SAVE_BUTTON",
				value1 = "Save"
			);
		}
	}

	macro logoutPG {
		if (IsElementPresent(locator1 = "SOUserBar#USER_NAME")) {
			Click(locator1 = "SOUserBar#USER_NAME");

			AssertClick.assertTextClickAt(
				locator1 = "SOUserBar#USER_MENU_SIGN_OUT",
				value1 = "Sign Out"
			);
		}
	}

	macro tearDownCP {
		var userFirstName = "social*";

		SOUser.firstLoginPG();

		SOUserBar.gotoCP(portletName = "Users and Organizations");

		User.deactivateCP(userFirstName = "${userFirstName}");

		SOUserBar.gotoCP(portletName = "Users and Organizations");

		User.deleteCP(userFirstName = "${userFirstName}");
	}
}