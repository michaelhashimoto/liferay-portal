definition {
	macro addCP {
		Page.gotoCP(portletName = "Categories");

		AssertClick(
			locator1 = "CPCategories#VOCABULARY_ENTRY_2",
			value1 = "${vocabularyName}"
		);

		AssertClick(
			locator1 = "CPCategories#VOCABULARY_CATEGORY_1",
			value1 = "${categoryName}"
		);

		AssertClick(
			locator1 = "CPCategories#CATEGORY_DETAILS_ADD_SUBCATEGORY_BUTTON",
			value1 = "Add Subcategory"
		);

		Type(
			locator1 = "CPCategories#ADD_SUBCATEGORY_NAME_FIELD",
			value1 = "${subcategoryName}"
		);

		AssertClick(
			locator1 = "CPCategories#ADD_SUBCATEGORY_SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals.assertTextNoWaitForText(
			locator1 = "CPCategories#SUCCESS_MESSAGE",
			value1 = "Your request processed successfully."
		);

		Click(locator1 = "CPCategories#CATEGORY_DETAILS_DROPDOWN_TREE");

		Click(locator1 = "CPCategories#SUBCATEGORY_CHECKBOX");

		AssertTextEquals(
			locator1 = "CPCategories#SUBCATEGORY_DETAILS_HEADER",
			value1 = "${subcategoryName}"
		);

		AssertElementPresent(
			locator1 = "CPCategories#SUBCATEGORY_DETAILS_EDIT_BUTTON",
			value1 = "Edit"
		);

		AssertElementPresent(
			locator1 = "CPCategories#SUBCATEGORY_DETAILS_DELETE_BUTTON",
			value1 = "Delete"
		);

		AssertElementPresent(
			locator1 = "CPCategories#SUBCATEGORY_DETAILS_ADD_SUBCATEGORY_BUTTON",
			value1 = "Add Subcategory"
		);
	}

	macro deleteCPByActions {
		Page.gotoCP(portletName = "Categories");

		AssertClick(
			locator1 = "CPCategories#VOCABULARY_ENTRY_2",
			value1 = "${vocabularyName}"
		);

		AssertClick(
			locator1 = "CPCategories#VOCABULARY_CATEGORY_1",
			value1 = "${categoryName}"
		);

		Click(locator1 = "CPCategories#CATEGORY_DETAILS_DROPDOWN_TREE");

		Click(locator1 = "CPCategories#SUBCATEGORY_CHECKBOX");

		AssertClick(locator1 = "CPCategories#ACTIONS_BUTTON", value1 = "Actions");

		AssertClickNoError(
			locator1 = "CPCategories#ACTIONS_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete the selected categories?");

		AssertTextEquals.assertTextNoWaitForText(
			locator1 = "CPCategories#SUCCESS_MESSAGE",
			value1 = "Your request processed successfully."
		);

		AssertTextNotPresent(value1 = "${subcategoryName}");
	}

	macro editCP {
		Page.gotoCP(portletName = "Categories");

		AssertClick(
			locator1 = "CPCategories#VOCABULARY_ENTRY_2",
			value1 = "${vocabularyName}"
		);

		AssertClick(
			locator1 = "CPCategories#VOCABULARY_CATEGORY_1",
			value1 = "${categoryName}"
		);

		Click(locator1 = "CPCategories#CATEGORY_DETAILS_DROPDOWN_TREE");

		Click(locator1 = "CPCategories#SUBCATEGORY_CHECKBOX");

		AssertClick(
			locator1 = "CPCategories#SUBCATEGORY_DETAILS_EDIT_BUTTON",
			value1 = "Edit"
		);

		Type(
			locator1 = "CPCategories#EDIT_SUBCATEGORY_NAME_FIELD",
			value1 = "${subcategoryNameEdit}"
		);

		AssertClick(
			locator1 = "CPCategories#EDIT_SUBCATEGORY_SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals.assertTextNoWaitForText(
			locator1 = "CPCategories#SUCCESS_MESSAGE",
			value1 = "Your request processed successfully."
		);

		Click(locator1 = "CPCategories#CATEGORY_DETAILS_DROPDOWN_TREE");

		Click(locator1 = "CPCategories#SUBCATEGORY_CHECKBOX");

		AssertTextEquals(
			locator1 = "CPCategories#SUBCATEGORY_DETAILS_HEADER",
			value1 = "${subcategoryNameEdit}"
		);
	}
}