definition {
	var password = "test";

	macro sendMessage {
		AssertClick.assertValueClickAt(
			locator1 = "SOMessages#NEW_MESSAGE_BUTTON",
			value1 = "New Message"
		);

		Click(locator1 = "SOMessagesAdd#TO_FIELD_DROPDOWN");

		Type.sendKeys(locator1 = "SOMessagesAdd#TO_FIELD", value1 = "${recipientName}");

		AssertClick.pauseAssertPartialTextClickAt(
			locator1 = "SOMessagesAdd#TO_FIELD_DROPDOWN_LIST",
			value1 = "${key_recipientName}"
		);

		AssertTextEquals(
			locator1 = "SOMessagesAdd#TO_FIELD",
			value1 = "${recipientName}<${recipientScreenName}>, "
		);

		if (isSet(number)) {
			Type(
				locator1 = "SOMessagesAdd#SUBJECT_FIELD",
				value1 = "${messageSubject}${number}"
			);

			Type(locator1 = "SOMessagesAdd#BODY_FIELD", value1 = "${messageBody}${number}");
		}
		else {
			Type(locator1 = "SOMessagesAdd#SUBJECT_FIELD", value1 = "${messageSubject}");

			Type(locator1 = "SOMessagesAdd#BODY_FIELD", value1 = "${messageBody}");
		}

		if (isSet(messageAttachmentFile)) {
			UploadCommonFile(
				locator1 = "SOMessagesAdd#ATTACHMENTS_FIELD",
				value1 = "${messageAttachmentFile}"
			);
		}

		Click(locator1 = "SOMessagesAdd#SEND_BUTTON");

		AssertTextEquals(
			locator1 = "SOMessagesAdd#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro sendReplyMessage {
		Type(
			locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_REPLY_BODY_FIELD",
			value1 = "${messageReplyBody}"
		);

		if (isSet(messageReplyAttachmentFile)) {
			UploadCommonFile(
				locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_REPLY_ATTACHMENT_FIELD",
				value1 = "${messageReplyAttachmentFile}"
			);
		}

		Click(locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_SEND_BUTTON");

		AssertTextEquals(
			locator1 = "SOMessagesMessage#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro tearDownPG {
		SOUser.firstLoginPG();

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		Check(locator1 = "SOMessages#SELECT_ALL_CHECKBOX");

		Click(locator1 = "SOMessages#DELETE_BUTTON");

		AssertTextEquals(
			locator1 = "SOMessages#INFO_MESSAGE",
			value1 = "No messages found."
		);
	}

	macro viewMessage {
		SOMessages.viewMessageList();

		if (isSet(number)) {
			Click(locator1 = "SOMessages#MESSAGE_SUBJECT_INCREMENT");

			AssertTextEquals(
				locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_SUBJECT",
				value1 = "${messageSubject}${number}"
			);

			AssertTextEquals(
				locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_USERS",
				value1 = "Between ${connectionName} And You"
			);

			AssertTextEquals(
				locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_SENDER",
				value1 = "${senderName}"
			);

			AssertTextEquals.assertPartialText(
				locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_BODY",
				value1 = "${messageBody}${number}"
			);
		}
		else {
			Click(locator1 = "SOMessages#MESSAGE_SUBJECT");

			AssertTextEquals(
				locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_SUBJECT",
				value1 = "${messageSubject}"
			);

			AssertTextEquals(
				locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_USERS",
				value1 = "Between ${connectionName} And You"
			);

			AssertTextEquals(
				locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_SENDER",
				value1 = "${senderName}"
			);

			AssertTextEquals.assertPartialText(
				locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_BODY",
				value1 = "${messageBody}"
			);
		}

		if (isSet(messageAttachmentFile)) {
			AssertElementPresent(locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_ATTACHMENT");

			AssertTextEquals(
				locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_ATTACHMENT_LINK",
				value1 = "${messageAttachmentFile}"
			);
		}
	}

	macro viewMessageList {
		if (isSet(number)) {
			AssertTextEquals(
				locator1 = "SOMessages#MESSAGE_SENDER_INCREMENT",
				value1 = "${connectionName}"
			);

			AssertTextEquals(
				locator1 = "SOMessages#MESSAGE_SUBJECT_INCREMENT",
				value1 = "${messageSubject}${number}"
			);

			AssertTextEquals(
				locator1 = "SOMessages#MESSAGE_BODY_INCREMENT",
				value1 = "${messageBody}${number}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SOMessages#MESSAGE_SENDER",
				value1 = "${connectionName}"
			);

			AssertTextEquals(
				locator1 = "SOMessages#MESSAGE_SUBJECT",
				value1 = "${messageSubject}"
			);

			AssertTextEquals(
				locator1 = "SOMessages#MESSAGE_BODY",
				value1 = "${messageBody}"
			);
		}
	}

	macro viewMessageNotification {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertElementPresent.assertElementPresent(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "1");

		MouseOver(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals.assertPartialText(
			locator1 = "SOUserBar#NOTIFICATION_MENU_ENTRY_CONTENT",
			value1 = "${senderName} sent you a message."
		);

		AssertTextEquals(
			locator1 = "SOUserBar#NOTIFICATION_MENU_ENTRY_SUBCONTENT",
			value1 = "${messageBody}"
		);

		AssertClick(
			locator1 = "SOUserBar#NOTIFICATION_MENU_MARK_ALL_AS_READ",
			value1 = "Mark All as Read"
		);

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "0");
	}

	macro viewReplyMessage {
		AssertTextEquals(
			locator1 = "SOMessages#MESSAGE_SENDER",
			value1 = "${connectionName}"
		);

		AssertTextEquals(
			locator1 = "SOMessages#MESSAGE_SUBJECT",
			value1 = "${messageSubject}"
		);

		AssertTextEquals(
			locator1 = "SOMessages#MESSAGE_BODY",
			value1 = "${messageReplyBody}"
		);

		Click(locator1 = "SOMessages#MESSAGE_SUBJECT");

		AssertTextEquals(
			locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_SUBJECT",
			value1 = "${messageSubject}"
		);

		AssertTextEquals(
			locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_USERS",
			value1 = "Between ${connectionName} And You"
		);

		AssertTextEquals(
			locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_SENDER",
			value1 = "${senderName}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_BODY",
			value1 = "${messageBody}"
		);

		if (isSet(messageAttachmentFile)) {
			AssertElementPresent(locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_ATTACHMENT");

			AssertTextEquals(
				locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_ATTACHMENT_LINK",
				value1 = "${messageAttachmentFile}"
			);
		}

		AssertTextEquals(
			locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_REPLY_SENDER",
			value1 = "${replySenderName}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_REPLY_BODY",
			value1 = "${messageReplyBody}"
		);

		if (isSet(messageAttachmentFile)) {
			AssertElementPresent(
				locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_REPLY_ATTACHMENT"
			);

			AssertTextEquals(
				locator1 = "SOMessagesMessage#PRIVATE_MESSAGE_REPLY_ATTACHMENT_LINK",
				value1 = "${messageAttachmentFile}"
			);
		}
	}
}