definition {
	macro smoke {
		var bookmarkDescription1 = "Test Folder Entry 1 Description";
		var bookmarkDescription2 = "Test Folder Entry 2 Description";
		var bookmarkDescription3 = "Test Folder Entry 3 Description";
		var bookmarkFolderDescription = "Test Folder Description";
		var bookmarkFolderName = "Test Folder";
		var bookmarkName1 = "Test Folder Entry 1";
		var bookmarkName2 = "Test Folder Entry 2";
		var bookmarkName3 = "Test Folder Entry 3";
		var bookmarkURL1 = "http://www.liferay.com";
		var bookmarkURL2 = "http://www.openqa.org";
		var bookmarkURL3 = "http://www.google.com";
		var dmDocumentDescription1 = "DM Document Description";
		var dmDocumentDescription2 = "DM Folder Image 1 Description";
		var dmDocumentDescription3 = "DM Folder Image 2 Description";
		var dmDocumentDescription4 = "DM Folder Image 3 Description";
		var dmDocumentFile1 = "Document_1.txt";
		var dmDocumentFile2 = "Document_1.jpg";
		var dmDocumentFile3 = "Document_2.jpg";
		var dmDocumentFile4 = "Document_3.jpg";
		var dmDocumentSize1 = "0.3k";
		var dmDocumentSize2 = "12.9k";
		var dmDocumentSize3 = "29.9k";
		var dmDocumentSize4 = "16.1k";
		var dmDocumentTitle1 = "DM Document Title";
		var dmDocumentTitle2 = "DM Folder Image 1 Title";
		var dmDocumentTitle3 = "DM Folder Image 2 Title";
		var dmDocumentTitle4 = "DM Folder Image 3 Title";
		var dmDocumentUploader = "Test Test";
		var dmDocumentVersionNumber = "1.0";
		var dmFolderDescription = "DM Folder 1 Description";
		var dmFolderName = "DM Folder 1 Name";
		var entryAuthorFirstName = "Test";
		var entryAuthorLastName = "Test";
		var entryComment1 = "Blogs Entry 1 Comment";
		var entryComment2 = "Blogs Entry 2 Comment";
		var entryComment3 = "Blogs Entry 3 Comment";
		var entryContent1 = "Blogs Entry 1 Content";
		var entryContent2 = "Blogs Entry 2 Content";
		var entryContent3 = "Blogs Entry 3 Content";
		var entryTitle1 = "Blogs Entry 1 Title";
		var entryTitle2 = "Blogs Entry 2 Title";
		var entryTitle3 = "Blogs Entry 3 Title";
		var eventDescription1 = "Calendar Event Description";
		var eventDescription2 = "Weekly Repeating Event Description";
		var eventDescription3 = "Monthly Repeating Event Description";
		var eventTitle1 = "Calendar Event Title";
		var eventTitle2 = "Weekly Repeating Event";
		var eventTitle3 = "Monthly Repeating Event";
		var eventType = "Anniversary";
		var mbCategoryName = "MB Category Name";
		var mbThreadBody = "MB Category Thread Message Body";
		var mbThreadSubject = "MB Category Thread Message Subject";
		var pageName1 = "Blogs Test Page";
		var pageName2 = "Bookmarks Test Page";
		var pageName3 = "Calendar Test Page";
		var pageName4 = "Documents and Media Test Page";
		var pageName5 = "Message Boards Test Page";
		var pageName6 = "Wiki Test Page";
		var wikiChildPageContent1 = "Wiki Front Page Child Page Content 1";
		var wikiChildPageContent2 = "Wiki Front Page Child Page Content 2";
		var wikiChildPageContent3 = "Wiki Front Page Child Page Content 3";
		var wikiChildPageTitle1 = "Wiki Front Page Child Page Title 1";
		var wikiChildPageTitle2 = "Wiki Front Page Child Page Title 2";
		var wikiChildPageTitle3 = "Wiki Front Page Child Page Title 3";
		var wikiPageContent = "Wiki FrontPage Content";
		var wikiPageTitle = "FrontPage";

		Page.addPG(pageName = "${pageName1}");

		Portlet.addPG(pageName = "${pageName1}", portletName = "Blogs");

		Page.gotoPG(pageName = "${pageName1}");

		BlogsEntry.addPG(
			entryContent = "${entryContent1}",
			entryTitle = "${entryTitle1}"
		);

		BlogsEntry.viewPG(
			entryAuthorFirstName = "${entryAuthorFirstName}",
			entryAuthorLastName = "${entryAuthorLastName}",
			entryContent = "${entryContent1}",
			entryTitle = "${entryTitle1}"
		);

		BlogsEntryComment.addPG(
			entryComment = "${entryComment1}",
			entryTitle = "${entryTitle1}"
		);

		Page.gotoPG(pageName = "${pageName1}");

		BlogsEntry.addPG(
			entryContent = "${entryContent2}",
			entryTitle = "${entryTitle2}"
		);

		BlogsEntry.viewPG(
			entryAuthorFirstName = "${entryAuthorFirstName}",
			entryAuthorLastName = "${entryAuthorLastName}",
			entryContent = "${entryContent2}",
			entryTitle = "${entryTitle2}"
		);

		BlogsEntryComment.addPG(
			entryComment = "${entryComment2}",
			entryTitle = "${entryTitle2}"
		);

		Page.gotoPG(pageName = "${pageName1}");

		BlogsEntry.addPG(
			entryContent = "${entryContent3}",
			entryTitle = "${entryTitle3}"
		);

		BlogsEntry.viewPG(
			entryAuthorFirstName = "${entryAuthorFirstName}",
			entryAuthorLastName = "${entryAuthorLastName}",
			entryContent = "${entryContent3}",
			entryTitle = "${entryTitle3}"
		);

		BlogsEntryComment.addPG(
			entryComment = "${entryComment3}",
			entryTitle = "${entryTitle3}"
		);

		Page.addPG(pageName = "${pageName2}");

		Portlet.addPG(pageName = "${pageName2}", portletName = "Bookmarks");

		Page.gotoPG(pageName = "${pageName2}");

		BookmarksFolder.addPG(
			bookmarkFolderDescription = "${bookmarkFolderDescription}",
			bookmarkFolderName = "${bookmarkFolderName}"
		);

		Page.gotoPG(pageName = "${pageName2}");

		Bookmark.addToFolderPG(
			bookmarkDescription = "${bookmarkDescription1}",
			bookmarkFolderName = "${bookmarkFolderName}",
			bookmarkName = "${bookmarkName1}",
			bookmarkURL = "${bookmarkURL1}"
		);

		Page.gotoPG(pageName = "${pageName2}");

		Bookmark.viewInFolderPG(
			bookmarkDescription = "${bookmarkDescription1}",
			bookmarkFolderName = "${bookmarkFolderName}",
			bookmarkName = "${bookmarkName1}",
			bookmarkURL = "${bookmarkURL1}"
		);

		Page.gotoPG(pageName = "${pageName2}");

		Bookmark.addToFolderPG(
			bookmarkDescription = "${bookmarkDescription2}",
			bookmarkFolderName = "${bookmarkFolderName}",
			bookmarkName = "${bookmarkName2}",
			bookmarkURL = "${bookmarkURL2}"
		);

		Page.gotoPG(pageName = "${pageName2}");

		Bookmark.viewInFolderPG(
			bookmarkDescription = "${bookmarkDescription2}",
			bookmarkFolderName = "${bookmarkFolderName}",
			bookmarkName = "${bookmarkName2}",
			bookmarkURL = "${bookmarkURL2}"
		);

		Page.gotoPG(pageName = "${pageName2}");

		Bookmark.addToFolderPG(
			bookmarkDescription = "${bookmarkDescription3}",
			bookmarkFolderName = "${bookmarkFolderName}",
			bookmarkName = "${bookmarkName3}",
			bookmarkURL = "${bookmarkURL3}"
		);

		Page.gotoPG(pageName = "${pageName2}");

		Bookmark.viewInFolderPG(
			bookmarkDescription = "${bookmarkDescription3}",
			bookmarkFolderName = "${bookmarkFolderName}",
			bookmarkName = "${bookmarkName3}",
			bookmarkURL = "${bookmarkURL3}"
		);

		Page.addPG(pageName = "${pageName3}");

		Portlet.addPG(pageName = "${pageName3}", portletName = "Calendar");

		Page.gotoPG(pageName = "${pageName3}");

		Event.addPG(
			eventDescription = "${eventDescription1}",
			eventTitle = "${eventTitle1}",
			eventType = "${eventType}"
		);

		Page.gotoPG(pageName = "${pageName3}");

		Event.addRepeatWeeklyPG(
			eventDescription = "${eventDescription2}",
			eventEndDay = "1",
			eventEndMonth = "January",
			eventEndYear = "2016",
			eventStartDay = "1",
			eventStartMonth = "January",
			eventStartYear = "2015",
			eventTitle = "${eventTitle2}",
			eventType = "${eventType}"
		);

		Page.gotoPG(pageName = "${pageName3}");

		Event.addRepeatMonthlyPG(
			eventDescription = "${eventDescription3}",
			eventEndDay = "1",
			eventEndMonth = "January",
			eventEndYear = "2016",
			eventStartDay = "1",
			eventStartMonth = "January",
			eventStartYear = "2015",
			eventTitle = "${eventTitle3}",
			eventType = "${eventType}"
		);

		Page.addPG(pageName = "${pageName4}");

		Portlet.addPG(pageName = "${pageName4}", portletName = "Documents and Media");

		DMDocument.addPG(
			dmDocumentDescription = "${dmDocumentDescription1}",
			dmDocumentFile = "${dmDocumentFile1}",
			dmDocumentSize = "${dmDocumentSize1}",
			dmDocumentTitle = "${dmDocumentTitle1}"
		);

		Page.gotoPG(pageName = "${pageName4}");

		DMFolder.addPG(
			dmFolderDescription = "${dmFolderDescription}",
			dmFolderName = "${dmFolderName}"
		);

		DMFolderDocument.addPG(
			dmDocumentDescription = "${dmDocumentDescription2}",
			dmDocumentFile = "${dmDocumentFile2}",
			dmDocumentTitle = "${dmDocumentTitle2}",
			dmFolderName = "${dmFolderName}"
		);

		Page.gotoPG(pageName = "${pageName4}");

		DMFolderDocument.addPG(
			dmDocumentDescription = "${dmDocumentDescription3}",
			dmDocumentFile = "${dmDocumentFile3}",
			dmDocumentTitle = "${dmDocumentTitle3}",
			dmFolderName = "${dmFolderName}"
		);

		Page.gotoPG(pageName = "${pageName4}");

		DMFolderDocument.addPG(
			dmDocumentDescription = "${dmDocumentDescription4}",
			dmDocumentFile = "${dmDocumentFile4}",
			dmDocumentTitle = "${dmDocumentTitle4}",
			dmFolderName = "${dmFolderName}"
		);

		DMFolderDocument.viewPG(
			dmDocumentSize = "${dmDocumentSize2}",
			dmDocumentTitle = "${dmDocumentTitle2}",
			dmDocumentUploader = "${dmDocumentUploader}",
			dmDocumentVersionNumber = "${dmDocumentVersionNumber}"
		);

		Page.gotoPG(pageName = "${pageName4}");

		DMFolderDocument.viewPG(
			dmDocumentSize = "${dmDocumentSize3}",
			dmDocumentTitle = "${dmDocumentTitle3}",
			dmDocumentUploader = "${dmDocumentUploader}",
			dmDocumentVersionNumber = "${dmDocumentVersionNumber}"
		);

		Page.gotoPG(pageName = "${pageName4}");

		DMFolderDocument.viewPG(
			dmDocumentSize = "${dmDocumentSize4}",
			dmDocumentTitle = "${dmDocumentTitle4}",
			dmDocumentUploader = "${dmDocumentUploader}",
			dmDocumentVersionNumber = "${dmDocumentVersionNumber}"
		);

		Page.addPG(pageName = "${pageName5}");

		Portlet.addPG(pageName = "${pageName5}", portletName = "Message Boards");

		Page.gotoPG(pageName = "${pageName5}");

		MessageboardsCategory.addPG(categoryName = "${mbCategoryName}");

		MessageboardsCategory.viewPG(categoryName = "${mbCategoryName}");

		Page.gotoPG(pageName = "${pageName5}");

		MessageboardsThread.addInCategoryPG(
			categoryName = "${mbCategoryName}",
			threadBody = "${mbThreadBody}",
			threadSubject = "${mbThreadSubject}"
		);

		Page.gotoPG(pageName = "${pageName5}");

		MessageboardsThread.viewInCategoryPG(
			categoryName = "${mbCategoryName}",
			threadBody = "${mbThreadBody}",
			threadSubject = "${mbThreadSubject}"
		);

		Page.addPG(pageName = "${pageName6}");

		Portlet.addPG(pageName = "${pageName6}", portletName = "Wiki");

		WikiPage.addFrontPagePG(wikiPageContent = "${wikiPageContent}");

		Page.gotoPG(pageName = "${pageName6}");

		WikiPage.addChildPagePG(
			wikiChildPageContent = "${wikiChildPageContent1}",
			wikiChildPageTitle = "${wikiChildPageTitle1}",
			wikiPageContent = "${wikiPageContent}",
			wikiPageTitle = "${wikiPageTitle}"
		);

		Page.gotoPG(pageName = "${pageName6}");

		WikiPage.addChildPagePG(
			wikiChildPageContent = "${wikiChildPageContent2}",
			wikiChildPageTitle = "${wikiChildPageTitle2}",
			wikiPageContent = "${wikiPageContent}",
			wikiPageTitle = "${wikiPageTitle}"
		);

		Page.gotoPG(pageName = "${pageName6}");

		WikiPage.addChildPagePG(
			wikiChildPageContent = "${wikiChildPageContent3}",
			wikiChildPageTitle = "${wikiChildPageTitle3}",
			wikiPageContent = "${wikiPageContent}",
			wikiPageTitle = "${wikiPageTitle}"
		);
	}
}