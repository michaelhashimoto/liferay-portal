<definition>
	<command name="deletePG">
		<var name="key_threadSubject" value="${threadSubject}" />

		<execute function="AssertTextEquals" locator1="PGMessageboards#THREAD_TABLE_THREAD" value1="${threadSubject}" />
		<execute function="Click#pauseTextClickAt" locator1="PGMessageboards#THREAD_TABLE_ACTIONS" />
		<execute function="AssertClickNoError" locator1="PGMessageboards#THREAD_MENULIST_DELETE" value1="Delete" />
		<execute function="Confirm" value1="Are you sure you want to delete this?" />
		<execute function="AssertTextEquals" locator1="PGMessageboards#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextNotPresent" value1="${threadSubject}" />
	</command>

	<command name="viewMyPostsPG">
		<var name="key_threadSubject" value="${threadSubject}" />

		<execute function="AssertClick#assertTextClickAt" locator1="PGMessageboards#NAVIGATION_MY_POSTS" value1="My Posts" />

		<execute function="Click" locator1="SOUserBar#TOGGLE_DOCKBAR" />

		<if>
			<condition function="IsElementNotPresent#pauseIsElementNotPresent" locator1="SOForums#BREADCRUMB_PORTLET_TITLE" />
			<then>
				<execute function="MouseOver#mouseOverClickDockbar" locator1="Dockbar#EDIT_CONTROLS" />
				<execute function="AssertClick" locator1="Dockbar#EDIT_CONTROLS" value1="Edit Controls" />
			</then>
		</if>

		<execute function="AssertTextEquals" locator1="SOForums#BREADCRUMB_PORTLET_TITLE" value1="BREADCRUMB" />
		<execute function="AssertTextEquals" locator1="SOForums#MESSAGE_BOARDS_PORTLET_TITLE" value1="MESSAGE BOARDS" />
