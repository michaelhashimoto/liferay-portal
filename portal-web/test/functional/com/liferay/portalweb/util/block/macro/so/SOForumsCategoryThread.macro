definition {
	macro deletePG {
		var key_threadSubject = "${threadSubject}";

		AssertTextEquals(
			locator1 = "PGMessageboards#THREAD_TABLE_THREAD",
			value1 = "${threadSubject}"
		);

		Click.pauseTextClickAt(locator1 = "PGMessageboards#THREAD_TABLE_ACTIONS");

		AssertClickNoError(
			locator1 = "PGMessageboards#THREAD_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextEquals(
			locator1 = "PGMessageboards#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextNotPresent(value1 = "${threadSubject}");
	}

	macro viewMyPostsPG {
		var key_threadSubject = "${threadSubject}";

		AssertClick.assertTextClickAt(
			locator1 = "PGMessageboards#NAVIGATION_MY_POSTS",
			value1 = "My Posts"
		);

		Click(locator1 = "SOUserBar#TOGGLE_DOCKBAR");

		if (IsElementNotPresent.pauseIsElementNotPresent(locator1 = "SOForums#BREADCRUMB_PORTLET_TITLE")) {
			MouseOver.mouseOverClickDockbar(locator1 = "Dockbar#EDIT_CONTROLS");

			AssertClick(locator1 = "Dockbar#EDIT_CONTROLS", value1 = "Edit Controls");
		}

		AssertTextEquals(
			locator1 = "SOForums#BREADCRUMB_PORTLET_TITLE",
			value1 = "BREADCRUMB"
		);

		AssertTextEquals(
			locator1 = "SOForums#MESSAGE_BOARDS_PORTLET_TITLE",
			value1 = "MESSAGE BOARDS"
		);

		AssertTextEquals(locator1 = "SOForums#BREADCRUMB_1", value1 = "Liferay");

		AssertTextEquals(locator1 = "SOForums#BREADCRUMB_2", value1 = "${siteName}");

		AssertTextEquals(locator1 = "SOForums#BREADCRUMB_3", value1 = "${pageName}");

		AssertTextEquals(locator1 = "SOForums#BREADCRUMB_4", value1 = "My Posts");

		AssertTextEquals(
			locator1 = "PGMessageboardsMyposts#THREAD_TABLE_THREAD",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsMyposts#THREAD_TABLE_STARTED_BY",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsMyposts#THREAD_TABLE_POSTS",
			value1 = "1"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "PGMessageboardsMyposts#THREAD_TABLE_LAST_POST",
			value1 = "By: ${userName}"
		);

		AssertElementPresent(locator1 = "PGMessageboardsMyposts#THREAD_TABLE_ACTIONS");

		AssertClick.assertTextClickAt(
			locator1 = "PGMessageboardsMyposts#THREAD_TABLE_THREAD",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "SOForums#BREADCRUMB_PORTLET_TITLE",
			value1 = "BREADCRUMB"
		);

		AssertTextEquals(
			locator1 = "SOForums#MESSAGE_BOARDS_PORTLET_TITLE",
			value1 = "MESSAGE BOARDS"
		);

		AssertTextEquals(locator1 = "SOForums#BREADCRUMB_1", value1 = "Liferay");

		AssertTextEquals(locator1 = "SOForums#BREADCRUMB_2", value1 = "${siteName}");

		AssertTextEquals(locator1 = "SOForums#BREADCRUMB_3", value1 = "${pageName}");

		AssertTextEquals(locator1 = "SOForums#BREADCRUMB_4", value1 = "${categoryName}");

		AssertTextEquals(
			locator1 = "SOForums#BREADCRUMB_5",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#TITLE_HEADER",
			value1 = "${threadSubject}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "PGMessageboardsThread#THREAD_CONTROLS_BACK",
			value1 = "Back to ${categoryName}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#THREAD_CONTROLS_NAVIGATION",
			value1 = "Threads [ Previous | Next ]"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_USERNAME_1",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_SUBJECT_1",
			value1 = "${threadSubject}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_BODY_1",
			value1 = "${threadBody}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsThread#MESSAGE_RATING_1",
			value1 = "0 (0 Votes)"
		);

		AssertElementNotPresent(
			locator1 = "PGMessageboardsThread#MESSAGE_WORKFLOW_STATUS_1"
		);
	}

