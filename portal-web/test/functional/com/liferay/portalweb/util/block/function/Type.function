@default = "type"
@summary = "Type to '${locator1}' the value '${value1}'"
definition {
	function clickAtSendKeys {
		selenium.waitForVisible();

		selenium.type("${locator1}", "");

		selenium.clickAt();

		selenium.sendKeys();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function sendKeys {
		selenium.waitForVisible();

		selenium.sendKeys();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function sendKeysAceEditor {
		selenium.waitForElementPresent();

		selenium.mouseOver();

		selenium.sendKeysAceEditor();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function sendKeysAceEditorNoMouseOver {
		selenium.waitForElementPresent();

		selenium.sendKeysAceEditor();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function sendKeysApplicationSearch {
		selenium.waitForElementPresent(
			"//script[contains(@src,'/aui/aui-live-search/aui-live-search-min.js')]"
		);

		Type.sendKeys();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function sikuliType {
		selenium.sikuliType();

		selenium.pause("2000");

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function type {
		selenium.waitForVisible();

		selenium.type();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function typeAceEditor {
		selenium.waitForElementPresent();

		selenium.mouseOver();

		selenium.typeAceEditor();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function typeAceEditorNoMouseOver {
		selenium.waitForElementPresent();

		selenium.typeAceEditor();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function typeAlloyEditor {
		selenium.waitForElementPresent();

		selenium.mouseOver();

		selenium.typeAlloyEditor();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function typeCKEditor {
		selenium.waitForVisible();

		selenium.typeCKEditor();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function typeCKEditorWaitForCKEditor {
		selenium.waitForVisible();

		selenium.waitForVisible("//a[@class='cke_button_cut cke_disabled']");

		selenium.typeCKEditor();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function typeWaitForNotValueNull {
		selenium.waitForNotValue();

		Type.type();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}
}