<definition>
	<command name="addCP">
		<execute action="CPWiki#assertClick" locator1="ADD_WIKI_BUTTON" value1="Add Wiki" />

		<execute action="CPWikiAddwiki#type" locator1="NAME_FIELD" value1="${wikiNodeName}" />
		<execute action="CPWikiAddwiki#type" locator1="DESCRIPTION_FIELD" value1="${wikiNodeDescription}" />
		<execute action="CPWikiAddwiki#assertClick" locator1="SAVE_BUTTON" value1="Save" />

		<execute action="CPWiki#assertTextEquals" locator1="SUCCESS_MESSAGE"  value1="Your request completed successfully." />
		<execute action="CPWiki#assertTextEquals" locator1="WIKI_NODE_TABLE_WIKI_2" value1="${wikiNodeName}" />
		<execute action="CPWiki#assertTextEquals" locator1="WIKI_NODE_TABLE_NUMBER_OF_PAGES_2" value1="0" />
	</command>

	<command name="deleteCP">
		<execute action="CPWiki#assertTextEquals" locator1="WIKI_NODE_TABLE_WIKI_2" value1="${wikiNodeName}" />
		<execute action="CPWiki#assertClick" locator1="WIKI_NODE_TABLE_ACTIONS_2" value1="Actions" />
		<execute action="CPWiki#assertClickNoError" locator1="WIKI_NODE_MENULIST_DELETE" value1="Delete" />
		<execute action="CPWiki#confirm" locator1="CONFIRMATION" value1="Are you sure you want to delete this?" />
		<execute action="CPWiki#assertTextNotPresent" value1="${wikiNodeName}" />
	</command>

	<command name="editCP">
		<execute action="CPWiki#assertTextEquals" locator1="WIKI_NODE_TABLE_WIKI_2" value1="${wikiNodeName}" />
		<execute action="CPWiki#assertClick" locator1="WIKI_NODE_TABLE_ACTIONS_2" value1="Actions" />
		<execute action="CPWiki#assertClick" locator1="WIKI_NODE_MENULIST_EDIT" value1="Edit" />

		<execute action="CPWikiAddwiki#type" locator1="NAME_FIELD" value1="${wikiNodeNameEdit}" />
		<execute action="CPWikiAddwiki#type" locator1="DESCRIPTION_FIELD" value1="${wikiNodeDescriptionEdit}" />
		<execute action="CPWikiAddwiki#assertClick" locator1="SAVE_BUTTON" value1="Save" />

		<execute action="CPWiki#assertTextEquals" locator1="SUCCESS_MESSAGE"  value1="Your request completed successfully." />
		<execute action="CPWiki#assertTextEquals" locator1="WIKI_NODE_TABLE_WIKI_2" value1="${wikiNodeNameEdit}" />
		<execute action="CPWiki#assertTextNotEquals" locator1="WIKI_NODE_TABLE_WIKI_2" value1="${wikiNodeName}" />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Wiki" />
		</execute>

		<while>
			<condition action="CPWiki#isElementPresent" locator1="WIKI_NODE_TABLE_ACTIONS_2" value1="Actions" />
			<then>
				<execute action="CPWiki#assertClick" locator1="WIKI_NODE_TABLE_ACTIONS_2" value1="Actions" />
				<execute action="CPWiki#assertClickNoError" locator1="WIKI_NODE_MENULIST_DELETE" value1="Delete" />
				<execute action="CPWiki#confirm" locator1="CONFIRMATION" value1="Are you sure you want to delete this?" />
			</then>
		</while>
	</command>
</definition>