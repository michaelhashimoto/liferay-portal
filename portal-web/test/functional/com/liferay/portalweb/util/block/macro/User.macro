<definition>
	<var name="password" value="test" />
	<var name="userEmailAddress" value="test@liferay.com" />

	<command name="addCP">
		<execute function="AssertClick" locator1="CPUsersandorganizations#ADD" value1="Add" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPUsersandorganizations#ADD_USER" value1="User" />

		<execute function="Type" locator1="CPUsersandorganizationsAdduser#DETAILS_SCREEN_NAME_FIELD" value1="${userScreenName}" />
		<execute function="Type" locator1="CPUsersandorganizationsAdduser#DETAILS_EMAIL_ADDRESS_FIELD" value1="${userEmailAddress}" />
		<execute function="Type" locator1="CPUsersandorganizationsAdduser#DETAILS_FIRST_NAME_FIELD" value1="${userFirstName}" />

		<if>
			<isset var="userMiddleName" />
			<then>
				<execute function="Type" locator1="CPUsersandorganizationsAdduser#DETAILS_MIDDLE_NAME_FIELD" value1="${userMiddleName}" />
			</then>
		</if>

		<execute function="Type" locator1="CPUsersandorganizationsAdduser#DETAILS_LAST_NAME_FIELD" value1="${userLastName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPUsersandorganizationsAdduser#SAVE" value1="Save" />

		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsUser#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsUser#DETAILS_SCREEN_NAME_FIELD" value1="${userScreenName}" />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsUser#DETAILS_EMAIL_ADDRESS_FIELD" value1="${userEmailAddress}" />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsUser#DETAILS_FIRST_NAME_FIELD" value1="${userFirstName}" />

		<if>
			<isset var="userMiddleName" />
			<then>
				<execute function="AssertTextEquals" locator1="CPUsersandorganizationsUser#DETAILS_MIDDLE_NAME_FIELD" value1="${userMiddleName}" />
			</then>
		</if>

		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsUser#DETAILS_LAST_NAME_FIELD" value1="${userLastName}" />
	</command>

	<command name="deactivateCP">
		<execute function="AssertClick#assertTextClickAt" locator1="CPUsersandorganizations#SEARCH_ALL_USERS" value1="Search All Users" />

		<execute macro="CPUsersandorganizationsViewusers#showAdvancedSearch" />
		<execute function="Type" locator1="CPUsersandorganizationsViewusers#ADVANCED_SEARCH_FIRST_NAME" value1="${userFirstName}" />
		<execute function="Select" locator1="CPUsersandorganizationsViewusers#ADVANCED_SEARCH_STATUS" value1="Active" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPUsersandorganizationsViewusers#ADVANCED_SEARCH_BUTTON" value1="Search" />

		<if>
			<condition function="IsElementPresent" locator1="CPUsersandorganizationsViewusers#USER_TABLE_ALL_CHECKBOX" />
			<then>
				<execute function="Check" locator1="CPUsersandorganizationsViewusers#USER_TABLE_ALL_CHECKBOX" value1="Check All" />
				<execute function="AssertClickNoError" locator1="CPUsersandorganizationsViewusers#DEACTIVATE" value1="Deactivate" />
				<execute function="Confirm" value1="Are you sure you want to deactivate the selected users?" />
				<execute function="AssertTextEquals" locator1="CPUsersandorganizationsViewusers#SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</if>

		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsViewusers#INFO_MESSAGE" value1="No users were found." />
		<execute function="AssertElementNotPresent" locator1="CPUsersandorganizationsViewusers#DEACTIVATE" value1="Deactivate" />
		<execute macro="CPUsersandorganizationsViewusers#showBasicSearch" />
	</command>

	<command name="deleteCP">
		<execute function="AssertClick#assertTextClickAt" locator1="CPUsersandorganizations#SEARCH_ALL_USERS" value1="Search All Users" />

		<execute macro="CPUsersandorganizationsViewusers#showAdvancedSearch" />
		<execute function="Type" locator1="CPUsersandorganizationsViewusers#ADVANCED_SEARCH_FIRST_NAME" value1="${userFirstName}" />
		<execute function="Select" locator1="CPUsersandorganizationsViewusers#ADVANCED_SEARCH_STATUS" value1="Inactive" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPUsersandorganizationsViewusers#ADVANCED_SEARCH_BUTTON" value1="Search" />

		<if>
			<condition function="IsElementPresent" locator1="CPUsersandorganizationsViewusers#USER_TABLE_ALL_CHECKBOX" />
			<then>
				<execute function="Check" locator1="CPUsersandorganizationsViewusers#USER_TABLE_ALL_CHECKBOX" value1="Check All" />
				<execute function="AssertClickNoError" locator1="CPUsersandorganizationsViewusers#DELETE" value1="Delete" />
				<execute function="Confirm" value1="Are you sure you want to permanently delete the selected users?" />
				<execute function="AssertTextEquals" locator1="CPUsersandorganizationsViewusers#SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</if>

		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsViewusers#INFO_MESSAGE" value1="No users were found." />
		<execute function="AssertElementNotPresent" locator1="CPUsersandorganizationsViewusers#DELETE" value1="Delete" />
		<execute macro="CPUsersandorganizationsViewusers#showBasicSearch" />
	</command>

	<command name="editPasswordCP">
		<execute function="AssertClick#assertTextClickAt" locator1="CPUsersandorganizations#SEARCH_ALL_USERS" value1="Search All Users" />

		<execute macro="CPUsersandorganizationsViewusers#showBasicSearch" />
		<execute function="Type" locator1="CPUsersandorganizationsViewusers#BASIC_SEARCH_FIELD" value1="${userScreenName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPUsersandorganizationsViewusers#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsViewusers#USER_TABLE_SCREEN_NAME_1" value1="${userScreenName}" />
		<execute function="Click" locator1="CPUsersandorganizationsViewusers#USER_TABLE_SCREEN_NAME_1" value1="${userScreenName}" />

		<execute function="Click" locator1="CPUsersandorganizationsUser#PASSWORD" />
		<execute function="Type" locator1="CPUsersandorganizationsUser#PASSWORD_NEW_PASSWORD_FIELD" value1="password" />
		<execute function="Type" locator1="CPUsersandorganizationsUser#PASSWORD_ENTER_AGAIN_FIELD" value1="password" />
		<execute function="Click" locator1="CPUsersandorganizationsUser#SAVE_BUTTON" />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsUser#SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<execute macro="User#logoutPG" />

		<execute macro="User#loginPG">
			<var name="password" value="password" />
			<var name="userEmailAddress" value="${userEmailAddress}" />
		</execute>

		<execute macro="User#logoutPG" />

		<execute macro="User#loginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="test@liferay.com" />
		</execute>
	</command>

	<command name="firstLoginPG" summary="Log into Liferay Portal as '${userEmailAddress}' using the password '${password}'; if not logged in as '${userEmailAddress}', then log out first">
		<echo message="Checking to see if Mobile Device is enabled..." />

		<var method="PropsUtil#get('MOBILE_BROWSER')" name="mobileBrowser" />

		<if>
			<equals arg1="${mobileBrowser}" arg2="true" />
			<then>
				<execute macro="MobileDevice#selectMobileDevice" />
			</then>
		</if>

		<echo message="Checking to see if TCat is enabled..." />

		<var method="selenium#isTCatEnabled()" name="tcatEnabled" />

		<if>
			<equals arg1="${tcatEnabled}" arg2="true" />
			<then>
				<execute macro="TCat#deployLiferayPortalWar" />
			</then>
		</if>

		<execute macro="Page#openURL" />

		<if>
			<condition function="IsElementPresent" locator1="Dockbar#USER_NAME" />
			<then>
				<execute macro="User#logoutPG" />
				<execute macro="User#loginPG" />
			</then>
			<else>
				<execute macro="User#loginPG" />
			</else>
		</if>
	</command>

	<command name="loginPG" summary="Log into Liferay Portal as '${userEmailAddress}' using the password '${password}'">
		<execute macro="Page#openURL" />

		<if>
			<isset var="welcomeTheme" />
			<then>
				<execute function="AssertClick#assertTextClickAt" locator1="PGWelcomePage1#SIGN_IN" value1="Sign In" />
			</then>
		</if>

		<execute function="Type" locator1="PGLogin#EMAIL_ADDRESS_FIELD" value1="${userEmailAddress}" />
		<execute function="Type" locator1="PGLogin#PASSWORD_FIELD" value1="${password}" />
		<execute function="Click" locator1="PGLogin#REMEMBER_ME_CHECKBOX" />

		<take-screenshot />

		<execute function="Click" locator1="PGLogin#SIGN_IN_BUTTON"  value1="Sign In" />

		<if>
			<condition function="IsElementPresent" locator1="PGLoginTermsofservice#I_AGREE_BUTTON" />
			<then>
				<execute function="Click" locator1="PGLoginTermsofservice#I_AGREE_BUTTON" />
			</then>
		</if>

		<if>
			<condition function="IsElementPresent" locator1="PGLoginNewpassword#PASSWORD_FIELD" />
			<then>
				<execute function="Type" locator1="PGLoginNewpassword#PASSWORD_FIELD" value1="test" />
				<execute function="Type" locator1="PGLoginNewpassword#ENTER_AGAIN_FIELD" value1="test" />
				<execute function="Click" locator1="PGLoginNewpassword#SAVE_BUTTON" />
			</then>
		</if>

		<if>
			<condition function="IsElementPresent" locator1="PGLoginPasswordreminder#ANSWER_FIELD" />
			<then>
				<execute function="Type" locator1="PGLoginPasswordreminder#ANSWER_FIELD" value1="test" />
				<execute function="Click" locator1="PGLoginPasswordreminder#SAVE_BUTTON" />
			</then>
		</if>
	</command>

	<command name="logoutPG">
		<description message="Log out of Liferay Portal." />

		<execute macro="Page#openURL" />

		<if>
			<condition function="IsElementPresent" locator1="Dockbar#USER_NAME" />
			<then>
				<execute function="AssertClick#assertTextClickAt" locator1="Dockbar#USER_SIGN_OUT" value1="Sign Out" />
			</then>
		</if>
	</command>

	<command name="tearDownCP">
		<var name="userFirstName" value="userfn*" />

		<execute macro="Page#gotoCP">
			<var name="portletName" value="Users and Organizations" />
		</execute>

		<execute macro="User#deactivateCP">
			<var name="userFirstName" value="${userFirstName}" />
		</execute>

		<execute macro="Page#gotoCP">
			<var name="portletName" value="Users and Organizations" />
		</execute>

		<execute macro="User#deleteCP">
			<var name="userFirstName" value="${userFirstName}" />
		</execute>
	</command>

	<command name="viewCP">
		<execute function="AssertClick#assertTextClickAt" locator1="CPUsersandorganizations#SEARCH_ALL_USERS" value1="Search All Users" />

		<execute macro="CPUsersandorganizationsViewusers#showBasicSearch" />
		<execute function="Type" locator1="CPUsersandorganizationsViewusers#BASIC_SEARCH_FIELD" value1="${userScreenName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPUsersandorganizationsViewusers#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsViewusers#USER_TABLE_FIRST_NAME_1" value1="${userFirstName}" />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsViewusers#USER_TABLE_LAST_NAME_1" value1="${userLastName}" />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsViewusers#USER_TABLE_SCREEN_NAME_1" value1="${userScreenName}" />
		<execute function="Click" locator1="CPUsersandorganizationsViewusers#USER_TABLE_FIRST_NAME_1" value1="${userFirstName}" />

		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsUser#DETAILS_SCREEN_NAME_FIELD" value1="${userScreenName}" />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsUser#DETAILS_EMAIL_ADDRESS_FIELD" value1="${userEmailAddress}" />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsUser#DETAILS_FIRST_NAME_FIELD" value1="${userFirstName}" />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsUser#DETAILS_LAST_NAME_FIELD" value1="${userLastName}" />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsUser#USER_NAME" value1="${userFirstName} ${userLastName}" />
	</command>
</definition>