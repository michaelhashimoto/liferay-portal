definition {
	var password = "test";
	var userEmailAddress = "test@liferay.com";

	macro addCP {
		AssertClick(locator1 = "CPUsersandorganizations#ADD", value1 = "Add");

		AssertClick.assertTextClickAt(
			locator1 = "CPUsersandorganizations#ADD_USER",
			value1 = "User"
		);

		Type(
			locator1 = "CPUsersandorganizationsAdduser#DETAILS_SCREEN_NAME_FIELD",
			value1 = "${userScreenName}"
		);

		Type(
			locator1 = "CPUsersandorganizationsAdduser#DETAILS_EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}"
		);

		Type(
			locator1 = "CPUsersandorganizationsAdduser#DETAILS_FIRST_NAME_FIELD",
			value1 = "${userFirstName}"
		);

		if (isSet(userMiddleName)) {
			Type(
				locator1 = "CPUsersandorganizationsAdduser#DETAILS_MIDDLE_NAME_FIELD",
				value1 = "${userMiddleName}"
			);
		}

		Type(
			locator1 = "CPUsersandorganizationsAdduser#DETAILS_LAST_NAME_FIELD",
			value1 = "${userLastName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPUsersandorganizationsAdduser#SAVE",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsUser#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsUser#DETAILS_SCREEN_NAME_FIELD",
			value1 = "${userScreenName}"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsUser#DETAILS_EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsUser#DETAILS_FIRST_NAME_FIELD",
			value1 = "${userFirstName}"
		);

		if (isSet(userMiddleName)) {
			AssertTextEquals(
				locator1 = "CPUsersandorganizationsUser#DETAILS_MIDDLE_NAME_FIELD",
				value1 = "${userMiddleName}"
			);
		}

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsUser#DETAILS_LAST_NAME_FIELD",
			value1 = "${userLastName}"
		);
	}

	macro deactivateCP {
		AssertClick.assertTextClickAt(
			locator1 = "CPUsersandorganizations#SEARCH_ALL_USERS",
			value1 = "Search All Users"
		);

		CPUsersandorganizationsViewusers.showAdvancedSearch();

		Type(
			locator1 = "CPUsersandorganizationsViewusers#ADVANCED_SEARCH_FIRST_NAME",
			value1 = "${userFirstName}"
		);

		Select(
			locator1 = "CPUsersandorganizationsViewusers#ADVANCED_SEARCH_STATUS",
			value1 = "Active"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPUsersandorganizationsViewusers#ADVANCED_SEARCH_BUTTON",
			value1 = "Search"
		);

		if (IsElementPresent(locator1 = "CPUsersandorganizationsViewusers#USER_TABLE_ALL_CHECKBOX")) {
			Check(
				locator1 = "CPUsersandorganizationsViewusers#USER_TABLE_ALL_CHECKBOX",
				value1 = "Check All"
			);

			AssertClickNoError(
				locator1 = "CPUsersandorganizationsViewusers#DEACTIVATE",
				value1 = "Deactivate"
			);

			Confirm(value1 = "Are you sure you want to deactivate the selected users?");

			AssertTextEquals(
				locator1 = "CPUsersandorganizationsViewusers#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsViewusers#INFO_MESSAGE",
			value1 = "No users were found."
		);

		AssertElementNotPresent(
			locator1 = "CPUsersandorganizationsViewusers#DEACTIVATE",
			value1 = "Deactivate"
		);

		CPUsersandorganizationsViewusers.showBasicSearch();
	}

	macro deleteCP {
		AssertClick.assertTextClickAt(
			locator1 = "CPUsersandorganizations#SEARCH_ALL_USERS",
			value1 = "Search All Users"
		);

		CPUsersandorganizationsViewusers.showAdvancedSearch();

		Type(
			locator1 = "CPUsersandorganizationsViewusers#ADVANCED_SEARCH_FIRST_NAME",
			value1 = "${userFirstName}"
		);

		Select(
			locator1 = "CPUsersandorganizationsViewusers#ADVANCED_SEARCH_STATUS",
			value1 = "Inactive"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPUsersandorganizationsViewusers#ADVANCED_SEARCH_BUTTON",
			value1 = "Search"
		);

		if (IsElementPresent(locator1 = "CPUsersandorganizationsViewusers#USER_TABLE_ALL_CHECKBOX")) {
			Check(
				locator1 = "CPUsersandorganizationsViewusers#USER_TABLE_ALL_CHECKBOX",
				value1 = "Check All"
			);

			AssertClickNoError(
				locator1 = "CPUsersandorganizationsViewusers#DELETE",
				value1 = "Delete"
			);

			Confirm(
				value1 = "Are you sure you want to permanently delete the selected users?"
			);

			AssertTextEquals(
				locator1 = "CPUsersandorganizationsViewusers#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsViewusers#INFO_MESSAGE",
			value1 = "No users were found."
		);

		AssertElementNotPresent(
			locator1 = "CPUsersandorganizationsViewusers#DELETE",
			value1 = "Delete"
		);

		CPUsersandorganizationsViewusers.showBasicSearch();
	}

	macro editPasswordCP {
		AssertClick.assertTextClickAt(
			locator1 = "CPUsersandorganizations#SEARCH_ALL_USERS",
			value1 = "Search All Users"
		);

		CPUsersandorganizationsViewusers.showBasicSearch();

		Type(
			locator1 = "CPUsersandorganizationsViewusers#BASIC_SEARCH_FIELD",
			value1 = "${userScreenName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPUsersandorganizationsViewusers#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsViewusers#USER_TABLE_SCREEN_NAME_1",
			value1 = "${userScreenName}"
		);

		Click(
			locator1 = "CPUsersandorganizationsViewusers#USER_TABLE_SCREEN_NAME_1",
			value1 = "${userScreenName}"
		);

		Click(locator1 = "CPUsersandorganizationsUser#PASSWORD");

		Type(
			locator1 = "CPUsersandorganizationsUser#PASSWORD_NEW_PASSWORD_FIELD",
			value1 = "password"
		);

		Type(
			locator1 = "CPUsersandorganizationsUser#PASSWORD_ENTER_AGAIN_FIELD",
			value1 = "password"
		);

		Click(locator1 = "CPUsersandorganizationsUser#SAVE_BUTTON");

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsUser#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		User.logoutPG();

		User.loginPG(password = "password", userEmailAddress = "${userEmailAddress}");

		User.logoutPG();

		User.loginPG(password = "test", userEmailAddress = "test@liferay.com");
	}

	@summary = "Log into Liferay Portal as '${userEmailAddress}' using the password '${password}'; if not logged in as '${userEmailAddress}', then log out first"
	macro firstLoginPG {
		echo("Checking to see if Mobile Device is enabled...");

		var mobileBrowser = PropsUtil.get("MOBILE_BROWSER");

		if ("${mobileBrowser}" == "true") {
			MobileDevice.selectMobileDevice();
		}

		echo("Checking to see if TCat is enabled...");

		var tcatEnabled = selenium.isTCatEnabled();

		if ("${tcatEnabled}" == "true") {
			TCat.deployLiferayPortalWar();
		}

		Page.openURL();

		if (IsElementPresent(locator1 = "Dockbar#USER_NAME")) {
			User.logoutPG();

			User.loginPG();
		}
		else {
			User.loginPG();
		}
	}

	@summary = "Log into Liferay Portal as '${userEmailAddress}' using the password '${password}'"
	macro loginPG {
		Page.openURL();

		if (isSet(welcomeTheme)) {
			AssertClick.assertTextClickAt(
				locator1 = "PGWelcomePage1#SIGN_IN",
				value1 = "Sign In"
			);
		}

		Type(locator1 = "PGLogin#EMAIL_ADDRESS_FIELD", value1 = "${userEmailAddress}");

		Type(locator1 = "PGLogin#PASSWORD_FIELD", value1 = "${password}");

		Click(locator1 = "PGLogin#REMEMBER_ME_CHECKBOX");

		takeScreenshot();

		Click(locator1 = "PGLogin#SIGN_IN_BUTTON", value1 = "Sign In");

		if (IsElementPresent(locator1 = "PGLoginTermsofservice#I_AGREE_BUTTON")) {
			Click(locator1 = "PGLoginTermsofservice#I_AGREE_BUTTON");
		}

		if (IsElementPresent(locator1 = "PGLoginNewpassword#PASSWORD_FIELD")) {
			Type(locator1 = "PGLoginNewpassword#PASSWORD_FIELD", value1 = "test");

			Type(locator1 = "PGLoginNewpassword#ENTER_AGAIN_FIELD", value1 = "test");

			Click(locator1 = "PGLoginNewpassword#SAVE_BUTTON");
		}

		if (IsElementPresent(locator1 = "PGLoginPasswordreminder#ANSWER_FIELD")) {
			Type(locator1 = "PGLoginPasswordreminder#ANSWER_FIELD", value1 = "test");

			Click(locator1 = "PGLoginPasswordreminder#SAVE_BUTTON");
		}
	}

	@description = "Log out of Liferay Portal."
	macro logoutPG {
		Page.openURL();

		if (IsElementPresent(locator1 = "Dockbar#USER_NAME")) {
			AssertClick.assertTextClickAt(
				locator1 = "Dockbar#USER_SIGN_OUT",
				value1 = "Sign Out"
			);
		}
	}

	macro tearDownCP {
		var userFirstName = "userfn*";

		Page.gotoCP(portletName = "Users and Organizations");

		User.deactivateCP(userFirstName = "${userFirstName}");

		Page.gotoCP(portletName = "Users and Organizations");

		User.deleteCP(userFirstName = "${userFirstName}");
	}

	macro viewCP {
		AssertClick.assertTextClickAt(
			locator1 = "CPUsersandorganizations#SEARCH_ALL_USERS",
			value1 = "Search All Users"
		);

		CPUsersandorganizationsViewusers.showBasicSearch();

		Type(
			locator1 = "CPUsersandorganizationsViewusers#BASIC_SEARCH_FIELD",
			value1 = "${userScreenName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPUsersandorganizationsViewusers#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsViewusers#USER_TABLE_FIRST_NAME_1",
			value1 = "${userFirstName}"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsViewusers#USER_TABLE_LAST_NAME_1",
			value1 = "${userLastName}"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsViewusers#USER_TABLE_SCREEN_NAME_1",
			value1 = "${userScreenName}"
		);

		Click(
			locator1 = "CPUsersandorganizationsViewusers#USER_TABLE_FIRST_NAME_1",
			value1 = "${userFirstName}"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsUser#DETAILS_SCREEN_NAME_FIELD",
			value1 = "${userScreenName}"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsUser#DETAILS_EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsUser#DETAILS_FIRST_NAME_FIELD",
			value1 = "${userFirstName}"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsUser#DETAILS_LAST_NAME_FIELD",
			value1 = "${userLastName}"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsUser#USER_NAME",
			value1 = "${userFirstName} ${userLastName}"
		);
	}
}