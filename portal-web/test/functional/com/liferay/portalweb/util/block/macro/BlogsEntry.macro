definition {
	macro addCP {
		AssertClick(locator1 = "CPBlogs#ADD_ENTRY", value1 = "Add");

		Type(locator1 = "CPBlogsAdd#TITLE_FIELD", value1 = "${entryTitle}");

		SelectFrame(locator1 = "CPBlogsAdd#CONTENT_FIELD");

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "CPBlogsAdd#CONTENT_FIELD",
			value1 = "${entryContent}"
		);

		AssertClick.assertValueClickAtCKEditor(
			locator1 = "CPBlogsAdd#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		var key_entryTitle = "${entryTitle}";

		AssertTextEquals(
			locator1 = "CPBlogs#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "CPBlogs#ENTRY_TABLE_TITLE",
			value1 = "${entryTitle}"
		);

		AssertClick(locator1 = "CPBlogs#ENTRY_TABLE_TITLE", value1 = "${entryTitle}");

		AssertTextEquals(
			locator1 = "CPBlogsEntry#ENTRY_TITLE_HEADER",
			value1 = "${entryTitle}"
		);

		AssertTextEquals(
			locator1 = "CPBlogsEntry#ENTRY_CONTENT",
			value1 = "${entryContent}"
		);
	}

	macro addCPWithWorkflow {
		AssertClick(locator1 = "CPBlogs#ADD_ENTRY", value1 = "Add");

		Type(locator1 = "CPBlogsAdd#TITLE_FIELD", value1 = "${entryTitle}");

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "CPBlogsAdd#CONTENT_FIELD",
			value1 = "${entryContent}"
		);

		AssertClick.assertValueClickAtCKEditor(
			locator1 = "CPBlogsAdd#SUBMIT_FOR_PUBLICATION_BUTTON",
			value1 = "Submit for Publication"
		);

		var key_entryTitle = "${entryTitle}";

		AssertTextEquals(
			locator1 = "CPBlogs#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "CPBlogs#ENTRY_TABLE_TITLE",
			value1 = "${entryTitle}"
		);

		AssertClick(locator1 = "CPBlogs#ENTRY_TABLE_TITLE", value1 = "${entryTitle}");

		AssertTextEquals(
			locator1 = "CPBlogsEntry#ENTRY_TITLE_HEADER",
			value1 = "${entryTitle}"
		);

		AssertTextEquals(
			locator1 = "CPBlogsEntry#ENTRY_WORKFLOW_STATUS",
			value1 = "Pending Approval"
		);

		AssertTextEquals(
			locator1 = "CPBlogsEntry#ENTRY_TITLE_LINK",
			value1 = "${entryTitle}"
		);

		AssertTextEquals(
			locator1 = "CPBlogsEntry#ENTRY_CONTENT",
			value1 = "${entryContent}"
		);
	}

	macro addNoPermissionPG {
		AssertElementNotPresent(
			locator1 = "PGBlogs#ADD_ENTRY_BUTTON",
			value1 = "Add Blogs Entry"
		);
	}

	macro addPG {
		AssertClick.assertValueClickAt(
			locator1 = "PGBlogs#ADD_ENTRY_BUTTON",
			value1 = "Add Blog Entry"
		);

		if (isSet(number)) {
			var number = "${number}";

			Type(locator1 = "PGBlogsAdd#TITLE_FIELD", value1 = "${entryTitle}${number}");

			SelectFrame(locator1 = "PGBlogsAdd#CONTENT_FIELD");

			Type.typeCKEditorWaitForCKEditor(
				locator1 = "PGBlogsAdd#CONTENT_FIELD",
				value1 = "${entryContent}${number}"
			);

			AssertClick.assertValueClickAtCKEditor(
				locator1 = "PGBlogsAdd#PUBLISH_BUTTON",
				value1 = "Publish"
			);

			AssertTextEquals.assertText(
				locator1 = "PGBlogs#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);

			AssertTextEquals(
				locator1 = "PGBlogs#ENTRY_TITLE_INCREMENT",
				value1 = "${entryTitle}${number}"
			);

			AssertTextEquals(
				locator1 = "PGBlogs#ENTRY_CONTENT_INCREMENT",
				value1 = "${entryContent}${number}"
			);
		}
		else {
			Type(locator1 = "PGBlogsAdd#TITLE_FIELD", value1 = "${entryTitle}");

			Type.typeCKEditorWaitForCKEditor(
				locator1 = "PGBlogsAdd#CONTENT_FIELD",
				value1 = "${entryContent}"
			);

			AssertClick.assertValueClickAtCKEditor(
				locator1 = "PGBlogsAdd#PUBLISH_BUTTON",
				value1 = "Publish"
			);

			AssertTextEquals.assertText(
				locator1 = "PGBlogs#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);

			AssertTextEquals(locator1 = "PGBlogs#ENTRY_TITLE_1", value1 = "${entryTitle}");

			AssertTextEquals(
				locator1 = "PGBlogs#ENTRY_CONTENT_1",
				value1 = "${entryContent}"
			);
		}
	}

	macro deleteNoPermissionPG {
		AssertElementNotPresent(locator1 = "PGBlogs#ENTRY_DELETE_1");
	}

	macro deletePG {
		AssertTextEquals(locator1 = "PGBlogs#ENTRY_TITLE_1", value1 = "${entryTitle}");

		AssertTextEquals(
			locator1 = "PGBlogs#ENTRY_CONTENT_1",
			value1 = "${entryContent}"
		);

		AssertClickNoError(locator1 = "PGBlogs#ENTRY_DELETE_1", value1 = "Delete");

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextEquals.assertText(
			locator1 = "PGBlogs#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextNotPresent(value1 = "${entryTitle}");

		AssertTextNotPresent(value1 = "${entryContent}");
	}

	macro editPG {
		AssertTextEquals(locator1 = "PGBlogs#ENTRY_TITLE_1", value1 = "${entryTitle}");

		AssertTextEquals(
			locator1 = "PGBlogs#ENTRY_CONTENT_1",
			value1 = "${entryContent}"
		);

		AssertClick(locator1 = "PGBlogs#ENTRY_EDIT_1", value1 = "Edit");

		Type(locator1 = "PGBlogsEdit#TITLE_FIELD", value1 = "${entryTitleEdit}");

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "PGBlogsEdit#CONTENT_FIELD",
			value1 = "${entryContentEdit}"
		);

		AssertClick.assertValueClickAtCKEditor(
			locator1 = "PGBlogsEdit#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals.assertText(
			locator1 = "PGBlogs#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "PGBlogs#ENTRY_TITLE_1",
			value1 = "${entryTitleEdit}"
		);

		AssertTextEquals(
			locator1 = "PGBlogs#ENTRY_CONTENT_1",
			value1 = "${entryContentEdit}"
		);
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Blogs");

		if (IsElementPresent.isVisible(locator1 = "CPBlogs#ENTRY_TABLE_ALL_CHECKBOX")) {
			Click(locator1 = "CPBlogs#ENTRY_TABLE_ALL_CHECKBOX");

			AssertClickNoError(locator1 = "CPBlogs#DELETE_BUTTON", value1 = "Delete");

			Confirm(value1 = "Are you sure you want to delete the selected entries?");
		}
	}

	macro viewCP {
		var key_entryTitle = "${entryTitle}";

		AssertTextEquals(
			locator1 = "CPBlogs#ENTRY_TABLE_TITLE",
			value1 = "${entryTitle}"
		);

		AssertClick(locator1 = "CPBlogs#ENTRY_TABLE_TITLE", value1 = "${entryTitle}");

		AssertTextEquals(
			locator1 = "CPBlogsEntry#ENTRY_TITLE_HEADER",
			value1 = "${entryTitle}"
		);

		AssertTextEquals(
			locator1 = "CPBlogsEntry#ENTRY_TITLE_LINK",
			value1 = "${entryTitle}"
		);

		AssertTextEquals(
			locator1 = "CPBlogsEntry#ENTRY_CONTENT",
			value1 = "${entryContent}"
		);

		AssertElementNotPresent(locator1 = "CPBlogsEntry#ENTRY_WORKFLOW_STATUS");
	}

	macro viewCPWithWorkflow {
		var key_entryTitle = "${entryTitle}";

		AssertTextEquals(
			locator1 = "CPBlogs#ENTRY_TABLE_TITLE",
			value1 = "${entryTitle}"
		);

		AssertClick(locator1 = "CPBlogs#ENTRY_TABLE_TITLE", value1 = "${entryTitle}");

		AssertTextEquals(
			locator1 = "CPBlogsEntry#ENTRY_TITLE_HEADER",
			value1 = "${entryTitle}"
		);

		AssertTextEquals(
			locator1 = "CPBlogsEntry#ENTRY_WORKFLOW_STATUS",
			value1 = "Pending Approval"
		);

		AssertTextEquals(
			locator1 = "CPBlogsEntry#ENTRY_TITLE_LINK",
			value1 = "${entryTitle}"
		);

		AssertTextEquals(
			locator1 = "CPBlogsEntry#ENTRY_CONTENT",
			value1 = "${entryContent}"
		);
	}

	macro viewPG {
		AssertElementPresent(locator1 = "PGBlogs#SEARCH_FIELD");

		AssertElementPresent(locator1 = "PGBlogs#SEARCH_BUTTON");

		AssertElementPresent(locator1 = "PGBlogs#ADD_ENTRY_BUTTON");

		AssertElementPresent(locator1 = "PGBlogs#PERMISSIONS_BUTTON");

		AssertTextEquals(locator1 = "PGBlogs#ENTRY_TITLE_1", value1 = "${entryTitle}");

		AssertElementPresent(locator1 = "PGBlogs#ENTRY_DATE_1");

		AssertTextEquals(locator1 = "PGBlogs#ENTRY_EDIT_1", value1 = "Edit");

		AssertTextEquals(
			locator1 = "PGBlogs#ENTRY_PERMISSIONS_1",
			value1 = "Permissions"
		);

		AssertTextEquals(locator1 = "PGBlogs#ENTRY_DELETE_1", value1 = "Delete");

		AssertTextEquals(
			locator1 = "PGBlogs#ENTRY_CONTENT_1",
			value1 = "${entryContent}"
		);

		if (isSet(entryAuthorMiddleName)) {
			AssertTextEquals(
				locator1 = "PGBlogs#ENTRY_AUTHOR_1",
				value1 = "By ${entryAuthorFirstName} ${entryAuthorMiddleName} ${entryAuthorLastName}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "PGBlogs#ENTRY_AUTHOR_1",
				value1 = "By ${entryAuthorFirstName} ${entryAuthorLastName}"
			);
		}

		AssertTextEquals(locator1 = "PGBlogs#ENTRY_FLAG_1", value1 = "Flag");

		AssertElementPresent(locator1 = "PGBlogs#ENTRY_TWITTER_1");

		AssertElementPresent(locator1 = "PGBlogs#ENTRY_FACEBOOK_1");

		AssertElementPresent(locator1 = "PGBlogs#ENTRY_GOOGLE_1");

		AssertTextEquals.assertPartialText(
			locator1 = "PGBlogs#ENTRY_YOUR_RATING_1",
			value1 = "Your Rating"
		);

		AssertTextEquals(locator1 = "PGBlogs#RSS_LINK", value1 = "RSS");

		AssertTextEquals(locator1 = "PGBlogs#SUBSCRIBE_LINK", value1 = "Subscribe");
	}

	macro viewPGDetails {
		Click(locator1 = "PGBlogs#ENTRY_TITLE_1", value1 = "${entryTitle}");

		AssertTextEquals(
			locator1 = "PGBlogsEntry#ENTRY_TITLE",
			value1 = "${entryTitle}"
		);

		AssertTextEquals(
			locator1 = "PGBlogsEntry#ENTRY_CONTENT",
			value1 = "${entryContent}"
		);

		if (isSet(entryAuthorMiddleName)) {
			AssertTextEquals(
				locator1 = "PGBlogsEntry#ENTRY_AUTHOR",
				value1 = "By ${entryAuthorFirstName} ${entryAuthorMiddleName} ${entryAuthorLastName}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "PGBlogsEntry#ENTRY_AUTHOR",
				value1 = "By ${entryAuthorFirstName} ${entryAuthorLastName}"
			);
		}

		AssertTextEquals.assertPartialText(
			locator1 = "PGBlogsEntry#ENTRY_YOUR_RATING",
			value1 = "Your Rating"
		);

		AssertTextEquals(locator1 = "PGBlogsEntry#PREVIOUS", value1 = "Previous");

		AssertTextEquals(locator1 = "PGBlogsEntry#NEXT", value1 = "Next");

		AssertTextEquals(locator1 = "PGBlogsEntry#COMMENTS", value1 = "Comments");
	}

	macro viewPortletPG {
		AssertElementPresent(
			locator1 = "PGBlogs#ADD_ENTRY_BUTTON",
			value1 = "Add Blog Entry"
		);

		AssertElementPresent(
			locator1 = "PGBlogs#PERMISSIONS_BUTTON",
			value1 = "Permissions"
		);

		AssertTextEquals.assertText(
			locator1 = "PGBlogs#PORTLET_TITLE",
			value1 = "Blogs"
		);

		AssertTextEquals(locator1 = "PGBlogs#RSS_LINK", value1 = "RSS");

		AssertTextEquals(locator1 = "PGBlogs#SUBSCRIBE_LINK", value1 = "Subscribe");
	}

	macro viewPortletPGasGuest {
		AssertElementNotPresent(
			locator1 = "PGBlogs#ADD_ENTRY_BUTTON",
			value1 = "Add Blog Entry"
		);

		AssertElementNotPresent(
			locator1 = "PGBlogs#PERMISSIONS_BUTTON",
			value1 = "Permissions"
		);

		AssertTextEquals.assertText(
			locator1 = "PGBlogs#PORTLET_TITLE",
			value1 = "Blogs"
		);

		AssertTextEquals(locator1 = "PGBlogs#RSS_LINK", value1 = "RSS");

		AssertTextNotPresent(locator1 = "PGBlogs#SUBSCRIBE_LINK", value1 = "Subscribe");
	}
}