definition {
	macro viewBlogsEntryRecentBlogs {
		AssertTextEquals(
			locator1 = "SOBlogs#RECENT_BLOGS_ENTRY_TITLE",
			value1 = "${entryTitle}"
		);

		if (isSet(entryAuthorMiddleName)) {
			AssertTextEquals.assertPartialText(
				locator1 = "SOBlogs#RECENT_BLOGS_ENTRY_AUTHOR",
				value1 = "By ${entryAuthorFirstName} ${entryAuthorMiddleName} ${entryAuthorLastName}"
			);
		}
		else {
			AssertTextEquals.assertPartialText(
				locator1 = "SOBlogs#RECENT_BLOGS_ENTRY_AUTHOR",
				value1 = "By ${entryAuthorFirstName} ${entryAuthorLastName}"
			);
		}

		AssertElementPresent(locator1 = "SOBlogs#RECENT_BLOGS_ENTRY_DATE");

		AssertClick.assertPartialTextClickAt(
			locator1 = "SOBlogs#RECENT_BLOGS_ENTRY_READ_MORE_LINK",
			value1 = "Read More"
		);

		AssertTextEquals(
			locator1 = "PGBlogsEntry#ENTRY_TITLE",
			value1 = "${entryTitle}"
		);

		AssertTextEquals(
			locator1 = "PGBlogsEntry#ENTRY_CONTENT",
			value1 = "${entryContent}"
		);

		if (isSet(entryAuthorMiddleName)) {
			AssertTextEquals(
				locator1 = "PGBlogsEntry#ENTRY_AUTHOR",
				value1 = "By ${entryAuthorFirstName} ${entryAuthorMiddleName} ${entryAuthorLastName}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "PGBlogsEntry#ENTRY_AUTHOR",
				value1 = "By ${entryAuthorFirstName} ${entryAuthorLastName}"
			);
		}

		AssertTextEquals.assertPartialText(
			locator1 = "PGBlogsEntry#ENTRY_YOUR_RATING",
			value1 = "Your Rating"
		);

		AssertTextEquals(locator1 = "PGBlogsEntry#PREVIOUS", value1 = "Previous");

		AssertTextEquals(locator1 = "PGBlogsEntry#NEXT", value1 = "Next");

		AssertTextEquals(locator1 = "PGBlogsEntry#COMMENTS", value1 = "Comments");
	}
}