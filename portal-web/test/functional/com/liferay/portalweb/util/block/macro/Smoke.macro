definition {
	@summary-ignore = "true"
	macro runSmoke {
		Page.addPG(pageName = "Test Page1");

		Page.addPG(pageName = "Test Page2");

		Page.addPG(pageName = "Test Page3");

		var pageName = "Test Page1";
		var portletBody = "Welcome to Liferay Portal";
		var portletName = "Hello World";

		task ("Add a '${portletName}' portlet to the page named '${pageName}'") {
			Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");

			Portlet.viewTitle(portletName = "${portletName}");

			Portlet.viewBody(portletBody = "${portletBody}", portletName = "${portletName}");

			Page.gotoPG(pageName = "${pageName}");

			Portlet.viewTitle(portletName = "${portletName}");

			Portlet.viewBody(portletBody = "${portletBody}", portletName = "${portletName}");
		}

		var portletName = "Blogs";
		var portletTitle = "Blogs";

		task ("Navigate to Go to > Control Panel > ${portletName}") {
			Page.gotoCP(portletName = "${portletName}");

			ControlPanel.viewPortletTitle(portletTitle = "${portletTitle}");
		}
	}
}