definition {
	macro addPG {
		var key_dmFolderName = "${dmFolderName}";

		if (isSet(number)) {
			var number = "${number}";

			Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER_INCREMENT");

			AssertClick(locator1 = "PGDocumentsandmediaFolder#TOOLBAR_ADD", value1 = "Add");

			AssertClick(
				locator1 = "PGDocumentsandmediaFolder#ADD_MENULIST_BASIC_DOCUMENT",
				value1 = "Basic Document"
			);

			UploadCommonFile(
				locator1 = "PGDocumentsandmediaAdddocument#FILE_FIELD",
				value1 = "${dmDocumentFile}"
			);

			Type(
				locator1 = "PGDocumentsandmediaAdddocument#TITLE_FIELD",
				value1 = "${dmDocumentTitle}${number}"
			);

			Type(
				locator1 = "PGDocumentsandmediaAdddocument#DESCRIPTION_FIELD",
				value1 = "${dmDocumentDescription}${number}"
			);

			AssertClick.assertValueClickAt(
				locator1 = "PGDocumentsandmediaAdddocument#PUBLISH_BUTTON",
				value1 = "Publish"
			);
		}
		else {
			Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

			AssertClick(locator1 = "PGDocumentsandmediaFolder#TOOLBAR_ADD", value1 = "Add");

			AssertClick(
				locator1 = "PGDocumentsandmediaFolder#ADD_MENULIST_BASIC_DOCUMENT",
				value1 = "Basic Document"
			);

			UploadCommonFile(
				locator1 = "PGDocumentsandmediaAdddocument#FILE_FIELD",
				value1 = "${dmDocumentFile}"
			);

			Type(
				locator1 = "PGDocumentsandmediaAdddocument#TITLE_FIELD",
				value1 = "${dmDocumentTitle}"
			);

			Type(
				locator1 = "PGDocumentsandmediaAdddocument#DESCRIPTION_FIELD",
				value1 = "${dmDocumentDescription}"
			);

			AssertClick.assertValueClickAt(
				locator1 = "PGDocumentsandmediaAdddocument#PUBLISH_BUTTON",
				value1 = "Publish"
			);
		}

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaFolder#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro addPGviaDMD {
		AssertClick.assertTextClickAt(
			locator1 = "PGDocumentlibrarydisplay#FOLDERS_TABLE_NAME_1",
			value1 = "${dmdFolderName}"
		);

		Click(
			locator1 = "PGDocumentlibrarydisplayFolder#SUBFOLDER_MENU_ADD_DOCUMENT",
			value1 = "${dmdDocumentTitle}"
		);

		SelectFrame.selectFrameWaitForScript(
			locator1 = "PGDocumentlibrarydisplayAdddocument#SELECT_DOCUMENT_TYPE_IFRAME"
		);

		AssertClick.assertTextClickAt(
			locator1 = "PGDocumentlibrarydisplayAdddocument#SELECT_DOCUMENT_TYPE_BASIC_DOCUMENT",
			value1 = "Basic Document"
		);

		SelectFrame();

		UploadCommonFile(
			locator1 = "PGDocumentlibrarydisplayAdddocument#DOCUMENT_FILE_FIELD",
			value1 = "${dmdDocumentFile}"
		);

		Type(
			locator1 = "PGDocumentlibrarydisplayAdddocument#DOCUMENT_TITLE_FIELD",
			value1 = "${dmdDocumentTitle}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGDocumentlibrarydisplayAdddocument#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplayFolder#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplayFolder#DOCUMENTS_TABLE_NAME_1",
			value1 = "${dmdDocumentTitle}"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplayFolder#DOCUMENTS_TABLE_SIZE_1",
			value1 = "${dmdDocumentSize}"
		);

		AssertClick.assertTextClickAt(
			locator1 = "PGDocumentlibrarydisplayFolder#DOCUMENTS_TABLE_NAME_1",
			value1 = "${dmdDocumentTitle}"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplayDocument#DOCUMENT_HEADER_TITLE",
			value1 = "${dmdDocumentTitle}"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplayDocument#DOCUMENT_TITLE",
			value1 = "${dmdDocumentTitle}"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplayDocument#DOCUMENT_VERSION",
			value1 = "Version 1.0"
		);
	}

	macro addPGviaMG {
		AssertTextEquals(
			locator1 = "PGMediagallery#ENTRY_TITLE",
			value1 = "${mgFolderName}"
		);

		AssertClick(locator1 = "PGMediagallery#ENTRY_TITLE", value1 = "${mgFolderName}");

		AssertTextEquals(
			locator1 = "PGMediagalleryFolder#INFO_MESSAGE",
			value1 = "There are no media files in this folder."
		);

		AssertClick(
			locator1 = "PGMediagalleryFolder#FOLDER_MENU_ADD_MEDIA",
			value1 = "Add Media"
		);

		SelectFrame(locator1 = "PGMediagallerySelectmediatype#SELECT_MEDIA_TYPE_IFRAME");

		AssertClick(
			locator1 = "PGMediagallerySelectmediatype#MEDIA_TABLE_BASIC_DOCUMENT",
			value1 = "Basic Document"
		);

		SelectFrame();

		UploadCommonFile(
			locator1 = "PGMediagalleryAddmedia#FILE",
			value1 = "${mgDocumentFile}"
		);

		Type(
			locator1 = "PGMediagalleryAddmedia#TITLE_FIELD",
			value1 = "${mgDocumentTitle}"
		);

		Type(
			locator1 = "PGMediagalleryAddmedia#DESCRIPTION_FIELD",
			value1 = "${mgDocumentDescription}"
		);

		AssertClick(
			locator1 = "PGMediagalleryAddmedia#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals(
			locator1 = "PGMediagalleryAddmedia#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "PGMediagallery#ENTRY_TITLE",
			value1 = "${mgFolderName}"
		);

		AssertClick(locator1 = "PGMediagallery#ENTRY_TITLE", value1 = "${mgFolderName}");

		AssertElementPresent(locator1 = "PGMediagalleryFolder#MEDIA_THUMBNAIL");

		AssertElementPresent(
			locator1 = "PGMediagalleryFolder#MEDIA_TITLE",
			value1 = "${mgDocumentTitle}"
		);
	}

	macro cancelCheckoutPG {
		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		var key_dmDocumentTitle = "${dmDocumentTitle}";

		AssertElementPresent(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#CHECKOUT_SUCCESS_MESSAGE",
			value1 = "You now have a lock on this document. No one else can edit this document until you unlock it. This lock will automatically expire in 1 day."
		);

		if (IsElementPresent(locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE")) {
			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SODocuments#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}

		if (IsElementPresent(locator1 = "SODocuments#VERSION_HISTORY_TITLE")) {
			var versionNumber = "PWC";

			AssertTextEquals(
				locator1 = "SODocuments#VERSION_HISTORY_NUMBER",
				value1 = "Version PWC"
			);
		}

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#DOCUMENT_DETAILS_VERSION",
			value1 = "Version PWC"
		);

		AssertClick(
			locator1 = "PGDocumentsandmediaDocument#TOOLBAR_CANCEL_CHECKOUT_BUTTON",
			value1 = "Cancel Checkout"
		);

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro checkinPG {
		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		var key_dmDocumentTitle = "${dmDocumentTitle}";

		AssertElementPresent(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

		if (IsElementPresent(locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE")) {
			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SODocuments#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#CHECKOUT_SUCCESS_MESSAGE",
			value1 = "You now have a lock on this document. No one else can edit this document until you unlock it. This lock will automatically expire in 1 day."
		);

		AssertClick(
			locator1 = "PGDocumentsandmediaDocument#TOOLBAR_CHECKIN_BUTTON",
			value1 = "Checkin"
		);

		if ("${revision}" == "Major") {
			Click(locator1 = "PGDocumentsandmediaCheckin#MAJOR_REVISION");
		}
		else {
			Click(locator1 = "PGDocumentsandmediaCheckin#MINOR_REVISION");
		}

		if (isSet(changeLog)) {
			Type(
				locator1 = "PGDocumentsandmediaCheckin#CHANGE_LOG",
				value1 = "${changeLog}"
			);
		}

		AssertClick(
			locator1 = "PGDocumentsandmediaCheckin#SAVE_AND_CHECKIN_BUTTON",
			value1 = "Save and Checkin"
		);
	}

	macro checkoutPG {
		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		var key_dmDocumentTitle = "${dmDocumentTitle}";

		AssertElementPresent(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

		if (IsElementPresent(locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE")) {
			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SODocuments#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}

		AssertClick(
			locator1 = "PGDocumentsandmediaDocument#TOOLBAR_CHECKOUT_BUTTON",
			value1 = "Checkout"
		);

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#CHECKOUT_SUCCESS_MESSAGE",
			value1 = "You now have a lock on this document. No one else can edit this document until you unlock it. This lock will automatically expire in 1 day."
		);
	}

	macro deletePG {
		var key_dmFolderName = "${dmFolderName}";

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		var key_dmDocumentTitle = "${dmDocumentTitle}";

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

		if (IsElementPresent(locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE")) {
			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SODocuments#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}

		AssertClickNoError(
			locator1 = "PGDocumentsandmediaDocument#TOOLBAR_DELETE_BUTTON",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this entry?");

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertElementNotPresent(
			locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE"
		);
	}

	macro deletePGviaMG {
		AssertTextEquals(
			locator1 = "PGMediagallery#ENTRY_TITLE",
			value1 = "${mgFolderName}"
		);

		AssertClick(locator1 = "PGMediagallery#ENTRY_TITLE", value1 = "${mgFolderName}");

		AssertClick(
			locator1 = "PGMediagalleryFolder#MEDIA_TITLE",
			value1 = "${mgDocumentTitle}"
		);

		ClickNoError(locator1 = "PGMediagalleryMedia#DELETE_ICON");

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextEquals(
			locator1 = "PGMediagalleryFolder#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "PGMediagalleryFolder#INFO_MESSAGE",
			value1 = "There are no media files in this folder."
		);
	}

	macro editPG {
		var key_dmFolderName = "${dmFolderName}";

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		var key_dmDocumentTitle = "${dmDocumentTitle}";

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

		if (IsElementPresent(locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE")) {
			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SODocuments#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}

		AssertClick(
			locator1 = "PGDocumentsandmediaDocument#TOOLBAR_EDIT_BUTTON",
			value1 = "Edit"
		);

		if (isSet(dmDocumentFile2)) {
			UploadCommonFile(
				locator1 = "PGDocumentsandmediaAdddocument#FILE_FIELD",
				value1 = "${dmDocumentFile2}"
			);
		}

		Type(
			locator1 = "PGDocumentsandmediaEditdocument#TITLE_FIELD",
			value1 = "${dmDocumentTitleEdit}"
		);

		Type(
			locator1 = "PGDocumentsandmediaEditdocument#DESCRIPTION_FIELD",
			value1 = "${dmDocumentDescriptionEdit}"
		);

		if (IsElementPresent(locator1 = "PGDocumentsandmediaEditdocument#MAJOR_REVISION")) {
			if ("${revision}" == "Major") {
				Click(locator1 = "PGDocumentsandmediaCheckin#MAJOR_REVISION");
			}
			else {
				Click(locator1 = "PGDocumentsandmediaCheckin#MINOR_REVISION");
			}

			if (isSet(changeLog)) {
				Type(
					locator1 = "PGDocumentsandmediaCheckin#CHANGE_LOG",
					value1 = "${changeLog}"
				);
			}

			AssertClick(
				locator1 = "PGDocumentsandmediaEditdocument#SAVE_AND_CHECKIN_BUTTON",
				value1 = "Save and Checkin"
			);
		}
		else {
			AssertClick(
				locator1 = "PGDocumentsandmediaEditdocument#PUBLISH_BUTTON",
				value1 = "Publish"
			);
		}

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		if (IsElementPresent(locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE")) {
			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitleEdit}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SODocuments#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitleEdit}"
			);
		}
	}

	macro editPGviaMG {
		AssertTextEquals(
			locator1 = "PGMediagallery#ENTRY_TITLE",
			value1 = "${mgFolderName}"
		);

		AssertClick(locator1 = "PGMediagallery#ENTRY_TITLE", value1 = "${mgFolderName}");

		AssertClick(
			locator1 = "PGMediagalleryFolder#MEDIA_TITLE",
			value1 = "${mgDocumentTitle}"
		);

		AssertTextEquals(
			locator1 = "PGMediagalleryMedia#MEDIA_CAPTION",
			value1 = "${mgDocumentTitle} - ${mgDocumentDescription}"
		);

		Click(locator1 = "PGMediagalleryMedia#EDIT_ICON");

		Type(
			locator1 = "PGMediagalleryEditmedia#TITLE_FIELD",
			value1 = "${mgDocumentTitleEdit}"
		);

		Type(
			locator1 = "PGMediagalleryEditmedia#DESCRIPTION_FIELD",
			value1 = "${mgDocumentDescriptionEdit}"
		);

		AssertClick(
			locator1 = "PGMediagalleryEditmedia#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals(
			locator1 = "PGMediagalleryEditmedia#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "PGMediagalleryFolder#MEDIA_TITLE",
			value1 = "${mgDocumentTitleEdit}"
		);
	}

	macro moveToFolderPG {
		var key_dmFolderName = "${dmFolderName}";

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		Check(locator1 = "PGDocumentsandmediaFolder#FOLDER_ENTRIES_DOCUMENT_SELECT");

		AssertClick(
			locator1 = "PGDocumentsandmediaFolder#TOOLBAR_ACTIONS",
			value1 = "Actions"
		);

		AssertClick(
			locator1 = "PGDocumentsandmediaFolder#ACTIONS_MENULIST_MOVE",
			value1 = "Move"
		);

		AssertClick(locator1 = "PGDocumentsandmediaMovefiles#SELECT", value1 = "Select");

		SelectWindow(locator1 = "PGDocumentsandmediaMovefiles#SELECT_POP_UP");

		AssertClick(
			locator1 = "PGDocumentsandmediaMovefiles#SELECT_POP_UP_CHOOSE_2",
			value1 = "Choose"
		);

		SelectWindow();

		AssertClick.assertValueClickAt(
			locator1 = "PGDocumentsandmediaMovefiles#MOVE",
			value1 = "Move"
		);

		AssertTextEquals(
			locator1 = "PGDocumentsandmedia#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro publishDraftDMFolderDocument {
		var key_dmFolderName = "${dmFolderName}";

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		var key_dmDocumentTitle = "${dmDocumentTitle}";

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

		if (IsElementPresent(locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE")) {
			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SODocuments#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}

		AssertClick(
			locator1 = "PGDocumentsandmediaDocument#TOOLBAR_EDIT_BUTTON",
			value1 = "Edit"
		);

		AssertClick(
			locator1 = "PGDocumentsandmediaEditdocument#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro saveAsDraftEditDMFolderDocument {
		var key_dmFolderName = "${dmFolderName}";

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		var key_dmDocumentTitle = "${dmDocumentTitle}";

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

		if (IsElementPresent(locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE")) {
			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SODocuments#DOCUMENT_INFO_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}

		AssertClick(
			locator1 = "PGDocumentsandmediaDocument#TOOLBAR_EDIT_BUTTON",
			value1 = "Edit"
		);

		if (isSet(dmDocumentFile2)) {
			UploadCommonFile(
				locator1 = "PGDocumentsandmediaAdddocument#FILE_FIELD",
				value1 = "${dmDocumentFile2}"
			);
		}

		Type(
			locator1 = "PGDocumentsandmediaEditdocument#TITLE_FIELD",
			value1 = "${dmDocumentTitleEdit}"
		);

		Type(
			locator1 = "PGDocumentsandmediaEditdocument#DESCRIPTION_FIELD",
			value1 = "${dmDocumentDescriptionEdit}"
		);

		if (IsElementPresent(locator1 = "PGDocumentsandmediaEditdocument#MAJOR_REVISION")) {
			if ("${revision}" == "Major") {
				Click(locator1 = "PGDocumentsandmediaCheckin#MAJOR_REVISION");
			}
			else {
				Click(locator1 = "PGDocumentsandmediaCheckin#MINOR_REVISION");
			}

			if (isSet(changeLog)) {
				Type(
					locator1 = "PGDocumentsandmediaCheckin#CHANGE_LOG",
					value1 = "${changeLog}"
				);
			}
		}

		AssertClick(
			locator1 = "PGDocumentsandmediaEditdocument#SAVE_AS_DRAFT_BUTTON",
			value1 = "Save as Draft"
		);

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaEditdocument#STATUS",
			value1 = "Draft"
		);
	}

	macro saveAsDraftPG {
		if (isSet(number)) {
			var number = "${number}";

			Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER_INCREMENT");

			AssertClick(locator1 = "PGDocumentsandmediaFolder#TOOLBAR_ADD", value1 = "Add");

			AssertClick(
				locator1 = "PGDocumentsandmediaFolder#ADD_MENULIST_BASIC_DOCUMENT",
				value1 = "Basic Document"
			);

			UploadCommonFile(
				locator1 = "PGDocumentsandmediaAdddocument#FILE_FIELD",
				value1 = "${dmDocumentFile}"
			);

			Type(
				locator1 = "PGDocumentsandmediaAdddocument#TITLE_FIELD",
				value1 = "${dmDocumentTitle}${number}"
			);

			Type(
				locator1 = "PGDocumentsandmediaAdddocument#DESCRIPTION_FIELD",
				value1 = "${dmDocumentDescription}${number}"
			);

			AssertClick(
				locator1 = "PGDocumentsandmediaAdddocument#SAVE_AS_DRAFT_BUTTON",
				value1 = "Save as Draft"
			);
		}
		else {
			Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

			AssertClick(locator1 = "PGDocumentsandmediaFolder#TOOLBAR_ADD", value1 = "Add");

			AssertClick(
				locator1 = "PGDocumentsandmediaFolder#ADD_MENULIST_BASIC_DOCUMENT",
				value1 = "Basic Document"
			);

			UploadCommonFile(
				locator1 = "PGDocumentsandmediaAdddocument#FILE_FIELD",
				value1 = "${dmDocumentFile}"
			);

			Type(
				locator1 = "PGDocumentsandmediaAdddocument#TITLE_FIELD",
				value1 = "${dmDocumentTitle}"
			);

			Type(
				locator1 = "PGDocumentsandmediaAdddocument#DESCRIPTION_FIELD",
				value1 = "${dmDocumentDescription}"
			);

			AssertClick(
				locator1 = "PGDocumentsandmediaAdddocument#SAVE_AS_DRAFT_BUTTON",
				value1 = "Save as Draft"
			);
		}

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaFolder#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro searchNoPGviaDMD {
		Type(
			locator1 = "PGDocumentlibrarydisplaySearch#SEARCH_FIELD",
			value1 = "${dmdDocumentTitleSearch}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGDocumentlibrarydisplaySearch#SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplaySearch#INFO_MESSAGE",
			value1 = "No documents were found that matched the keywords: ${dmdDocumentTitleSearch}."
		);
	}

	macro searchPGviaDMD {
		Type(
			locator1 = "PGDocumentlibrarydisplay#SEARCH_FIELD",
			value1 = "${dmdDocumentTitleSearch}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGDocumentlibrarydisplay#SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplaySearch#SEARCH_RESULTS_FOLDER",
			value1 = "${dmdFolderName}"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplaySearch#SEARCH_RESULTS_DOCUMENT",
			value1 = "${dmdDocumentTitle}"
		);
	}

	macro viewPG {
