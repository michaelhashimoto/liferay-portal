<definition>
	<command name="addPG">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />

				<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER_INCREMENT" />

				<execute function="AssertClick" locator1="PGDocumentsandmediaFolder#TOOLBAR_ADD" value1="Add" />
				<execute function="AssertClick" locator1="PGDocumentsandmediaFolder#ADD_MENULIST_BASIC_DOCUMENT" value1="Basic Document" />

				<execute function="UploadCommonFile" locator1="PGDocumentsandmediaAdddocument#FILE_FIELD" value1="${dmDocumentFile}" />
				<execute function="Type" locator1="PGDocumentsandmediaAdddocument#TITLE_FIELD" value1="${dmDocumentTitle}${number}" />
				<execute function="Type" locator1="PGDocumentsandmediaAdddocument#DESCRIPTION_FIELD" value1="${dmDocumentDescription}${number}" />
				<execute function="AssertClick#assertValueClickAtAndWait" locator1="PGDocumentsandmediaAdddocument#PUBLISH_BUTTON" value1="Publish" />
			</then>
			<else>
				<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER" />

				<execute function="AssertClick" locator1="PGDocumentsandmediaFolder#TOOLBAR_ADD" value1="Add" />
				<execute function="AssertClick" locator1="PGDocumentsandmediaFolder#ADD_MENULIST_BASIC_DOCUMENT" value1="Basic Document" />

				<execute function="UploadCommonFile" locator1="PGDocumentsandmediaAdddocument#FILE_FIELD" value1="${dmDocumentFile}" />
				<execute function="Type" locator1="PGDocumentsandmediaAdddocument#TITLE_FIELD" value1="${dmDocumentTitle}" />
				<execute function="Type" locator1="PGDocumentsandmediaAdddocument#DESCRIPTION_FIELD" value1="${dmDocumentDescription}" />
				<execute function="AssertClick#assertValueClickAtAndWait" locator1="PGDocumentsandmediaAdddocument#PUBLISH_BUTTON" value1="Publish" />
			</else>
		</if>

		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaFolder#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="addPGviaDMD">
		<execute function="AssertClick#assertTextClickAtAndWait" locator1="PGDocumentlibrarydisplay#FOLDERS_TABLE_NAME_1" value1="${dmdFolderName}" />

		<execute function="Click" locator1="PGDocumentlibrarydisplayFolder#SUBFOLDER_MENU_ADD_DOCUMENT" value1="${dmdDocumentTitle}" />

		<execute function="SelectFrame#selectFrameWaitForScript" locator1="PGDocumentlibrarydisplayAdddocument#SELECT_DOCUMENT_TYPE_IFRAME" />
		<execute function="AssertClick#assertTextClickAtAndWait" locator1="PGDocumentlibrarydisplayAdddocument#SELECT_DOCUMENT_TYPE_BASIC_DOCUMENT" value1="Basic Document" />
		<execute function="SelectFrame" />
		<execute function="UploadCommonFile" locator1="PGDocumentlibrarydisplayAdddocument#DOCUMENT_FILE_FIELD" value1="${dmdDocumentFile}" />
		<execute function="Type" locator1="PGDocumentlibrarydisplayAdddocument#DOCUMENT_TITLE_FIELD" value1="${dmdDocumentTitle}" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="PGDocumentlibrarydisplayAdddocument#PUBLISH_BUTTON" value1="Publish" />

		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplayFolder#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplayFolder#DOCUMENTS_TABLE_NAME_1" value1="${dmdDocumentTitle}" />
		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplayFolder#DOCUMENTS_TABLE_SIZE_1" value1="${dmdDocumentSize}" />
		<execute function="AssertClick#assertTextClickAtAndWait" locator1="PGDocumentlibrarydisplayFolder#DOCUMENTS_TABLE_NAME_1" value1="${dmdDocumentTitle}" />

		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplayDocument#DOCUMENT_HEADER_TITLE" value1="${dmdDocumentTitle}" />
		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplayDocument#DOCUMENT_TITLE" value1="${dmdDocumentTitle}" />
		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplayDocument#DOCUMENT_VERSION" value1="Version 1.0" />
	</command>

	<command name="addPGviaMG">
		<execute function="AssertTextEquals" locator1="PGMediagallery#ENTRY_TITLE" value1="${mgFolderName}" />
		<execute function="AssertClick" locator1="PGMediagallery#ENTRY_TITLE" value1="${mgFolderName}" />

		<execute function="AssertTextEquals" locator1="PGMediagalleryFolder#INFO_MESSAGE" value1="There are no media files in this folder." />
		<execute function="AssertClick" locator1="PGMediagalleryFolder#FOLDER_MENU_ADD_MEDIA" value1="Add Media" />

		<execute function="SelectFrame" locator1="PGMediagallerySelectmediatype#SELECT_MEDIA_TYPE_IFRAME" />
		<execute function="AssertClick" locator1="PGMediagallerySelectmediatype#MEDIA_TABLE_BASIC_DOCUMENT" value1="Basic Document" />
		<execute function="SelectFrame" />

		<execute function="UploadCommonFile" locator1="PGMediagalleryAddmedia#FILE" value1="${mgDocumentFile}" />
		<execute function="Type" locator1="PGMediagalleryAddmedia#TITLE_FIELD" value1="${mgDocumentTitle}" />
		<execute function="Type" locator1="PGMediagalleryAddmedia#DESCRIPTION_FIELD" value1="${mgDocumentDescription}" />
		<execute function="AssertClick" locator1="PGMediagalleryAddmedia#PUBLISH_BUTTON" value1="Publish" />
		<execute function="AssertTextEquals" locator1="PGMediagalleryAddmedia#SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<execute function="AssertTextEquals" locator1="PGMediagallery#ENTRY_TITLE" value1="${mgFolderName}" />
		<execute function="AssertClick" locator1="PGMediagallery#ENTRY_TITLE" value1="${mgFolderName}" />

		<execute function="AssertElementPresent" locator1="PGMediagalleryFolder#MEDIA_THUMBNAIL" />
		<execute function="AssertElementPresent" locator1="PGMediagalleryFolder#MEDIA_TITLE" value1="${mgDocumentTitle}" />
	</command>

	<command name="cancelCheckoutPG">
		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER" />

		<var name="key_dmDocumentTitle" value="${dmDocumentTitle}" />

		<execute function="AssertElementPresent" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT" />
		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT" />

		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#CHECKOUT_SUCCESS_MESSAGE" value1="You now have a lock on this document. No one else can edit this document until you unlock it. This lock will automatically expire in 1 day." />

		<if>
			<condition function="IsElementPresent" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" />
			<then>
				<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="SODocuments#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
			</else>
		</if>

		<if>
			<condition function="IsElementPresent" locator1="SODocuments#VERSION_HISTORY_TITLE" />
			<then>
				<var name="versionNumber" value="PWC" />

				<execute function="AssertTextEquals" locator1="SODocuments#VERSION_HISTORY_NUMBER" value1="Version PWC" />
			</then>
		</if>

		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#DOCUMENT_DETAILS_VERSION" value1="Version PWC" />
		<execute function="AssertClick" locator1="PGDocumentsandmediaDocument#TOOLBAR_CANCEL_CHECKOUT_BUTTON" value1="Cancel Checkout" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="checkinPG">
		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER" />

		<var name="key_dmDocumentTitle" value="${dmDocumentTitle}" />

		<execute function="AssertElementPresent" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT" />
		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT" />

		<if>
			<condition function="IsElementPresent" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" />
			<then>
				<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="SODocuments#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
			</else>
		</if>

		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#CHECKOUT_SUCCESS_MESSAGE" value1="You now have a lock on this document. No one else can edit this document until you unlock it. This lock will automatically expire in 1 day." />
		<execute function="AssertClick" locator1="PGDocumentsandmediaDocument#TOOLBAR_CHECKIN_BUTTON" value1="Checkin" />

		<if>
			<equals arg1="${revision}" arg2="Major" />
			<then>
				<execute function="Click" locator1="PGDocumentsandmediaCheckin#MAJOR_REVISION" />
			</then>
			<else>
				<execute function="Click" locator1="PGDocumentsandmediaCheckin#MINOR_REVISION" />
			</else>
		</if>

		<if>
			<isset var="changeLog" />
			<then>
				<execute function="Type" locator1="PGDocumentsandmediaCheckin#CHANGE_LOG" value1="${changeLog}" />
			</then>
		</if>

		<execute function="AssertClick" locator1="PGDocumentsandmediaCheckin#SAVE_AND_CHECKIN_BUTTON" value1="Save and Checkin" />
	</command>

	<command name="checkoutPG">
		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER" />

		<var name="key_dmDocumentTitle" value="${dmDocumentTitle}" />

		<execute function="AssertElementPresent" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT" />
		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT" />

		<if>
			<condition function="IsElementPresent" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" />
			<then>
				<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="SODocuments#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
			</else>
		</if>

		<execute function="AssertClick" locator1="PGDocumentsandmediaDocument#TOOLBAR_CHECKOUT_BUTTON" value1="Checkout" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#CHECKOUT_SUCCESS_MESSAGE" value1="You now have a lock on this document. No one else can edit this document until you unlock it. This lock will automatically expire in 1 day." />
	</command>

	<command name="deletePG">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER" />

		<var name="key_dmDocumentTitle" value="${dmDocumentTitle}" />

		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT" />

		<if>
			<condition function="IsElementPresent" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" />
			<then>
				<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="SODocuments#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
			</else>
		</if>

		<execute function="AssertClickNoError" locator1="PGDocumentsandmediaDocument#TOOLBAR_DELETE_BUTTON" value1="Delete" />
		<execute function="Confirm" value1="Are you sure you want to delete this entry?" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertElementNotPresent" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" />
	</command>

	<command name="deletePGviaMG">
		<execute function="AssertTextEquals" locator1="PGMediagallery#ENTRY_TITLE" value1="${mgFolderName}" />
		<execute function="AssertClick" locator1="PGMediagallery#ENTRY_TITLE" value1="${mgFolderName}" />

		<execute function="AssertClick" locator1="PGMediagalleryFolder#MEDIA_TITLE" value1="${mgDocumentTitle}" />

		<execute function="ClickNoError" locator1="PGMediagalleryMedia#DELETE_ICON" />
		<execute function="Confirm" value1="Are you sure you want to delete this?" />

		<execute function="AssertTextEquals" locator1="PGMediagalleryFolder#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals" locator1="PGMediagalleryFolder#INFO_MESSAGE" value1="There are no media files in this folder." />
	</command>

	<command name="editPG">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER" />

		<var name="key_dmDocumentTitle" value="${dmDocumentTitle}" />

		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT" />

		<if>
			<condition function="IsElementPresent" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" />
			<then>
				<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="SODocuments#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
			</else>
		</if>

		<execute function="AssertClick" locator1="PGDocumentsandmediaDocument#TOOLBAR_EDIT_BUTTON" value1="Edit" />

		<if>
			<isset var="dmDocumentFile2" />
			<then>
				<execute function="UploadCommonFile" locator1="PGDocumentsandmediaAdddocument#FILE_FIELD" value1="${dmDocumentFile2}" />
			</then>
		</if>

		<execute function="Type" locator1="PGDocumentsandmediaEditdocument#TITLE_FIELD" value1="${dmDocumentTitleEdit}"  />
		<execute function="Type" locator1="PGDocumentsandmediaEditdocument#DESCRIPTION_FIELD" value1="${dmDocumentDescriptionEdit}" />

		<if>
			<condition function="IsElementPresent" locator1="PGDocumentsandmediaEditdocument#MAJOR_REVISION" />
			<then>
				<if>
					<equals arg1="${revision}" arg2="Major" />
					<then>
						<execute function="Click" locator1="PGDocumentsandmediaCheckin#MAJOR_REVISION" />
					</then>
					<else>
						<execute function="Click" locator1="PGDocumentsandmediaCheckin#MINOR_REVISION" />
					</else>
				</if>

				<if>
					<isset var="changeLog" />
					<then>
						<execute function="Type" locator1="PGDocumentsandmediaCheckin#CHANGE_LOG" value1="${changeLog}" />
					</then>
				</if>

				<execute function="AssertClick" locator1="PGDocumentsandmediaEditdocument#SAVE_AND_CHECKIN_BUTTON" value1="Save and Checkin" />
			</then>
			<else>
				<execute function="AssertClick" locator1="PGDocumentsandmediaEditdocument#PUBLISH_BUTTON" value1="Publish" />
			</else>
		</if>

		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<if>
			<condition function="IsElementPresent" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" />
			<then>
				<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitleEdit}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="SODocuments#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitleEdit}" />
			</else>
		</if>
	</command>

	<command name="editPGviaMG">
		<execute function="AssertTextEquals" locator1="PGMediagallery#ENTRY_TITLE" value1="${mgFolderName}" />
		<execute function="AssertClick" locator1="PGMediagallery#ENTRY_TITLE" value1="${mgFolderName}" />

		<execute function="AssertClick" locator1="PGMediagalleryFolder#MEDIA_TITLE" value1="${mgDocumentTitle}" />

		<execute function="AssertTextEquals" locator1="PGMediagalleryMedia#MEDIA_CAPTION" value1="${mgDocumentTitle} - ${mgDocumentDescription}" />
		<execute function="Click" locator1="PGMediagalleryMedia#EDIT_ICON" />

		<execute function="Type" locator1="PGMediagalleryEditmedia#TITLE_FIELD" value1="${mgDocumentTitleEdit}" />
		<execute function="Type" locator1="PGMediagalleryEditmedia#DESCRIPTION_FIELD" value1="${mgDocumentDescriptionEdit}" />
		<execute function="AssertClick" locator1="PGMediagalleryEditmedia#PUBLISH_BUTTON" value1="Publish" />
		<execute function="AssertTextEquals" locator1="PGMediagalleryEditmedia#SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<execute function="AssertTextEquals" locator1="PGMediagalleryFolder#MEDIA_TITLE" value1="${mgDocumentTitleEdit}" />
	</command>

	<command name="moveToFolderPG">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER" />

		<execute function="Check" locator1="PGDocumentsandmediaFolder#FOLDER_ENTRIES_DOCUMENT_SELECT" />
		<execute function="AssertClick" locator1="PGDocumentsandmediaFolder#TOOLBAR_ACTIONS" value1="Actions" />
		<execute function="AssertClick" locator1="PGDocumentsandmediaFolder#ACTIONS_MENULIST_MOVE" value1="Move" />

		<execute function="AssertClick" locator1="PGDocumentsandmediaMovefiles#SELECT" value1="Select" />
		<execute function="SelectWindow" locator1="PGDocumentsandmediaMovefiles#SELECT_POP_UP" />
		<execute function="AssertClick" locator1="PGDocumentsandmediaMovefiles#SELECT_POP_UP_CHOOSE_2" value1="Choose" />
		<execute function="SelectWindow" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="PGDocumentsandmediaMovefiles#MOVE" value1="Move" />

		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="publishDraftDMFolderDocument">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER" />

		<var name="key_dmDocumentTitle" value="${dmDocumentTitle}" />

		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT" />

		<if>
			<condition function="IsElementPresent" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" />
			<then>
				<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="SODocuments#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
			</else>
		</if>

		<execute function="AssertClick" locator1="PGDocumentsandmediaDocument#TOOLBAR_EDIT_BUTTON" value1="Edit" />

		<execute function="AssertClick" locator1="PGDocumentsandmediaEditdocument#PUBLISH_BUTTON" value1="Publish" />

		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="saveAsDraftEditDMFolderDocument">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER" />

		<var name="key_dmDocumentTitle" value="${dmDocumentTitle}" />

		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT" />

		<if>
			<condition function="IsElementPresent" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" />
			<then>
				<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="SODocuments#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
			</else>
		</if>

		<execute function="AssertClick" locator1="PGDocumentsandmediaDocument#TOOLBAR_EDIT_BUTTON" value1="Edit" />

		<if>
			<isset var="dmDocumentFile2" />
			<then>
				<execute function="UploadCommonFile" locator1="PGDocumentsandmediaAdddocument#FILE_FIELD" value1="${dmDocumentFile2}" />
			</then>
		</if>

		<execute function="Type" locator1="PGDocumentsandmediaEditdocument#TITLE_FIELD" value1="${dmDocumentTitleEdit}"  />
		<execute function="Type" locator1="PGDocumentsandmediaEditdocument#DESCRIPTION_FIELD" value1="${dmDocumentDescriptionEdit}" />

		<if>
			<condition function="IsElementPresent" locator1="PGDocumentsandmediaEditdocument#MAJOR_REVISION" />
			<then>
				<if>
					<equals arg1="${revision}" arg2="Major" />
					<then>
						<execute function="Click" locator1="PGDocumentsandmediaCheckin#MAJOR_REVISION" />
					</then>
					<else>
						<execute function="Click" locator1="PGDocumentsandmediaCheckin#MINOR_REVISION" />
					</else>
				</if>

				<if>
					<isset var="changeLog" />
					<then>
						<execute function="Type" locator1="PGDocumentsandmediaCheckin#CHANGE_LOG" value1="${changeLog}" />
					</then>
				</if>
			</then>
		</if>

		<execute function="AssertClick" locator1="PGDocumentsandmediaEditdocument#SAVE_AS_DRAFT_BUTTON" value1="Save as Draft" />

		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaEditdocument#STATUS" value1="Draft" />
	</command>

	<command name="saveAsDraftPG">
		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />

				<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER_INCREMENT" />

				<execute function="AssertClick" locator1="PGDocumentsandmediaFolder#TOOLBAR_ADD" value1="Add" />
				<execute function="AssertClick" locator1="PGDocumentsandmediaFolder#ADD_MENULIST_BASIC_DOCUMENT" value1="Basic Document" />

				<execute function="UploadCommonFile" locator1="PGDocumentsandmediaAdddocument#FILE_FIELD" value1="${dmDocumentFile}" />
				<execute function="Type" locator1="PGDocumentsandmediaAdddocument#TITLE_FIELD" value1="${dmDocumentTitle}${number}" />
				<execute function="Type" locator1="PGDocumentsandmediaAdddocument#DESCRIPTION_FIELD" value1="${dmDocumentDescription}${number}" />
				<execute function="AssertClick" locator1="PGDocumentsandmediaAdddocument#SAVE_AS_DRAFT_BUTTON" value1="Save as Draft" />
			</then>
			<else>
				<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER" />

				<execute function="AssertClick" locator1="PGDocumentsandmediaFolder#TOOLBAR_ADD" value1="Add" />
				<execute function="AssertClick" locator1="PGDocumentsandmediaFolder#ADD_MENULIST_BASIC_DOCUMENT" value1="Basic Document" />

				<execute function="UploadCommonFile" locator1="PGDocumentsandmediaAdddocument#FILE_FIELD" value1="${dmDocumentFile}" />
				<execute function="Type" locator1="PGDocumentsandmediaAdddocument#TITLE_FIELD" value1="${dmDocumentTitle}" />
				<execute function="Type" locator1="PGDocumentsandmediaAdddocument#DESCRIPTION_FIELD" value1="${dmDocumentDescription}" />
				<execute function="AssertClick" locator1="PGDocumentsandmediaAdddocument#SAVE_AS_DRAFT_BUTTON" value1="Save as Draft" />
			</else>
		</if>

		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaFolder#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="searchNoPGviaDMD">
		<execute function="Type" locator1="PGDocumentlibrarydisplaySearch#SEARCH_FIELD" value1="${dmdDocumentTitleSearch}" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="PGDocumentlibrarydisplaySearch#SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplaySearch#INFO_MESSAGE" value1="No documents were found that matched the keywords: ${dmdDocumentTitleSearch}." />
	</command>

	<command name="searchPGviaDMD">
		<execute function="Type" locator1="PGDocumentlibrarydisplay#SEARCH_FIELD" value1="${dmdDocumentTitleSearch}" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="PGDocumentlibrarydisplay#SEARCH_BUTTON" value1="Search" />

		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplaySearch#SEARCH_RESULTS_FOLDER" value1="${dmdFolderName}" />
		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplaySearch#SEARCH_RESULTS_DOCUMENT" value1="${dmdDocumentTitle}" />
	</command>

	<command name="viewPG">
		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#BREADCRUMB_HOME" value1="Home" />
		<execute function="Type" locator1="PGDocumentsandmedia#TOOLBAR_SEARCH_FIELD" value1="${dmDocumentTitle}" />
		<execute function="AssertClick" locator1="PGDocumentsandmedia#TOOLBAR_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertClick#assertTextClickAtAndWait" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT_SEARCH_TITLE" value1="${dmDocumentTitle}" />

		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#TOOLBAR_DOWNLOAD_BUTTON" value1="Download" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#TOOLBAR_EDIT_BUTTON" value1="Edit" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#TOOLBAR_MOVE_BUTTON" value1="Move" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#TOOLBAR_CHECKOUT_BUTTON" value1="Checkout" />
