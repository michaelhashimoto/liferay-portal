@default = "mouseUp"
definition {
	function javaScriptMouseUp {
		selenium.javaScriptMouseUp();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function mouseRelease {
		selenium.mouseRelease();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function mouseUp {
		selenium.mouseUp();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function mouseUpAt {
		selenium.mouseUpAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}
}