definition {
	macro addTask {
		if (IsElementNotPresent(locator1 = "SOTasks#TASK_DESCRIPTION")) {
			AssertTextEquals(
				locator1 = "SOTasks#INFO_MESSAGE",
				value1 = "No tasks were found."
			);
		}

		Click(locator1 = "SOTasks#ADD_TASK_BUTTON");

		if (isSet(number)) {
			Type(
				locator1 = "SOTasksAdd#TASK_DESCRIPTION_FIELD",
				value1 = "${taskDescription}${number}"
			);
		}
		else {
			Type(
				locator1 = "SOTasksAdd#TASK_DESCRIPTION_FIELD",
				value1 = "${taskDescription}"
			);
		}

		Select(
			locator1 = "SOTasksAdd#TASK_ASSIGNEE_SELECT_MENU",
			value1 = "${taskAssignee}"
		);

		if (isSet(taskPriority)) {
			Select(
				locator1 = "SOTasksAdd#TASK_PRIORITY_SELECT_MENU",
				value1 = "${taskPriority}"
			);
		}
		else {
			Select(locator1 = "SOTasksAdd#TASK_PRIORITY_SELECT_MENU", value1 = "Normal");
		}

		if ("${dueDate}" == "true") {
			if (IsTextEqual(locator1 = "SOTasksAdd#TASK_ADD_DUE_DATE_LINK", value1 = "Add Due Date")) {
				AssertClick(
					locator1 = "SOTasksAdd#TASK_ADD_DUE_DATE_LINK",
					value1 = "Add Due Date"
				);
			}

			if (IsElementPresent(locator1 = "SOTasksAdd#DUE_DATE_MONTH_SELECT_6120")) {
				Select(locator1 = "SOTasksAdd#DUE_DATE_MONTH_SELECT_6120", value1 = "March");

				Select(locator1 = "SOTasksAdd#DUE_DATE_DAY_SELECT_6120", value1 = "16");

				Select(locator1 = "SOTasksAdd#DUE_DATE_YEAR_SELECT_6120", value1 = "2016");
			}
			else {
				Select(locator1 = "SOTasksAdd#DUE_DATE_MONTH_SELECT_61X", value1 = "March");

				Select(locator1 = "SOTasksAdd#DUE_DATE_DAY_SELECT_61X", value1 = "16");

				Select(locator1 = "SOTasksAdd#DUE_DATE_YEAR_SELECT_61X", value1 = "2016");
			}
		}

		if (isSet(taskPriority)) {
			Select(
				locator1 = "SOTasksAdd#TASK_PRIORITY_SELECT_MENU",
				value1 = "${taskPriority}"
			);
		}
		else {
			Select(locator1 = "SOTasksAdd#TASK_PRIORITY_SELECT_MENU", value1 = "Normal");
		}

		if (isSet(numberOfTags)) {
			var tagNumber = "0";

			while (!("${tagNumber}" == "${numberOfTags}")) {
				var tagNumber = MathUtil.sum("${tagNumber}", "1");

				Type(locator1 = "SOTasksAdd#TASK_TAG_FIELD", value1 = "tag${tagNumber}");

				Click(locator1 = "SOTasksAdd#TASK_ADD_TAG_BUTTON");

				AssertTextEquals(locator1 = "SOTasksAdd#TASK_TAG", value1 = "tag${tagNumber}");
			}
		}

		if (isSet(tagNumber)) {
			Type(locator1 = "SOTasksAdd#TASK_TAG_FIELD", value1 = "tag${tagNumber}");

			Click(locator1 = "SOTasksAdd#TASK_ADD_TAG_BUTTON");

			AssertTextEquals(locator1 = "SOTasksAdd#TASK_TAG", value1 = "tag${tagNumber}");
		}

		Click(locator1 = "SOTasksAdd#SAVE_BUTTON");

		if (isSet(number)) {
			AssertTextEquals(
				locator1 = "SOTasksTask#TASK_DESCRIPTION",
				value1 = "${taskDescription}${number}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SOTasksTask#TASK_DESCRIPTION",
				value1 = "${taskDescription}"
			);
		}

		AssertTextEquals(
			locator1 = "SOTasksTask#TASK_ASSIGNEE",
			value1 = "Assigned to ${taskAssignee}"
		);

		AssertTextEquals(
			locator1 = "SOTasksTask#TASK_REPORTER",
			value1 = "Created by ${taskReporter}"
		);

		Page.openURL();
	}

	macro completeTask {
		Click.clickAt(locator1 = "SOTasks#ASSIGNED_TO_ME_LINK");

		if ("${taskPriority}" == "High") {
			AssertTextEquals(
				locator1 = "SOTasks#TASK_DESCRIPTION_HIGH",
				value1 = "${taskDescription}"
			);
		}
		else if ("${taskPriority}" == "Low") {
			AssertTextEquals(
				locator1 = "SOTasks#TASK_DESCRIPTION_LOW",
				value1 = "${taskDescription}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SOTasks#TASK_DESCRIPTION_NORMAL",
				value1 = "${taskDescription}"
			);
		}

		MouseOver.makeVisible(locator1 = "SOTasks#TASK_PROGRESS_BAR");

		Click.makeVisibleClickAt(locator1 = "SOTasks#TASK_PROGRESS_BAR_PERCENT_CLICK");

		Pause(value1 = "1000");

		if ("${percentCompletion}" == "100") {
			AssertTextEquals(
				locator1 = "SOTasks#INFO_MESSAGE",
				value1 = "No tasks were found."
			);

			Check(locator1 = "SOTasks#SHOW_COMPLETED_TASKS_CHECKBOX");

			if ("${taskPriority}" == "High") {
				AssertClick(
					locator1 = "SOTasks#TASK_DESCRIPTION_HIGH",
					value1 = "${taskDescription}"
				);
			}
			else if ("${taskPriority}" == "Low") {
				AssertClick(
					locator1 = "SOTasks#TASK_DESCRIPTION_LOW",
					value1 = "${taskDescription}"
				);
			}
			else {
				AssertClick(
					locator1 = "SOTasks#TASK_DESCRIPTION_NORMAL",
					value1 = "${taskDescription}"
				);
			}

			AssertTextEquals(
				locator1 = "SOTasksTask#TASK_DESCRIPTION",
				value1 = "${taskDescription}"
			);

			AssertTextEquals(
				locator1 = "SOTasksTask#TASK_ASSIGNEE",
				value1 = "Assigned to ${taskAssignee}"
			);

			AssertTextEquals(
				locator1 = "SOTasksTask#TASK_REPORTER",
				value1 = "Created by ${taskReporter}"
			);

			AssertTextEquals(locator1 = "SOTasksTask#TASK_STATUS", value1 = "Resolved");

			if (isSet(taskPriority)) {
				if ("${taskPriority}" == "High") {
					AssertTextEquals(
						locator1 = "SOTasksTask#TASK_PRIORITY_HIGH",
						value1 = "${taskPriority}"
					);
				}
				else if ("${taskPriority}" == "Low") {
					AssertTextEquals(
						locator1 = "SOTasksTask#TASK_PRIORITY_LOW",
						value1 = "${taskPriority}"
					);
				}
			}
			else {
				AssertTextEquals(
					locator1 = "SOTasksTask#TASK_PRIORITY_NORMAL",
					value1 = "Normal"
				);
			}
		}
		else {
			AssertElementPresent(locator1 = "SOTasks#TASK_PROGRESS_BAR_PERCENT_COMPLETION");

			if ("${taskPriority}" == "High") {
				AssertClick(
					locator1 = "SOTasks#TASK_DESCRIPTION_HIGH",
					value1 = "${taskDescription}"
				);
			}
			else if ("${taskPriority}" == "Low") {
				AssertClick(
					locator1 = "SOTasks#TASK_DESCRIPTION_LOW",
					value1 = "${taskDescription}"
				);
			}
			else {
				AssertClick(
					locator1 = "SOTasks#TASK_DESCRIPTION_NORMAL",
					value1 = "${taskDescription}"
				);
			}

			AssertTextEquals(
				locator1 = "SOTasksTask#TASK_DESCRIPTION",
				value1 = "${taskDescription}"
			);

			AssertTextEquals(
				locator1 = "SOTasksTask#TASK_ASSIGNEE",
				value1 = "Assigned to ${taskAssignee}"
			);

			AssertTextEquals(
				locator1 = "SOTasksTask#TASK_REPORTER",
				value1 = "Created by ${taskReporter}"
			);

			AssertTextEquals(
				locator1 = "SOTasksTask#TASK_STATUS",
				value1 = "${percentCompletion}% Complete"
			);

			if (isSet(taskPriority)) {
				if ("${taskPriority}" == "High") {
					AssertTextEquals(
						locator1 = "SOTasksTask#TASK_PRIORITY_HIGH",
						value1 = "${taskPriority}"
					);
				}
				else if ("${taskPriority}" == "Low") {
					AssertTextEquals(
						locator1 = "SOTasksTask#TASK_PRIORITY_LOW",
						value1 = "${taskPriority}"
					);
				}
			}
			else {
				AssertTextEquals(
					locator1 = "SOTasksTask#TASK_PRIORITY_NORMAL",
					value1 = "Normal"
				);
			}
		}
	}

	macro deleteTask {
		Click.clickAt(locator1 = "SOTasks#I_HAVE_CREATED_LINK");

		Check(locator1 = "SOTasks#SHOW_COMPLETED_TASKS_CHECKBOX");

		AssertClick(
			locator1 = "SOTasks#TASK_DESCRIPTION",
			value1 = "${taskDescription}"
		);

		ClickNoError(locator1 = "SOTasksTask#TASK_DELETE_BUTTON");

		Confirm(value1 = "Are you sure you want to delete this entry?");

		Click.clickAt(locator1 = "SOTasks#ASSIGNED_TO_ME_LINK");

		Check(locator1 = "SOTasks#SHOW_COMPLETED_TASKS_CHECKBOX");

		if (IsElementNotPresent(locator1 = "SOTasks#TASK_DESCRIPTION")) {
			AssertTextEquals(
				locator1 = "SOTasks#INFO_MESSAGE",
				value1 = "No tasks were found."
			);
		}

		AssertTextNotPresent(value1 = "${taskDescription}");

		Click.clickAt(locator1 = "SOTasks#I_HAVE_CREATED_LINK");

		Check(locator1 = "SOTasks#SHOW_COMPLETED_TASKS_CHECKBOX");

		if (IsElementNotPresent(locator1 = "SOTasks#TASK_DESCRIPTION")) {
			AssertTextEquals(
				locator1 = "SOTasks#INFO_MESSAGE",
				value1 = "No tasks were found."
			);
		}

		AssertTextNotPresent(value1 = "${taskDescription}");
	}

	macro editTask {
		Click.clickAt(locator1 = "SOTasks#I_HAVE_CREATED_LINK");

		Check(locator1 = "SOTasks#SHOW_COMPLETED_TASKS_CHECKBOX");

		AssertClick(
			locator1 = "SOTasks#TASK_DESCRIPTION",
			value1 = "${taskDescription}"
		);

		Click(locator1 = "SOTasksTask#TASK_EDIT_BUTTON");

		if (isSet(taskDescriptionEdit)) {
			Type(
				locator1 = "SOTasksAdd#TASK_DESCRIPTION_FIELD",
				value1 = "${taskDescriptionEdit}"
			);
		}

		if (isSet(taskAssigneeEdit)) {
			Select(
				locator1 = "SOTasksAdd#TASK_ASSIGNEE_SELECT_MENU",
				value1 = "${taskAssigneeEdit}"
			);
		}

		if (isSet(taskPriorityEdit)) {
			Select(
				locator1 = "SOTasksAdd#TASK_PRIORITY_SELECT_MENU",
				value1 = "${taskPriorityEdit}"
			);
		}
		else {
			Select(locator1 = "SOTasksAdd#TASK_PRIORITY_SELECT_MENU", value1 = "Normal");
		}

		if ("${dueDateEdit}" == "true") {
			if (IsTextEqual(locator1 = "SOTasksAdd#TASK_ADD_DUE_DATE_LINK", value1 = "Add Due Date")) {
				AssertClick(
					locator1 = "SOTasksAdd#TASK_ADD_DUE_DATE_LINK",
					value1 = "Add Due Date"
				);
			}

			if (IsElementPresent(locator1 = "SOTasksAdd#DUE_DATE_MONTH_SELECT_6120")) {
				Select(locator1 = "SOTasksAdd#DUE_DATE_MONTH_SELECT_6120", value1 = "April");

				Select(locator1 = "SOTasksAdd#DUE_DATE_DAY_SELECT_6120", value1 = "17");

				Select(locator1 = "SOTasksAdd#DUE_DATE_YEAR_SELECT_6120", value1 = "2017");
			}
			else {
				Select(locator1 = "SOTasksAdd#DUE_DATE_MONTH_SELECT_61X", value1 = "April");

				Select(locator1 = "SOTasksAdd#DUE_DATE_DAY_SELECT_61X", value1 = "17");

				Select(locator1 = "SOTasksAdd#DUE_DATE_YEAR_SELECT_61X", value1 = "2017");
			}
		}

		Click(locator1 = "SOTasksAdd#SAVE_BUTTON");

		if (isSet(taskDescriptionEdit)) {
			AssertTextEquals(
				locator1 = "SOTasksTask#TASK_DESCRIPTION",
				value1 = "${taskDescriptionEdit}"
			);
		}

		if (isSet(taskAssigneeEdit)) {
			AssertTextEquals(
				locator1 = "SOTasksTask#TASK_ASSIGNEE",
				value1 = "Assigned to ${taskAssigneeEdit}"
			);
		}

		if ("${dueDateEdit}" == "true") {
			AssertTextEquals.assertPartialText(
				locator1 = "SOTasksTask#TASK_DUE_DATE",
				value1 = "4/17/17"
			);
		}

		Page.openURL();
	}

	macro resolveTask {
		var currentUser = selenium.getText("SODashboard#PROFILE_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOTasks#ASSIGNED_TO_ME_LINK",
			value1 = "Assigned to Me"
		);

		AssertClick(
			locator1 = "SOTasks#TASK_DESCRIPTION_NORMAL",
			value1 = "${taskDescription}"
		);

		AssertTextEquals(
			locator1 = "SOTasksTask#TASK_DESCRIPTION",
			value1 = "${taskDescription}"
		);

		AssertTextEquals(
			locator1 = "SOTasksTask#TASK_ASSIGNEE",
			value1 = "Assigned to ${taskAssignee}"
		);

		AssertTextEquals(
			locator1 = "SOTasksTask#TASK_REPORTER",
			value1 = "Created by ${taskReporter}"
		);

		AssertTextEquals(
			locator1 = "SOTasksTask#TASK_PRIORITY_NORMAL",
			value1 = "Normal"
		);

		AssertTextEquals(locator1 = "SOTasksTask#TASK_STATUS", value1 = "Open");

		AssertTextNotPresent(value1 = "Resolved");

		Click(locator1 = "SOTasksTask#TASK_RESOLVE_BUTTON", value1 = "Resolve");

		AssertTextEquals(locator1 = "SOTasksTask#TASK_STATUS", value1 = "Resolved");
	}

	macro tearDownTask {
		SOUser.firstLoginPG();

		SONavigation.gotoDashboardTasks();

		Click.clickAt(locator1 = "SOTasks#ASSIGNED_TO_ME_LINK");

		Check(locator1 = "SOTasks#SHOW_COMPLETED_TASKS_CHECKBOX");

		while (IsElementPresent(locator1 = "SOTasks#TASK_DESCRIPTION")) {
			Click(locator1 = "SOTasks#TASK_DESCRIPTION");

			ClickNoError(locator1 = "SOTasksTask#TASK_DELETE_BUTTON");

			Confirm(value1 = "Are you sure you want to delete this entry?");

			Click.clickAt(locator1 = "SOTasks#ASSIGNED_TO_ME_LINK");

			Check(locator1 = "SOTasks#SHOW_COMPLETED_TASKS_CHECKBOX");
		}

		Click.clickAt(locator1 = "SOTasks#I_HAVE_CREATED_LINK");

		Check(locator1 = "SOTasks#SHOW_COMPLETED_TASKS_CHECKBOX");

		while (IsElementPresent(locator1 = "SOTasks#TASK_DESCRIPTION")) {
			Click(locator1 = "SOTasks#TASK_DESCRIPTION");

			ClickNoError(locator1 = "SOTasksTask#TASK_DELETE_BUTTON");

			Confirm(value1 = "Are you sure you want to delete this entry?");

			Click.clickAt(locator1 = "SOTasks#I_HAVE_CREATED_LINK");

			Check(locator1 = "SOTasks#SHOW_COMPLETED_TASKS_CHECKBOX");
		}
	}

	macro viewResolveTaskNotification {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertElementPresent.assertElementPresent(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "1");

		MouseOver(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals.assertPartialText(
			locator1 = "SOUserBar#NOTIFICATION_MENU_ENTRY_CONTENT",
			value1 = "${taskAssignee} resolved the task."
		);

		AssertTextEquals(
			locator1 = "SOUserBar#NOTIFICATION_MENU_ENTRY_SUBCONTENT",
			value1 = "${taskDescription}"
		);

		AssertClick(
			locator1 = "SOUserBar#NOTIFICATION_MENU_MARK_ALL_AS_READ",
			value1 = "Mark All as Read"
		);

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "0");
	}

	macro viewTask {
		var currentUser = selenium.getText("SODashboard#PROFILE_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOTasks#ASSIGNED_TO_ME_LINK",
			value1 = "Assigned to Me"
		);

		if ("${taskAssignee}" == "${currentUser}") {
			if (isSet(percentCompletion)) {
				if ("${percentCompletion}" == "100") {
					AssertTextEquals(
						locator1 = "SOTasks#INFO_MESSAGE",
						value1 = "No tasks were found."
					);

					Check(locator1 = "SOTasks#SHOW_COMPLETED_TASKS_CHECKBOX");
				}

				AssertElementPresent(locator1 = "SOTasks#TASK_PROGRESS_BAR_PERCENT_COMPLETION");
			}

			AssertTextEquals(
				locator1 = "SOTasks#TASK_REPORTER",
				value1 = "Reporter: ${taskReporter}"
			);

			if ("${taskPriority}" == "High") {
				if (isSet(number)) {
					AssertClick(
						locator1 = "SOTasks#TASK_DESCRIPTION_HIGH_INCREMENT",
						value1 = "${taskDescription}${number}"
					);
				}
				else {
					AssertClick(
						locator1 = "SOTasks#TASK_DESCRIPTION_HIGH",
						value1 = "${taskDescription}"
					);
				}
			}
			else if ("${taskPriority}" == "Low") {
				if (isSet(number)) {
					AssertClick(
						locator1 = "SOTasks#TASK_DESCRIPTION_LOW_INCREMENT",
						value1 = "${taskDescription}${number}"
					);
				}
				else {
					AssertClick(
						locator1 = "SOTasks#TASK_DESCRIPTION_LOW",
						value1 = "${taskDescription}"
					);
				}
			}
			else {
				if (isSet(number)) {
					AssertClick(
						locator1 = "SOTasks#TASK_DESCRIPTION_NORMAL_INCREMENT",
						value1 = "${taskDescription}${number}"
					);
				}
				else {
					AssertClick(
						locator1 = "SOTasks#TASK_DESCRIPTION_NORMAL",
						value1 = "${taskDescription}"
					);
				}
			}

			SOTasks.viewTaskDetails();
		}
		else {
			AssertTextEquals(
				locator1 = "SOTasks#INFO_MESSAGE",
				value1 = "No tasks were found."
			);
		}

		SONavigation.gotoDashboardTasks();

		AssertClick.assertTextClickAt(
			locator1 = "SOTasks#I_HAVE_CREATED_LINK",
			value1 = "I Have Created"
		);

		if ("${taskReporter}" == "${currentUser}") {
			if (isSet(percentCompletion)) {
				if ("${percentCompletion}" == "100") {
					AssertTextEquals(
						locator1 = "SOTasks#INFO_MESSAGE",
						value1 = "No tasks were found."
					);

					Check(locator1 = "SOTasks#SHOW_COMPLETED_TASKS_CHECKBOX");
				}

				AssertElementPresent(locator1 = "SOTasks#TASK_PROGRESS_BAR_PERCENT_COMPLETION");
			}

			AssertTextEquals(
				locator1 = "SOTasks#TASK_ASSIGNEE",
				value1 = "Assignee: ${taskAssignee}"
			);

			if ("${taskPriority}" == "High") {
				if (isSet(number)) {
					AssertClick(
						locator1 = "SOTasks#TASK_DESCRIPTION_HIGH_INCREMENT",
						value1 = "${taskDescription}${number}"
					);
				}
				else {
					AssertClick(
						locator1 = "SOTasks#TASK_DESCRIPTION_HIGH",
						value1 = "${taskDescription}"
					);
				}
			}
			else if ("${taskPriority}" == "Low") {
				if (isSet(number)) {
					AssertClick(
						locator1 = "SOTasks#TASK_DESCRIPTION_LOW_INCREMENT",
						value1 = "${taskDescription}${number}"
					);
				}
				else {
					AssertClick(
						locator1 = "SOTasks#TASK_DESCRIPTION_LOW",
						value1 = "${taskDescription}"
					);
				}
			}
			else {
				if (isSet(number)) {
					AssertClick(
						locator1 = "SOTasks#TASK_DESCRIPTION_NORMAL_INCREMENT",
						value1 = "${taskDescription}${number}"
					);
				}
				else {
					AssertClick(
						locator1 = "SOTasks#TASK_DESCRIPTION_NORMAL",
						value1 = "${taskDescription}"
					);
				}
			}

			SOTasks.viewTaskDetails();
		}
		else {
			AssertTextEquals(
				locator1 = "SOTasks#INFO_MESSAGE",
				value1 = "No tasks were found."
			);
		}
	}

	macro viewTaskDetails {
		if (isSet(number)) {
			AssertTextEquals(
				locator1 = "SOTasksTask#TASK_DESCRIPTION",
				value1 = "${taskDescription}${number}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SOTasksTask#TASK_DESCRIPTION",
				value1 = "${taskDescription}"
			);
		}

		AssertTextEquals(
			locator1 = "SOTasksTask#TASK_ASSIGNEE",
			value1 = "Assigned to ${taskAssignee}"
		);

		AssertTextEquals(
			locator1 = "SOTasksTask#TASK_REPORTER",
			value1 = "Created by ${taskReporter}"
		);

		if (isSet(percentCompletion)) {
			if ("${percentCompletion}" == "100") {
				AssertTextEquals(locator1 = "SOTasksTask#TASK_STATUS", value1 = "Resolved");
			}
			else {
				AssertTextEquals(
					locator1 = "SOTasksTask#TASK_STATUS",
					value1 = "${percentCompletion}% Complete"
				);
			}
		}
		else {
			AssertTextEquals(locator1 = "SOTasksTask#TASK_STATUS", value1 = "Open");
		}

		if (isSet(taskPriority)) {
			if ("${taskPriority}" == "High") {
				AssertTextEquals(
					locator1 = "SOTasksTask#TASK_PRIORITY_HIGH",
					value1 = "${taskPriority}"
				);
			}
			else if ("${taskPriority}" == "Low") {
				AssertTextEquals(
					locator1 = "SOTasksTask#TASK_PRIORITY_LOW",
					value1 = "${taskPriority}"
				);
			}
		}
		else {
			AssertTextEquals(
				locator1 = "SOTasksTask#TASK_PRIORITY_NORMAL",
				value1 = "Normal"
			);
		}

		if ("${dueDate}" == "true") {
			AssertTextEquals.assertPartialText(
				locator1 = "SOTasksTask#TASK_DUE_DATE",
				value1 = "3/16/16"
			);
		}
		else if ("${dueDateEdit}" == "true") {
			AssertTextEquals.assertPartialText(
				locator1 = "SOTasksTask#TASK_DUE_DATE",
				value1 = "4/17/17"
			);
		}
		else {
			AssertElementNotPresent(locator1 = "SOTasksTask#TASK_DUE_DATE");
		}

		if (isSet(numberOfTags)) {
			var tagNumber = "0";

			while (!("${tagNumber}" == "${numberOfTags}")) {
				var tagNumber = MathUtil.sum("${tagNumber}", "1");

				AssertTextEquals(locator1 = "SOTasksTask#TASK_TAG", value1 = "tag${tagNumber}");
			}
		}

		if (isSet(tagNumber)) {
			AssertTextEquals(locator1 = "SOTasksTask#TASK_TAG", value1 = "tag${tagNumber}");
		}
	}

	macro viewTaskNotification {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertElementPresent.assertElementPresent(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "1");

		MouseOver(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals.assertPartialText(
			locator1 = "SOUserBar#NOTIFICATION_MENU_ENTRY_CONTENT",
			value1 = "${taskReporter} assigned you a task."
		);

		AssertTextEquals(
			locator1 = "SOUserBar#NOTIFICATION_MENU_ENTRY_SUBCONTENT",
			value1 = "${taskDescription}"
		);

		Click(
			locator1 = "SOUserBar#NOTIFICATION_MENU_ENTRY_CONTENT",
			value1 = "${taskReporter} assigned you a task."
		);

		if ("${taskPriority}" == "High") {
			if (isSet(number)) {
				AssertTextEquals(
					locator1 = "SOTasks#TASK_DESCRIPTION_HIGH_INCREMENT",
					value1 = "${taskDescription}${number}"
				);
			}
			else {
				AssertTextEquals(
					locator1 = "SOTasks#TASK_DESCRIPTION_HIGH",
					value1 = "${taskDescription}"
				);
			}
		}
		else if ("${taskPriority}" == "Low") {
			if (isSet(number)) {
				AssertTextEquals(
					locator1 = "SOTasks#TASK_DESCRIPTION_LOW_INCREMENT",
					value1 = "${taskDescription}${number}"
				);
			}
			else {
				AssertTextEquals(
					locator1 = "SOTasks#TASK_DESCRIPTION_LOW",
					value1 = "${taskDescription}"
				);
			}
		}
		else {
			if (isSet(number)) {
				AssertTextEquals(
					locator1 = "SOTasks#TASK_DESCRIPTION_NORMAL_INCREMENT",
					value1 = "${taskDescription}${number}"
				);
			}
			else {
				AssertTextEquals(
					locator1 = "SOTasks#TASK_DESCRIPTION_NORMAL",
					value1 = "${taskDescription}"
				);
			}
		}

		AssertTextEquals(
			locator1 = "SOTasks#TASK_REPORTER",
			value1 = "Reporter: ${taskReporter}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertElementPresent.assertElementPresent(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "1");

		MouseOver(locator1 = "SOUserBar#NOTIFICATION");

		AssertClick(
			locator1 = "SOUserBar#NOTIFICATION_MENU_MARK_ALL_AS_READ",
			value1 = "Mark All as Read"
		);

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "0");
	}
}