@default = "mouseOver"
@summary = "Mouse over '${locator1}'"
definition {
	function makeVisible {
		selenium.makeVisible();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function mouseOver {
		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function mouseOverClickDockbar {
		selenium.clickAt("//div[@id='dockbar']", "");

		selenium.waitForElementPresent(
			"//script[contains(@src,'/liferay/dockbar_underlay.js')]"
		);

		MouseOver.mouseOver();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function mouseOverClickNavigation {
		selenium.clickAt("//nav[@id='navigation']", "");

		selenium.waitForElementPresent(
			"//script[contains(@src,'/aui/sortable/sortable-min.js')]"
		);

		MouseOver.mouseOver();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function partialTextMouseOver {
		AssertTextEquals.assertPartialText();

		selenium.mouseOver();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function textMouseOver {
		AssertTextEquals.assertText();

		selenium.mouseOver();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function textMouseOverClickDockbar {
		selenium.clickAt("//div[@id='dockbar']", "");

		selenium.waitForElementPresent(
			"//script[contains(@src,'/liferay/dockbar_underlay.js')]"
		);

		MouseOver.textMouseOver();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function textMouseOverClickNavigation {
		selenium.clickAt("//nav[@id='navigation']", "");

		selenium.waitForElementPresent(
			"//script[contains(@src,'/aui/sortable/sortable-min.js')]"
		);

		MouseOver.textMouseOver();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function valueMouseOver {
		AssertTextEquals.assertValue();

		selenium.mouseOver();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}
}