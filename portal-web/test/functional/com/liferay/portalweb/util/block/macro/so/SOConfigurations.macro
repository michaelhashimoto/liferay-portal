definition {
	macro assignUserRoleCP {
		Page.gotoCP(portletName = "Social Office Configurations");

		Click.clickAtPause(locator1 = "SOConfigurations#STATUS_AVAILABLE");

		Type(locator1 = "SOConfigurations#SEARCH_FIELD", value1 = "${userScreenName}");

		Click(locator1 = "SOConfigurations#SEARCH_BUTTON");

		AssertTextEquals(
			locator1 = "CPRolesAssignmembersUsers#SEARCH_RESULTS",
			value1 = "Showing 1 result."
		);

		AssertTextEquals(
			locator1 = "SOConfigurations#USER_TABLE_SCREEN_NAME_1",
			value1 = "${userScreenName}"
		);

		Check(locator1 = "SOConfigurations#USER_TABLE_CHECKBOX_1");

		Click.valueClickAt(locator1 = "SOConfigurations#SAVE_BUTTON", value1 = "Save");

		AssertTextEquals(locator1 = "CPRolesAssignmembersUsers#SUCCESS_MESSAGE");

		AssertChecked(locator1 = "SOConfigurations#USER_TABLE_CHECKBOX_1");
	}

	macro unassignUserRoleCP {
		Page.gotoCP(portletName = "Social Office Configurations");

		Click.clickAtPause(locator1 = "SOConfigurations#STATUS_CURRENT");

		Type(locator1 = "SOConfigurations#SEARCH_FIELD", value1 = "${userScreenName}");

		Click(locator1 = "SOConfigurations#SEARCH_BUTTON");

		AssertTextEquals(
			locator1 = "CPRolesAssignmembersUsers#SEARCH_RESULTS",
			value1 = "Showing 1 result."
		);

		AssertTextEquals(
			locator1 = "SOConfigurations#USER_TABLE_SCREEN_NAME_1",
			value1 = "${userScreenName}"
		);

		Uncheck(locator1 = "SOConfigurations#USER_TABLE_CHECKBOX_1");

		Click.valueClickAt(locator1 = "SOConfigurations#SAVE_BUTTON", value1 = "Save");

		AssertTextEquals(locator1 = "CPRolesAssignmembersUsers#SUCCESS_MESSAGE");
	}
}