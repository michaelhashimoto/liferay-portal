definition {
	macro addSOSite {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Click(locator1 = "SOUserBar#GO_TO_ADD_SITE_BUTTON");

		Type(locator1 = "SOUserBarAddSite#NAME_FIELD", value1 = "${siteName}");

		Type(
			locator1 = "SOUserBarAddSite#DESCRIPTION_FIELD",
			value1 = "${siteDescription}"
		);

		Click(locator1 = "SOUserBarAddSite#NEXT_BUTTON");

		Select(
			locator1 = "SOUserBarAddSite#DEFAULT_PAGES_SELECT",
			value1 = "Default Social Office Site"
		);

		Check(locator1 = "SOUserBarAddSite#HOME_CHECKBOX");

		Check(locator1 = "SOUserBarAddSite#CALENDAR_CHECKBOX");

		Check(locator1 = "SOUserBarAddSite#DOCUMENTS_CHECKBOX");

		Check(locator1 = "SOUserBarAddSite#FORUMS_CHECKBOX");

		Check(locator1 = "SOUserBarAddSite#BLOGS_CHECKBOX");

		Check(locator1 = "SOUserBarAddSite#WIKI_CHECKBOX");

		Check(locator1 = "SOUserBarAddSite#MEMBERS_CHECKBOX");

		if ("${siteType}" == "Private") {
			Select(locator1 = "SOUserBarAddSite#TYPE_SELECT", value1 = "value=3");

			AssertSelectedLabel(
				locator1 = "SOUserBarAddSite#TYPE_SELECT",
				value1 = "Private"
			);
		}
		else {
			Select(locator1 = "SOUserBarAddSite#TYPE_SELECT", value1 = "${siteType}");
		}

		Click.clickAtPause(locator1 = "SOUserBarAddSite#SAVE_BUTTON");

		AssertElementNotPresent.assertNotVisible(
			locator1 = "SOUserBarAddSite#SAVE_BUTTON"
		);
	}

	macro dashboardPG {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertTextEquals(locator1 = "SODashboard#PROFILE_NAME", value1 = "${userName}");
	}

	macro deleteSOSite {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO_SITES_DIRECTORY_BUTTON");

		if ("${siteType}" == "Private") {
			Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

			Select(locator1 = "SOUserBar#GO_TO_SITE_CATEGORY_SELECT", value1 = "My Sites");
		}
		else {
			Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

			Select(locator1 = "SOUserBar#GO_TO_SITE_CATEGORY_SELECT", value1 = "All Sites");
		}

		Type(
			locator1 = "SOUserBarSitesDirectory#SITE_SEARCH_FIELD",
			value1 = "${siteName}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName}"
		);

		AssertClickNoError.pauseAssertTextClick(
			locator1 = "SOUserBarSitesDirectory#DELETE_SITE_ICON",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete ${siteName}?");

		AssertTextNotPresent(value1 = "${siteName}");
	}

	macro favoriteSOSite {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Type(locator1 = "SOUserBar#GO_TO_SEARCH_FIELD", value1 = "${siteName}");

		AssertTextEquals(
			locator1 = "SOUserBar#GO_TO_SITE_NAME_LINK",
			value1 = "${siteName}"
		);

		Click(locator1 = "SOUserBar#GO_TO_FAVORITE_SITE_ICON");

		AssertElementPresent(locator1 = "SOUserBar#GO_TO_UNFAVORITE_SITE_ICON");
	}

	macro gotoCP {
		Open(locator1 = "Home#GUEST_URL");

		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_CONTROL_PANEL",
			value1 = "Control Panel"
		);

		if (isSet(siteScopeName)) {
			Click(locator1 = "Home#SCOPE_SELECTOR");

			var key_siteScopeName = "${siteScopeName}";

			Click(locator1 = "Home#SCOPE_SELECTOR_MENULIST_ITEM");
		}

		if ("${portletName}" == "Workflow") {
			Click(
				locator1 = "xPath=(//ul[@class='category-portlets']/li/a[contains(.,'${portletName}')])[3]"
			);
		}
		else {
			Click(
				locator1 = "//ul[@class='category-portlets']/li/a[contains(.,'${portletName}')]"
			);
		}
	}

	macro gotoProfile {
		SOUserBar.dashboardPG(userName = "${userName}");

		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_MY_PROFILE",
			value1 = "My Profile"
		);
	}

	macro joinSOSite {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO_SITES_DIRECTORY_BUTTON");

		Type(
			locator1 = "SOUserBarSitesDirectory#SITE_SEARCH_FIELD",
			value1 = "${siteName}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName}"
		);

		ClickNoError(locator1 = "SOUserBarSitesDirectory#JOIN_SITE_ICON");

		Confirm(value1 = "Are you sure you want to join ${siteName}?");

		AssertElementPresent(locator1 = "SOUserBarSitesDirectory#LEAVE_SITE_ICON");
	}

	macro leaveSOSite {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO_SITES_DIRECTORY_BUTTON");

		Type(
			locator1 = "SOUserBarSitesDirectory#SITE_SEARCH_FIELD",
			value1 = "${siteName}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName}"
		);

		ClickNoError(locator1 = "SOUserBarSitesDirectory#LEAVE_SITE_ICON");

		Confirm(value1 = "Are you sure you want to leave ${siteName}?");

		if ("${siteType}" == "Open") {
			AssertElementPresent(locator1 = "SOUserBarSitesDirectory#JOIN_SITE_ICON");
		}
		else {
			AssertElementPresent(
				locator1 = "SOUserBarSitesDirectory#REQUEST_MEMBERSHIP_ICON"
			);
		}
	}

	macro myProfilePG {
		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_MY_PROFILE",
			value1 = "My Profile"
		);

		AssertTextEquals(locator1 = "SOProfile#USER_NAME", value1 = "${userName}");
	}

	macro requestMembershipSOSite {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO_SITES_DIRECTORY_BUTTON");

		Type(
			locator1 = "SOUserBarSitesDirectory#SITE_SEARCH_FIELD",
			value1 = "${siteName}"
		);

		if ("${siteType}" == "Private Restricted") {
			AssertTextEquals(
				locator1 = "SOUserBarSitesDirectory#SITE_NAME",
				value1 = "${siteName}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
				value1 = "${siteName}"
			);
		}

		ClickNoError(locator1 = "SOUserBarSitesDirectory#REQUEST_MEMBERSHIP_ICON");

		Confirm(
			value1 = "This is a restricted site. Do you want to send a membership request to ${siteName}?"
		);

		AssertElementPresent(
			locator1 = "SOUserBarSitesDirectory#MEMBERSHIP_REQUESTED_ICON"
		);
	}

	macro searchSOSite {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		if ("${siteType}" == "Private") {
			Select(locator1 = "SOUserBar#GO_TO_SITE_CATEGORY_SELECT", value1 = "My Sites");
		}
		else {
			Select(locator1 = "SOUserBar#GO_TO_SITE_CATEGORY_SELECT", value1 = "All Sites");
		}

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Type(locator1 = "SOUserBar#GO_TO_SEARCH_FIELD", value1 = "${siteName}");

		AssertTextEquals(
			locator1 = "SOUserBar#GO_TO_SITE_NAME_LINK",
			value1 = "${siteName}"
		);
	}

	macro tearDownNotifications {
		SOUser.firstLoginPG();

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		MouseOver(locator1 = "SOUserBar#NOTIFICATION");

		AssertClick.assertPartialTextClickAt(
			locator1 = "SOUserBar#NOTIFICATION_MENU_VIEW_ALL",
			value1 = "View All"
		);

		while (IsElementPresent(locator1 = "SONotifications#NOTIFICATIONS_CHECKBOX")) {
			Check(locator1 = "SONotifications#NOTIFICATIONS_CHECKBOX");

			Click.clickAt(locator1 = "SONotifications#DELETE_BUTTON");
		}
	}

	macro tearDownSites {
		SOUser.firstLoginPG();

		SOUserBar.gotoCP(portletName = "Sites");

		Type(locator1 = "CPSites#SEARCH_FIELD", value1 = "Name");

		AssertClick.assertValueClickAt(
			locator1 = "CPSites#SEARCH_BUTTON",
			value1 = "Search"
		);

		while (IsElementPresent(locator1 = "CPSites#SITE_TABLE_ACTIONS")) {
			AssertClick(locator1 = "CPSites#SITE_TABLE_ACTIONS", value1 = "Actions");

			AssertClickNoError(locator1 = "CPSites#SITE_MENULIST_DELETE", value1 = "Delete");

			Confirm(value1 = "Are you sure you want to delete this?");
		}
	}
}