<definition>
	<command name="addSOSite">
		<execute action="SOUserBar#click" locator1="DASHBOARD" />
		<execute action="SOUserBar#click" locator1="GO_TO" />
		<execute action="SOUserBar#click" locator1="GO_TO_ADD_SITE_BUTTON" />

		<execute action="SOUserBarAddSite#type" locator1="NAME_FIELD" value1="${siteName}" />
		<execute action="SOUserBarAddSite#type" locator1="DESCRIPTION_FIELD" value1="${siteDescription}" />
		<execute action="SOUserBarAddSite#click" locator1="NEXT_BUTTON" />
		<execute action="SOUserBarAddSite#select" locator1="DEFAULT_PAGES_SELECT" value1="Default Social Office Site" />

		<execute action="SOUserBarAddSite#check" locator1="HOME_CHECKBOX" />
		<execute action="SOUserBarAddSite#check" locator1="CALENDAR_CHECKBOX" />
		<execute action="SOUserBarAddSite#check" locator1="DOCUMENTS_CHECKBOX" />
		<execute action="SOUserBarAddSite#check" locator1="FORUMS_CHECKBOX" />
		<execute action="SOUserBarAddSite#check" locator1="BLOGS_CHECKBOX" />
		<execute action="SOUserBarAddSite#check" locator1="WIKI_CHECKBOX" />
		<execute action="SOUserBarAddSite#check" locator1="MEMBERS_CHECKBOX" />

		<if>
			<equals arg1="${siteType}" arg2="Private" />
			<then>
				<execute action="SOUserBarAddSite#select" locator1="TYPE_SELECT" value1="value=3" />
				<execute action="SOUserBarAddSite#assertSelectedLabel" locator1="TYPE_SELECT" value1="Private" />
			</then>
			<else>
				<execute action="SOUserBarAddSite#select" locator1="TYPE_SELECT" value1="${siteType}" />
			</else>
		</if>

		<execute action="SOUserBarAddSite#click" locator1="SAVE_BUTTON" />
		<execute action="SOUserBarAddSite#assertElementNotPresent" locator1="SAVE_BUTTON" />
	</command>

	<command name="dashboardPG">
		<execute action="SOUserBar#click" locator1="DASHBOARD" />

		<execute action="SODashboard#assertTextEquals" locator1="PROFILE_NAME" value1="${userName}" />
	</command>

	<command name="deleteSOSite">
		<execute action="SOUserBar#click" locator1="DASHBOARD" />
		<execute action="SOUserBar#click" locator1="GO_TO" />
		<execute action="SOUserBar#click" locator1="GO_TO_SITES_DIRECTORY_BUTTON" />

		<if>
			<equals arg1="${siteType}" arg2="Private" />
			<then>
				<execute action="SOUserBar#click" locator1="GO_TO" />
				<execute action="SOUserBar#select" locator1="GO_TO_SITE_CATEGORY_SELECT" value1="My Sites" />
			</then>
			<else>
				<execute action="SOUserBar#click" locator1="GO_TO" />
				<execute action="SOUserBar#select" locator1="GO_TO_SITE_CATEGORY_SELECT" value1="All Sites" />
			</else>
		</if>

		<execute action="SOUserBarSitesDirectory#type" locator1="SITE_SEARCH_FIELD" value1="${siteName}" />
		<execute action="SOUserBarSitesDirectory#assertTextEquals" locator1="SITE_NAME_LINK" value1="${siteName}" />
		<execute action="SOUserBarSitesDirectory#assertClickNoError" locator1="DELETE_SITE_ICON" value1="Delete" />
		<execute action="SOUserBarSitesDirectory#confirm" locator1="CONFIRMATION" value1="Are you sure you want to delete ${siteName}?" />
		<execute action="SOUserBarSitesDirectory#assertTextNotPresent" value1="${siteName}" />
	</command>

	<command name="favoriteSOSite">
		<execute action="SOUserBar#click" locator1="DASHBOARD" />
		<execute action="SOUserBar#click" locator1="GO_TO" />
		<execute action="SOUserBar#type" locator1="GO_TO_SEARCH_FIELD" value1="${siteName}" />
		<execute action="SOUserBar#assertTextEquals" locator1="GO_TO_SITE_NAME_LINK" value1="${siteName}" />
		<execute action="SOUserBar#click" locator1="GO_TO_FAVORITE_SITE_ICON" />
		<execute action="SOUserBar#assertElementPresent" locator1="GO_TO_UNFAVORITE_SITE_ICON" />
	</command>

	<command name="gotoCP">
		<execute action="Home#open" locator1="GUEST_URL" />

		<execute action="SOUserBar#click" locator1="USER_NAME" />
		<execute action="SOUserBar#click" locator1="USER_MENU_CONTROL_PANEL" value1="Control Panel" />

		<if>
			<isset var="siteScopeName" />
			<then>
				<execute action="Home#click" locator1="SCOPE_SELECTOR" />

				<var name="key_siteScopeName" value="${siteScopeName}" />

				<execute action="Home#click" locator1="SCOPE_SELECTOR_MENULIST_ITEM" />
			</then>
		</if>

		<if>
			<equals arg1="${portletName}" arg2="Workflow" />
			<then>
				<execute function="#click" locator1="xPath=(//ul[@class='category-portlets']/li/a[contains(.,'${portletName}')])[3]" />
			</then>
			<else>
				<execute function="#click" locator1="//ul[@class='category-portlets']/li/a[contains(.,'${portletName}')]" />
			</else>
		</if>
	</command>

	<command name="gotoProfile">
		<execute macro="SOUserBar#dashboardPG">
			<var name="userName" value="${userName}" />
		</execute>

		<execute action="SOUserBar#click" locator1="USER_NAME" />
		<execute action="SOUserBar#click" locator1="USER_MENU_MY_PROFILE" value1="My Profile" />
	</command>

	<command name="joinSOSite">
		<execute action="SOUserBar#click" locator1="DASHBOARD" />
		<execute action="SOUserBar#click" locator1="GO_TO" />
		<execute action="SOUserBar#click" locator1="GO_TO_SITES_DIRECTORY_BUTTON" />

		<execute action="SOUserBarSitesDirectory#type" locator1="SITE_SEARCH_FIELD" value1="${siteName}" />
		<execute action="SOUserBarSitesDirectory#assertTextEquals" locator1="SITE_NAME_LINK" value1="${siteName}" />
		<execute action="SOUserBarSitesDirectory#clickNoError" locator1="JOIN_SITE_ICON" />
		<execute action="SOUserBarSitesDirectory#confirm" locator1="CONFIRMATION" value1="Are you sure you want to join ${siteName}?" />
		<execute action="SOUserBarSitesDirectory#assertElementPresent" locator1="LEAVE_SITE_ICON" />
	</command>

	<command name="leaveSOSite">
		<execute action="SOUserBar#click" locator1="DASHBOARD" />
		<execute action="SOUserBar#click" locator1="GO_TO" />
		<execute action="SOUserBar#click" locator1="GO_TO_SITES_DIRECTORY_BUTTON" />

		<execute action="SOUserBarSitesDirectory#type" locator1="SITE_SEARCH_FIELD" value1="${siteName}" />
		<execute action="SOUserBarSitesDirectory#assertTextEquals" locator1="SITE_NAME_LINK" value1="${siteName}" />
		<execute action="SOUserBarSitesDirectory#clickNoError" locator1="LEAVE_SITE_ICON" />
		<execute action="SOUserBarSitesDirectory#confirm" locator1="CONFIRMATION" value1="Are you sure you want to leave ${siteName}?" />

		<if>
			<equals arg1="${siteType}" arg2="Open" />
			<then>
				<execute action="SOUserBarSitesDirectory#assertElementPresent" locator1="JOIN_SITE_ICON" />
			</then>
			<else>
				<execute action="SOUserBarSitesDirectory#assertElementPresent" locator1="REQUEST_MEMBERSHIP_ICON" />
			</else>
		</if>
	</command>

	<command name="myProfilePG">
		<execute action="SOUserBar#click" locator1="USER_NAME" />
		<execute action="SOUserBar#click" locator1="USER_MENU_MY_PROFILE" value1="My Profile" />

		<execute action="SOProfile#assertTextEquals" locator1="USER_NAME" value1="${userName}" />
	</command>

	<command name="requestMembershipSOSite">
		<execute action="SOUserBar#click" locator1="DASHBOARD" />
		<execute action="SOUserBar#click" locator1="GO_TO" />
		<execute action="SOUserBar#click" locator1="GO_TO_SITES_DIRECTORY_BUTTON" />

		<execute action="SOUserBarSitesDirectory#type" locator1="SITE_SEARCH_FIELD" value1="${siteName}" />

		<if>
			<equals arg1="${siteType}" arg2="Private Restricted" />
			<then>
				<execute action="SOUserBarSitesDirectory#assertTextEquals" locator1="SITE_NAME" value1="${siteName}" />
			</then>
			<else>
				<execute action="SOUserBarSitesDirectory#assertTextEquals" locator1="SITE_NAME_LINK" value1="${siteName}" />
			</else>
		</if>

		<execute action="SOUserBarSitesDirectory#clickNoError" locator1="REQUEST_MEMBERSHIP_ICON" />
		<execute action="SOUserBarSitesDirectory#confirm" locator1="CONFIRMATION" value1="This is a restricted site. Do you want to send a membership request to ${siteName}?" />
		<execute action="SOUserBarSitesDirectory#assertElementPresent" locator1="MEMBERSHIP_REQUESTED_ICON" />
	</command>

	<command name="searchSOSite">
		<execute action="SOUserBar#click" locator1="DASHBOARD" />
		<execute action="SOUserBar#click" locator1="GO_TO" />

		<if>
			<equals arg1="${siteType}" arg2="Private" />
			<then>
				<execute action="SOUserBar#select" locator1="GO_TO_SITE_CATEGORY_SELECT" value1="My Sites" />
			</then>
			<else>
				<execute action="SOUserBar#select" locator1="GO_TO_SITE_CATEGORY_SELECT" value1="All Sites" />
			</else>
		</if>

		<execute action="SOUserBar#click" locator1="GO_TO" />
		<execute action="SOUserBar#type" locator1="GO_TO_SEARCH_FIELD" value1="${siteName}" />
		<execute action="SOUserBar#assertTextEquals" locator1="GO_TO_SITE_NAME_LINK" value1="${siteName}" />
	</command>

	<command name="tearDownNotifications">
		<execute macro="SOUser#firstLoginPG" />

		<execute action="SOUserBar#click" locator1="DASHBOARD" />

		<execute action="SOUserBar#mouseOver" locator1="NOTIFICATION" />
		<execute action="SOUserBar#click" locator1="NOTIFICATION_MENU_VIEW_ALL" value1="View All" />

		<while>
			<condition action="SONotifications#isElementPresent" locator1="NOTIFICATIONS_CHECKBOX" />
			<then>
				<execute action="SONotifications#check" locator1="NOTIFICATIONS_CHECKBOX" />
				<execute action="SONotifications#click" locator1="DELETE_BUTTON" />
			</then>
		</while>
	</command>

	<command name="tearDownSites">
		<execute macro="SOUser#firstLoginPG" />

		<execute macro="SOUserBar#gotoCP">
			<var name="portletName" value="Sites" />
		</execute>

		<execute action="CPSites#type" locator1="SEARCH_FIELD" value1="Name" />
		<execute action="CPSites#assertClick" locator1="SEARCH_BUTTON" value1="Search" />

		<while>
			<condition action="CPSites#isElementPresent" locator1="SITE_TABLE_ACTIONS" />
			<then>
				<execute action="CPSites#assertClick" locator1="SITE_TABLE_ACTIONS" value1="Actions" />
				<execute action="CPSites#assertClickNoError" locator1="SITE_MENULIST_DELETE" value1="Delete" />
				<execute action="CPSites#confirm" locator1="CONFIRMATION" value1="Are you sure you want to delete this?" />
			</then>
		</while>
	</command>
</definition>