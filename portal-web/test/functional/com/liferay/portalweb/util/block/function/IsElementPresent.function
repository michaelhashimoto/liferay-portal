@default = "isElementPresent"
definition {
	function isElementPresent {
		selenium.isElementPresent();
	}

	function isElementPresentAfterWait {
		selenium.isElementPresentAfterWait();
	}

	function isElementPresentClickNavigation {
		selenium.clickAt("//nav[@id='navigation']");

		selenium.waitForVisible("//li[contains(@class,'lfr-nav-deletable')][1]/a/span");

		selenium.isElementPresent();
	}

	function isElementPresentStaging {
		selenium.waitForElementPresent(
			"//div[@id='layoutsAdminExportPagesPanelContainer']"
		);

		selenium.isElementPresent();
	}

	function isVisible {
		selenium.isVisible();
	}

	function pauseIsElementPresent {
		selenium.pause("1000");

		selenium.isElementPresent();
	}

	function waitForVisible {
		selenium.waitForVisible();

		IsElementPresent.isVisible();
	}
}