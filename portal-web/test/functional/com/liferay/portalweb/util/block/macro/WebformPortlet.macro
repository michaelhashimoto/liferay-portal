definition {
	macro configureWebformPG {
		AssertTextEquals(locator1 = "PGWebform#PORTLET_TITLE", value1 = "Web Form");

		AssertTextEquals(
			locator1 = "PGWebform#DEFAULT_FORM_INFORMATION_TITLE",
			value1 = "${webFormInformationTitle}"
		);

		AssertTextEquals(
			locator1 = "PGWebform#DEFAULT_FORM_INFORMATION_DESCRIPTION",
			value1 = "${webFormInformationDescription}"
		);

		AssertTextEquals(
			locator1 = "PGWebform#DEFAULT_FORM_FIELDS_NAME_HEADER",
			value1 = "${webFormFieldsName}"
		);

		AssertElementPresent(locator1 = "PGWebform#DEFAULT_FORM_FIELDS_NAME");

		AssertTextEquals(
			locator1 = "PGWebform#DEFAULT_FORM_FIELDS_RATING_HEADER",
			value1 = "${webFormFieldsRating}"
		);

		AssertElementPresent(locator1 = "PGWebform#DEFAULT_FORM_FIELDS_RATING");

		AssertTextEquals(
			locator1 = "PGWebform#DEFAULT_FORM_FIELDS_COMMENTS_HEADER",
			value1 = "${webFormFieldsComments}"
		);

		AssertElementPresent(locator1 = "PGWebform#DEFAULT_FORM_FIELDS_COMMENTS");

		Click.pauseClickAt(locator1 = "PGWebform#PORTLET_OPTIONS");

		AssertClick.assertTextClickAt(
			locator1 = "PGWebform#WEBFORM_OPTIONS_MENULIST_CONFIGURATION",
			value1 = "Configuration"
		);

		SelectFrame(locator1 = "PGWebformConfiguration#CONFIGURATION_IFRAME");

		Type.clickAtSendKeys(
			locator1 = "PGWebformConfiguration#SETUP_FORM_INFORMATION_TITLE",
			value1 = "${webFormInformationTitleEdit}"
		);

		Type.clickAtSendKeys(
			locator1 = "PGWebformConfiguration#SETUP_FORM_INFORMATION_DESCRIPTION",
			value1 = "${webFormInformationDescriptionEdit}"
		);

		Type.clickAtSendKeys(
			locator1 = "PGWebformConfiguration#SETUP_FORM_FIELDS_NAME",
			value1 = "${webFormFieldsNameEdit}"
		);

		Type.clickAtSendKeys(
			locator1 = "PGWebformConfiguration#SETUP_FORM_FIELDS_RATING",
			value1 = "${webFormFieldsRatingEdit}"
		);

		Type.clickAtSendKeys(
			locator1 = "PGWebformConfiguration#SETUP_FORM_FIELDS_COMMENTS",
			value1 = "${webFormFieldsCommentsEdit}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGWebformConfiguration#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "PGWebformConfiguration#SUCCESS_MESSAGE",
			value1 = "You have successfully updated the setup."
		);
	}

	macro viewConfigureWebformPG {
		AssertTextEquals(locator1 = "PGWebform#PORTLET_TITLE", value1 = "Web Form");

		AssertTextNotEquals(
			locator1 = "PGWebform#DEFAULT_FORM_INFORMATION_TITLE",
			value1 = "${webFormInformationTitle}"
		);

		AssertTextEquals(
			locator1 = "PGWebform#DEFAULT_FORM_INFORMATION_TITLE",
			value1 = "${webFormInformationTitleEdit}"
		);

		AssertTextNotEquals(
			locator1 = "PGWebform#DEFAULT_FORM_INFORMATION_DESCRIPTION",
			value1 = "${webFormInformationDescription}"
		);

		AssertTextEquals(
			locator1 = "PGWebform#DEFAULT_FORM_INFORMATION_DESCRIPTION",
			value1 = "${webFormInformationDescriptionEdit}"
		);

		AssertTextNotEquals(
			locator1 = "PGWebform#DEFAULT_FORM_FIELDS_NAME_HEADER",
			value1 = "${webFormFieldsName}"
		);

		AssertTextEquals(
			locator1 = "PGWebform#DEFAULT_FORM_FIELDS_NAME_HEADER",
			value1 = "${webFormFieldsNameEdit}"
		);

		AssertElementPresent(locator1 = "PGWebform#DEFAULT_FORM_FIELDS_NAME");

		AssertTextNotEquals(
			locator1 = "PGWebform#DEFAULT_FORM_FIELDS_RATING_HEADER",
			value1 = "${webFormFieldsRating}"
		);

		AssertTextEquals(
			locator1 = "PGWebform#DEFAULT_FORM_FIELDS_RATING_HEADER",
			value1 = "${webFormFieldsRatingEdit}"
		);

		AssertElementPresent(locator1 = "PGWebform#DEFAULT_FORM_FIELDS_RATING");

		AssertTextNotEquals(
			locator1 = "PGWebform#DEFAULT_FORM_FIELDS_COMMENTS_HEADER",
			value1 = "${webFormFieldsComments}"
		);

		AssertTextEquals(
			locator1 = "PGWebform#DEFAULT_FORM_FIELDS_COMMENTS_HEADER",
			value1 = "${webFormFieldsCommentsEdit}"
		);

		AssertElementPresent(locator1 = "PGWebform#DEFAULT_FORM_FIELDS_COMMENTS");
	}
}