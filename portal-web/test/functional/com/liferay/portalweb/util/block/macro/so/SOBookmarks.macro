definition {
	macro addBookmarksEntry {
		Click(locator1 = "SOSiteHome#BOOKMARKS_ADD_ENTRY_LINK");

		if (isSet(number)) {
			var number = "${number}";

			Type(
				locator1 = "SOSiteHomeBookmarksAdd#NAME_FIELD",
				value1 = "${bookmarksEntryName}${number}"
			);

			Type(
				locator1 = "SOSiteHomeBookmarksAdd#URL_FIELD",
				value1 = "${bookmarksEntryUrl}"
			);

			Type(
				locator1 = "SOSiteHomeBookmarksAdd#DESCRIPTION_FIELD",
				value1 = "${bookmarksEntryDescription}${number}"
			);

			Click(locator1 = "SOSiteHomeBookmarksAdd#SAVE_BUTTON");

			AssertTextEquals(
				locator1 = "SOSiteHome#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);

			AssertTextEquals(
				locator1 = "SOSiteHome#BOOKMARKS_ENTRY_LINK_INCREMENT",
				value1 = "${bookmarksEntryName}${number}"
			);
		}
		else {
			Type(
				locator1 = "SOSiteHomeBookmarksAdd#NAME_FIELD",
				value1 = "${bookmarksEntryName}"
			);

			Type(
				locator1 = "SOSiteHomeBookmarksAdd#URL_FIELD",
				value1 = "${bookmarksEntryUrl}"
			);

			Type(
				locator1 = "SOSiteHomeBookmarksAdd#DESCRIPTION_FIELD",
				value1 = "${bookmarksEntryDescription}"
			);

			Click(locator1 = "SOSiteHomeBookmarksAdd#SAVE_BUTTON");

			AssertTextEquals(
				locator1 = "SOSiteHome#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);

			AssertTextEquals(
				locator1 = "SOSiteHome#BOOKMARKS_ENTRY_LINK",
				value1 = "${bookmarksEntryName}"
			);
		}
	}

	macro deleteBookmarksEntry {
		AssertClick(locator1 = "SOSiteHome#BOOKMARKS_ENTRY_ACTIONS", value1 = "Actions");

		AssertClickNoError(
			locator1 = "SOSiteHome#ACTIONS_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextEquals(
			locator1 = "SOSiteHome#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals.assertPartialText(
			locator1 = "SOSiteHome#BOOKMARKS_NO_ENTRIES_MESSAGE",
			value1 = "There are no entries."
		);

		AssertElementNotPresent(locator1 = "SOSiteHome#BOOKMARKS_ENTRY_LINK");
	}

	macro editBookmarksEntry {
		AssertClick(locator1 = "SOSiteHome#BOOKMARKS_ENTRY_ACTIONS", value1 = "Actions");

		AssertClick.assertTextClickAt(
			locator1 = "SOSiteHome#ACTIONS_MENULIST_EDIT",
			value1 = "Edit"
		);

		Type(
			locator1 = "SOSiteHomeBookmarksAdd#NAME_FIELD",
			value1 = "${bookmarksEntryNameEdit}"
		);

		Type(
			locator1 = "SOSiteHomeBookmarksAdd#URL_FIELD",
			value1 = "${bookmarksEntryUrlEdit}"
		);

		Type(
			locator1 = "SOSiteHomeBookmarksAdd#DESCRIPTION_FIELD",
			value1 = "${bookmarksEntryDescriptionEdit}"
		);

		Click(locator1 = "SOSiteHomeBookmarksAdd#SAVE_BUTTON");

		AssertTextEquals(
			locator1 = "SOSiteHome#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "SOSiteHome#BOOKMARKS_ENTRY_LINK",
			value1 = "${bookmarksEntryNameEdit}"
		);
	}

	macro viewBookmarksEntry {
		Click(locator1 = "SOSiteHome#BOOKMARKS_ENTRY_LINK");

		if ("${bookmarksEntryUrl}" == "http://www.google.com") {
			SelectWindow(locator1 = "SOSiteHome#BOOKMARKS_POP_UP_GOOGLE");

			AssertElementPresent(locator1 = "SOSiteHome#BOOKMARKS_POP_UP_IMAGE_GOOGLE");

			Close.closeWindow(locator1 = "SOSiteHome#BOOKMARKS_POP_UP_GOOGLE");
		}
		else if ("${bookmarksEntryUrl}" == "http://www.yahoo.com") {
			SelectWindow(locator1 = "SOSiteHome#BOOKMARKS_POP_UP_YAHOO");

			AssertElementPresent(locator1 = "SOSiteHome#BOOKMARKS_POP_UP_IMAGE_YAHOO");

			Close.closeWindow(locator1 = "SOSiteHome#BOOKMARKS_POP_UP_YAHOO");
		}
		else {
			SelectWindow(locator1 = "SOSiteHome#BOOKMARKS_POP_UP_MSN");

			AssertElementPresent(locator1 = "SOSiteHome#BOOKMARKS_POP_UP_IMAGE_MSN");

			Close.closeWindow(locator1 = "SOSiteHome#BOOKMARKS_POP_UP_MSN");
		}

		AssertClick(locator1 = "SOSiteHome#BOOKMARKS_ENTRY_ACTIONS", value1 = "Actions");

		AssertClick.assertTextClickAt(
			locator1 = "SOSiteHome#ACTIONS_MENULIST_EDIT",
			value1 = "Edit"
		);

		AssertTextEquals(
			locator1 = "SOSiteHomeBookmarksAdd#NAME_FIELD",
			value1 = "${bookmarksEntryName}"
		);

		AssertTextEquals(
			locator1 = "SOSiteHomeBookmarksAdd#URL_FIELD",
			value1 = "${bookmarksEntryUrl}"
		);

		AssertTextEquals(
			locator1 = "SOSiteHomeBookmarksAdd#DESCRIPTION_FIELD",
			value1 = "${bookmarksEntryDescription}"
		);
	}
}