<definition>
	<command name="addBookmarksEntry">
		<execute function="Click" locator1="SOSiteHome#BOOKMARKS_ADD_ENTRY_LINK" />

		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />
				<execute function="Type" locator1="SOSiteHomeBookmarksAdd#NAME_FIELD" value1="${bookmarksEntryName}${number}" />
				<execute function="Type" locator1="SOSiteHomeBookmarksAdd#URL_FIELD" value1="${bookmarksEntryUrl}" />
				<execute function="Type" locator1="SOSiteHomeBookmarksAdd#DESCRIPTION_FIELD" value1="${bookmarksEntryDescription}${number}" />
				<execute function="Click" locator1="SOSiteHomeBookmarksAdd#SAVE_BUTTON"  />

				<execute function="AssertTextEquals" locator1="SOSiteHome#SUCCESS_MESSAGE" value1="Your request completed successfully." />
				<execute function="AssertTextEquals" locator1="SOSiteHome#BOOKMARKS_ENTRY_LINK_INCREMENT" value1="${bookmarksEntryName}${number}" />
			</then>
			<else>
				<execute function="Type" locator1="SOSiteHomeBookmarksAdd#NAME_FIELD" value1="${bookmarksEntryName}" />
				<execute function="Type" locator1="SOSiteHomeBookmarksAdd#URL_FIELD" value1="${bookmarksEntryUrl}" />
				<execute function="Type" locator1="SOSiteHomeBookmarksAdd#DESCRIPTION_FIELD" value1="${bookmarksEntryDescription}" />
				<execute function="Click" locator1="SOSiteHomeBookmarksAdd#SAVE_BUTTON"  />

				<execute function="AssertTextEquals" locator1="SOSiteHome#SUCCESS_MESSAGE" value1="Your request completed successfully." />
				<execute function="AssertTextEquals" locator1="SOSiteHome#BOOKMARKS_ENTRY_LINK" value1="${bookmarksEntryName}" />
			</else>
		</if>
	</command>

	<command name="deleteBookmarksEntry">
		<execute function="AssertClick" locator1="SOSiteHome#BOOKMARKS_ENTRY_ACTIONS" value1="Actions" />
		<execute function="AssertClickNoError" locator1="SOSiteHome#ACTIONS_MENULIST_DELETE" value1="Delete" />
		<execute function="Confirm" value1="Are you sure you want to delete this?" />
		<execute function="AssertTextEquals" locator1="SOSiteHome#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals#assertPartialText" locator1="SOSiteHome#BOOKMARKS_NO_ENTRIES_MESSAGE" value1="There are no entries." />
		<execute function="AssertElementNotPresent" locator1="SOSiteHome#BOOKMARKS_ENTRY_LINK" />
	</command>

	<command name="editBookmarksEntry">
		<execute function="AssertClick" locator1="SOSiteHome#BOOKMARKS_ENTRY_ACTIONS" value1="Actions" />
		<execute function="AssertClick#assertTextClickAt" locator1="SOSiteHome#ACTIONS_MENULIST_EDIT" value1="Edit" />

		<execute function="Type" locator1="SOSiteHomeBookmarksAdd#NAME_FIELD" value1="${bookmarksEntryNameEdit}" />
		<execute function="Type" locator1="SOSiteHomeBookmarksAdd#URL_FIELD" value1="${bookmarksEntryUrlEdit}" />
		<execute function="Type" locator1="SOSiteHomeBookmarksAdd#DESCRIPTION_FIELD" value1="${bookmarksEntryDescriptionEdit}" />
		<execute function="Click" locator1="SOSiteHomeBookmarksAdd#SAVE_BUTTON"  />

		<execute function="AssertTextEquals" locator1="SOSiteHome#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals" locator1="SOSiteHome#BOOKMARKS_ENTRY_LINK" value1="${bookmarksEntryNameEdit}" />
	</command>

	<command name="viewBookmarksEntry">
		<execute function="Click" locator1="SOSiteHome#BOOKMARKS_ENTRY_LINK" />

		<if>
			<equals arg1="${bookmarksEntryUrl}" arg2="http://www.google.com" />
			<then>
				<execute function="SelectWindow" locator1="SOSiteHome#BOOKMARKS_POP_UP_GOOGLE" />
				<execute function="AssertElementPresent" locator1="SOSiteHome#BOOKMARKS_POP_UP_IMAGE_GOOGLE" />
				<execute function="Close#closeWindow" locator1="SOSiteHome#BOOKMARKS_POP_UP_GOOGLE" />
			</then>
			<elseif>
				<equals arg1="${bookmarksEntryUrl}" arg2="http://www.yahoo.com" />
				<then>
					<execute function="SelectWindow" locator1="SOSiteHome#BOOKMARKS_POP_UP_YAHOO" />
					<execute function="AssertElementPresent" locator1="SOSiteHome#BOOKMARKS_POP_UP_IMAGE_YAHOO" />
					<execute function="Close#closeWindow" locator1="SOSiteHome#BOOKMARKS_POP_UP_YAHOO" />
				</then>
			</elseif>
			<else>
				<execute function="SelectWindow" locator1="SOSiteHome#BOOKMARKS_POP_UP_MSN" />
				<execute function="AssertElementPresent" locator1="SOSiteHome#BOOKMARKS_POP_UP_IMAGE_MSN" />
				<execute function="Close#closeWindow" locator1="SOSiteHome#BOOKMARKS_POP_UP_MSN" />
			</else>
		</if>

		<execute function="AssertClick" locator1="SOSiteHome#BOOKMARKS_ENTRY_ACTIONS" value1="Actions" />
		<execute function="AssertClick#assertTextClickAt" locator1="SOSiteHome#ACTIONS_MENULIST_EDIT" value1="Edit" />

		<execute function="AssertTextEquals" locator1="SOSiteHomeBookmarksAdd#NAME_FIELD" value1="${bookmarksEntryName}" />
		<execute function="AssertTextEquals" locator1="SOSiteHomeBookmarksAdd#URL_FIELD" value1="${bookmarksEntryUrl}" />
		<execute function="AssertTextEquals" locator1="SOSiteHomeBookmarksAdd#DESCRIPTION_FIELD" value1="${bookmarksEntryDescription}" />
	</command>
</definition>