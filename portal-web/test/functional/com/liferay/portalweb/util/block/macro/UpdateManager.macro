definition {
	macro UninstallPlugins {
		Page.gotoCP(portletName = "Update Manager");

		AssertTextEquals(
			locator1 = "CPUpdateManager#PORTLET_TITLE",
			value1 = "Update Manager"
		);

		AssertTextEquals(
			locator1 = "CPUpdateManager#PLUGIN_NAME",
			value1 = "${pluginName}"
		);

		AssertClick(locator1 = "CPUpdateManager#UNINSTALL", value1 = "Uninstall");

		AssertTextEquals(
			locator1 = "CPUpdateManager#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextNotPresent(value1 = "${pluginName}");
	}
}