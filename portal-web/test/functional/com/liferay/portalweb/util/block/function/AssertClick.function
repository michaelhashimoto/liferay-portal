@default = "assertClick"
@summary = "Click on '${locator1}' that should have a value of '${value1}'"
definition {
	function assertClick {
		if (contains("${locator1}", "/input")) {
			AssertClick.assertValueClickAt();
		}
		else {
			AssertClick.assertTextClickAt();
		}
	}

	@summary = "Click on '${locator1}' that should contain a value of '${value1}'"
	function assertPartialTextClickAt {
		AssertTextEquals.assertPartialText();

		selenium.clickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertTextClick {
		AssertTextEquals.assertText();

		selenium.click();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertTextClickAt {
		AssertTextEquals.assertText();

		selenium.clickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertTextClickAtClickDockbar {
		selenium.clickAt("//div[@id='dockbar']", "");

		selenium.waitForElementPresent(
			"//script[contains(@src,'/aui/aui-button-item/aui-button-item-min.js')]"
		);

		AssertClick.assertTextClickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertValueClickAt {
		AssertTextEquals.assertValue();

		selenium.clickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertValueClickAtCKEditor {
		selenium.waitForVisible("//a[@class='cke_button_cut cke_disabled']");

		AssertClick.assertValueClickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertValueClickAtClickAt {
		AssertTextEquals.assertValue();

		selenium.clickAt();

		selenium.clickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertValueClickAtPause {
		AssertTextEquals.assertValue();

		selenium.clickAt();

		selenium.pause("1000");

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function pauseAssertPartialTextClickAt {
		selenium.pause("1000");

		AssertClick.assertPartialTextClickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function pauseAssertTextClickAt {
		selenium.pause("1000");

		AssertClick.assertTextClickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}
}