<definition>
	<command name="tearDownCP">
		<execute action="SOUserBar#click" locator1="DASHBOARD" />
		<execute action="SOUserBar#click" locator1="USER_NAME" />
		<execute action="SOUserBar#click" locator1="USER_MENU_CONTROL_PANEL" value1="Control Panel" />

		<execute function="#click" locator1="//ul[@class='category-portlets']/li/a[contains(.,'Calendar')]" />

		<execute action="PGCalendar#assertClick" locator1="VIEW_EVENTS" value1="Events" />

		<while>
			<condition action="CPCalendarEvents#isElementPresent" locator1="EVENT_TABLE_ACTIONS" value1="Actions" />
			<then>
				<execute action="CPCalendarEvents#assertClick" locator1="EVENT_TABLE_ACTIONS"  value1="Actions" />
				<execute action="CPCalendarEvents#assertClickNoError" locator1="EVENT_MENULIST_DELETE" value1="Delete" />
				<execute action="CPCalendarEvents#confirm" locator1="CONFIRMATION" value1="Are you sure you want to delete this?" />
				<execute action="CPCalendarEvents#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</while>

		<execute action="CPCalendarEvents#assertElementNotPresent" locator1="EVENT_TABLE_ACTIONS" value1="Actions" />
	</command>
</definition>