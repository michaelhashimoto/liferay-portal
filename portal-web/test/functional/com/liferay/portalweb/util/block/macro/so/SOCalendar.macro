definition {
	macro tearDownCP {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_CONTROL_PANEL",
			value1 = "Control Panel"
		);

		Click(
			locator1 = "//ul[@class='category-portlets']/li/a[contains(.,'Calendar')]"
		);

		AssertClick.assertTextClickAt(
			locator1 = "PGCalendar#VIEW_EVENTS",
			value1 = "Events"
		);

		while (IsElementPresent(locator1 = "CPCalendarEvents#EVENT_TABLE_ACTIONS", value1 = "Actions")) {
			AssertClick(
				locator1 = "CPCalendarEvents#EVENT_TABLE_ACTIONS",
				value1 = "Actions"
			);

			AssertClickNoError(
				locator1 = "CPCalendarEvents#EVENT_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete this?");

			AssertTextEquals(
				locator1 = "CPCalendarEvents#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}

		AssertElementNotPresent(
			locator1 = "CPCalendarEvents#EVENT_TABLE_ACTIONS",
			value1 = "Actions"
		);
	}
}