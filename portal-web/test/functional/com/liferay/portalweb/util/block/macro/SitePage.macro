definition {
	macro _configurePageType {
		var sitePageType = "${sitePageType}";

		if (contains("${sitePageType}", "{sitePageType}")) {
			var sitePageType = "Portlet";
		}

		Select(locator1 = "CPSitepages#DETAILS_TYPE_SELECT", value1 = "${sitePageType}");

		if (("${sitePageType}" == "Embedded") || ("${sitePageType}" == "URL")) {
			Type(locator1 = "CPSitepages#DETAILS_URL_FIELD", value1 = "${url}");
		}
		else if ("${sitePageType}" == "Link to Page") {
			Select(
				locator1 = "CPSitepages#DETAILS_LINK_TO_PAGE_SELECT_FIELD",
				value1 = "regexp:.*${linkToPage}"
			);
		}
		else if ("${sitePageType}" == "Panel") {
			Click(
				locator1 = "CPSitepages#DETAILS_PANEL_APPLICATION_CHECKBOX",
				key_componentName = "${componentName}"
			);
		}
		else if ("${isCopy}" == "true") {
			Click(
				locator1 = "CPSitepages#NAVIGATION_SIDEBAR_NAVIGATION_ENTRY",
				key_sidebarNav = "Advanced"
			);

			Click(locator1 = "CPSitepages#ADVANCED_COPY_PORTLETS_FROM_PAGE_BUTTON");

			Select(
				locator1 = "CPSitepages#ADVANCED_COPY_PORTLETS_FROM_PAGE_SELECT",
				value1 = "regexp:.*${copyPageName}"
			);

			AssertClick(
				locator1 = "CPSitepages#ADVANCED_COPY_SUBMIT_BUTTON",
				value1 = "Copy"
			);
		}

		if (!(contains("${description}", "{description}"))) {
			Type(
				locator1 = "CPSitepages#DETAILS_DESCRIPTION_FIELD",
				value1 = "${description}"
			);
		}
	}

	macro addChildCP {
		Type(locator1 = "CPSites#SEARCH_FIELD", value1 = "${siteName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPSites#SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertClick(locator1 = "CPSites#SITE_TABLE_ACTIONS", value1 = "Actions");

		AssertClick(
			locator1 = "CPSites#SITE_MENULIST_MANAGE_PAGES",
			value1 = "Manage Pages"
		);

		if ("${sitePagePrivacy}" == "Private") {
			AssertClick.assertTextClickAt(
				locator1 = "CPSitepages#NAVIGATION_PRIVATE_PAGES",
				value1 = "Private Pages"
			);
		}
		else if ("${sitePagePrivacy}" == "Public") {
			AssertClick.assertTextClickAt(
				locator1 = "CPSitepages#NAVIGATION_PUBLIC_PAGES",
				value1 = "Public Pages"
			);
		}
		else {
			fail("Invalid var sitePagePrivacy. Must be (Private|Public).");
		}

		SitePage.expandRootCP();

		AssertClick(
			locator1 = "CPSitepages#PAGE_TREE_PAGE_LINK_1",
			value1 = "${sitePageName}"
		);

		AssertClick(
			locator1 = "CPSitepages#TOOLBAR_ADD_CHILD_PAGE",
			value1 = "Add Child Page"
		);

		Type(
			locator1 = "CPSitepages#ADD_PAGE_NAME_FIELD",
			value1 = "${siteChildPageName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPSitepages#ADD_PAGE_BUTTON",
			value1 = "Add Page"
		);

		AssertTextEquals(
			locator1 = "CPSitepages#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		SitePage.expandTreeCP();

		AssertTextEquals(
			locator1 = "CPSitepages#PAGE_TREE_PAGE_LINK_1",
			value1 = "${sitePageName}"
		);

		AssertTextEquals(
			locator1 = "CPSitepages#PAGE_TREE_PAGE_LINK_1_CHILD_PAGE_LINK_1",
			value1 = "${siteChildPageName}"
		);
	}

	macro addCP {
		if (!("${siteScopeSelected}" == "true")) {
			Type(locator1 = "CPSites#SEARCH_FIELD", value1 = "${siteName}");

			AssertClick.assertValueClickAt(
				locator1 = "CPSites#SEARCH_BUTTON",
				value1 = "Search"
			);

			AssertClick(locator1 = "CPSites#SITE_TABLE_ACTIONS", value1 = "Actions");

			AssertClick(
				locator1 = "CPSites#SITE_MENULIST_MANAGE_PAGES",
				value1 = "Manage Pages"
			);
		}

		if ("${sitePagePrivacy}" == "Private") {
			AssertClick.assertTextClickAt(
				locator1 = "CPSitepages#NAVIGATION_PRIVATE_PAGES",
				value1 = "Private Pages"
			);
		}
		else if ("${sitePagePrivacy}" == "Public") {
			AssertClick.assertTextClickAt(
				locator1 = "CPSitepages#NAVIGATION_PUBLIC_PAGES",
				value1 = "Public Pages"
			);
		}
		else {
			fail("Invalid var sitePagePrivacy. Must be (Private|Public).");
		}

		AssertClick(locator1 = "CPSitepages#TOOLBAR_ADD_PAGE", value1 = "Add Page");

		Type(locator1 = "CPSitepages#ADD_PAGE_NAME_FIELD", value1 = "${sitePageName}");

		var sitePageType = "${sitePageType}";

		if (contains("${sitePageType}", "{sitePageType}")) {
			var sitePageType = "Portlet";
		}

		if (contains("${sitePageTemplate}", "{sitePageTemplate}")) {
			Select(
				locator1 = "CPSitepages#ADD_PAGE_TYPE_SELECT",
				value1 = "${sitePageType}"
			);
		}
		else {
			Select(
				locator1 = "CPSitepages#ADD_PAGE_TEMPLATE_SELECT",
				value1 = "${sitePageTemplate}"
			);
		}

		if ("${isHidden}" == "true") {
			Check(locator1 = "CPSitepages#ADD_PAGE_HIDDEN_CHECKBOX");
		}

		AssertClick.assertValueClickAt(
			locator1 = "CPSitepages#ADD_PAGE_BUTTON",
			value1 = "Add Page"
		);

		AssertTextEquals(
			locator1 = "CPSitepages#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		SitePage.expandRootCP();

		AssertTextEquals(
			locator1 = "CPSitepages#PAGE_TREE_PAGE_LINK_GENERIC",
			value1 = "${sitePageName}",
			key_sitePageName = "${sitePageName}"
		);

		Click(
			locator1 = "CPSitepages#PAGE_TREE_PAGE_LINK_GENERIC",
			key_sitePageName = "${sitePageName}"
		);

		SitePage._configurePageType(
			componentName = "${componentName}",
			copyPageName = "${copyPageName}",
			description = "${description}",
			isCopy = "${isCopy}",
			linkToPage = "${linkToPage}",
			sitePageType = "${sitePageType}",
			url = "${url}"
		);

		AssertClick(locator1 = "CPSitepages#SAVE_BUTTON", value1 = "Save");

		AssertTextEquals(
			locator1 = "CPSitepages#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro expandRootCP {
		Click(locator1 = "CPSitepages#PAGE_TREE_ROOT_ARROW");

		AssertElementPresent.assertElementPresent(
			locator1 = "CPSitepages#PAGE_TREE_PAGE_LINK_1"
		);

		if (IsElementNotPresent.isNotVisible(locator1 = "CPSitepages#PAGE_TREE_PAGE_LINK_1")) {
			Click(locator1 = "CPSitepages#PAGE_TREE_ROOT_ARROW");
		}
	}

	macro expandTreeCP {
		Click(locator1 = "CPSitepages#PAGE_TREE_PAGE_ARROW_1");

		if (IsElementNotPresent(locator1 = "CPSitepages#PAGE_TREE_PAGE_LINK_1_CHILD_PAGE_LINK_1")) {
			Click(locator1 = "CPSitepages#PAGE_TREE_PAGE_ARROW_1");
		}

		AssertElementPresent(
			locator1 = "CPSitepages#PAGE_TREE_PAGE_LINK_1_CHILD_PAGE_LINK_1"
		);
	}

	macro exportLarCP {
		AssertClick(locator1 = "CPSitepages#TOOLBAR_EXPORT", value1 = "Export");

		SelectFrame(locator1 = "CPSitepagesExport#EXPORT_IFRAME");

		Type(locator1 = "CPSitepagesExport#EXPORT_FILE_FIELD", value1 = "${file}");

		Check(locator1 = "CPSitepagesExport#APPLICATIONS_MESSAGE_BOARDS_CHECKBOX");

		Check(locator1 = "CPSitepagesExport#OTHER_PERMISSIONS_CHECKBOX");

		Check(locator1 = "CPSitepagesExport#OTHER_CATEGORIES_CHECKBOX");

		AssertClick(locator1 = "CPSitepagesExport#EXPORT_BUTTON", value1 = "Export");

		DownloadTempFile(locator1 = "${file}");

		SelectFrame();
	}

	macro importLarCP {
		AssertClick(locator1 = "CPSitepages#TOOLBAR_IMPORT", value1 = "Import");

		SelectFrame(locator1 = "CPSitepagesImport#IMPORT_IFRAME");

		UploadTempFile(
			locator1 = "CPSitepagesImport#FILE_UPLOAD_FIELD",
			value1 = "${file}"
		);

		Check(locator1 = "CPSitepagesImport#PAGES_DELETE_MISSING_PAGES_CHECKBOX");

		Check(locator1 = "CPSitepagesImport#APPLICATIONS_DELETE_PORTLET_DATA_CHECKBOX");

		Check(locator1 = "CPSitepagesImport#OTHER_PERMISSIONS_CHECKBOX");

		Check(locator1 = "CPSitepagesImport#OTHER_CATEGORIES_CHECKBOX");

		AssertClick.assertValueClickAt(
			locator1 = "CPSitepagesImport#IMPORT_BUTTON",
			value1 = "Import"
		);

		SelectFrame();

		AssertTextEquals(
			locator1 = "CPSitepages#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro selectTheme {
		Page.gotoCP(portletName = "Site Pages");

		if ("${liferayVersion}" == "6101") {
			AssertTextEquals(locator1 = "CPSitepages#HEADER", value1 = "liferay.com");
		}
		else if ("${liferayVersion}" == "6102") {
			AssertTextEquals(locator1 = "CPSitepages#HEADER", value1 = "Liferay");
		}

		AssertClick(
			locator1 = "CPSitepages#NAVIGATION_PUBLIC_PAGES",
			value1 = "Public Pages"
		);

		AssertClick(
			locator1 = "CPSitepages#NAVIGATION_REGULAR_BROWSERS",
			value1 = "Regular Browsers"
		);

		AssertTextNotEquals(
			locator1 = "CPSitepages#CURRENT_THEME_NAME",
			value1 = "${availableThemeName}"
		);

		AssertTextEquals(
			locator1 = "CPSitepages#AVAILABLE_THEME_NAME",
			value1 = "${availableThemeName}"
		);

		var key_availableThemeName = "${availableThemeName}";

		Check(locator1 = "CPSitepages#AVAILABLE_THEME_RADIO");

		Click.clickAt(locator1 = "CPSitepages#SAVE_BUTTON");

		AssertTextEquals(
			locator1 = "CPSitepages#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "CPSitepages#CURRENT_THEME_NAME",
			value1 = "${availableThemeName}"
		);
	}

	macro viewChildPG {
		MouseOver.mouseOverClickNavigation(
			locator1 = "Home#PAGE_1",
			value1 = "${sitePageName}"
		);

		AssertClick.assertTextClickAt(
			locator1 = "Home#PAGE_1_CHILD_PAGE_1",
			value1 = "${siteChildPageName}"
		);

		AssertTextEquals(locator1 = "Home#BREADCRUMB_1", value1 = "${siteGuestName}");

		AssertTextEquals(locator1 = "Home#BREADCRUMB_2", value1 = "${siteName}");

		AssertTextEquals(locator1 = "Home#BREADCRUMB_3", value1 = "${sitePageName}");

		AssertTextEquals(
			locator1 = "Home#BREADCRUMB_4",
			value1 = "${siteChildPageName}"
		);

		AssertTextEquals(locator1 = "Home#SITE_NAME", value1 = "${siteName}");

		AssertLocation(value1 = "${sitePageURL}");
	}

	macro viewPG {
		AssertTextEquals(locator1 = "Home#BREADCRUMB_1", value1 = "${siteGuestName}");

		AssertTextEquals(locator1 = "Home#BREADCRUMB_2", value1 = "${siteName}");

		AssertTextEquals(locator1 = "Home#BREADCRUMB_3", value1 = "${sitePageName}");

		AssertTextEquals(locator1 = "Home#SITE_NAME", value1 = "${siteName}");

		AssertLocation(value1 = "${sitePageURL}");
	}
}