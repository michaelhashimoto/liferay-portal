<definition>
	<command name="addCP">
		<execute function="#assertClick" locator1="CPDynamicdatalists#TOOLBAR_ADD" value1="Add" />

		<execute function="#type" locator1="CPDynamicdatalistsAddlist#NAME_FIELD" value1="${listName}" />
		<execute function="#type" locator1="CPDynamicdatalistsAddlist#DESCRIPTION_FIELD" value1="${listDescription}" />
		<execute function="#assertClick" locator1="CPDynamicdatalistsAddlist#DATA_DEFINITION_SELECT_LINK" value1="Select" />

		<execute function="#selectFrame" locator1="CPDynamicdatalistsAddlistDatadefinitions#DATA_DEFINITIONS_IFRAME" />
		<execute function="#type" locator1="CPDynamicdatalistsAddlistDatadefinitions#BASIC_SEARCH_FIELD" value1="${dataDefinitionName}" />
		<execute function="#assertClick" locator1="CPDynamicdatalistsAddlistDatadefinitions#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="#assertClick" locator1="CPDynamicdatalistsAddlistDatadefinitions#DATA_DEFINITION_TABLE_NAME_1" value1="${dataDefinitionName}" />

		<execute function="#selectFrameTop" />

		<execute function="#assertTextEquals" locator1="CPDynamicdatalistsAddlist#DATA_DEFINITION_NAME" value1="${dataDefinitionName}" />
		<execute function="#assertClick" locator1="CPDynamicdatalistsAddlist#SAVE_BUTTON" value1="Save" />

		<execute function="#assertTextEquals" locator1="CPDynamicdatalists#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="addPG">
		<execute function="#assertClick" locator1="PGDDLDisplay#TOOLBAR_ADD_LIST" />

		<execute function="#type" locator1="PGDDLDisplayAddlist#NAME_FIELD" value1="${listName}" />
		<execute function="#type" locator1="PGDDLDisplayAddlist#DESCRIPTION_FIELD" value1="${listDescription}" />
		<execute function="#assertClick" locator1="PGDDLDisplayAddlist#DATA_DEFINITION_SELECT_LINK" value1="Select" />

		<execute function="#selectFrame" locator1="PGDDLDisplayAddlistDatadefinitions#DATA_DEFINITIONS_IFRAME" />
		<execute function="#type" locator1="PGDDLDisplayAddlistDatadefinitions#BASIC_SEARCH_FIELD" value1="${dataDefinitionName}" />
		<execute function="#assertClick" locator1="PGDDLDisplayAddlistDatadefinitions#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="#assertClick" locator1="PGDDLDisplayAddlistDatadefinitions#DATA_DEFINITION_TABLE_NAME_1" value1="${dataDefinitionName}" />

		<execute function="#selectFrameTop" />
		<execute function="#assertTextEquals" locator1="PGDDLDisplayAddlist#DATA_DEFINITION_NAME" value1="${dataDefinitionName}" />
		<execute function="#assertClick" locator1="PGDDLDisplayAddlist#SAVE_BUTTON" value1="Save" />
	</command>

	<command name="deleteCP">
		<execute function="#type" locator1="CPDynamicdatalists#BASIC_SEARCH_FIELD" value1="${listName}" />
		<execute function="#assertClick" locator1="CPDynamicdatalists#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="#assertTextEquals" locator1="CPDynamicdatalists#LIST_TABLE_NAME_1" value1="${listName}" />
		<execute function="#assertClick" locator1="CPDynamicdatalists#LIST_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="#assertClickNoError" locator1="CPDynamicdatalists#LIST_MENULIST_DELETE" value1="Delete" />
		<execute function="#confirm" locator1="CPDynamicdatalists#CONFIRMATION" value1="Are you sure you want to delete this?" />
		<execute function="#assertTextEquals" locator1="CPDynamicdatalists#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="#assertTextNotPresent" value1="${listName}" />
	</command>

	<command name="deletePG">
		<execute function="#assertClick" locator1="PGDDLDisplay#TOOLBAR_SELECT_LIST" />

		<execute function="#selectFrame" locator1="PGDDLDisplayConfiguration#CONFIGURATION_IFRAME" />
		<execute function="#type" locator1="PGDDLDisplayConfiguration#BASIC_SEARCH_FIELD" value1="${listName}" />
		<execute function="#assertClick" locator1="PGDDLDisplayConfiguration#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="#assertTextEquals" locator1="PGDDLDisplayConfiguration#LIST_TABLE_NAME_1" value1="${listName}" />
		<execute function="#assertClick" locator1="PGDDLDisplayConfiguration#LIST_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="#assertClickNoError" locator1="PGDDLDisplayConfiguration#LIST_MENULIST_DELETE" value1="Delete" />
		<execute function="#confirm" locator1="PGDDLDisplayConfiguration#CONFIRMATION" value1="Are you sure you want to delete this?" />
		<execute function="#assertTextNotPresent" value1="${listNameEdit}" />

		<execute function="#selectFrameTop" />
	</command>

	<command name="editCP">
		<execute function="#type" locator1="CPDynamicdatalists#BASIC_SEARCH_FIELD" value1="${listName}" />
		<execute function="#assertClick" locator1="CPDynamicdatalists#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="#assertTextEquals" locator1="CPDynamicdatalists#LIST_TABLE_NAME_1" value1="${listName}" />
		<execute function="#assertClick" locator1="CPDynamicdatalists#LIST_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="#assertClick" locator1="CPDynamicdatalists#LIST_MENULIST_EDIT" value1="Edit" />

		<execute function="#type" locator1="CPDynamicdatalistsEditlist#NAME_FIELD" value1="${listNameEdit}" />
		<execute function="#type" locator1="CPDynamicdatalistsEditlist#DESCRIPTION_FIELD" value1="${listDescriptionEdit}" />
		<execute function="#assertClick" locator1="CPDynamicdatalistsEditlist#SAVE_BUTTON" value1="Save" />

		<execute function="#assertTextEquals" locator1="CPDynamicdatalists#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="editPG">
		<execute function="#assertClick" locator1="PGDDLDisplay#TOOLBAR_SELECT_LIST" />

		<execute function="#selectFrame" locator1="PGDDLDisplayConfiguration#CONFIGURATION_IFRAME" />
		<execute function="#type" locator1="PGDDLDisplayConfiguration#BASIC_SEARCH_FIELD" value1="${listName}" />
		<execute function="#assertClick" locator1="PGDDLDisplayConfiguration#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="#assertTextEquals" locator1="PGDDLDisplayConfiguration#LIST_TABLE_NAME_1" value1="${listName}" />
		<execute function="#assertClick" locator1="PGDDLDisplayConfiguration#LIST_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="#assertClick" locator1="PGDDLDisplayConfiguration#LIST_MENULIST_EDIT" value1="Edit" />

		<execute function="#type" locator1="PGDDLDisplayConfigurationEditlist#NAME_FIELD" value1="${listNameEdit}" />
		<execute function="#type" locator1="PGDDLDisplayConfigurationEditlist#DESCRIPTION_FIELD" value1="${listDescriptionEdit}" />
		<execute function="#assertClick" locator1="PGDDLDisplayConfigurationEditlist#SAVE_BUTTON" value1="Save" />

		<execute function="#assertTextEquals" locator1="PGDDLDisplayConfiguration#INFO_MESSAGE" value1="Displaying List: ${listNameEdit}" />
		<execute function="#assertTextEquals" locator1="PGDDLDisplayConfiguration#LIST_TABLE_NAME_1" value1="${listNameEdit}" />
		<execute function="#assertTextEquals" locator1="PGDDLDisplayConfiguration#LIST_TABLE_DESCRIPTION_1" value1="${listDescriptionEdit}" />

		<execute function="#selectFrameTop" />
	</command>

	<command name="selectPG">
		<execute function="#assertClick" locator1="PGDDLDisplay#TOOLBAR_SELECT_LIST" />

		<execute function="#selectFrame" locator1="PGDDLDisplayConfiguration#CONFIGURATION_IFRAME" />
		<execute function="#type" locator1="PGDDLDisplayConfiguration#BASIC_SEARCH_FIELD" value1="${listName}" />
		<execute function="#assertClick" locator1="PGDDLDisplayConfiguration#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="#assertClick" locator1="PGDDLDisplayConfiguration#LIST_TABLE_NAME_1" value1="${listName}" />
		<execute function="#assertTextEquals" locator1="PGDDLDisplayConfiguration#INFO_MESSAGE" value1="Displaying List: ${listName} (Modified)" />
		<execute function="#assertClick" locator1="PGDDLDisplayConfiguration#SAVE_BUTTON" value1="Save" />
		<execute function="#assertTextEquals" locator1="PGDDLDisplayConfiguration#SUCCESS_MESSAGE" value1="You have successfully updated the setup." />

		<execute function="#selectFrameTop" />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Dynamic Data Lists" />
		</execute>

		<while>
			<condition function="#isElementPresent" locator1="CPDynamicdatalists#LIST_TABLE_ACTIONS_1" />
			<then>
				<execute function="#assertClick" locator1="CPDynamicdatalists#LIST_TABLE_ACTIONS_1" value1="Actions" />
				<execute function="#assertClickNoError" locator1="CPDynamicdatalists#LIST_MENULIST_DELETE" value1="Delete" />
				<execute function="#confirm" locator1="CPDynamicdatalists#CONFIRMATION" value1="Are you sure you want to delete this?" />
				<execute function="#assertTextEquals" locator1="CPDynamicdatalists#SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</while>
	</command>

	<command name="viewCP">
		<execute function="#type" locator1="CPDynamicdatalists#BASIC_SEARCH_FIELD" value1="${listName}" />
		<execute function="#assertClick" locator1="CPDynamicdatalists#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="#assertTextEquals" locator1="CPDynamicdatalists#LIST_TABLE_NAME_1" value1="${listName}" />
		<execute function="#assertTextEquals" locator1="CPDynamicdatalists#LIST_TABLE_DESCRIPTION_1" value1="${listDescription}" />
		<execute function="#assertClick" locator1="CPDynamicdatalists#LIST_TABLE_NAME_1" value1="${listName}" />

		<execute function="#assertTextEquals" locator1="CPDynamicdatalistsList#HEADER_TITLE" value1="${listName}" />
		<execute function="#assertElementPresent" locator1="CPDynamicdatalistsList#ADD_RECORD_BUTTON" />
	</command>

	<command name="viewPG">
		<execute function="#assertTextEquals" locator1="PGDDLDisplay#HEADER_TITLE" value1="${listName}" />
	</command>
</definition>