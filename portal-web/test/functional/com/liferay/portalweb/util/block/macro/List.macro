definition {
	macro addCP {
		AssertClick.assertTextClickAt(
			locator1 = "CPDynamicdatalists#TOOLBAR_ADD",
			value1 = "Add"
		);

		Type.clickAtSendKeys(
			locator1 = "CPDynamicdatalistsAddlist#NAME_FIELD",
			value1 = "${listName}"
		);

		Type.clickAtSendKeys(
			locator1 = "CPDynamicdatalistsAddlist#DESCRIPTION_FIELD",
			value1 = "${listDescription}"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPDynamicdatalistsAddlist#DATA_DEFINITION_SELECT_LINK",
			value1 = "Select"
		);

		SelectFrame(
			locator1 = "CPDynamicdatalistsAddlistDatadefinitions#DATA_DEFINITIONS_IFRAME"
		);

		Type(
			locator1 = "CPDynamicdatalistsAddlistDatadefinitions#BASIC_SEARCH_FIELD",
			value1 = "${dataDefinitionName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalistsAddlistDatadefinitions#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertClick(
			locator1 = "CPDynamicdatalistsAddlistDatadefinitions#DATA_DEFINITION_TABLE_NAME_1",
			value1 = "${dataDefinitionName}"
		);

		SelectFrameTop();

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsAddlist#DATA_DEFINITION_NAME",
			value1 = "${dataDefinitionName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalistsAddlist#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalists#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro addPG {
		Click.clickAt(locator1 = "PGDDLDisplay#TOOLBAR_ADD_LIST");

		Type(locator1 = "PGDDLDisplayAddlist#NAME_FIELD", value1 = "${listName}");

		Type(
			locator1 = "PGDDLDisplayAddlist#DESCRIPTION_FIELD",
			value1 = "${listDescription}"
		);

		AssertClick(
			locator1 = "PGDDLDisplayAddlist#DATA_DEFINITION_SELECT_LINK",
			value1 = "Select"
		);

		SelectFrame(
			locator1 = "PGDDLDisplayAddlistDatadefinitions#DATA_DEFINITIONS_IFRAME"
		);

		Type(
			locator1 = "PGDDLDisplayAddlistDatadefinitions#BASIC_SEARCH_FIELD",
			value1 = "${dataDefinitionName}"
		);

		AssertClick(
			locator1 = "PGDDLDisplayAddlistDatadefinitions#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertClick(
			locator1 = "PGDDLDisplayAddlistDatadefinitions#DATA_DEFINITION_TABLE_NAME_1",
			value1 = "${dataDefinitionName}"
		);

		SelectFrameTop();

		AssertTextEquals(
			locator1 = "PGDDLDisplayAddlist#DATA_DEFINITION_NAME",
			value1 = "${dataDefinitionName}"
		);

		AssertClick.assertValueClickAtClickAt(
			locator1 = "PGDDLDisplayAddlist#SAVE_BUTTON",
			value1 = "Save"
		);
	}

	macro deleteCP {
		Type(locator1 = "CPDynamicdatalists#BASIC_SEARCH_FIELD", value1 = "${listName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalists#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalists#LIST_TABLE_NAME_1",
			value1 = "${listName}"
		);

		AssertClick(
			locator1 = "CPDynamicdatalists#LIST_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClickNoError(
			locator1 = "CPDynamicdatalists#LIST_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextEquals(
			locator1 = "CPDynamicdatalists#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextNotPresent(value1 = "${listName}");
	}

	macro deletePG {
		Click.clickAt(locator1 = "PGDDLDisplay#TOOLBAR_SELECT_LIST");

		SelectFrame(locator1 = "PGDDLDisplayConfiguration#CONFIGURATION_IFRAME");

		Type(
			locator1 = "PGDDLDisplayConfiguration#BASIC_SEARCH_FIELD",
			value1 = "${listName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGDDLDisplayConfiguration#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "PGDDLDisplayConfiguration#LIST_TABLE_NAME_1",
			value1 = "${listName}"
		);

		AssertClick(
			locator1 = "PGDDLDisplayConfiguration#LIST_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClickNoError(
			locator1 = "PGDDLDisplayConfiguration#LIST_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextNotPresent(value1 = "${listNameEdit}");

		SelectFrameTop();
	}

	macro editCP {
		Type(locator1 = "CPDynamicdatalists#BASIC_SEARCH_FIELD", value1 = "${listName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalists#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalists#LIST_TABLE_NAME_1",
			value1 = "${listName}"
		);

		AssertClick(
			locator1 = "CPDynamicdatalists#LIST_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPDynamicdatalists#LIST_MENULIST_EDIT",
			value1 = "Edit"
		);

		Type.clickAtSendKeys(
			locator1 = "CPDynamicdatalistsEditlist#NAME_FIELD",
			value1 = "${listNameEdit}"
		);

		Type.clickAtSendKeys(
			locator1 = "CPDynamicdatalistsEditlist#DESCRIPTION_FIELD",
			value1 = "${listDescriptionEdit}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalistsEditlist#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalists#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro editPG {
		Click.clickAt(locator1 = "PGDDLDisplay#TOOLBAR_SELECT_LIST");

		SelectFrame(locator1 = "PGDDLDisplayConfiguration#CONFIGURATION_IFRAME");

		Type(
			locator1 = "PGDDLDisplayConfiguration#BASIC_SEARCH_FIELD",
			value1 = "${listName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGDDLDisplayConfiguration#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "PGDDLDisplayConfiguration#LIST_TABLE_NAME_1",
			value1 = "${listName}"
		);

		AssertClick(
			locator1 = "PGDDLDisplayConfiguration#LIST_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClick.assertTextClickAt(
			locator1 = "PGDDLDisplayConfiguration#LIST_MENULIST_EDIT",
			value1 = "Edit"
		);

		Type(
			locator1 = "PGDDLDisplayConfigurationEditlist#NAME_FIELD",
			value1 = "${listNameEdit}"
		);

		Type(
			locator1 = "PGDDLDisplayConfigurationEditlist#DESCRIPTION_FIELD",
			value1 = "${listDescriptionEdit}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGDDLDisplayConfigurationEditlist#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "PGDDLDisplayConfiguration#INFO_MESSAGE",
			value1 = "Displaying List: ${listNameEdit}"
		);

		AssertTextEquals(
			locator1 = "PGDDLDisplayConfiguration#LIST_TABLE_NAME_1",
			value1 = "${listNameEdit}"
		);

		AssertTextEquals(
			locator1 = "PGDDLDisplayConfiguration#LIST_TABLE_DESCRIPTION_1",
			value1 = "${listDescriptionEdit}"
		);

		SelectFrameTop();
	}

	macro selectPG {
		Click.clickAt(locator1 = "PGDDLDisplay#TOOLBAR_SELECT_LIST");

		SelectFrame(locator1 = "PGDDLDisplayConfiguration#CONFIGURATION_IFRAME");

		Type(
			locator1 = "PGDDLDisplayConfiguration#BASIC_SEARCH_FIELD",
			value1 = "${listName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGDDLDisplayConfiguration#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertClick(
			locator1 = "PGDDLDisplayConfiguration#LIST_TABLE_NAME_1",
			value1 = "${listName}"
		);

		AssertTextEquals(
			locator1 = "PGDDLDisplayConfiguration#INFO_MESSAGE",
			value1 = "Displaying List: ${listName} (Modified)"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGDDLDisplayConfiguration#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals.assertText(
			locator1 = "PGDDLDisplayConfiguration#SUCCESS_MESSAGE",
			value1 = "You have successfully updated the setup."
		);

		SelectFrameTop();
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Dynamic Data Lists");

		while (IsElementPresent(locator1 = "CPDynamicdatalists#LIST_TABLE_ACTIONS_1")) {
			AssertClick(
				locator1 = "CPDynamicdatalists#LIST_TABLE_ACTIONS_1",
				value1 = "Actions"
			);

			AssertClickNoError(
				locator1 = "CPDynamicdatalists#LIST_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete this?");

			AssertTextEquals(
				locator1 = "CPDynamicdatalists#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}
	}

	macro viewCP {
		Type(locator1 = "CPDynamicdatalists#BASIC_SEARCH_FIELD", value1 = "${listName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalists#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalists#LIST_TABLE_NAME_1",
			value1 = "${listName}"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalists#LIST_TABLE_DESCRIPTION_1",
			value1 = "${listDescription}"
		);

		AssertClick(
			locator1 = "CPDynamicdatalists#LIST_TABLE_NAME_1",
			value1 = "${listName}"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsList#HEADER_TITLE",
			value1 = "${listName}"
		);

		AssertElementPresent(locator1 = "CPDynamicdatalistsList#ADD_RECORD_BUTTON");
	}

	macro viewPG {
		AssertTextEquals(locator1 = "PGDDLDisplay#HEADER_TITLE", value1 = "${listName}");
	}
}