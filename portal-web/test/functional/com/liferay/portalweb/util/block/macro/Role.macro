<definition>
	<command name="addCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Roles" />
		</execute>

		<execute function="AssertClick#pauseAssertTextClickAt" locator1="CPRoles#ADD" value1="Add" />

		<if>
			<equals arg1="${roleType}" arg2="Organization" />
			<then>
				<execute function="#assertClick" locator1="CPRoles#ADD_MENULIST_ORGANIZATION_ROLE" value1="Organization Role" />
			</then>
			<elseif>
				<equals arg1="${roleType}" arg2="Site" />
				<then>
					<execute function="#assertClick" locator1="CPRoles#ADD_MENULIST_SITE_ROLE" value1="Site Role" />
				</then>
			</elseif>
			<else>
				<execute function="#assertClick" locator1="CPRoles#ADD_MENULIST_REGULAR_ROLE" value1="Regular Role" />
			</else>
		</if>

		<execute function="#type" locator1="CPRolesAddrole#NAME_FIELD" value1="${roleName}" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="CPRolesAddrole#SAVE_BUTTON" value1="Save" />

		<execute function="#assertTextEquals" locator1="CPRoles#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="assignRegRoleCP">
		<execute function="#type" locator1="CPRoles#SEARCH_FIELD" value1="${roleName}" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="CPRoles#SEARCH_BUTTON" value1="Search" />
		<execute function="#assertClick" locator1="CPRoles#ROLE_TABLE_ACTIONS" value1="Actions" />
		<execute function="#assertClick" locator1="CPRoles#ROLE_MENULIST_ASSIGN_MEMBERS" value1="Assign Members" />

		<execute function="AssertClick#assertTextClickAtAndWait" locator1="CPRolesAssignmembersUsers#STATUS_AVAILABLE" value1="Available" />
		<execute function="#type" locator1="CPRolesAssignmembersUsers#BASIC_SEARCH_FIELD" value1="${userScreenName}" />
		<execute function="AssertClick#assertValueClickAtPause" locator1="CPRolesAssignmembersUsers#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="#assertTextEquals" locator1="CPRolesAssignmembersUsers#SEARCH_RESULTS" value1="Showing 1 result." />
		<execute function="#assertTextEquals" locator1="CPRolesAssignmembersUsers#USER_TABLE_SCREEN_NAME_1" value1="${userScreenName}" />
		<execute function="#check" locator1="CPRolesAssignmembersUsers#USER_TABLE_CHECKBOX_1" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="CPRolesAssignmembersUsers#UPDATE_ASSOCIATIONS_BUTTON" value1="Update Associations" />
		<execute function="#assertTextEquals" locator1="CPRolesAssignmembersUsers#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="#assertChecked" locator1="CPRolesAssignmembersUsers#USER_TABLE_CHECKBOX_1" />
	</command>

	<command name="definePermissionBlogsEntryCP">
		<if>
			<equals arg1="${roleType}" arg2="Organization" />
			<then>
				<execute function="#type" locator1="CPRoles#SEARCH_FIELD" value1="Orgrole" />

				<var name="roleTypeKey" value="ORG" />
			</then>
			<elseif>
				<equals arg1="${roleType}" arg2="Site" />
				<then>
					<execute function="#type" locator1="CPRoles#SEARCH_FIELD" value1="Siterole" />

					<var name="roleTypeKey" value="SITE" />
				</then>
			</elseif>
			<else>
				<execute function="#type" locator1="CPRoles#SEARCH_FIELD" value1="Regrole" />

				<var name="roleTypeKey" value="REG" />
			</else>
		</if>

		<execute function="AssertClick#assertValueClickAtAndWait" locator1="CPRoles#SEARCH_BUTTON" value1="Search" />
		<execute function="#assertTextEquals" locator1="CPRoles#ROLE_TABLE_TITLE_1" value1="${roleName}" />
		<execute function="#assertClick" locator1="CPRoles#ROLE_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="#assertClick" locator1="CPRoles#ROLE_MENULIST_DEFINE_PERMISSIONS" value1="Define Permissions" />

		<execute function="#select" locator1="CPRolesDefinepermissions#ADD_PERMISSIONS_SELECT" value1="Blogs" />

		<if>
			<equals arg1="${rolePermission}" arg2="Add Entry" />
			<then>
				<var name="permissionResource" value="Blogs" />

				<execute function="#check" locator1="CPRolesPermissionsSitecontentBlogs#BLOGS_TABLE_ADD_ENTRY_CHECKBOX" />
				<execute function="AssertClick#assertValueClickAtAndWait" locator1="CPRolesPermissionsSitecontentBlogs#SAVE_BUTTON" value1="Save" />
			</then>
			<elseif>
				<equals arg1="${rolePermission}" arg2="Delete" />
				<then>
					<var name="permissionResource" value="Blogs Entry" />

					<execute function="#check" locator1="CPRolesPermissionsSitecontentBlogs#BLOGS_ENTRY_TABLE_DELETE_CHECKBOX" />
					<execute function="AssertClick#assertValueClickAtAndWait" locator1="CPRolesPermissionsSitecontentBlogs#SAVE_BUTTON" value1="Save" />
				</then>
			</elseif>
			<else>
				<fail message="Invalid var rolePermission." />
			</else>
		</if>

		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#SUCCESS_MESSAGE" value1="The role permissions were updated." />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_RESOURCE_SET_1" value1="Blogs" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_RESOURCE_1" value1="${permissionResource}" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_ACTION_1" value1="${rolePermission}" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_DELETE_1" value1="Delete" />
	</command>

	<command name="definePermissionSiteMembersBlogsCP">
		<execute function="#type" locator1="CPRoles#SEARCH_FIELD" value1="${roleName}" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="CPRoles#SEARCH_BUTTON" value1="Search" />
		<execute function="#assertTextEquals" locator1="CPRoles#ROLE_TABLE_TITLE" value1="${roleName}" />
		<execute function="#assertClick" locator1="CPRoles#ROLE_TABLE_ACTIONS" value1="Actions" />
		<execute function="#assertClick" locator1="CPRoles#ROLE_MENULIST_DEFINE_PERMISSIONS" value1="Define Permissions" />

		<execute function="#select" locator1="CPRolesDefinepermissions#ADD_PERMISSIONS_SELECT" value1="${permissions}" />

		<execute function="#check" locator1="CPRolesPermissionsSitecontentBlogs#BLOGS_TABLE_ALL_CHECKBOX" />
		<execute function="#check" locator1="CPRolesPermissionsSitecontentBlogs#BLOGS_ENTRY_TABLE_ALL_CHECKBOX" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="CPRolesPermissionsSitecontentBlogs#SAVE_BUTTON" value1="Save" />

		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#SUCCESS_MESSAGE" value1="The role permissions were updated." />

		<var name="key_row" value="1" />

		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_SET_INCREMENT" value1="Blogs" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_INCREMENT" value1="Blogs" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_ACTION_INCREMENT" value1="Add Entry" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_DELETE_INCREMENT" value1="Delete" />

		<var name="key_row" value="2" />

		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_SET_INCREMENT" value1="Blogs" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_INCREMENT" value1="Blogs" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_ACTION_INCREMENT" value1="Permissions" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_DELETE_INCREMENT" value1="Delete" />

		<var name="key_row" value="3" />

		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_SET_INCREMENT" value1="Blogs" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_INCREMENT" value1="Blogs" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_ACTION_INCREMENT" value1="Subscribe" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_DELETE_INCREMENT" value1="Delete" />

		<var name="key_row" value="4" />

		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_SET_INCREMENT" value1="Blogs" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_INCREMENT" value1="Blogs Entry" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_ACTION_INCREMENT" value1="Add Discussion" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_DELETE_INCREMENT" value1="Delete" />

		<var name="key_row" value="5" />

		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_SET_INCREMENT" value1="Blogs" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_INCREMENT" value1="Blogs Entry" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_ACTION_INCREMENT" value1="Delete" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_DELETE_INCREMENT" value1="Delete" />

		<var name="key_row" value="6" />

		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_SET_INCREMENT" value1="Blogs" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_INCREMENT" value1="Blogs Entry" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_ACTION_INCREMENT" value1="Delete Discussion" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_DELETE_INCREMENT" value1="Delete" />

		<var name="key_row" value="7" />

		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_SET_INCREMENT" value1="Blogs" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_INCREMENT" value1="Blogs Entry" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_ACTION_INCREMENT" value1="Permissions" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_DELETE_INCREMENT" value1="Delete" />

		<var name="key_row" value="8" />

		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_SET_INCREMENT" value1="Blogs" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_INCREMENT" value1="Blogs Entry" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_ACTION_INCREMENT" value1="Update" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_DELETE_INCREMENT" value1="Delete" />

		<var name="key_row" value="9" />

		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_SET_INCREMENT" value1="Blogs" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_INCREMENT" value1="Blogs Entry" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_ACTION_INCREMENT" value1="Update Discussion" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_DELETE_INCREMENT" value1="Delete" />

		<var name="key_row" value="10" />

		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_SET_INCREMENT" value1="Blogs" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_RESOURCE_INCREMENT" value1="Blogs Entry" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_ACTION_INCREMENT" value1="View" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_DELETE_INCREMENT" value1="Delete" />
	</command>

	<command name="removePermissionBlogsEntryCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Roles" />
		</execute>

		<if>
			<equals arg1="${rolePermission}" arg2="Add Entry" />
			<then>
				<var name="permissionResource" value="Blogs" />
			</then>
			<elseif>
				<equals arg1="${rolePermission}" arg2="Delete" />
				<then>
					<var name="permissionResource" value="Blogs Entry" />
				</then>
			</elseif>
			<else>
				<fail message="Invalid var rolePermission." />
			</else>
		</if>

		<if>
			<equals arg1="${roleType}" arg2="Organization" />
			<then>
				<execute function="#type" locator1="CPRoles#SEARCH_FIELD" value1="Orgrole" />

				<var name="roleTypeKey" value="ORG" />
			</then>
			<elseif>
				<equals arg1="${roleType}" arg2="Site" />
				<then>
					<execute function="#type" locator1="CPRoles#SEARCH_FIELD" value1="Siterole" />

					<var name="roleTypeKey" value="SITE" />
				</then>
			</elseif>
			<else>
				<execute function="#type" locator1="CPRoles#SEARCH_FIELD" value1="Regrole" />

				<var name="roleTypeKey" value="REG" />
			</else>
		</if>

		<execute function="AssertClick#assertValueClickAtAndWait" locator1="CPRoles#SEARCH_BUTTON" value1="Search" />
		<execute function="#assertTextEquals" locator1="CPRoles#ROLE_TABLE_TITLE_1" value1="${roleName}" />
		<execute function="#assertClick" locator1="CPRoles#ROLE_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="#assertClick" locator1="CPRoles#ROLE_MENULIST_DEFINE_PERMISSIONS" value1="Define Permissions" />

		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_RESOURCE_SET_1" value1="Blogs" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_RESOURCE_1" value1="${permissionResource}" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_ACTION_1" value1="${rolePermission}" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_DELETE_1" value1="Delete" />
		<execute function="#assertClick" locator1="CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_DELETE_1" value1="Delete" />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#SUCCESS_MESSAGE" value1="The permission was deleted." />
		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#INFO_MESSAGE" value1="This role does not have any permissions." />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Roles" />
		</execute>

		<execute function="#type" locator1="CPRoles#SEARCH_FIELD" value1="Name" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="CPRoles#SEARCH_BUTTON" value1="Search" />

		<while>
			<condition function="#isElementPresent" locator1="CPRoles#ROLE_TABLE_ACTIONS_1" />
			<then>
				<execute function="#assertClick" locator1="CPRoles#ROLE_TABLE_ACTIONS_1" value1="Actions" />
				<execute function="#assertClickNoError" locator1="CPRoles#ROLE_MENULIST_DELETE" value1="Delete" />
				<execute function="#confirm" locator1="CPRoles#CONFIRMATION" value1="Are you sure you want to delete this?" />
			</then>
		</while>
	</command>

	<command name="tearDownDefinePermissionCP">
		<execute macro="SOUser#firstLoginPG" />

		<execute macro="SOUserBar#gotoCP">
			<var name="portletName" value="Roles" />
		</execute>

		<execute function="#type" locator1="CPRoles#SEARCH_FIELD" value1="${roleName}" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="CPRoles#SEARCH_BUTTON" value1="Search" />
		<execute function="#assertTextEquals" locator1="CPRoles#ROLE_TABLE_TITLE" value1="${roleName}" />
		<execute function="#assertClick" locator1="CPRoles#ROLE_TABLE_ACTIONS" value1="Actions" />
		<execute function="#assertClick" locator1="CPRoles#ROLE_MENULIST_DEFINE_PERMISSIONS" value1="Define Permissions" />

		<var name="key_row" value="1" />

		<while>
			<condition function="#isElementPresent" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_DELETE_INCREMENT" />
			<then>
				<execute function="#assertClick" locator1="CPRolesDefinepermissions#PERMISSION_TABLE_DELETE_INCREMENT" value1="Delete" />
				<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#SUCCESS_MESSAGE" value1="The permission was deleted." />
			</then>
		</while>

		<execute function="#assertTextEquals" locator1="CPRolesDefinepermissions#INFO_MESSAGE" value1="This role does not have any permissions." />
	</command>

	<command name="unassignRegRoleCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Roles" />
		</execute>

		<execute function="#type" locator1="CPRoles#SEARCH_FIELD" value1="${roleName}" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="CPRoles#SEARCH_BUTTON" value1="Search" />
		<execute function="#assertClick" locator1="CPRoles#ROLE_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="#assertClick" locator1="CPRoles#ROLE_MENULIST_ASSIGN_MEMBERS" value1="Assign Members" />

		<execute function="AssertClick#assertTextClickAtAndWait" locator1="CPRolesAssignmembersUsers#STATUS_CURRENT" value1="Current" />
		<execute function="#type" locator1="CPRolesAssignmembersUsers#BASIC_SEARCH_FIELD" value1="${userScreenName}" />
		<execute function="AssertClick#assertValueClickAtPause" locator1="CPRolesAssignmembersUsers#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="#assertTextEquals" locator1="CPRolesAssignmembersUsers#SEARCH_RESULTS" value1="Showing 1 result." />
		<execute function="#assertTextEquals" locator1="CPRolesAssignmembersUsers#USER_TABLE_SCREEN_NAME_1" value1="${userScreenName}" />
		<execute function="#uncheck" locator1="CPRolesAssignmembersUsers#USER_TABLE_CHECKBOX_1" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="CPRolesAssignmembersUsers#UPDATE_ASSOCIATIONS_BUTTON" value1="Update Associations" />
		<execute function="#assertTextEquals" locator1="CPRolesAssignmembersUsers#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="viewCP">
		<if>
			<equals arg1="${roleType}" arg2="Organization" />
			<then>
				<execute function="#type" locator1="CPRoles#SEARCH_FIELD" value1="Orgrole" />
			</then>
			<elseif>
				<equals arg1="${roleType}" arg2="Site" />
				<then>
					<execute function="#type" locator1="CPRoles#SEARCH_FIELD" value1="Siterole" />
				</then>
			</elseif>
			<else>
				<execute function="#type" locator1="CPRoles#SEARCH_FIELD" value1="Regrole" />

				<var name="roleType" value="Regular" />
			</else>
		</if>

		<execute function="AssertClick#assertValueClickAtAndWait" locator1="CPRoles#SEARCH_BUTTON" value1="Search" />
		<execute function="#assertTextEquals" locator1="CPRoles#ROLE_TABLE_TITLE_1" value1="${roleName}" />
		<execute function="#assertTextEquals" locator1="CPRoles#ROLE_TABLE_TYPE_1" value1="${roleType}" />
		<execute function="#assertClick" locator1="CPRoles#ROLE_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="#assertClick" locator1="CPRoles#ROLE_MENULIST_EDIT" value1="Edit" />

		<execute function="#assertTextEquals" locator1="CPRolesEdit#HEADER" value1="${roleName}" />
		<execute function="#assertTextEquals" locator1="CPRolesEdit#NAME_FIELD" value1="${roleName}" />
	</command>
</definition>