definition {
	macro addCP {
		Page.gotoCP(portletName = "Roles");

		AssertClick.pauseAssertTextClickAt(locator1 = "CPRoles#ADD", value1 = "Add");

		if ("${roleType}" == "Organization") {
			AssertClick.assertTextClickAt(
				locator1 = "CPRoles#ADD_MENULIST_ORGANIZATION_ROLE",
				value1 = "Organization Role"
			);
		}
		else if ("${roleType}" == "Site") {
			AssertClick.assertTextClickAt(
				locator1 = "CPRoles#ADD_MENULIST_SITE_ROLE",
				value1 = "Site Role"
			);
		}
		else {
			AssertClick.assertTextClickAt(
				locator1 = "CPRoles#ADD_MENULIST_REGULAR_ROLE",
				value1 = "Regular Role"
			);
		}

		Type(locator1 = "CPRolesAddrole#NAME_FIELD", value1 = "${roleName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPRolesAddrole#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPRoles#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro assignRegRoleCP {
		Type(locator1 = "CPRoles#SEARCH_FIELD", value1 = "${roleName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPRoles#SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertClick(locator1 = "CPRoles#ROLE_TABLE_ACTIONS", value1 = "Actions");

		AssertClick(
			locator1 = "CPRoles#ROLE_MENULIST_ASSIGN_MEMBERS",
			value1 = "Assign Members"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPRolesAssignmembersUsers#STATUS_AVAILABLE",
			value1 = "Available"
		);

		Type(
			locator1 = "CPRolesAssignmembersUsers#BASIC_SEARCH_FIELD",
			value1 = "${userScreenName}"
		);

		AssertClick.assertValueClickAtPause(
			locator1 = "CPRolesAssignmembersUsers#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPRolesAssignmembersUsers#SEARCH_RESULTS",
			value1 = "Showing 1 result."
		);

		AssertTextEquals(
			locator1 = "CPRolesAssignmembersUsers#USER_TABLE_SCREEN_NAME_1",
			value1 = "${userScreenName}"
		);

		Check(locator1 = "CPRolesAssignmembersUsers#USER_TABLE_CHECKBOX_1");

		AssertClick.assertValueClickAt(
			locator1 = "CPRolesAssignmembersUsers#UPDATE_ASSOCIATIONS_BUTTON",
			value1 = "Update Associations"
		);

		AssertTextEquals(
			locator1 = "CPRolesAssignmembersUsers#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertChecked(locator1 = "CPRolesAssignmembersUsers#USER_TABLE_CHECKBOX_1");
	}

	macro definePermissionBlogsEntryCP {
		if ("${roleType}" == "Organization") {
			Type(locator1 = "CPRoles#SEARCH_FIELD", value1 = "Orgrole");

			var roleTypeKey = "ORG";
		}
		else if ("${roleType}" == "Site") {
			Type(locator1 = "CPRoles#SEARCH_FIELD", value1 = "Siterole");

			var roleTypeKey = "SITE";
		}
		else {
			Type(locator1 = "CPRoles#SEARCH_FIELD", value1 = "Regrole");

			var roleTypeKey = "REG";
		}

		AssertClick.assertValueClickAt(
			locator1 = "CPRoles#SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPRoles#ROLE_TABLE_TITLE_1",
			value1 = "${roleName}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "CPRoles#ROLE_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClick(
			locator1 = "CPRoles#ROLE_MENULIST_DEFINE_PERMISSIONS",
			value1 = "Define Permissions"
		);

		Select(
			locator1 = "CPRolesDefinepermissions#ADD_PERMISSIONS_SELECT",
			value1 = "Blogs"
		);

		if ("${rolePermission}" == "Add Entry") {
			var permissionResource = "Blogs";

			Check(
				locator1 = "CPRolesPermissionsSitecontentBlogs#BLOGS_TABLE_ADD_ENTRY_CHECKBOX"
			);

			AssertClick.assertValueClickAt(
				locator1 = "CPRolesPermissionsSitecontentBlogs#SAVE_BUTTON",
				value1 = "Save"
			);
		}
		else if ("${rolePermission}" == "Delete") {
			var permissionResource = "Blogs Entry";

			Check(
				locator1 = "CPRolesPermissionsSitecontentBlogs#BLOGS_ENTRY_TABLE_DELETE_CHECKBOX"
			);

			AssertClick.assertValueClickAt(
				locator1 = "CPRolesPermissionsSitecontentBlogs#SAVE_BUTTON",
				value1 = "Save"
			);
		}
		else {
			fail("Invalid var rolePermission.");
		}

		AssertTextEquals(
			locator1 = "CPRolesDefinepermissions#SUCCESS_MESSAGE",
			value1 = "The role permissions were updated."
		);

		AssertTextEquals(
			locator1 = "CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_RESOURCE_SET_1",
			value1 = "Blogs"
		);

		AssertTextEquals(
			locator1 = "CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_RESOURCE_1",
			value1 = "${permissionResource}"
		);

		AssertTextEquals(
			locator1 = "CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_ACTION_1",
			value1 = "${rolePermission}"
		);

		AssertTextEquals(
			locator1 = "CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_DELETE_1",
			value1 = "Delete"
		);
	}

