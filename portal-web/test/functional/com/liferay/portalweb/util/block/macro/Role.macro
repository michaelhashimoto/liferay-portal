	macro removePermissionBlogsEntryCP {
		Page.gotoCP(portletName = "Roles");

		if ("${rolePermission}" == "Add Entry") {
			var permissionResource = "Blogs";
		}
		else if ("${rolePermission}" == "Delete") {
			var permissionResource = "Blogs Entry";
		}
		else {
			fail("Invalid var rolePermission.");
		}

		if ("${roleType}" == "Organization") {
			Type(locator1 = "CPRoles#SEARCH_FIELD", value1 = "Orgrole");

			var roleTypeKey = "ORG";
		}
		else if ("${roleType}" == "Site") {
			Type(locator1 = "CPRoles#SEARCH_FIELD", value1 = "Siterole");

			var roleTypeKey = "SITE";
		}
		else {
			Type(locator1 = "CPRoles#SEARCH_FIELD", value1 = "Regrole");

			var roleTypeKey = "REG";
		}

		AssertClick.assertValueClickAt(
			locator1 = "CPRoles#SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPRoles#ROLE_TABLE_TITLE_1",
			value1 = "${roleName}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "CPRoles#ROLE_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClick(
			locator1 = "CPRoles#ROLE_MENULIST_DEFINE_PERMISSIONS",
			value1 = "Define Permissions"
		);

		AssertTextEquals(
			locator1 = "CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_RESOURCE_SET_1",
			value1 = "Blogs"
		);

		AssertTextEquals(
			locator1 = "CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_RESOURCE_1",
			value1 = "${permissionResource}"
		);

		AssertTextEquals(
			locator1 = "CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_ACTION_1",
			value1 = "${rolePermission}"
		);

		AssertTextEquals(
			locator1 = "CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_DELETE_1",
			value1 = "Delete"
		);

		AssertClick(
			locator1 = "CPRolesDefinepermissions#${roleTypeKey}_PERMISSION_TABLE_DELETE_1",
			value1 = "Delete"
		);

		AssertTextEquals(
			locator1 = "CPRolesDefinepermissions#SUCCESS_MESSAGE",
			value1 = "The permission was deleted."
		);

		AssertTextEquals(
			locator1 = "CPRolesDefinepermissions#INFO_MESSAGE",
			value1 = "This role does not have any permissions."
		);
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Roles");

		Type(locator1 = "CPRoles#SEARCH_FIELD", value1 = "Name");

		AssertClick.assertValueClickAt(
			locator1 = "CPRoles#SEARCH_BUTTON",
			value1 = "Search"
		);

		while (IsElementPresent.pauseIsElementPresent(locator1 = "CPRoles#ROLE_TABLE_ACTIONS_1")) {
			AssertClick.pauseAssertTextClickAt(
				locator1 = "CPRoles#ROLE_TABLE_ACTIONS_1",
				value1 = "Actions"
			);

			AssertClickNoError(locator1 = "CPRoles#ROLE_MENULIST_DELETE", value1 = "Delete");

			Confirm(value1 = "Are you sure you want to delete this?");
		}
	}

	macro tearDownDefinePermissionCP {
		SOUser.firstLoginPG();

		SOUserBar.gotoCP(portletName = "Roles");

		Type(locator1 = "CPRoles#SEARCH_FIELD", value1 = "${roleName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPRoles#SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(locator1 = "CPRoles#ROLE_TABLE_TITLE", value1 = "${roleName}");

		AssertClick(locator1 = "CPRoles#ROLE_TABLE_ACTIONS", value1 = "Actions");

		AssertClick(
			locator1 = "CPRoles#ROLE_MENULIST_DEFINE_PERMISSIONS",
			value1 = "Define Permissions"
		);

		var key_row = "1";

		while (IsElementPresent(locator1 = "CPRolesDefinepermissions#PERMISSION_TABLE_DELETE_INCREMENT")) {
			AssertClick(
				locator1 = "CPRolesDefinepermissions#PERMISSION_TABLE_DELETE_INCREMENT",
				value1 = "Delete"
			);

			AssertTextEquals(
				locator1 = "CPRolesDefinepermissions#SUCCESS_MESSAGE",
				value1 = "The permission was deleted."
			);
		}

		AssertTextEquals(
			locator1 = "CPRolesDefinepermissions#INFO_MESSAGE",
			value1 = "This role does not have any permissions."
		);
	}

	macro unassignRegRoleCP {
		Page.gotoCP(portletName = "Roles");

		Type(locator1 = "CPRoles#SEARCH_FIELD", value1 = "${roleName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPRoles#SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "CPRoles#ROLE_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClick(
			locator1 = "CPRoles#ROLE_MENULIST_ASSIGN_MEMBERS",
			value1 = "Assign Members"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPRolesAssignmembersUsers#STATUS_CURRENT",
			value1 = "Current"
		);

		Type(
			locator1 = "CPRolesAssignmembersUsers#BASIC_SEARCH_FIELD",
			value1 = "${userScreenName}"
		);

		AssertClick.assertValueClickAtPause(
			locator1 = "CPRolesAssignmembersUsers#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPRolesAssignmembersUsers#SEARCH_RESULTS",
			value1 = "Showing 1 result."
		);

		AssertTextEquals(
			locator1 = "CPRolesAssignmembersUsers#USER_TABLE_SCREEN_NAME_1",
			value1 = "${userScreenName}"
		);

		Uncheck(locator1 = "CPRolesAssignmembersUsers#USER_TABLE_CHECKBOX_1");

		AssertClick.assertValueClickAt(
			locator1 = "CPRolesAssignmembersUsers#UPDATE_ASSOCIATIONS_BUTTON",
			value1 = "Update Associations"
		);

		AssertTextEquals(
			locator1 = "CPRolesAssignmembersUsers#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro viewCP {
		if ("${roleType}" == "Organization") {
			Type(locator1 = "CPRoles#SEARCH_FIELD", value1 = "Orgrole");
		}
		else if ("${roleType}" == "Site") {
			Type(locator1 = "CPRoles#SEARCH_FIELD", value1 = "Siterole");
		}
		else {
			Type(locator1 = "CPRoles#SEARCH_FIELD", value1 = "Regrole");

			var roleType = "Regular";
		}

		AssertClick.assertValueClickAt(
			locator1 = "CPRoles#SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPRoles#ROLE_TABLE_TITLE_1",
			value1 = "${roleName}"
		);

		AssertTextEquals(locator1 = "CPRoles#ROLE_TABLE_TYPE_1", value1 = "${roleType}");

		AssertClick.pauseAssertTextClickAt(
			locator1 = "CPRoles#ROLE_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClick(locator1 = "CPRoles#ROLE_MENULIST_EDIT", value1 = "Edit");

		AssertTextEquals(locator1 = "CPRolesEdit#HEADER", value1 = "${roleName}");

		AssertTextEquals(locator1 = "CPRolesEdit#NAME_FIELD", value1 = "${roleName}");
	}
}