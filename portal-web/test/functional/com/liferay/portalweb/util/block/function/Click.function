@default = "clickAt"
@summary = "Click on '${locator1}'"
definition {
	function clickAt {
		selenium.waitForVisible();

		MouseOver.mouseOver();

		selenium.clickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function clickAtPause {
		selenium.waitForVisible();

		MouseOver.mouseOver();

		selenium.clickAt();

		selenium.pause("1000");

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function makeVisibleClickAt {
		selenium.makeVisible();

		MouseOver.mouseOver();

		selenium.clickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function partialTextClickAt {
		AssertTextEquals.assertPartialText();

		MouseOver.mouseOver();

		selenium.clickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function pauseClickAt {
		selenium.pause("1000");

		Click.clickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function pauseTextClickAt {
		selenium.pause("1000");

		Click.textClickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function sikuliClick {
		selenium.sikuliClick();

		selenium.pause("2000");

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function textClick {
		AssertTextEquals.assertText();

		MouseOver.mouseOver();

		selenium.click();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function textClickAt {
		AssertTextEquals.assertText();

		MouseOver.mouseOver();

		selenium.clickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function textClickAtClickDockbar {
		selenium.clickAt("//div[@id='dockbar']", "");

		selenium.waitForElementPresent(
			"//script[contains(@src,'/aui/aui-button-item/aui-button-item-min.js')]"
		);

		Click.textClickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function valueClickAt {
		AssertTextEquals.assertValue();

		MouseOver.mouseOver();

		selenium.clickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function valueClickAtPause {
		AssertTextEquals.assertValue();

		MouseOver.mouseOver();

		selenium.clickAt();

		selenium.pause("1000");

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}
}