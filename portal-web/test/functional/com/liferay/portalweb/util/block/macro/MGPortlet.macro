definition {
	macro configureShowAllPG {
		Page.gotoPG(pageName = "${pageName}");

		AssertElementPresent(locator1 = "PGMediagallery#OPTIONS");

		Click.pauseClickAt(locator1 = "PGMediagallery#OPTIONS");

		AssertClick(
			locator1 = "PGMediagallery#OPTIONS_MENULIST_CONFIGURATION",
			value1 = "Configuration"
		);

		SelectFrame(locator1 = "PGMediagalleryConfiguration#MG_CONFIGURATION_IFRAME");

		Check.clickAtConfiguration(
			locator1 = "PGMediagalleryConfiguration#MG_DISPLAY_SETTINGS_SHOW_ACTIONS_CHECKBOX"
		);

		Check.clickAtConfiguration(
			locator1 = "PGMediagalleryConfiguration#MG_DISPLAY_SETTINGS_SHOW_FOLDER_MENU_CHECKBOX"
		);

		Check.clickAtConfiguration(
			locator1 = "PGMediagalleryConfiguration#MG_DISPLAY_SETTINGS_SHOW_NAVIGATION_LINKS_CHECKBOX"
		);

		Check.clickAtConfiguration(
			locator1 = "PGMediagalleryConfiguration#MG_DISPLAY_SETTINGS_SHOW_SEARCH_CHECKBOX"
		);

		AssertClick(
			locator1 = "PGMediagalleryConfiguration#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "PGMediagalleryConfiguration#SUCCESS_MESSAGE",
			value1 = "You have successfully updated the setup."
		);
	}
}