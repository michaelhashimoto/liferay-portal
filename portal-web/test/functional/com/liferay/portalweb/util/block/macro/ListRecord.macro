<definition>
	<command name="addBooleanCmdCP">
		<if>
			<equals arg1="${recordBoolean}" arg2="false" />
			<then>
				<execute function="Uncheck" locator1="//input[contains(@id,'_167_${booleanNameLabel}')]" />
			</then>
			<elseif>
				<equals arg1="${recordBoolean}" arg2="true" />
				<then>
					<execute function="Check" locator1="//input[contains(@id,'_167_${booleanNameLabel}')]" />
				</then>
			</elseif>
			<else>
				<fail message="Invalid var recordBooleanValue. Must be (true|false)." />
			</else>
		</if>
	</command>

	<command name="addCP">
		<execute function="Type" locator1="CPDynamicdatalists#BASIC_SEARCH_FIELD" value1="${listName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPDynamicdatalists#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalists#LIST_TABLE_NAME_1" value1="${listName}" />
		<execute function="AssertClick" locator1="CPDynamicdatalists#LIST_TABLE_NAME_1" value1="${listName}" />

		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsList#HEADER_TITLE" value1="${listName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPDynamicdatalistsList#ADD_RECORD_BUTTON" value1="Add Record" />

		<execute macro="ListRecord#addTextCmdCP">
			<var name="textNameLabel" value="text" />
		</execute>

		<execute function="AssertClick#assertValueClickAt" locator1="CPDynamicdatalistsListAddrecord#PUBLISH_BUTTON" value1="Publish" />

		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsList#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="addDateCmdCP">
		<execute function="Select" locator1="//select[contains(@id,'_167_${dateNameLabel}') and @class='datepicker-month']" value1="${recordDateMonth}" />
		<execute function="Select" locator1="//select[contains(@id,'_167_${dateNameLabel}') and @class='datepicker-day']" value1="${recordDateDay}" />
		<execute function="Select" locator1="//select[contains(@id,'_167_${dateNameLabel}') and @class='datepicker-year']" value1="${recordDateYear}" />
	</command>

	<command name="addDecimalCmdCP">
		<execute function="Type" locator1="//input[contains(@id,'_167_${decimalNameLabel}')]" value1="${recordDecimal}" />
	</command>

	<command name="addDocumentsAndMediaCmdCP">
		<fail message="Add Documents and Media record not yet implentmented." />
	</command>

	<command name="addFileUploadCmdCP">
		<fail message="Add File Upload record not yet implemented." />
	</command>

	<command name="addIntegerCmdCP">
		<execute function="Type" locator1="//input[contains(@id,'_167_${integerNameLabel}')]" value1="${recordInteger}" />
	</command>

	<command name="addNumberCmdCP">
		<execute function="Type" locator1="//input[contains(@id,'_167_${numberNameLabel}')]" value1="${recordNumber}" />
	</command>

	<command name="addPG">
		<execute function="AssertClick#assertValueClickAt" locator1="PGDDLDisplay#ADD_RECORD_BUTTON" value1="Add Record" />

		<execute macro="ListRecord#addTextCmdPG">
			<var name="textNameLabel" value="text" />
		</execute>

		<execute function="AssertClick#assertValueClickAt" locator1="PGDDLDisplayAddrecord#PUBLISH_BUTTON" value1="Publish" />

		<execute function="AssertTextEquals#assertText" locator1="PGDDLDisplay#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="addRadioCmdCP">
		<if>
			<equals arg1="${recordRadio}" arg2="1" />
			<then>
				<execute function="AssertClick" locator1="xpath=(//input[contains(@name,'_167_${radioNameLabel}')])[1]" value1="${radioNameLabel}" />
			</then>
			<elseif>
				<equals arg1="${recordRadio}" arg2="2" />
				<then>
					<execute function="AssertClick" locator1="xpath=(//input[contains(@name,'_167_${radioNameLabel}')])[2]" value1="${radioNameLabel}" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${recordRadio}" arg2="3" />
				<then>
					<execute function="AssertClick" locator1="xpath=(//input[contains(@name,'_167_${radioNameLabel}')])[3]" value1="${radioNameLabel}" />
				</then>
			</elseif>
			<else>
				<fail message="Invalid var recordBooleanValue. Must be (1|2|3)." />
			</else>
		</if>
	</command>

	<command name="addSelectCmdCP">
		<execute function="Select" locator1="//select[contains(@name,'_167_${selectNameLabel}')" value1="${recordSelect}" />
	</command>

	<command name="addTextBoxCmdCP">
		<execute function="Type" locator1="//textarea[contains(@id,'_167_${textBoxNameLabel}')]" value1="${recordTextBox}" />
	</command>

	<command name="addTextCmdCP">
		<execute function="Type" locator1="//input[contains(@id,'_167_${textNameLabel}')]" value1="${recordText}" />
	</command>

	<command name="addTextCmdPG">
		<execute function="Type" locator1="//input[contains(@id,'_${textNameLabel}')]" value1="${recordText}" />
	</command>

	<command name="deleteCP">
		<execute function="Type" locator1="CPDynamicdatalists#BASIC_SEARCH_FIELD" value1="${listName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPDynamicdatalists#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalists#LIST_TABLE_NAME_1" value1="${listName}" />
		<execute function="AssertClick" locator1="CPDynamicdatalists#LIST_TABLE_NAME_1" value1="${listName}" />

		<execute function="AssertClick" locator1="CPDynamicdatalistsList#RECORD_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="AssertClickNoError" locator1="CPDynamicdatalistsList#RECORD_MENULIST_DELETE" value1="Delete" />
		<execute function="Confirm" value1="Are you sure you want to delete this?" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsList#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsList#INFO_MESSAGE" value1="No records were found." />
	</command>

	<command name="deletePG">
		<execute function="AssertClick" locator1="PGDDLDisplay#RECORD_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="AssertClickNoError" locator1="PGDDLDisplay#RECORD_MENULIST_DELETE" value1="Delete" />
		<execute function="Confirm" value1="Are you sure you want to delete this?" />
		<execute function="AssertTextEquals#assertText" locator1="PGDDLDisplay#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals#assertText" locator1="PGDDLDisplay#INFO_MESSAGE" value1="No records were found." />
	</command>

	<command name="editBooleanCmdCP">
		<execute macro="ListRecord#addBooleanCmdCP">
			<var name="recordBoolean" value="${recordBooleanEdit}" />
		</execute>
	</command>

	<command name="editCP">
		<execute function="Type" locator1="CPDynamicdatalists#BASIC_SEARCH_FIELD" value1="${listName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPDynamicdatalists#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalists#LIST_TABLE_NAME_1" value1="${listName}" />
		<execute function="AssertClick" locator1="CPDynamicdatalists#LIST_TABLE_NAME_1" value1="${listName}" />

		<execute function="AssertClick" locator1="CPDynamicdatalistsList#RECORD_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsList#RECORD_MENULIST_EDIT" value1="Edit" />

		<execute macro="ListRecord#editTextCmdCP">
			<var name="textNameLabel" value="text" />
		</execute>

		<execute function="AssertClick#assertValueClickAt" locator1="CPDynamicdatalistsListEditrecord#PUBLISH_BUTTON" value1="Publish" />

		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsList#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="editDateCmdCP">
		<execute macro="ListRecord#addDateCmdCP">
			<var name="recordDateDay" value="${recordDateDayEdit}" />
			<var name="recordDateMonth" value="${recordDateMonthEdit}" />
			<var name="recordDateYear" value="${recordDateYearEdit}" />
		</execute>
	</command>

	<command name="editDecimalCmdCP">
		<execute macro="ListRecord#addDecimalCmdCP">
			<var name="recordDecimal" value="${recordDecimalEdit}" />
		</execute>
	</command>

	<command name="editDocumentsAndMediaCmdCP">
		<execute macro="ListRecord#addDocumentsAndMediaCmdCP">
			<var name="recordDocument" value="${recordDocumentEdit}" />
		</execute>
	</command>

	<command name="editFileUploadCmdCP">
		<execute macro="ListRecord#addFileUploadCmdCP">
			<var name="recordFileUpload" value="${recordFileUploadEdit}" />
		</execute>
	</command>

	<command name="editIntegerCmdCP">
		<execute macro="ListRecord#addIntegerCmdCP">
			<var name="recordInteger" value="${recordIntegerEdit}" />
		</execute>
	</command>

	<command name="editNumberCmdCP">
		<execute macro="ListRecord#addNumberCmdCP">
			<var name="recordNumber" value="${recordNumberEdit}" />
		</execute>
	</command>

	<command name="editPG">
		<execute function="AssertClick" locator1="PGDDLDisplay#RECORD_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="AssertClick#assertTextClickAt" locator1="PGDDLDisplay#RECORD_MENULIST_EDIT" value1="Edit" />

		<execute macro="ListRecord#editTextCmdPG">
			<var name="textNameLabel" value="text" />
		</execute>

		<execute function="AssertClick#assertValueClickAt" locator1="PGDDLDisplayEditrecord#PUBLISH_BUTTON" value1="Publish" />

		<execute function="AssertTextEquals#assertText" locator1="PGDDLDisplay#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="editRadioCmdCP">
		<execute macro="ListRecord#addRadioCmdCP">
			<var name="recordRadio" value="${recordRadioEdit}" />
		</execute>
	</command>

	<command name="editSelectCmdCP">
		<execute macro="ListRecord#addSelectCmdCP">
			<var name="recordSelect" value="${recordSelectEdit}" />
		</execute>
	</command>

	<command name="editTextBoxCmdCP">
		<execute macro="ListRecord#addTextBoxCmdCP">
			<var name="recordTextBox" value="${recordTextBoxEdit}" />
		</execute>
	</command>

	<command name="editTextCmdCP">
		<execute macro="ListRecord#addTextCmdCP">
			<var name="recordText" value="${recordTextEdit}" />
		</execute>
	</command>

	<command name="editTextCmdPG">
		<execute macro="ListRecord#addTextCmdPG">
			<var name="recordText" value="${recordTextEdit}" />
		</execute>
	</command>

	<command name="spreadsheetViewCP">
		<execute function="Type" locator1="CPDynamicdatalists#BASIC_SEARCH_FIELD" value1="${listName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPDynamicdatalists#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalists#LIST_TABLE_NAME_1" value1="${listName}" />
		<execute function="AssertClick" locator1="CPDynamicdatalists#LIST_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalists#LIST_MENULIST_SPREADSHEET_VIEW" value1="Spreadsheet View" />

		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsListSpreadsheetview#HEADER_TITLE" value1="${listName}" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsListSpreadsheetview#RECORD_TABLE_COLUMN_ONE_NAME" value1="Text" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsListSpreadsheetview#RECORD_TABLE_COLUMN_ONE_RECORD_1" value1="${recordText}" />
	</command>

	<command name="viewCP">
		<execute function="Type" locator1="CPDynamicdatalists#BASIC_SEARCH_FIELD" value1="${listName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPDynamicdatalists#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalists#LIST_TABLE_NAME_1" value1="${listName}" />
		<execute function="AssertClick" locator1="CPDynamicdatalists#LIST_TABLE_NAME_1" value1="${listName}" />

		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsList#HEADER_TITLE" value1="${listName}" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsList#RECORD_TABLE_COLUMN_ONE_NAME" value1="Text" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsList#RECORD_TABLE_COLUMN_ONE_RECORD_1" value1="${recordText}" />
		<execute function="AssertClick" locator1="CPDynamicdatalistsList#RECORD_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsList#RECORD_MENULIST_VIEW" value1="View" />

		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsListRecord#FIELD_1" value1="Text ${recordText}" />
	</command>

	<command name="viewPG">
		<execute function="AssertTextEquals" locator1="PGDDLDisplay#HEADER_TITLE" value1="${listName}" />
		<execute function="AssertTextEquals" locator1="PGDDLDisplay#RECORD_TABLE_COLUMN_ONE_NAME" value1="Text" />
		<execute function="AssertTextEquals" locator1="PGDDLDisplay#RECORD_TABLE_COLUMN_ONE_RECORD_1" value1="${recordText}" />
		<execute function="AssertClick" locator1="PGDDLDisplay#RECORD_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="AssertClick" locator1="PGDDLDisplay#RECORD_MENULIST_VIEW" value1="View" />

		<execute function="AssertTextEquals" locator1="PGDDLDisplayRecord#FIELD_1" value1="Text ${recordText}" />
	</command>
</definition>