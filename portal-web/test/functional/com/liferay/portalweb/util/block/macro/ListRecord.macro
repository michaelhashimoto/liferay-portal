		AssertTextEquals(
			locator1 = "CPDynamicdatalistsListRecord#FIELD_1",
			value1 = "Text ${recordText}"
		);
	}

	macro viewPG {
		AssertTextEquals(locator1 = "PGDDLDisplay#HEADER_TITLE", value1 = "${listName}");

		AssertTextEquals(
			locator1 = "PGDDLDisplay#RECORD_TABLE_COLUMN_ONE_NAME",
			value1 = "Text"
