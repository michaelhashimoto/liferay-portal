		AssertClick(
			locator1 = "PGDDLDisplay#RECORD_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClick(locator1 = "PGDDLDisplay#RECORD_MENULIST_VIEW", value1 = "View");

		AssertTextEquals(
			locator1 = "PGDDLDisplayRecord#FIELD_1",
			value1 = "Text ${recordText}"
		);
	}
