		AssertTextEquals(
			locator1 = "CPDynamicdatalistsList#HEADER_TITLE",
			value1 = "${listName}"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsList#RECORD_TABLE_COLUMN_ONE_NAME",
			value1 = "Text"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsList#RECORD_TABLE_COLUMN_ONE_RECORD_1",
