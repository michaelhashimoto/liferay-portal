		);

		AssertClick.assertTextClickAt(
			locator1 = "CPDynamicdatalists#LIST_MENULIST_SPREADSHEET_VIEW",
			value1 = "Spreadsheet View"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsListSpreadsheetview#HEADER_TITLE",
			value1 = "${listName}"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsListSpreadsheetview#RECORD_TABLE_COLUMN_ONE_NAME",
			value1 = "Text"
