definition {
	macro addBooleanCmdCP {
		if ("${recordBoolean}" == "false") {
			Uncheck(locator1 = "//input[contains(@id,'_167_${booleanNameLabel}')]");
		}
		else if ("${recordBoolean}" == "true") {
			Check(locator1 = "//input[contains(@id,'_167_${booleanNameLabel}')]");
		}
		else {
			fail("Invalid var recordBooleanValue. Must be (true|false).");
		}
	}

	macro addCP {
		Type(locator1 = "CPDynamicdatalists#BASIC_SEARCH_FIELD", value1 = "${listName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalists#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalists#LIST_TABLE_NAME_1",
			value1 = "${listName}"
		);

		AssertClick(
			locator1 = "CPDynamicdatalists#LIST_TABLE_NAME_1",
			value1 = "${listName}"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsList#HEADER_TITLE",
			value1 = "${listName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalistsList#ADD_RECORD_BUTTON",
			value1 = "Add Record"
		);

		ListRecord.addTextCmdCP(
			textNameLabel = "text",
			recordText = "${recordText}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalistsListAddrecord#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsList#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro addDateCmdCP {
		Select(
			locator1 = "//select[contains(@id,'_167_${dateNameLabel}') and @class='datepicker-month']",
			value1 = "${recordDateMonth}"
		);

		Select(
			locator1 = "//select[contains(@id,'_167_${dateNameLabel}') and @class='datepicker-day']",
			value1 = "${recordDateDay}"
		);

		Select(
			locator1 = "//select[contains(@id,'_167_${dateNameLabel}') and @class='datepicker-year']",
			value1 = "${recordDateYear}"
		);
	}

	macro addDecimalCmdCP {
		Type(
			locator1 = "//input[contains(@id,'_167_${decimalNameLabel}')]",
			value1 = "${recordDecimal}"
		);
	}

	macro addDocumentsAndMediaCmdCP {
		fail("Add Documents and Media record not yet implentmented.");
	}

	macro addFileUploadCmdCP {
		fail("Add File Upload record not yet implemented.");
	}

	macro addIntegerCmdCP {
		Type(
			locator1 = "//input[contains(@id,'_167_${integerNameLabel}')]",
			value1 = "${recordInteger}"
		);
	}

	macro addNumberCmdCP {
		Type(
			locator1 = "//input[contains(@id,'_167_${numberNameLabel}')]",
			value1 = "${recordNumber}"
		);
	}

	macro addPG {
		AssertClick.assertValueClickAt(
			locator1 = "PGDDLDisplay#ADD_RECORD_BUTTON",
			value1 = "Add Record"
		);

		ListRecord.addTextCmdPG(textNameLabel = "text");

		AssertClick.assertValueClickAt(
			locator1 = "PGDDLDisplayAddrecord#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals.assertText(
			locator1 = "PGDDLDisplay#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro addRadioCmdCP {
		if ("${recordRadio}" == "1") {
			AssertClick(
				locator1 = "xpath=(//input[contains(@name,'_167_${radioNameLabel}')])[1]",
				value1 = "${radioNameLabel}"
			);
		}
		else if ("${recordRadio}" == "2") {
			AssertClick(
				locator1 = "xpath=(//input[contains(@name,'_167_${radioNameLabel}')])[2]",
				value1 = "${radioNameLabel}"
			);
		}
		else if ("${recordRadio}" == "3") {
			AssertClick(
				locator1 = "xpath=(//input[contains(@name,'_167_${radioNameLabel}')])[3]",
				value1 = "${radioNameLabel}"
			);
		}
		else {
			fail("Invalid var recordBooleanValue. Must be (1|2|3).");
		}
	}

	macro addSelectCmdCP {
		Select(
			locator1 = "//select[contains(@name,'_167_${selectNameLabel}')",
			value1 = "${recordSelect}"
		);
	}

	macro addTextBoxCmdCP {
		Type(
			locator1 = "//textarea[contains(@id,'_167_${textBoxNameLabel}')]",
			value1 = "${recordTextBox}"
		);
	}

	macro addTextCmdCP {
		Type(
			locator1 = "//input[contains(@id,'_167_${textNameLabel}')]",
			value1 = "${recordText}"
		);
	}

	macro addTextCmdPG {
		Type(
			locator1 = "//input[contains(@id,'_${textNameLabel}')]",
			value1 = "${recordText}"
		);
	}

	macro deleteCP {
		Type(locator1 = "CPDynamicdatalists#BASIC_SEARCH_FIELD", value1 = "${listName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalists#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalists#LIST_TABLE_NAME_1",
			value1 = "${listName}"
		);

		AssertClick(
			locator1 = "CPDynamicdatalists#LIST_TABLE_NAME_1",
			value1 = "${listName}"
		);

		AssertClick(
			locator1 = "CPDynamicdatalistsList#RECORD_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClickNoError(
			locator1 = "CPDynamicdatalistsList#RECORD_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsList#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsList#INFO_MESSAGE",
			value1 = "No records were found."
		);
	}

	macro deletePG {
		AssertClick(
			locator1 = "PGDDLDisplay#RECORD_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClickNoError(
			locator1 = "PGDDLDisplay#RECORD_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextEquals.assertText(
			locator1 = "PGDDLDisplay#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals.assertText(
			locator1 = "PGDDLDisplay#INFO_MESSAGE",
			value1 = "No records were found."
		);
	}

	macro editBooleanCmdCP {
		ListRecord.addBooleanCmdCP(recordBoolean = "${recordBooleanEdit}");
	}

	macro editCP {
		Type(locator1 = "CPDynamicdatalists#BASIC_SEARCH_FIELD", value1 = "${listName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalists#BASIC_SEARCH_BUTTON",
