<definition>
	<command name="addCP">
		<var name="key_entryTitle" value="${entryTitle}" />

		<execute function="#assertClick" locator1="CPBlogs#ENTRY_TABLE_TITLE" value1="${entryTitle}" />

		<execute function="#assertClick" locator1="CPBlogsEntry#COMMENTS_ADD" value1="Be the first." />
		<execute function="#type" locator1="CPBlogsEntry#COMMENTS_BODY_FIELD" value1="${entryComment}" />
		<execute function="#assertClick" locator1="CPBlogsEntry#COMMENTS_REPLY_BUTTON" value1="Reply" />
		<execute function="#assertTextEquals" locator1="CPBlogsEntry#COMMENTS_SUCCESS" value1="Your request processed successfully." />
		<execute function="#assertTextEquals" locator1="CPBlogsEntry#COMMENT_1" value1="${entryComment}" />
	</command>

	<command name="addPG">
		<execute function="#assertClick" locator1="PGBlogs#ENTRY_TITLE_1" value1="${entryTitle}" />

		<execute function="#assertClick" locator1="PGBlogsEntry#COMMENTS_ADD" value1="Be the first." />
		<execute function="#type" locator1="PGBlogsEntry#COMMENTS_BODY_FIELD" value1="${entryComment}" />
		<execute function="#assertClick" locator1="PGBlogsEntry#COMMENTS_REPLY_BUTTON" value1="Reply" />
		<execute function="#assertTextEquals" locator1="PGBlogsEntry#COMMENTS_SUCCESS" value1="Your request processed successfully." />
		<execute function="#assertTextEquals" locator1="PGBlogsEntry#COMMENT_1" value1="${entryComment}" />
	</command>
</definition>