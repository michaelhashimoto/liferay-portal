definition {
	macro addCP {
		var key_entryTitle = "${entryTitle}";

		AssertClick(locator1 = "CPBlogs#ENTRY_TABLE_TITLE", value1 = "${entryTitle}");

		AssertClick(locator1 = "CPBlogsEntry#COMMENTS_ADD", value1 = "Be the first.");

		Type(locator1 = "CPBlogsEntry#COMMENTS_BODY_FIELD", value1 = "${entryComment}");

		AssertClick(locator1 = "CPBlogsEntry#COMMENTS_REPLY_BUTTON", value1 = "Reply");

		AssertTextEquals(
			locator1 = "CPBlogsEntry#COMMENTS_SUCCESS",
			value1 = "Your request processed successfully."
		);

		AssertTextEquals(
			locator1 = "CPBlogsEntry#COMMENT_1",
			value1 = "${entryComment}"
		);
	}

	macro addPG {
		AssertClick(locator1 = "PGBlogs#ENTRY_TITLE_1", value1 = "${entryTitle}");

		AssertClick.assertTextClickAt(
			locator1 = "PGBlogsEntry#COMMENTS_ADD",
			value1 = "Be the first."
		);

		Type(locator1 = "PGBlogsEntry#COMMENTS_BODY_FIELD", value1 = "${entryComment}");

		AssertClick.assertValueClickAt(
			locator1 = "PGBlogsEntry#COMMENTS_REPLY_BUTTON",
			value1 = "Reply"
		);

		AssertTextEquals(
			locator1 = "PGBlogsEntry#COMMENTS_SUCCESS",
			value1 = "Your request processed successfully."
		);

		AssertTextEquals(
			locator1 = "PGBlogsEntry#COMMENT_1",
			value1 = "${entryComment}"
		);
	}
}