<definition>
	<command name="addCP">
		<execute function="AssertClick#assertValueClickAt" locator1="CPWebcontent#ADD_BUTTON" value1="Add" />

		<execute function="Type" locator1="CPWebcontentAddwebcontent#TITLE_FIELD" value1="${webContentTitle}" />
		<execute function="Type#typeCKEditorWaitForCKEditor" locator1="CPWebcontentAddwebcontent#CONTENT_FIELD" value1="${webContentContent}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPWebcontentAddwebcontent#PUBLISH_BUTTON" value1="Publish" />

		<var name="key_webContentTitle" value="${webContentTitle}" />

		<execute function="AssertTextEquals" locator1="CPWebcontent#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals" locator1="CPWebcontent#WEB_CONTENT_TABLE_TITLE" value1="${webContentTitle}" />
		<execute function="AssertTextEquals" locator1="CPWebcontent#WEB_CONTENT_TABLE_STATUS" value1="Approved" />
	</command>

	<command name="addCPwithStructure">
		<execute function="AssertClick" locator1="CPWebcontent#ADD_DROPDOWN" value1="Add" />
		<execute function="Click" locator1="//div[@class='lfr-component lfr-menu-list']/ul/li/a[contains(.,'${structureName}')]" />

		<execute function="Type" locator1="CPWebcontentAddwebcontent#TITLE_FIELD" value1="${webContentTitle}" />
		<execute function="Type" locator1="//input[@name='_15_text_text']" value1="${webContentText}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPWebcontentAddwebcontent#PUBLISH_BUTTON" value1="Publish" />

		<var name="key_webContentTitle" value="${webContentTitle}" />

		<execute function="AssertTextEquals" locator1="CPWebcontent#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals" locator1="CPWebcontent#WEB_CONTENT_TABLE_TITLE" value1="${webContentTitle}" />
	</command>

	<command name="addCPWithWorkflow">
		<execute function="AssertClick#assertValueClickAt" locator1="CPWebcontent#ADD_BUTTON" value1="Add" />

		<execute function="Type" locator1="CPWebcontentAddwebcontent#TITLE_FIELD" value1="${webContentTitle}" />
		<execute function="Type#typeCKEditorWaitForCKEditor" locator1="CPWebcontentAddwebcontent#CONTENT_FIELD" value1="${webContentContent}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPWebcontentAddwebcontent#SUBMIT_FOR_PUBLICATION_BUTTON" value1="Submit for Publication" />

		<var name="key_webContentTitle" value="${webContentTitle}" />

		<execute function="AssertTextEquals" locator1="CPWebcontent#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals" locator1="CPWebcontent#WEB_CONTENT_TABLE_TITLE" value1="${webContentTitle}" />
		<execute function="AssertTextEquals" locator1="CPWebcontent#WEB_CONTENT_TABLE_STATUS" value1="Pending" />
	</command>

	<command name="addPGviaAP">
		<execute function="AssertClick" locator1="PGAssetpublisher#ADD_NEW_DROPDOWN" value1="Add New" />
		<execute function="AssertClick#assertTextClickAt" locator1="PGAssetpublisher#ADD_NEW_MENULIST_WEB_CONTENT" value1="Web Content" />

		<execute function="SelectFrame" locator1="PGAssetpublisherAddnewwebcontent#WEB_CONTENT_IFRAME" />
		<execute function="Type" locator1="PGAssetpublisherAddnewwebcontent#TITLE_FIELD" value1="${webContentTitle}" />
		<execute function="Type#typeCKEditorWaitForCKEditor" locator1="PGAssetpublisherAddnewwebcontent#CONTENT_FIELD" value1="${webContentContent}" />
		<execute function="SelectFrame" locator1="PGAssetpublisherAddnewwebcontent#WEB_CONTENT_IFRAME" />
		<execute function="AssertClick#assertValueClickAt" locator1="PGAssetpublisherAddnewwebcontent#PUBLISH_BUTTON" value1="Publish" />

		<execute function="SelectFrame" />
		<execute function="AssertTextEquals" locator1="PGAssetpublisher#ASSET_TITLE_1" value1="${webContentTitle}" />
		<execute function="AssertTextEquals" locator1="PGAssetpublisher#ASSET_SUMMARY_1" value1="${webContentContent}" />
	</command>

	<command name="addPGviaWCD">
		<execute function="Click#clickAt" locator1="PGWebcontentdisplay#ADD_WEB_CONTENT" />

		<execute function="Type" locator1="PGWebcontentdisplayAddwebcontent#TITLE_FIELD" value1="${webContentTitle}" />
		<execute function="Type#typeCKEditorWaitForCKEditor" locator1="PGWebcontentdisplayAddwebcontent#CONTENT_FIELD" value1="${webContentContent}" />
		<execute function="AssertClick#assertValueClickAt" locator1="PGWebcontentdisplayAddwebcontent#PUBLISH_BUTTON" value1="Publish" />

		<execute function="AssertTextEquals" locator1="PGWebcontentdisplay#WEB_CONTENT_CONTENT" value1="${webContentContent}" />
	</command>

	<command name="addPGWithWorkflowViaAP">
		<execute function="AssertClick" locator1="PGAssetpublisher#ADD_NEW_DROPDOWN" value1="Add New" />
		<execute function="AssertClick#assertTextClickAt" locator1="PGAssetpublisher#ADD_NEW_MENULIST_WEB_CONTENT" value1="Web Content" />

		<execute function="SelectFrame" locator1="PGAssetpublisherAddnewwebcontent#WEB_CONTENT_IFRAME" />
		<execute function="Type" locator1="PGAssetpublisherAddnewwebcontent#TITLE_FIELD" value1="${webContentTitle}" />
		<execute function="Type#typeCKEditorWaitForCKEditor" locator1="PGAssetpublisherAddnewwebcontent#CONTENT_FIELD" value1="${webContentContent}" />
		<execute function="SelectFrame" locator1="PGAssetpublisherAddnewwebcontent#WEB_CONTENT_IFRAME" />
		<execute function="AssertClick" locator1="PGAssetpublisherAddnewwebcontent#SUBMIT_FOR_PUBLICATION_BUTTON" value1="Submit for Publication" />

		<execute function="SelectFrame" />
		<execute function="AssertTextNotPresent" value1="${webContentTitle}" />
		<execute function="AssertTextEquals" locator1="PGAssetpublisher#INFO_MESSAGE" value1="There are no results." />
	</command>

	<command name="addPGWithWorkflowViaWCD">
		<execute function="Click#clickAt" locator1="PGWebcontentdisplay#ADD_WEB_CONTENT" />

		<execute function="Type" locator1="PGWebcontentdisplayAddwebcontent#TITLE_FIELD" value1="${webContentTitle}" />
		<execute function="Type#typeCKEditorWaitForCKEditor" locator1="PGWebcontentdisplayAddwebcontent#CONTENT_FIELD" value1="${webContentContent}" />
		<execute function="AssertClick" locator1="PGWebcontentdisplayAddwebcontent#SUBMIT_FOR_PUBLICATION_BUTTON" value1="Submit for Publication" />

		<execute function="AssertTextEquals" locator1="PGWebcontentdisplay#ALERT_MESSAGE" value1="${webContentTitle} is not approved." />
	</command>

	<command name="editPGviaWCD">
		<execute function="Click#clickAt" locator1="PGWebcontentdisplay#EDIT_WEB_CONTENT" />

		<execute function="Type" locator1="PGWebcontentdisplayEditwebcontent#TITLE_FIELD" value1="${webContentTitleEdit}" />
		<execute function="Type#typeCKEditorWaitForCKEditor" locator1="PGWebcontentdisplayEditwebcontent#CONTENT_FIELD" value1="${webContentContentEdit}" />
		<execute function="AssertClick#assertValueClickAt" locator1="PGWebcontentdisplayEditwebcontent#PUBLISH_BUTTON" value1="Publish" />

		<execute function="AssertTextEquals" locator1="PGWebcontentdisplay#WEB_CONTENT_CONTENT" value1="${webContentContentEdit}" />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Web Content" />
		</execute>

		<if>
			<condition function="IsElementPresent#isVisible" locator1="CPWebcontent#WEB_CONTENT_TABLE_ALL_CHECKBOX" />
			<then>
				<execute function="Check" locator1="CPWebcontent#WEB_CONTENT_TABLE_ALL_CHECKBOX" />
				<execute function="AssertClickNoError" locator1="CPWebcontent#DELETE_BUTTON" value1="Delete" />
				<execute function="Confirm" value1="Are you sure you want to delete the selected web content?" />
				<execute function="AssertTextEquals" locator1="CPWebcontent#SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</if>

		<execute function="AssertTextEquals" locator1="CPWebcontent#INFO_MESSAGE" value1="No Web Content was found." />
	</command>

	<command name="viewCP">
		<var name="key_webContentTitle" value="${webContentTitle}" />

		<execute function="AssertTextEquals" locator1="CPWebcontent#WEB_CONTENT_TABLE_TITLE" value1="${webContentTitle}" />
		<execute function="AssertTextEquals" locator1="CPWebcontent#WEB_CONTENT_TABLE_STATUS" value1="Approved" />
	</command>

	<command name="viewCPDraft">
		<var name="key_webContentTitle" value="${webContentTitle}" />

		<execute function="AssertTextEquals" locator1="CPWebcontent#WEB_CONTENT_TABLE_TITLE" value1="${webContentTitle}" />
		<execute function="AssertTextEquals" locator1="CPWebcontent#WEB_CONTENT_TABLE_STATUS" value1="Draft" />
	</command>

	<command name="viewCPWithWorkflow">
		<var name="key_webContentTitle" value="${webContentTitle}" />

		<execute function="AssertTextEquals" locator1="CPWebcontent#WEB_CONTENT_TABLE_TITLE" value1="${webContentTitle}" />
		<execute function="AssertTextEquals" locator1="CPWebcontent#WEB_CONTENT_TABLE_STATUS" value1="Pending" />
	</command>

	<command name="viewPGViaAP">
		<var name="key_webContentTitle" value="${webContentTitle}" />

		<execute function="AssertTextEquals" locator1="PGAssetpublisher#ASSET_TITLE" value1="${webContentTitle}" />
		<execute function="AssertTextEquals" locator1="PGAssetpublisher#ASSET_SUMMARY" value1="${webContentContent}" />
		<execute function="AssertClick#assertPartialTextClickAt" locator1="PGAssetpublisher#ASSET_READ_MORE" value1="Read More" />

		<execute function="AssertTextEquals" locator1="PGAssetpublisherAsset#ASSET_TITLE" value1="${webContentTitle}" />
		<execute function="AssertTextEquals" locator1="PGAssetpublisherAsset#ASSET_CONTENT" value1="${webContentContent}" />
	</command>

	<command name="viewPGViaWCD">
		<execute function="AssertTextEquals" locator1="PGWebcontentdisplay#WEB_CONTENT_CONTENT" value1="${webContentContent}" />
	</command>

	<command name="viewPGWithWorkflowViaAP">
		<var name="key_webContentTitle" value="${webContentTitle}" />

		<execute function="AssertTextNotPresent" value1="${webContentTitle}" />
	</command>

	<command name="viewPGWithWorkflowViaWCD">
		<execute function="AssertTextEquals" locator1="PGWebcontentdisplay#ALERT_MESSAGE" value1="${webContentTitle} is not approved." />
		<execute function="AssertClick" locator1="PGWebcontentdisplay#ALERT_MESSAGE" value1="${webContentTitle} is not approved." />

		<execute function="AssertTextEquals" locator1="PGWebcontentdisplayEditwebcontent#WORKFLOW_STATUS" value1="Pending (${workflowTask})" />
		<execute function="AssertTextEquals" locator1="PGWebcontentdisplayEditwebcontent#TITLE_FIELD" value1="${webContentTitle}" />
		<execute function="SelectFrame" locator1="PGWebcontentdisplayEditwebcontent#CONTENT_FIELD" />
		<execute function="AssertTextEquals" locator1="//body" value1="${webContentContent}" />
		<execute function="SelectFrameTop" />
	</command>
</definition>