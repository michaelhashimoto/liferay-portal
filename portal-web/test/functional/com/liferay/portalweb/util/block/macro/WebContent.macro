definition {
	macro addCP {
		AssertClick.assertValueClickAt(
			locator1 = "CPWebcontent#ADD_BUTTON",
			value1 = "Add"
		);

		Type(
			locator1 = "CPWebcontentAddwebcontent#TITLE_FIELD",
			value1 = "${webContentTitle}"
		);

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "CPWebcontentAddwebcontent#CONTENT_FIELD",
			value1 = "${webContentContent}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPWebcontentAddwebcontent#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		var key_webContentTitle = "${webContentTitle}";

		AssertTextEquals(
			locator1 = "CPWebcontent#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "CPWebcontent#WEB_CONTENT_TABLE_TITLE",
			value1 = "${webContentTitle}"
		);

		AssertTextEquals(
			locator1 = "CPWebcontent#WEB_CONTENT_TABLE_STATUS",
			value1 = "Approved"
		);
	}

	macro addCPwithStructure {
		AssertClick(locator1 = "CPWebcontent#ADD_DROPDOWN", value1 = "Add");

		Click(
			locator1 = "//div[@class='lfr-component lfr-menu-list']/ul/li/a[contains(.,'${structureName}')]"
		);

		Type(
			locator1 = "CPWebcontentAddwebcontent#TITLE_FIELD",
			value1 = "${webContentTitle}"
		);

		Type(locator1 = "//input[@name='_15_text_text']", value1 = "${webContentText}");

		AssertClick.assertValueClickAt(
			locator1 = "CPWebcontentAddwebcontent#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		var key_webContentTitle = "${webContentTitle}";

		AssertTextEquals(
			locator1 = "CPWebcontent#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "CPWebcontent#WEB_CONTENT_TABLE_TITLE",
			value1 = "${webContentTitle}"
		);
	}

	macro addCPWithWorkflow {
		AssertClick.assertValueClickAt(
			locator1 = "CPWebcontent#ADD_BUTTON",
			value1 = "Add"
		);

		Type(
			locator1 = "CPWebcontentAddwebcontent#TITLE_FIELD",
			value1 = "${webContentTitle}"
		);

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "CPWebcontentAddwebcontent#CONTENT_FIELD",
			value1 = "${webContentContent}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPWebcontentAddwebcontent#SUBMIT_FOR_PUBLICATION_BUTTON",
			value1 = "Submit for Publication"
		);

		var key_webContentTitle = "${webContentTitle}";

		AssertTextEquals(
			locator1 = "CPWebcontent#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "CPWebcontent#WEB_CONTENT_TABLE_TITLE",
			value1 = "${webContentTitle}"
		);

		AssertTextEquals(
			locator1 = "CPWebcontent#WEB_CONTENT_TABLE_STATUS",
			value1 = "Pending"
		);
	}

	macro addPGviaAP {
		AssertClick(locator1 = "PGAssetpublisher#ADD_NEW_DROPDOWN", value1 = "Add New");

		AssertClick.assertTextClickAt(
			locator1 = "PGAssetpublisher#ADD_NEW_MENULIST_WEB_CONTENT",
			value1 = "Web Content"
		);

		SelectFrame(locator1 = "PGAssetpublisherAddnewwebcontent#WEB_CONTENT_IFRAME");

		Type(
			locator1 = "PGAssetpublisherAddnewwebcontent#TITLE_FIELD",
			value1 = "${webContentTitle}"
		);

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "PGAssetpublisherAddnewwebcontent#CONTENT_FIELD",
			value1 = "${webContentContent}"
		);

		SelectFrame(locator1 = "PGAssetpublisherAddnewwebcontent#WEB_CONTENT_IFRAME");

		AssertClick.assertValueClickAt(
			locator1 = "PGAssetpublisherAddnewwebcontent#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		SelectFrame();

		AssertTextEquals(
			locator1 = "PGAssetpublisher#ASSET_TITLE_1",
			value1 = "${webContentTitle}"
		);

		AssertTextEquals(
			locator1 = "PGAssetpublisher#ASSET_SUMMARY_1",
			value1 = "${webContentContent}"
		);
	}

	macro addPGviaWCD {
		Click.clickAt(locator1 = "PGWebcontentdisplay#ADD_WEB_CONTENT");

		Type(
			locator1 = "PGWebcontentdisplayAddwebcontent#TITLE_FIELD",
			value1 = "${webContentTitle}"
		);

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "PGWebcontentdisplayAddwebcontent#CONTENT_FIELD",
			value1 = "${webContentContent}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGWebcontentdisplayAddwebcontent#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals(
			locator1 = "PGWebcontentdisplay#WEB_CONTENT_CONTENT",
			value1 = "${webContentContent}"
		);
	}

	macro addPGWithWorkflowViaAP {
		AssertClick(locator1 = "PGAssetpublisher#ADD_NEW_DROPDOWN", value1 = "Add New");

		AssertClick.assertTextClickAt(
			locator1 = "PGAssetpublisher#ADD_NEW_MENULIST_WEB_CONTENT",
			value1 = "Web Content"
		);

		SelectFrame(locator1 = "PGAssetpublisherAddnewwebcontent#WEB_CONTENT_IFRAME");

		Type(
			locator1 = "PGAssetpublisherAddnewwebcontent#TITLE_FIELD",
			value1 = "${webContentTitle}"
		);

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "PGAssetpublisherAddnewwebcontent#CONTENT_FIELD",
			value1 = "${webContentContent}"
		);

		SelectFrame(locator1 = "PGAssetpublisherAddnewwebcontent#WEB_CONTENT_IFRAME");

		AssertClick(
			locator1 = "PGAssetpublisherAddnewwebcontent#SUBMIT_FOR_PUBLICATION_BUTTON",
			value1 = "Submit for Publication"
		);

		SelectFrame();

		AssertTextNotPresent(value1 = "${webContentTitle}");

		AssertTextEquals(
			locator1 = "PGAssetpublisher#INFO_MESSAGE",
			value1 = "There are no results."
		);
	}

	macro addPGWithWorkflowViaWCD {
		Click.clickAt(locator1 = "PGWebcontentdisplay#ADD_WEB_CONTENT");

		Type(
			locator1 = "PGWebcontentdisplayAddwebcontent#TITLE_FIELD",
			value1 = "${webContentTitle}"
		);

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "PGWebcontentdisplayAddwebcontent#CONTENT_FIELD",
			value1 = "${webContentContent}"
		);

		AssertClick(
			locator1 = "PGWebcontentdisplayAddwebcontent#SUBMIT_FOR_PUBLICATION_BUTTON",
			value1 = "Submit for Publication"
		);

		AssertTextEquals(
			locator1 = "PGWebcontentdisplay#ALERT_MESSAGE",
			value1 = "${webContentTitle} is not approved."
		);
	}

	macro editPGviaWCD {
		Click.clickAt(locator1 = "PGWebcontentdisplay#EDIT_WEB_CONTENT");

		Type(
			locator1 = "PGWebcontentdisplayEditwebcontent#TITLE_FIELD",
			value1 = "${webContentTitleEdit}"
		);

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "PGWebcontentdisplayEditwebcontent#CONTENT_FIELD",
			value1 = "${webContentContentEdit}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGWebcontentdisplayEditwebcontent#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals(
			locator1 = "PGWebcontentdisplay#WEB_CONTENT_CONTENT",
			value1 = "${webContentContentEdit}"
		);
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Web Content");

		if (IsElementPresent.isVisible(locator1 = "CPWebcontent#WEB_CONTENT_TABLE_ALL_CHECKBOX")) {
			Check(locator1 = "CPWebcontent#WEB_CONTENT_TABLE_ALL_CHECKBOX");

			AssertClickNoError(locator1 = "CPWebcontent#DELETE_BUTTON", value1 = "Delete");

			Confirm(value1 = "Are you sure you want to delete the selected web content?");

			AssertTextEquals(
				locator1 = "CPWebcontent#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}

		AssertTextEquals(
			locator1 = "CPWebcontent#INFO_MESSAGE",
			value1 = "No Web Content was found."
		);
	}

	macro viewCP {
		var key_webContentTitle = "${webContentTitle}";

		AssertTextEquals(
			locator1 = "CPWebcontent#WEB_CONTENT_TABLE_TITLE",
			value1 = "${webContentTitle}"
		);

		AssertTextEquals(
			locator1 = "CPWebcontent#WEB_CONTENT_TABLE_STATUS",
			value1 = "Approved"
		);
	}

	macro viewCPDraft {
		var key_webContentTitle = "${webContentTitle}";

		AssertTextEquals(
			locator1 = "CPWebcontent#WEB_CONTENT_TABLE_TITLE",
			value1 = "${webContentTitle}"
		);

		AssertTextEquals(
			locator1 = "CPWebcontent#WEB_CONTENT_TABLE_STATUS",
			value1 = "Draft"
		);
	}

	macro viewCPWithWorkflow {
		var key_webContentTitle = "${webContentTitle}";

		AssertTextEquals(
			locator1 = "CPWebcontent#WEB_CONTENT_TABLE_TITLE",
			value1 = "${webContentTitle}"
		);

		AssertTextEquals(
			locator1 = "CPWebcontent#WEB_CONTENT_TABLE_STATUS",
			value1 = "Pending"
		);
	}

	macro viewPGViaAP {
		var key_webContentTitle = "${webContentTitle}";

		AssertTextEquals(
			locator1 = "PGAssetpublisher#ASSET_TITLE",
			value1 = "${webContentTitle}"
		);

		AssertTextEquals(
			locator1 = "PGAssetpublisher#ASSET_SUMMARY",
			value1 = "${webContentContent}"
		);

		AssertClick.assertPartialTextClickAt(
			locator1 = "PGAssetpublisher#ASSET_READ_MORE",
			value1 = "Read More"
		);

		AssertTextEquals(
			locator1 = "PGAssetpublisherAsset#ASSET_TITLE",
			value1 = "${webContentTitle}"
		);

		AssertTextEquals(
			locator1 = "PGAssetpublisherAsset#ASSET_CONTENT",
			value1 = "${webContentContent}"
		);
	}

	macro viewPGViaWCD {
		AssertTextEquals(
			locator1 = "PGWebcontentdisplay#WEB_CONTENT_CONTENT",
			value1 = "${webContentContent}"
		);
	}

	macro viewPGWithWorkflowViaAP {
		var key_webContentTitle = "${webContentTitle}";

		AssertTextNotPresent(value1 = "${webContentTitle}");
	}

	macro viewPGWithWorkflowViaWCD {
		AssertTextEquals(
			locator1 = "PGWebcontentdisplay#ALERT_MESSAGE",
			value1 = "${webContentTitle} is not approved."
		);

		AssertClick(
			locator1 = "PGWebcontentdisplay#ALERT_MESSAGE",
			value1 = "${webContentTitle} is not approved."
		);

		AssertTextEquals(
			locator1 = "PGWebcontentdisplayEditwebcontent#WORKFLOW_STATUS",
			value1 = "Pending (${workflowTask})"
		);

		AssertTextEquals(
			locator1 = "PGWebcontentdisplayEditwebcontent#TITLE_FIELD",
			value1 = "${webContentTitle}"
		);

		SelectFrame(locator1 = "PGWebcontentdisplayEditwebcontent#CONTENT_FIELD");

		AssertTextEquals(locator1 = "//body", value1 = "${webContentContent}");

		SelectFrameTop();
	}
}