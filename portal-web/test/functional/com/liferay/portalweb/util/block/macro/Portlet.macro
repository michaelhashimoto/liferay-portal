definition {
	@summary = "Add a '${portletName}' portlet"
	macro addPG {
		Page.gotoPG(
			pageAccess = "${pageAccess}",
			pageName = "${pageName}",
			pageStaging = "${pageStaging}",
			pageType = "${pageType}"
		);

		if (IsElementPresent(locator1 = "SOUserBar#USER_BAR")) {
			if (IsElementNotPresent(locator1 = "SOUserBar#VISIBLE_DOCKBAR")) {
				Click(locator1 = "SOUserBar#TOGGLE_DOCKBAR");
			}
		}

		MouseOver.textMouseOverClickDockbar(locator1 = "Dockbar#ADD", value1 = "Add");

		Click(locator1 = "Dockbar#ADD_APPLICATION");

		Type.sendKeysApplicationSearch(
			locator1 = "Dockbar#ADD_APPLICATION_SEARCH_FIELD",
			value1 = "${portletName}"
		);

		Click(locator1 = "//div[@title='${portletName}']/p/a", value1 = "Add");

		AssertElementPresent(locator1 = "Home#PORTLET_1");
	}

	macro removePG {
		Page.gotoPG(pageName = "${pageName}");

		ClickNoError(locator1 = "Home#PORTLET_REMOVE_1");

		Confirm(value1 = "Are you sure you want to remove this component?");

		AssertElementNotPresent(locator1 = "Home#PORTLET_1");
	}

	@summary = "Assert that the ${portletName} portlet body has the text '${portletBody}'"
	macro viewBody {
		var key_portletName = "${portletName}";

		AssertTextEquals.assertPartialText(
			locator1 = "BasePortlet#PORTLET_BODY",
			value1 = "${portletBody}"
		);
	}

	@summary = "Assert that the ${portletName} portlet title has the text '${portletName}'"
	macro viewTitle {
		AssertTextEquals(locator1 = "BasePortlet#TITLE", value1 = "${portletName}");
	}
}