<definition>
	<command name="addPG">
		<description message="Add a ${portletName} portlet to ${pageName}." />

		<execute macro="Page#gotoPG">
			<var name="pageName" value="${pageName}" />
		</execute>

		<if>
			<condition action="SOUserBar#isElementPresent" locator1="USER_BAR" />
			<then>
				<if>
					<condition action="SOUserBar#isElementNotPresent" locator1="VISIBLE_DOCKBAR" />
					<then>
						<execute action="SOUserBar#click" locator1="TOGGLE_DOCKBAR" />
					</then>
				</if>
			</then>
		</if>

		<execute action="Dockbar#mouseOver" locator1="ADD" />
		<execute action="Dockbar#click" locator1="ADD_APPLICATION" />
		<execute action="Dockbar#type" locator1="ADD_APPLICATION_SEARCH_FIELD" value1="${portletName}" />
		<execute function="#click" locator1="//div[@title='${portletName}']/p/a" value1="Add" />

		<execute action="Home#assertElementPresent" locator1="PORTLET_1" />
	</command>

	<command name="removePG">
		<execute macro="Page#gotoPG">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute action="Home#clickNoError" locator1="PORTLET_REMOVE_1" />
		<execute action="Home#confirm" locator1="CONFIRMATION" value1="Are you sure you want to remove this component?" />
		<execute action="Home#assertElementNotPresent" locator1="PORTLET_1" />
	</command>
</definition>