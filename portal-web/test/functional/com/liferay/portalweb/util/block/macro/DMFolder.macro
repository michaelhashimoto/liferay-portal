definition {
	macro addCP {
		AssertClick(locator1 = "CPDocumentsandmedia#ADD", value1 = "Add");

		AssertClick(
			locator1 = "CPDocumentsandmedia#ADD_MENULIST_FOLDER",
			value1 = "Folder"
		);

		Type(
			locator1 = "CPDocumentsandmediaAddfolder#NAME_FIELD",
			value1 = "${dmFolderName}"
		);

		Type(
			locator1 = "CPDocumentsandmediaAddfolder#DESCRIPTION_FIELD",
			value1 = "${dmFolderDescription}"
		);

		AssertClick(
			locator1 = "CPDocumentsandmediaAddfolder#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#REQUEST",
			value1 = "Your request completed successfully."
		);

		if (IsElementNotPresent(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER2")) {
			AssertElementPresent(
				locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1"
			);

			AssertTextEquals(
				locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_TITLE",
				value1 = "${dmFolderName}"
			);
		}
		else {
			AssertElementPresent(
				locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER2"
			);

			AssertTextEquals(
				locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER2_TITLE",
				value1 = "${dmFolderName}"
			);
		}
	}

	macro addPG {
		AssertClick(locator1 = "PGDocumentsandmedia#TOOLBAR_ADD", value1 = "Add");

		AssertClick(
			locator1 = "PGDocumentsandmedia#ADD_MENULIST_FOLDER",
			value1 = "Folder"
		);

		if (isSet(number)) {
			var number = "${number}";

			Type(
				locator1 = "PGDocumentsandmediaAddfolder#NAME_FIELD",
				value1 = "${dmFolderName}${number}"
			);

			Type(
				locator1 = "PGDocumentsandmediaAddfolder#DESCRIPTION_FIELD",
				value1 = "${dmFolderDescription}${number}"
			);

			AssertClick(
				locator1 = "PGDocumentsandmediaAddfolder#SAVE_BUTTON",
				value1 = "Save"
			);
		}
		else {
			Type(
				locator1 = "PGDocumentsandmediaAddfolder#NAME_FIELD",
				value1 = "${dmFolderName}"
			);

			Type(
				locator1 = "PGDocumentsandmediaAddfolder#DESCRIPTION_FIELD",
				value1 = "${dmFolderDescription}"
			);

			AssertClick(
				locator1 = "PGDocumentsandmediaAddfolder#SAVE_BUTTON",
				value1 = "Save"
			);
		}

		AssertTextEquals(
			locator1 = "PGDocumentsandmedia#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro addPGviaDMD {
		AssertClick.assertTextClickAt(
			locator1 = "PGDocumentlibrarydisplay#FOLDER_MENU_ADD_FOLDER",
			value1 = "Add Folder"
		);

		Type(
			locator1 = "PGDocumentlibrarydisplayAddfolder#FOLDER_NAME",
			value1 = "${dmdFolderName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGDocumentlibrarydisplayAddfolder#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplay#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplay#FOLDERS_TABLE_NAME_1",
			value1 = "${dmdFolderName}"
		);

		Click(
			locator1 = "PGDocumentlibrarydisplay#FOLDERS_TABLE_NAME_1",
			value1 = "${dmdFolderName}"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplayFolder#FOLDER_NAME",
			value1 = "${dmdFolderName}"
		);

		AssertElementPresent(
			locator1 = "PGDocumentlibrarydisplayFolder#ASSET_THUMBNAIL"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplayFolder#ASSET_NAME",
			value1 = "${dmdFolderName}"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplayFolder#INFO_MESSAGE",
			value1 = "There are no documents or media files in this folder."
		);
	}

	macro addPGviaMG {
		AssertClick(
			locator1 = "PGMediagallery#FOLDER_MENU_ADD_FOLDER",
			value1 = "Add Folder"
		);

		Type(
			locator1 = "PGMediagalleryAddfolder#NAME_FIELD",
			value1 = "${mgFolderName}"
		);

		Type(
			locator1 = "PGMediagalleryAddfolder#DESCRIPTION_FIELD",
			value1 = "${mgFolderDescription}"
		);

		AssertClick(locator1 = "PGMediagalleryAddfolder#SAVE_BUTTON", value1 = "Save");

		AssertTextEquals(
			locator1 = "PGMediagalleryAddfolder#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertElementPresent(locator1 = "PGMediagallery#ENTRY_THUMBNAIL");

		AssertTextEquals(
			locator1 = "PGMediagallery#ENTRY_TITLE",
			value1 = "${mgFolderName}"
		);
	}

	macro deleteCP {
		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1"
		);

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_TITLE",
			value1 = "${dmFolderName}"
		);

		MouseOver(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1");

		Click(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_CHECKBOX");

		AssertElementPresent(locator1 = "CPDocumentsandmedia#ACTIONS");

		AssertClick(locator1 = "CPDocumentsandmedia#ACTIONS", value1 = "Actions");

		AssertClickNoError(
			locator1 = "CPDocumentsandmedia#ACTIONS_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete the selected entries?");

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#REQUEST",
			value1 = "Your request completed successfully."
		);

		if (IsElementPresent(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1")) {
			AssertTextNotEquals(
				locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_TITLE",
				value1 = "${dmFolderName}"
			);
		}
		else {
			AssertElementNotPresent(
				locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1"
			);
		}
	}

	macro deletePG {
		var key_dmFolderName = "${dmFolderName}";

		AssertElementPresent(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		AssertTextEquals(
			locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER_TITLE",
			value1 = "${dmFolderName}"
		);

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER_SELECT");

		AssertClick(
			locator1 = "PGDocumentsandmedia#TOOLBAR_ACTIONS",
			value1 = "Actions"
		);

		AssertClickNoError(
			locator1 = "PGDocumentsandmedia#ACTIONS_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete the selected entries?");

		AssertTextEquals(
			locator1 = "PGDocumentsandmedia#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertElementNotPresent(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");
	}

	macro editCP {
		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1"
		);

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_TITLE",
			value1 = "${dmFolderName}"
		);

		MouseOver(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1");

		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_DROPDOWN"
		);

		Click(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_DROPDOWN");

		AssertElementPresent(locator1 = "CPDocumentsandmedia#FOLDER_MENULIST_EDIT");

		AssertClick(
			locator1 = "CPDocumentsandmedia#FOLDER_MENULIST_EDIT",
			value1 = "Edit"
		);

		Type(
			locator1 = "CPDocumentsandmediaEditfolder#NAME_FIELD",
			value1 = "${dmFolderNameEdit}"
		);

		Type(
			locator1 = "CPDocumentsandmediaEditfolder#DESCRIPTION_FIELD",
			value1 = "${dmFolderDescriptionEdit}"
		);

		AssertClick(
			locator1 = "CPDocumentsandmediaEditfolder#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#REQUEST",
			value1 = "Your request completed successfully."
		);

		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1"
		);

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_TITLE",
			value1 = "${dmFolderNameEdit}"
		);
	}

	macro editPG {
		AssertTextEquals(
			locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER_TITLE",
			value1 = "${dmFolderName}"
		);

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER_ACTIONS");

		AssertClick(
			locator1 = "PGDocumentsandmedia#FOLDER_MENULIST_EDIT",
			value1 = "Edit"
		);

		Type(
			locator1 = "PGDocumentsandmediaEditfolder#NAME_FIELD",
			value1 = "${dmFolderNameEdit}"
		);

		Type(
			locator1 = "PGDocumentsandmediaEditfolder#DESCRIPTION_FIELD",
			value1 = "${dmFolderDescriptionEdit}"
		);

		AssertClick(
			locator1 = "PGDocumentsandmediaEditfolder#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "PGDocumentsandmedia#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER_TITLE",
			value1 = "${dmFolderNameEdit}"
		);
	}

	macro editPGviaMG {
		AssertTextEquals(
			locator1 = "PGMediagallery#ENTRY_TITLE",
			value1 = "${mgFolderName}"
		);

		AssertClick(locator1 = "PGMediagallery#ENTRY_TITLE", value1 = "${mgFolderName}");

		AssertClick(locator1 = "PGMediagalleryFolder#FOLDER_MENU_EDIT", value1 = "Edit");

		Type(
			locator1 = "PGMediagalleryEditfolder#NAME_FIELD",
			value1 = "${mgFolderNameEdit}"
		);

		Type(
			locator1 = "PGMediagalleryEditfolder#DESCRIPTION_FIELD",
			value1 = "${mgFolderDescriptionEdit}"
		);

		AssertClick(locator1 = "PGMediagalleryEditfolder#SAVE_BUTTON", value1 = "Save");

		AssertTextEquals(
			locator1 = "PGMediagalleryEditfolder#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro gotoPG {
		var key_dmFolderName = "${dmFolderName}";

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");
	}

	macro moveToFolderCP {
		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1"
		);

		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER2"
		);

		Click(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_DROPDOWN");

		AssertElementPresent(locator1 = "CPDocumentsandmedia#FOLDER_MENULIST_MOVE");

		AssertClick(
			locator1 = "CPDocumentsandmedia#FOLDER_MENULIST_MOVE",
			value1 = "Move"
		);

		AssertClick(
			locator1 = "CPDocumentsandmediaMovefolder#SELECT_PARENT_FOLDER_BUTTON",
			value1 = "Select"
		);

		SelectWindow(locator1 = "CPDocumentsandmediaMovefolder#FOLDER_WINDOW_ID");

		AssertClick(
			locator1 = "CPDocumentsandmediaMovefolder#FOLDER_WINDOW_FOLDER2_CHOOSE_BUTTON",
			value1 = "Choose"
		);

		SelectWindow(locator1 = "null");

		AssertTextEquals(
			locator1 = "CPDocumentsandmediaMovefolder#PARENT_FOLDER",
			value1 = "${dmFolderName2}"
		);

		AssertClick(
			locator1 = "CPDocumentsandmediaMovefolder#MOVE_BUTTON",
			value1 = "Move"
		);

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#REQUEST",
			value1 = "Your request completed successfully."
		);

		AssertElementNotPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER2"
		);

		Click(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1");
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Documents and Media");

		while (IsElementPresent(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1")) {
			Select(
				locator1 = "CPDocumentsandmedia#PAGINATION_ROWS_PER_PAGE_SELECT",
				value1 = "75"
			);

			Check(locator1 = "CPDocumentsandmedia#SELECT_ALL_ROWS_CHECKBOX");

			AssertClick(locator1 = "CPDocumentsandmedia#ACTIONS", value1 = "Actions");

			AssertElementPresent(locator1 = "CPDocumentsandmedia#ACTIONS_MENULIST_DELETE");

			AssertClickNoError(
				locator1 = "CPDocumentsandmedia#ACTIONS_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete the selected entries?");

			AssertTextEquals(
				locator1 = "CPDocumentsandmedia#REQUEST",
				value1 = "Your request completed successfully."
			);
		}
	}

	macro tearDownPG {
		Page.gotoPG(pageName = "${pageName}");

		if (IsElementPresent(locator1 = "PGDocumentsandmedia#TOOLBAR_SELECT_ALL_CHECKBOX")) {
			Check(locator1 = "PGDocumentsandmedia#TOOLBAR_SELECT_ALL_CHECKBOX");

			AssertClick(
				locator1 = "PGDocumentsandmedia#TOOLBAR_ACTIONS",
				value1 = "Actions"
			);

			AssertElementPresent(locator1 = "PGDocumentsandmedia#ACTIONS_MENULIST_DELETE");

			AssertClickNoError(
				locator1 = "PGDocumentsandmedia#ACTIONS_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete the selected entries?");

			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}
	}

	macro tearDownPGviaDMD {
		Page.gotoPG(pageName = "${pageName}");

		while (IsElementPresent(locator1 = "PGDocumentlibrarydisplay#FOLDERS_TABLE_ACTIONS_BUTTON_1")) {
			Click(locator1 = "PGDocumentlibrarydisplay#FOLDERS_TABLE_ACTIONS_BUTTON_1");

			AssertClickNoError(
				locator1 = "PGDocumentlibrarydisplay#FOLDER_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete this?");

			AssertTextEquals(
				locator1 = "PGDocumentlibrarydisplay#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}
	}

	macro tearDownPGviaMG {
		Page.gotoPG(pageName = "${pageName}");

		while (IsElementPresent(locator1 = "PGMediagallery#ENTRY_THUMBNAIL")) {
			Click(locator1 = "PGMediagallery#ENTRY_TITLE");

			AssertClickNoError(
				locator1 = "PGMediagalleryFolder#FOLDER_MENU_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete this?");

			AssertTextEquals(
				locator1 = "PGMediagalleryFolder#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}
	}

	macro viewPG {
		var key_dmFolderName = "${dmFolderName}";

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaFolder#BREADCRUMB_FOLDER",
			value1 = "${dmFolderName}"
		);
	}
}