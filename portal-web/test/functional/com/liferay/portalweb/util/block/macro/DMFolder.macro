<definition>
	<command name="addCP">
		<execute function="AssertClick" locator1="CPDocumentsandmedia#ADD" value1="Add" />
		<execute function="AssertClick" locator1="CPDocumentsandmedia#ADD_MENULIST_FOLDER" value1="Folder" />

		<execute function="Type" locator1="CPDocumentsandmediaAddfolder#NAME_FIELD" value1="${dmFolderName}" />
		<execute function="Type" locator1="CPDocumentsandmediaAddfolder#DESCRIPTION_FIELD" value1="${dmFolderDescription}" />
		<execute function="AssertClick" locator1="CPDocumentsandmediaAddfolder#SAVE_BUTTON" value1="Save" />

		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#REQUEST" value1="Your request completed successfully." />

		<if>
			<condition function="IsElementNotPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER2" />
			<then>
				<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1" />
				<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_TITLE" value1="${dmFolderName}" />
			</then>
			<else>
				<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER2" />
				<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER2_TITLE" value1="${dmFolderName}" />
			</else>
		</if>
	</command>

	<command name="addPG">
		<execute function="AssertClick" locator1="PGDocumentsandmedia#TOOLBAR_ADD" value1="Add" />
		<execute function="AssertClick" locator1="PGDocumentsandmedia#ADD_MENULIST_FOLDER" value1="Folder" />

		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />

				<execute function="Type" locator1="PGDocumentsandmediaAddfolder#NAME_FIELD" value1="${dmFolderName}${number}" />
				<execute function="Type" locator1="PGDocumentsandmediaAddfolder#DESCRIPTION_FIELD" value1="${dmFolderDescription}${number}" />
				<execute function="AssertClick" locator1="PGDocumentsandmediaAddfolder#SAVE_BUTTON" value1="Save" />
			</then>
			<else>
				<execute function="Type" locator1="PGDocumentsandmediaAddfolder#NAME_FIELD" value1="${dmFolderName}" />
				<execute function="Type" locator1="PGDocumentsandmediaAddfolder#DESCRIPTION_FIELD" value1="${dmFolderDescription}" />
				<execute function="AssertClick" locator1="PGDocumentsandmediaAddfolder#SAVE_BUTTON" value1="Save" />
			</else>
		</if>

		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="addPGviaDMD">
		<execute function="AssertClick#assertTextClickAt" locator1="PGDocumentlibrarydisplay#FOLDER_MENU_ADD_FOLDER" value1="Add Folder" />

		<execute function="Type" locator1="PGDocumentlibrarydisplayAddfolder#FOLDER_NAME" value1="${dmdFolderName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="PGDocumentlibrarydisplayAddfolder#SAVE_BUTTON" value1="Save" />

		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplay#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplay#FOLDERS_TABLE_NAME_1" value1="${dmdFolderName}" />
		<execute function="Click" locator1="PGDocumentlibrarydisplay#FOLDERS_TABLE_NAME_1" value1="${dmdFolderName}" />

		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplayFolder#FOLDER_NAME" value1="${dmdFolderName}" />
		<execute function="AssertElementPresent" locator1="PGDocumentlibrarydisplayFolder#ASSET_THUMBNAIL" />
		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplayFolder#ASSET_NAME" value1="${dmdFolderName}" />
		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplayFolder#INFO_MESSAGE" value1="There are no documents or media files in this folder." />
	</command>

	<command name="addPGviaMG">
		<execute function="AssertClick" locator1="PGMediagallery#FOLDER_MENU_ADD_FOLDER" value1="Add Folder" />

		<execute function="Type" locator1="PGMediagalleryAddfolder#NAME_FIELD" value1="${mgFolderName}" />
		<execute function="Type" locator1="PGMediagalleryAddfolder#DESCRIPTION_FIELD" value1="${mgFolderDescription}" />
		<execute function="AssertClick" locator1="PGMediagalleryAddfolder#SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="PGMediagalleryAddfolder#SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<execute function="AssertElementPresent" locator1="PGMediagallery#ENTRY_THUMBNAIL" />
		<execute function="AssertTextEquals" locator1="PGMediagallery#ENTRY_TITLE" value1="${mgFolderName}" />
	</command>

	<command name="deleteCP">
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1" />
		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_TITLE" value1="${dmFolderName}" />
		<execute function="MouseOver" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1" />
		<execute function="Click" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_CHECKBOX" />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#ACTIONS" />
		<execute function="AssertClick" locator1="CPDocumentsandmedia#ACTIONS" value1="Actions" />
		<execute function="AssertClickNoError" locator1="CPDocumentsandmedia#ACTIONS_MENULIST_DELETE" value1="Delete" />
		<execute function="Confirm" value1="Are you sure you want to delete the selected entries?" />
		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#REQUEST" value1="Your request completed successfully." />

		<if>
			<condition function="IsElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1" />
			<then>
				<execute function="AssertTextNotEquals" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_TITLE" value1="${dmFolderName}" />
			</then>
			<else>
				<execute function="AssertElementNotPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1" />
			</else>
		</if>
	</command>

	<command name="deletePG">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="AssertElementPresent" locator1="PGDocumentsandmedia#ENTRIES_FOLDER" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#ENTRIES_FOLDER_TITLE" value1="${dmFolderName}" />
		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER_SELECT" />
		<execute function="AssertClick" locator1="PGDocumentsandmedia#TOOLBAR_ACTIONS" value1="Actions" />
		<execute function="AssertClickNoError" locator1="PGDocumentsandmedia#ACTIONS_MENULIST_DELETE" value1="Delete" />
		<execute function="Confirm" value1="Are you sure you want to delete the selected entries?" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertElementNotPresent" locator1="PGDocumentsandmedia#ENTRIES_FOLDER" />
	</command>

	<command name="editCP">
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1" />
		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_TITLE" value1="${dmFolderName}" />
		<execute function="MouseOver" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1" />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_DROPDOWN" />
		<execute function="Click" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_DROPDOWN" />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#FOLDER_MENULIST_EDIT" />
		<execute function="AssertClick" locator1="CPDocumentsandmedia#FOLDER_MENULIST_EDIT" value1="Edit" />

		<execute function="Type" locator1="CPDocumentsandmediaEditfolder#NAME_FIELD" value1="${dmFolderNameEdit}" />
		<execute function="Type" locator1="CPDocumentsandmediaEditfolder#DESCRIPTION_FIELD" value1="${dmFolderDescriptionEdit}" />
		<execute function="AssertClick" locator1="CPDocumentsandmediaEditfolder#SAVE_BUTTON" value1="Save" />

		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#REQUEST" value1="Your request completed successfully." />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1" />
		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_TITLE" value1="${dmFolderNameEdit}" />
	</command>

	<command name="editPG">
		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#ENTRIES_FOLDER_TITLE" value1="${dmFolderName}" />
		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER_ACTIONS" />
		<execute function="AssertClick" locator1="PGDocumentsandmedia#FOLDER_MENULIST_EDIT" value1="Edit" />

		<execute function="Type" locator1="PGDocumentsandmediaEditfolder#NAME_FIELD" value1="${dmFolderNameEdit}" />
		<execute function="Type" locator1="PGDocumentsandmediaEditfolder#DESCRIPTION_FIELD" value1="${dmFolderDescriptionEdit}" />
		<execute function="AssertClick" locator1="PGDocumentsandmediaEditfolder#SAVE_BUTTON" value1="Save" />

		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#ENTRIES_FOLDER_TITLE" value1="${dmFolderNameEdit}" />
	</command>

	<command name="editPGviaMG">
		<execute function="AssertTextEquals" locator1="PGMediagallery#ENTRY_TITLE" value1="${mgFolderName}" />
		<execute function="AssertClick" locator1="PGMediagallery#ENTRY_TITLE" value1="${mgFolderName}" />

		<execute function="AssertClick" locator1="PGMediagalleryFolder#FOLDER_MENU_EDIT" value1="Edit" />

		<execute function="Type" locator1="PGMediagalleryEditfolder#NAME_FIELD" value1="${mgFolderNameEdit}" />
		<execute function="Type" locator1="PGMediagalleryEditfolder#DESCRIPTION_FIELD" value1="${mgFolderDescriptionEdit}" />
		<execute function="AssertClick" locator1="PGMediagalleryEditfolder#SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="PGMediagalleryEditfolder#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="gotoPG">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER" />
	</command>

	<command name="moveToFolderCP">
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1" />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER2" />
		<execute function="Click" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_DROPDOWN" />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#FOLDER_MENULIST_MOVE" />
		<execute function="AssertClick" locator1="CPDocumentsandmedia#FOLDER_MENULIST_MOVE" value1="Move" />

		<execute function="AssertClick" locator1="CPDocumentsandmediaMovefolder#SELECT_PARENT_FOLDER_BUTTON" value1="Select" />
		<execute function="SelectWindow" locator1="CPDocumentsandmediaMovefolder#FOLDER_WINDOW_ID" />
		<execute function="AssertClick" locator1="CPDocumentsandmediaMovefolder#FOLDER_WINDOW_FOLDER2_CHOOSE_BUTTON" value1="Choose" />
		<execute function="SelectWindow" locator1="null" />
		<execute function="AssertTextEquals" locator1="CPDocumentsandmediaMovefolder#PARENT_FOLDER" value1="${dmFolderName2}" />
		<execute function="AssertClick" locator1="CPDocumentsandmediaMovefolder#MOVE_BUTTON" value1="Move" />

		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#REQUEST" value1="Your request completed successfully." />
		<execute function="AssertElementNotPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER2" />
		<execute function="Click" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1" />
		<!-- <execute function="AssertElementPresent" locator1="CPDocumentsandmedia#FOLDER_VIEW_FOLDER1" /> -->
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<while>
			<condition function="IsElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1" />
			<then>
				<execute function="Select" locator1="CPDocumentsandmedia#PAGINATION_ROWS_PER_PAGE_SELECT" value1="75" />
				<execute function="Check" locator1="CPDocumentsandmedia#SELECT_ALL_ROWS_CHECKBOX" />
				<execute function="AssertClick" locator1="CPDocumentsandmedia#ACTIONS" value1="Actions" />
				<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#ACTIONS_MENULIST_DELETE" />
				<execute function="AssertClickNoError" locator1="CPDocumentsandmedia#ACTIONS_MENULIST_DELETE" value1="Delete" />
				<execute function="Confirm" value1="Are you sure you want to delete the selected entries?" />
				<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#REQUEST" value1="Your request completed successfully." />
			</then>
		</while>
	</command>

	<command name="tearDownPG">
		<execute macro="Page#gotoPG">
			<var name="pageName" value="${pageName}" />
		</execute>

		<if>
			<condition function="IsElementPresent" locator1="PGDocumentsandmedia#TOOLBAR_SELECT_ALL_CHECKBOX" />
			<then>
				<execute function="Check" locator1="PGDocumentsandmedia#TOOLBAR_SELECT_ALL_CHECKBOX" />
				<execute function="AssertClick" locator1="PGDocumentsandmedia#TOOLBAR_ACTIONS" value1="Actions" />
				<execute function="AssertElementPresent" locator1="PGDocumentsandmedia#ACTIONS_MENULIST_DELETE" />
				<execute function="AssertClickNoError" locator1="PGDocumentsandmedia#ACTIONS_MENULIST_DELETE" value1="Delete" />
				<execute function="Confirm" value1="Are you sure you want to delete the selected entries?" />
				<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</if>
	</command>

	<command name="tearDownPGviaDMD">
		<execute macro="Page#gotoPG">
			<var name="pageName" value="${pageName}" />
		</execute>

		<while>
			<condition function="IsElementPresent" locator1="PGDocumentlibrarydisplay#FOLDERS_TABLE_ACTIONS_BUTTON_1" />
			<then>
				<execute function="Click" locator1="PGDocumentlibrarydisplay#FOLDERS_TABLE_ACTIONS_BUTTON_1" />
				<execute function="AssertClickNoError" locator1="PGDocumentlibrarydisplay#FOLDER_MENULIST_DELETE" value1="Delete" />
				<execute function="Confirm" value1="Are you sure you want to delete this?" />
				<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplay#SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</while>
	</command>

	<command name="tearDownPGviaMG" >
		<execute macro="Page#gotoPG">
			<var name="pageName" value="${pageName}" />
		</execute>

		<while>
			<condition function="IsElementPresent" locator1="PGMediagallery#ENTRY_THUMBNAIL" />
			<then>
				<execute function="Click" locator1="PGMediagallery#ENTRY_TITLE" />

				<execute function="AssertClickNoError" locator1="PGMediagalleryFolder#FOLDER_MENU_DELETE" value1="Delete" />
				<execute function="Confirm" value1="Are you sure you want to delete this?" />
				<execute function="AssertTextEquals" locator1="PGMediagalleryFolder#SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</while>
	</command>

	<command name="viewPG">
		<var name="key_dmFolderName" value="${dmFolderName}" />

		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_FOLDER" />

		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaFolder#BREADCRUMB_FOLDER" value1="${dmFolderName}" />
	</command>
</definition>