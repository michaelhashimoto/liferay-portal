<definition>
	<command name="addPG">
		<execute function="#assertClick" locator1="PGBookmarks#HOME_MENU_ADD_FOLDER" value1="Add Folder" />

		<execute function="#type" locator1="PGBookmarksAddfolder#NAME_FIELD" value1="${bookmarkFolderName}" />
		<execute function="#type" locator1="PGBookmarksAddfolder#DESCRIPTION_FIELD" value1="${bookmarkFolderDescription}" />
		<execute function="#assertClick" locator1="PGBookmarksAddfolder#SAVE_BUTTON" value1="Save" />

		<var name="key_folderName" value="${bookmarkFolderName}" />

		<execute function="#assertTextEquals" locator1="PGBookmarks#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="#assertTextEquals" locator1="PGBookmarks#FOLDERS_TABLE_FOLDER_NAME" value1="${bookmarkFolderName}" />
		<execute function="#assertTextEquals" locator1="PGBookmarks#FOLDERS_TABLE_FOLDER_DESCRIPTION" value1="${bookmarkFolderDescription}" />
	</command>

	<command name="deletePG" >
		<var name="key_folderName" value="${bookmarkFolderName}" />

		<execute function="#assertClick" locator1="PGBookmarks#FOLDERS_TABLE_FOLDER_ACTIONS_BUTTON" value1="Actions" />
		<execute function="#assertClickNoError" locator1="PGBookmarks#FOLDER_MENULIST_DELETE" value1="Delete" />
		<execute function="#confirm" locator1="PGBookmarks#CONFIRMATION" value1="Are you sure you want to delete this?" />
		<execute function="#assertTextEquals" locator1="PGBookmarks#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="#assertTextNotPresent" value1="${bookmarkFolderName}" />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Bookmarks" />
		</execute>

		<while>
			<condition function="#isElementPresent" locator1="CPBookmarks#FOLDERS_TABLE_FOLDER_ACTIONS_BUTTON_GENERIC" />
			<then>
				<execute function="#assertClick" locator1="CPBookmarks#FOLDERS_TABLE_FOLDER_ACTIONS_BUTTON_GENERIC" value1="Actions" />
				<execute function="#assertClickNoError" locator1="CPBookmarks#FOLDER_MENULIST_DELETE" value1="Delete" />
				<execute function="#confirm" locator1="CPBookmarks#CONFIRMATION" value1="Are you sure you want to delete this?" />
				<execute function="#assertTextEquals" locator1="CPBookmarks#SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</while>
	</command>
</definition>