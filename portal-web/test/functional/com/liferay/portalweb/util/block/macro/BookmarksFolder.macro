definition {
	macro addPG {
		AssertClick(
			locator1 = "PGBookmarks#HOME_MENU_ADD_FOLDER",
			value1 = "Add Folder"
		);

		Type(
			locator1 = "PGBookmarksAddfolder#NAME_FIELD",
			value1 = "${bookmarkFolderName}"
		);

		Type(
			locator1 = "PGBookmarksAddfolder#DESCRIPTION_FIELD",
			value1 = "${bookmarkFolderDescription}"
		);

		AssertClick(locator1 = "PGBookmarksAddfolder#SAVE_BUTTON", value1 = "Save");

		var key_folderName = "${bookmarkFolderName}";

		AssertTextEquals(
			locator1 = "PGBookmarks#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "PGBookmarks#FOLDERS_TABLE_FOLDER_NAME",
			value1 = "${bookmarkFolderName}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "PGBookmarks#FOLDERS_TABLE_FOLDER_DESCRIPTION",
			value1 = "${bookmarkFolderDescription}"
		);
	}

	macro deletePG {
		var key_folderName = "${bookmarkFolderName}";

		AssertClick(
			locator1 = "PGBookmarks#FOLDERS_TABLE_FOLDER_ACTIONS_BUTTON",
			value1 = "Actions"
		);

		AssertClickNoError(
			locator1 = "PGBookmarks#FOLDER_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextEquals(
			locator1 = "PGBookmarks#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextNotPresent(value1 = "${bookmarkFolderName}");
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Bookmarks");

		while (IsElementPresent(locator1 = "CPBookmarks#FOLDERS_TABLE_FOLDER_ACTIONS_BUTTON_GENERIC")) {
			AssertClick(
				locator1 = "CPBookmarks#FOLDERS_TABLE_FOLDER_ACTIONS_BUTTON_GENERIC",
				value1 = "Actions"
			);

			AssertClickNoError(
				locator1 = "CPBookmarks#FOLDER_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete this?");

			AssertTextEquals(
				locator1 = "CPBookmarks#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}
	}
}