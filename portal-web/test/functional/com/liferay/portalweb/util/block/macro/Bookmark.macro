definition {
	macro addPG {
		var key_bookmarkName = "${bookmarkName}";

		AssertClick(
			locator1 = "PGBookmarks#HOME_MENU_ADD_BOOKMARK",
			value1 = "Add Bookmark"
		);

		Type(locator1 = "PGBookmarksAddbookmark#NAME_FIELD", value1 = "${bookmarkName}");

		Type(locator1 = "PGBookmarksAddbookmark#URL_FIELD", value1 = "${bookmarkURL}");

		if (isSet(bookmarkDescription)) {
			Type(
				locator1 = "PGBookmarksAddbookmark#DESCRIPTION_FIELD",
				value1 = "${bookmarkDescription}"
			);
		}

		AssertClick(locator1 = "PGBookmarksAddbookmark#SAVE_BUTTON", value1 = "Save");

		AssertTextEquals(
			locator1 = "PGBookmarks#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "PGBookmarks#BOOKMARKS_TABLE_NAME",
			value1 = "${bookmarkName}"
		);

		AssertTextEquals(
			locator1 = "PGBookmarks#BOOKMARKS_TABLE_URL",
			value1 = "${bookmarkURL}"
		);
	}

	macro addToFolderPG {
		var key_folderName = "${bookmarkFolderName}";

		AssertClick(
			locator1 = "PGBookmarks#FOLDERS_TABLE_FOLDER_NAME",
			value1 = "${bookmarkFolderName}"
		);

		Bookmark.addPG(bookmarkName = "${bookmarkName}", bookmarkURL = "${bookmarkURL}");
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Bookmarks");

		while (IsElementPresent(locator1 = "CPBookmarks#BOOKMARKS_TABLE_ACTIONS_BUTTON_GENERIC")) {
			AssertClick(
				locator1 = "CPBookmarks#BOOKMARKS_TABLE_ACTIONS_BUTTON_GENERIC",
				value1 = "Actions"
			);

			AssertClick(
				locator1 = "CPBookmarks#BOOKMARK_MENULIST_DELETE",
				value1 = "Delete"
			);

			AssertTextEquals(
				locator1 = "CPBookmarks#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}
	}

	macro viewInFolderPG {
		var key_folderName = "${bookmarkFolderName}";

		AssertClick(
			locator1 = "PGBookmarks#FOLDERS_TABLE_FOLDER_NAME",
			value1 = "${bookmarkFolderName}"
		);

		Bookmark.viewPG(
			bookmarkName = "${bookmarkName}",
			bookmarkURL = "${bookmarkURL}"
		);
	}

	macro viewPG {
		var key_bookmarkName = "${bookmarkName}";

		AssertTextEquals(
			locator1 = "PGBookmarks#BOOKMARKS_TABLE_NAME",
			value1 = "${bookmarkName}"
		);

		AssertTextEquals(
			locator1 = "PGBookmarks#BOOKMARKS_TABLE_URL",
			value1 = "${bookmarkURL}"
		);

		AssertClick(
			locator1 = "PGBookmarks#BOOKMARKS_TABLE_NAME",
			value1 = "${bookmarkName}"
		);

		AssertTextEquals(
			locator1 = "PGBookmarksBookmark#NAME",
			value1 = "${bookmarkName}"
		);

		AssertTextEquals(
			locator1 = "PGBookmarksBookmark#URL",
			value1 = "${bookmarkURL}"
		);

		if (isSet(bookmarkDescription)) {
			AssertTextEquals(
				locator1 = "PGBookmarksBookmark#DESCRIPTION",
				value1 = "${bookmarkDescription}"
			);
		}
	}
}