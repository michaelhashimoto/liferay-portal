definition {
	macro pgAdd {
		AssertClick(locator1 = "PGDocumentsandmedia#TOOLBAR_ADD", value1 = "Add");

		AssertClick(
			locator1 = "PGDocumentsandmedia#ADD_MENULIST_SHORTCUT",
			value1 = "Shortcut"
		);

		Click(locator1 = "PGDocumentsandmediaAddshortcut#SITE_BUTTON");

		Click(locator1 = "PGDocumentsandmediaAddshortcutsites#SITES_GLOBAL_SITE");

		AssertClick(
			locator1 = "PGDocumentsandmediaAddshortcut#SAVE_BUTTON",
			value1 = "Save"
		);
	}
}