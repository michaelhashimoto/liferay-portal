definition {
	macro addCP {
		AssertClick.assertTextClickAt(
			locator1 = "CPWebcontent#NAVIGATION_STRUCTURES",
			value1 = "Structures"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPWebcontentStructures#ADD_STRUCTURE_BUTTON",
			value1 = "Add Structure"
		);

		Type(
			locator1 = "CPWebcontentStructuresAddstructure#NAME_FIELD",
			value1 = "${structureName}"
		);

		Type(
			locator1 = "CPWebcontentStructuresAddstructure#DESCRIPTION_FIELD",
			value1 = "${structureDescription}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPWebcontentStructuresAddstructure#ADD_ROW_BUTTON",
			value1 = "Add Row"
		);

		Type(
			locator1 = "CPWebcontentStructuresAddstructure#ROW_NAME_1",
			value1 = "text"
		);

		Select(
			locator1 = "CPWebcontentStructuresAddstructure#ROW_TYPE_SELECT_1",
			value1 = "Text"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPWebcontentStructuresAddstructure#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPWebcontentStructures#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertElementPresent(locator1 = "CPWebcontentStructures#STRUCTURE_TABLE_ID_1");

		AssertTextEquals(
			locator1 = "CPWebcontentStructures#STRUCTURE_TABLE_NAME_1",
			value1 = "${structureName}"
		);

		AssertTextEquals(
			locator1 = "CPWebcontentStructures#STRUCTURE_TABLE_DESCRIPTION_1",
			value1 = "${structureDescription}"
		);
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Web Content");

		AssertClick.assertTextClickAt(
			locator1 = "CPWebcontent#NAVIGATION_STRUCTURES",
			value1 = "Structures"
		);

		if (IsElementPresent.isVisible(locator1 = "CPWebcontentStructures#STRUCTURE_TABLE_ALL_CHECKBOX")) {
			Check(locator1 = "CPWebcontentStructures#STRUCTURE_TABLE_ALL_CHECKBOX");

			AssertClickNoError(
				locator1 = "CPWebcontentStructures#DELETE_BUTTON",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete the selected structures?");

			AssertTextEquals(
				locator1 = "CPWebcontentStructures#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}

		AssertTextEquals(
			locator1 = "CPWebcontentStructures#INFO_MESSAGE",
			value1 = "No structures were found."
		);
	}
}