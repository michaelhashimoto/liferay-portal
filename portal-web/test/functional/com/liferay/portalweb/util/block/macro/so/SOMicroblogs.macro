definition {
	macro addMicroblogsEntry {
		if ("${microblogsEntryViewableBy}" == "Connections") {
			Select(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_VIEW_FILTER",
				value1 = "Connections"
			);
		}
		else if ("${microblogsEntryViewableBy}" == "Followers") {
			Select(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_VIEW_FILTER",
				value1 = "Followers"
			);
		}
		else {
			Select(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_VIEW_FILTER",
				value1 = "Everyone"
			);
		}

		Click(locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD");

		if (isSet(number)) {
			if (isSet(microblogsEntryCharacterCountdown)) {
				var microblogsEntryCharacterCountdown = "${microblogsEntryCharacterCountdown}";
			}
			else {
				var microblogsEntryCharacterCountdown = "133";
			}

			var number = "${number}";

			Type.sendKeys(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD",
				value1 = "${microblogsEntryContent}${number}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_COUNTDOWN",
				value1 = "${microblogsEntryCharacterCountdown}"
			);

			Click(locator1 = "SOMicroblogs#POST_BUTTON");

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_INCREMENT",
				value1 = "${microblogsEntryContent}${number}"
			);
		}
		else {
			if (isSet(microblogsEntryCharacterCountdown)) {
				var microblogsEntryCharacterCountdown = "${microblogsEntryCharacterCountdown}";
			}
			else {
				var microblogsEntryCharacterCountdown = "135";
			}

			Type.sendKeys(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD",
				value1 = "${microblogsEntryContent}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_COUNTDOWN",
				value1 = "${microblogsEntryCharacterCountdown}"
			);

			Click(locator1 = "SOMicroblogs#POST_BUTTON");

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT",
				value1 = "${microblogsEntryContent}"
			);
		}
	}

	macro addMicroblogsEntryComment {
		if (isSet(microblogsEntryCharacterCountdown)) {
			var microblogsEntryCharacterCountdown = "${microblogsEntryCharacterCountdown}";
		}
		else {
			var microblogsEntryCharacterCountdown = "127";
		}

		SOMicroblogs.viewMicroblogsEntryAuthor();

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT",
			value1 = "${microblogsEntryContent}"
		);

		if (IsElementPresent(locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_FIELD")) {
			AssertClick(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_LINK",
				value1 = "Comment"
			);

			Click(locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_CONTENT_FIELD");

			Click(locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD");

			Type.sendKeys(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD",
				value1 = "${microblogsEntryCommentContent}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_CONTENT_COUNTDOWN",
				value1 = "${microblogsEntryCharacterCountdown}"
			);

			Click(locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_POST_BUTTON");

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_CONTENT",
				value1 = "${microblogsEntryCommentContent}"
			);
		}
		else {
			AssertClick(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_LINK",
				value1 = "Comment"
			);

			Click(locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_FIELD");

			Click(locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD");

			Type.sendKeys(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD",
				value1 = "${microblogsEntryCommentContent}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_COUNTDOWN",
				value1 = "${microblogsEntryCharacterCountdown}"
			);

			Click(locator1 = "SOMicroblogs#POST_BUTTON");

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_CONTENT",
				value1 = "${microblogsEntryCommentContent}"
			);
		}
	}

	macro addMicroblogsEntryCommentMention {
		if (isSet(microblogsEntryCharacterCountdown)) {
			var microblogsEntryCharacterCountdown = "${microblogsEntryCharacterCountdown}";
		}
		else {
			var microblogsEntryCharacterCountdown = "122";
		}

		SOMicroblogs.viewMicroblogsEntryAuthor();

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT",
			value1 = "${microblogsEntryContent}"
		);

		AssertClick(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_LINK",
			value1 = "Comment"
		);

		if (IsElementPresent(locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_CONTENT_FIELD")) {
			Click(locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_CONTENT_FIELD");

			Click(locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD");

			Type.sendKeys(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD",
				value1 = "${microblogsEntryCommentContent} @${mentionUserFirstName}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_AUTOCOMPLETE_USERNAME",
				value1 = "${mentionUserName}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_AUTOCOMPLETE_EMAIL",
				value1 = "${mentionUserEmailAddress}"
			);

			Click(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_AUTOCOMPLETE_USERNAME",
				value1 = "${mentionUserEmailAddress}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_CONTENT_COUNTDOWN",
				value1 = "${microblogsEntryCharacterCountdown}"
			);

			Click(locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_POST_BUTTON");

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_CONTENT",
				value1 = "${microblogsEntryCommentContent} ${mentionUserName}"
			);
		}
		else {
			Click(locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_FIELD");

			Click(locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD");

			Type.sendKeys(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD",
				value1 = "${microblogsEntryCommentContent} @${mentionUserFirstName}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_AUTOCOMPLETE_USERNAME",
				value1 = "${mentionUserName}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_AUTOCOMPLETE_EMAIL",
				value1 = "${mentionUserEmailAddress}"
			);

			Click(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_AUTOCOMPLETE_USERNAME",
				value1 = "${mentionUserEmailAddress}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_COUNTDOWN",
				value1 = "${microblogsEntryCharacterCountdown}"
			);

			Click(locator1 = "SOMicroblogs#POST_BUTTON");

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_CONTENT",
				value1 = "${microblogsEntryCommentContent} ${mentionUserName}"
			);
		}
	}

	macro addMicroblogsEntryHashtag {
		if ("${microblogsEntryViewableBy}" == "Connections") {
			Select(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_VIEW_FILTER",
				value1 = "Connections"
			);
		}
		else if ("${microblogsEntryViewableBy}" == "Followers") {
			Select(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_VIEW_FILTER",
				value1 = "Followers"
			);
		}
		else {
			Select(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_VIEW_FILTER",
				value1 = "Everyone"
			);
		}

		Click(locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD");

		if (isSet(number)) {
			if (isSet(microblogsEntryCharacterCountdown)) {
				var microblogsEntryCharacterCountdown = "${microblogsEntryCharacterCountdown}";
			}
			else {
				var microblogsEntryCharacterCountdown = "132";
			}

			var number = "${number}";

			Type.sendKeys(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD",
				value1 = "#${microblogsEntryContent}${number}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_COUNTDOWN",
				value1 = "${microblogsEntryCharacterCountdown}"
			);

			Click(locator1 = "SOMicroblogs#POST_BUTTON");

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_INCREMENT",
				value1 = "${microblogsEntryContent}${number}"
			);
		}
		else {
			if (isSet(microblogsEntryCharacterCountdown)) {
				var microblogsEntryCharacterCountdown = "${microblogsEntryCharacterCountdown}";
			}
			else {
				var microblogsEntryCharacterCountdown = "134";
			}

			Type.sendKeys(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD",
				value1 = "#${microblogsEntryContent}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_COUNTDOWN",
				value1 = "${microblogsEntryCharacterCountdown}"
			);

			Click(locator1 = "SOMicroblogs#POST_BUTTON");

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT",
				value1 = "${microblogsEntryContent}"
			);
		}
	}

	macro addMicroblogsEntryMention {
		if ("${microblogsEntryViewableBy}" == "Connections") {
			Select(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_VIEW_FILTER",
				value1 = "Connections"
			);
		}
		else if ("${microblogsEntryViewableBy}" == "Followers") {
			Select(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_VIEW_FILTER",
				value1 = "Followers"
			);
		}
		else {
			Select(
				locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_VIEW_FILTER",
				value1 = "Everyone"
			);
		}

		Click(locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD");

		if (isSet(microblogsEntryCharacterCountdown)) {
			var microblogsEntryCharacterCountdown = "${microblogsEntryCharacterCountdown}";
		}
		else {
			var microblogsEntryCharacterCountdown = "141";
		}

		Type.sendKeys(
			locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_INPUT_FIELD",
			value1 = "@${mentionUserFirstName}"
		);

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_AUTOCOMPLETE_USERNAME",
			value1 = "${mentionUserName}"
		);

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_AUTOCOMPLETE_EMAIL",
			value1 = "${mentionUserEmailAddress}"
		);

		Click(
			locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_AUTOCOMPLETE_USERNAME",
			value1 = "${mentionUserEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_COUNTDOWN",
			value1 = "${microblogsEntryCharacterCountdown}"
		);

		Click(locator1 = "SOMicroblogs#POST_BUTTON");

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT",
			value1 = "${mentionUserName}"
		);
	}

	macro deleteMicroblogsEntry {
		MouseOver.makeVisible(locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_EDIT");

		MouseOver.makeVisible(locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_DELETE");

		AssertClickNoError.makeVisibleClick(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_DELETE_LINK",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this post?");
	}

	macro gotoMicroblogsContentField {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MICROBLOGS",
			value1 = "Microblogs"
		);

		if (IsElementNotPresent(locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT")) {
			AssertTextEquals(
				locator1 = "SOMicroblogs#INFO_MESSAGE",
				value1 = "You do not have any microblog entries."
			);
		}

		Click(locator1 = "SOMicroblogs#MICROBLOGS_CONTENT_FIELD");
	}

	macro repostMicroblogsEntry {
		SOMicroblogs.viewMicroblogsEntryViewableByEveryone();

		AssertClick(
			locator1 = "SOProfileMicroblogs#MICROBLOGS_ENTRY_REPOST_LINK",
			value1 = "Repost"
		);

		AssertTextEquals(
			locator1 = "SOProfileMicroblogsRepost#HEADER",
			value1 = "Do you want to repost this entry?"
		);

		if (isSet(microblogsEntryAuthorMiddleName)) {
			AssertTextEquals(
				locator1 = "SOProfileMicroblogs#MICROBLOGS_ENTRY_AUTHOR",
				value1 = "${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SOProfileMicroblogs#MICROBLOGS_ENTRY_AUTHOR",
				value1 = "${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}"
			);
		}

		AssertTextEquals(
			locator1 = "SOProfileMicroblogsRepost#MICROBLOGS_ENTRY_CONTENT",
			value1 = "${microblogsEntryContent}"
		);

		AssertClick(locator1 = "SOProfileMicroblogsRepost#POST_BUTTON", value1 = "Post");

		AssertElementPresent(locator1 = "SOProfile#USER_NAME");
	}

	macro tearDownMicroblogsEntry {
		SOUser.firstLoginPG();

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MICROBLOGS",
			value1 = "Microblogs"
		);

		while (IsElementPresent.pauseIsElementPresent(locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_DELETE_LINK", value1 = "Delete")) {
			MouseOver.makeVisible(locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_EDIT");

			MouseOver.makeVisible(locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_DELETE");

			AssertClickNoError.makeVisibleClick(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_DELETE_LINK",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete this post?");
		}
	}

	macro viewMicroblogsEntryAuthor {
		if (isSet(microblogsEntryRepostAuthorFirstName)) {
			if (isSet(microblogsEntryAuthorMiddleName)) {
				if (isSet(microblogsEntryRepostAuthorMiddleName)) {
					AssertTextEquals.assertPartialText(
						locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_AUTHOR",
						value1 = "${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorMiddleName} ${microblogsEntryRepostAuthorLastName} Reposted From ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}"
					);
				}
				else {
					AssertTextEquals.assertPartialText(
						locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_AUTHOR",
						value1 = "${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorLastName} Reposted From ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}"
					);
				}
			}
			else {
				if (isSet(microblogsEntryRepostAuthorMiddleName)) {
					AssertTextEquals.assertPartialText(
						locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_AUTHOR",
						value1 = "${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorMiddleName} ${microblogsEntryRepostAuthorLastName} Reposted From ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}"
					);
				}
				else {
					AssertTextEquals.assertPartialText(
						locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_AUTHOR",
						value1 = "${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorLastName} Reposted From ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}"
					);
				}
			}
		}
		else {
			if (isSet(microblogsEntryAuthorMiddleName)) {
				AssertTextEquals.assertPartialText(
					locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_AUTHOR",
					value1 = "${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}"
				);
			}
			else {
				AssertTextEquals.assertPartialText(
					locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_AUTHOR",
					value1 = "${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}"
				);
			}
		}
	}

	macro viewMicroblogsEntryComment {
		if ("${commentCount}" == "1") {
			AssertClick(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_LINK",
				value1 = "1 Comment"
			);
		}
		else {
			AssertClick(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_LINK",
				value1 = "${commentCount} Comments"
			);
		}

		if (isSet(microblogsEntryCommentAuthorMiddleName)) {
			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_AUTHOR",
				value1 = "${microblogsEntryCommentAuthorFirstName} ${microblogsEntryCommentAuthorMiddleName} ${microblogsEntryCommentAuthorLastName}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_AUTHOR",
				value1 = "${microblogsEntryCommentAuthorFirstName} ${microblogsEntryCommentAuthorLastName}"
			);
		}

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_CONTENT",
			value1 = "${microblogsEntryCommentContent}"
		);
	}

	macro viewMicroblogsEntryCommentLink {
		if (isSet(commentCount)) {
			if ("${commentCount}" == "1") {
				AssertTextEquals(
					locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_LINK",
					value1 = "1 Comment"
				);
			}
			else {
				AssertTextEquals(
					locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_LINK",
					value1 = "${commentCount} Comments"
				);
			}
		}
		else {
			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_LINK",
				value1 = "Comment"
			);
		}
	}

	macro viewMicroblogsEntryCommentNotification {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertElementPresent.assertElementPresent(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "1");

		MouseOver(locator1 = "SOUserBar#NOTIFICATION");

		if (isSet(microblogsEntryCommentAuthorMiddleName)) {
			AssertTextEquals.assertPartialText(
				locator1 = "SOUserBar#NOTIFICATION_MENU_ENTRY_CONTENT",
				value1 = "${microblogsEntryCommentAuthorFirstName} ${microblogsEntryCommentAuthorMiddleName} ${microblogsEntryCommentAuthorLastName} commented on your post."
			);
		}
		else {
			AssertTextEquals.assertPartialText(
				locator1 = "SOUserBar#NOTIFICATION_MENU_ENTRY_CONTENT",
				value1 = "${microblogsEntryCommentAuthorFirstName} ${microblogsEntryCommentAuthorLastName} commented on your post."
			);
		}

		AssertTextEquals(
			locator1 = "SOUserBar#NOTIFICATION_MENU_ENTRY_SUBCONTENT",
			value1 = "${microblogsEntryCommentContent}"
		);

		AssertClick(
			locator1 = "SOUserBar#NOTIFICATION_MENU_MARK_ALL_AS_READ",
			value1 = "Mark All as Read"
		);

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "0");
	}

	macro viewMicroblogsEntryMention {
		var microblogsEntryContent = "${mentionUserName}";

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		if (IsElementNotPresent(locator1 = "SODashboard#WHATS_HAPPENING_ENTRY_CONTENT")) {
			AssertTextEquals(
				locator1 = "SODashboard#WHATS_HAPPENING_INFO_MESSAGE",
				value1 = "You do not have any microblog entries."
			);
		}

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MICROBLOGS",
			value1 = "Microblogs"
		);

		SOMicroblogs.viewMicroblogsEntryAuthor();

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT",
			value1 = "${microblogsEntryContent}"
		);

		SOMicroblogs.viewMicroblogsEntryCommentLink();

		AssertClick.assertTextClickAt(
			locator1 = "SOMicroblogs#TAB_MENTIONS",
			value1 = "Mentions"
		);

		SOMicroblogs.viewMicroblogsEntryAuthor();

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT",
			value1 = "${microblogsEntryContent}"
		);

		SOMicroblogs.viewMicroblogsEntryCommentLink();

		AssertClick(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_TAG",
			value1 = "${microblogsEntryContent}"
		);

		AssertTextEquals(
			locator1 = "SOProfile#USER_NAME",
			value1 = "${mentionUserName}"
		);

		AssertTextEquals(
			locator1 = "SOProfile#USER_EMAIL",
			value1 = "${mentionUserEmailAddress}"
		);
	}

	macro viewMicroblogsEntryNone {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertClick.assertTextClickAt(
			locator1 = "SOActivities#NAVIGATION_CONNECTIONS",
			value1 = "Connections"
		);

		AssertTextEquals(
			locator1 = "SOActivities#NO_ACTIVITIES",
			value1 = "There are no activities."
		);

		AssertTextNotPresent(value1 = "${microblogsEntryContent}");

		AssertClick.assertTextClickAt(
			locator1 = "SOActivities#NAVIGATION_FOLLOWING",
			value1 = "Following"
		);

		AssertTextEquals(
			locator1 = "SOActivities#NO_ACTIVITIES",
			value1 = "There are no activities."
		);

		AssertTextNotPresent(value1 = "${microblogsEntryContent}");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MICROBLOGS",
			value1 = "Microblogs"
		);

		AssertTextNotPresent(value1 = "${microblogsEntryContent}");
	}

	macro viewMicroblogsEntryNotViewableByEveryone {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertTextEquals(
			locator1 = "SODashboard#WHATS_HAPPENING_INFO_MESSAGE",
			value1 = "You do not have any microblog entries."
		);

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MICROBLOGS",
			value1 = "Microblogs"
		);

		SOMicroblogs.viewMicroblogsEntryAuthor();

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT",
			value1 = "${microblogsEntryContent}"
		);

		SOMicroblogs.viewMicroblogsEntryCommentLink();

		AssertElementNotPresent(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_REPOST_LINK",
			value1 = "Repost"
		);
	}

	macro viewMicroblogsEntryViewableByEveryone {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${microblogsEntryAuthorScreenName}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${microblogsEntryAuthorLastName}, ${microblogsEntryAuthorFirstName}"
		);

		if (isSet(microblogsEntryAuthorMiddleName)) {
			AssertClick.assertTextClickAt(
				locator1 = "SOContactscenter#USER_DETAILS_NAME",
				value1 = "${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}"
			);
		}
		else {
			AssertClick.assertTextClickAt(
				locator1 = "SOContactscenter#USER_DETAILS_NAME",
				value1 = "${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}"
			);
		}

		AssertTextEquals(
			locator1 = "SOProfile#WHATS_HAPPENING_ENTRY_CONTENT",
			value1 = "${microblogsEntryContent}"
		);

		Click(locator1 = "SOProfile#NAVIGATION_MICROBLOGS");

		SOMicroblogs.viewMicroblogsEntryAuthor();

		AssertTextEquals(
			locator1 = "SOProfileMicroblogs#MICROBLOGS_ENTRY_CONTENT",
			value1 = "${microblogsEntryContent}"
		);

		if (isSet(commentCount)) {
			if ("${commentCount}" == "1") {
				AssertTextEquals(
					locator1 = "SOProfileMicroblogs#MICROBLOGS_ENTRY_COMMENT_LINK",
					value1 = "1 Comment"
				);
			}
			else {
				AssertTextEquals(
					locator1 = "SOProfileMicroblogs#MICROBLOGS_ENTRY_COMMENT_LINK",
					value1 = "${commentCount} Comments"
				);
			}
		}
		else {
			AssertTextEquals(
				locator1 = "SOProfileMicroblogs#MICROBLOGS_ENTRY_COMMENT_LINK",
				value1 = "Comment"
			);
		}

		AssertTextEquals(
			locator1 = "SOProfileMicroblogs#MICROBLOGS_ENTRY_REPOST_LINK",
			value1 = "Repost"
		);

		AssertElementNotPresent(
			locator1 = "SOProfileMicroblogs#MICROBLOGS_ENTRY_EDIT_LINK",
			value1 = "Edit"
		);

		AssertElementNotPresent(
			locator1 = "SOProfileMicroblogs#MICROBLOGS_ENTRY_DELETE_LINK",
			value1 = "Delete"
		);
	}

