	macro viewOwnMicroblogsEntryMention {
		var microblogsEntryContent = "${mentionUserName}";

		SOMicroblogs.viewOwnMicroblogsEntry();

		AssertClick(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_TAG",
			value1 = "${mentionUserName}"
		);

		AssertTextEquals(
			locator1 = "SOProfile#USER_NAME",
			value1 = "${mentionUserName}"
		);

		AssertTextEquals(
			locator1 = "SOProfile#USER_EMAIL",
			value1 = "${userEmailAddress}"
		);
	}

	macro viewOwnMicroblogsEntryTag {
		if (isSet(number)) {
			var number = "${number}";

			SOMicroblogs.viewOwnMicroblogsEntry();

			AssertClick(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_TAG",
				value1 = "${microblogsEntryTagValue}"
			);

			SOMicroblogs.viewMicroblogsEntryAuthor();

			AssertTextEquals(
				locator1 = "SOMicroblogs#TAB_TAG_VALUE",
				value1 = "${microblogsEntryTagValue}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_INCREMENT",
				value1 = "${microblogsEntryContent}${number}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_TAG_INCREMENT",
				value1 = "${microblogsEntryTagValue}"
			);

			AssertClick.assertTextClickAt(
				locator1 = "SOMicroblogs#TAB_TAG_VALUE",
				value1 = "${microblogsEntryTagValue}"
			);

			SOMicroblogs.viewMicroblogsEntryAuthor();

			AssertTextEquals(
				locator1 = "SOMicroblogs#TAB_TAG_VALUE",
				value1 = "${microblogsEntryTagValue}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_INCREMENT",
				value1 = "${microblogsEntryContent}${number}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_TAG_INCREMENT",
				value1 = "${microblogsEntryTagValue}"
			);
		}
		else {
			SOMicroblogs.viewOwnMicroblogsEntry();

			AssertClick(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_TAG",
				value1 = "${microblogsEntryTagValue}"
			);

			SOMicroblogs.viewMicroblogsEntryAuthor();

			AssertTextEquals(
				locator1 = "SOMicroblogs#TAB_TAG_VALUE",
				value1 = "${microblogsEntryTagValue}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT",
				value1 = "${microblogsEntryContent}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_TAG",
				value1 = "${microblogsEntryTagValue}"
			);

			AssertClick.assertTextClickAt(
				locator1 = "SOMicroblogs#TAB_TAG_VALUE",
				value1 = "${microblogsEntryTagValue}"
			);

			SOMicroblogs.viewMicroblogsEntryAuthor();

			AssertTextEquals(
				locator1 = "SOMicroblogs#TAB_TAG_VALUE",
				value1 = "${microblogsEntryTagValue}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT",
				value1 = "${microblogsEntryContent}"
			);

			AssertTextEquals(
				locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_TAG",
				value1 = "${microblogsEntryTagValue}"
			);
		}
	}

