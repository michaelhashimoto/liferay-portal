	macro viewMicroblogsActivityEntry {
		if (isSet(row)) {
			var row = "${row}";
		}
		else {
			var row = "01";
		}

		AssertElementPresent(locator1 = "SOActivities#NO_ACTIVITIES");

		if (IsElementPresent(locator1 = "SOActivities#ACTIVITIES_USER_LINK")) {
			AssertTextEquals(
				locator1 = "SOActivities#ACTIVITIES_USER",
				value1 = "${userName}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SOActivities#ACTIVITIES_USER",
				value1 = "${userFirstName}"
			);
		}

		AssertElementPresent(locator1 = "SOActivities#ACTIVITIES_TIME_STAMP");

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_ACTION",
			value1 = "${microblogsEntryContent}"
		);

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_VIEW_MICROBLOGS",
			value1 = "View Microblogs"
		);

		if (IsElementPresent(locator1 = "SOActivities#ACTIVITIES_USER_LINK")) {
			AssertTextEquals(locator1 = "SOActivities#ACTIVITIES_REPOST", value1 = "Repost");
		}

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_COMMENT",
			value1 = "Comment"
		);

		AssertElementPresent(locator1 = "SOActivities#ACTIVITIES_COMMENT_FIELD");
	}

	macro viewMicroblogsActivityEntryProfile {
		if (isSet(row)) {
			var row = "${row}";
		}
		else {
			var row = "01";
		}

		if (isSet(number)) {
			var number = "${number}";
		}
		else {
			var number = "01";
		}

		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_MY_ACCOUNT",
			value1 = "My Account"
		);

		var currentUser = selenium.getText("CPMyAccount#USER_NAME_HEADER");

		if (isSet(profileScreenName)) {
			Open(locator1 = "SOProfile#PROFILE_URL");
		}
		else {
			Click(locator1 = "SOUserBar#USER_NAME");

			AssertClick.assertTextClickAt(
				locator1 = "SOUserBar#USER_MENU_MY_PROFILE",
				value1 = "My Profile"
			);
		}

		AssertElementPresent(locator1 = "SOActivities#NO_ACTIVITIES");

		if (isSet(microblogsEntryAuthorMiddleName)) {
			if ("${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}" == "${currentUser}") {
				AssertTextEquals(
					locator1 = "SOActivities#ACTIVITIES_USER",
					value1 = "${microblogsEntryAuthorFirstName}"
				);
			}
			else {
				AssertTextEquals(
					locator1 = "SOActivities#ACTIVITIES_USER",
					value1 = "${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}"
				);
			}
		}
		else {
			if ("${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}" == "${currentUser}") {
				AssertTextEquals(
					locator1 = "SOActivities#ACTIVITIES_USER",
					value1 = "${microblogsEntryAuthorFirstName}"
				);
			}
			else {
				AssertTextEquals(
					locator1 = "SOActivities#ACTIVITIES_USER",
					value1 = "${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}"
				);
			}
		}

		AssertElementPresent(locator1 = "SOActivities#ACTIVITIES_TIME_STAMP");

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_ACTION",
			value1 = "${microblogsEntryContent}"
		);

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_VIEW_MICROBLOGS",
			value1 = "View Microblogs"
		);

		if (IsElementPresent(locator1 = "SOActivities#ACTIVITIES_USER_LINK")) {
			AssertTextEquals(locator1 = "SOActivities#ACTIVITIES_REPOST", value1 = "Repost");
		}

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_COMMENT",
			value1 = "Comment"
		);

		AssertElementPresent(locator1 = "SOActivities#ACTIVITIES_COMMENT_FIELD");
	}

	macro viewMicroblogsCommentActivityEntry {
		if (isSet(row)) {
			var row = "${row}";
		}
		else {
			var row = "01";
		}

		if (isSet(number)) {
			var number = "${number}";
		}
		else {
			var number = "01";
		}

		AssertElementPresent(locator1 = "SOActivities#NO_ACTIVITIES");

		if (IsElementPresent(locator1 = "SOActivities#ACTIVITIES_USER_LINK")) {
			AssertTextEquals(
				locator1 = "SOActivities#ACTIVITIES_USER",
				value1 = "${userName}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SOActivities#ACTIVITIES_USER",
				value1 = "${userFirstName}"
			);
		}

		AssertElementPresent(locator1 = "SOActivities#ACTIVITIES_TIME_STAMP");

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_ACTION",
			value1 = "Commented on a microblog entry."
		);

		AssertTextEquals.assertPartialText(
			locator1 = "SOActivities#ACTIVITIES_CONTENT",
			value1 = "${microblogsEntryContent}"
		);

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_VIEW_MICROBLOGS",
			value1 = "View Microblogs"
		);

		if (IsElementPresent(locator1 = "SOActivities#ACTIVITIES_USER_LINK")) {
			AssertTextEquals(locator1 = "SOActivities#ACTIVITIES_REPOST", value1 = "Repost");
		}

		if ("${commentCount}" == "1") {
			AssertClick(locator1 = "SOActivities#ACTIVITIES_COMMENT", value1 = "1 Comment");
		}
		else {
			AssertClick(
				locator1 = "SOActivities#ACTIVITIES_COMMENT",
				value1 = "${commentCount} Comments"
			);
		}

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_COMMENT_USER_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_COMMENT_CONTENT",
			value1 = "${microblogsEntryCommentContent}"
		);

		AssertElementPresent(locator1 = "SOActivities#ACTIVITIES_COMMENT_FIELD");
	}

