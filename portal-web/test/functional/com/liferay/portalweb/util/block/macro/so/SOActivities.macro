definition {
	macro addSiteContent {
		Page.gotoPG(pageName = "Calendar", pageType = "Open Site");

		Event.addPG(
			eventDescription = "${eventDescription}",
			eventTitle = "${eventTitle}"
		);

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolder.addPG(
			dmFolderDescription = "${dmFolderDescription}",
			dmFolderName = "${dmFolderName}",
			pageType = "Open Site"
		);

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolderDocument.addPG(
			dmDocumentDescription = "${dmDocumentDescription}",
			dmDocumentFile = "${dmDocumentFile}",
			dmDocumentTitle = "${dmDocumentTitle}",
			dmFolderName = "${dmFolderName}"
		);

		Page.gotoPG(pageName = "Forums", pageType = "Open Site");

		MessageboardsCategory.addPG(categoryName = "${categoryName}");

		Page.gotoPG(pageName = "Forums", pageType = "Open Site");

		MessageboardsCategory.gotoPG(categoryName = "${categoryName}");

		MessageboardsThread.addPG();

		Page.gotoPG(pageName = "Blogs", pageType = "Open Site");

		BlogsEntry.addPG();

		Page.gotoPG(pageName = "Wiki", pageType = "Open Site");

		if (!(isSet(wikiEditOnly))) {
			WikiPage.addFrontPagePG(
				pageName = "Wiki",
				wikiPageContent = "${wikiPageContent}"
			);
		}

		WikiPage.editFrontPagePG(
			pageName = "Wiki",
			pageType = "Open Site",
			wikiPageContentEdit = "${wikiPageContentEdit}"
		);

		Page.openURL(pageType = "Open Site");

		SOBookmarks.addBookmarksEntry(
			bookmarksEntryDescription = "${bookmarksEntryDescription}",
			bookmarksEntryName = "${bookmarksEntryName}",
			bookmarksEntryUrl = "${bookmarksEntryUrl}"
		);
	}

	macro viewBlogsActivityEntry {
		if (isSet(row)) {
			var row = "${row}";
		}
		else {
			var row = "01";
		}

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_USER",
			value1 = "${userName}"
		);

		AssertElementPresent(locator1 = "SOActivities#ACTIVITIES_TIME_STAMP");

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_ACTION",
			value1 = "${action}"
		);

		if (isSet(number)) {
			var number = "${number}";

			AssertTextEquals(
				locator1 = "SOActivities#ACTIVITIES_TITLE",
				value1 = "${entryTitle}${number}"
			);

			AssertTextEquals.assertPartialText(
				locator1 = "SOActivities#ACTIVITIES_CONTENT",
				value1 = "${entryContent}${number}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SOActivities#ACTIVITIES_TITLE",
				value1 = "${entryTitle}"
			);

			AssertTextEquals.assertPartialText(
				locator1 = "SOActivities#ACTIVITIES_CONTENT",
				value1 = "${entryContent}"
			);
		}

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_COMMENT",
			value1 = "Comment"
		);

		AssertElementPresent(locator1 = "SOActivities#ACTIVITIES_COMMENT_FIELD");
	}

