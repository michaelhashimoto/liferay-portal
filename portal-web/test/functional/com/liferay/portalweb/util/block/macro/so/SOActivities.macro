	macro viewMicroblogsRepostActivityEntry {
		if (isSet(row)) {
			var row = "${row}";
		}
		else {
			var row = "01";
		}

		if (isSet(number)) {
			var number = "${number}";
		}
		else {
			var number = "01";
		}

		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_MY_ACCOUNT",
			value1 = "My Account"
		);

		var currentUser = selenium.getText("CPMyAccount#USER_NAME_HEADER");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertElementPresent(locator1 = "SOActivities#NO_ACTIVITIES");

		if (IsElementPresent(locator1 = "SOActivities#ACTIVITIES_USER_LINK")) {
			if (isSet(microblogsEntryRepostAuthorMiddleName)) {
				AssertTextEquals(
					locator1 = "SOActivities#ACTIVITIES_USER",
					value1 = "${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorMiddleName} ${microblogsEntryRepostAuthorLastName}"
				);
			}
			else {
				AssertTextEquals(
					locator1 = "SOActivities#ACTIVITIES_USER",
					value1 = "${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorLastName}"
				);
			}
		}
		else {
			AssertTextEquals(
				locator1 = "SOActivities#ACTIVITIES_USER",
				value1 = "${microblogsEntryRepostAuthorFirstName}"
			);
		}

		AssertElementPresent(locator1 = "SOActivities#ACTIVITIES_TIME_STAMP");

		if (isSet(microblogsEntryRepostAuthorMiddleName)) {
			if ("${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorMiddleName} ${microblogsEntryRepostAuthorLastName}" == "${currentUser}") {
				if (isSet(microblogsEntryAuthorMiddleName)) {
					AssertTextEquals(
						locator1 = "SOActivities#ACTIVITIES_ACTION",
						value1 = "Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}."
					);
				}
				else {
					AssertTextEquals(
						locator1 = "SOActivities#ACTIVITIES_ACTION",
						value1 = "Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}."
					);
				}
			}
			else {
				if (isSet(microblogsEntryAuthorMiddleName)) {
					if ("${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}" == "${currentUser}") {
						AssertTextEquals(
							locator1 = "SOActivities#ACTIVITIES_ACTION",
							value1 = "${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorMiddleName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName}."
						);
					}
					else {
						AssertTextEquals(
							locator1 = "SOActivities#ACTIVITIES_ACTION",
							value1 = "${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorMiddleName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}."
						);
					}
				}
				else {
					if ("${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}" == "${currentUser}") {
						AssertTextEquals(
							locator1 = "SOActivities#ACTIVITIES_ACTION",
							value1 = "${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorMiddleName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName}."
						);
					}
					else {
						AssertTextEquals(
							locator1 = "SOActivities#ACTIVITIES_ACTION",
							value1 = "${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorMiddleName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}."
						);
					}
				}
			}
		}
		else {
			if ("${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorLastName}" == "${currentUser}") {
				if (isSet(microblogsEntryAuthorMiddleName)) {
					AssertTextEquals(
						locator1 = "SOActivities#ACTIVITIES_ACTION",
						value1 = "Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}."
					);
				}
				else {
					AssertTextEquals(
						locator1 = "SOActivities#ACTIVITIES_ACTION",
						value1 = "Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}."
					);
				}
			}
			else {
				if (isSet(microblogsEntryAuthorMiddleName)) {
					if ("${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}" == "${currentUser}") {
						AssertTextEquals(
							locator1 = "SOActivities#ACTIVITIES_ACTION",
							value1 = "${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName}."
						);
					}
					else {
						AssertTextEquals(
							locator1 = "SOActivities#ACTIVITIES_ACTION",
							value1 = "${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}."
						);
					}
				}
				else {
					if ("${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}" == "${currentUser}") {
						AssertTextEquals(
							locator1 = "SOActivities#ACTIVITIES_ACTION",
							value1 = "${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName}."
						);
					}
					else {
						AssertTextEquals(
							locator1 = "SOActivities#ACTIVITIES_ACTION",
							value1 = "${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}."
						);
					}
				}
			}
		}

		AssertTextEquals.assertPartialText(
			locator1 = "SOActivities#ACTIVITIES_CONTENT",
			value1 = "${microblogsEntryContent}"
		);

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_VIEW_MICROBLOGS",
			value1 = "View Microblogs"
		);

		if (IsElementPresent(locator1 = "SOActivities#ACTIVITIES_USER_LINK")) {
			AssertTextEquals(locator1 = "SOActivities#ACTIVITIES_REPOST", value1 = "Repost");
		}

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_COMMENT",
			value1 = "Comment"
		);

		AssertElementPresent(locator1 = "SOActivities#ACTIVITIES_COMMENT_FIELD");
	}

	macro viewMicroblogsRepostActivityEntryProfile {
		if (isSet(row)) {
			var row = "${row}";
		}
		else {
			var row = "01";
		}

		if (isSet(number)) {
			var number = "${number}";
		}
		else {
			var number = "01";
		}

		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_MY_ACCOUNT",
			value1 = "My Account"
		);

		var currentUser = selenium.getText("CPMyAccount#USER_NAME_HEADER");

		if (isSet(profileScreenName)) {
			Open(locator1 = "SOProfile#PROFILE_URL");
		}
		else {
			Click(locator1 = "SOUserBar#USER_NAME");

			AssertClick.assertTextClickAt(
