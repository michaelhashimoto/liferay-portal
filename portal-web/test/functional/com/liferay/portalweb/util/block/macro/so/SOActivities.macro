	macro viewMultipleDocumentsActivityEntry {
		if (isSet(row)) {
			var row = "${row}";
		}
		else {
			var row = "01";
		}

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_USER",
			value1 = "${userName}"
		);

		AssertElementPresent(locator1 = "SOActivities#ACTIVITIES_TIME_STAMP");

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_ACTION",
			value1 = "${documentsAction}"
		);

		var stopAtNumber = MathUtil.sum("${number}", "1");

		while (!("${documentTitleRow}" == "${stopAtNumber}")) {
			AssertTextEquals(
				locator1 = "SOActivities#ACTIVITIES_DOCUMENT_TITLE_INCREMENT",
				value1 = "${dmDocumentTitle}${documentTitleRow}"
			);

			AssertTextEquals(
				locator1 = "SOActivities#ACTIVITIES_DOCUMENT_DESCRIPTION_INCREMENT",
				value1 = "${dmDocumentDescription}${documentTitleRow}"
			);

			var documentTitleRow = MathUtil.sum("${documentTitleRow}", "1");
		}

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_COMMENT",
			value1 = "Comment"
		);

		AssertElementPresent(locator1 = "SOActivities#ACTIVITIES_COMMENT_FIELD");
	}

	macro viewSiteContent {
		SOActivities.viewBookmarksActivityEntry(action = "${bookmarkAction}");

		SOActivities.viewWikiActivityEntry(action = "${wikiAction}", row = "02");

		SOActivities.viewBlogsActivityEntry(action = "${blogsAction}", row = "03");

		SOActivities.viewForumsActivityEntry(action = "${forumsAction}", row = "04");

		SOActivities.viewDocumentsActivityEntry(
			action = "${documentsAction}",
			row = "05"
		);

		SOActivities.viewCalendarActivityEntry(action = "${calendarAction}", row = "06");
	}

	macro viewWikiActivityEntry {
		if (isSet(row)) {
			var row = "${row}";
		}
		else {
			var row = "01";
		}

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_USER",
			value1 = "${userName}"
		);

		AssertElementPresent(locator1 = "SOActivities#ACTIVITIES_TIME_STAMP");

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_ACTION",
			value1 = "${action}"
		);

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_TITLE",
			value1 = "${wikiPageTitle}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "SOActivities#ACTIVITIES_CONTENT",
			value1 = "${wikiPageContent}"
		);

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_VIEW_CHANGES",
			value1 = "View Changes"
		);

		AssertTextEquals(
			locator1 = "SOActivities#ACTIVITIES_COMMENT",
			value1 = "Comment"
		);

		AssertElementPresent(locator1 = "SOActivities#ACTIVITIES_COMMENT_FIELD");
	}
