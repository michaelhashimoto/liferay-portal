<definition>
	<command name="addPG">
		<execute function="AssertClick#assertTextClickAt" locator1="PGAnnouncements#NAVIGATION_MANAGE_ENTRIES" value1="Manage Entries" />

		<execute function="Select" locator1="PGAnnouncementsManageentries#DISTRIBUTION_SCOPE_SELECT" value1="${distributionScope}" />
		<execute function="AssertClick#assertValueClickAt" locator1="PGAnnouncementsManageentries#ADD_ENTRY_BUTTON" value1="Add Entry" />

		<execute function="Type" locator1="PGAnnouncementsAddentry#TITLE_FIELD" value1="${entryTitle}" />
		<execute function="Type#typeCKEditorWaitForCKEditor" locator1="PGAnnouncementsAddentry#CONTENT_FIELD" value1="${entryContent}" />
		<execute function="Type" locator1="PGAnnouncementsAddentry#URL_FIELD" value1="${entryURL}" />
		<execute function="AssertClick#assertValueClickAt" locator1="PGAnnouncementsAddentry#SAVE_BUTTON" value1="Save" />
	</command>

	<command name="deletePG">
		<execute function="AssertTextEquals" locator1="PGAnnouncements#ENTRY_TITLE_1" value1="${entryTitle}" />
		<execute function="AssertTextEquals" locator1="PGAnnouncements#ENTRY_CONTENT_1" value1="${distributionScope} ${entryContent}" />
		<execute function="AssertClickNoError" locator1="PGAnnouncements#ENTRY_DELETE_1" value1="Delete" />
		<execute function="Confirm" value1="Are you sure you want to delete this?" />
		<execute function="AssertTextNotPresent" value1="{entryTitle}" />
		<execute function="AssertTextNotPresent" value1="{entryContent}" />
	</command>

	<command name="editPG">
		<execute function="AssertTextEquals" locator1="PGAnnouncements#ENTRY_TITLE_1" value1="${entryTitle}" />
		<execute function="AssertTextEquals" locator1="PGAnnouncements#ENTRY_CONTENT_1" value1="${distributionScope} ${entryContent}" />
		<execute function="AssertClick" locator1="PGAnnouncements#ENTRY_EDIT_1" value1="Edit" />

		<execute function="Type" locator1="PGAnnouncementsAddentry#TITLE_FIELD" value1="${entryTitleEdit}" />
		<execute function="Type" locator1="PGAnnouncementsAddentry#URL_FIELD" value1="${entryURLEdit}" />
		<execute function="Type#typeCKEditorWaitForCKEditor" locator1="PGAnnouncementsAddentry#CONTENT_FIELD" value1="${entryContentEdit}" />
		<execute function="AssertClick#assertValueClickAt" locator1="PGAnnouncementsAddentry#SAVE_BUTTON" value1="Save" />
	</command>

	<command name="tearDownPG">
		<execute macro="Page#gotoPG">
			<var name="pageName" value="${pageName}" />
		</execute>

		<while>
			<condition function="IsElementPresent" locator1="PGAnnouncements#ENTRY_DELETE_1" />
			<then>
				<execute function="AssertClickNoError" locator1="PGAnnouncements#ENTRY_DELETE_1" value1="Delete" />
				<execute function="Confirm" value1="Are you sure you want to delete this?" />
			</then>
		</while>
	</command>

	<command name="viewPG">
		<execute function="AssertTextEquals" locator1="PGAnnouncements#ENTRY_TITLE_1" value1="${entryTitle}" />
		<execute function="AssertTextEquals" locator1="PGAnnouncements#ENTRY_SCOPE_1" value1="${distributionScope}" />
		<execute function="AssertTextEquals" locator1="PGAnnouncements#ENTRY_CONTENT_1" value1="${distributionScope} ${entryContent}" />
		<execute function="AssertClick#assertTextClickAt" locator1="PGAnnouncements#NAVIGATION_MANAGE_ENTRIES" value1="Manage Entries" />

		<execute function="Select" locator1="PGAnnouncementsManageentries#DISTRIBUTION_SCOPE_SELECT" value1="${distributionScope}" />
		<execute function="AssertTextEquals" locator1="PGAnnouncementsManageentries#ENTRY_TABLE_TITLE_1" value1="${entryTitle}" />
		<execute function="AssertTextEquals" locator1="PGAnnouncementsManageentries#ENTRY_TABLE_TYPE_1" value1="${distributionScope}" />
	</command>
</definition>