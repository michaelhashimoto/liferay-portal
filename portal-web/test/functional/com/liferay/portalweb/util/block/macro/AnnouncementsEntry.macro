definition {
	macro addPG {
		AssertClick.assertTextClickAt(
			locator1 = "PGAnnouncements#NAVIGATION_MANAGE_ENTRIES",
			value1 = "Manage Entries"
		);

		Select(
			locator1 = "PGAnnouncementsManageentries#DISTRIBUTION_SCOPE_SELECT",
			value1 = "${distributionScope}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGAnnouncementsManageentries#ADD_ENTRY_BUTTON",
			value1 = "Add Entry"
		);

		Type(locator1 = "PGAnnouncementsAddentry#TITLE_FIELD", value1 = "${entryTitle}");

		SelectFrame(locator1 = "PGAnnouncementsAddentry#CONTENT_FIELD");

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "PGAnnouncementsAddentry#CONTENT_FIELD",
			value1 = "${entryContent}"
		);

		Type(locator1 = "PGAnnouncementsAddentry#URL_FIELD", value1 = "${entryURL}");

		AssertClick.assertValueClickAt(
			locator1 = "PGAnnouncementsAddentry#SAVE_BUTTON",
			value1 = "Save"
		);
	}

	macro deletePG {
		AssertTextEquals(
			locator1 = "PGAnnouncements#ENTRY_TITLE_1",
			value1 = "${entryTitle}"
		);

		AssertTextEquals(
			locator1 = "PGAnnouncements#ENTRY_CONTENT_1",
			value1 = "${distributionScope} ${entryContent}"
		);

		AssertClickNoError(
			locator1 = "PGAnnouncements#ENTRY_DELETE_1",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextNotPresent(value1 = "{entryTitle}");

		AssertTextNotPresent(value1 = "{entryContent}");
	}

	macro editPG {
		AssertTextEquals(
			locator1 = "PGAnnouncements#ENTRY_TITLE_1",
			value1 = "${entryTitle}"
		);

		AssertTextEquals(
			locator1 = "PGAnnouncements#ENTRY_CONTENT_1",
			value1 = "${distributionScope} ${entryContent}"
		);

		AssertClick(locator1 = "PGAnnouncements#ENTRY_EDIT_1", value1 = "Edit");

		Type(
			locator1 = "PGAnnouncementsAddentry#TITLE_FIELD",
			value1 = "${entryTitleEdit}"
		);

		Type(locator1 = "PGAnnouncementsAddentry#URL_FIELD", value1 = "${entryURLEdit}");

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "PGAnnouncementsAddentry#CONTENT_FIELD",
			value1 = "${entryContentEdit}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGAnnouncementsAddentry#SAVE_BUTTON",
			value1 = "Save"
		);
	}

	macro tearDownPG {
		Page.gotoPG(pageName = "${pageName}");

		while (IsElementPresent(locator1 = "PGAnnouncements#ENTRY_DELETE_1")) {
			AssertClickNoError(
				locator1 = "PGAnnouncements#ENTRY_DELETE_1",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete this?");
		}
	}

	macro viewPG {
		AssertTextEquals(
			locator1 = "PGAnnouncements#ENTRY_TITLE_1",
			value1 = "${entryTitle}"
		);

		AssertTextEquals(
			locator1 = "PGAnnouncements#ENTRY_SCOPE_1",
			value1 = "${distributionScope}"
		);

		AssertTextEquals(
			locator1 = "PGAnnouncements#ENTRY_CONTENT_1",
			value1 = "${distributionScope} ${entryContent}"
		);

		AssertClick.assertTextClickAt(
			locator1 = "PGAnnouncements#NAVIGATION_MANAGE_ENTRIES",
			value1 = "Manage Entries"
		);

		Select(
			locator1 = "PGAnnouncementsManageentries#DISTRIBUTION_SCOPE_SELECT",
			value1 = "${distributionScope}"
		);

		AssertTextEquals(
			locator1 = "PGAnnouncementsManageentries#ENTRY_TABLE_TITLE_1",
			value1 = "${entryTitle}"
		);

		AssertTextEquals(
			locator1 = "PGAnnouncementsManageentries#ENTRY_TABLE_TYPE_1",
			value1 = "${distributionScope}"
		);
	}
}