<definition>
	<command name="addPG" summary="Add a page named '${pageName}'">
		<execute macro="Page#openURL" />

		<if>
			<condition function="IsElementPresent" locator1="SOUserBar#USER_BAR" />
			<then>
				<if>
					<condition function="IsElementNotPresent" locator1="SOUserBar#VISIBLE_DOCKBAR" />
					<then>
						<execute function="Click" locator1="SOUserBar#TOGGLE_DOCKBAR" />
					</then>
				</if>
			</then>
		</if>

		<execute function="MouseOver#textMouseOverClickDockbar" locator1="Dockbar#ADD" value1="Add" />
		<execute function="AssertClick#assertTextClickAt" locator1="Dockbar#ADD_PAGE" value1="Page" />

		<execute function="Type" locator1="Home#NEW_PAGE_FIELD" value1="${pageName}" />
		<execute function="Click" locator1="Home#NEW_PAGE_SAVE" />

		<var name="key_pageName" value="${pageName}" />

		<execute function="Click" locator1="Home#PAGE" value1="${pageName}" />
	</command>

	<command name="addPGWithWorkflow">
		<execute macro="Page#openURL" />

		<execute function="MouseOver#textMouseOverClickDockbar" locator1="Dockbar#ADD" value1="Add" />
		<execute function="Click" locator1="Dockbar#ADD_PAGE" />

		<execute function="Type" locator1="Home#NEW_PAGE_FIELD" value1="${pageName}" />
		<execute function="Click" locator1="Home#NEW_PAGE_SAVE" />

		<var name="key_pageName" value="${pageName}" />

		<execute function="Click" locator1="Home#PAGE" value1="${pageName}" />

		<execute function="AssertClick" locator1="Staging#LAYOUT_REVISION_SUBMIT_FOR_PUBLICATION_BUTTON" value1="Submit for Publication" />
		<execute function="AssertTextEquals" locator1="Staging#LAYOUT_REVISION_WORKFLOW_STATUS" value1="Pending (Review)" />
	</command>

	<command name="gotoCP" summary="Navigate to Go to > Control Panel > ${portletName}">
		<execute macro="Page#openURL" />

		<execute function="MouseOver#textMouseOverClickDockbar" locator1="Dockbar#GO_TO" value1="Go to" />
		<execute function="AssertClick#assertTextClickAt" locator1="Dockbar#GO_TO_CONTROL_PANEL" value1="Control Panel" />

		<if>
			<isset var="siteScopeName" />
			<then>
				<execute function="Click" locator1="Home#SCOPE_SELECTOR" />

				<var name="key_siteScopeName" value="${siteScopeName}" />

				<execute function="Click" locator1="Home#SCOPE_SELECTOR_MENULIST_ITEM" />
			</then>
		</if>

		<if>
			<equals arg1="${portletName}" arg2="Workflow" />
			<then>
				<execute function="Click" locator1="xPath=(//ul[@class='category-portlets']/li/a[contains(.,'${portletName}')])[3]" />
			</then>
			<else>
				<execute function="Click" locator1="//ul[@class='category-portlets']/li/a[contains(.,'${portletName}')]" />
			</else>
		</if>
	</command>

	<command name="gotoPG" summary="Navigate to the page named '${pageName}'">
		<execute macro="Page#openURL" />

		<execute function="Click" locator1="Home#PAGE" value1="${pageName}">
			<var name="key_pageName" value="${pageName}" />
		</execute>
	</command>

	<command name="isPresent">
		<execute macro="Page#openURL" />

		<var name="key_pageName" value="${pageName}" />

		<execute function="IsElementPresent" locator1="Home#PAGE" value1="${pageName}" />
	</command>

	<command name="openURL">
		<if>
			<equals arg1="${pageAccess}" arg2="Private" />
			<then>
				<var name="pageAccessURL" value="/group" />
			</then>
			<else>
				<var name="pageAccessURL" value="/web" />
			</else>
		</if>

		<if>
			<equals arg1="${pageType}" arg2="Open Site" />
			<then>
				<var name="pageTypeURL" value="/open-site-name" />
			</then>
			<elseif>
				<equals arg1="${pageType}" arg2="Organization" />
				<then>
					<var name="pageTypeURL" value="/organization-name" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${pageType}" arg2="Site" />
				<then>
					<var name="pageTypeURL" value="/site-name" />
				</then>
			</elseif>
			<else>
				<var name="pageTypeURL" value="/guest" />
			</else>
		</if>

		<if>
			<equals arg1="${pageStaging}" arg2="true" />
			<then>
				<var name="pageStagingURL" value="-staging" />
			</then>
			<else>
				<var name="pageStagingURL" value="" />
			</else>
		</if>

		<execute function="Open" locator1="${pageAccessURL}${pageTypeURL}${pageStagingURL}" />
	</command>

	<command name="tearDownPG">
		<description message="Delete all pages except the Welcome Page." />

		<execute macro="Page#openURL" />

		<while>
			<condition function="IsElementPresent#isElementPresentClickNavigation" locator1="Home#PAGE_2" />
			<then>
				<execute function="MouseOver#mouseOverClickNavigation" locator1="Home#PAGE_2" />
				<execute function="AssertClickNoError" locator1="Home#PAGE_DELETE_2" value1="X" />
				<execute function="Confirm#waitForConfirmation" value1="Are you sure you want to delete this page?" />
				<execute function="AssertElementNotPresent" locator1="Home#PAGE_DELETE_2" />
			</then>
		</while>
	</command>

	<command name="viewPG">
		<execute macro="Page#gotoPG" />

		<execute function="AssertTextEquals" locator1="Home#BREADCRUMB_3" value1="${pageName}" />
	</command>

	<command name="viewPGWithWorkflow">
		<execute macro="Page#gotoPG" />

		<execute function="AssertTextEquals" locator1="Home#BREADCRUMB_3" value1="${pageName}" />

		<execute function="AssertTextEquals" locator1="Staging#LAYOUT_REVISION_WORKFLOW_STATUS" value1="${workflowStatus}" />
		<execute function="AssertClick" locator1="Staging#LIVE_BUTTON" value1="Live" />

		<var name="key_pageName" value="${pageName}" />

		<execute function="AssertElementNotPresent" locator1="Home#PAGE" value1="${pageName}" />
	</command>
</definition>