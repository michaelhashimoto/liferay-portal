definition {
	@summary = "Add a page named '${pageName}'"
	macro addPG {
		Page.openURL();

		if (IsElementPresent(locator1 = "SOUserBar#USER_BAR")) {
			if (IsElementNotPresent(locator1 = "SOUserBar#VISIBLE_DOCKBAR")) {
				Click(locator1 = "SOUserBar#TOGGLE_DOCKBAR");
			}
		}

		MouseOver.textMouseOverClickDockbar(locator1 = "Dockbar#ADD", value1 = "Add");

		AssertClick.assertTextClickAt(locator1 = "Dockbar#ADD_PAGE", value1 = "Page");

		Type(locator1 = "Home#NEW_PAGE_FIELD", value1 = "${pageName}");

		Click(locator1 = "Home#NEW_PAGE_SAVE");

		var key_pageName = "${pageName}";

		Click(locator1 = "Home#PAGE", value1 = "${pageName}");
	}

	macro addPGWithWorkflow {
		Page.openURL();

		MouseOver.textMouseOverClickDockbar(locator1 = "Dockbar#ADD", value1 = "Add");

		Click(locator1 = "Dockbar#ADD_PAGE");

		Type(locator1 = "Home#NEW_PAGE_FIELD", value1 = "${pageName}");

		Click(locator1 = "Home#NEW_PAGE_SAVE");

		var key_pageName = "${pageName}";

		Click(locator1 = "Home#PAGE", value1 = "${pageName}");

		AssertClick(
			locator1 = "Staging#LAYOUT_REVISION_SUBMIT_FOR_PUBLICATION_BUTTON",
			value1 = "Submit for Publication"
		);

		AssertTextEquals(
			locator1 = "Staging#LAYOUT_REVISION_WORKFLOW_STATUS",
			value1 = "Pending (Review)"
		);
	}

	@summary = "Navigate to Go to > Control Panel > ${portletName}"
	macro gotoCP {
		Page.openURL();

		MouseOver.textMouseOverClickDockbar(
			locator1 = "Dockbar#GO_TO",
			value1 = "Go to"
		);

		AssertClick.assertTextClickAt(
			locator1 = "Dockbar#GO_TO_CONTROL_PANEL",
			value1 = "Control Panel"
		);

		if (isSet(siteScopeName)) {
			Click(locator1 = "Home#SCOPE_SELECTOR");

			var key_siteScopeName = "${siteScopeName}";

			Click(locator1 = "Home#SCOPE_SELECTOR_MENULIST_ITEM");
		}

		if ("${portletName}" == "Workflow") {
			Click(
				locator1 = "xPath=(//ul[@class='category-portlets']/li/a[contains(.,'${portletName}')])[3]"
			);
		}
		else {
			Click(
				locator1 = "//ul[@class='category-portlets']/li/a[contains(.,'${portletName}')]"
			);
		}
	}

	@summary = "Navigate to the page named '${pageName}'"
	macro gotoPG {
		Page.openURL(
			pageAccess = "${pageAccess}",
			pageStaging = "${pageStaging}",
			pageType = "${pageType}"
		);

		Click(
			locator1 = "Home#PAGE",
			value1 = "${pageName}",
			key_pageName = "${pageName}"
		);
	}

	macro isPresent {
		Page.openURL();

		var key_pageName = "${pageName}";

		IsElementPresent(locator1 = "Home#PAGE", value1 = "${pageName}");
	}

	macro openURL {
		if ("${pageAccess}" == "Private") {
			var pageAccessURL = "/group";
		}
		else {
			var pageAccessURL = "/web";
		}

		if ("${pageType}" == "Open Site") {
			var pageTypeURL = "/open-site-name";
		}
		else if ("${pageType}" == "Organization") {
			var pageTypeURL = "/organization-name";
		}
		else if ("${pageType}" == "Site") {
			var pageTypeURL = "/site-name";
		}
		else {
			var pageTypeURL = "/guest";
		}

		if ("${pageStaging}" == "true") {
			var pageStagingURL = "-staging";
		}
		else {
			var pageStagingURL = "";
		}

		Open(locator1 = "${pageAccessURL}${pageTypeURL}${pageStagingURL}");
	}

	@description = "Delete all pages except the Welcome Page."
	macro tearDownPG {
		Page.openURL();

		while (IsElementPresent.isElementPresentClickNavigation(locator1 = "Home#PAGE_2")) {
			MouseOver.mouseOverClickNavigation(locator1 = "Home#PAGE_2");

			AssertClickNoError(locator1 = "Home#PAGE_DELETE_2", value1 = "X");

			Confirm.waitForConfirmation(
				value1 = "Are you sure you want to delete this page?"
			);

			AssertElementNotPresent(locator1 = "Home#PAGE_DELETE_2");
		}
	}

	macro viewPG {
		Page.gotoPG();

		AssertTextEquals(locator1 = "Home#BREADCRUMB_3", value1 = "${pageName}");
	}

	macro viewPGWithWorkflow {
		Page.gotoPG();

		AssertTextEquals(locator1 = "Home#BREADCRUMB_3", value1 = "${pageName}");

		AssertTextEquals(
			locator1 = "Staging#LAYOUT_REVISION_WORKFLOW_STATUS",
			value1 = "${workflowStatus}"
		);

		AssertClick(locator1 = "Staging#LIVE_BUTTON", value1 = "Live");

		var key_pageName = "${pageName}";

		AssertElementNotPresent(locator1 = "Home#PAGE", value1 = "${pageName}");
	}
}