definition {
	var adminEmailAddress = "test@liferay.com";
	var adminListName = "Bloggs, Joe";
	var adminName = "Joe Bloggs";
	var password = "test";

	macro addConnection {
		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOContactsCenter.requestToConnect(
			userEmailAddress = "${userEmailAddress}",
			userListName = "${userListName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOContactsCenter.confirmRequestToConnect(
			senderName = "${adminName}",
			userName = "${userName}"
		);
	}

	macro addContact {
		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		AssertClick(
			locator1 = "SOContactscenter#ADD_CONTACT_BUTTON",
			value1 = "Add Contact"
		);

		Type(
			locator1 = "SOContactscenterAddcontact#NAME_FIELD",
			value1 = "${contactName}"
		);

		Type(
			locator1 = "SOContactscenterAddcontact#EMAIL_ADDRESS_FIELD",
			value1 = "${contactEmailAddress}"
		);

		Type(
			locator1 = "SOContactscenterAddcontact#COMMENTS_FIELD",
			value1 = "${contactName} Comments"
		);

		Click.pauseClickAt(locator1 = "SOContactscenterAddcontact#SAVE_BUTTON");

		AssertTextEquals(
			locator1 = "SOContactscenter#SUCCESS_MESSAGE",
			value1 = "You have successfully added a new contact."
		);
	}

	macro addFollower {
		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOContactsCenter.followUser(
			adminEmailAddress = "${adminEmailAddress}",
			adminListName = "${adminListName}",
			adminName = "${adminName}"
		);
	}

	macro confirmRequestToConnect {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertElementPresent.assertElementPresent(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "1");

		MouseOver(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals(
			locator1 = "SOUserBar#NOTIFICATION_MENU_ENTRY_SENDER",
			value1 = "${senderName}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "SOUserBar#NOTIFICATION_MENU_ENTRY_CONTENT",
			value1 = "would like to add you as a connection."
		);

		AssertTextEquals(
			locator1 = "SOUserBar#NOTIFICATION_MENU_CONFIRM",
			value1 = "Confirm"
		);

		Click(locator1 = "SOUserBar#NOTIFICATION_MENU_CONFIRM");

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "0");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LINK_CONNECTIONS",
			value1 = "You have 1 connections."
		);
	}

	macro disconnectFromConnection {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${userScreenName}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_EMAIL",
			value1 = "${userEmailAddress}"
		);

		Click(locator1 = "SOContactscenter#DISCONNECT_BUTTON", value1 = "Disconnect");

		AssertElementNotPresent.assertNotVisible(
			locator1 = "SOContactscenter#DISCONNECT_BUTTON"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#SUCCESS_MESSAGE",
			value1 = "You are not connected to this user anymore."
		);
	}

	macro followUser {
		SOUserBar.dashboardPG(userName = "${userName}");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${adminName}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${adminListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_NAME",
			value1 = "${adminName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_EMAIL",
			value1 = "${adminEmailAddress}"
		);

		AssertClick(locator1 = "SOContactscenter#FOLLOW_BUTTON", value1 = "Follow");

		AssertTextEquals(
			locator1 = "SOContactscenter#FOLLOWING_MESSAGE",
			value1 = "Following"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#UNFOLLOW_BUTTON",
			value1 = "Unfollow"
		);
	}

	macro gotoProfile {
		SOUserBar.dashboardPG(userName = "${userName}");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${userScreenName}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);
	}

	macro ignoreRequestToConnect {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertElementPresent.assertElementPresent(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "1");

		MouseOver(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals(
			locator1 = "SOUserBar#NOTIFICATION_MENU_ENTRY_SENDER",
			value1 = "${senderName}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "SOUserBar#NOTIFICATION_MENU_ENTRY_CONTENT",
			value1 = "would like to add you as a connection."
		);

		AssertTextEquals(
			locator1 = "SOUserBar#NOTIFICATION_MENU_IGNORE",
			value1 = "Ignore"
		);

		Click(locator1 = "SOUserBar#NOTIFICATION_MENU_IGNORE");

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "0");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LINK_CONNECTIONS",
			value1 = "You have 0 connections."
		);
	}

	macro requestToConnect {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${userScreenName}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_EMAIL",
			value1 = "${userEmailAddress}"
		);

		AssertClick(locator1 = "SOContactscenter#CONNECT_BUTTON", value1 = "Connect");

		AssertTextEquals(
			locator1 = "SOContactscenter#CONNECTION_REQUESTED_MESSAGE",
			value1 = "Connection Requested"
		);

		AssertElementNotPresent.assertNotVisible(
			locator1 = "SOContactscenter#CONNECT_BUTTON",
			value1 = "Connect"
		);
	}

	macro sendMessage {
		var connectionName = "${userName}";
		var key_recipientName = "${userName}";
		var recipientName = "${userName}";
		var recipientScreenName = "${userScreenName}";

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${userScreenName}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_EMAIL",
			value1 = "${userEmailAddress}"
		);

		AssertClick(locator1 = "SOContactscenter#MESSAGE_BUTTON", value1 = "Message");

		AssertTextEquals(
			locator1 = "SOMessagesAdd#TO_FIELD",
			value1 = "${recipientName}<${recipientScreenName}>,"
		);

		if (isSet(number)) {
			Type(
				locator1 = "SOMessagesAdd#SUBJECT_FIELD",
				value1 = "${messageSubject}${number}"
			);

			Type(locator1 = "SOMessagesAdd#BODY_FIELD", value1 = "${messageBody}${number}");
		}
		else {
			Type(locator1 = "SOMessagesAdd#SUBJECT_FIELD", value1 = "${messageSubject}");

			Type(locator1 = "SOMessagesAdd#BODY_FIELD", value1 = "${messageBody}");
		}

		if (isSet(messageAttachmentFile)) {
			UploadCommonFile(
				locator1 = "SOMessagesAdd#ATTACHMENTS_FIELD",
				value1 = "${messageAttachmentFile}"
			);
		}

		Click(locator1 = "SOMessagesAdd#SEND_BUTTON");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		SOMessages.viewMessageList();
	}

	macro tearDownContacts {
		SOUser.firstLoginPG();

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Select(
			locator1 = "SOContactscenter#CONTACTS_LIST_FILTER",
			value1 = "My Contacts"
		);

		Pause(value1 = "1000");

		while (IsElementPresent(locator1 = "SOContactscenter#CONTACTS_LIST_NAME")) {
			var contactName = selenium.getText("SOContactscenter#CONTACTS_LIST_NAME");

			Click(locator1 = "SOContactscenter#CONTACTS_LIST_NAME");

			Click(locator1 = "SOContactscenter#CONTACTS_LIST_NAME");

			AssertClickNoError(
				locator1 = "SOContactscenter#DELETE_BUTTON",
				value1 = "Delete"
			);

			Confirm(
				value1 = "Are you sure you want to delete ${contactName} from your contacts?"
			);

			Select(
				locator1 = "SOContactscenter#CONTACTS_LIST_FILTER",
				value1 = "My Contacts"
			);

			Pause(value1 = "1000");
		}
	}

	macro unfollowUser {
		SOUserBar.dashboardPG(userName = "${userName}");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${adminName}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${adminListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_NAME",
			value1 = "${adminName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_EMAIL",
			value1 = "${adminEmailAddress}"
		);

		AssertClick(locator1 = "SOContactscenter#UNFOLLOW_BUTTON", value1 = "Unfollow");

		AssertTextEquals(
			locator1 = "SOContactscenter#SUCCESS_MESSAGE",
			value1 = "You are not following this user anymore."
		);

		AssertTextEquals(locator1 = "SOContactscenter#FOLLOW_BUTTON", value1 = "Follow");
	}

	macro viewContact {
		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${contactName}"
		);

		Pause(value1 = "1000");

		AssertClick.pauseAssertTextClickAt(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${contactName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACT_DETAILS_NAME",
			value1 = "${contactName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACT_DETAILS_EMAIL",
			value1 = "${contactEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACT_DETAILS_COMMENTS",
			value1 = "${contactName} Comments"
		);
	}
}