<definition>
	<var name="adminEmailAddress" value="test@liferay.com" />
	<var name="adminListName" value="Bloggs, Joe" />
	<var name="adminName" value="Joe Bloggs" />
	<var name="password" value="test" />

	<command name="addConnection">
		<execute macro="SOUser#addUserWithSORole">
			<var name="adminEmailAddress" value="test@liferay.com" />
			<var name="password" value="test" />
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="userFirstName" value="${userFirstName}" />
			<var name="userLastName" value="${userLastName}" />
			<var name="userMiddleName" value="${userMiddleName}" />
			<var name="userScreenName" value="${userScreenName}" />
		</execute>

		<execute macro="SOContactsCenter#requestToConnect">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="userListName" value="${userListName}" />
			<var name="userName" value="${userName}" />
			<var name="userScreenName" value="${userScreenName}" />
		</execute>

		<execute macro="SOUser#logoutPG" />

		<execute macro="SOUser#loginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="${userEmailAddress}" />
		</execute>

		<execute macro="SOContactsCenter#confirmRequestToConnect">
			<var name="senderName" value="${adminName}" />
			<var name="userName" value="${userName}" />
		</execute>
	</command>

	<command name="addContact">
		<execute macro="SOUserBar#dashboardPG">
			<var name="userName" value="Joe Bloggs" />
		</execute>

		<execute function="Click#textClickAt" locator1="SODashboard#NAVIGATION_CONTACTS_CENTER" value1="Contacts Center" />

		<execute function="AssertClick" locator1="SOContactscenter#ADD_CONTACT_BUTTON" value1="Add Contact" />

		<execute function="Type" locator1="SOContactscenterAddcontact#NAME_FIELD" value1="${contactName}" />
		<execute function="Type" locator1="SOContactscenterAddcontact#EMAIL_ADDRESS_FIELD" value1="${contactEmailAddress}" />
		<execute function="Type" locator1="SOContactscenterAddcontact#COMMENTS_FIELD" value1="${contactName} Comments" />
		<execute function="Click#pauseClickAt" locator1="SOContactscenterAddcontact#SAVE_BUTTON" />

		<execute function="AssertTextEquals" locator1="SOContactscenter#SUCCESS_MESSAGE" value1="You have successfully added a new contact." />
	</command>

	<command name="addFollower">
		<execute macro="SOUser#addUserWithSORole">
			<var name="adminEmailAddress" value="test@liferay.com" />
			<var name="password" value="test" />
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="userFirstName" value="${userFirstName}" />
			<var name="userLastName" value="${userLastName}" />
			<var name="userMiddleName" value="${userMiddleName}" />
			<var name="userScreenName" value="${userScreenName}" />
		</execute>

		<execute macro="SOUser#logoutPG" />

		<execute macro="SOUser#loginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="${userEmailAddress}" />
		</execute>

		<execute macro="SOContactsCenter#followUser">
			<var name="adminEmailAddress" value="${adminEmailAddress}" />
			<var name="adminListName" value="${adminListName}" />
			<var name="adminName" value="${adminName}" />
		</execute>
	</command>

	<command name="confirmRequestToConnect">
		<execute function="Click#textClickAt" locator1="SOUserBar#DASHBOARD" value1="Dashboard" />
		<execute function="AssertElementPresent#assertElementPresent" locator1="SOUserBar#NOTIFICATION" />
		<execute function="AssertTextEquals" locator1="SOUserBar#NOTIFICATION_MENU_COUNT" value1="1" />
		<execute function="MouseOver" locator1="SOUserBar#NOTIFICATION" />
		<execute function="AssertTextEquals" locator1="SOUserBar#NOTIFICATION_MENU_ENTRY_SENDER" value1="${senderName}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SOUserBar#NOTIFICATION_MENU_ENTRY_CONTENT" value1="would like to add you as a connection." />
		<execute function="AssertTextEquals" locator1="SOUserBar#NOTIFICATION_MENU_CONFIRM" value1="Confirm" />
		<execute function="Click" locator1="SOUserBar#NOTIFICATION_MENU_CONFIRM" />
		<execute function="AssertTextEquals" locator1="SOUserBar#NOTIFICATION_MENU_COUNT" value1="0" />

		<execute function="Click#textClickAt" locator1="SODashboard#NAVIGATION_CONTACTS_CENTER" value1="Contacts Center" />

		<execute function="AssertTextEquals" locator1="SOContactscenter#CONTACTS_LINK_CONNECTIONS" value1="You have 1 connections." />
	</command>

	<command name="disconnectFromConnection">
		<execute function="Click#textClickAt" locator1="SOUserBar#DASHBOARD" value1="Dashboard" />

		<execute function="Click#textClickAt" locator1="SODashboard#NAVIGATION_CONTACTS_CENTER" value1="Contacts Center" />

		<execute function="Type" locator1="SOContactscenter#CONTACTS_LIST_SEARCH" value1="${userScreenName}" />
		<execute function="AssertClick#pauseAssertTextClickAt" locator1="SOContactscenter#CONTACTS_LIST_NAME" value1="${userListName}" />

		<execute function="AssertTextEquals" locator1="SOContactscenter#USER_DETAILS_NAME" value1="${userName}" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#USER_DETAILS_EMAIL" value1="${userEmailAddress}" />
		<execute function="Click" locator1="SOContactscenter#DISCONNECT_BUTTON" value1="Disconnect" />
		<execute function="AssertElementNotPresent#assertNotVisible" locator1="SOContactscenter#DISCONNECT_BUTTON" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#SUCCESS_MESSAGE" value1="You are not connected to this user anymore." />
	</command>

	<command name="followUser">
		<execute macro="SOUserBar#dashboardPG">
			<var name="userName" value="${userName}" />
		</execute>

		<execute function="Click#textClickAt" locator1="SODashboard#NAVIGATION_CONTACTS_CENTER" value1="Contacts Center" />

		<execute function="Type" locator1="SOContactscenter#CONTACTS_LIST_SEARCH" value1="${adminName}" />
		<execute function="AssertClick#pauseAssertTextClickAt" locator1="SOContactscenter#CONTACTS_LIST_NAME" value1="${adminListName}" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#USER_DETAILS_NAME" value1="${adminName}" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#USER_DETAILS_EMAIL" value1="${adminEmailAddress}" />
		<execute function="AssertClick" locator1="SOContactscenter#FOLLOW_BUTTON" value1="Follow" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#FOLLOWING_MESSAGE" value1="Following" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#UNFOLLOW_BUTTON" value1="Unfollow" />
	</command>

	<command name="gotoProfile">
		<execute macro="SOUserBar#dashboardPG">
			<var name="userName" value="${userName}" />
		</execute>

		<execute function="Click#textClickAt" locator1="SODashboard#NAVIGATION_CONTACTS_CENTER" value1="Contacts Center" />

		<execute function="Type" locator1="SOContactscenter#CONTACTS_LIST_SEARCH" value1="${userScreenName}" />
		<execute function="AssertClick#pauseAssertTextClickAt" locator1="SOContactscenter#CONTACTS_LIST_NAME" value1="${userListName}" />
	</command>

	<command name="ignoreRequestToConnect">
		<execute function="Click#textClickAt" locator1="SOUserBar#DASHBOARD" value1="Dashboard" />
		<execute function="AssertElementPresent#assertElementPresent" locator1="SOUserBar#NOTIFICATION" />
		<execute function="AssertTextEquals" locator1="SOUserBar#NOTIFICATION_MENU_COUNT" value1="1" />
		<execute function="MouseOver" locator1="SOUserBar#NOTIFICATION" />
		<execute function="AssertTextEquals" locator1="SOUserBar#NOTIFICATION_MENU_ENTRY_SENDER" value1="${senderName}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SOUserBar#NOTIFICATION_MENU_ENTRY_CONTENT" value1="would like to add you as a connection." />
		<execute function="AssertTextEquals" locator1="SOUserBar#NOTIFICATION_MENU_IGNORE" value1="Ignore" />
		<execute function="Click" locator1="SOUserBar#NOTIFICATION_MENU_IGNORE" />
		<execute function="AssertTextEquals" locator1="SOUserBar#NOTIFICATION_MENU_COUNT" value1="0" />

		<execute function="Click#textClickAt" locator1="SODashboard#NAVIGATION_CONTACTS_CENTER" value1="Contacts Center" />

		<execute function="AssertTextEquals" locator1="SOContactscenter#CONTACTS_LINK_CONNECTIONS" value1="You have 0 connections." />
	</command>

	<command name="requestToConnect">
		<execute function="Click#textClickAt" locator1="SOUserBar#DASHBOARD" value1="Dashboard" />

		<execute function="Click#textClickAt" locator1="SODashboard#NAVIGATION_CONTACTS_CENTER" value1="Contacts Center" />

		<execute function="Type" locator1="SOContactscenter#CONTACTS_LIST_SEARCH" value1="${userScreenName}" />
		<execute function="AssertClick#pauseAssertTextClickAt" locator1="SOContactscenter#CONTACTS_LIST_NAME" value1="${userListName}" />

		<execute function="AssertTextEquals" locator1="SOContactscenter#USER_DETAILS_NAME" value1="${userName}" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#USER_DETAILS_EMAIL" value1="${userEmailAddress}" />
		<execute function="AssertClick" locator1="SOContactscenter#CONNECT_BUTTON" value1="Connect" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#CONNECTION_REQUESTED_MESSAGE" value1="Connection Requested" />
		<execute function="AssertElementNotPresent#assertNotVisible" locator1="SOContactscenter#CONNECT_BUTTON" value1="Connect" />
	</command>

	<command name="sendMessage">
		<var name="connectionName" value="${userName}" />
		<var name="key_recipientName" value="${userName}" />
		<var name="recipientName" value="${userName}" />
		<var name="recipientScreenName" value="${userScreenName}" />

		<execute function="Click#textClickAt" locator1="SOUserBar#DASHBOARD" value1="Dashboard" />

		<execute function="Click#textClickAt" locator1="SODashboard#NAVIGATION_CONTACTS_CENTER" value1="Contacts Center" />

		<execute function="Type" locator1="SOContactscenter#CONTACTS_LIST_SEARCH" value1="${userScreenName}" />
		<execute function="AssertClick#pauseAssertTextClickAt" locator1="SOContactscenter#CONTACTS_LIST_NAME" value1="${userListName}" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#USER_DETAILS_NAME" value1="${userName}" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#USER_DETAILS_EMAIL" value1="${userEmailAddress}" />
		<execute function="AssertClick" locator1="SOContactscenter#MESSAGE_BUTTON" value1="Message" />

		<execute function="AssertTextEquals" locator1="SOMessagesAdd#TO_FIELD" value1="${recipientName} &lt;${recipientScreenName}&gt;," />

		<if>
			<isset var="number" />
			<then>
				<execute function="Type" locator1="SOMessagesAdd#SUBJECT_FIELD" value1="${messageSubject}${number}" />
				<execute function="Type" locator1="SOMessagesAdd#BODY_FIELD" value1="${messageBody}${number}" />
			</then>
			<else>
				<execute function="Type" locator1="SOMessagesAdd#SUBJECT_FIELD" value1="${messageSubject}" />
				<execute function="Type" locator1="SOMessagesAdd#BODY_FIELD" value1="${messageBody}" />
			</else>
		</if>

		<if>
			<isset var="messageAttachmentFile" />
			<then>
				<execute function="UploadCommonFile" locator1="SOMessagesAdd#ATTACHMENTS_FIELD" value1="${messageAttachmentFile}" />
			</then>
		</if>

		<execute function="Click" locator1="SOMessagesAdd#SEND_BUTTON" />

		<execute function="Click#textClickAt" locator1="SODashboard#NAVIGATION_MESSAGES" value1="Messages" />

		<execute macro="SOMessages#viewMessageList" />
	</command>

	<command name="tearDownContacts">
		<execute macro="SOUser#firstLoginPG" />

		<execute function="Click#textClickAt" locator1="SOUserBar#DASHBOARD" value1="Dashboard" />

		<execute function="Click#textClickAt" locator1="SODashboard#NAVIGATION_CONTACTS_CENTER" value1="Contacts Center" />

		<execute function="Select" locator1="SOContactscenter#CONTACTS_LIST_FILTER" value1="My Contacts" />
		<execute function="Pause" value1="1000" />

		<while>
			<condition function="IsElementPresent" locator1="SOContactscenter#CONTACTS_LIST_NAME" />
			<then>
				<var method="selenium#getText('SOContactscenter#CONTACTS_LIST_NAME')" name="contactName" />

				<execute function="Click" locator1="SOContactscenter#CONTACTS_LIST_NAME" />
				<execute function="Click" locator1="SOContactscenter#CONTACTS_LIST_NAME" />
				<execute function="AssertClickNoError" locator1="SOContactscenter#DELETE_BUTTON" value1="Delete" />
				<execute function="Confirm" value1="Are you sure you want to delete ${contactName} from your contacts?" />
				<execute function="Select" locator1="SOContactscenter#CONTACTS_LIST_FILTER" value1="My Contacts" />
				<execute function="Pause" value1="1000" />
			</then>
		</while>
	</command>

	<command name="unfollowUser">
		<execute macro="SOUserBar#dashboardPG">
			<var name="userName" value="${userName}" />
		</execute>

		<execute function="Click#textClickAt" locator1="SODashboard#NAVIGATION_CONTACTS_CENTER" value1="Contacts Center" />

		<execute function="Type" locator1="SOContactscenter#CONTACTS_LIST_SEARCH" value1="${adminName}" />
		<execute function="AssertClick#pauseAssertTextClickAt" locator1="SOContactscenter#CONTACTS_LIST_NAME" value1="${adminListName}" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#USER_DETAILS_NAME" value1="${adminName}" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#USER_DETAILS_EMAIL" value1="${adminEmailAddress}" />
		<execute function="AssertClick" locator1="SOContactscenter#UNFOLLOW_BUTTON" value1="Unfollow" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#SUCCESS_MESSAGE" value1="You are not following this user anymore." />
		<execute function="AssertTextEquals" locator1="SOContactscenter#FOLLOW_BUTTON" value1="Follow" />
	</command>

	<command name="viewContact">
		<execute macro="SOUserBar#dashboardPG">
			<var name="userName" value="Joe Bloggs" />
		</execute>

		<execute function="Click#textClickAt" locator1="SODashboard#NAVIGATION_CONTACTS_CENTER" value1="Contacts Center" />

		<execute function="Type" locator1="SOContactscenter#CONTACTS_LIST_SEARCH" value1="${contactName}" />
		<execute function="Pause" value1="1000" />
		<execute function="AssertClick#pauseAssertTextClickAt" locator1="SOContactscenter#CONTACTS_LIST_NAME" value1="${contactName}" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#CONTACT_DETAILS_NAME" value1="${contactName}" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#CONTACT_DETAILS_EMAIL" value1="${contactEmailAddress}" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#CONTACT_DETAILS_COMMENTS" value1="${contactName} Comments" />
	</command>
</definition>