<definition>
	<command name="gotoDashboardTasks">
		<execute action="SOUserBar#click" locator1="DASHBOARD" />

		<execute action="SODashboard#assertClick" locator1="NAVIGATION_TASKS" value1="Tasks" />
	</command>

	<command name="gotoSiteDocuments">
		<execute macro="Page#openURL" />

		<execute action="SOSiteHome#click" locator1="NAVIGATION_DOCUMENTS" value1="Documents" />
	</command>
</definition>