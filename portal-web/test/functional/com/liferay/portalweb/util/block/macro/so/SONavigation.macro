definition {
	macro gotoDashboardTasks {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertClick(locator1 = "SODashboard#NAVIGATION_TASKS", value1 = "Tasks");
	}

	macro gotoSiteDocuments {
		Page.openURL();

		Click.textClickAt(
			locator1 = "SOSiteHome#NAVIGATION_DOCUMENTS",
			value1 = "Documents"
		);
	}
}