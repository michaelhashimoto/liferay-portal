definition {
	macro addCP {
		Type(locator1 = "CPUsersandorganizations#SEARCH_FIELD", value1 = "${orgName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPUsersandorganizations#SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizations#ORGANIZATION_TABLE_NAME_1",
			value1 = "${orgName}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "CPUsersandorganizations#ORGANIZATION_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClick(
			locator1 = "CPUsersandorganizations#ORGANIZATION_MENULIST_ADD_REGULAR_ORGANIZATION",
			value1 = "Add Regular Organization"
		);

		Type(
			locator1 = "CPUsersandorganizationsAddorganization#DETAILS_NAME_FIELD",
			value1 = "${suborgName}"
		);

		Select(
			locator1 = "CPUsersandorganizationsAddorganization#DETAILS_TYPE_SELECT",
			value1 = "${suborgType}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPUsersandorganizationsAddorganization#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsOrganizationEdit#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsOrganizationEdit#DETAILS_NAME_FIELD",
			value1 = "${suborgName}"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsOrganizationEdit#DETAILS_TYPE",
			value1 = "Type ${suborgType}"
		);
	}

	macro tearDownCP {
		Organization.tearDownCP(orgName = "Suborganization*");
	}

	macro viewCP {
		Organization.viewCP(
			orgName = "${suborgName}",
			orgType = "${suborgType}",
			searchToken = "${suborgSearchName}"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsOrganizationEdit#DETAILS_PARENT_ORGANIZATION_TABLE_NAME",
			value1 = "${orgName}"
		);

		AssertTextEquals(
			locator1 = "CPUsersandorganizationsOrganizationEdit#DETAILS_PARENT_ORGANIZATION_TABLE_TYPE",
			value1 = "${orgType}"
		);
	}
}