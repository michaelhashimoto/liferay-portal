<definition>
	<command name="addCP">
		<execute function="Type" locator1="CPUsersandorganizations#SEARCH_FIELD" value1="${orgName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPUsersandorganizations#SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizations#ORGANIZATION_TABLE_NAME_1" value1="${orgName}" />
		<execute function="AssertClick#pauseAssertTextClickAt" locator1="CPUsersandorganizations#ORGANIZATION_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="AssertClick" locator1="CPUsersandorganizations#ORGANIZATION_MENULIST_ADD_REGULAR_ORGANIZATION" value1="Add Regular Organization" />

		<execute function="Type" locator1="CPUsersandorganizationsAddorganization#DETAILS_NAME_FIELD" value1="${suborgName}" />
		<execute function="Select" locator1="CPUsersandorganizationsAddorganization#DETAILS_TYPE_SELECT" value1="${suborgType}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPUsersandorganizationsAddorganization#SAVE_BUTTON" value1="Save" />

		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsOrganizationEdit#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsOrganizationEdit#DETAILS_NAME_FIELD" value1="${suborgName}" />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsOrganizationEdit#DETAILS_TYPE" value1="Type ${suborgType}" />
	</command>

	<command name="tearDownCP">
		<execute macro="Organization#tearDownCP">
			<var name="orgName" value="Suborganization*" />
		</execute>
	</command>

	<command name="viewCP">
		<execute macro="Organization#viewCP">
			<var name="orgName" value="${suborgName}" />
			<var name="orgType" value="${suborgType}" />
			<var name="searchToken" value="${suborgSearchName}" />
		</execute>

		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsOrganizationEdit#DETAILS_PARENT_ORGANIZATION_TABLE_NAME" value1="${orgName}" />
		<execute function="AssertTextEquals" locator1="CPUsersandorganizationsOrganizationEdit#DETAILS_PARENT_ORGANIZATION_TABLE_TYPE" value1="${orgType}" />
	</command>
</definition>