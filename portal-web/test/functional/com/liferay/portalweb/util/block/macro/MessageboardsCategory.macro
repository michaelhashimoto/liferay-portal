definition {
	macro addPG {
		AssertClick.assertValueClickAt(
			locator1 = "PGMessageboards#ADD_CATEGORY_BUTTON",
			value1 = "Add Category"
		);

		if (isSet(number)) {
			var number = "${number}";

			Type(
				locator1 = "PGMessageboardsAddcategory#NAME_FIELD",
				value1 = "${categoryName}${number}"
			);

			AssertClick.assertValueClickAt(
				locator1 = "PGMessageboardsAddcategory#SAVE_BUTTON",
				value1 = "Save"
			);
		}
		else {
			Type(
				locator1 = "PGMessageboardsAddcategory#NAME_FIELD",
				value1 = "${categoryName}"
			);

			AssertClick.assertValueClickAt(
				locator1 = "PGMessageboardsAddcategory#SAVE_BUTTON",
				value1 = "Save"
			);
		}

		AssertTextEquals(
			locator1 = "PGMessageboards#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro deletePG {
		var key_categoryName = "${categoryName}";

		AssertTextEquals(
			locator1 = "PGMessageboards#CATEGORY_TABLE_CATEGORY",
			value1 = "${categoryName}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "PGMessageboards#CATEGORY_TABLE_ACTIONS",
			value1 = "Actions"
		);

		AssertClickNoError(
			locator1 = "PGMessageboards#CATEGORY_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextEquals(
			locator1 = "PGMessageboards#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextNotPresent(value1 = "${categoryName}");
	}

	macro editPG {
		var key_categoryName = "${categoryName}";

		AssertTextEquals(
			locator1 = "PGMessageboards#CATEGORY_TABLE_CATEGORY",
			value1 = "${categoryName}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "PGMessageboards#CATEGORY_TABLE_ACTIONS",
			value1 = "Actions"
		);

		AssertClick(
			locator1 = "PGMessageboards#CATEGORY_MENULIST_EDIT",
			value1 = "Edit"
		);

		Type(
			locator1 = "PGMessageboardsAddcategory#NAME_FIELD",
			value1 = "${categoryNameEdit}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGMessageboardsAddcategory#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "PGMessageboards#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		var key_categoryName = "${categoryNameEdit}";

		AssertTextEquals(
			locator1 = "PGMessageboards#CATEGORY_TABLE_CATEGORY",
			value1 = "${categoryNameEdit}"
		);
	}

	macro gotoPG {
		var key_categoryName = "${categoryName}";

		if (isSet(number)) {
			var number = "${number}";

			AssertClick(
				locator1 = "PGMessageboards#CATEGORY_TABLE_CATEGORY_INCREMENT",
				value1 = "${categoryName}${number}"
			);
		}
		else {
			AssertClick(
				locator1 = "PGMessageboards#CATEGORY_TABLE_CATEGORY",
				value1 = "${categoryName}"
			);
		}
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Message Boards");

		if (IsElementPresent(locator1 = "CPMessageboards#CATEGORY_TABLE_ALL_CHECKBOX")) {
			Check(locator1 = "CPMessageboards#CATEGORY_TABLE_ALL_CHECKBOX");

			AssertClickNoError(
				locator1 = "CPMessageboards#CATEGORIES_DELETE_BUTTON",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete this?");
		}
	}

	macro viewPG {
		var key_categoryName = "${categoryName}";

		AssertTextEquals(
			locator1 = "PGMessageboards#CATEGORY_TABLE_CATEGORIES",
			value1 = "0"
		);

		AssertTextEquals(
			locator1 = "PGMessageboards#CATEGORY_TABLE_THREADS",
			value1 = "0"
		);

		AssertTextEquals(
			locator1 = "PGMessageboards#CATEGORY_TABLE_POSTS",
			value1 = "0"
		);

		AssertClick(
			locator1 = "PGMessageboards#CATEGORY_TABLE_CATEGORY",
			value1 = "${categoryName}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboardsCategory#NAME_HEADER",
			value1 = "${categoryName}"
		);
	}
}