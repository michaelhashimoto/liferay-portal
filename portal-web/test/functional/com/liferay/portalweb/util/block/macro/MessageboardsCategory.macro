<definition>
	<command name="addPG">
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="PGMessageboards#ADD_CATEGORY_BUTTON" value1="Add Category" />

		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />

				<execute function="#type" locator1="PGMessageboardsAddcategory#NAME_FIELD" value1="${categoryName}${number}" />
				<execute function="AssertClick#assertValueClickAtAndWait" locator1="PGMessageboardsAddcategory#SAVE_BUTTON" value1="Save" />
			</then>
			<else>
				<execute function="#type" locator1="PGMessageboardsAddcategory#NAME_FIELD" value1="${categoryName}" />
				<execute function="AssertClick#assertValueClickAtAndWait" locator1="PGMessageboardsAddcategory#SAVE_BUTTON" value1="Save" />
			</else>
		</if>

		<execute function="#assertTextEquals" locator1="PGMessageboards#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="deletePG">
		<var name="key_categoryName" value="${categoryName}" />

		<execute function="#assertTextEquals" locator1="PGMessageboards#CATEGORY_TABLE_CATEGORY" value1="${categoryName}" />
		<execute function="AssertClick#pauseAssertTextClickAt" locator1="PGMessageboards#CATEGORY_TABLE_ACTIONS" value1="Actions" />
		<execute function="#assertClickNoError" locator1="PGMessageboards#CATEGORY_MENULIST_DELETE" value1="Delete" />
		<execute function="#confirm" locator1="PGMessageboards#CONFIRMATION" value1="Are you sure you want to delete this?" />
		<execute function="#assertTextEquals" locator1="PGMessageboards#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="#assertTextNotPresent" value1="${categoryName}" />
	</command>

	<command name="editPG">
		<var name="key_categoryName" value="${categoryName}" />

		<execute function="#assertTextEquals" locator1="PGMessageboards#CATEGORY_TABLE_CATEGORY" value1="${categoryName}" />
		<execute function="AssertClick#pauseAssertTextClickAt" locator1="PGMessageboards#CATEGORY_TABLE_ACTIONS" value1="Actions" />
		<execute function="#assertClick" locator1="PGMessageboards#CATEGORY_MENULIST_EDIT" value1="Edit" />

		<execute function="#type" locator1="PGMessageboardsAddcategory#NAME_FIELD" value1="${categoryNameEdit}" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="PGMessageboardsAddcategory#SAVE_BUTTON" value1="Save" />

		<execute function="#assertTextEquals" locator1="PGMessageboards#SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<var name="key_categoryName" value="${categoryNameEdit}" />

		<execute function="#assertTextEquals" locator1="PGMessageboards#CATEGORY_TABLE_CATEGORY" value1="${categoryNameEdit}" />
	</command>

	<command name="gotoPG">
		<var name="key_categoryName" value="${categoryName}" />

		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />

				<execute function="#assertClick" locator1="PGMessageboards#CATEGORY_TABLE_CATEGORY_INCREMENT" value1="${categoryName}${number}" />
			</then>
			<else>
				<execute function="#assertClick" locator1="PGMessageboards#CATEGORY_TABLE_CATEGORY" value1="${categoryName}" />
			</else>
		</if>
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Message Boards" />
		</execute>

		<if>
			<condition function="#isElementPresent" locator1="CPMessageboards#CATEGORY_TABLE_ALL_CHECKBOX" />
			<then>
				<execute function="#check" locator1="CPMessageboards#CATEGORY_TABLE_ALL_CHECKBOX" />
				<execute function="#assertClickNoError" locator1="CPMessageboards#CATEGORIES_DELETE_BUTTON"  value1="Delete" />
				<execute function="#confirm" locator1="CPMessageboards#CONFIRMATION" value1="Are you sure you want to delete this?" />
			</then>
		</if>
	</command>

	<command name="viewPG">
		<var name="key_categoryName" value="${categoryName}" />

		<execute function="#assertTextEquals" locator1="PGMessageboards#CATEGORY_TABLE_CATEGORIES" value1="0" />
		<execute function="#assertTextEquals" locator1="PGMessageboards#CATEGORY_TABLE_THREADS" value1="0" />
		<execute function="#assertTextEquals" locator1="PGMessageboards#CATEGORY_TABLE_POSTS" value1="0" />
		<execute function="#assertClick" locator1="PGMessageboards#CATEGORY_TABLE_CATEGORY" value1="${categoryName}" />

		<execute function="#assertTextEquals" locator1="PGMessageboardsCategory#NAME_HEADER" value1="${categoryName}" />
	</command>
</definition>