<definition>
	<command name="addCP">
		<execute function="AssertClick#assertTextClickAtAndWait" locator1="CPUsergroups#ADD" value1="Add" />

		<execute function="#type" locator1="CPUsergroupsAddusergroup#NAME_FIELD" value1="${userGroupName}" />
		<execute function="#click" locator1="CPUsergroupsAddusergroup#SAVE_BUTTON" value1="Save" />

		<execute function="#assertTextEquals" locator1="CPUsergroups#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="#assertTextEquals" locator1="CPUsergroups#USER_GROUP_TABLE_NAME_1" value1="${userGroupName}" />
	</command>

	<command name="deleteCP">
		<execute function="#assertClick" locator1="CPUsergroups#USER_GROUP_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="#assertClickNoError" locator1="CPUsergroups#USER_GROUP_MENULIST_DELETE" value1="Delete" />
		<execute function="#confirm" locator1="CPUsergroups#CONFIRMATION" value1="Are you sure you want to delete this?" />
		<execute function="#assertTextEquals" locator1="CPUsergroups#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="#assertElementNotPresent" locator1="CPUsergroups#USER_GROUP_TABLE_NAME_1" />
	</command>

	<command name="editCP">
		<execute function="#assertClick" locator1="CPUsergroups#USER_GROUP_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="AssertClick#assertTextClickAtAndWait" locator1="CPUsergroups#USER_GROUP_MENULIST_EDIT" value1="Edit" />

		<execute function="#type" locator1="CPUsergroupsEditusergroup#NAME_FIELD" value1="${userGroupNameEdit}" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="CPUsergroupsEditusergroup#SAVE_BUTTON" value1="Save" />

		<execute function="#assertTextEquals" locator1="CPUsergroups#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="#assertTextEquals" locator1="CPUsergroups#USER_GROUP_TABLE_NAME_1" value1="${userGroupNameEdit}" />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="User Groups" />
		</execute>

		<while>
			<condition function="#isElementPresent" locator1="CPUsergroups#USER_GROUP_TABLE_CHECKBOX_1" />
			<then>
				<execute function="#click" locator1="CPUsergroups#USER_GROUP_TABLE_ALL_CHECKBOX" />
				<execute function="#assertChecked" locator1="CPUsergroups#USER_GROUP_TABLE_ALL_CHECKBOX" />
				<execute function="#assertClickNoError" locator1="CPUsergroups#DELETE_BUTTON" value1="Delete" />
				<execute function="#confirm" locator1="CPUsergroups#CONFIRMATION" value1="Are you sure you want to delete this?" />
				<execute function="#assertTextEquals" locator1="CPUsergroups#SUCCESS_MESSAGE" value1="Your request completed successfully." />
				<execute function="#assertTextEquals" locator1="CPUsergroups#INFO_MESSAGE" value1="No user groups were found." />
			</then>
		</while>
	</command>
</definition>