<definition>
	<command name="addCP">
		<execute action="CPUsergroups#assertClick" locator1="ADD" value1="Add" />

		<execute action="CPUsergroupsAddusergroup#type" locator1="NAME_FIELD" value1="${userGroupName}" />
		<execute action="CPUsergroupsAddusergroup#click" locator1="SAVE_BUTTON" value1="Save" />

		<execute action="CPUsergroups#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="CPUsergroups#assertTextEquals" locator1="USER_GROUP_TABLE_NAME_1" value1="${userGroupName}" />
	</command>

	<command name="deleteCP">
		<execute action="CPUsergroups#assertClick" locator1="USER_GROUP_TABLE_ACTIONS_1" value1="Actions" />
		<execute action="CPUsergroups#assertClickNoError" locator1="USER_GROUP_MENULIST_DELETE" value1="Delete" />
		<execute action="CPUsergroups#confirm" locator1="CONFIRMATION" value1="Are you sure you want to delete this?" />
		<execute action="CPUsergroups#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="CPUsergroups#assertElementNotPresent" locator1="USER_GROUP_TABLE_NAME_1" />
	</command>

	<command name="editCP">
		<execute action="CPUsergroups#assertClick" locator1="USER_GROUP_TABLE_ACTIONS_1" value1="Actions" />
		<execute action="CPUsergroups#assertClick" locator1="USER_GROUP_MENULIST_EDIT" value1="Edit" />

		<execute action="CPUsergroupsEditusergroup#type" locator1="NAME_FIELD" value1="${userGroupNameEdit}" />
		<execute action="CPUsergroupsEditusergroup#assertClick" locator1="SAVE_BUTTON" value1="Save" />

		<execute action="CPUsergroups#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="CPUsergroups#assertTextEquals" locator1="USER_GROUP_TABLE_NAME_1" value1="${userGroupNameEdit}" />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="User Groups" />
		</execute>

		<while>
			<condition action="CPUsergroups#isElementPresent" locator1="USER_GROUP_TABLE_CHECKBOX_1" />
			<then>
				<execute action="CPUsergroups#click" locator1="USER_GROUP_TABLE_ALL_CHECKBOX" />
				<execute action="CPUsergroups#assertChecked" locator1="USER_GROUP_TABLE_ALL_CHECKBOX" />
				<execute action="CPUsergroups#assertClickNoError" locator1="DELETE_BUTTON" value1="Delete" />
				<execute action="CPUsergroups#confirm" locator1="CONFIRMATION" value1="Are you sure you want to delete this?" />
				<execute action="CPUsergroups#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
				<execute action="CPUsergroups#assertTextEquals" locator1="INFO_MESSAGE" value1="No user groups were found." />
			</then>
		</while>
	</command>
</definition>