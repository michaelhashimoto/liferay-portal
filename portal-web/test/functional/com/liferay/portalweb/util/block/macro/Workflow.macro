definition {
	macro approveTaskByActions {
		var key_workflowAssetTitle = "${workflowAssetTitle}";

		AssertTextEquals(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_TASK",
			value1 = "${workflowTask}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_ASSET_TITLE",
			value1 = "${workflowAssetTitle}"
		);

		AssertTextEquals(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_ASSET_TYPE",
			value1 = "${workflowAssetType}"
		);

		AssertElementPresent(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_LAST_ACTIVITY_DATE"
		);

		AssertElementPresent(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_DUE_DATE"
		);

		AssertClick(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_ACTIONS",
			value1 = "Actions"
		);

		AssertClick(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_MENULIST_APPROVE",
			value1 = "Approve"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPMyworkflowtasks#PANEL_OK_BUTTON",
			value1 = "OK"
		);

		AssertTextEquals(
			locator1 = "CPMyworkflowtasks#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		Click(locator1 = "CPMyworkflowtasks#NAVIGATION_COMPLETED", value1 = "Completed");

		AssertTextEquals(
			locator1 = "CPMyworkflowtasksCompleted#COMPLETED_TABLE_TASK",
			value1 = "${workflowTask}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "CPMyworkflowtasksCompleted#COMPLETED_TABLE_ASSET_TITLE",
			value1 = "${workflowAssetTitle}"
		);

		AssertTextEquals(
			locator1 = "CPMyworkflowtasksCompleted#COMPLETED_TABLE_ASSET_TYPE",
			value1 = "${workflowAssetType}"
		);

		AssertElementPresent(
			locator1 = "CPMyworkflowtasksCompleted#COMPLETED_TABLE_LAST_ACTIVITY_DATE"
		);

		AssertElementPresent(
			locator1 = "CPMyworkflowtasksCompleted#COMPLETED_TABLE_DUE_DATE"
		);
	}

	macro approveTaskByDetails {
		var key_workflowAssetTitle = "${workflowAssetTitle}";

		AssertTextEquals(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_TASK",
			value1 = "${workflowTask}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_ASSET_TITLE",
			value1 = "${workflowAssetTitle}"
		);

		AssertTextEquals(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_ASSET_TYPE",
			value1 = "${workflowAssetType}"
		);

		AssertElementPresent(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_LAST_ACTIVITY_DATE"
		);

		AssertElementPresent(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_DUE_DATE"
		);

		AssertClick.assertPartialTextClickAt(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_ASSET_TITLE",
			value1 = "${workflowAssetTitle}"
		);

		AssertTextEquals(
			locator1 = "CPMyworkflowtasksTask#PREVIEW",
			value1 = "Preview of ${workflowAssetType}"
		);

		AssertTextEquals(
			locator1 = "CPMyworkflowtasksTask#PREVIEW_TITLE",
			value1 = "${workflowAssetTitle}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "CPMyworkflowtasksTask#PREVIEW_CONTENT",
			value1 = "${workflowAssetContent}"
		);

		AssertClick(locator1 = "CPMyworkflowtasksTask#MENU_APPROVE", value1 = "Approve");

		AssertClick.assertTextClickAt(
			locator1 = "CPMyworkflowtasksTask#PANEL_OK_BUTTON",
			value1 = "OK"
		);

		AssertTextEquals(
			locator1 = "CPMyworkflowtasksTask#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertClick.assertPartialTextClickAt(
			locator1 = "CPMyworkflowtasksTask#BACK",
			value1 = "Back"
		);

		Click(locator1 = "CPMyworkflowtasks#NAVIGATION_COMPLETED", value1 = "Completed");

		AssertTextEquals(
			locator1 = "CPMyworkflowtasksCompleted#COMPLETED_TABLE_TASK",
			value1 = "${workflowTask}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "CPMyworkflowtasksCompleted#COMPLETED_TABLE_ASSET_TITLE",
			value1 = "${workflowAssetTitle}"
		);

		AssertTextEquals(
			locator1 = "CPMyworkflowtasksCompleted#COMPLETED_TABLE_ASSET_TYPE",
			value1 = "${workflowAssetType}"
		);

		AssertElementPresent(
			locator1 = "CPMyworkflowtasksCompleted#COMPLETED_TABLE_LAST_ACTIVITY_DATE"
		);

		AssertElementPresent(
			locator1 = "CPMyworkflowtasksCompleted#COMPLETED_TABLE_DUE_DATE"
		);
	}

