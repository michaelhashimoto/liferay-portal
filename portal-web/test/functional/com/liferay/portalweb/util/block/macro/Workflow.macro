			locator1 = "CPMysubmissionsCompleted#COMPLETED_TABLE_ASSET_TYPE",
			value1 = "${workflowAssetType}"
		);

		AssertTextEquals(
			locator1 = "CPMysubmissionsCompleted#COMPLETED_TABLE_STATUS",
			value1 = "${workflowTask}"
		);

		AssertElementPresent(
			locator1 = "CPMysubmissionsCompleted#COMPLETED_TABLE_LAST_ACTIVITY_DATE"
		);

		AssertElementPresent(
			locator1 = "CPMysubmissionsCompleted#COMPLETED_TABLE_END_DATE"
		);

		AssertElementNotPresent(
			locator1 = "//div[@id='_158_workflowInstancesSearchContainer']//tr[contains(.,'${key_workflowAssetTitle}')]/td[7]/span/a[contains(@id,'menu_withdraw-submission')]/span"
		);

		AssertTextNotPresent(value1 = "Withdraw Submission");
	}

	macro withdrawTaskCompletedNoByDetails {
		var key_workflowAssetContent = "${workflowAssetContent}";
		var key_workflowAssetTitle = "${workflowAssetTitle}";

		AssertClick(locator1 = "NAVIGATION_COMPLETED", value1 = "Completed");

		AssertTextEquals(
			locator1 = "CPMysubmissionsCompleted#COMPLETED_TABLE_DEFINITION",
			value1 = "${workflowDefinition}"
		);

		AssertTextEquals(
			locator1 = "CPMysubmissionsCompleted#COMPLETED_TABLE_ASSET_TITLE",
			value1 = "${workflowAssetTitle}"
		);

		AssertTextEquals(
			locator1 = "CPMysubmissionsCompleted#COMPLETED_TABLE_ASSET_TYPE",
			value1 = "${workflowAssetType}"
		);

		AssertTextEquals(
			locator1 = "CPMysubmissionsCompleted#COMPLETED_TABLE_STATUS",
			value1 = "${workflowTask}"
		);

		AssertElementPresent(
			locator1 = "CPMysubmissionsCompleted#COMPLETED_TABLE_LAST_ACTIVITY_DATE"
		);

		AssertElementPresent(
			locator1 = "CPMysubmissionsCompleted#COMPLETED_TABLE_END_DATE"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPMysubmissionsCompleted#COMPLETED_TABLE_ASSET_TITLE",
			value1 = "${workflowAssetTitle}"
		);

		AssertTextEquals(
			locator1 = "CPMysubmissionsTask#PREVIEW",
			value1 = "Preview of ${workflowAssetType}"
		);

		AssertTextEquals(
			locator1 = "CPMysubmissionsTask#PREVIEW_TITLE",
			value1 = "${workflowAssetTitle}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "CPMysubmissionsTask#PREVIEW_CONTENT",
			value1 = "${workflowAssetContent}"
		);

		AssertTextEquals(
			locator1 = "CPMysubmissionsTask#MENU_WORKFLOW_NAME",
			value1 = "${workflowDefinition}"
		);

		AssertElementNotPresent(
			locator1 = "CPMysubmissionsTask#MENU_WITHDRAW_SUBMISSION",
			value1 = "Withdraw Submission"
		);

		AssertTextNotPresent(value1 = "Withdraw Submission");
	}
}