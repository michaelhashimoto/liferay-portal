	macro assignToMeTaskByDetails {
		var key_workflowAssetTitle = "${workflowAssetTitle}";

		AssertTextEquals(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_MY_ROLES_TABLE_TASK",
			value1 = "${workflowTask}"
		);

		AssertTextEquals.assertPartialText(
