		);

		AssertTextEquals(
			locator1 = "CPMyworkflowtasksTask#PREVIEW_TITLE",
			value1 = "${workflowAssetTitle}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "CPMyworkflowtasksTask#PREVIEW_CONTENT",
			value1 = "${workflowAssetContent}"
		);

		if ("${assignToMeKey}" == "ASSIGN_TO_ME") {
			AssertClick(
				locator1 = "CPMyworkflowtasksTask#ASSIGN_TO_ME",
				value1 = "Assign to Me"
			);
		}
		else {
			AssertClick(
				locator1 = "CPMyworkflowtasksTask#MENU_ASSIGN_TO_ME",
				value1 = "Assign to Me"
			);
		}

		AssertClick(
			locator1 = "CPMyworkflowtasksTask#MENU_ASSIGN_TO_ME",
			value1 = "Assign to Me"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPMyworkflowtasksTask#PANEL_OK_BUTTON",
			value1 = "OK"
		);

		AssertTextEquals(
			locator1 = "CPMyworkflowtasksTask#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertClick.assertPartialTextClickAt(
			locator1 = "CPMyworkflowtasksTask#BACK",
			value1 = "Back"
		);

		AssertTextEquals(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_TASK",
			value1 = "${workflowTask}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_ASSET_TITLE",
			value1 = "${workflowAssetTitle}"
		);

		AssertTextEquals(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_ASSET_TYPE",
			value1 = "${workflowAssetType}"
		);

		AssertElementPresent(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_LAST_ACTIVITY_DATE"
		);

		AssertElementPresent(
			locator1 = "CPMyworkflowtasks#ASSIGNED_TO_ME_TABLE_DUE_DATE"
		);
	}

	macro configurePortalWorkflow {
		Click(
			locator1 = "CPPortalWorkflowconfiguration#NAVIGATION_DEFAULT_CONFIGURATION"
		);

		Select(
			locator1 = "CPPortalWorkflowconfigurationDefaultconfiguration#${workflowResourceKey}",
			value1 = "${workflowDefinition}"
		);

		Click(
			locator1 = "CPPortalWorkflowconfigurationDefaultconfiguration#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPPortalWorkflowconfigurationDefaultconfiguration#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro configureSiteWorkflow {
		Select(
