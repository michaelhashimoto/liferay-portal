	macro tearDownPortalWorkflow {
		Page.gotoCP(portletName = "Workflow");

		Click(
			locator1 = "CPPortalWorkflowconfiguration#NAVIGATION_DEFAULT_CONFIGURATION"
		);

		Select(
			locator1 = "CPPortalWorkflowconfigurationDefaultconfiguration#RESOURCE_TABLE_PAGE_REVISION_SELECT",
			value1 = "No Workflow"
		);

		Select(
			locator1 = "CPPortalWorkflowconfigurationDefaultconfiguration#RESOURCE_TABLE_USER_SELECT",
			value1 = "No Workflow"
		);

		Select(
			locator1 = "CPPortalWorkflowconfigurationDefaultconfiguration#RESOURCE_TABLE_BLOGS_ENTRY_SELECT",
			value1 = "No Workflow"
		);

		Select(
			locator1 = "CPPortalWorkflowconfigurationDefaultconfiguration#RESOURCE_TABLE_WEB_CONTENT_SELECT",
			value1 = "No Workflow"
		);

		Select(
			locator1 = "CPPortalWorkflowconfigurationDefaultconfiguration#RESOURCE_TABLE_COMMENTS_SELECT",
			value1 = "No Workflow"
		);

		Select(
			locator1 = "CPPortalWorkflowconfigurationDefaultconfiguration#RESOURCE_TABLE_MESSAGE_BOARDS_MESSAGE_SELECT",
			value1 = "No Workflow"
		);

		Select(
			locator1 = "CPPortalWorkflowconfigurationDefaultconfiguration#RESOURCE_TABLE_WIKI_PAGE_SELECT",
			value1 = "No Workflow"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPPortalWorkflowconfigurationDefaultconfiguration#SAVE_BUTTON",
			value1 = "Save"
		);
	}

