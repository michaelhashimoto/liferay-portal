<definition>
	<command name="addPage">
		<if>
			<condition function="IsElementNotPresent" locator1="SOUserBar#VISIBLE_DOCKBAR" />
			<then>
				<execute function="Click" locator1="SOUserBar#TOGGLE_DOCKBAR" />
			</then>
		</if>

		<execute function="MouseOver#textMouseOverClickDockbar" locator1="Dockbar#ADD" value1="Add" />
		<execute function="AssertClick#assertTextClickAt" locator1="Dockbar#ADD_PAGE" value1="Page" />

		<execute function="Type" locator1="Home#NEW_PAGE_FIELD" value1="${pageName}" />
		<execute function="Click" locator1="Home#NEW_PAGE_SAVE" />
		<execute function="Click" locator1="//nav/ul/li/a[contains(.,'${pageName}')]" />
	</command>

	<command name="addPortlet">
		<if>
			<condition function="IsElementNotPresent" locator1="SOUserBar#VISIBLE_DOCKBAR" />
			<then>
				<execute function="Click" locator1="SOUserBar#TOGGLE_DOCKBAR" />
			</then>
		</if>

		<execute function="MouseOver#textMouseOverClickDockbar" locator1="Dockbar#ADD" value1="Add" />
		<execute function="Click" locator1="Dockbar#ADD_APPLICATION" />
		<execute function="Type#sendKeysApplicationSearch" locator1="Dockbar#ADD_APPLICATION_SEARCH_FIELD" value1="${portletName}" />
		<execute function="Click" locator1="//div[@title='${portletName}']/p/a" value1="Add" />

		<execute function="AssertElementPresent" locator1="Home#PORTLET_1" />
	</command>

	<command name="addWhatsHappeningEntry">
		<execute function="Click#textClickAt" locator1="SOUserBar#DASHBOARD" value1="Dashboard" />

		<if>
			<condition function="IsElementNotPresent" locator1="SODashboard#WHATS_HAPPENING_ENTRY_CONTENT" />
			<then>
				<execute function="AssertTextEquals" locator1="SODashboard#WHATS_HAPPENING_INFO_MESSAGE" value1="You do not have any microblog entries." />
			</then>
		</if>

		<execute function="Click" locator1="SODashboard#WHATS_HAPPENING_CONTENT_FIELD" />
		<execute function="Click" locator1="SODashboard#WHATS_HAPPENING_CONTENT_INPUT_FIELD" />
		<execute function="Type#sendKeys" locator1="SODashboard#WHATS_HAPPENING_CONTENT_INPUT_FIELD" value1="${whatsHappeningEntryContent}" />
		<execute function="AssertTextEquals" locator1="SODashboard#WHATS_HAPPENING_CONTENT_COUNTDOWN" value1="${whatsHappeningEntryCharacterCountdown}" />

		<if>
			<equals arg1="${whatsHappeningEntryViewableBy}" arg2="Connections" />
			<then>
				<execute function="Select" locator1="SODashboard#WHATS_HAPPENING_CONTENT_VIEW_FILTER" value1="Connections" />
			</then>
			<elseif>
				<equals arg1="${whatsHappeningEntryViewableBy}" arg2="Followers" />
				<then>
					<execute function="Select" locator1="SODashboard#WHATS_HAPPENING_CONTENT_VIEW_FILTER" value1="Followers" />
				</then>
			</elseif>
			<else>
				<execute function="Select" locator1="SODashboard#WHATS_HAPPENING_CONTENT_VIEW_FILTER" value1="Everyone" />
			</else>
		</if>

		<execute function="Click" locator1="SODashboard#WHATS_HAPPENING_POST_BUTTON" />
		<execute function="AssertTextEquals" locator1="SODashboard#WHATS_HAPPENING_ENTRY_CONTENT" value1="${whatsHappeningEntryContent}" />
	</command>

	<command name="tearDownPG">
		<execute function="Click#textClickAt" locator1="SOUserBar#DASHBOARD" value1="Dashboard" />

		<if>
			<condition function="IsElementNotPresent" locator1="SOUserBar#VISIBLE_DOCKBAR" />
			<then>
				<execute function="Click" locator1="SOUserBar#TOGGLE_DOCKBAR" />
			</then>
		</if>

		<if>
			<condition function="IsElementPresent" locator1="SOUserBar#EDIT_CONTROLS_NOT_FLAGGED" />
			<then>
				<execute function="MouseOver#mouseOverClickDockbar" locator1="Dockbar#EDIT_CONTROLS" />
				<execute function="AssertClick" locator1="Dockbar#EDIT_CONTROLS" value1="Edit Controls" />
			</then>
		</if>

		<while>
			<condition function="IsElementPresent#isElementPresentClickNavigation" locator1="SODashboard#NAVIGATION_PAGE" />
			<then>
				<execute function="MouseOver#mouseOverClickNavigation" locator1="SODashboard#NAVIGATION_PAGE" />
				<execute function="AssertClickNoError" locator1="SODashboard#NAVIGATION_PAGE_DELETE" value1="X" />
				<execute function="Confirm#waitForConfirmation" value1="Are you sure you want to delete this page?" />
				<execute function="AssertElementNotPresent" locator1="SODashboard#NAVIGATION_PAGE" />
			</then>
		</while>
	</command>

	<command name="viewLinkContactscenter">
		<execute function="AssertElementPresent" locator1="SOContactscenter#CONTACTS_LIST_NAME" />
		<execute function="AssertElementPresent" locator1="SOContactscenter#CONTACTS_LIST_ALL_CHECKBOX" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#CONTACTS_LINK_TITLE" value1="Contacts Center" />
		<execute function="AssertTextEquals" locator1="SOContactscenter#CONTACTS_LINK_CONNECTIONS" value1="You have 0 connections." />
		<execute function="AssertTextEquals" locator1="SOContactscenter#CONTACTS_LINK_FOLLOWING" value1="You are following 0 people." />
		<execute function="AssertTextEquals" locator1="SOContactscenter#CONTACTS_LINK_CONTACTS" value1="View my 0 contacts." />

		<execute function="Click#pauseClickAt" locator1="SOUserBar#GO_TO" />
		<execute function="AssertElementPresent#assertElementPresent" locator1="SOUserBar#GO_TO_SEARCH_FIELD" />

		<var name="siteName" value="Liferay, Inc." />

		<execute function="AssertTextEquals" locator1="SOUserBar#GO_TO_SITE_NAME" value1="${siteName}" />

		<var name="siteName" value="Liferay" />

		<execute function="AssertTextEquals" locator1="SOUserBar#GO_TO_SITE_NAME" value1="${siteName}" />
	</command>

	<command name="viewLinkHome">
		<execute function="AssertTextEquals" locator1="SODashboard#WHATS_HAPPENING_CONTENT_FIELD" value1="Update your status..." />
		<execute function="AssertTextEquals" locator1="SODashboard#WHATS_HAPPENING_INFO_MESSAGE" value1="You do not have any microblog entries." />

		<execute function="AssertTextEquals" locator1="SODashboard#ANNOUNCEMENTS_PORTLET_TITLE" value1="Announcements" />
		<execute function="AssertTextEquals" locator1="SODashboard#ANNOUNCEMENTS_ADD_ENTRY_BUTTON" value1="Add Entry" />
		<execute function="AssertTextEquals" locator1="SODashboard#ANNOUNCEMENTS_MANAGE_ENTRIES_BUTTON" value1="Manage Entries" />
		<execute function="AssertTextEquals" locator1="SODashboard#ANNOUNCEMENTS_NO_ANNOUNCEMENTS" value1="There are no new announcements." />

		<execute function="AssertTextEquals" locator1="SOActivities#ACTIVITIES_PORTLET_TITLE" value1="Activities" />
		<execute function="AssertTextEquals" locator1="SOActivities#NAVIGATION_ALL" value1="All" />
		<execute function="AssertTextEquals" locator1="SOActivities#NAVIGATION_CONNECTIONS" value1="Connections" />
		<execute function="AssertTextEquals" locator1="SOActivities#NAVIGATION_FOLLOWING" value1="Following" />
		<execute function="AssertTextEquals" locator1="SOActivities#NAVIGATION_MY_SITE" value1="My Sites" />
		<execute function="AssertTextEquals" locator1="SOActivities#NAVIGATION_ME" value1="Me" />
		<execute function="AssertTextEquals" locator1="SOActivities#NO_ACTIVITIES" value1="There are no activities." />

		<execute function="AssertTextEquals" locator1="SODashboard#TASK_PORTLET_TITLE" value1="Upcoming Tasks" />
		<execute function="AssertTextEquals" locator1="SODashboard#VIEW_ALL_TASKS_LINK" value1="View All Tasks" />

		<execute function="AssertTextEquals" locator1="SODashboard#EVENTS_PORTLET_TITLE" value1="Events" />
		<execute function="AssertTextEquals" locator1="SODashboard#EVENTS_DISPLAY_NO_EVENTS_MESSAGE" value1="There are no more events today." />

		<execute function="Click#pauseClickAt" locator1="SOUserBar#GO_TO" />
		<execute function="AssertElementPresent#assertElementPresent" locator1="SOUserBar#GO_TO_SEARCH_FIELD" />

		<var name="siteName" value="Liferay, Inc." />

		<execute function="AssertTextEquals" locator1="SOUserBar#GO_TO_SITE_NAME" value1="${siteName}" />

		<var name="siteName" value="Liferay" />

		<execute function="AssertTextEquals" locator1="SOUserBar#GO_TO_SITE_NAME" value1="${siteName}" />
	</command>

	<command name="viewLinkMicroblogs">
		<execute function="AssertTextEquals" locator1="SOMicroblogs#MICROBLOGS_CONTENT_FIELD" value1="Update your status..." />
		<execute function="AssertTextEquals" locator1="SOMicroblogs#INFO_MESSAGE" value1="You do not have any microblog entries." />

		<execute function="Click#pauseClickAt" locator1="SOUserBar#GO_TO" />
		<execute function="AssertElementPresent#assertElementPresent" locator1="SOUserBar#GO_TO_SEARCH_FIELD" />

		<var name="siteName" value="Liferay, Inc." />

		<execute function="AssertTextEquals" locator1="SOUserBar#GO_TO_SITE_NAME" value1="${siteName}" />

		<var name="siteName" value="Liferay" />

		<execute function="AssertTextEquals" locator1="SOUserBar#GO_TO_SITE_NAME" value1="${siteName}" />
	</command>

	<command name="viewLinkMydocuments">
		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#FILTER_HOME" value1="Home" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#FILTER_RECENT" value1="Recent" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#FILTER_MINE" value1="Mine" />
		<execute function="AssertElementPresent" locator1="PGDocumentsandmedia#TOOLBAR_SELECT_ALL_CHECKBOX" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#TOOLBAR_ADD" value1="Add" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#TOOLBAR_SORT_BY" value1="Sort By" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#TOOLBAR_MANAGE" value1="Manage" />
		<execute function="AssertElementPresent" locator1="PGDocumentsandmedia#TOOLBAR_DISPLAY_ICON" />
		<execute function="AssertElementPresent" locator1="PGDocumentsandmedia#TOOLBAR_DISPLAY_DESCRIPTIVE" />
		<execute function="AssertElementPresent" locator1="PGDocumentsandmedia#TOOLBAR_DISPLAY_LIST" />
		<execute function="AssertElementPresent" locator1="PGDocumentsandmedia#TOOLBAR_SEARCH_FIELD" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#TOOLBAR_SEARCH_BUTTON" value1="Search" />

		<execute function="Click#pauseClickAt" locator1="SOUserBar#GO_TO" />
		<execute function="AssertElementPresent#assertElementPresent" locator1="SOUserBar#GO_TO_SEARCH_FIELD" />

		<var name="siteName" value="Liferay, Inc." />

		<execute function="AssertTextEquals" locator1="SOUserBar#GO_TO_SITE_NAME" value1="${siteName}" />

		<var name="siteName" value="Liferay" />

		<execute function="AssertTextEquals" locator1="SOUserBar#GO_TO_SITE_NAME" value1="${siteName}" />
	</command>

	<command name="viewLinkPrivateMessaging">
		<execute function="AssertTextEquals" locator1="SOMessages#INFO_MESSAGE" value1="No messages found." />
		<execute function="AssertTextEquals" locator1="SOMessages#MARK_AS_UNREAD_BUTTON" value1="Mark as Unread" />
		<execute function="AssertTextEquals" locator1="SOMessages#MARK_AS_READ_BUTTON" value1="Mark as Read" />
		<execute function="AssertTextEquals" locator1="SOMessages#DELETE_BUTTON" value1="Delete" />
		<execute function="AssertTextEquals" locator1="SOMessages#NEW_MESSAGE_BUTTON" value1="New Message" />

		<execute function="Click#pauseClickAt" locator1="SOUserBar#GO_TO" />
		<execute function="AssertElementPresent#assertElementPresent" locator1="SOUserBar#GO_TO_SEARCH_FIELD" />

		<var name="siteName" value="Liferay, Inc." />

		<execute function="AssertTextEquals" locator1="SOUserBar#GO_TO_SITE_NAME" value1="${siteName}" />

		<var name="siteName" value="Liferay" />

		<execute function="AssertTextEquals" locator1="SOUserBar#GO_TO_SITE_NAME" value1="${siteName}" />
	</command>

	<command name="viewLinkTasks">
		<execute function="AssertTextEquals" locator1="SOTasks#ASSIGNED_TO_ME_LINK" value1="Assigned to Me" />
		<execute function="AssertTextEquals" locator1="SOTasks#I_HAVE_CREATED_LINK" value1="I Have Created" />
		<execute function="AssertTextEquals" locator1="SOTasks#ADD_TASK_BUTTON" value1="Add Task" />
		<execute function="AssertTextEquals" locator1="SOTasks#PERMISSIONS_BUTTON" value1="Permissions" />
		<execute function="AssertTextEquals" locator1="SOTasks#INFO_MESSAGE" value1="No tasks were found." />

		<execute function="Click#pauseClickAt" locator1="SOUserBar#GO_TO" />
		<execute function="AssertElementPresent#assertElementPresent" locator1="SOUserBar#GO_TO_SEARCH_FIELD" />

		<var name="siteName" value="Liferay, Inc." />

		<execute function="AssertTextEquals" locator1="SOUserBar#GO_TO_SITE_NAME" value1="${siteName}" />

		<var name="siteName" value="Liferay" />

		<execute function="AssertTextEquals" locator1="SOUserBar#GO_TO_SITE_NAME" value1="${siteName}" />
	</command>

	<command name="viewTodaysEvent">
		<execute function="Click#textClickAt" locator1="SOUserBar#DASHBOARD" value1="Dashboard" />

		<execute function="AssertTextEquals" locator1="SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE" value1="${eventTitle}" />
		<execute function="AssertTextEquals" locator1="SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_CREATOR" value1="${userName}" />
		<execute function="AssertElementPresent" locator1="SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TIME" />
		<execute function="Click#clickAt" locator1="SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE" />

		<execute macro="Event#viewDetailsPG" />
	</command>

	<command name="viewTodaysEventSiteEvent">
		<execute function="Click#textClickAt" locator1="SOUserBar#DASHBOARD" value1="Dashboard" />

		<execute function="AssertTextEquals" locator1="SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE" value1="${eventTitle}" />
		<execute function="AssertElementPresent" locator1="SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TIME" />
		<execute function="Click#clickAt" locator1="SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE" />

		<execute macro="Event#viewDetailsPG" />
	</command>

	<command name="viewUpcomingTask">
		<execute function="Click#textClickAt" locator1="SOUserBar#DASHBOARD" value1="Dashboard" />

		<var method="selenium#getText('SODashboard#PROFILE_NAME')" name="currentUser" />

		<if>
			<equals arg1="${taskAssignee}" arg2="${currentUser}" />
			<then>
				<if>
					<equals arg1="${taskPriority}" arg2="High" />
					<then>
						<if>
							<isset var="number" />
							<then>
								<execute function="AssertClick" locator1="SODashboard#TASK_DESCRIPTION_HIGH_INCREMENT" value1="${taskDescription}${number}" />
							</then>
							<else>
								<execute function="AssertClick" locator1="SODashboard#TASK_DESCRIPTION_HIGH" value1="${taskDescription}" />
							</else>
						</if>
					</then>
					<elseif>
						<equals arg1="${taskPriority}" arg2="Low" />
						<then>
							<if>
								<isset var="number" />
								<then>
									<execute function="AssertClick" locator1="SODashboard#TASK_DESCRIPTION_LOW_INCREMENT" value1="${taskDescription}${number}" />
								</then>
								<else>
									<execute function="AssertClick" locator1="SODashboard#TASK_DESCRIPTION_LOW" value1="${taskDescription}" />
								</else>
							</if>
						</then>
					</elseif>
					<else>
						<if>
							<isset var="number" />
							<then>
								<execute function="AssertClick" locator1="SODashboard#TASK_DESCRIPTION_NORMAL_INCREMENT" value1="${taskDescription}${number}" />
							</then>
							<else>
								<execute function="AssertClick" locator1="SODashboard#TASK_DESCRIPTION_NORMAL" value1="${taskDescription}" />
							</else>
						</if>
					</else>
				</if>

				<execute macro="SOTasks#viewTaskDetails" />
			</then>
			<else>
				<execute function="AssertTextNotPresent" value1="${taskDescription}" />
			</else>
		</if>

		<execute function="Click#textClickAt" locator1="SOUserBar#DASHBOARD" value1="Dashboard" />

		<execute function="AssertClick#assertTextClickAt" locator1="SODashboard#VIEW_ALL_TASKS_LINK" value1="View All Tasks" />

		<execute macro="SOTasks#viewTask" />
	</command>
</definition>