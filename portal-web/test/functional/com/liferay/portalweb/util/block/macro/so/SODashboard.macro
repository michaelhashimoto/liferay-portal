	macro viewTodaysEvent {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertTextEquals(
			locator1 = "SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE",
			value1 = "${eventTitle}"
		);

		AssertTextEquals(
			locator1 = "SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_CREATOR",
			value1 = "${userName}"
		);

		AssertElementPresent(
			locator1 = "SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TIME"
		);

		Click.clickAt(locator1 = "SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE");

		Event.viewDetailsPG();
	}

	macro viewTodaysEventSiteEvent {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertTextEquals(
			locator1 = "SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE",
			value1 = "${eventTitle}"
		);

		AssertElementPresent(
			locator1 = "SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TIME"
		);

		Click.clickAt(locator1 = "SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE");

		Event.viewDetailsPG();
	}

	macro viewUpcomingTask {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		var currentUser = selenium.getText("SODashboard#PROFILE_NAME");

		if ("${taskAssignee}" == "${currentUser}") {
			if ("${taskPriority}" == "High") {
				if (isSet(number)) {
					AssertClick(
						locator1 = "SODashboard#TASK_DESCRIPTION_HIGH_INCREMENT",
						value1 = "${taskDescription}${number}"
					);
				}
				else {
					AssertClick(
						locator1 = "SODashboard#TASK_DESCRIPTION_HIGH",
						value1 = "${taskDescription}"
					);
				}
			}
			else if ("${taskPriority}" == "Low") {
				if (isSet(number)) {
					AssertClick(
						locator1 = "SODashboard#TASK_DESCRIPTION_LOW_INCREMENT",
						value1 = "${taskDescription}${number}"
					);
				}
				else {
					AssertClick(
						locator1 = "SODashboard#TASK_DESCRIPTION_LOW",
						value1 = "${taskDescription}"
					);
				}
			}
			else {
				if (isSet(number)) {
					AssertClick(
						locator1 = "SODashboard#TASK_DESCRIPTION_NORMAL_INCREMENT",
						value1 = "${taskDescription}${number}"
					);
				}
				else {
					AssertClick(
						locator1 = "SODashboard#TASK_DESCRIPTION_NORMAL",
						value1 = "${taskDescription}"
					);
				}
			}

			SOTasks.viewTaskDetails();
		}
		else {
			AssertTextNotPresent(value1 = "${taskDescription}");
		}

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertClick.assertTextClickAt(
			locator1 = "SODashboard#VIEW_ALL_TASKS_LINK",
			value1 = "View All Tasks"
		);

		SOTasks.viewTask();
	}
}