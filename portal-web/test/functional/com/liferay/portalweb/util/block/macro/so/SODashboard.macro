definition {
	macro addPage {
		if (IsElementNotPresent(locator1 = "SOUserBar#VISIBLE_DOCKBAR")) {
			Click(locator1 = "SOUserBar#TOGGLE_DOCKBAR");
		}

		MouseOver.textMouseOverClickDockbar(locator1 = "Dockbar#ADD", value1 = "Add");

		AssertClick.assertTextClickAt(locator1 = "Dockbar#ADD_PAGE", value1 = "Page");

		Type(locator1 = "Home#NEW_PAGE_FIELD", value1 = "${pageName}");

		Click(locator1 = "Home#NEW_PAGE_SAVE");

		Click(locator1 = "//nav/ul/li/a[contains(.,'${pageName}')]");
	}

	macro addPortlet {
		if (IsElementNotPresent(locator1 = "SOUserBar#VISIBLE_DOCKBAR")) {
			Click(locator1 = "SOUserBar#TOGGLE_DOCKBAR");
		}

		MouseOver.textMouseOverClickDockbar(locator1 = "Dockbar#ADD", value1 = "Add");

		Click(locator1 = "Dockbar#ADD_APPLICATION");

		Type.sendKeysApplicationSearch(
			locator1 = "Dockbar#ADD_APPLICATION_SEARCH_FIELD",
			value1 = "${portletName}"
		);

		Click(locator1 = "//div[@title='${portletName}']/p/a", value1 = "Add");

		AssertElementPresent(locator1 = "Home#PORTLET_1");
	}

	macro addWhatsHappeningEntry {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		if (IsElementNotPresent(locator1 = "SODashboard#WHATS_HAPPENING_ENTRY_CONTENT")) {
			AssertTextEquals(
				locator1 = "SODashboard#WHATS_HAPPENING_INFO_MESSAGE",
				value1 = "You do not have any microblog entries."
			);
		}

		Click(locator1 = "SODashboard#WHATS_HAPPENING_CONTENT_FIELD");

		Click(locator1 = "SODashboard#WHATS_HAPPENING_CONTENT_INPUT_FIELD");

		Type.sendKeys(
			locator1 = "SODashboard#WHATS_HAPPENING_CONTENT_INPUT_FIELD",
			value1 = "${whatsHappeningEntryContent}"
		);

		AssertTextEquals(
			locator1 = "SODashboard#WHATS_HAPPENING_CONTENT_COUNTDOWN",
			value1 = "${whatsHappeningEntryCharacterCountdown}"
		);

		if ("${whatsHappeningEntryViewableBy}" == "Connections") {
			Select(
				locator1 = "SODashboard#WHATS_HAPPENING_CONTENT_VIEW_FILTER",
				value1 = "Connections"
			);
		}
		else if ("${whatsHappeningEntryViewableBy}" == "Followers") {
			Select(
				locator1 = "SODashboard#WHATS_HAPPENING_CONTENT_VIEW_FILTER",
				value1 = "Followers"
			);
		}
		else {
			Select(
				locator1 = "SODashboard#WHATS_HAPPENING_CONTENT_VIEW_FILTER",
				value1 = "Everyone"
			);
		}

		Click(locator1 = "SODashboard#WHATS_HAPPENING_POST_BUTTON");

		AssertTextEquals(
			locator1 = "SODashboard#WHATS_HAPPENING_ENTRY_CONTENT",
			value1 = "${whatsHappeningEntryContent}"
		);
	}

	macro tearDownPG {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		if (IsElementNotPresent(locator1 = "SOUserBar#VISIBLE_DOCKBAR")) {
			Click(locator1 = "SOUserBar#TOGGLE_DOCKBAR");
		}

		if (IsElementPresent(locator1 = "SOUserBar#EDIT_CONTROLS_NOT_FLAGGED")) {
			MouseOver.mouseOverClickDockbar(locator1 = "Dockbar#EDIT_CONTROLS");

			AssertClick(locator1 = "Dockbar#EDIT_CONTROLS", value1 = "Edit Controls");
		}

		while (IsElementPresent.isElementPresentClickNavigation(locator1 = "SODashboard#NAVIGATION_PAGE")) {
			MouseOver.mouseOverClickNavigation(locator1 = "SODashboard#NAVIGATION_PAGE");

			AssertClickNoError(
				locator1 = "SODashboard#NAVIGATION_PAGE_DELETE",
				value1 = "X"
			);

			Confirm.waitForConfirmation(
				value1 = "Are you sure you want to delete this page?"
			);

			AssertElementNotPresent(locator1 = "SODashboard#NAVIGATION_PAGE");
		}
	}

	macro viewLinkContactscenter {
		AssertElementPresent(locator1 = "SOContactscenter#CONTACTS_LIST_NAME");

		AssertElementPresent(locator1 = "SOContactscenter#CONTACTS_LIST_ALL_CHECKBOX");

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LINK_TITLE",
			value1 = "Contacts Center"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LINK_CONNECTIONS",
			value1 = "You have 0 connections."
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LINK_FOLLOWING",
			value1 = "You are following 0 people."
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LINK_CONTACTS",
			value1 = "View my 0 contacts."
		);

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		AssertElementPresent.assertElementPresent(
			locator1 = "SOUserBar#GO_TO_SEARCH_FIELD"
		);

		var siteName = "Liferay, Inc.";

		AssertTextEquals(locator1 = "SOUserBar#GO_TO_SITE_NAME", value1 = "${siteName}");

		var siteName = "Liferay";

		AssertTextEquals(locator1 = "SOUserBar#GO_TO_SITE_NAME", value1 = "${siteName}");
	}

