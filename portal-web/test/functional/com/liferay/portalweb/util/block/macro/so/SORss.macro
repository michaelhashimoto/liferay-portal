<definition>
	<command name="addRssFeed">
		<if>
			<condition function="IsElementNotPresent" locator1="SOUserBar#VISIBLE_DOCKBAR" />
			<then>
				<execute function="Click" locator1="SOUserBar#TOGGLE_DOCKBAR" />
			</then>
		</if>

		<if>
			<condition function="IsElementPresent" locator1="SOUserBar#EDIT_CONTROLS_NOT_FLAGGED" />
			<then>
				<execute function="MouseOver#mouseOverClickDockbar" locator1="Dockbar#EDIT_CONTROLS" />
				<execute function="AssertClick" locator1="Dockbar#EDIT_CONTROLS" value1="Edit Controls" />
			</then>
		</if>

		<execute function="Click" locator1="SOSiteHome#RSS_OPTIONS" />

		<execute function="Click" locator1="BasePortlet#OPTIONS_MENULIST_CONFIGURATION" />

		<execute function="SelectFrame" locator1="SOSiteHomeRssConfiguration#CONFIGURATION_IFRAME" />
		<execute function="Click" locator1="SOSiteHomeRssConfiguration#FEEDS_ADD_ROW_BUTTON" />
		<execute function="Type" locator1="SOSiteHomeRssConfiguration#FEEDS_TITLE_FIELD" value1="${feedTitle}" />
		<execute function="Type" locator1="SOSiteHomeRssConfiguration#FEEDS_URL_FIELD" value1="${feedUrl}" />
		<execute function="Check" locator1="SOSiteHomeRssConfiguration#DISPLAY_SETTINGS_SHOW_FEED_TITLE_CHECKBOX" />
		<execute function="Check" locator1="SOSiteHomeRssConfiguration#DISPLAY_SETTINGS_SHOW_FEED_PUBLISHED_DATE_CHECKBOX" />
		<execute function="Check" locator1="SOSiteHomeRssConfiguration#DISPLAY_SETTINGS_SHOW_FEED_DESCRIPTION_CHECKBOX" />
		<execute function="Check" locator1="SOSiteHomeRssConfiguration#DISPLAY_SETTINGS_SHOW_FEED_IMAGE_CHECKBOX" />
		<execute function="Check" locator1="SOSiteHomeRssConfiguration#DISPLAY_SETTINGS_SHOW_FEED_ITEM_AUTHOR_CHECKBOX" />
		<execute function="Select" locator1="SOSiteHomeRssConfiguration#DISPLAY_SETTINGS_ENTRIES_PER_FEED_SELECT" value1="${entriesPerFeed}" />
		<execute function="Select" locator1="SOSiteHomeRssConfiguration#DISPLAY_SETTINGS_EXPANDED_ENTRIES_PER_FEED_SELECT" value1="${expandedEntriesPerFeed}" />
		<execute function="AssertClick#assertValueClickAt" locator1="SOSiteHomeRssConfiguration#SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="SOSiteHomeRssConfiguration#SUCCESS_MESSAGE" value1="You have successfully updated the setup." />
		<execute function="SelectFrameTop" />
		<execute function="Click" locator1="SOSiteHomeEventsConfiguration#CLOSE_BUTTON" />
	</command>

	<command name="viewRssFeed">
		<execute function="AssertTextEquals#assertPartialText" locator1="SOSiteHome#RSS_FEED_TITLE" value1="CNET" />
		<execute function="AssertElementPresent" locator1="SOSiteHome#RSS_FEED_PUBLISHED_DATE" />
		<execute function="AssertElementPresent" locator1="SOSiteHome#RSS_FEED_DESCRIPTION" />
		<execute function="AssertElementPresent" locator1="SOSiteHome#RSS_FEED_IMAGE" />

		<var name="expandedFeedEntryNumber" value="0" />
		<var name="feedEntryNumber" value="0" />

		<while>
			<not>
				<equals arg1="${feedEntryNumber}" arg2="${entriesPerFeed}" />
			</not>
			<then>
				<var method="MathUtil#sum('${feedEntryNumber}', '1')" name="feedEntryNumber" />

				<if>
					<not>
						<equals arg1="${expandedFeedEntryNumber}" arg2="${expandedEntriesPerFeed}" />
					</not>
					<then>
						<var method="MathUtil#sum('${expandedFeedEntryNumber}', '1')" name="expandedFeedEntryNumber" />
					</then>
				</if>

				<execute function="AssertElementPresent" locator1="SOSiteHome#RSS_FEED_ENTRY_TITLE_INCREMENT" />

				<if>
					<not>
						<equals arg1="${expandedFeedEntryNumber}" arg2="${feedEntryNumber}" />
					</not>
					<then>
						<execute function="Click" locator1="SOSiteHome#RSS_FEED_ENTRY_EXPAND_BUTTON_INCREMENT" />
					</then>
				</if>

				<execute function="AssertElementPresent" locator1="SOSiteHome#RSS_FEED_ENTRY_DATE_AND_TIME_INCREMENT" />
				<execute function="AssertElementPresent" locator1="SOSiteHome#RSS_FEED_ENTRY_AUTHOR_INCREMENT" />
				<execute function="AssertElementPresent" locator1="SOSiteHome#RSS_FEED_ENTRY_CONTENT_INCREMENT" />
				<execute function="AssertElementPresent" locator1="SOSiteHome#RSS_FEED_ENTRY_CONTENT_READ_MORE_INCREMENT" />
			</then>
		</while>
	</command>
</definition>