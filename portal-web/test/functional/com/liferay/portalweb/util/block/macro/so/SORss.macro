definition {
	macro addRssFeed {
		if (IsElementNotPresent(locator1 = "SOUserBar#VISIBLE_DOCKBAR")) {
			Click(locator1 = "SOUserBar#TOGGLE_DOCKBAR");
		}

		if (IsElementPresent(locator1 = "SOUserBar#EDIT_CONTROLS_NOT_FLAGGED")) {
			MouseOver.mouseOverClickDockbar(locator1 = "Dockbar#EDIT_CONTROLS");

			AssertClick(locator1 = "Dockbar#EDIT_CONTROLS", value1 = "Edit Controls");
		}

		Click(locator1 = "SOSiteHome#RSS_OPTIONS");

		Click(locator1 = "BasePortlet#OPTIONS_MENULIST_CONFIGURATION");

		SelectFrame(locator1 = "SOSiteHomeRssConfiguration#CONFIGURATION_IFRAME");

		Click(locator1 = "SOSiteHomeRssConfiguration#FEEDS_ADD_ROW_BUTTON");

		Type(
			locator1 = "SOSiteHomeRssConfiguration#FEEDS_TITLE_FIELD",
			value1 = "${feedTitle}"
		);

		Type(
			locator1 = "SOSiteHomeRssConfiguration#FEEDS_URL_FIELD",
			value1 = "${feedUrl}"
		);

		Check(
			locator1 = "SOSiteHomeRssConfiguration#DISPLAY_SETTINGS_SHOW_FEED_TITLE_CHECKBOX"
		);

		Check(
			locator1 = "SOSiteHomeRssConfiguration#DISPLAY_SETTINGS_SHOW_FEED_PUBLISHED_DATE_CHECKBOX"
		);

		Check(
			locator1 = "SOSiteHomeRssConfiguration#DISPLAY_SETTINGS_SHOW_FEED_DESCRIPTION_CHECKBOX"
		);

		Check(
			locator1 = "SOSiteHomeRssConfiguration#DISPLAY_SETTINGS_SHOW_FEED_IMAGE_CHECKBOX"
		);

		Check(
			locator1 = "SOSiteHomeRssConfiguration#DISPLAY_SETTINGS_SHOW_FEED_ITEM_AUTHOR_CHECKBOX"
		);

		Select(
			locator1 = "SOSiteHomeRssConfiguration#DISPLAY_SETTINGS_ENTRIES_PER_FEED_SELECT",
			value1 = "${entriesPerFeed}"
		);

		Select(
			locator1 = "SOSiteHomeRssConfiguration#DISPLAY_SETTINGS_EXPANDED_ENTRIES_PER_FEED_SELECT",
			value1 = "${expandedEntriesPerFeed}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "SOSiteHomeRssConfiguration#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "SOSiteHomeRssConfiguration#SUCCESS_MESSAGE",
			value1 = "You have successfully updated the setup."
		);

		SelectFrameTop();

		Click(locator1 = "SOSiteHomeEventsConfiguration#CLOSE_BUTTON");
	}

	macro viewRssFeed {
		AssertTextEquals.assertPartialText(
			locator1 = "SOSiteHome#RSS_FEED_TITLE",
			value1 = "CNET"
		);

		AssertElementPresent(locator1 = "SOSiteHome#RSS_FEED_PUBLISHED_DATE");

		AssertElementPresent(locator1 = "SOSiteHome#RSS_FEED_DESCRIPTION");

		AssertElementPresent(locator1 = "SOSiteHome#RSS_FEED_IMAGE");

		var expandedFeedEntryNumber = "0";
		var feedEntryNumber = "0";

		while (!("${feedEntryNumber}" == "${entriesPerFeed}")) {
			var feedEntryNumber = MathUtil.sum("${feedEntryNumber}", "1");

			if (!("${expandedFeedEntryNumber}" == "${expandedEntriesPerFeed}")) {
				var expandedFeedEntryNumber = MathUtil.sum("${expandedFeedEntryNumber}", "1");
			}

			AssertElementPresent(locator1 = "SOSiteHome#RSS_FEED_ENTRY_TITLE_INCREMENT");

			if (!("${expandedFeedEntryNumber}" == "${feedEntryNumber}")) {
				Click(locator1 = "SOSiteHome#RSS_FEED_ENTRY_EXPAND_BUTTON_INCREMENT");
			}

			AssertElementPresent(
				locator1 = "SOSiteHome#RSS_FEED_ENTRY_DATE_AND_TIME_INCREMENT"
			);

			AssertElementPresent(locator1 = "SOSiteHome#RSS_FEED_ENTRY_AUTHOR_INCREMENT");

			AssertElementPresent(locator1 = "SOSiteHome#RSS_FEED_ENTRY_CONTENT_INCREMENT");

			AssertElementPresent(
				locator1 = "SOSiteHome#RSS_FEED_ENTRY_CONTENT_READ_MORE_INCREMENT"
			);
		}
	}
}