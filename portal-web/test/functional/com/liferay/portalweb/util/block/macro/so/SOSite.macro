definition {
	macro acceptMemberRequestSOSite {
		SOUserBar.gotoCP(portletName = "Sites");

		Type(locator1 = "CPSites#SEARCH_FIELD", value1 = "${siteName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPSites#SEARCH_BUTTON",
			value1 = "Search"
		);

		var key_siteName = "${siteName}";

		AssertTextEquals.assertPartialText(
			locator1 = "CPSites#SITE_TABLE_NAME",
			value1 = "${siteName}"
		);

		AssertClick(locator1 = "CPSites#SITE_TABLE_ACTIONS", value1 = "Actions");

		AssertClick(
			locator1 = "CPSites#SITE_MENULIST_MANAGE_MEMBERSHIPS",
			value1 = "Manage Memberships"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPSitememberships#PENDING_MEMBERSHIP_REQUESTS_LINK",
			value1 = "There are 1 membership requests pending."
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPSitemembershipsViewmembershiprequests#NAVIGATION_PENDING",
			value1 = "Pending"
		);

		AssertElementPresent(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_DATE"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_NAME",
			value1 = "${userEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_USER_COMMENTS",
			value1 = "${userName} wishes to join ${siteName}."
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_REPLY",
			value1 = "Reply"
		);

		AssertTextEquals(
			locator1 = "CPSitemembershipsReplymembershiprequests#HEADER_TITLE",
			value1 = "Reply Membership Request for ${siteName}"
		);

		Select(
			locator1 = "CPSitemembershipsReplymembershiprequests#STATUS_SELECT",
			value1 = "Approve"
		);

		Type(
			locator1 = "CPSitemembershipsReplymembershiprequests#REPLY_COMMENTS_FIELD",
			value1 = "${siteName} Membership Approved"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPSitemembershipsReplymembershiprequests#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPSitemembershipsViewmembershiprequests#SUCCESS_MESSAGE_1",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "CPSitemembershipsViewmembershiprequests#SUCCESS_MESSAGE_2",
			value1 = "Your reply will be sent to the user by email."
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPSitemembershipsViewmembershiprequests#NAVIGATION_APPROVED",
			value1 = "Approved"
		);

		AssertElementPresent(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_DATE"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_NAME",
			value1 = "${userEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_USER_COMMENTS",
			value1 = "${userName} wishes to join ${siteName}."
		);

		AssertElementPresent(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_REPLY_DATE"
		);

		AssertTextEquals(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_REPLIER",
			value1 = "${siteOwner}"
		);

		AssertTextEquals(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_REPLY_COMMENTS",
			value1 = "${siteName} Membership Approved"
		);
	}

	macro denyMemberRequestSOSite {
		SOUserBar.gotoCP(portletName = "Sites");

		Type(locator1 = "CPSites#SEARCH_FIELD", value1 = "${siteName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPSites#SEARCH_BUTTON",
			value1 = "Search"
		);

		var key_siteName = "${siteName}";

		AssertTextEquals.assertPartialText(
