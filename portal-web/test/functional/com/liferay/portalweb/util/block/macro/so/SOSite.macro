		AssertTextEquals(locator1 = "SOSiteHome#SITE_NAME", value1 = "${siteName}");

		AssertElementNotPresent(locator1 = "SOSiteHome#SITE_JOIN_LINK");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_HOME", value1 = "Home");

		AssertTextEquals(
			locator1 = "SOSiteHome#NAVIGATION_CALENDAR",
			value1 = "Calendar"
		);

		AssertTextEquals(
			locator1 = "SOSiteHome#NAVIGATION_DOCUMENTS",
			value1 = "Documents"
		);

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_FORUMS", value1 = "Forums");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_BLOGS", value1 = "Blogs");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_WIKI", value1 = "Wiki");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_MEMBERS", value1 = "Members");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO_SITES_DIRECTORY_BUTTON");

		Select(
			locator1 = "SOUserBarSitesDirectory#SITE_CATEGORY_SELECT",
			value1 = "My Sites"
		);

		Type(
			locator1 = "SOUserBarSitesDirectory#SITE_SEARCH_FIELD",
			value1 = "${siteName}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION",
			value1 = "${siteDescription}"
		);

		Click(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName}"
		);

		AssertTextEquals(locator1 = "SOSiteHome#SITE_NAME", value1 = "${siteName}");

		AssertElementNotPresent(locator1 = "SOSiteHome#SITE_JOIN_LINK");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_HOME", value1 = "Home");

		AssertTextEquals(
			locator1 = "SOSiteHome#NAVIGATION_CALENDAR",
			value1 = "Calendar"
		);

		AssertTextEquals(
			locator1 = "SOSiteHome#NAVIGATION_DOCUMENTS",
			value1 = "Documents"
		);

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_FORUMS", value1 = "Forums");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_BLOGS", value1 = "Blogs");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_WIKI", value1 = "Wiki");

		Click.textClickAt(
			locator1 = "SOSiteHome#NAVIGATION_MEMBERS",
			value1 = "Members"
		);

		SOMembers.viewMember();
	}

	macro viewSOSiteNonMembership {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Select(locator1 = "SOUserBar#GO_TO_SITE_CATEGORY_SELECT", value1 = "All Sites");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Type(locator1 = "SOUserBar#GO_TO_SEARCH_FIELD", value1 = "${siteName}");

		if ("${siteType}" == "Private") {
			AssertTextEquals(
				locator1 = "SOUserBar#GO_TO_SITE_EMPTY",
				value1 = "There are no results."
			);

			AssertElementNotPresent(locator1 = "SOUserBar#GO_TO_SITE_NAME_LINK");
		}
		else {
			AssertElementPresent(locator1 = "SOUserBar#GO_TO_SITE_NAME_LINK");
		}

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Select(locator1 = "SOUserBar#GO_TO_SITE_CATEGORY_SELECT", value1 = "My Sites");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Type(locator1 = "SOUserBar#GO_TO_SEARCH_FIELD", value1 = "${siteName}");

		AssertTextEquals(
			locator1 = "SOUserBar#GO_TO_SITE_EMPTY",
			value1 = "There are no results."
		);

		AssertElementNotPresent(locator1 = "SOUserBar#GO_TO_SITE_NAME_LINK");

		AssertTextNotPresent(value1 = "${siteName}");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO_SITES_DIRECTORY_BUTTON");

		Select(
			locator1 = "SOUserBarSitesDirectory#SITE_CATEGORY_SELECT",
			value1 = "My Sites"
		);

		Type(
			locator1 = "SOUserBarSitesDirectory#SITE_SEARCH_FIELD",
			value1 = "${siteName}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#EMPTY_INFO_MESSAGE",
			value1 = "There are no results."
		);

		AssertTextNotPresent(value1 = "${siteName}");

		Select(
			locator1 = "SOUserBarSitesDirectory#SITE_CATEGORY_SELECT",
			value1 = "All Sites"
		);

		Type(
			locator1 = "SOUserBarSitesDirectory#SITE_SEARCH_FIELD",
			value1 = "${siteName}"
		);

		if ("${siteType}" == "Private Restricted") {
			AssertTextEquals(
				locator1 = "SOUserBarSitesDirectory#SITE_NAME",
				value1 = "${siteName}"
			);

			AssertElementNotPresent(locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK");

			AssertTextEquals(
				locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION",
				value1 = "${siteDescription}"
			);
		}
		else if ("${siteType}" == "Private") {
			AssertTextEquals(
				locator1 = "SOUserBarSitesDirectory#EMPTY_INFO_MESSAGE",
				value1 = "There are no results."
			);

			AssertTextNotPresent(value1 = "${siteName}");
		}
		else {
			AssertTextEquals(
				locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
				value1 = "${siteName}"
			);

			AssertTextEquals(
				locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION",
				value1 = "${siteDescription}"
			);
		}

		if (!("${siteType}" == "Private")) {
			if ("${siteType}" == "Open") {
				AssertElementPresent(locator1 = "SOUserBarSitesDirectory#JOIN_SITE_ICON");
			}
			else {
				AssertElementPresent(
					locator1 = "SOUserBarSitesDirectory#REQUEST_MEMBERSHIP_ICON"
				);
			}
		}

		if (!(contains("${siteType}", "Private"))) {
			Click(
				locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
				value1 = "${siteName}"
			);

			AssertTextEquals(locator1 = "SOSiteHome#SITE_NAME", value1 = "${siteName}");

			if ("${siteType}" == "Open") {
				AssertTextEquals(locator1 = "SOSiteHome#SITE_JOIN_LINK", value1 = "Join Site");
			}
			else {
				AssertTextEquals(
					locator1 = "SOSiteHome#SITE_JOIN_LINK",
					value1 = "Request Membership"
				);
			}

			AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_HOME", value1 = "Home");

			AssertTextEquals(
				locator1 = "SOSiteHome#NAVIGATION_CALENDAR",
				value1 = "Calendar"
			);

			AssertTextEquals(
				locator1 = "SOSiteHome#NAVIGATION_DOCUMENTS",
				value1 = "Documents"
			);

			AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_FORUMS", value1 = "Forums");

			AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_BLOGS", value1 = "Blogs");

			AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_WIKI", value1 = "Wiki");

			Click.textClickAt(
				locator1 = "SOSiteHome#NAVIGATION_MEMBERS",
				value1 = "Members"
			);

			AssertTextEquals(
				locator1 = "SOMembers#MEMBERS_LINK_ALL",
				value1 = "View all 1 users."
			);

			Type(locator1 = "SOMembers#MEMBERS_LIST_SEARCH", value1 = "${userEmailAddress}");

			AssertTextEquals(
				locator1 = "SOMembers#MEMBERS_LIST_EMPTY",
				value1 = "There are no results."
			);

			AssertTextNotPresent(value1 = "${userListName}");
		}
	}
}