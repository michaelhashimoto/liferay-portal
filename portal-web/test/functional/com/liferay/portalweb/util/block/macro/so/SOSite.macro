		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO_SITES_DIRECTORY_BUTTON");

		Select(
