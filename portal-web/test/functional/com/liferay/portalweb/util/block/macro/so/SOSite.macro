		AssertTextEquals(
			locator1 = "CPSitemembershipsViewmembershiprequests#SUCCESS_MESSAGE_2",
			value1 = "Your reply will be sent to the user by email."
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPSitemembershipsViewmembershiprequests#NAVIGATION_DENIED",
			value1 = "Denied"
		);

		AssertElementPresent(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_DATE"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_NAME",
			value1 = "${userEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_USER_COMMENTS",
			value1 = "${userName} wishes to join ${siteName}."
		);

		AssertElementPresent(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_REPLY_DATE"
		);

		AssertTextEquals(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_REPLIER",
			value1 = "${siteOwner}"
		);

		AssertTextEquals(
			locator1 = "CPSitemembershipsViewmembershiprequests#USER_TABLE_REPLY_COMMENTS",
			value1 = "${siteName} Membership Denied"
		);
	}

	macro joinSitePG {
		AssertTextEquals(locator1 = "SOSiteHome#SITE_NAME", value1 = "${siteName}");

		AssertClick(locator1 = "SOSiteHome#SITE_JOIN_LINK", value1 = "Join Site");

		AssertElementNotPresent(locator1 = "SOSiteHome#SITE_JOIN_LINK");
	}

	macro requestMembershipPG {
		AssertTextEquals(locator1 = "SOSiteHome#SITE_NAME", value1 = "${siteName}");

		AssertClick(
			locator1 = "SOSiteHome#SITE_JOIN_LINK",
			value1 = "Request Membership"
		);

		AssertTextEquals(
			locator1 = "SOSiteHome#SITE_MEMBERSHIP_REQUESTED",
			value1 = "Membership Requested"
		);
	}

	macro viewSOSite {
		SOUserBar.searchSOSite();

		Click(locator1 = "SOUserBar#GO_TO_SITE_NAME_LINK");

		AssertTextEquals(locator1 = "SOSiteHome#SITE_NAME", value1 = "${siteName}");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_HOME", value1 = "Home");

		AssertTextEquals(
			locator1 = "SOSiteHome#NAVIGATION_CALENDAR",
			value1 = "Calendar"
		);

		AssertTextEquals(
			locator1 = "SOSiteHome#NAVIGATION_DOCUMENTS",
			value1 = "Documents"
		);

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_FORUMS", value1 = "Forums");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_BLOGS", value1 = "Blogs");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_WIKI", value1 = "Wiki");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_MEMBERS", value1 = "Members");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO_SITES_DIRECTORY_BUTTON");

		if ("${siteType}" == "Private") {
			Select(
				locator1 = "SOUserBarSitesDirectory#SITE_CATEGORY_SELECT",
				value1 = "My Sites"
			);
		}
		else {
			Select(
				locator1 = "SOUserBarSitesDirectory#SITE_CATEGORY_SELECT",
				value1 = "All Sites"
			);
		}

		Type(
			locator1 = "SOUserBarSitesDirectory#SITE_SEARCH_FIELD",
			value1 = "${siteName}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION",
			value1 = "${siteDescription}"
		);

		Click(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName}"
		);

		AssertTextEquals(locator1 = "SOSiteHome#SITE_NAME", value1 = "${siteName}");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_HOME", value1 = "Home");

		AssertTextEquals(
			locator1 = "SOSiteHome#NAVIGATION_CALENDAR",
			value1 = "Calendar"
		);

		AssertTextEquals(
			locator1 = "SOSiteHome#NAVIGATION_DOCUMENTS",
			value1 = "Documents"
		);

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_FORUMS", value1 = "Forums");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_BLOGS", value1 = "Blogs");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_WIKI", value1 = "Wiki");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_MEMBERS", value1 = "Members");

		SOUserBar.gotoCP(portletName = "Sites");

		Type(locator1 = "CPSites#SEARCH_FIELD", value1 = "${siteName}");

		Click(locator1 = "CPSites#SEARCH_BUTTON");

		var key_siteName = "${siteName}";

		AssertTextEquals.assertPartialText(
			locator1 = "CPSites#SITE_TABLE_NAME",
			value1 = "${siteName}"
		);

		Click(locator1 = "CPSites#SITE_TABLE_NAME");

		if (contains("${siteType}", "Private")) {
			AssertChecked(locator1 = "CPSitesEdit#PRIVATE_PAGE_PROPAGATION_CHECKBOX");
		}
		else {
			AssertChecked(locator1 = "CPSitesEdit#PUBLIC_PAGE_PROPAGATION_CHECKBOX");
		}

		AssertSelectedLabel(
			locator1 = "CPSitesEdit#APPLICATION_ADAPTER_SELECT",
			value1 = "Social Office EE Hook"
		);
	}

	macro viewSOSiteFavorite {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

