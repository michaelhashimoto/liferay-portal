		Type(
			locator1 = "SOUserBarSitesDirectory#SITE_SEARCH_FIELD",
			value1 = "${siteName}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION",
			value1 = "${siteDescription}"
		);

		AssertElementPresent(locator1 = "SOUserBarSitesDirectory#UNFAVORITE_SITE_ICON");

		AssertElementNotPresent(locator1 = "SOUserBarSitesDirectory#FAVORITE_SITE_ICON");

		Click(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName}"
		);

		AssertTextEquals(locator1 = "SOSiteHome#SITE_NAME", value1 = "${siteName}");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_HOME", value1 = "Home");

		AssertTextEquals(
			locator1 = "SOSiteHome#NAVIGATION_CALENDAR",
			value1 = "Calendar"
		);

		AssertTextEquals(
			locator1 = "SOSiteHome#NAVIGATION_DOCUMENTS",
			value1 = "Documents"
		);

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_FORUMS", value1 = "Forums");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_BLOGS", value1 = "Blogs");

		AssertTextEquals(locator1 = "SOSiteHome#NAVIGATION_WIKI", value1 = "Wiki");
	}

	macro viewSOSiteMembership {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Select(locator1 = "SOUserBar#GO_TO_SITE_CATEGORY_SELECT", value1 = "My Sites");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Type(locator1 = "SOUserBar#GO_TO_SEARCH_FIELD", value1 = "${siteName}");

		AssertTextEquals(
			locator1 = "SOUserBar#GO_TO_SITE_NAME_LINK",
