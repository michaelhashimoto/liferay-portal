definition {
	var pageTemplateActive = "Yes";

	macro addCP {
		AssertClick.assertTextClickAt(
			locator1 = "CPPagetemplates#ADD_BUTTON",
			value1 = "Add"
		);

		Type(locator1 = "CPPagetemplatesAdd#NAME_FIELD", value1 = "${pageTemplateName}");

		if ("${pageTemplateActive}" == "No") {
			Uncheck(locator1 = "CPPagetemplatesAdd#ACTIVE_CHECKBOX");
		}
		else {
			Check(locator1 = "CPPagetemplatesAdd#ACTIVE_CHECKBOX");
		}

		AssertClick.assertValueClickAt(
			locator1 = "CPPagetemplatesAdd#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPPagetemplates#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "CPPagetemplates#PAGE_TEMPLATE_TABLE_NAME_4",
			value1 = "${pageTemplateName}"
		);

		AssertTextEquals(
			locator1 = "CPPagetemplates#PAGE_TEMPLATE_TABLE_ACTIVE_4",
			value1 = "${pageTemplateActive}"
		);
	}

	macro editCP {
		AssertTextEquals(
			locator1 = "CPPagetemplates#PAGE_TEMPLATE_TABLE_NAME_4",
			value1 = "${pageTemplateName}"
		);

		AssertClick(
			locator1 = "CPPagetemplates#PAGE_TEMPLATE_TABLE_ACTIONS_4",
			value1 = "Actions"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPPagetemplates#PAGE_TEMPLATE_MENULIST_EDIT",
			value1 = "Edit"
		);

		Type(
			locator1 = "CPPagetemplatesEdit#NAME_FIELD",
			value1 = "${pageTemplateNameEdit}"
		);

		if ("${pageTemplateActiveEdit}" == "No") {
			Uncheck(locator1 = "CPPagetemplatesAdd#ACTIVE_CHECKBOX");
		}
		else {
			Check(locator1 = "CPPagetemplatesAdd#ACTIVE_CHECKBOX");
		}

		AssertTextEquals(
			locator1 = "CPPagetemplatesEdit#CONFIGURATION_OPEN",
			value1 = "Open Page Template"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPPagetemplatesEdit#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPPagetemplates#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "CPPagetemplates#PAGE_TEMPLATE_TABLE_NAME_4",
			value1 = "${pageTemplateNameEdit}"
		);

		AssertTextEquals(
			locator1 = "CPPagetemplates#PAGE_TEMPLATE_TABLE_ACTIVE_4",
			value1 = "${pageTemplateActiveEdit}"
		);
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Page Templates");

		while (IsElementPresent(locator1 = "CPPagetemplates#PAGE_TEMPLATE_TABLE_ACTIONS_4", value1 = "Actions")) {
			AssertClick(
				locator1 = "CPPagetemplates#PAGE_TEMPLATE_TABLE_ACTIONS_4",
				value1 = "Actions"
			);

			AssertClickNoError(
				locator1 = "CPPagetemplates#PAGE_TEMPLATE_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete this?");

			AssertTextEquals(
				locator1 = "CPPagetemplates#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}
	}
}