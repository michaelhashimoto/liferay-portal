<definition>
	<var name="pageTemplateActive" value="Yes" />

	<command name="addCP">
		<execute function="AssertClick#assertTextClickAt" locator1="CPPagetemplates#ADD_BUTTON" value1="Add" />

		<execute function="Type" locator1="CPPagetemplatesAdd#NAME_FIELD" value1="${pageTemplateName}" />

		<if>
			<equals arg1="${pageTemplateActive}" arg2="No" />
			<then>
				<execute function="Uncheck" locator1="CPPagetemplatesAdd#ACTIVE_CHECKBOX" />
			</then>
			<else>
				<execute function="Check" locator1="CPPagetemplatesAdd#ACTIVE_CHECKBOX" />
			</else>
		</if>

		<execute function="AssertClick#assertValueClickAt" locator1="CPPagetemplatesAdd#SAVE_BUTTON" value1="Save" />

		<execute function="AssertTextEquals" locator1="CPPagetemplates#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals" locator1="CPPagetemplates#PAGE_TEMPLATE_TABLE_NAME_4" value1="${pageTemplateName}" />
		<execute function="AssertTextEquals" locator1="CPPagetemplates#PAGE_TEMPLATE_TABLE_ACTIVE_4" value1="${pageTemplateActive}" />
	</command>

	<command name="editCP">
		<execute function="AssertTextEquals" locator1="CPPagetemplates#PAGE_TEMPLATE_TABLE_NAME_4" value1="${pageTemplateName}" />
		<execute function="AssertClick" locator1="CPPagetemplates#PAGE_TEMPLATE_TABLE_ACTIONS_4" value1="Actions" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPPagetemplates#PAGE_TEMPLATE_MENULIST_EDIT" value1="Edit" />

		<execute function="Type" locator1="CPPagetemplatesEdit#NAME_FIELD" value1="${pageTemplateNameEdit}" />

		<if>
			<equals arg1="${pageTemplateActiveEdit}" arg2="No" />
			<then>
				<execute function="Uncheck" locator1="CPPagetemplatesAdd#ACTIVE_CHECKBOX" />
			</then>
			<else>
				<execute function="Check" locator1="CPPagetemplatesAdd#ACTIVE_CHECKBOX" />
			</else>
		</if>

		<execute function="AssertTextEquals" locator1="CPPagetemplatesEdit#CONFIGURATION_OPEN" value1="Open Page Template" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPPagetemplatesEdit#SAVE_BUTTON" value1="Save" />

		<execute function="AssertTextEquals" locator1="CPPagetemplates#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals" locator1="CPPagetemplates#PAGE_TEMPLATE_TABLE_NAME_4" value1="${pageTemplateNameEdit}" />
		<execute function="AssertTextEquals" locator1="CPPagetemplates#PAGE_TEMPLATE_TABLE_ACTIVE_4" value1="${pageTemplateActiveEdit}" />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Page Templates" />
		</execute>

		<while>
			<condition function="IsElementPresent" locator1="CPPagetemplates#PAGE_TEMPLATE_TABLE_ACTIONS_4" value1="Actions" />
			<then>
				<execute function="AssertClick" locator1="CPPagetemplates#PAGE_TEMPLATE_TABLE_ACTIONS_4" value1="Actions" />
				<execute function="AssertClickNoError" locator1="CPPagetemplates#PAGE_TEMPLATE_MENULIST_DELETE" value1="Delete" />
				<execute function="Confirm" value1="Are you sure you want to delete this?" />
				<execute function="AssertTextEquals" locator1="CPPagetemplates#SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</while>
	</command>
</definition>