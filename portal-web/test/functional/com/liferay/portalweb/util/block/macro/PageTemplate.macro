<definition>
	<var name="pageTemplateActive" value="Yes" />

	<command name="addCP">
		<execute action="CPPagetemplates#assertClick" locator1="ADD_BUTTON" value1="Add" />

		<execute action="CPPagetemplatesAdd#type" locator1="NAME_FIELD" value1="${pageTemplateName}" />

		<if>
			<equals arg1="${pageTemplateActive}" arg2="No" />
			<then>
				<execute action="CPPagetemplatesAdd#uncheck" locator1="ACTIVE_CHECKBOX" />
			</then>
			<else>
				<execute action="CPPagetemplatesAdd#check" locator1="ACTIVE_CHECKBOX" />
			</else>
		</if>

		<execute action="CPPagetemplatesAdd#assertClick" locator1="SAVE_BUTTON" value1="Save" />

		<execute action="CPPagetemplates#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="CPPagetemplates#assertTextEquals" locator1="PAGE_TEMPLATE_TABLE_NAME_4" value1="${pageTemplateName}" />
		<execute action="CPPagetemplates#assertTextEquals" locator1="PAGE_TEMPLATE_TABLE_ACTIVE_4" value1="${pageTemplateActive}" />
	</command>

	<command name="editCP">
		<execute action="CPPagetemplates#assertTextEquals" locator1="PAGE_TEMPLATE_TABLE_NAME_4" value1="${pageTemplateName}" />
		<execute action="CPPagetemplates#assertClick" locator1="PAGE_TEMPLATE_TABLE_ACTIONS_4" value1="Actions" />
		<execute action="CPPagetemplates#assertClick" locator1="PAGE_TEMPLATE_MENULIST_EDIT" value1="Edit" />

		<execute action="CPPagetemplatesEdit#type" locator1="NAME_FIELD" value1="${pageTemplateNameEdit}" />

		<if>
			<equals arg1="${pageTemplateActiveEdit}" arg2="No" />
			<then>
				<execute action="CPPagetemplatesAdd#uncheck" locator1="ACTIVE_CHECKBOX" />
			</then>
			<else>
				<execute action="CPPagetemplatesAdd#check" locator1="ACTIVE_CHECKBOX" />
			</else>
		</if>

		<execute action="CPPagetemplatesEdit#assertTextEquals" locator1="CONFIGURATION_OPEN" value1="Open Page Template" />
		<execute action="CPPagetemplatesEdit#assertClick" locator1="SAVE_BUTTON" value1="Save" />

		<execute action="CPPagetemplates#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="CPPagetemplates#assertTextEquals" locator1="PAGE_TEMPLATE_TABLE_NAME_4" value1="${pageTemplateNameEdit}" />
		<execute action="CPPagetemplates#assertTextEquals" locator1="PAGE_TEMPLATE_TABLE_ACTIVE_4" value1="${pageTemplateActiveEdit}" />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Page Templates" />
		</execute>

		<while>
			<condition action="CPPagetemplates#isElementPresent" locator1="PAGE_TEMPLATE_TABLE_ACTIONS_4" value1="Actions" />
			<then>
				<execute action="CPPagetemplates#assertClick" locator1="PAGE_TEMPLATE_TABLE_ACTIONS_4" value1="Actions" />
				<execute action="CPPagetemplates#assertClickNoError" locator1="PAGE_TEMPLATE_MENULIST_DELETE" value1="Delete" />
				<execute action="CPPagetemplates#confirm" locator1="CONFIRMATION" value1="Are you sure you want to delete this?" />
				<execute action="CPPagetemplates#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</while>
	</command>
</definition>