definition {
	macro tearDownDocumentViewPG {
		SOUser.firstLoginPG();

		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MY_DOCUMENTS",
			value1 = "My Documents"
		);

		Click(
			locator1 = "PGDocumentsandmedia#TOOLBAR_DISPLAY_ICON",
			value1 = "Icon Display"
		);
	}

	macro tearDownPG {
		SOUser.firstLoginPG();

		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MY_DOCUMENTS",
			value1 = "My Documents"
		);

		if (IsElementPresent(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_GENERIC")) {
			Check(locator1 = "PGDocumentsandmedia#TOOLBAR_SELECT_ALL_CHECKBOX");

			AssertClick(
				locator1 = "PGDocumentsandmedia#TOOLBAR_ACTIONS",
				value1 = "Actions"
			);

			AssertElementPresent(locator1 = "PGDocumentsandmedia#ACTIONS_MENULIST_DELETE");

			AssertClickNoError(
				locator1 = "PGDocumentsandmedia#ACTIONS_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete the selected entries?");

			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}
	}

	macro viewPGDisplayView {
		var key_dmDocumentTitle = "${dmDocumentTitle}";

		AssertElementPresent(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

		if ("${workflow}" == "Draft") {
			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_TITLE",
				value1 = "${dmDocumentTitle} (Draft)"
			);
		}
		else if ("${workflow}" == "Checkedout") {
			AssertElementPresent(
				locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_LOCKED_ICON"
			);

			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_TITLE",
				value1 = "${dmDocumentTitle} (Draft)"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}

		Click(
			locator1 = "PGDocumentsandmedia#TOOLBAR_DISPLAY_DESCRIPTIVE",
			value1 = "Descriptive Display"
		);

		AssertElementPresent(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

		if ("${workflow}" == "Draft") {
			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_TITLE",
				value1 = "${dmDocumentTitle} (Draft)"
			);
		}
		else if ("${workflow}" == "Checkedout") {
			AssertElementPresent(
				locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_LOCKED_ICON"
			);

			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_TITLE",
				value1 = "${dmDocumentTitle} (Draft)"
			);
		}
		else if ("${workflow}" == "Locked") {
			AssertElementPresent(
				locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_LOCKED_ICON"
			);

			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}

		AssertTextEquals(
			locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_DESCRIPTION",
			value1 = "${dmDocumentDescription}"
		);

		Click(
			locator1 = "PGDocumentsandmedia#TOOLBAR_DISPLAY_LIST",
			value1 = "List Display"
		);

		if ("${workflow}" == "Draft") {
			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#LIST_ENTRIES_DOCUMENT_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}
		else if ("${workflow}" == "Checkedout") {
			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#LIST_ENTRIES_DOCUMENT_TITLE",
				value1 = "${dmDocumentTitle}"
			);

			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#LIST_ENTRIES_DOCUMENT_WORKFLOW",
				value1 = "(Draft)"
			);

			AssertElementPresent(
				locator1 = "PGDocumentsandmedia#LIST_ENTRIES_DOCUMENT_LOCKED_ICON"
			);
		}
		else if ("${workflow}" == "Locked") {
			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#LIST_ENTRIES_DOCUMENT_TITLE",
				value1 = "${dmDocumentTitle}"
			);

			AssertElementPresent(
				locator1 = "PGDocumentsandmedia#LIST_ENTRIES_DOCUMENT_LOCKED_ICON"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#LIST_ENTRIES_DOCUMENT_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}

		Click(
			locator1 = "PGDocumentsandmedia#TOOLBAR_DISPLAY_ICON",
			value1 = "Icon Display"
		);

		AssertTextEquals(
			locator1 = "PGDocumentsandmedia#BREADCRUMB_HOME",
			value1 = "Home"
		);

		if (("${workflow}" == "Draft") || ("${workflow}" == "Checkedout")) {
			AssertClick(
				locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_TITLE",
				value1 = "${dmDocumentTitle} (Draft)"
			);
		}
		else {
			AssertClick(
				locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}

		SODocuments.viewPGDocumentDetailView();
	}

	macro viewPGDocumentDetailView {
		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#TOOLBAR_DOWNLOAD_BUTTON",
			value1 = "Download"
		);

		if (!("${workflow}" == "Locked")) {
			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#TOOLBAR_EDIT_BUTTON",
				value1 = "Edit"
			);

			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#TOOLBAR_MOVE_BUTTON",
				value1 = "Move"
			);
		}

		if ("${workflow}" == "Checkedout") {
			AssertElementNotPresent(
				locator1 = "PGDocumentsandmediaDocument#TOOLBAR_CHECKOUT_BUTTON",
				value1 = "Checkout"
			);

			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#TOOLBAR_CHECKIN_BUTTON",
				value1 = "Checkin"
			);

			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#TOOLBAR_CANCEL_CHECKOUT_BUTTON",
				value1 = "Cancel Checkout"
			);
		}
		else if ("${workflow}" == "Locked") {
			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#TOOLBAR_DOWNLOAD_BUTTON",
				value1 = "Download"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#TOOLBAR_CHECKOUT_BUTTON",
				value1 = "Checkout"
			);

			AssertElementNotPresent(
				locator1 = "PGDocumentsandmediaDocument#TOOLBAR_CHECKIN_BUTTON"
			);

			AssertElementNotPresent(
				locator1 = "PGDocumentsandmediaDocument#TOOLBAR_CANCEL_CHECKOUT_BUTTON"
			);
		}

		if (!("${workflow}" == "Locked")) {
			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#TOOLBAR_PERMISSIONS_BUTTON",
				value1 = "Permissions"
			);

			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#TOOLBAR_DELETE_BUTTON",
				value1 = "Delete"
			);
		}

		AssertTextEquals(
			locator1 = "SODocuments#DOCUMENT_INFO_TITLE",
			value1 = "${dmDocumentTitle}"
		);

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_DESCRIPTION",
			value1 = "${dmDocumentDescription}"
		);

		AssertElementPresent(
			locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_THUMBNAIL"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_UPLOADED_BY",
			value1 = "Uploaded by ${dmDocumentUploader}"
		);

		AssertElementPresent(
			locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_RATING",
			value1 = "Ratings"
		);

		AssertTextEquals(
			locator1 = "SODocuments#VERSION_HISTORY_TITLE",
			value1 = "Version History"
		);

		if (!("${workflow}" == "Draft")) {
			if ("${workflow}" == "Checkedout") {
				var versionNumber = "PWC";

				AssertTextEquals(
					locator1 = "SODocuments#VERSION_HISTORY_NUMBER",
					value1 = "Version PWC"
				);

				AssertTextEquals(
					locator1 = "SODocuments#VERSION_HISTORY_UPLOADER_NAME",
					value1 = "By: ${dmDocumentUploader}"
				);

				AssertElementPresent(locator1 = "SODocuments#VERSION_HISTORY_DATE");

				AssertTextEquals(
					locator1 = "SODocuments#VERSION_HISTORY_SIZE",
					value1 = "Size: ${dmDocumentSize}"
				);
			}
			else {
				var versionNumber = "${dmDocumentVersionNumber}";

				AssertTextEquals(
					locator1 = "SODocuments#VERSION_HISTORY_NUMBER",
					value1 = "Version ${dmDocumentVersionNumber}"
				);

				AssertTextEquals(
					locator1 = "SODocuments#VERSION_HISTORY_UPLOADER_NAME",
					value1 = "By: ${dmDocumentUploader}"
				);

				AssertElementPresent(locator1 = "SODocuments#VERSION_HISTORY_DATE");

				AssertTextEquals(
					locator1 = "SODocuments#VERSION_HISTORY_SIZE",
					value1 = "Size: ${dmDocumentSize}"
				);

				if (isSet(dmDocumentPreviousVersionNumber)) {
					var versionNumber = "${dmDocumentPreviousVersionNumber}";

					AssertTextEquals(
						locator1 = "SODocuments#VERSION_HISTORY_NUMBER",
						value1 = "Version ${dmDocumentPreviousVersionNumber}"
					);

					AssertTextEquals(
						locator1 = "SODocuments#VERSION_HISTORY_UPLOADER_NAME",
						value1 = "By: ${dmDocumentPreviousUploader}"
					);

					AssertElementPresent(locator1 = "SODocuments#VERSION_HISTORY_DATE");

					AssertTextEquals(
						locator1 = "SODocuments#VERSION_HISTORY_SIZE",
						value1 = "Size: ${dmDocumentPreviousSize}"
					);
				}
			}
		}

		if ("${workflow}" == "Draft") {
			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#DOCUMENT_DETAILS_VERSION",
				value1 = "Version ${dmDocumentVersionNumber}"
			);

			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#DOCUMENT_DETAILS_WORKFLOW",
				value1 = "Status: Draft"
			);
		}
		else if ("${workflow}" == "Checkedout") {
			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#DOCUMENT_DETAILS_VERSION",
				value1 = "Version PWC"
			);

			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#DOCUMENT_DETAILS_WORKFLOW",
				value1 = "Status: Draft"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#DOCUMENT_DETAILS_VERSION",
				value1 = "Version ${dmDocumentVersionNumber}"
			);

			AssertTextEquals(
				locator1 = "PGDocumentsandmediaDocument#DOCUMENT_DETAILS_WORKFLOW",
				value1 = "Status: Approved"
			);
		}

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#DOCUMENT_DETAILS_UPLOADER",
			value1 = "Last Updated by ${dmDocumentUploader}"
		);

		AssertElementPresent(
			locator1 = "PGDocumentsandmediaDocument#DOCUMENT_DETAILS_DATE"
		);

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#DOCUMENT_DETAILS_DOWNLOAD",
			value1 = "Download (${dmDocumentSize})"
		);

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#DOCUMENT_DETAILS_URL",
			value1 = "Get URL or WebDAV URL."
		);
	}
}