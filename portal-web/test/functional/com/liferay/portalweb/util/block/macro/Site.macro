<definition>
	<var name="siteMember" value="User" />
	<var name="siteType" value="Open" />

	<command name="addBlankCP">
		<execute macro="Site#addCP">
			<var name="membershipType" value="${membershipType}" />
			<var name="siteName" value="${siteName}" />
			<var name="siteType" value="Blank" />
		</execute>
	</command>

	<command name="addCommunityCP">
		<execute macro="Site#addCP">
			<var name="membershipType" value="${membershipType}" />
			<var name="siteName" value="${siteName}" />
			<var name="siteType" value="Community" />
		</execute>
	</command>

	<command name="addCP">
		<execute function="AssertClick" locator1="CPSites#ADD" value1="Add" />

		<if>
			<equals arg1="${siteType}" arg2="Blank" />
			<then>
				<execute function="AssertClick#assertTextClickAt" locator1="CPSites#ADD_BLANK_SITE" value1="Blank Site" />
			</then>
			<elseif>
				<equals arg1="${siteType}" arg2="Community" />
				<then>
					<execute function="AssertClick" locator1="CPSites#ADD_COMMUNITY_SITE" value1="Community Site" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${siteType}" arg2="Intranet" />
				<then>
					<execute function="AssertClick" locator1="CPSites#ADD_INTRANET_SITE" value1="Intranet Site" />
				</then>
			</elseif>
			<else>
				<fail message="Invalid var siteType. Must be (Blank|Community|Intranet)." />
			</else>
		</if>

		<execute function="Type" locator1="CPSitesAdd#DETAILS_NAME" value1="${siteName}" />

		<if>
			<equals arg1="${membershipType}" arg2="Private" />
			<then>
				<execute function="Select" locator1="CPSitesAdd#DETAILS_MEMBERSHIP_TYPE_SELECT" value1="Private" />
			</then>
			<elseif>
				<equals arg1="${membershipType}" arg2="Restricted" />
				<then>
					<execute function="Select" locator1="CPSitesAdd#DETAILS_MEMBERSHIP_TYPE_SELECT" value1="Restricted" />
				</then>
			</elseif>
		</if>

		<execute function="AssertClick#assertValueClickAt" locator1="CPSitesAdd#MENU_SAVE" value1="Save" />

		<execute function="AssertClick#assertValueClickAt" locator1="CPSitesAdd#MENU_SAVE" value1="Save" />

		<execute function="AssertTextEquals" locator1="CPSitesEdit#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals" locator1="CPSitesEdit#HEADER" value1="${siteName}" />
	</command>

	<command name="addIntranetCP">
		<execute macro="Site#addCP">
			<var name="membershipType" value="${membershipType}" />
			<var name="siteName" value="${siteName}" />
			<var name="siteType" value="Intranet" />
		</execute>
	</command>

	<command name="addMemberCP">
		<execute function="Type" locator1="CPSites#SEARCH_FIELD" value1="${siteName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPSites#SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals#assertPartialText" locator1="CPSites#SITE_TABLE_NAME" value1="${siteName}" />
		<execute function="AssertClick" locator1="CPSites#SITE_TABLE_ACTIONS" value1="Actions" />
		<execute function="AssertClick" locator1="CPSites#SITE_MENULIST_MANAGE_MEMBERSHIPS" value1="Manage Memberships" />

		<execute function="AssertClick" locator1="CPSitememberships#TOOLBAR_ADD_MEMBERS" value1="Add Members" />
		<execute function="AssertClick" locator1="CPSitememberships#ADD_MEMBERS_MENULIST_USER" value1="User" />

		<execute function="Type" locator1="CPSitemembershipsAddmembers#SEARCH_FIELD" value1="${userScreenName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPSitemembershipsAddmembers#SEARCH_BUTTON" value1="Search" />

		<if>
			<isset var="userMiddleName" />
			<then>
				<execute function="AssertTextEquals" locator1="CPSitemembershipsAddmembers#USER_TABLE_NAME" value1="${userFirstName} ${userMiddleName} ${userLastName}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="CPSitemembershipsAddmembers#USER_TABLE_NAME" value1="${userFirstName} ${userLastName}" />
			</else>
		</if>

		<execute function="AssertTextEquals" locator1="CPSitemembershipsAddmembers#USER_TABLE_SCREEN_NAME" value1="${userScreenName}" />
		<execute function="Check" locator1="CPSitemembershipsAddmembers#USER_TABLE_CHECKBOX" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPSitemembershipsAddmembers#SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="CPSitemembershipsAddmembers#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="assignRoleCP">
		<execute function="Type" locator1="CPSites#SEARCH_FIELD" value1="${siteName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPSites#SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals#assertPartialText" locator1="CPSites#SITE_TABLE_NAME" value1="${siteName}" />
		<execute function="AssertClick" locator1="CPSites#SITE_TABLE_ACTIONS" value1="Actions" />
		<execute function="AssertClick" locator1="CPSites#SITE_MENULIST_MANAGE_MEMBERSHIPS" value1="Manage Memberships" />

		<execute function="AssertClick" locator1="CPSitememberships#TOOLBAR_ADD_SITE_ROLES_TO" value1="Add Site Roles to" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPSitememberships#ADD_SITE_ROLES_TO_MENULIST_USERS" value1="Users" />

		<execute function="Type" locator1="CPSitemembershipsAssignuserroles#ROLES_SEARCH_FIELD" value1="${searchTerm}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPSitemembershipsAssignuserroles#ROLES_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals" locator1="CPSitemembershipsAssignuserroles#ROLE_TABLE_TITLE_1" value1="${roleName}" />
		<execute function="AssertClick" locator1="CPSitemembershipsAssignuserroles#ROLE_TABLE_TITLE_1" value1="${roleName}" />

		<execute function="AssertClick#assertTextClickAt" locator1="CPSitemembershipsAssignuserrolesUser#AVAILABLE" value1="Available" />
		<execute function="Type" locator1="CPSitemembershipsAssignuserrolesUser#BASIC_SEARCH_FIELD" value1="${userScreenName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPSitemembershipsAssignuserrolesUser#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals" locator1="CPSitemembershipsAssignuserrolesUser#USER_TABLE_SCREEN_NAME_1" value1="${userScreenName}" />
		<execute function="Check" locator1="CPSitemembershipsAssignuserrolesUser#USER_TABLE_CHECKBOX_1" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPSitemembershipsAssignuserrolesUser#UPDATE_ASSOCIATIONS_BUTTON" value1="Update Associations" />
		<execute function="AssertTextEquals" locator1="CPSitemembershipsAssignuserrolesUser#SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<execute function="AssertClick#assertTextClickAt" locator1="CPSitemembershipsAssignuserrolesUser#CURRENT" value1="Current" />
		<execute function="AssertChecked" locator1="CPSitemembershipsAssignuserrolesUser#USER_TABLE_CHECKBOX_1" />

		<if>
			<isset var="userMiddleName" />
			<then>
				<execute function="AssertTextEquals" locator1="CPSitemembershipsAssignuserrolesUser#USER_TABLE_USER_NAME_1" value1="${userFirstName} ${userMiddleName} ${userLastName}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="CPSitemembershipsAssignuserrolesUser#USER_TABLE_USER_NAME_1" value1="${userFirstName} ${userLastName}" />
			</else>
		</if>

		<execute function="AssertTextEquals" locator1="CPSitemembershipsAssignuserrolesUser#USER_TABLE_SCREEN_NAME_1" value1="${userScreenName}" />
	</command>

	<command name="deleteCP">
		<execute function="Type" locator1="CPSites#SEARCH_FIELD" value1="Name" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPSites#SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals#assertPartialText" locator1="CPSites#SITE_TABLE_NAME" value1="${siteName}" />
		<execute function="AssertClick" locator1="CPSites#SITE_TABLE_ACTIONS" value1="Actions" />
		<execute function="AssertClickNoError" locator1="CPSites#SITE_MENULIST_DELETE" value1="Delete" />
		<execute function="Confirm" value1="Are you sure you want to delete this?" />
		<execute function="AssertTextEquals" locator1="CPSites#INFO_MESSAGE" value1="No sites were found." />
		<execute function="AssertTextNotPresent" value1="${siteName}" />
	</command>

	<command name="removeMemberCP">
		<execute function="Type" locator1="CPSites#SEARCH_FIELD" value1="${siteName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPSites#SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals#assertPartialText" locator1="CPSites#SITE_TABLE_NAME" value1="${siteName}" />
		<execute function="AssertClick" locator1="CPSites#SITE_TABLE_ACTIONS" value1="Actions" />
		<execute function="AssertClick" locator1="CPSites#SITE_MENULIST_MANAGE_MEMBERSHIPS" value1="Manage Memberships" />

		<execute function="Type" locator1="CPSitememberships#USER_SEARCH_FIELD" value1="${userScreenName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPSitememberships#USER_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals" locator1="CPSitememberships#USER_TABLE_NAME_1" value1="${userFirstName} ${userLastName}" />
		<execute function="AssertTextEquals" locator1="CPSitememberships#USER_TABLE_SCREEN_NAME_1" value1="${userScreenName}" />
		<execute function="AssertClick" locator1="CPSitememberships#USER_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="AssertClick" locator1="CPSitememberships#USER_MENULIST_REMOVE_MEMBERSHIP" value1="Remove Membership" />

		<execute function="AssertTextEquals" locator1="CPSitemembershipsAddmembers#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Sites" />
		</execute>

		<execute function="Type" locator1="CPSites#SEARCH_FIELD" value1="Name" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPSites#SEARCH_BUTTON" value1="Search" />

		<while>
			<condition function="IsElementPresent" locator1="CPSites#SITE_TABLE_ACTIONS" />
			<then>
				<execute function="AssertClick" locator1="CPSites#SITE_TABLE_ACTIONS" value1="Actions" />
				<execute function="AssertClickNoError" locator1="CPSites#SITE_MENULIST_DELETE" value1="Delete" />
				<execute function="Confirm" value1="Are you sure you want to delete this?" />
			</then>
		</while>
	</command>

	<command name="viewCP">
		<execute function="Type" locator1="CPSites#SEARCH_FIELD" value1="${siteName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPSites#SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals#assertPartialText" locator1="CPSites#SITE_TABLE_NAME" value1="${siteName}" />
		<execute function="AssertTextEquals" locator1="CPSites#SITE_TABLE_TYPE" value1="${siteType}" />

		<if>
			<equals arg1="${siteMember}" arg2="Organization" />
			<then>
				<execute function="AssertTextEquals" locator1="CPSites#SITE_TABLE_MEMBERS_ORGS" value1="1 ${siteMember}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="CPSites#SITE_TABLE_MEMBERS_USERS" value1="1 ${siteMember}" />
			</else>
		</if>

		<execute function="AssertTextEquals" locator1="CPSites#SITE_TABLE_ACTIVE" value1="Yes" />
		<execute function="AssertTextEquals" locator1="CPSites#SITE_TABLE_PENDING_REQUESTS" value1="" />
		<execute function="AssertTextEquals" locator1="CPSites#SITE_TABLE_TAGS" value1="" />
		<execute function="AssertTextEquals" locator1="CPSites#SITE_TABLE_ACTIONS" value1="Actions" />
	</command>
</definition>