definition {
	var siteMember = "User";
	var siteType = "Open";

	macro addBlankCP {
		Site.addCP(
			membershipType = "${membershipType}",
			siteName = "${siteName}",
			siteType = "Blank"
		);
	}

	macro addCommunityCP {
		Site.addCP(
			membershipType = "${membershipType}",
			siteName = "${siteName}",
			siteType = "Community"
		);
	}

	macro addCP {
		AssertClick(locator1 = "CPSites#ADD", value1 = "Add");

		if ("${siteType}" == "Blank") {
			AssertClick.assertTextClickAt(
				locator1 = "CPSites#ADD_BLANK_SITE",
				value1 = "Blank Site"
			);
		}
		else if ("${siteType}" == "Community") {
			AssertClick(locator1 = "CPSites#ADD_COMMUNITY_SITE", value1 = "Community Site");
		}
		else if ("${siteType}" == "Intranet") {
			AssertClick(locator1 = "CPSites#ADD_INTRANET_SITE", value1 = "Intranet Site");
		}
		else {
			fail("Invalid var siteType. Must be (Blank|Community|Intranet).");
		}

		Type(locator1 = "CPSitesAdd#DETAILS_NAME", value1 = "${siteName}");

		if ("${membershipType}" == "Private") {
			Select(
				locator1 = "CPSitesAdd#DETAILS_MEMBERSHIP_TYPE_SELECT",
				value1 = "Private"
			);
		}
		else if ("${membershipType}" == "Restricted") {
			Select(
				locator1 = "CPSitesAdd#DETAILS_MEMBERSHIP_TYPE_SELECT",
				value1 = "Restricted"
			);
		}

		AssertClick.assertValueClickAt(
			locator1 = "CPSitesAdd#MENU_SAVE",
			value1 = "Save"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPSitesAdd#MENU_SAVE",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPSitesEdit#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(locator1 = "CPSitesEdit#HEADER", value1 = "${siteName}");
	}

	macro addIntranetCP {
		Site.addCP(
			membershipType = "${membershipType}",
			siteName = "${siteName}",
			siteType = "Intranet"
		);
	}

	macro addMemberCP {
		Type(locator1 = "CPSites#SEARCH_FIELD", value1 = "${siteName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPSites#SEARCH_BUTTON",
			value1 = "Search"
		);

		var key_siteName = "${siteName}";

		AssertTextEquals.assertPartialText(
			locator1 = "CPSites#SITE_TABLE_NAME",
			value1 = "${siteName}"
		);

		AssertClick(locator1 = "CPSites#SITE_TABLE_ACTIONS", value1 = "Actions");

		AssertClick(
			locator1 = "CPSites#SITE_MENULIST_MANAGE_MEMBERSHIPS",
			value1 = "Manage Memberships"
		);

		AssertClick(
			locator1 = "CPSitememberships#TOOLBAR_ADD_MEMBERS",
			value1 = "Add Members"
		);

		AssertClick(
			locator1 = "CPSitememberships#ADD_MEMBERS_MENULIST_USER",
			value1 = "User"
		);

		Type(
			locator1 = "CPSitemembershipsAddmembers#SEARCH_FIELD",
			value1 = "${userScreenName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPSitemembershipsAddmembers#SEARCH_BUTTON",
			value1 = "Search"
		);

		if (isSet(userMiddleName)) {
			AssertTextEquals(
				locator1 = "CPSitemembershipsAddmembers#USER_TABLE_NAME",
				value1 = "${userFirstName} ${userMiddleName} ${userLastName}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "CPSitemembershipsAddmembers#USER_TABLE_NAME",
				value1 = "${userFirstName} ${userLastName}"
			);
		}

		AssertTextEquals(
			locator1 = "CPSitemembershipsAddmembers#USER_TABLE_SCREEN_NAME",
			value1 = "${userScreenName}"
		);

		Check(locator1 = "CPSitemembershipsAddmembers#USER_TABLE_CHECKBOX");

		AssertClick.assertValueClickAt(
			locator1 = "CPSitemembershipsAddmembers#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPSitemembershipsAddmembers#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro assignRoleCP {
		Type(locator1 = "CPSites#SEARCH_FIELD", value1 = "${siteName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPSites#SEARCH_BUTTON",
			value1 = "Search"
		);

		var key_siteName = "${siteName}";

		AssertTextEquals.assertPartialText(
			locator1 = "CPSites#SITE_TABLE_NAME",
			value1 = "${siteName}"
		);

		AssertClick(locator1 = "CPSites#SITE_TABLE_ACTIONS", value1 = "Actions");

		AssertClick(
			locator1 = "CPSites#SITE_MENULIST_MANAGE_MEMBERSHIPS",
			value1 = "Manage Memberships"
		);

		AssertClick(
			locator1 = "CPSitememberships#TOOLBAR_ADD_SITE_ROLES_TO",
			value1 = "Add Site Roles to"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPSitememberships#ADD_SITE_ROLES_TO_MENULIST_USERS",
			value1 = "Users"
		);

		Type(
			locator1 = "CPSitemembershipsAssignuserroles#ROLES_SEARCH_FIELD",
			value1 = "${searchTerm}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPSitemembershipsAssignuserroles#ROLES_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPSitemembershipsAssignuserroles#ROLE_TABLE_TITLE_1",
			value1 = "${roleName}"
		);

		AssertClick(
			locator1 = "CPSitemembershipsAssignuserroles#ROLE_TABLE_TITLE_1",
			value1 = "${roleName}"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPSitemembershipsAssignuserrolesUser#AVAILABLE",
			value1 = "Available"
		);

		Type(
			locator1 = "CPSitemembershipsAssignuserrolesUser#BASIC_SEARCH_FIELD",
			value1 = "${userScreenName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPSitemembershipsAssignuserrolesUser#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPSitemembershipsAssignuserrolesUser#USER_TABLE_SCREEN_NAME_1",
			value1 = "${userScreenName}"
		);

		Check(locator1 = "CPSitemembershipsAssignuserrolesUser#USER_TABLE_CHECKBOX_1");

		AssertClick.assertValueClickAt(
			locator1 = "CPSitemembershipsAssignuserrolesUser#UPDATE_ASSOCIATIONS_BUTTON",
			value1 = "Update Associations"
		);

		AssertTextEquals(
			locator1 = "CPSitemembershipsAssignuserrolesUser#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPSitemembershipsAssignuserrolesUser#CURRENT",
			value1 = "Current"
		);

		AssertChecked(
			locator1 = "CPSitemembershipsAssignuserrolesUser#USER_TABLE_CHECKBOX_1"
		);

		if (isSet(userMiddleName)) {
			AssertTextEquals(
				locator1 = "CPSitemembershipsAssignuserrolesUser#USER_TABLE_USER_NAME_1",
				value1 = "${userFirstName} ${userMiddleName} ${userLastName}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "CPSitemembershipsAssignuserrolesUser#USER_TABLE_USER_NAME_1",
				value1 = "${userFirstName} ${userLastName}"
			);
		}

		AssertTextEquals(
			locator1 = "CPSitemembershipsAssignuserrolesUser#USER_TABLE_SCREEN_NAME_1",
			value1 = "${userScreenName}"
		);
	}

	macro deleteCP {
		Type(locator1 = "CPSites#SEARCH_FIELD", value1 = "Name");

		AssertClick.assertValueClickAt(
			locator1 = "CPSites#SEARCH_BUTTON",
			value1 = "Search"
		);

		var key_siteName = "${siteName}";

		AssertTextEquals.assertPartialText(
			locator1 = "CPSites#SITE_TABLE_NAME",
			value1 = "${siteName}"
		);

		AssertClick(locator1 = "CPSites#SITE_TABLE_ACTIONS", value1 = "Actions");

		AssertClickNoError(locator1 = "CPSites#SITE_MENULIST_DELETE", value1 = "Delete");

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextEquals(
			locator1 = "CPSites#INFO_MESSAGE",
			value1 = "No sites were found."
		);

		AssertTextNotPresent(value1 = "${siteName}");
	}

	macro removeMemberCP {
		Type(locator1 = "CPSites#SEARCH_FIELD", value1 = "${siteName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPSites#SEARCH_BUTTON",
			value1 = "Search"
		);

		var key_siteName = "${siteName}";

		AssertTextEquals.assertPartialText(
			locator1 = "CPSites#SITE_TABLE_NAME",
			value1 = "${siteName}"
		);

		AssertClick(locator1 = "CPSites#SITE_TABLE_ACTIONS", value1 = "Actions");

		AssertClick(
			locator1 = "CPSites#SITE_MENULIST_MANAGE_MEMBERSHIPS",
			value1 = "Manage Memberships"
		);

		Type(
			locator1 = "CPSitememberships#USER_SEARCH_FIELD",
			value1 = "${userScreenName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPSitememberships#USER_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "CPSitememberships#USER_TABLE_NAME_1",
			value1 = "${userFirstName} ${userLastName}"
		);

		AssertTextEquals(
			locator1 = "CPSitememberships#USER_TABLE_SCREEN_NAME_1",
			value1 = "${userScreenName}"
		);

		AssertClick(
			locator1 = "CPSitememberships#USER_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClick(
			locator1 = "CPSitememberships#USER_MENULIST_REMOVE_MEMBERSHIP",
			value1 = "Remove Membership"
		);

		AssertTextEquals(
			locator1 = "CPSitemembershipsAddmembers#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Sites");

		Type(locator1 = "CPSites#SEARCH_FIELD", value1 = "Name");

		AssertClick.assertValueClickAt(
			locator1 = "CPSites#SEARCH_BUTTON",
			value1 = "Search"
		);

		while (IsElementPresent(locator1 = "CPSites#SITE_TABLE_ACTIONS")) {
			AssertClick(locator1 = "CPSites#SITE_TABLE_ACTIONS", value1 = "Actions");

			AssertClickNoError(locator1 = "CPSites#SITE_MENULIST_DELETE", value1 = "Delete");

			Confirm(value1 = "Are you sure you want to delete this?");
		}
	}

	macro viewCP {
		Type(locator1 = "CPSites#SEARCH_FIELD", value1 = "${siteName}");

		AssertClick.assertValueClickAt(
			locator1 = "CPSites#SEARCH_BUTTON",
			value1 = "Search"
		);

		var key_siteName = "${siteName}";

		AssertTextEquals.assertPartialText(
			locator1 = "CPSites#SITE_TABLE_NAME",
			value1 = "${siteName}"
		);

		AssertTextEquals(locator1 = "CPSites#SITE_TABLE_TYPE", value1 = "${siteType}");

		if ("${siteMember}" == "Organization") {
			AssertTextEquals(
				locator1 = "CPSites#SITE_TABLE_MEMBERS_ORGS",
				value1 = "1 ${siteMember}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "CPSites#SITE_TABLE_MEMBERS_USERS",
				value1 = "1 ${siteMember}"
			);
		}

		AssertTextEquals(locator1 = "CPSites#SITE_TABLE_ACTIVE", value1 = "Yes");

		AssertTextEquals(locator1 = "CPSites#SITE_TABLE_PENDING_REQUESTS", value1 = "");

		AssertTextEquals(locator1 = "CPSites#SITE_TABLE_TAGS", value1 = "");

		AssertTextEquals(locator1 = "CPSites#SITE_TABLE_ACTIONS", value1 = "Actions");
	}
}