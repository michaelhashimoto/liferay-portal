definition {
	macro addCP {
		AssertClick.assertTextClickAt(
			locator1 = "CPWebcontent#NAVIGATION_TEMPLATES",
			value1 = "Templates"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPWebcontentTemplates#ADD_TEMPLATE",
			value1 = "Add Template"
		);

		Type(
			locator1 = "CPWebcontentTemplatesAddtemplate#NAME_FIELD",
			value1 = "${templateName}"
		);

		Type(
			locator1 = "CPWebcontentTemplatesAddtemplate#DESCRIPTION_FIELD",
			value1 = "${templateDescription}"
		);

		if (isSet(structureName)) {
			AssertClick.assertValueClickAt(
				locator1 = "CPWebcontentTemplatesAddtemplate#SELECT_STRUCTURE_BUTTON",
				value1 = "Select"
			);

			SelectFrame(
				locator1 = "CPWebcontentTemplatesAddtemplateStructure#STRUCTURE_IFRAME"
			);

			AssertElementPresent(
				locator1 = "CPWebcontentTemplatesAddtemplateStructure#STRUCTURE_TABLE_ID_1"
			);

			AssertTextPresent(
				locator1 = "CPWebcontentTemplatesAddtemplateStructure#STRUCTURE_TABLE_NAME_1",
				value1 = "${structureName}"
			);

			AssertTextPresent(
				locator1 = "CPWebcontentTemplatesAddtemplateStructure#STRUCTURE_TABLE_DESCRIPTION_1",
				value1 = "${structureDescription}"
			);

			AssertClick(
				locator1 = "CPWebcontentTemplatesAddtemplateStructure#STRUCTURE_TABLE_NAME_1",
				value1 = "${structureName}"
			);

			SelectFrame();

			AssertTextEquals(
				locator1 = "CPWebcontentTemplatesAddtemplate#STRUCTURE_NAME",
				value1 = "${structureName}"
			);
		}

		AssertClick.assertValueClickAt(
			locator1 = "CPWebcontentTemplatesAddtemplate#LAUNCH_EDITOR_BUTTON",
			value1 = "Launch Editor"
		);

		SelectFrame(locator1 = "CPWebcontentTemplatesAddtemplateEditor#EDITOR_IFRAME");

		Type.typeWaitForNotValueNull(
			locator1 = "CPWebcontentTemplatesAddtemplateEditor#EDITOR_FIELD",
			value1 = "$text.getData()"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPWebcontentTemplatesAddtemplateEditor#UPDATE_BUTTON",
			value1 = "Update"
		);

		SelectFrame();

		AssertClick.assertValueClickAt(
			locator1 = "CPWebcontentTemplatesAddtemplate#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPWebcontentTemplates#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertElementPresent(locator1 = "CPWebcontentTemplates#TEMPLATE_TABLE_ID_1");

		AssertTextEquals(
			locator1 = "CPWebcontentTemplates#TEMPLATE_TABLE_NAME_1",
			value1 = "${templateName}"
		);

		AssertTextEquals(
			locator1 = "CPWebcontentTemplates#TEMPLATE_TABLE_DESCRIPTION_1",
			value1 = "${templateDescription}"
		);
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Web Content");

		AssertClick.assertTextClickAt(
			locator1 = "CPWebcontent#NAVIGATION_TEMPLATES",
			value1 = "Templates"
		);

		if (IsElementPresent.isVisible(locator1 = "CPWebcontentTemplates#TEMPLATE_TABLE_ALL_CHECKBOX")) {
			Check(locator1 = "CPWebcontentTemplates#TEMPLATE_TABLE_ALL_CHECKBOX");

			AssertClickNoError(
				locator1 = "CPWebcontentTemplates#DELETE_BUTTON",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete the selected templates?");

			AssertTextEquals(
				locator1 = "CPWebcontentTemplates#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}
	}
}