<definition>
	<command name="addCP">
		<execute function="AssertClick" locator1="CPDocumentsandmedia#ADD" value1="Add" />
		<execute function="AssertClick" locator1="CPDocumentsandmedia#ADD_MENULIST_BASIC_DOCUMENT" value1="Basic Document" />

		<if>
			<equals arg1="${uploadTempFile}" arg2="true" />
			<then>
				<execute function="UploadTempFile" locator1="CPDocumentsandmediaAdddocument#FILE_FIELD" value1="${dmDocumentFile}" />
			</then>
			<else>
				<execute function="UploadCommonFile" locator1="CPDocumentsandmediaAdddocument#FILE_FIELD" value1="${dmDocumentFile}" />
			</else>
		</if>

		<execute function="UploadCommonFile" locator1="CPDocumentsandmediaAdddocument#FILE_FIELD" value1="${dmDocumentFile}" />
		<execute function="Type" locator1="CPDocumentsandmediaAdddocument#TITLE_FIELD" value1="${dmDocumentTitle}" />
		<execute function="Type" locator1="CPDocumentsandmediaAdddocument#DESCRIPTION_FIELD" value1="${dmDocumentDescription}" />
		<execute function="AssertClick" locator1="CPDocumentsandmediaAdddocument#PUBLISH_BUTTON" value1="Publish" />

		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#REQUEST" value1="Your request completed successfully." />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1" />

		<if>
			<condition function="IsElementNotPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT2" />
			<then>
				<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_TITLE" value1="${dmDocumentTitle}" />
				<execute function="Click" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_DROPDOWN" />
				<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#DOCUMENT_MENULIST_DOWNLOAD" value1="Download (${dmDocumentSize})" />
			</then>
			<else>
				<execute function="AssertTextPresent" value1="${dmDocumentTitle}" />
			</else>
		</if>
	</command>

	<command name="addPG">
		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />

				<execute function="AssertClick" locator1="PGDocumentsandmedia#TOOLBAR_ADD" value1="Add" />
				<execute function="AssertClick" locator1="PGDocumentsandmedia#ADD_MENULIST_BASIC_DOCUMENT" value1="Basic Document" />

				<execute function="UploadCommonFile" locator1="PGDocumentsandmediaAdddocument#FILE_FIELD" value1="${dmDocumentFile}" />
				<execute function="Type" locator1="PGDocumentsandmediaAdddocument#TITLE_FIELD" value1="${dmDocumentTitle}${number}" />
				<execute function="Type" locator1="PGDocumentsandmediaAdddocument#DESCRIPTION_FIELD" value1="${dmDocumentDescription}${number}" />
				<execute function="AssertClick#assertValueClickAt" locator1="PGDocumentsandmediaAdddocument#PUBLISH_BUTTON" value1="Publish" />

				<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#SUCCESS_MESSAGE" value1="Your request completed successfully." />

				<var name="key_dmDocumentTitle" value="${dmDocumentTitle}${number}" />

				<execute function="AssertElementPresent" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT" />
				<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT_TITLE" value1="${dmDocumentTitle}${number}" />
				<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT_ACTIONS" />
				<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#DOCUMENT_MENULIST_DOWNLOAD" value1="Download (${dmDocumentSize})" />
			</then>
			<else>
				<execute function="AssertClick" locator1="PGDocumentsandmedia#TOOLBAR_ADD" value1="Add" />
				<execute function="AssertClick" locator1="PGDocumentsandmedia#ADD_MENULIST_BASIC_DOCUMENT" value1="Basic Document" />

				<execute function="UploadCommonFile" locator1="PGDocumentsandmediaAdddocument#FILE_FIELD" value1="${dmDocumentFile}" />
				<execute function="Type" locator1="PGDocumentsandmediaAdddocument#TITLE_FIELD" value1="${dmDocumentTitle}" />
				<execute function="Type" locator1="PGDocumentsandmediaAdddocument#DESCRIPTION_FIELD" value1="${dmDocumentDescription}" />
				<execute function="AssertClick#assertValueClickAt" locator1="PGDocumentsandmediaAdddocument#PUBLISH_BUTTON" value1="Publish" />

				<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#SUCCESS_MESSAGE" value1="Your request completed successfully." />

				<var name="key_dmDocumentTitle" value="${dmDocumentTitle}" />

				<execute function="AssertElementPresent" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT" />
				<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT_TITLE" value1="${dmDocumentTitle}" />
				<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT_ACTIONS" />
				<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#DOCUMENT_MENULIST_DOWNLOAD" value1="Download (${dmDocumentSize})" />
			</else>
		</if>
	</command>

	<command name="addPGviaDMD">
		<execute function="AssertClick" locator1="PGDocumentlibrarydisplay#FOLDER_MENU_ADD_DOCUMENT" value1="Add Document" />

		<execute function="SelectFrame#selectFrameWaitForScript" locator1="PGDocumentlibrarydisplayAdddocument#SELECT_DOCUMENT_TYPE_IFRAME" />
		<execute function="AssertClick#assertTextClickAt" locator1="PGDocumentlibrarydisplayAdddocument#SELECT_DOCUMENT_TYPE_BASIC_DOCUMENT" value1="Basic Document" />
		<execute function="SelectFrame" />
		<execute function="UploadCommonFile" locator1="PGDocumentlibrarydisplayAdddocument#DOCUMENT_FILE_FIELD" value1="${dmdDocumentFile}" />
		<execute function="Type" locator1="PGDocumentlibrarydisplayAdddocument#DOCUMENT_TITLE_FIELD" value1="${dmdDocumentTitle}" />
		<execute function="AssertClick#assertValueClickAt" locator1="PGDocumentlibrarydisplayAdddocument#PUBLISH_BUTTON" value1="Publish" />

		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplay#SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<if>
			<condition function="IsElementPresent" locator1="PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_3" />
			<then>
				<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_3" value1="${dmdDocumentTitle}" />
				<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplay#DOCUMENTS_TABLE_SIZE_3" value1="${dmdDocumentSize}" />
				<execute function="AssertClick#assertTextClickAt" locator1="PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_3" value1="${dmdDocumentTitle}" />
			</then>
			<elseif>
				<condition function="IsElementPresent" locator1="PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_2" />
				<then>
					<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_2" value1="${dmdDocumentTitle}" />
					<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplay#DOCUMENTS_TABLE_SIZE_2" value1="${dmdDocumentSize}" />
					<execute function="AssertClick#assertTextClickAt" locator1="PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_2" value1="${dmdDocumentTitle}" />
				</then>
			</elseif>
			<else>
				<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_1" value1="${dmdDocumentTitle}" />
				<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplay#DOCUMENTS_TABLE_SIZE_1" value1="${dmdDocumentSize}" />
				<execute function="AssertClick#assertTextClickAt" locator1="PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_1" value1="${dmdDocumentTitle}" />
			</else>
		</if>

		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplayDocument#DOCUMENT_HEADER_TITLE" value1="${dmdDocumentTitle}" />
		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplayDocument#DOCUMENT_TITLE" value1="${dmdDocumentTitle}" />
		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplayDocument#DOCUMENT_VERSION" value1="Version 1.0" />
	</command>

	<command name="deleteCP">
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1" />
		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_TITLE" value1="${dmDocumentTitle}" />

		<execute function="MouseOver" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1" />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_CHECKBOX" />
		<execute function="Click" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_CHECKBOX" />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#ACTIONS" />
		<execute function="AssertClick" locator1="CPDocumentsandmedia#ACTIONS" value1="Actions" />
		<execute function="AssertClickNoError" locator1="CPDocumentsandmedia#ACTIONS_MENULIST_DELETE" value1="Delete" />
		<execute function="Confirm" value1="Are you sure you want to delete the selected entries?" />
		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#REQUEST" value1="Your request completed successfully." />

		<if>
			<condition function="IsElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1" />
			<then>
				<execute function="AssertTextNotEquals" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_TITLE" value1="${dmDocumentTitle}" />
			</then>
			<else>
				<execute function="AssertElementNotPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1" />
			</else>
		</if>
	</command>

	<command name="deletePG">
		<var name="key_dmDocumentTitle" value="${dmDocumentTitle}" />

		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT" />

		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
		<execute function="AssertClickNoError" locator1="PGDocumentsandmediaDocument#TOOLBAR_DELETE_BUTTON" value1="Delete" />
		<execute function="Confirm" value1="Are you sure you want to delete this entry?" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertElementNotPresent" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" />
	</command>

	<command name="deletePGviaDMD">
		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_1" value1="${dmdDocumentTitle}" />
		<execute function="Click" locator1="PGDocumentlibrarydisplay#DOCUMENTS_TABLE_ACTIONS_BUTTON_1" />
		<execute function="AssertClickNoError" locator1="PGDocumentlibrarydisplay#DOCUMENT_MENULIST_DELETE" value1="Delete" />
		<execute function="Confirm" value1="Are you sure you want to delete this?" />
		<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplay#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextNotPresent" value1="${dmdDocumentTitle}" />
	</command>

	<command name="downloadCP">
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1" />
		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_TITLE" value1="${dmDocumentTitle}" />

		<execute function="MouseOver" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1" />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_DROPDOWN" />
		<execute function="Click" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_DROPDOWN" />
		<execute function="Click" locator1="CPDocumentsandmedia#DOCUMENT_MENULIST_DOWNLOAD" value1="Download" />
	</command>

	<command name="editCP">
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1" />
		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_TITLE" value1="${dmDocumentTitle}" />

		<execute function="MouseOver" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1" />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_DROPDOWN" />
		<execute function="Click" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_DROPDOWN" />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_MENULIST_EDIT" />
		<execute function="AssertClick" locator1="CPDocumentsandmedia#DOCUMENT_MENULIST_EDIT" value1="Edit" />

		<execute function="Type" locator1="CPDocumentsandmediaEditdocument#TITLE_FIELD" value1="${dmDocumentTitleEdit}" />
		<execute function="Type" locator1="CPDocumentsandmediaEditdocument#DESCRIPTION_FIELD" value1="${dmDocumentDescriptionEdit}" />
		<execute function="AssertClick" locator1="CPDocumentsandmediaEditdocument#PUBLISH_BUTTON" value1="Publish" />

		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#REQUEST" value1="Your request completed successfully." />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1" />
		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_TITLE" value1="${dmDocumentTitleEdit}" />
	</command>

	<command name="editPG">
		<var name="key_dmDocumentTitle" value="${dmDocumentTitle}" />

		<execute function="Click" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT" />

		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitle}" />
		<execute function="AssertClick" locator1="PGDocumentsandmediaDocument#TOOLBAR_EDIT_BUTTON" value1="Edit" />

		<execute function="Type" locator1="PGDocumentsandmediaEditdocument#TITLE_FIELD" value1="${dmDocumentTitleEdit}"  />
		<execute function="Type" locator1="PGDocumentsandmediaEditdocument#DESCRIPTION_FIELD" value1="${dmDocumentDescriptionEdit}" />
		<execute function="AssertClick" locator1="PGDocumentsandmediaEditdocument#PUBLISH_BUTTON" value1="Publish" />

		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE" value1="${dmDocumentTitleEdit}" />
	</command>

	<command name="moveToFolderCP">
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1" />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER2" />

		<execute function="Click" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_DROPDOWN" />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_MENULIST_MOVE" />
		<execute function="AssertClick" locator1="CPDocumentsandmedia#DOCUMENT_MENULIST_MOVE" value1="Move" />

		<execute function="AssertClick" locator1="CPDocumentsandmediaMovedocument#SELECT_PARENT_FOLDER_BUTTON" value1="Select" />

		<execute function="SelectWindow" locator1="CPDocumentsandmediaMovedocument#FOLDER_WINDOW_ID" />
		<execute function="AssertClick" locator1="CPDocumentsandmediaMovedocument#FOLDER_WINDOW_FOLDER1_CHOOSE_BUTTON" value1="Choose" />
		<execute function="SelectWindow" locator1="null" />

		<execute function="AssertTextEquals" locator1="CPDocumentsandmediaMovedocument#PARENT_FOLDER" value1="${dmFolderName}" />
		<execute function="AssertClick" locator1="CPDocumentsandmediaMovedocument#MOVE_BUTTON" value1="Move" />

		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#REQUEST" value1="Your request completed successfully." />
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1" />
		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_TITLE" value1="${dmFolderName}" />
		<execute function="Click" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1" />
		<!-- <execute function="AssertTextEquals" locator1="CPDocumentsandmedia#BREADCRUMB_LAST" value1="${dmFolderName}" /> -->
		<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#FOLDER_VIEW_DOCUMENT1" />
		<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#FOLDER_VIEW_DOCUMENT1_TITLE" value1="${dmDocumentTitle}" />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Documents and Media" />
		</execute>

		<while>
			<condition function="IsElementPresent" locator1="CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1" />
			<then>
				<execute function="Select" locator1="CPDocumentsandmedia#PAGINATION_ROWS_PER_PAGE_SELECT" value1="75" />
				<execute function="Check" locator1="CPDocumentsandmedia#SELECT_ALL_ROWS_CHECKBOX" />
				<execute function="AssertClick" locator1="CPDocumentsandmedia#ACTIONS" value1="Actions" />
				<execute function="AssertElementPresent" locator1="CPDocumentsandmedia#ACTIONS_MENULIST_DELETE" />
				<execute function="AssertClickNoError" locator1="CPDocumentsandmedia#ACTIONS_MENULIST_DELETE" value1="Delete" />
				<execute function="Confirm" value1="Are you sure you want to delete the selected entries?" />
				<execute function="AssertTextEquals" locator1="CPDocumentsandmedia#REQUEST" value1="Your request completed successfully." />
			</then>
		</while>
	</command>

	<command name="tearDownPG">
		<execute macro="Page#gotoPG">
			<var name="pageName" value="${pageName}" />
		</execute>

		<if>
			<condition function="IsElementPresent" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT_GENERIC" />
			<then>
				<execute function="Check" locator1="PGDocumentsandmedia#TOOLBAR_SELECT_ALL_CHECKBOX" />
				<execute function="AssertClick" locator1="PGDocumentsandmedia#TOOLBAR_ACTIONS" value1="Actions" />
				<execute function="AssertElementPresent" locator1="PGDocumentsandmedia#ACTIONS_MENULIST_DELETE" />
				<execute function="AssertClickNoError" locator1="PGDocumentsandmedia#ACTIONS_MENULIST_DELETE" value1="Delete" />
				<execute function="Confirm" value1="Are you sure you want to delete the selected entries?" />
				<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</if>
	</command>

	<command name="tearDownPGviaDMD">
		<execute macro="Page#gotoPG">
			<var name="pageName" value="${pageName}" />
		</execute>

		<while>
			<condition function="IsElementPresent" locator1="PGDocumentlibrarydisplay#DOCUMENTS_TABLE_ACTIONS_BUTTON_1" />
			<then>
				<execute function="Click" locator1="PGDocumentlibrarydisplay#DOCUMENTS_TABLE_ACTIONS_BUTTON_1" />
				<execute function="AssertClickNoError" locator1="PGDocumentlibrarydisplay#DOCUMENT_MENULIST_DELETE" value1="Delete" />
				<execute function="Confirm" value1="Are you sure you want to delete this?" />
				<execute function="AssertTextEquals" locator1="PGDocumentlibrarydisplay#SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</while>
	</command>

	<command name="viewPG">
		<execute function="Type" locator1="PGDocumentsandmedia#TOOLBAR_SEARCH_FIELD" value1="${dmDocumentTitle}" />
		<execute function="AssertClick" locator1="PGDocumentsandmedia#TOOLBAR_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextEquals" locator1="PGDocumentsandmedia#ENTRIES_DOCUMENT_SEARCH_TITLE" value1="${dmDocumentTitle}" />
	</command>
</definition>