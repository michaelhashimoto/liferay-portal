definition {
	macro addCP {
		AssertClick(locator1 = "CPDocumentsandmedia#ADD", value1 = "Add");

		AssertClick(
			locator1 = "CPDocumentsandmedia#ADD_MENULIST_BASIC_DOCUMENT",
			value1 = "Basic Document"
		);

		if ("${uploadTempFile}" == "true") {
			UploadTempFile(
				locator1 = "CPDocumentsandmediaAdddocument#FILE_FIELD",
				value1 = "${dmDocumentFile}"
			);
		}
		else {
			UploadCommonFile(
				locator1 = "CPDocumentsandmediaAdddocument#FILE_FIELD",
				value1 = "${dmDocumentFile}"
			);
		}

		UploadCommonFile(
			locator1 = "CPDocumentsandmediaAdddocument#FILE_FIELD",
			value1 = "${dmDocumentFile}"
		);

		Type(
			locator1 = "CPDocumentsandmediaAdddocument#TITLE_FIELD",
			value1 = "${dmDocumentTitle}"
		);

		Type(
			locator1 = "CPDocumentsandmediaAdddocument#DESCRIPTION_FIELD",
			value1 = "${dmDocumentDescription}"
		);

		AssertClick(
			locator1 = "CPDocumentsandmediaAdddocument#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#REQUEST",
			value1 = "Your request completed successfully."
		);

		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1"
		);

		if (IsElementNotPresent(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT2")) {
			AssertTextEquals(
				locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_TITLE",
				value1 = "${dmDocumentTitle}"
			);

			Click(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_DROPDOWN");

			AssertTextEquals(
				locator1 = "CPDocumentsandmedia#DOCUMENT_MENULIST_DOWNLOAD",
				value1 = "Download (${dmDocumentSize})"
			);
		}
		else {
			AssertTextPresent(value1 = "${dmDocumentTitle}");
		}
	}

	macro addPG {
		if (isSet(number)) {
			var number = "${number}";

			AssertClick(locator1 = "PGDocumentsandmedia#TOOLBAR_ADD", value1 = "Add");

			AssertClick(
				locator1 = "PGDocumentsandmedia#ADD_MENULIST_BASIC_DOCUMENT",
				value1 = "Basic Document"
			);

			UploadCommonFile(
				locator1 = "PGDocumentsandmediaAdddocument#FILE_FIELD",
				value1 = "${dmDocumentFile}"
			);

			Type(
				locator1 = "PGDocumentsandmediaAdddocument#TITLE_FIELD",
				value1 = "${dmDocumentTitle}${number}"
			);

			Type(
				locator1 = "PGDocumentsandmediaAdddocument#DESCRIPTION_FIELD",
				value1 = "${dmDocumentDescription}${number}"
			);

			AssertClick.assertValueClickAt(
				locator1 = "PGDocumentsandmediaAdddocument#PUBLISH_BUTTON",
				value1 = "Publish"
			);

			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);

			var key_dmDocumentTitle = "${dmDocumentTitle}${number}";

			AssertElementPresent(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_TITLE",
				value1 = "${dmDocumentTitle}${number}"
			);

			Click(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_ACTIONS");

			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#DOCUMENT_MENULIST_DOWNLOAD",
				value1 = "Download (${dmDocumentSize})"
			);
		}
		else {
			AssertClick(locator1 = "PGDocumentsandmedia#TOOLBAR_ADD", value1 = "Add");

			AssertClick(
				locator1 = "PGDocumentsandmedia#ADD_MENULIST_BASIC_DOCUMENT",
				value1 = "Basic Document"
			);

			UploadCommonFile(
				locator1 = "PGDocumentsandmediaAdddocument#FILE_FIELD",
				value1 = "${dmDocumentFile}"
			);

			Type(
				locator1 = "PGDocumentsandmediaAdddocument#TITLE_FIELD",
				value1 = "${dmDocumentTitle}"
			);

			Type(
				locator1 = "PGDocumentsandmediaAdddocument#DESCRIPTION_FIELD",
				value1 = "${dmDocumentDescription}"
			);

			AssertClick.assertValueClickAt(
				locator1 = "PGDocumentsandmediaAdddocument#PUBLISH_BUTTON",
				value1 = "Publish"
			);

			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);

			var key_dmDocumentTitle = "${dmDocumentTitle}";

			AssertElementPresent(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_TITLE",
				value1 = "${dmDocumentTitle}"
			);

			Click(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_ACTIONS");

			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#DOCUMENT_MENULIST_DOWNLOAD",
				value1 = "Download (${dmDocumentSize})"
			);
		}
	}

	macro addPGviaDMD {
		AssertClick(
			locator1 = "PGDocumentlibrarydisplay#FOLDER_MENU_ADD_DOCUMENT",
			value1 = "Add Document"
		);

		SelectFrame.selectFrameWaitForScript(
			locator1 = "PGDocumentlibrarydisplayAdddocument#SELECT_DOCUMENT_TYPE_IFRAME"
		);

		AssertClick.assertTextClickAt(
			locator1 = "PGDocumentlibrarydisplayAdddocument#SELECT_DOCUMENT_TYPE_BASIC_DOCUMENT",
			value1 = "Basic Document"
		);

		SelectFrame();

		UploadCommonFile(
			locator1 = "PGDocumentlibrarydisplayAdddocument#DOCUMENT_FILE_FIELD",
			value1 = "${dmdDocumentFile}"
		);

		Type(
			locator1 = "PGDocumentlibrarydisplayAdddocument#DOCUMENT_TITLE_FIELD",
			value1 = "${dmdDocumentTitle}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGDocumentlibrarydisplayAdddocument#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplay#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		if (IsElementPresent(locator1 = "PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_3")) {
			AssertTextEquals(
				locator1 = "PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_3",
				value1 = "${dmdDocumentTitle}"
			);

			AssertTextEquals(
				locator1 = "PGDocumentlibrarydisplay#DOCUMENTS_TABLE_SIZE_3",
				value1 = "${dmdDocumentSize}"
			);

			AssertClick.assertTextClickAt(
				locator1 = "PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_3",
				value1 = "${dmdDocumentTitle}"
			);
		}
		else if (IsElementPresent(locator1 = "PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_2")) {
			AssertTextEquals(
				locator1 = "PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_2",
				value1 = "${dmdDocumentTitle}"
			);

			AssertTextEquals(
				locator1 = "PGDocumentlibrarydisplay#DOCUMENTS_TABLE_SIZE_2",
				value1 = "${dmdDocumentSize}"
			);

			AssertClick.assertTextClickAt(
				locator1 = "PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_2",
				value1 = "${dmdDocumentTitle}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_1",
				value1 = "${dmdDocumentTitle}"
			);

			AssertTextEquals(
				locator1 = "PGDocumentlibrarydisplay#DOCUMENTS_TABLE_SIZE_1",
				value1 = "${dmdDocumentSize}"
			);

			AssertClick.assertTextClickAt(
				locator1 = "PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_1",
				value1 = "${dmdDocumentTitle}"
			);
		}

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplayDocument#DOCUMENT_HEADER_TITLE",
			value1 = "${dmdDocumentTitle}"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplayDocument#DOCUMENT_TITLE",
			value1 = "${dmdDocumentTitle}"
		);

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplayDocument#DOCUMENT_VERSION",
			value1 = "Version 1.0"
		);
	}

	macro deleteCP {
		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1"
		);

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_TITLE",
			value1 = "${dmDocumentTitle}"
		);

		MouseOver(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1");

		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_CHECKBOX"
		);

		Click(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_CHECKBOX");

		AssertElementPresent(locator1 = "CPDocumentsandmedia#ACTIONS");

		AssertClick(locator1 = "CPDocumentsandmedia#ACTIONS", value1 = "Actions");

		AssertClickNoError(
			locator1 = "CPDocumentsandmedia#ACTIONS_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete the selected entries?");

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#REQUEST",
			value1 = "Your request completed successfully."
		);

		if (IsElementPresent(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1")) {
			AssertTextNotEquals(
				locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_TITLE",
				value1 = "${dmDocumentTitle}"
			);
		}
		else {
			AssertElementNotPresent(
				locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1"
			);
		}
	}

	macro deletePG {
		var key_dmDocumentTitle = "${dmDocumentTitle}";

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE",
			value1 = "${dmDocumentTitle}"
		);

		AssertClickNoError(
			locator1 = "PGDocumentsandmediaDocument#TOOLBAR_DELETE_BUTTON",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this entry?");

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertElementNotPresent(
			locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE"
		);
	}

	macro deletePGviaDMD {
		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplay#DOCUMENTS_TABLE_NAME_1",
			value1 = "${dmdDocumentTitle}"
		);

		Click(locator1 = "PGDocumentlibrarydisplay#DOCUMENTS_TABLE_ACTIONS_BUTTON_1");

		AssertClickNoError(
			locator1 = "PGDocumentlibrarydisplay#DOCUMENT_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplay#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextNotPresent(value1 = "${dmdDocumentTitle}");
	}

	macro downloadCP {
		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1"
		);

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_TITLE",
			value1 = "${dmDocumentTitle}"
		);

		MouseOver(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1");

		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_DROPDOWN"
		);

		Click(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_DROPDOWN");

		Click(
			locator1 = "CPDocumentsandmedia#DOCUMENT_MENULIST_DOWNLOAD",
			value1 = "Download"
		);
	}

	macro editCP {
		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1"
		);

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_TITLE",
			value1 = "${dmDocumentTitle}"
		);

		MouseOver(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1");

		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_DROPDOWN"
		);

		Click(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_DROPDOWN");

		AssertElementPresent(locator1 = "CPDocumentsandmedia#DOCUMENT_MENULIST_EDIT");

		AssertClick(
			locator1 = "CPDocumentsandmedia#DOCUMENT_MENULIST_EDIT",
			value1 = "Edit"
		);

		Type(
			locator1 = "CPDocumentsandmediaEditdocument#TITLE_FIELD",
			value1 = "${dmDocumentTitleEdit}"
		);

		Type(
			locator1 = "CPDocumentsandmediaEditdocument#DESCRIPTION_FIELD",
			value1 = "${dmDocumentDescriptionEdit}"
		);

		AssertClick(
			locator1 = "CPDocumentsandmediaEditdocument#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#REQUEST",
			value1 = "Your request completed successfully."
		);

		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1"
		);

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_TITLE",
			value1 = "${dmDocumentTitleEdit}"
		);
	}

	macro editPG {
		var key_dmDocumentTitle = "${dmDocumentTitle}";

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT");

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE",
			value1 = "${dmDocumentTitle}"
		);

		AssertClick(
			locator1 = "PGDocumentsandmediaDocument#TOOLBAR_EDIT_BUTTON",
			value1 = "Edit"
		);

		Type(
			locator1 = "PGDocumentsandmediaEditdocument#TITLE_FIELD",
			value1 = "${dmDocumentTitleEdit}"
		);

		Type(
			locator1 = "PGDocumentsandmediaEditdocument#DESCRIPTION_FIELD",
			value1 = "${dmDocumentDescriptionEdit}"
		);

		AssertClick(
			locator1 = "PGDocumentsandmediaEditdocument#PUBLISH_BUTTON",
			value1 = "Publish"
		);

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "PGDocumentsandmediaDocument#DOCUMENT_INFO_TITLE",
			value1 = "${dmDocumentTitleEdit}"
		);
	}

	macro moveToFolderCP {
		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1"
		);

		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER2"
		);

		Click(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1_DROPDOWN");

		AssertElementPresent(locator1 = "CPDocumentsandmedia#DOCUMENT_MENULIST_MOVE");

		AssertClick(
			locator1 = "CPDocumentsandmedia#DOCUMENT_MENULIST_MOVE",
			value1 = "Move"
		);

		AssertClick(
			locator1 = "CPDocumentsandmediaMovedocument#SELECT_PARENT_FOLDER_BUTTON",
			value1 = "Select"
		);

		SelectWindow(locator1 = "CPDocumentsandmediaMovedocument#FOLDER_WINDOW_ID");

		AssertClick(
			locator1 = "CPDocumentsandmediaMovedocument#FOLDER_WINDOW_FOLDER1_CHOOSE_BUTTON",
			value1 = "Choose"
		);

		SelectWindow(locator1 = "null");

		AssertTextEquals(
			locator1 = "CPDocumentsandmediaMovedocument#PARENT_FOLDER",
			value1 = "${dmFolderName}"
		);

		AssertClick(
			locator1 = "CPDocumentsandmediaMovedocument#MOVE_BUTTON",
			value1 = "Move"
		);

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#REQUEST",
			value1 = "Your request completed successfully."
		);

		AssertElementPresent(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1"
		);

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1_TITLE",
			value1 = "${dmFolderName}"
		);

		Click(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_FOLDER1");

		AssertElementPresent(locator1 = "CPDocumentsandmedia#FOLDER_VIEW_DOCUMENT1");

		AssertTextEquals(
			locator1 = "CPDocumentsandmedia#FOLDER_VIEW_DOCUMENT1_TITLE",
			value1 = "${dmDocumentTitle}"
		);
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Documents and Media");

		while (IsElementPresent(locator1 = "CPDocumentsandmedia#DOCUMENT_CONTAINER_DOCUMENT1")) {
			Select(
				locator1 = "CPDocumentsandmedia#PAGINATION_ROWS_PER_PAGE_SELECT",
				value1 = "75"
			);

			Check(locator1 = "CPDocumentsandmedia#SELECT_ALL_ROWS_CHECKBOX");

			AssertClick(locator1 = "CPDocumentsandmedia#ACTIONS", value1 = "Actions");

			AssertElementPresent(locator1 = "CPDocumentsandmedia#ACTIONS_MENULIST_DELETE");

			AssertClickNoError(
				locator1 = "CPDocumentsandmedia#ACTIONS_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete the selected entries?");

			AssertTextEquals(
				locator1 = "CPDocumentsandmedia#REQUEST",
				value1 = "Your request completed successfully."
			);
		}
	}

	macro tearDownPG {
		Page.gotoPG(pageName = "${pageName}");

		if (IsElementPresent(locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_GENERIC")) {
			Check(locator1 = "PGDocumentsandmedia#TOOLBAR_SELECT_ALL_CHECKBOX");

			AssertClick(
				locator1 = "PGDocumentsandmedia#TOOLBAR_ACTIONS",
				value1 = "Actions"
			);

			AssertElementPresent(locator1 = "PGDocumentsandmedia#ACTIONS_MENULIST_DELETE");

			AssertClickNoError(
				locator1 = "PGDocumentsandmedia#ACTIONS_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete the selected entries?");

			AssertTextEquals(
				locator1 = "PGDocumentsandmedia#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}
	}

	macro tearDownPGviaDMD {
		Page.gotoPG(pageName = "${pageName}");

		while (IsElementPresent(locator1 = "PGDocumentlibrarydisplay#DOCUMENTS_TABLE_ACTIONS_BUTTON_1")) {
			Click(locator1 = "PGDocumentlibrarydisplay#DOCUMENTS_TABLE_ACTIONS_BUTTON_1");

			AssertClickNoError(
				locator1 = "PGDocumentlibrarydisplay#DOCUMENT_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete this?");

			AssertTextEquals(
				locator1 = "PGDocumentlibrarydisplay#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}
	}

	macro viewPG {
		Type(
			locator1 = "PGDocumentsandmedia#TOOLBAR_SEARCH_FIELD",
			value1 = "${dmDocumentTitle}"
		);

		AssertClick(
			locator1 = "PGDocumentsandmedia#TOOLBAR_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextEquals(
			locator1 = "PGDocumentsandmedia#ENTRIES_DOCUMENT_SEARCH_TITLE",
			value1 = "${dmDocumentTitle}"
		);
	}
}