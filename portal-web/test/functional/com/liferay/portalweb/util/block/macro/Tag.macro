definition {
	macro addCP {
		AssertClick(locator1 = "CPTags#ADD_TAG_BUTTON", value1 = "Add Tag");

		Type(locator1 = "CPTags#ADD_TAG_NAME_FIELD", value1 = "${tagName}");

		AssertClick(locator1 = "CPTags#ADD_TAG_SAVE_BUTTON", value1 = "Save");

		AssertTextEquals(
			locator1 = "CPTags#SUCCESS_MESSAGE",
			value1 = "Your request processed successfully."
		);

		AssertTextEquals(locator1 = "CPTags#TAG_DETAILS_HEADER", value1 = "${tagName}");
	}

	macro deleteCP {
		AssertTextEquals(locator1 = "CPTags#TAG_DETAILS_HEADER", value1 = "${tagName}");

		AssertClickNoError(
			locator1 = "CPTags#TAG_DETAILS_DELETE_BUTTON",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this tag?");

		AssertTextEquals(
			locator1 = "CPTags#SUCCESS_MESSAGE",
			value1 = "Your request processed successfully."
		);

		AssertTextEquals(
			locator1 = "CPTags#INFO_MESSAGE",
			value1 = "There are no tags."
		);

		AssertTextNotPresent(value1 = "${tagName}");
	}

	macro editCP {
		AssertTextEquals(locator1 = "CPTags#TAG_DETAILS_HEADER", value1 = "${tagName}");

		AssertClick(locator1 = "CPTags#TAG_DETAILS_EDIT_BUTTON", value1 = "Edit");

		Type(locator1 = "CPTags#EDIT_TAG_NAME", value1 = "${tagNameEdit}");

		AssertClick(locator1 = "CPTags#EDIT_TAG_SAVE_BUTTON", value1 = "Save");

		AssertTextEquals(
			locator1 = "CPTags#SUCCESS_MESSAGE",
			value1 = "Your request processed successfully."
		);

		AssertTextEquals(
			locator1 = "CPTags#TAG_DETAILS_HEADER",
			value1 = "${tagNameEdit}"
		);
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Tags");

		if (IsElementPresent(locator1 = "CPTags#TAG_DETAILS_HEADER")) {
			Click(locator1 = "CPTags#CHECK_ALL_TAGS");

			AssertClick(locator1 = "CPTags#ACTIONS", value1 = "Actions");

			AssertClickNoError(
				locator1 = "CPTags#ACTIONS_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete the selected tags?");

			AssertTextEquals(
				locator1 = "CPTags#INFO_MESSAGE",
				value1 = "There are no tags."
			);
		}
	}
}