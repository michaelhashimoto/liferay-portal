<definition>
	<command name="addCP">
		<execute function="AssertClick" locator1="CPTags#ADD_TAG_BUTTON" value1="Add Tag" />
		<execute function="Type" locator1="CPTags#ADD_TAG_NAME_FIELD" value1="${tagName}" />
		<execute function="AssertClick" locator1="CPTags#ADD_TAG_SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="CPTags#SUCCESS_MESSAGE" value1="Your request processed successfully." />
		<execute function="AssertTextEquals" locator1="CPTags#TAG_DETAILS_HEADER" value1="${tagName}" />
	</command>

	<command name="deleteCP">
		<execute function="AssertTextEquals" locator1="CPTags#TAG_DETAILS_HEADER" value1="${tagName}" />
		<execute function="AssertClickNoError" locator1="CPTags#TAG_DETAILS_DELETE_BUTTON" value1="Delete" />
		<execute function="Confirm" locator1="CPTags#CONFIRMATION" value1="Are you sure you want to delete this tag?" />
		<execute function="AssertTextEquals" locator1="CPTags#SUCCESS_MESSAGE" value1="Your request processed successfully." />
		<execute function="AssertTextEquals" locator1="CPTags#INFO_MESSAGE" value1="There are no tags." />
		<execute function="AssertTextNotPresent" value1="${tagName}" />
	</command>

	<command name="editCP">
		<execute function="AssertTextEquals" locator1="CPTags#TAG_DETAILS_HEADER" value1="${tagName}" />
		<execute function="AssertClick" locator1="CPTags#TAG_DETAILS_EDIT_BUTTON" value1="Edit" />
		<execute function="Type" locator1="CPTags#EDIT_TAG_NAME" value1="${tagNameEdit}" />
		<execute function="AssertClick" locator1="CPTags#EDIT_TAG_SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="CPTags#SUCCESS_MESSAGE" value1="Your request processed successfully." />
		<execute function="AssertTextEquals" locator1="CPTags#TAG_DETAILS_HEADER" value1="${tagNameEdit}" />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Tags" />
		</execute>

		<if>
			<condition function="IsElementPresent" locator1="CPTags#TAG_DETAILS_HEADER" />
			<then>
				<execute function="Click" locator1="CPTags#CHECK_ALL_TAGS" />
				<execute function="AssertClick" locator1="CPTags#ACTIONS" value1="Actions" />
				<execute function="AssertClickNoError" locator1="CPTags#ACTIONS_MENULIST_DELETE" value1="Delete" />
				<execute function="Confirm" locator1="CPTags#CONFIRMATION" value1="Are you sure you want to delete the selected tags?" />
				<execute function="AssertTextEquals" locator1="CPTags#INFO_MESSAGE" value1="There are no tags." />
			</then>
		</if>
	</command>
</definition>