<definition>
	<command name="select">
		<execute selenium="waitForVisible" />

		<execute selenium="select" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>

	<command name="selectAndWait">
		<execute selenium="waitForVisible" />

		<execute selenium="selectAndWait" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>
</definition>