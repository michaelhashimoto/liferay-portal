definition {
	macro addBooleanCmdCP {
		DragAndDrop(
			locator1 = "CPDynamicdatalistsDatadefinitionsAdd#FIELDS_BOOLEAN",
			locator2 = "CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER",
			value1 = "Boolean"
		);

		DoubleClick(
			locator1 = "CPDynamicdatalistsDatadefinitionsAdd#FORM_BOOLEAN_FIELD_1"
		);

		DoubleClick(locator1 = "CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME");

		Type(
			locator1 = "CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_FIELD",
			value1 = "${booleanNameLabel}"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME",
			value1 = "${booleanNameLabel}"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPDynamicdatalistsDatadefinitionsAdd#FIELDS_LINK",
			value1 = "Fields"
		);

		Click(locator1 = "CPDynamicdatalistsDatadefinitionsAdd#NAME_FIELD");
	}

	macro addCP {
		AssertClick.assertTextClickAt(
			locator1 = "CPDynamicdatalists#TOOLBAR_MANAGE_DATA_DEFINITIONS",
			value1 = "Manage Data Definitions"
		);

		SelectFrame(
			locator1 = "CPDynamicdatalistsDatadefinitions#DATA_DEFINITIONS_IFRAME"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPDynamicdatalistsDatadefinitions#TOOLBAR_ADD",
			value1 = "Add"
		);

		Type.clickAtSendKeys(
			locator1 = "CPDynamicdatalistsDatadefinitionsAdd#NAME_FIELD",
			value1 = "${dataDefinitionName}"
		);

		Type.clickAtSendKeys(
			locator1 = "CPDynamicdatalistsDatadefinitionsAdd#DESCRIPTION_FIELD",
			value1 = "${dataDefinitionDescription}"
		);

		DataDefinition.addTextCmdCP(textNameLabel = "text");

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalistsDatadefinitionsAdd#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsDatadefinitions#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		SelectFrameTop();
	}

