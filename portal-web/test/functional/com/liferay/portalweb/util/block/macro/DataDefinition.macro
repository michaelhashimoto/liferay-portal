<definition>
	<command name="addBooleanCmdCP">
		<execute function="DragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_BOOLEAN" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Boolean" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#FORM_BOOLEAN_FIELD_1" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_FIELD" value1="${booleanNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" value1="${booleanNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_LINK" value1="Fields" />
		<execute function="Click" locator1="CPDynamicdatalistsDatadefinitionsAdd#NAME_FIELD" />
	</command>

	<command name="addCP">
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalists#TOOLBAR_MANAGE_DATA_DEFINITIONS" value1="Manage Data Definitions" />

		<execute function="SelectFrame" locator1="CPDynamicdatalistsDatadefinitions#DATA_DEFINITIONS_IFRAME" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitions#TOOLBAR_ADD" value1="Add" />

		<execute function="Type#clickAtSendKeys" locator1="CPDynamicdatalistsDatadefinitionsAdd#NAME_FIELD" value1="${dataDefinitionName}" />
		<execute function="Type#clickAtSendKeys" locator1="CPDynamicdatalistsDatadefinitionsAdd#DESCRIPTION_FIELD" value1="${dataDefinitionDescription}" />

		<execute macro="DataDefinition#addTextCmdCP">
			<var name="textNameLabel" value="text" />
		</execute>

		<execute function="AssertClick#assertValueClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#SAVE_BUTTON" value1="Save" />

		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitions#SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<execute function="SelectFrameTop" />
	</command>

	<command name="addDateCmdCP">
		<execute function="DragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_DATE" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Date" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#FORM_DATE_FIELD_1" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_FIELD" value1="${dateNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" value1="${dateNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_LINK" value1="Fields" />
		<execute function="Click" locator1="CPDynamicdatalistsDatadefinitionsAdd#NAME_FIELD" />
	</command>

	<command name="addDecimalCmdCP">
		<execute function="DragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_DECIMAL" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Decimal" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#FORM_DECIMAL_FIELD_1" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_FIELD" value1="${decimalNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" value1="${decimalNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_LINK" value1="Fields" />
		<execute function="Click" locator1="CPDynamicdatalistsDatadefinitionsAdd#NAME_FIELD" />
	</command>

	<command name="addDocumentsAndMediaCmdCP">
		<execute function="DragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_DOCUMENTS_AND_MEDIA" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Documents and Media" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#FORM_DOCUMENTS_AND_MEDIA_FIELD_1" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_FIELD" value1="${documentsAndMediaNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" value1="${documentsAndMediaNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_LINK" value1="Fields" />
		<execute function="Click" locator1="CPDynamicdatalistsDatadefinitionsAdd#NAME_FIELD" />
	</command>

	<command name="addFileUploadCmdCP">
		<execute function="DragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_FILE_UPLOAD" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="File Upload" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#FORM_FILE_UPLOAD_FIELD_1" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_FIELD" value1="${fileUploadNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" value1="${fileUploadNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_LINK" value1="Fields" />
		<execute function="Click" locator1="CPDynamicdatalistsDatadefinitionsAdd#NAME_FIELD" />
	</command>

	<command name="addIntegerCmdCP">
		<execute function="DragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_INTEGER" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Ingeger" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#FORM_INTEGER_FIELD_1" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_FIELD" value1="${integerNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" value1="${integerNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_LINK" value1="Fields" />
		<execute function="Click" locator1="CPDynamicdatalistsDatadefinitionsAdd#NAME_FIELD" />
	</command>

	<command name="addNumberCmdCP">
		<execute function="DragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_NUMBER" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Number" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#FORM_NUMBER_FIELD_1" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_FIELD" value1="${numberNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" value1="${numberNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_LINK" value1="Fields" />
		<execute function="Click" locator1="CPDynamicdatalistsDatadefinitionsAdd#NAME_FIELD" />
	</command>

	<command name="addRadioCmdCP">
		<execute function="DragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_RADIO" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Radio" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#FORM_RADIO_FIELD_1" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_FIELD" value1="${radioNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" value1="${radioNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_LINK" value1="Fields" />
		<execute function="Click" locator1="CPDynamicdatalistsDatadefinitionsAdd#NAME_FIELD" />
	</command>

	<command name="addSelectCmdCP">
		<execute function="DragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_SELECT" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Select" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#FORM_SELECT_FIELD_1" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_FIELD" value1="${selectNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" value1="${selectNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_LINK" value1="Fields" />
		<execute function="Click" locator1="CPDynamicdatalistsDatadefinitionsAdd#NAME_FIELD" />
	</command>

	<command name="addTextBoxCmdCP">
		<execute function="DragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_TEXT_BOX" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Text Box" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#FORM_TEXT_BOX_FIELD_1" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_FIELD" value1="${textBoxNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" value1="${textBoxNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_LINK" value1="Fields" />
		<execute function="Click" locator1="CPDynamicdatalistsDatadefinitionsAdd#NAME_FIELD" />
	</command>

	<command name="addTextCmdCP">
		<execute function="DragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_TEXT" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Text" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#FORM_TEXT_FIELD_1" />
		<execute function="DoubleClick" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_FIELD" value1="${textNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitionsAdd#SETTINGS_NAME" value1="${textNameLabel}" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_LINK" value1="Fields" />
		<execute function="Click" locator1="CPDynamicdatalistsDatadefinitionsAdd#NAME_FIELD" />
	</command>

	<command name="deleteCP">
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalists#TOOLBAR_MANAGE_DATA_DEFINITIONS" value1="Manage Data Definitions" />

		<execute function="SelectFrame" locator1="CPDynamicdatalistsDatadefinitions#DATA_DEFINITIONS_IFRAME" />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_FIELD" value1="${dataDefinitionName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertClick" locator1="CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="AssertClickNoError" locator1="CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_MENULIST_DELETE" value1="Delete" />
		<execute function="Confirm" value1="Are you sure you want to delete this?" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitions#SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_FIELD" value1="${dataDefinitionName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertTextNotPresent" value1="${dataDefinitionName}" />

		<execute function="SelectFrameTop" />
	</command>

	<command name="editCP">
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalists#TOOLBAR_MANAGE_DATA_DEFINITIONS" value1="Manage Data Definitions" />

		<execute function="SelectFrame" locator1="CPDynamicdatalistsDatadefinitions#DATA_DEFINITIONS_IFRAME" />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_FIELD" value1="${dataDefinitionName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertClick" locator1="CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_MENULIST_EDIT" value1="Edit" />

		<execute function="Type#clickAtSendKeys" locator1="CPDynamicdatalistsDatadefinitionsEdit#NAME_FIELD" value1="${dataDefinitionNameEdit}" />
		<execute function="Type#clickAtSendKeys" locator1="CPDynamicdatalistsDatadefinitionsEdit#DESCRIPTION_FIELD" value1="${dataDefinitionDescriptionEdit}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPDynamicdatalistsDatadefinitionsEdit#SAVE_BUTTON" value1="Save" />

		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitions#SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<execute function="SelectFrameTop" />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Dynamic Data Lists" />
		</execute>

		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalists#TOOLBAR_MANAGE_DATA_DEFINITIONS" value1="Manage Data Definitions" />

		<execute function="SelectFrame" locator1="CPDynamicdatalistsDatadefinitions#DATA_DEFINITIONS_IFRAME" />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_FIELD" value1="Data Definition" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_BUTTON" value1="Search" />

		<while>
			<condition function="IsElementPresent" locator1="CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_TABLE_ACTIONS_1" />
			<then>
				<execute function="AssertClick" locator1="CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_TABLE_ACTIONS_1" value1="Actions" />
				<execute function="AssertClickNoError" locator1="CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_MENULIST_DELETE" value1="Delete" />
				<execute function="Confirm" value1="Are you sure you want to delete this?" />
				<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitions#SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</while>
	</command>

	<command name="viewCP">
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalists#TOOLBAR_MANAGE_DATA_DEFINITIONS" value1="Manage Data Definitions" />

		<execute function="SelectFrame" locator1="CPDynamicdatalistsDatadefinitions#DATA_DEFINITIONS_IFRAME" />
		<execute function="Type" locator1="CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_FIELD" value1="${dataDefinitionName}" />
		<execute function="AssertClick#assertValueClickAt" locator1="CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_BUTTON" value1="Search" />
		<execute function="AssertClick" locator1="CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_TABLE_ACTIONS_1" value1="Actions" />
		<execute function="AssertClick#assertTextClickAt" locator1="CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_MENULIST_EDIT" value1="Edit" />

		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitionsEdit#HEADER_TITLE" value1="${dataDefinitionName}" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitionsEdit#NAME_FIELD" value1="${dataDefinitionName}" />
		<execute function="AssertTextEquals" locator1="CPDynamicdatalistsDatadefinitionsEdit#DESCRIPTION_FIELD" value1="${dataDefinitionDescription}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="CPDynamicdatalistsDatadefinitionsEdit#FORM_FIELD_1" value1="Text" />

		<execute function="SelectFrameTop" />
	</command>
</definition>