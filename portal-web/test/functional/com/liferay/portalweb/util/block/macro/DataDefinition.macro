<definition>
	<command name="addBooleanCmdCP">
		<execute function="#dragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_BOOLEAN" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Boolean" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="FORM_BOOLEAN_FIELD_1" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="SETTINGS_NAME" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#type" locator1="SETTINGS_CELL_EDITOR_FIELD" value1="${booleanNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertTextEquals" locator1="SETTINGS_NAME" value1="${booleanNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="FIELDS_LINK" value1="Fields" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#click" locator1="NAME_FIELD" />
	</command>

	<command name="addCP">
		<execute action="CPDynamicdatalists#assertClick" locator1="TOOLBAR_MANAGE_DATA_DEFINITIONS" value1="Manage Data Definitions" />

		<execute action="CPDynamicdatalistsDatadefinitions#selectFrame" locator1="DATA_DEFINITIONS_IFRAME" />
		<execute action="CPDynamicdatalistsDatadefinitions#assertClick" locator1="TOOLBAR_ADD" value1="Add" />

		<execute action="CPDynamicdatalistsDatadefinitionsAdd#type" locator1="NAME_FIELD" value1="${dataDefinitionName}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#type" locator1="DESCRIPTION_FIELD" value1="${dataDefinitionDescription}" />

		<execute macro="DataDefinition#addTextCmdCP">
			<var name="textNameLabel" value="text" />
		</execute>

		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="SAVE_BUTTON" value1="Save" />

		<execute action="CPDynamicdatalistsDatadefinitions#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<execute action="CPDynamicdatalists#selectFrameTop" />
	</command>

	<command name="addDateCmdCP">
		<execute function="#dragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_DATE" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Date" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="FORM_DATE_FIELD_1" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="SETTINGS_NAME" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#type" locator1="SETTINGS_CELL_EDITOR_FIELD" value1="${dateNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertTextEquals" locator1="SETTINGS_NAME" value1="${dateNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="FIELDS_LINK" value1="Fields" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#click" locator1="NAME_FIELD" />
	</command>

	<command name="addDecimalCmdCP">
		<execute function="#dragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_DECIMAL" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Decimal" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="FORM_DECIMAL_FIELD_1" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="SETTINGS_NAME" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#type" locator1="SETTINGS_CELL_EDITOR_FIELD" value1="${decimalNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertTextEquals" locator1="SETTINGS_NAME" value1="${decimalNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="FIELDS_LINK" value1="Fields" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#click" locator1="NAME_FIELD" />
	</command>

	<command name="addDocumentsAndMediaCmdCP">
		<execute function="#dragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_DOCUMENTS_AND_MEDIA" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Documents and Media" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="FORM_DOCUMENTS_AND_MEDIA_FIELD_1" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="SETTINGS_NAME" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#type" locator1="SETTINGS_CELL_EDITOR_FIELD" value1="${documentsAndMediaNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertTextEquals" locator1="SETTINGS_NAME" value1="${documentsAndMediaNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="FIELDS_LINK" value1="Fields" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#click" locator1="NAME_FIELD" />
	</command>

	<command name="addFileUploadCmdCP">
		<execute function="#dragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_FILE_UPLOAD" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="File Upload" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="FORM_FILE_UPLOAD_FIELD_1" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="SETTINGS_NAME" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#type" locator1="SETTINGS_CELL_EDITOR_FIELD" value1="${fileUploadNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertTextEquals" locator1="SETTINGS_NAME" value1="${fileUploadNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="FIELDS_LINK" value1="Fields" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#click" locator1="NAME_FIELD" />
	</command>

	<command name="addIntegerCmdCP">
		<execute function="#dragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_INTEGER" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Ingeger" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="FORM_INTEGER_FIELD_1" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="SETTINGS_NAME" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#type" locator1="SETTINGS_CELL_EDITOR_FIELD" value1="${integerNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertTextEquals" locator1="SETTINGS_NAME" value1="${integerNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="FIELDS_LINK" value1="Fields" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#click" locator1="NAME_FIELD" />
	</command>

	<command name="addNumberCmdCP">
		<execute function="#dragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_NUMBER" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Number" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="FORM_NUMBER_FIELD_1" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="SETTINGS_NAME" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#type" locator1="SETTINGS_CELL_EDITOR_FIELD" value1="${numberNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertTextEquals" locator1="SETTINGS_NAME" value1="${numberNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="FIELDS_LINK" value1="Fields" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#click" locator1="NAME_FIELD" />
	</command>

	<command name="addRadioCmdCP">
		<execute function="#dragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_RADIO" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Radio" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="FORM_RADIO_FIELD_1" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="SETTINGS_NAME" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#type" locator1="SETTINGS_CELL_EDITOR_FIELD" value1="${radioNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertTextEquals" locator1="SETTINGS_NAME" value1="${radioNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="FIELDS_LINK" value1="Fields" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#click" locator1="NAME_FIELD" />
	</command>

	<command name="addSelectCmdCP">
		<execute function="#dragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_SELECT" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Select" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="FORM_SELECT_FIELD_1" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="SETTINGS_NAME" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#type" locator1="SETTINGS_CELL_EDITOR_FIELD" value1="${selectNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertTextEquals" locator1="SETTINGS_NAME" value1="${selectNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="FIELDS_LINK" value1="Fields" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#click" locator1="NAME_FIELD" />
	</command>

	<command name="addTextBoxCmdCP">
		<execute function="#dragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_TEXT_BOX" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Text Box" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="FORM_TEXT_BOX_FIELD_1" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="SETTINGS_NAME" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#type" locator1="SETTINGS_CELL_EDITOR_FIELD" value1="${textBoxNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertTextEquals" locator1="SETTINGS_NAME" value1="${textBoxNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="FIELDS_LINK" value1="Fields" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#click" locator1="NAME_FIELD" />
	</command>

	<command name="addTextCmdCP">
		<execute function="#dragAndDrop" locator1="CPDynamicdatalistsDatadefinitionsAdd#FIELDS_TEXT" locator2="CPDynamicdatalistsDatadefinitionsAdd#FORM_BUILDER" value1="Text" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="FORM_TEXT_FIELD_1" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#doubleClick" locator1="SETTINGS_NAME" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#type" locator1="SETTINGS_CELL_EDITOR_FIELD" value1="${textNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="SETTINGS_CELL_EDITOR_SAVE_BUTTON" value1="Save" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertTextEquals" locator1="SETTINGS_NAME" value1="${textNameLabel}" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#assertClick" locator1="FIELDS_LINK" value1="Fields" />
		<execute action="CPDynamicdatalistsDatadefinitionsAdd#click" locator1="NAME_FIELD" />
	</command>

	<command name="deleteCP">
		<execute action="CPDynamicdatalists#assertClick" locator1="TOOLBAR_MANAGE_DATA_DEFINITIONS" value1="Manage Data Definitions" />

		<execute action="CPDynamicdatalistsDatadefinitions#selectFrame" locator1="DATA_DEFINITIONS_IFRAME" />
		<execute action="CPDynamicdatalistsDatadefinitions#type" locator1="BASIC_SEARCH_FIELD" value1="${dataDefinitionName}" />
		<execute action="CPDynamicdatalistsDatadefinitions#assertClick" locator1="BASIC_SEARCH_BUTTON" value1="Search" />
		<execute action="CPDynamicdatalistsDatadefinitions#assertClick" locator1="DATA_DEFINITION_TABLE_ACTIONS_1" value1="Actions" />
		<execute action="CPDynamicdatalistsDatadefinitions#assertClickNoError" locator1="DATA_DEFINITION_MENULIST_DELETE" value1="Delete" />
		<execute action="CPDynamicdatalistsDatadefinitions#confirm" locator1="CONFIRMATION" value1="Are you sure you want to delete this?" />
		<execute action="CPDynamicdatalistsDatadefinitions#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="CPDynamicdatalistsDatadefinitions#type" locator1="BASIC_SEARCH_FIELD" value1="${dataDefinitionName}" />
		<execute action="CPDynamicdatalistsDatadefinitions#assertClick" locator1="BASIC_SEARCH_BUTTON" value1="Search" />
		<execute action="CPDynamicdatalistsDatadefinitions#assertTextNotPresent" value1="${dataDefinitionName}" />

		<execute action="CPDynamicdatalists#selectFrameTop" />
	</command>

	<command name="editCP">
		<execute action="CPDynamicdatalists#assertClick" locator1="TOOLBAR_MANAGE_DATA_DEFINITIONS" value1="Manage Data Definitions" />

		<execute action="CPDynamicdatalistsDatadefinitions#selectFrame" locator1="DATA_DEFINITIONS_IFRAME" />
		<execute action="CPDynamicdatalistsDatadefinitions#type" locator1="BASIC_SEARCH_FIELD" value1="${dataDefinitionName}" />
		<execute action="CPDynamicdatalistsDatadefinitions#assertClick" locator1="BASIC_SEARCH_BUTTON" value1="Search" />
		<execute action="CPDynamicdatalistsDatadefinitions#assertClick" locator1="DATA_DEFINITION_TABLE_ACTIONS_1" value1="Actions" />
		<execute action="CPDynamicdatalistsDatadefinitions#assertClick" locator1="DATA_DEFINITION_MENULIST_EDIT" value1="Edit" />

		<execute action="CPDynamicdatalistsDatadefinitionsEdit#type" locator1="NAME_FIELD" value1="${dataDefinitionNameEdit}" />
		<execute action="CPDynamicdatalistsDatadefinitionsEdit#type" locator1="DESCRIPTION_FIELD" value1="${dataDefinitionDescriptionEdit}" />
		<execute action="CPDynamicdatalistsDatadefinitionsEdit#assertClick" locator1="SAVE_BUTTON" value1="Save" />

		<execute action="CPDynamicdatalistsDatadefinitions#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />

		<execute action="CPDynamicdatalists#selectFrameTop" />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Dynamic Data Lists" />
		</execute>

		<execute action="CPDynamicdatalists#assertClick" locator1="TOOLBAR_MANAGE_DATA_DEFINITIONS" value1="Manage Data Definitions" />

		<execute action="CPDynamicdatalistsDatadefinitions#selectFrame" locator1="DATA_DEFINITIONS_IFRAME" />
		<execute action="CPDynamicdatalistsDatadefinitions#type" locator1="BASIC_SEARCH_FIELD" value1="Data Definition" />
		<execute action="CPDynamicdatalistsDatadefinitions#assertClick" locator1="BASIC_SEARCH_BUTTON" value1="Search" />

		<while>
			<condition action="CPDynamicdatalistsDatadefinitions#isElementPresent" locator1="DATA_DEFINITION_TABLE_ACTIONS_1" />
			<then>
				<execute action="CPDynamicdatalistsDatadefinitions#assertClick" locator1="DATA_DEFINITION_TABLE_ACTIONS_1" value1="Actions" />
				<execute action="CPDynamicdatalistsDatadefinitions#assertClickNoError" locator1="DATA_DEFINITION_MENULIST_DELETE" value1="Delete" />
				<execute action="CPDynamicdatalistsDatadefinitions#confirm" locator1="CONFIRMATION" value1="Are you sure you want to delete this?" />
				<execute action="CPDynamicdatalistsDatadefinitions#assertTextEquals" locator1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</while>
	</command>

	<command name="viewCP">
		<execute action="CPDynamicdatalists#assertClick" locator1="TOOLBAR_MANAGE_DATA_DEFINITIONS" value1="Manage Data Definitions" />

		<execute action="CPDynamicdatalistsDatadefinitions#selectFrame" locator1="DATA_DEFINITIONS_IFRAME" />
		<execute action="CPDynamicdatalistsDatadefinitions#type" locator1="BASIC_SEARCH_FIELD" value1="${dataDefinitionName}" />
		<execute action="CPDynamicdatalistsDatadefinitions#assertClick" locator1="BASIC_SEARCH_BUTTON" value1="Search" />
		<execute action="CPDynamicdatalistsDatadefinitions#assertClick" locator1="DATA_DEFINITION_TABLE_ACTIONS_1" value1="Actions" />
		<execute action="CPDynamicdatalistsDatadefinitions#assertClick" locator1="DATA_DEFINITION_MENULIST_EDIT" value1="Edit" />

		<execute action="CPDynamicdatalistsDatadefinitionsEdit#assertTextEquals" locator1="HEADER_TITLE" value1="${dataDefinitionName}" />
		<execute action="CPDynamicdatalistsDatadefinitionsEdit#assertTextEquals" locator1="NAME_FIELD" value1="${dataDefinitionName}" />
		<execute action="CPDynamicdatalistsDatadefinitionsEdit#assertTextEquals" locator1="DESCRIPTION_FIELD" value1="${dataDefinitionDescription}" />
		<execute action="CPDynamicdatalistsDatadefinitionsEdit#assertTextEquals" locator1="FORM_FIELD_1" value1="Text" />

		<execute action="CPDynamicdatalists#selectFrameTop" />
	</command>
</definition>