	macro deleteCP {
		AssertClick.assertTextClickAt(
			locator1 = "CPDynamicdatalists#TOOLBAR_MANAGE_DATA_DEFINITIONS",
			value1 = "Manage Data Definitions"
		);

		SelectFrame(
			locator1 = "CPDynamicdatalistsDatadefinitions#DATA_DEFINITIONS_IFRAME"
		);

		Type(
			locator1 = "CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_FIELD",
			value1 = "${dataDefinitionName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertClick(
			locator1 = "CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClickNoError(
			locator1 = "CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsDatadefinitions#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		Type(
			locator1 = "CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_FIELD",
			value1 = "${dataDefinitionName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextNotPresent(value1 = "${dataDefinitionName}");

		SelectFrameTop();
	}

	macro editCP {
		AssertClick.assertTextClickAt(
			locator1 = "CPDynamicdatalists#TOOLBAR_MANAGE_DATA_DEFINITIONS",
			value1 = "Manage Data Definitions"
		);

		SelectFrame(
			locator1 = "CPDynamicdatalistsDatadefinitions#DATA_DEFINITIONS_IFRAME"
		);

		Type(
			locator1 = "CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_FIELD",
			value1 = "${dataDefinitionName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertClick(
			locator1 = "CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_MENULIST_EDIT",
			value1 = "Edit"
		);

		Type.clickAtSendKeys(
			locator1 = "CPDynamicdatalistsDatadefinitionsEdit#NAME_FIELD",
			value1 = "${dataDefinitionNameEdit}"
		);

		Type.clickAtSendKeys(
			locator1 = "CPDynamicdatalistsDatadefinitionsEdit#DESCRIPTION_FIELD",
			value1 = "${dataDefinitionDescriptionEdit}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalistsDatadefinitionsEdit#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsDatadefinitions#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		SelectFrameTop();
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Dynamic Data Lists");

		AssertClick.assertTextClickAt(
			locator1 = "CPDynamicdatalists#TOOLBAR_MANAGE_DATA_DEFINITIONS",
			value1 = "Manage Data Definitions"
		);

		SelectFrame(
			locator1 = "CPDynamicdatalistsDatadefinitions#DATA_DEFINITIONS_IFRAME"
		);

		Type(
			locator1 = "CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_FIELD",
			value1 = "Data Definition"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		while (IsElementPresent(locator1 = "CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_TABLE_ACTIONS_1")) {
			AssertClick(
				locator1 = "CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_TABLE_ACTIONS_1",
				value1 = "Actions"
			);

			AssertClickNoError(
				locator1 = "CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete this?");

			AssertTextEquals(
				locator1 = "CPDynamicdatalistsDatadefinitions#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}
	}

	macro viewCP {
		AssertClick.assertTextClickAt(
			locator1 = "CPDynamicdatalists#TOOLBAR_MANAGE_DATA_DEFINITIONS",
			value1 = "Manage Data Definitions"
		);

		SelectFrame(
			locator1 = "CPDynamicdatalistsDatadefinitions#DATA_DEFINITIONS_IFRAME"
		);

		Type(
			locator1 = "CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_FIELD",
			value1 = "${dataDefinitionName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPDynamicdatalistsDatadefinitions#BASIC_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertClick(
			locator1 = "CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_TABLE_ACTIONS_1",
			value1 = "Actions"
		);

		AssertClick.assertTextClickAt(
			locator1 = "CPDynamicdatalistsDatadefinitions#DATA_DEFINITION_MENULIST_EDIT",
			value1 = "Edit"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsDatadefinitionsEdit#HEADER_TITLE",
			value1 = "${dataDefinitionName}"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsDatadefinitionsEdit#NAME_FIELD",
			value1 = "${dataDefinitionName}"
		);

		AssertTextEquals(
			locator1 = "CPDynamicdatalistsDatadefinitionsEdit#DESCRIPTION_FIELD",
			value1 = "${dataDefinitionDescription}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "CPDynamicdatalistsDatadefinitionsEdit#FORM_FIELD_1",
			value1 = "Text"
		);

		SelectFrameTop();
	}
}