definition {
	var password = "test";
	var userEmailAddress = "test@liferay.com";

	macro apiAxisView {
		Open(locator1 = "Home#API_AXIS_URL");

		AssertTextPresent(value1 = "And now... Some Services");

		AssertTextPresent(value1 = "Portal_LayoutBranchService");

		AssertTextPresent(value1 = "Portal_AccountService");

		AssertTextPresent(value1 = "Portal_CompanyService");
	}

	macro apiJsonwsAddressView {
		Open(locator1 = "Home#API_JSON_URL");

		Click(locator1 = "Jsonwebservices#ADDRESS_ADD_ADDRESS");

		AssertTextEquals(
			locator1 = "JsonwebservicesAddress#API_METHOD",
			value1 = "/address/add-address"
		);

		AssertElementPresent(locator1 = "JsonwebservicesAddress#INVOKE");
	}

	macro apiJsonwsView {
		Open(locator1 = "Home#API_JSON_URL");

		AssertTextEquals(
			locator1 = "Jsonwebservices#INFO_MESSAGE",
			value1 = "Please select a method on the left."
		);

		AssertTextEquals(locator1 = "Jsonwebservices#SITE_NAME", value1 = "JSONWS API");

		AssertElementPresent(locator1 = "Jsonwebservices#SEARCH");

		AssertElementPresent(locator1 = "Jsonwebservices#ADDRESS");

		AssertElementPresent(locator1 = "Jsonwebservices#WIKI_PAGE");
	}

	macro apiJsonwsWikiView {
		Open(locator1 = "Home#API_JSON_URL");

		Click(locator1 = "Jsonwebservices#WIKI_PAGE_ADD_PAGE");

		AssertTextEquals(
			locator1 = "JsonwebservicesWiki#API_METHOD",
			value1 = "/wikipage/add-page"
		);

		AssertElementPresent(locator1 = "JsonwebservicesWiki#INVOKE");
	}
}