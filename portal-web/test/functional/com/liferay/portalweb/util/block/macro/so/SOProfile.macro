	macro viewNoConnection {
		AssertClick(
			locator1 = "SOContactscenter#CONTACTS_LINK_CONNECTIONS",
			value1 = "You have ${filterTypeCount} connections."
		);

		AssertSelectedLabel(
			locator1 = "SOContactscenter#CONTACTS_LIST_FILTER",
			value1 = "Connections"
		);

		AssertTextNotPresent(
			locator1 = "SOContactscenter#CONTACTS_LIST_EMAIL",
			value1 = "${adminEmailAddress}"
		);

		Select(locator1 = "SOContactscenter#CONTACTS_LIST_FILTER", value1 = "All");

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${adminName}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${adminListName}"
		);

		AssertClick.assertTextClickAt(
			locator1 = "SOContactscenter#USER_DETAILS_NAME",
			value1 = "${adminName}"
		);

		AssertTextEquals(locator1 = "SOProfile#USER_NAME", value1 = "${adminName}");

		AssertTextEquals(
			locator1 = "SOProfile#USER_EMAIL",
			value1 = "${adminEmailAddress}"
		);

		AssertElementPresent(locator1 = "SOProfile#CONNECT_BUTTON");

		AssertElementNotPresent(locator1 = "SOProfile#DISCONNECT_BUTTON");
	}

	macro viewPhoneNumbersProfile {
		AssertTextEquals.assertText(
			locator1 = "SOProfile#PROFILE_INFO_PHONE_NUMBERS_TITLE",
			value1 = "Phones:"
		);

		if (isSet(userPhoneNumberExtension)) {
			AssertTextEquals(
				locator1 = "SOProfile#PROFILE_INFO_PHONE_NUMBERS_CONTENT",
				value1 = "${userPhoneNumberType} ${userPhoneNumberNumber} ${userPhoneNumberExtension}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SOProfile#PROFILE_INFO_PHONE_NUMBERS_CONTENT",
				value1 = "${userPhoneNumberType} ${userPhoneNumberNumber}"
			);
		}
	}

