	macro viewConnectionProfile {
		AssertClick(
			locator1 = "SOContactscenter#CONTACTS_LINK_CONNECTIONS",
			value1 = "You have ${filterTypeCount} connections."
		);

		AssertSelectedLabel(
			locator1 = "SOContactscenter#CONTACTS_LIST_FILTER",
			value1 = "Connections"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_EMAIL",
			value1 = "${userEmailAddress}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertClick.assertTextClickAt(
			locator1 = "SOContactscenter#USER_DETAILS_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals(locator1 = "SOProfile#USER_NAME", value1 = "${userName}");

		AssertTextEquals(
			locator1 = "SOProfile#USER_EMAIL",
			value1 = "${userEmailAddress}"
		);

		AssertElementPresent(locator1 = "SOProfile#DISCONNECT_BUTTON");

		AssertElementPresent(locator1 = "SOProfile#FOLLOW_BUTTON");

		AssertElementPresent(locator1 = "SOProfile#BLOCK_BUTTON");

		AssertElementNotPresent(locator1 = "SOProfile#CONNECT_BUTTON");
	}

