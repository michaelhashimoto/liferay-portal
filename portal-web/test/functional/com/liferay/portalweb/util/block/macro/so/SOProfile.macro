	macro addWebsiteProfile {
		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_MY_PROFILE",
			value1 = "My Profile"
		);

		Click(locator1 = "SOProfile#ADD_WEBSITES");

		Type(locator1 = "SOProfileAddWebsite#URL_FIELD", value1 = "${userWebsiteURL}");

		Select(
			locator1 = "SOProfileAddWebsite#TYPE_SELECT",
			value1 = "${userWebsiteType}"
		);

		Click(locator1 = "SOProfileAddWebsite#PRIMARY_RADIO_BUTTON");

		Click(locator1 = "SOProfileAddWebsite#SAVE_BUTTON");

		AssertTextEquals.assertText(
			locator1 = "SOProfile#PROFILE_INFO_WEBSITES_TITLE",
			value1 = "Websites:"
		);

		AssertTextEquals(
			locator1 = "SOProfile#PROFILE_INFO_WEBSITES_CONTENT",
			value1 = "${userWebsiteType} ${userWebsiteURL}"
		);
	}

	macro disconnectFromConnection {
		Select(
			locator1 = "SOContactscenter#CONTACTS_LIST_FILTER",
			value1 = "${filterType}"
		);

		AssertClick(
			locator1 = "SOContactscenter#CONTACTS_LIST_EMAIL",
			value1 = "${userEmailAddress}"
		);

		AssertClick.assertTextClickAt(
			locator1 = "SOContactscenter#USER_DETAILS_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals(locator1 = "SOProfile#USER_NAME", value1 = "${userName}");

		AssertTextEquals(
			locator1 = "SOProfile#USER_EMAIL",
			value1 = "${userEmailAddress}"
		);

		AssertClick(locator1 = "SOProfile#DISCONNECT_BUTTON", value1 = "Disconnect");

		AssertElementPresent(locator1 = "SOProfile#CONNECT_BUTTON");

		AssertElementNotPresent(locator1 = "SOProfile#DISCONNECT_BUTTON");
	}

	macro requestToConnect {
		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${userScreenName}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertClick.pauseAssertTextClickAt(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertClick.assertTextClickAt(
			locator1 = "SOContactscenter#USER_DETAILS_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals(locator1 = "SOProfile#USER_NAME", value1 = "${userName}");

		AssertTextEquals(
			locator1 = "SOProfile#USER_EMAIL",
			value1 = "${userEmailAddress}"
		);

		AssertClick(locator1 = "SOProfile#CONNECT_BUTTON", value1 = "Connect");

		AssertTextEquals(
			locator1 = "SOProfile#CONNECTION_REQUESTED_MESSAGE",
			value1 = "Connection Requested"
		);

		AssertElementNotPresent(locator1 = "SOProfile#CONNECT_BUTTON");
	}

