	macro addPhoneNumbersProfile {
		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_MY_PROFILE",
			value1 = "My Profile"
		);

		Click(locator1 = "SOProfile#ADD_PHONES");

		Type(
			locator1 = "SOProfileAddPhoneNumber#NUMBER_FIELD",
			value1 = "${userPhoneNumberNumber}"
		);

		if (isSet(userPhoneNumberExtension)) {
			Type(
				locator1 = "SOProfileAddPhoneNumber#EXTENSION_FIELD",
				value1 = "${userPhoneNumberExtension}"
			);
		}

		Select(
			locator1 = "SOProfileAddPhoneNumber#TYPE_SELECT",
			value1 = "${userPhoneNumberType}"
		);

		Click(locator1 = "SOProfileAddPhoneNumber#PRIMARY_RADIO_BUTTON");

		Click(locator1 = "SOProfileAddPhoneNumber#SAVE_BUTTON");

		AssertTextEquals.assertText(
			locator1 = "SOProfile#PROFILE_INFO_PHONE_NUMBERS_TITLE",
			value1 = "Phones:"
		);

		if (isSet(userPhoneNumberExtension)) {
			AssertTextEquals(
				locator1 = "SOProfile#PROFILE_INFO_PHONE_NUMBERS_CONTENT",
				value1 = "${userPhoneNumberType} ${userPhoneNumberNumber} ${userPhoneNumberExtension}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "SOProfile#PROFILE_INFO_PHONE_NUMBERS_CONTENT",
				value1 = "${userPhoneNumberType} ${userPhoneNumberNumber}"
			);
		}
	}

