definition {
	macro addAdditionalEmailAddressMyAccount {
		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_MY_ACCOUNT",
			value1 = "My Account"
		);

		Click(locator1 = "CPMyAccount#ADDITIONAL_EMAIL_ADDRESSES");

		Type(
			locator1 = "CPMyAccount#ADDITIONAL_EMAIL_ADDRESSES_EMAIL_ADDRESS_FIELD",
			value1 = "${userAdditionalEmailAddress}"
		);

		Select(
			locator1 = "CPMyAccount#ADDITIONAL_EMAIL_ADDRESSES_TYPE_SELECT",
			value1 = "Email Address"
		);

		Click(locator1 = "CPMyAccount#ADDITIONAL_EMAIL_ADDRESSES_PRIMARY_RADIO_BUTTON");

		Click(locator1 = "CPMyAccount#SAVE_BUTTON");

		AssertTextEquals.assertText(
			locator1 = "CPMyAccount#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro addAdditionalEmailAddressProfile {
		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_MY_PROFILE",
			value1 = "My Profile"
		);

		Click(locator1 = "SOProfile#ADD_EMAIL_ADDRESS");

		Type(
			locator1 = "SOProfileAddAdditionalEmailAddress#EMAIL_ADDRESS_FIELD",
			value1 = "${userAdditionalEmailAddress}"
		);

		Select(
			locator1 = "SOProfileAddAdditionalEmailAddress#TYPE_SELECT",
			value1 = "Email Address"
		);

		Click(locator1 = "SOProfileAddAdditionalEmailAddress#PRIMARY_RADIO_BUTTON");

		Click(locator1 = "SOProfileAddAdditionalEmailAddress#SAVE_BUTTON");

		AssertTextEquals.assertText(
			locator1 = "SOProfile#PROFILE_INFO_EMAIL_ADDRESS_TITLE",
			value1 = "Additional Email Addresses:"
		);

		AssertTextEquals(
			locator1 = "SOProfile#PROFILE_INFO_EMAIL_ADDRESS_CONTENT",
			value1 = "Email Address ${userAdditionalEmailAddress}"
		);
	}

	macro addAddressMyAccount {
		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_MY_ACCOUNT",
			value1 = "My Account"
		);

		Click(locator1 = "CPMyAccount#ADDRESSES");

		Type(
			locator1 = "CPMyAccount#ADDRESSES_STREET_1_FIELD",
			value1 = "${userAddressStreet1}"
		);

		if (isSet(userAddressCountry)) {
			Select(
				locator1 = "CPMyAccount#ADDRESSES_COUNTRY_SELECT",
				value1 = "${userAddressCountry}"
			);
		}

		if (isSet(userAddressRegion)) {
			Select(
				locator1 = "CPMyAccount#ADDRESSES_REGION_SELECT",
				value1 = "${userAddressRegion}"
			);
		}

		if (isSet(userAddressPostalCode)) {
			Type(
				locator1 = "CPMyAccount#ADDRESSES_POSTAL_CODE_FIELD",
				value1 = "${userAddressPostalCode}"
			);
		}

		if (isSet(userAddressType)) {
			Select(
				locator1 = "CPMyAccount#ADDRESSES_TYPE_SELECT",
				value1 = "${userAddressType}"
			);
		}

		Type(
			locator1 = "CPMyAccount#ADDRESSES_CITY_FIELD",
			value1 = "${userAddressCity}"
		);

		Click(locator1 = "CPMyAccount#ADDRESSES_PRIMARY_RADIO_BUTTON");

		Check(locator1 = "CPMyAccount#ADDRESSES_MAILING_CHECKBOX");

		Click(locator1 = "CPMyAccount#SAVE_BUTTON");

		AssertTextEquals.assertText(
			locator1 = "CPMyAccount#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro addAddressProfile {
		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_MY_PROFILE",
			value1 = "My Profile"
		);

		Click(locator1 = "SOProfile#ADD_ADDRESSES");

		Type(
			locator1 = "SOProfileAddAddress#STREET_1_FIELD",
			value1 = "${userAddressStreet1}"
		);

		if (isSet(userAddressPostalCode)) {
			Type(
				locator1 = "SOProfileAddAddress#POSTAL_CODE_FIELD",
				value1 = "${userAddressPostalCode}"
			);
		}

		Type(locator1 = "SOProfileAddAddress#CITY_FIELD", value1 = "${userAddressCity}");

		if (isSet(userAddressType)) {
			Select(
				locator1 = "SOProfileAddAddress#TYPE_SELECT",
				value1 = "${userAddressType}"
			);
		}

		if (isSet(userAddressCountry)) {
			Select(
				locator1 = "SOProfileAddAddress#COUNTRY_SELECT",
				value1 = "${userAddressCountry}"
			);
		}

		Click(locator1 = "SOProfileAddAddress#PRIMARY_RADIO_BUTTON");

		Check(locator1 = "SOProfileAddAddress#MAILING_CHECKBOX");

		if (isSet(userAddressRegion)) {
			Select(
				locator1 = "SOProfileAddAddress#REGION_SELECT",
				value1 = "${userAddressRegion}"
			);
		}

		Click(locator1 = "SOProfileAddAddress#SAVE_BUTTON");

		AssertTextEquals.assertText(
			locator1 = "SOProfile#PROFILE_INFO_ADDRESS_TITLE",
			value1 = "Addresses:"
		);

		AssertTextEquals(
			locator1 = "SOProfile#PROFILE_INFO_ADDRESS_CONTENT",
			value1 = "${userAddressType} ${userAddressStreet1}, ${userAddressCity}, ${userAddressPostalCode}, ${userAddressRegion}, ${userAddressCountry} (Mailing)"
		);
	}

	macro addCommentsMyAccount {
		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_MY_ACCOUNT",
			value1 = "My Account"
		);

		Click(locator1 = "CPMyAccount#COMMENTS");

		Type(locator1 = "CPMyAccount#COMMENTS_FIELD", value1 = "${userIntroduction}");

		Click(locator1 = "CPMyAccount#SAVE_BUTTON");

		AssertTextEquals.assertText(
			locator1 = "CPMyAccount#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro addConnection {
		SOProfile.requestToConnect(
			userEmailAddress = "${userEmailAddress}",
			userListName = "${userListName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOContactsCenter.confirmRequestToConnect(
			senderName = "${adminName}",
			userName = "${userName}"
		);
	}

	macro addInstantMessengerMyAccount {
		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_MY_ACCOUNT",
			value1 = "My Account"
		);

		Click(locator1 = "CPMyAccount#INSTANT_MESSENGER");

		if (isSet(userInstantMessengerAIM)) {
			Type(
				locator1 = "CPMyAccount#INSTANT_MESSENGER_AIM_FIELD",
				value1 = "${userInstantMessengerAIM}"
			);
		}

		if (isSet(userInstantMessengerICQ)) {
			Type(
				locator1 = "CPMyAccount#INSTANT_MESSENGER_ICQ_FIELD",
				value1 = "${userInstantMessengerICQ}"
			);
		}

		if (isSet(userInstantMessengerJabber)) {
			Type(
				locator1 = "CPMyAccount#INSTANT_MESSENGER_JABBER_FIELD",
				value1 = "${userInstantMessengerJabber}"
			);
		}

		if (isSet(userInstantMessengerSkype)) {
			Type(
				locator1 = "CPMyAccount#INSTANT_MESSENGER_SKYPE_FIELD",
				value1 = "${userInstantMessengerSkype}"
			);
		}

		if (isSet(userInstantMessengerWindowsLiveMessenger)) {
			Type(
				locator1 = "CPMyAccount#INSTANT_MESSENGER_WINDOWS_LIVE_MESSENGER_FIELD",
				value1 = "${userInstantMessengerWindowsLiveMessenger}"
			);
		}

		if (isSet(userInstantMessengerYM)) {
			Type(
				locator1 = "CPMyAccount#INSTANT_MESSENGER_YM_FIELD",
				value1 = "${userInstantMessengerYM}"
			);
		}

		Click(locator1 = "CPMyAccount#SAVE_BUTTON");

		AssertTextEquals.assertText(
			locator1 = "CPMyAccount#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

	macro addInstantMessengerProfile {
		Click(locator1 = "SOUserBar#USER_NAME");

		AssertClick.assertTextClickAt(
			locator1 = "SOUserBar#USER_MENU_MY_PROFILE",
			value1 = "My Profile"
		);

		Click(locator1 = "SOProfile#ADD_INSTANT_MESSENGER");

		if (isSet(userInstantMessengerAIM)) {
			Type(
				locator1 = "SOProfileAddInstantMessenger#AIM_FIELD",
				value1 = "${userInstantMessengerAIM}"
			);
		}

		if (isSet(userInstantMessengerICQ)) {
			Type(
				locator1 = "SOProfileAddInstantMessenger#ICQ_FIELD",
				value1 = "${userInstantMessengerICQ}"
			);
		}

		if (isSet(userInstantMessengerJabber)) {
			Type(
				locator1 = "SOProfileAddInstantMessenger#JABBER_FIELD",
				value1 = "${userInstantMessengerJabber}"
			);
		}

		if (isSet(userInstantMessengerSkype)) {
			Type(
				locator1 = "SOProfileAddInstantMessenger#SKYPE_FIELD",
				value1 = "${userInstantMessengerSkype}"
			);
		}

		if (isSet(userInstantMessengerWindowsLiveMessenger)) {
			Type(
				locator1 = "SOProfileAddInstantMessenger#WINDOWS_LIVE_MESSENGER_FIELD",
				value1 = "${userInstantMessengerWindowsLiveMessenger}"
			);
		}

		if (isSet(userInstantMessengerYM)) {
			Type(
				locator1 = "SOProfileAddInstantMessenger#YM_FIELD",
				value1 = "${userInstantMessengerYM}"
			);
		}

		Click(locator1 = "SOProfileAddAddress#SAVE_BUTTON");

		AssertTextEquals.assertText(
			locator1 = "SOProfile#PROFILE_INFO_INSTANT_MESSENGER_TITLE",
			value1 = "Instant Messenger:"
		);

		AssertTextEquals(
			locator1 = "SOProfile#PROFILE_INFO_INSTANT_MESSENGER_AIM_CONTENT",
			value1 = "AIM ${userInstantMessengerAIM}"
		);

		AssertTextEquals(
			locator1 = "SOProfile#PROFILE_INFO_INSTANT_MESSENGER_ICQ_CONTENT",
			value1 = "ICQ ${userInstantMessengerICQ}"
		);

		AssertTextEquals(
			locator1 = "SOProfile#PROFILE_INFO_INSTANT_MESSENGER_JABBER_CONTENT",
			value1 = "Jabber ${userInstantMessengerJabber}"
		);

		AssertTextEquals(
			locator1 = "SOProfile#PROFILE_INFO_INSTANT_MESSENGER_MSN_CONTENT",
			value1 = "msn ${userInstantMessengerWindowsLiveMessenger}"
		);

		AssertTextEquals(
			locator1 = "SOProfile#PROFILE_INFO_INSTANT_MESSENGER_SKYPE_CONTENT",
			value1 = "Skype ${userInstantMessengerSkype}"
		);

		AssertTextEquals(
			locator1 = "SOProfile#PROFILE_INFO_INSTANT_MESSENGER_YM_CONTENT",
			value1 = "ym ${userInstantMessengerYM}"
		);
	}

