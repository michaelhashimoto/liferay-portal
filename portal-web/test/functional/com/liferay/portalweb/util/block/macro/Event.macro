	macro editPG {
		var key_eventTitle = "${eventTitle}";

		AssertClick.assertTextClickAt(
			locator1 = "PGCalendar#VIEW_SUMMARY",
			value1 = "Summary"
		);

		AssertTextEquals(
			locator1 = "PGCalendar#EVENT_TABLE_TITLE",
			value1 = "${eventTitle}"
		);

		AssertClick(locator1 = "PGCalendar#EVENT_TABLE_ACTIONS", value1 = "Actions");

		AssertClick(locator1 = "PGCalendar#EVENT_MENULIST_EDIT", value1 = "Edit");

		Type(locator1 = "PGCalendarEditEvent#TITLE_FIELD", value1 = "${eventTitleEdit}");

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "PGCalendarEditEvent#DESCRIPTION_FIELD",
			value1 = "${eventDescriptionEdit}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGCalendarEditEvent#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "PGCalendar#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertElementPresent(locator1 = "PGCalendar#EVENT_TABLE_TIME");

		AssertTextEquals(
			locator1 = "PGCalendar#EVENT_TABLE_TITLE",
			value1 = "${eventTitleEdit}"
		);

		AssertTextEquals(
			locator1 = "PGCalendar#EVENT_TABLE_TYPE",
			value1 = "Anniversary"
		);

		AssertTextEquals(
			locator1 = "PGCalendar#EVENT_TABLE_ACTIONS",
			value1 = "Actions"
		);
	}

	macro tearDownCP {
		Page.gotoCP(portletName = "Calendar");

		AssertClick.assertTextClickAt(
			locator1 = "PGCalendar#VIEW_EVENTS",
			value1 = "Events"
		);

		while (IsElementPresent(locator1 = "CPCalendarEvents#EVENT_TABLE_ACTIONS", value1 = "Actions")) {
			AssertClick(
				locator1 = "CPCalendarEvents#EVENT_TABLE_ACTIONS",
				value1 = "Actions"
			);

			AssertClickNoError(
				locator1 = "CPCalendarEvents#EVENT_MENULIST_DELETE",
				value1 = "Delete"
			);

			Confirm(value1 = "Are you sure you want to delete this?");

			AssertTextEquals(
				locator1 = "CPCalendarEvents#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);
		}

		AssertElementNotPresent(
			locator1 = "CPCalendarEvents#EVENT_TABLE_ACTIONS",
			value1 = "Actions"
		);
	}

	macro viewDetailsPG {
		if (isSet(number)) {
			var number = "${number}";

			AssertTextEquals(
				locator1 = "PGCalendarEventDetails#EVENT_TITLE",
				value1 = "${eventTitle}${number}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "PGCalendarEventDetails#EVENT_TITLE",
				value1 = "${eventTitle}"
			);
		}

		AssertTextEquals(
			locator1 = "PGCalendarEventDetails#START_DATE",
			value1 = "Start Date:"
		);

		AssertTextEquals(
			locator1 = "PGCalendarEventDetails#END_DATE",
			value1 = "End Date:"
		);

		AssertTextEquals(
			locator1 = "PGCalendarEventDetails#DURATION",
			value1 = "Duration:"
		);

		AssertTextEquals(locator1 = "PGCalendarEventDetails#TYPE", value1 = "Type:");

		if (isSet(number)) {
			var number = "${number}";

			AssertTextEquals(
				locator1 = "PGCalendarEventDetails#EVENT_DESCRIPTION",
				value1 = "${eventDescription}${number}"
			);
		}
		else {
			AssertTextEquals(
				locator1 = "PGCalendarEventDetails#EVENT_DESCRIPTION",
				value1 = "${eventDescription}"
			);
		}

		AssertTextEquals(
			locator1 = "PGCalendarEventDetails#YOUR_RATING",
			value1 = "Your Rating"
		);

		AssertTextEquals(
			locator1 = "PGCalendarEventDetails#AVERAGE",
			value1 = "Average (0 Votes)"
		);

		AssertTextEquals(
			locator1 = "PGCalendarEventDetails#NO_COMMENTS_YET",
			value1 = "No comments yet. Be the first. Subscribe to Comments"
		);

		AssertTextEquals(
			locator1 = "PGCalendarEventDetails#BE_THE_FIRST_LINK",
			value1 = "Be the first."
		);

		AssertTextEquals(
			locator1 = "PGCalendarEventDetails#SUBSCRIBE_TO_COMMENTS_LINK",
			value1 = "Subscribe to Comments"
		);
	}

	macro viewPG {
		var key_eventTitle = "${eventTitle}";

		AssertClick.assertTextClickAt(
			locator1 = "PGCalendar#EVENT_TABLE_TITLE",
			value1 = "${eventTitle}"
		);

		Event.viewDetailsPG();
	}
}