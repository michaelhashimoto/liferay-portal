definition {
	macro addCP {
		AssertClick.assertTextClickAt(
			locator1 = "CPCalendar#VIEW_SUMMARY",
			value1 = "Summary"
		);

		AssertClick.assertValueClickAt(
			locator1 = "CPCalendar#ADD_EVENT_BUTTON",
			value1 = "Add Event"
		);

		Type(locator1 = "CPCalendarAddEvent#TITLE_FIELD", value1 = "${eventTitle}");

		AssertClick.assertValueClickAt(
			locator1 = "CPCalendarAddEvent#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPCalendar#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertElementPresent(locator1 = "CPCalendar#EVENT_TABLE_TIME");

		AssertTextEquals(
			locator1 = "CPCalendar#EVENT_TABLE_TITLE",
			value1 = "${eventTitle}"
		);

		AssertTextEquals(
			locator1 = "CPCalendar#EVENT_TABLE_TYPE",
			value1 = "Anniversary"
		);

		AssertTextEquals(
			locator1 = "CPCalendar#EVENT_TABLE_ACTIONS",
			value1 = "Actions"
		);
	}

	macro addPG {
		var key_eventTitle = "${eventTitle}";

		if (isSet(daysIntoFuture)) {
			var dayNumber = "0";

			AssertClick.assertTextClickAt(locator1 = "PGCalendar#VIEW_DAY", value1 = "Day");

			while (!("${dayNumber}" == "${daysIntoFuture}")) {
				var dayNumber = MathUtil.sum("${dayNumber}", "1");

				Click.clickAt(locator1 = "PGCalendar#NEXT_BUTTON");
			}
		}
		else {
			AssertClick.assertTextClickAt(
				locator1 = "PGCalendar#VIEW_SUMMARY",
				value1 = "Summary"
			);
		}

		AssertClick.assertValueClickAt(
			locator1 = "PGCalendar#ADD_EVENT_BUTTON",
			value1 = "Add Event"
		);

		if (isSet(number)) {
			var number = "${number}";

			Type(
				locator1 = "PGCalendarAddEvent#TITLE_FIELD",
				value1 = "${eventTitle}${number}"
			);

			SelectFrame(locator1 = "PGCalendarAddEvent#DESCRIPTION_FIELD");

			Type.typeCKEditorWaitForCKEditor(
				locator1 = "PGCalendarAddEvent#DESCRIPTION_FIELD",
				value1 = "${eventDescription}${number}"
			);

			AssertClick.assertValueClickAt(
				locator1 = "PGCalendarAddEvent#SAVE_BUTTON",
				value1 = "Save"
			);

			AssertTextEquals(
				locator1 = "PGCalendar#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);

			AssertClick.assertTextClickAt(
				locator1 = "PGCalendar#VIEW_SUMMARY",
				value1 = "Summary"
			);

			AssertElementPresent(locator1 = "PGCalendar#EVENT_TABLE_TIME_INCREMENT");

			AssertTextEquals(
				locator1 = "PGCalendar#EVENT_TABLE_TITLE_INCREMENT",
				value1 = "${eventTitle}${number}"
			);

			AssertTextEquals(
				locator1 = "PGCalendar#EVENT_TABLE_TYPE_INCREMENT",
				value1 = "Anniversary"
			);

			AssertTextEquals(
				locator1 = "PGCalendar#EVENT_TABLE_ACTIONS_INCREMENT",
				value1 = "Actions"
			);
		}
		else {
			Type(locator1 = "PGCalendarAddEvent#TITLE_FIELD", value1 = "${eventTitle}");

			Type.typeCKEditorWaitForCKEditor(
				locator1 = "PGCalendarAddEvent#DESCRIPTION_FIELD",
				value1 = "${eventDescription}"
			);

			AssertClick.assertValueClickAt(
				locator1 = "PGCalendarAddEvent#SAVE_BUTTON",
				value1 = "Save"
			);

			AssertTextEquals(
				locator1 = "PGCalendar#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully."
			);

			AssertClick.assertTextClickAt(
				locator1 = "PGCalendar#VIEW_SUMMARY",
				value1 = "Summary"
			);

			AssertElementPresent(locator1 = "PGCalendar#EVENT_TABLE_TIME");

			AssertTextEquals(
				locator1 = "PGCalendar#EVENT_TABLE_TITLE",
				value1 = "${eventTitle}"
			);

			AssertTextEquals(
				locator1 = "PGCalendar#EVENT_TABLE_TYPE",
				value1 = "Anniversary"
			);

			AssertTextEquals(
				locator1 = "PGCalendar#EVENT_TABLE_ACTIONS",
				value1 = "Actions"
			);
		}
	}

	macro addRepeatMonthlyPG {
		var key_eventTitle = "${eventTitle}";

		AssertClick.assertValueClickAt(
			locator1 = "PGCalendar#ADD_EVENT_BUTTON",
			value1 = "Add Event"
		);

		Select(
			locator1 = "PGCalendarAddEvent#START_DATE_MONTH_SELECT",
			value1 = "${eventStartMonth}"
		);

		Select(
			locator1 = "PGCalendarAddEvent#START_DATE_DAY_SELECT",
			value1 = "${eventStartDay}"
		);

		Select(
			locator1 = "PGCalendarAddEvent#START_DATE_YEAR_SELECT",
			value1 = "${eventStartYear}"
		);

		Type(locator1 = "PGCalendarAddEvent#TITLE_FIELD", value1 = "${eventTitle}");

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "PGCalendarAddEvent#DESCRIPTION_FIELD",
			value1 = "${eventDescription}"
		);

		Select(locator1 = "PGCalendarAddEvent#TYPE_SELECT", value1 = "${eventType}");

		Check(
			locator1 = "PGCalendarAddEvent#REPEAT_MONTHLY_CHECKBOX",
			value1 = "Monthly"
		);

		Check(locator1 = "PGCalendarAddEvent#REPEAT_END_DATE", value1 = "End By");

		Select(
			locator1 = "PGCalendarAddEvent#END_DATE_MONTH_SELECT",
			value1 = "${eventEndMonth}"
		);

		Select(
			locator1 = "PGCalendarAddEvent#END_DATE_DAY_SELECT",
			value1 = "${eventEndDay}"
		);

		Select(
			locator1 = "PGCalendarAddEvent#END_DATE_YEAR_SELECT",
			value1 = "${eventEndYear}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGCalendarAddEvent#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "PGCalendar#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertClick.assertTextClickAt(
			locator1 = "PGCalendar#VIEW_EVENTS",
			value1 = "Events"
		);

		AssertElementPresent(locator1 = "PGCalendar#EVENT_TABLE_TIME");

		AssertTextEquals(
			locator1 = "PGCalendar#EVENT_TABLE_TITLE",
			value1 = "${eventTitle}"
		);

		AssertTextEquals(
			locator1 = "PGCalendar#EVENT_TABLE_TYPE",
			value1 = "${eventType}"
		);

		AssertTextEquals(
			locator1 = "PGCalendar#EVENT_TABLE_ACTIONS",
			value1 = "Actions"
		);
	}

	macro addRepeatWeeklyPG {
		var key_eventTitle = "${eventTitle}";

		AssertClick.assertValueClickAt(
			locator1 = "PGCalendar#ADD_EVENT_BUTTON",
			value1 = "Add Event"
		);

		Select(
			locator1 = "PGCalendarAddEvent#START_DATE_MONTH_SELECT",
			value1 = "${eventStartMonth}"
		);

		Select(
			locator1 = "PGCalendarAddEvent#START_DATE_DAY_SELECT",
			value1 = "${eventStartDay}"
		);

		Select(
			locator1 = "PGCalendarAddEvent#START_DATE_YEAR_SELECT",
			value1 = "${eventStartYear}"
		);

		Type(locator1 = "PGCalendarAddEvent#TITLE_FIELD", value1 = "${eventTitle}");

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "PGCalendarAddEvent#DESCRIPTION_FIELD",
			value1 = "${eventDescription}"
		);

		Select(locator1 = "PGCalendarAddEvent#TYPE_SELECT", value1 = "${eventType}");

		Check(
			locator1 = "PGCalendarAddEvent#REPEAT_WEEKLY_CHECKBOX",
			value1 = "Repeat Weekly Checkbox"
		);

		Check(locator1 = "PGCalendarAddEvent#REPEAT_SUNDAY", value1 = "Sunday");

		Check(locator1 = "PGCalendarAddEvent#REPEAT_END_DATE", value1 = "End By");

		Select(
			locator1 = "PGCalendarAddEvent#END_DATE_MONTH_SELECT",
			value1 = "${eventEndMonth}"
		);

		Select(
			locator1 = "PGCalendarAddEvent#END_DATE_DAY_SELECT",
			value1 = "${eventEndDay}"
		);

		Select(
			locator1 = "PGCalendarAddEvent#END_DATE_YEAR_SELECT",
			value1 = "${eventEndYear}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGCalendarAddEvent#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "PGCalendar#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertClick.assertTextClickAt(
			locator1 = "PGCalendar#VIEW_EVENTS",
			value1 = "Events"
		);

		AssertElementPresent(locator1 = "PGCalendar#EVENT_TABLE_TIME");

		AssertTextEquals(
			locator1 = "PGCalendar#EVENT_TABLE_TITLE",
			value1 = "${eventTitle}"
		);

		AssertTextEquals(
			locator1 = "PGCalendar#EVENT_TABLE_TYPE",
			value1 = "${eventType}"
		);

		AssertTextEquals(
			locator1 = "PGCalendar#EVENT_TABLE_ACTIONS",
			value1 = "Actions"
		);
	}

	macro deleteCP {
		AssertClick.assertTextClickAt(
			locator1 = "CPCalendar#VIEW_SUMMARY",
			value1 = "Summary"
		);

		AssertTextEquals(
			locator1 = "CPCalendar#EVENT_TABLE_TITLE",
			value1 = "${eventTitle}"
		);

		AssertClick(locator1 = "CPCalendar#EVENT_TABLE_ACTIONS", value1 = "Actions");

		AssertClickNoError(
			locator1 = "CPCalendar#EVENT_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete this?");

		AssertTextEquals(
			locator1 = "CPCalendar#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);
	}

