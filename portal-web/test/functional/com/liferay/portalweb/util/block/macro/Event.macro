	macro editCP {
		AssertClick.assertTextClickAt(
			locator1 = "CPCalendar#VIEW_SUMMARY",
			value1 = "Summary"
		);

		AssertTextEquals(
			locator1 = "CPCalendar#EVENT_TABLE_TITLE",
			value1 = "${eventTitle}"
		);

		AssertClick(locator1 = "CPCalendar#EVENT_TABLE_ACTIONS", value1 = "Actions");

		AssertClick(locator1 = "CPCalendar#EVENT_MENULIST_EDIT", value1 = "Edit");

		Type(locator1 = "CPCalendarEditEvent#TITLE_FIELD", value1 = "${eventTitleEdit}");

		AssertClick.assertValueClickAt(
			locator1 = "CPCalendarEditEvent#SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals(
			locator1 = "CPCalendar#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertElementPresent(locator1 = "CPCalendar#EVENT_TABLE_TIME");

		AssertTextEquals(
			locator1 = "CPCalendar#EVENT_TABLE_TITLE",
			value1 = "${eventTitleEdit}"
		);

		AssertTextEquals(
			locator1 = "CPCalendar#EVENT_TABLE_TYPE",
			value1 = "Anniversary"
		);

		AssertTextEquals(
			locator1 = "CPCalendar#EVENT_TABLE_ACTIONS",
			value1 = "Actions"
		);
