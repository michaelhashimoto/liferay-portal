definition {
	macro addCP {
		AssertClick(
			locator1 = "CPCategories#VOCABULARY_ENTRY_2",
			value1 = "${vocabularyName}"
		);

		AssertClick(
			locator1 = "CPCategories#ADD_CATEGORY_BUTTON",
			value1 = "Add Category"
		);

		Type(
			locator1 = "CPCategories#ADD_CATEGORY_NAME_FIELD",
			value1 = "${categoryName}"
		);

		AssertClick(locator1 = "CPCategories#ADD_CATEGORY_SAVE_BUTTON", value1 = "Save");

		AssertTextEquals.assertTextNoWaitForText(
			locator1 = "CPCategories#SUCCESS_MESSAGE",
			value1 = "Your request processed successfully."
		);

		AssertTextEquals(
			locator1 = "CPCategories#VOCABULARY_CATEGORY_1",
			value1 = "${categoryName}"
		);
	}

	macro deleteCPByActions {
		AssertClick(
			locator1 = "CPCategories#VOCABULARY_ENTRY_2",
			value1 = "${vocabularyName}"
		);

		AssertTextEquals(
			locator1 = "CPCategories#VOCABULARY_CATEGORY_1",
			value1 = "${categoryName}"
		);

		Click(locator1 = "CPCategories#ALL_CATEGORIES_CHECKBOX");

		AssertClick(locator1 = "CPCategories#ACTIONS_BUTTON", value1 = "Actions");

		AssertClickNoError(
			locator1 = "CPCategories#ACTIONS_MENULIST_DELETE",
			value1 = "Delete"
		);

		Confirm(value1 = "Are you sure you want to delete the selected categories?");

		AssertTextEquals.assertTextNoWaitForText(
			locator1 = "CPCategories#SUCCESS_MESSAGE",
			value1 = "Your request processed successfully."
		);

		AssertTextEquals(
			locator1 = "CPCategories#INFO_MESSAGE",
			value1 = "There are no categories."
		);

		AssertTextNotPresent(value1 = "${categoryName}");
	}

	macro editCP {
		AssertClick(
			locator1 = "CPCategories#VOCABULARY_ENTRY_2",
			value1 = "${vocabularyName}"
		);

		AssertClick(
			locator1 = "CPCategories#VOCABULARY_CATEGORY_1",
			value1 = "${categoryName}"
		);

		AssertClick(
			locator1 = "CPCategories#CATEGORY_DETAILS_EDIT_BUTTON",
			value1 = "Edit"
		);

		Type(
			locator1 = "CPCategories#EDIT_CATEGORY_NAME_FIELD",
			value1 = "${categoryNameEdit}"
		);

		AssertClick(
			locator1 = "CPCategories#EDIT_CATEGORY_SAVE_BUTTON",
			value1 = "Save"
		);

		AssertTextEquals.assertTextNoWaitForText(
			locator1 = "CPCategories#SUCCESS_MESSAGE",
			value1 = "Your request processed successfully."
		);

		AssertTextEquals(
			locator1 = "CPCategories#VOCABULARY_CATEGORY_1",
			value1 = "${categoryNameEdit}"
		);
	}
}