@default = "mouseDown"
definition {
	function javaScriptMouseDown {
		selenium.javaScriptMouseDown();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function mouseDown {
		selenium.mouseDown();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function mouseDownAt {
		selenium.mouseDownAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}
}