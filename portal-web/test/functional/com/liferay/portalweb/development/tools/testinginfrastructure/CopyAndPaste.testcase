@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testcase.url = "http://the-internet.herokuapp.com/tinymce";
	property testray.main.component.name = "Tools";

	@priority = "5"
	test CopyAndPaste {
		SelectFrame(locator1 = "CopyAndPaste#EDITOR_IFRAME");

		AssertTextEquals(
			locator1 = "CopyAndPaste#PASTE_TEXT_AREA",
			value1 = "Your content goes here."
		);

		SelectFrame(locator1 = "//body");

		AssertTextEquals(
			locator1 = "CopyAndPaste#COPY_TEST_LABEL",
			value1 = "An iFrame containing the TinyMCE WYSIWYG Editor"
		);

		Copy(locator1 = "CopyAndPaste#COPY_TEST_LABEL");

		SelectFrame(locator1 = "CopyAndPaste#EDITOR_IFRAME");

		Paste(locator1 = "CopyAndPaste#PASTE_TEXT_AREA");

		AssertTextEquals(
			locator1 = "CopyAndPaste#PASTE_TEXT_AREA",
			value1 = "An iFrame containing the TinyMCE WYSIWYG Editor"
		);
	}
}