@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testcase.url = "";
	property testray.main.component.name = "Tools";

	@priority = "5"
	test ContainsConditionalUsingTwoEmptyStringVariables {
		echo("Test null values: 'contains' if clause comparing two empty string variables");

		var emptyString1 = "";
		var emptyString2 = "";

		if (contains("${emptyString1}", "${emptyString2}")) {
			TestUtils.pass();
		}
		else {
			TestUtils.fail();
		}
	}

	@priority = "5"
	test EchoEmptyStringAndEmptyStringVariable {
		echo("Test null values: echo the empty string and empty var");

		var emptyString = "";

		echo("${emptyString}");

		echo("");

		echo("PASSED if two new lines were outputted\n");
	}

	@priority = "5"
	test EqualsConditionalComparingEmptyStringVariableWithEmptyString {
		echo("Test null values: 'equals' if clause comparing one empty string var against the empty string");

		var emptyString = "";

		if ("${emptyString}" == "") {
			TestUtils.pass();
		}
		else {
			TestUtils.fail();
		}
	}

	@priority = "5"
	test EqualsConditionalUsingTwoEmptyStringVariables {
		echo("Test null values: 'equals' if clause comparing two empty string variables");

		var emptyString1 = "";
		var emptyString2 = "";

		if ("${emptyString1}" == "${emptyString2}") {
			TestUtils.pass();
		}
		else {
			TestUtils.fail();
		}
	}

	@priority = "5"
	test TypeEmptyString {
		echo("Test null values: typing the empty string into a field");

		User.firstLoginPG();

		TestUtils.typeIntoField(text = "");

		TestUtils.pass();
	}
}