@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testcase.url = "http://the-internet.herokuapp.com/status_codes";
	property testray.main.component.name = "Tools";

	@priority = "5"
	test EchoStatement {
		echo("echoMessage");
	}

	@priority = "5"
	test ForLoops {
		var list = "1,2,3";

		for (var param : list "${list}") {
			echo("${param}");
		}

		for (var param : list "a,b,c") {
			echo("${param}");
		}
	}

	@priority = "5"
	test IfStatements {
		if (IsElementPresent(locator1 = "ActionLog#PAGE_TITLE")) {
			TestUtils.pass(message = "Webpage title element was found: PASS");
		}
		else {
			TestUtils.fail(message = "Webpage title element was not found: FAIL");
		}

		if (contains("string", "substring")) {
			TestUtils.fail(message = "Matched incorrect substring to string: FAIL");
		}
		else {
			TestUtils.pass(message = "Did not match incorrect substring: PASS");
		}

		if ("arg1" == "arg2") {
			TestUtils.fail(message = "Incorrectly matched arg1 to arg2: FAIL");
		}
		else {
			TestUtils.pass(message = "Did not match arg1 to arg2: PASS");
		}

		if (isSet(var)) {
			TestUtils.fail(message = "Detected non-set variable var as set: FAIL");
		}
		else {
			TestUtils.pass(message = "Detected variable var is not set: PASS");
		}

		if (("a" == "a") && ("b" == "b")) {
			TestUtils.pass(message = "Both condition cases match: PASS");
		}
		else {
			TestUtils.fail(message = "One or both condition cases did not match: FAIL");
		}
	}

	@priority = "5"
	test WhileLoops {
		while (IsElementNotPresent(locator1 = "ActionLog#PAGE_TITLE")) {
			TestUtils.fail(
				message = "Element is present and should not go into this while loop: FAIL"
			);
		}

		while (contains("string", "substring")) {
			TestUtils.fail(message = "Matched an incorrect substring: FAIL");
		}

		while ("arg1" == "arg2") {
			TestUtils.fail(message = "arg1 does not equal arg2: FAIL");
		}

		var number = "0";

		while (!("${number}" == "4")) {
			var number = MathUtil.sum("1", "${number}");
		}

		if ("${number}" == "4") {
			TestUtils.pass(message = "Ending condition sum was 4: PASS");
		}
		else {
			TestUtils.fail(message = "Ending condition sum was NOT 4: FAIL");
		}

		while (isSet(var)) {
			TestUtils.fail(message = "var is not set: FAIL");
		}
	}
}