@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Tools";

	setUp {
		User.firstLoginPG();
	}

	tearDown {
		Page.tearDownPG();
	}

	@priority = "5"
	test ContainsConditionalWithUTF8Characters {
		echo("Test UTF8 Characters: 'contains' conditional clause values");

		if (contains("りんご", "りんご")) {
			TestUtils.pass();
		}
	}

	@priority = "5"
	test EchoUTF8Characters {
		echo("Test UTF8 Characters: echo message");

		echo("りんご");
	}

	@priority = "5"
	test EqualsConditionalWithUTF8Characters {
		echo("Test UTF8 Characters: 'equals' conditional clause values");

		if ("りんご" == "りんご") {
			TestUtils.pass();
		}
	}

	@priority = "5"
	test TypeAndAssertInlineUTF8Characters {
		echo("Test UTF8 Characters: typing and asserting inline values");

		Page.openURL();

		Click(locator1 = "Dockbar#ADD", value1 = "Add");

		AssertClick.assertTextClickAt(locator1 = "Dockbar#ADD_PAGE", value1 = "Page");

		Type(locator1 = "Home#NEW_PAGE_FIELD", value1 = "りんご");

		Click(locator1 = "Home#NEW_PAGE_SAVE");

		var key_pageName = "りんご";

		AssertClick.assertTextClickAt(locator1 = "Home#PAGE", value1 = "りんご");

		TestUtils.pass();
	}

	@priority = "5"
	test TypeAndAssertUTF8CharactersSavedInVariable {
		echo("Test UTF8 Characters: typing and asserting a variable value");

		var test = "りんご";

		Page.openURL();

		Click(locator1 = "Dockbar#ADD", value1 = "Add");

		AssertClick.assertTextClickAt(locator1 = "Dockbar#ADD_PAGE", value1 = "Page");

		Type(locator1 = "Home#NEW_PAGE_FIELD", value1 = "${test}");

		Click(locator1 = "Home#NEW_PAGE_SAVE");

		var key_pageName = "${test}";

		AssertClick.assertTextClickAt(locator1 = "Home#PAGE", value1 = "${test}");

		TestUtils.pass();
	}
}