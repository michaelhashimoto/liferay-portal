definition {
	macro assertEquals {
		echo("${expected}");

		echo("${actual}");

		if ("${expected}" == "${actual}") {
			echo("PASSED");
		}
		else {
			TestUtils.fail(
				message = "FAILED: expected &apos;${expected}&apos;, actual was &apos;${actual}&apos;"
			);
		}
	}

	macro fail {
		if (!(isSet(message))) {
			var message = "FAIL";
		}

		echo("${message}");

		fail("${message}");
	}

	macro pass {
		if (!(isSet(message))) {
			var message = "PASS";
		}

		echo("${message}");
	}

	macro typeIntoField {
		Page.openURL();

		Click(locator1 = "Dockbar#ADD", value1 = "Add");

		AssertClick.assertTextClickAt(locator1 = "Dockbar#ADD_PAGE", value1 = "Page");

		Type(locator1 = "Home#NEW_PAGE_FIELD", value1 = "${text}");

		AssertTextEquals(locator1 = "Home#NEW_PAGE_FIELD", value1 = "${text}");
	}
}