@component-name = "portal-tools"
definition {
	property browser.type = "android";
	property portal.release = "true";
	property portal.upstream = "false";
	property testray.main.component.name = "Tools";

	@priority = "5"
	test BrowseGoogle {
		Open(locator1 = "www.google.com");

		Pause(locator1 = "5000");
	}

	@priority = "5"
	test Smoke {
		User.firstLoginPG();
	}
}