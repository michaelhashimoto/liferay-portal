@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testcase.url = "";
	property testray.main.component.name = "Tools";

	@priority = "5"
	test GetIPAddress {
		echo("Test getIPAddress()");

		var ipAddress = "${getIPAddress()}";

		echo("${ipAddress}");
	}

	@priority = "5"
	test Increment {
		echo("Test increment()");

		var number = "1";
		var numberIncremented = MathUtil.sum("${number}", "1");

		TestUtils.assertEquals(actual = "${numberIncremented}", expected = "2");

		echo("Test increment() used inline");

		TestUtils.assertEquals(actual = MathUtil.sum("${number}", "1"), expected = "2");
	}

	@priority = "5"
	test Length {
		echo("Test StringUtil#length");

		var string = "abcde";
		var stringLength = StringUtil.length("${string}");

		TestUtils.assertEquals(actual = "${stringLength}", expected = "5");

		echo("Test StringUtil#length used inline");

		TestUtils.assertEquals(actual = StringUtil.length("${string}"), expected = "5");
	}

	@priority = "5"
	test Lowercase {
		echo("Test lowercase()");

		var string = "abCDe";
		var stringLowercased = StringUtil.lowerCase("${string}");

		TestUtils.assertEquals(actual = "${stringLowercased}", expected = "abcde");

		echo("Test lowercase() used inline");

		TestUtils.assertEquals(
			actual = StringUtil.lowerCase("${string}"),
			expected = "abcde"
		);
	}

	@priority = "5"
	test Regex {
		var regex = RegexUtil.replace("regularexpression=32132", "[a-z]*=([0-9]*)", "0");

		TestUtils.assertEquals(
			actual = "${regex}",
			expected = "regularexpression=32132"
		);

		var regex = RegexUtil.replace("regularexpression=32132", "[a-z]*=([0-9]*)", "1");

		TestUtils.assertEquals(actual = "${regex}", expected = "32132");
	}

	@priority = "5"
	test Replace {
		echo("Test replace()");

		var string = "abcde";
		var stringReplaced = StringUtil.replace("${string}", "abc", "123");

		TestUtils.assertEquals(actual = "${stringReplaced}", expected = "123de");

		echo("Test replace() used inline");

		TestUtils.assertEquals(
			actual = StringUtil.replace("${string}", "abc", "123"),
			expected = "123de"
		);
	}

	@priority = "5"
	test Uppercase {
		echo("Test uppercase()");

		var string = "abCDe";
		var stringUppercased = StringUtil.upperCase("${string}");

		TestUtils.assertEquals(actual = "${stringUppercased}", expected = "ABCDE");

		echo("Test uppercase() used inline");

		TestUtils.assertEquals(
			actual = StringUtil.upperCase("${string}"),
			expected = "ABCDE"
		);
	}
}