@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Tools";

	@priority = "5"
	test StopAndStartAppServer {
		AntCommand(locator1 = "build-test.xml", value1 = "stop-app-server");

		AntCommand(locator1 = "build-test.xml", value1 = "start-app-server");

		User.firstLoginPG();
	}
}