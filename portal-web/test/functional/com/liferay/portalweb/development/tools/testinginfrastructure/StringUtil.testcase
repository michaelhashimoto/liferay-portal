@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testcase.url = "";
	property testray.main.component.name = "Tools";

	@priority = "5"
	test Add {
		var string = StringUtil.add("abc", "def", "...");

		TestUtils.assertEquals(actual = "${string}", expected = "abc...def...");
	}

	@priority = "5"
	test Contains {
		var boolean = StringUtil.contains("These are tests", "test");

		TestUtils.assertEquals(actual = "${boolean}", expected = "false");
	}

	@priority = "5"
	test Count {
		var int = StringUtil.count("Life Ray is Life of Portal", "Life");

		TestUtils.assertEquals(actual = "${int}", expected = "2");
	}

	@priority = "5"
	test EndsWith {
		var boolean = StringUtil.endsWith("Hello World", "World");

		TestUtils.assertEquals(actual = "${boolean}", expected = "true");
	}

	@priority = "5"
	test ExtractChars {
		var string = StringUtil.extractChars("These are t23415ests");

		TestUtils.assertEquals(actual = "${string}", expected = "Thesearetests");
	}

	@priority = "5"
	test ExtractDigits {
		var string = StringUtil.extractDigits("These are t23415ests");

		TestUtils.assertEquals(actual = "${string}", expected = "23415");
	}

	@priority = "5"
	test ExtractFirst {
		var string = StringUtil.extractFirst("The Life Ray is the Life of Portal", "Life");

		TestUtils.assertEquals(actual = "${string}", expected = "The ");
	}

	@priority = "5"
	test ExtractLast {
		var string = StringUtil.extractLast("The Life Ray is the Life of Portal", "Life");

		TestUtils.assertEquals(actual = "${string}", expected = " of Portal");
	}

	@priority = "5"
	test ExtractLeadingDigits {
		var string = StringUtil.extractLeadingDigits("123456Hello World");

		TestUtils.assertEquals(actual = "${string}", expected = "123456");
	}

	@priority = "5"
	test IsLowerCase {
		var boolean = StringUtil.isLowerCase("heLLo");

		TestUtils.assertEquals(actual = "${boolean}", expected = "false");
	}

	@priority = "5"
	test IsUpperCase {
		var boolean = StringUtil.isUpperCase("HELL0");

		TestUtils.assertEquals(actual = "${boolean}", expected = "true");
	}

	@priority = "5"
	test LowerCase {
		var string = StringUtil.lowerCase("heLLo");

		TestUtils.assertEquals(actual = "${string}", expected = "hello");
	}

	@priority = "5"
	test LowerCaseFirstLetter {
		var string = StringUtil.lowerCaseFirstLetter("HELLO");

		TestUtils.assertEquals(actual = "${string}", expected = "hELLO");
	}

	@priority = "5"
	test Matches {
		var boolean = StringUtil.matches("The fox jumped over the lazy dog", "lazy dog");

		TestUtils.assertEquals(actual = "${boolean}", expected = "true");
	}

	@priority = "5"
	test Quote {
		var string = StringUtil.quote("Love", "xo");

		TestUtils.assertEquals(actual = "${string}", expected = "xoLovexo");
	}

	@priority = "5"
	test Replace {
		var string = StringUtil.replace("You are my guest", "guest", "friend");

		TestUtils.assertEquals(actual = "${string}", expected = "You are my friend");
	}

	@priority = "5"
	test Reverse {
		var string = StringUtil.reverse("Hello");

		TestUtils.assertEquals(actual = "${string}", expected = "olleH");
	}

	@priority = "5"
	test StartsWith {
		var boolean = StringUtil.startsWith("This is a test", "This");

		TestUtils.assertEquals(actual = "${boolean}", expected = "true");
	}

	@priority = "5"
	test StripBetween {
		var string = StringUtil.stripBetween("Liferay is the life of portal", "is", "of ");

		TestUtils.assertEquals(actual = "${string}", expected = "Liferay portal");
	}

	@priority = "5"
	test Trim {
		var string = StringUtil.trim("       Life Ray is Life of Portal             ");

		TestUtils.assertEquals(
			actual = "${string}",
			expected = "Life Ray is Life of Portal"
		);
	}

	@priority = "5"
	test TrimLeading {
		var string = StringUtil.trimLeading("            Hello");

		TestUtils.assertEquals(actual = "${string}", expected = "Hello");
	}

	@priority = "5"
	test TrimTrailing {
		var string = StringUtil.trimTrailing("Hello                 ");

		TestUtils.assertEquals(actual = "${string}", expected = "Hello");
	}

	@priority = "5"
	test Unquote {

		var stringUnquote = '''"HELP"''';
		var string = StringUtil.unquote("${stringUnquote}");

		TestUtils.assertEquals(actual = "${string}", expected = "HELP");
	}

	@priority = "5"
	test UpperCase {
		var string = StringUtil.upperCase("heLLo");

		TestUtils.assertEquals(actual = "${string}", expected = "HELLO");
	}

	@priority = "5"
	test UpperCaseFirstLetter {
		var string = StringUtil.upperCaseFirstLetter("heLLo");

		TestUtils.assertEquals(actual = "${string}", expected = "HeLLo");
	}
}