@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testcase.url = "http://the-internet.herokuapp.com/status_codes";
	property testray.main.component.name = "Tools";

	@priority = "5"
	test MacroElseClauseEvaluated {
		ElseIfLogger.switchConditional(expected = "Last clause", switch = "5");
	}

	@priority = "5"
	test MacroElseIfClauseEvaluated {
		ElseIfLogger.switchConditional(expected = "3rd clause", switch = "3");
	}

	@priority = "5"
	test TestCaseElseClauseEvaluated {
		var switch = "5";

		if ("${switch}" == "1") {
			TestUtils.fail(message = "1st clause is not true: FAIL");
		}
		else if ("${switch}" == "2") {
			TestUtils.fail(message = "2nd clause is not true: FAIL");
		}
		else if ("${switch}" == "3") {
			TestUtils.fail(message = "3rd clause is not true: FAIL");
		}
		else if ("${switch}" == "4") {
			TestUtils.fail(message = "4th clause is not true: FAIL");
		}
		else {
			TestUtils.pass(message = "Last clause is true: PASS");
		}
	}

	@priority = "5"
	test TestCaseElseIfClauseEvaluated {
		var switch = "4";

		if ("${switch}" == "1") {
			TestUtils.fail(message = "1st clause is not true: FAIL");
		}
		else if ("${switch}" == "2") {
			TestUtils.fail(message = "2nd clause is not true: FAIL");
		}
		else if ("${switch}" == "3") {
			TestUtils.fail(message = "3rd clause is not true: FAIL");
		}
		else if ("${switch}" == "4") {
			TestUtils.pass(message = "4th clause is true: PASS");
		}
		else {
			TestUtils.fail(message = "Last clause is not true: FAIL");
		}
	}

	@priority = "5"
	test TestCaseElseIfConditions {
		if (IsElementPresent(locator1 = "ElseIfLogger#FAKE_ELEMENT")) {
			TestUtils.fail(message = "1st clause is not true: FAIL");
		}
		else if (IsElementPresent(locator1 = "ElseIfLogger#REAL_ELEMENT")) {
			TestUtils.pass(message = "2nd clause is true: PASS");
		}
		else {
			TestUtils.fail(message = "Last clause is not true: FAIL");
		}
	}

	@priority = "5"
	test TestCaseElseIfContains {
		if (contains("abcdefg", "abcdefghij")) {
			TestUtils.fail(message = "1st clause is not true: FAIL");
		}
		else if (contains("abcdefg", "abc")) {
			TestUtils.pass(message = "2nd clause is true: PASS");
		}
		else {
			TestUtils.fail(message = "Last clause is not true: FAIL");
		}
	}

	@priority = "5"
	test TestCaseElseIfIsset {
		var switch = "4";

		if (isSet(fake)) {
			TestUtils.fail(message = "1st clause is not true: FAIL");
		}
		else if (isSet(switch)) {
			TestUtils.pass(message = "2nd clause is true: PASS");
		}
		else {
			TestUtils.fail(message = "Last clause is not true: FAIL");
		}
	}
}