@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "false";
	property testcase.url = "";
	property testray.main.component.name = "Tools";

	@priority = "5"
	test Get {
		var string = PropsUtil.get("browser.type");

		TestUtils.assertEquals(actual = "${string}", expected = "*chrome");
	}
}