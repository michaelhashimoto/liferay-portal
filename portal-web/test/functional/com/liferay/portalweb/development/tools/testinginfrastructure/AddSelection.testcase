@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testcase.url = "http://www.w3schools.com/tags/tryit.asp?filename=tryhtml_select_multiple";
	property testray.main.component.name = "Tools";
	var commitMessage = "LPS-41076";
	var ticketLocation = "https://issues.liferay.com/browse/LIFERAYQA-5866";
	var ticketSummary = "LIFERAYQA-5866: Enable selecting multiple choices from a dropdown";

	@priority = "5"
	test AddSelection {
		echo("Test addSelection: select multiple items");

		SelectFrame(locator1 = "//iframe[@id='iframeResult']");

		AssertElementPresent(locator1 = "//select");

		AddSelection(locator1 = "//select", value1 = "Volvo");

		AddSelection(locator1 = "//select", value1 = "Saab");

		AddSelection(locator1 = "//select", value1 = "Audi");

		AssertSelectedLabel(locator1 = "//select", value1 = "Volvo");

		AssertSelectedLabel(locator1 = "//select", value1 = "Saab");

		AssertSelectedLabel(locator1 = "//select", value1 = "Audi");
	}
}