@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testcase.url = "";
	property testray.main.component.name = "Tools";
	var commitMessage = "LPS-41203";
	var ticketLocation = "https://issues.liferay.com/browse/LIFERAYQA-5879";
	var ticketSummary = "LIFERAYQA-5879: Enable looping on a list";

	@priority = "5"
	test LoopAtTestCaseLevel {
		for (var number : list "1,2,3,4,5") {
			echo("${number}");
		}
	}

	@priority = "5"
	test LoopContainingContainsIfConditional {
		Iteration.loopContainingContainsIfConditional();
	}

	@priority = "5"
	test LoopContainingEchoStatement {
		Iteration.loopContainingEchoStatement();
	}

	@priority = "5"
	test LoopContainingEqualsIfConditional {
		Iteration.loopContainingEqualsIfConditional();
	}

	@ignore = "true"
	@priority = "5"
	test LoopOnEmptyList {
		Iteration.loopOnEmptyList();
	}

	@priority = "5"
	test NestedForLoopsWithinMacro {
		Iteration.nestedForLoops();
	}

	@priority = "5"
	test NestedForLoopsWithinTestcase {
		echo("Test loops: checking to make sure that you can have nested loops");

		var string = "";

		for (var number : list "1,2,3") {
			for (var letter : list "a,b,c") {
				var string = "${string}${number}${letter},";
			}
		}

		TestUtils.assertEquals(
			actual = "${string}",
			expected = "1a,1b,1c,2a,2b,2c,3a,3b,3c,"
		);
	}
}