@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Tools";

	@ignore = "true"
	@priority = "5"
	test Smoke {
		SikuliAssertElementPresent(locator1 = "Sikuli#EMAIL_ADDRESS");

		SikuliAssertElementNotPresent(locator1 = "Sikuli#AVERAGE_RATING_STAR_ICON_PNG");

		Type(locator1 = "Sikuli#EMAIL_ADDRESS", value1 = "test@liferay.com");

		Type(locator1 = "Sikuli#PASSWORD", value1 = "test");

		Click(locator1 = "Sikuli#SIGN_IN");
	}
}