@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Tools";

	setUp {
		User.firstLoginPG();
	}

	tearDown {
		DMDocument.tearDownCP();

		User.logoutPG();
	}

	@priority = "5"
	test AddDocumentWithUploadTempFile {
		var dmDocumentDescription = "DM Document Description";
		var dmDocumentFile = "Document_1.doc";
		var dmDocumentSize = "21.5k";
		var dmDocumentTitle = "DM Document Title";

		Page.gotoCP(portletName = "Documents and Media");

		DMDocument.addCP(
			dmDocumentDescription = "${dmDocumentDescription}",
			dmDocumentFile = "${dmDocumentFile}",
			dmDocumentSize = "${dmDocumentSize}",
			dmDocumentTitle = "${dmDocumentTitle}"
		);

		Page.gotoCP(portletName = "Documents and Media");

		DMDocument.downloadCP(
			dmDocumentFile = "${dmDocumentFile}",
			dmDocumentSize = "${dmDocumentSize}",
			dmDocumentTitle = "${dmDocumentTitle}"
		);

		Page.gotoCP(portletName = "Documents and Media");

		DMDocument.addCP(
			dmDocumentDescription = "${dmDocumentDescription} New",
			dmDocumentFile = "${dmDocumentTitle}.doc",
			dmDocumentSize = "${dmDocumentSize}",
			dmDocumentTitle = "${dmDocumentTitle} New",
			uploadTempFile = "true"
		);
	}
}