@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testcase.url = "http://the-internet.herokuapp.com/status_codes";
	property testray.main.component.name = "Tools";

	@priority = "5"
	test Condition {
		if (IsElementPresent(locator1 = "Conditional#TITLE_ELEMENT")) {
			TestUtils.pass(message = "Webpage title element was found: PASS");
		}
		else {
			TestUtils.fail(message = "Webpage title element was not found: FAIL");
		}

		if (IsElementNotPresent(locator1 = "Conditional#TITLE_ELEMENT")) {
			TestUtils.fail(message = "Webpage title element was not found: FAIL");
		}
		else {
			TestUtils.pass(message = "Webpage title element was found: PASS");
		}

		if (IsElementPresent(locator1 = "Conditional#LIST_ELEMENT")) {
			TestUtils.pass(message = "Webpage list element was found: PASS");
		}
		else {
			TestUtils.fail(message = "Webpage list element was not found: FAIL");
		}

		if (IsElementNotPresent(locator1 = "Conditional#LIST_ELEMENT")) {
			TestUtils.fail(message = "Webpage list element was not found: FAIL");
		}
		else {
			TestUtils.pass(message = "Webpage list element was found: PASS");
		}

		if (IsTextEqual(locator1 = "Conditional#TITLE_ELEMENT_NAME", value1 = "Status Codes")) {
			TestUtils.pass(message = "Matched webpage title value: PASS");
		}
		else {
			TestUtils.fail(message = "Did not match webpage title value: FAIL");
		}

		if (IsTextEqual(locator1 = "Conditional#TITLE_ELEMENT_NAME", value1 = "Not real title")) {
			TestUtils.fail(message = "Matched incorrect webpage title value: FAIL");
		}
		else {
			TestUtils.pass(message = "Did not match incorrect webpage title value: PASS");
		}

		if (IsTextNotEqual(locator1 = "Conditional#TITLE_ELEMENT_NAME", value1 = "Status Codes")) {
			TestUtils.fail(message = "Did not match webpage title value: FAIL");
		}
		else {
			TestUtils.pass(message = "Matched webpage title value: PASS");
		}

		if (IsTextNotEqual(locator1 = "Conditional#TITLE_ELEMENT_NAME", value1 = "Not real title")) {
			TestUtils.pass(message = "Did not match incorrect webpage title value: PASS");
		}
		else {
			TestUtils.fail(message = "Matched incorrect webpage title value: FAIL");
		}
	}

	@priority = "5"
	test Contains {
		var nonSubstring = "abc";
		var string = "string";
		var substring = "str";

		if (contains("${string}", "${substring}")) {
			TestUtils.pass(message = "Substring was found within string: PASS");
		}
		else {
			TestUtils.fail(message = "Substring was not found within string: FAIL");
		}

		if (contains("${string}", "${nonSubstring}")) {
			TestUtils.fail(message = "Matched a non-substring as a substring: FAIL");
		}
		else {
			TestUtils.pass(message = "Did not match non-substring as a substring: PASS");
		}

		if (contains("string", "str")) {
			TestUtils.pass(message = "Substring was found within string: PASS");
		}
		else {
			TestUtils.fail(message = "Substring was not found within string: FAIL");
		}

		if (contains("string", "abc")) {
			TestUtils.fail(message = "Matched a non-substring as a substring: FAIL");
		}
		else {
			TestUtils.pass(message = "Did not match non-substring as a substring: PASS");
		}
	}

	@priority = "5"
	test Equals {
		var var1 = "value1";
		var var2 = "value2";
		var var3 = "value1";

		if ("${var1}" == "${var2}") {
			TestUtils.fail(message = "Two non-matching variables were matched: FAIL");
		}
		else {
			TestUtils.pass(message = "Two non-matching variables were not matched: PASS");
		}

		if ("${var1}" == "${var3}") {
			TestUtils.pass(message = "Two matching variables were matched: PASS");
		}
		else {
			TestUtils.fail(message = "Two matching variables were not matched: FAIL");
		}

		if ("matching value" == "matching value") {
			TestUtils.pass(message = "Two matching values were matched: PASS");
		}
		else {
			TestUtils.fail(message = "Two matching values were not matched: FAIL");
		}

		if ("non-matching value" == "") {
			TestUtils.fail(message = "Two non-matching values were matched: FAIL");
		}
		else {
			TestUtils.pass(message = "Two non-matching values were not matched: PASS");
		}
	}

	@priority = "5"
	test Isset {
		var validVar1 = "validVarValue";

		if (isSet(validVar1)) {
			TestUtils.pass(message = "Detected a set variable was set: PASS");
		}
		else {
			TestUtils.fail(message = "Detected a set variable as not set: FAIL");
		}

		var validVar2 = "${validVar1}";

		if (isSet(validVar2)) {
			TestUtils.pass(message = "Detected a set variable was set: PASS");
		}
		else {
			TestUtils.fail(message = "Detected a set variable as not set: FAIL");
		}

		if (isSet(nonexistentVar1)) {
			TestUtils.fail(message = "Detected a non-set variable as set: FAIL");
		}
		else {
			TestUtils.pass(message = "Detected the variable was not set: PASS");
		}

		var nonexistentVar2 = "${nonexistentVar1}";

		if (isSet(nonexistentVar2)) {
			TestUtils.fail(message = "Detected a non-set variable as set: FAIL");
		}
		else {
			TestUtils.pass(message = "Detected the variable was not set: PASS");
		}

		var invalidVar1 = "${invalidVar1}";

		if (isSet(invalidVar1)) {
			TestUtils.fail(message = "Detected a non-set variable as set: FAIL");
		}
		else {
			TestUtils.pass(message = "Detected the variable was not set: PASS");
		}

		var invalidVar2 = "${invalidVar1}";

		if (isSet(invalidVar2)) {
			TestUtils.fail(message = "Detected a non-set variable as set: FAIL");
		}
		else {
			TestUtils.pass(message = "Detected the variable was not set: PASS");
		}

		var validWithLineSeparator = "${validVar1}${line.separator}";

		if (isSet(validWithLineSeparator)) {
			TestUtils.pass(
				message = "Detected a variable was set with special character: PASS"
			);
		}
		else {
			TestUtils.fail(
				message = "Detected a set variable with special character as not set"
			);
		}
	}
}