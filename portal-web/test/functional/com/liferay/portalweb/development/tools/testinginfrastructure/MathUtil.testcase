@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testcase.url = "";
	property testray.main.component.name = "Tools";

	@priority = "5"
	test Difference {
		var difference = MathUtil.difference("3", "2");

		TestUtils.assertEquals(actual = "${difference}", expected = "1");
	}

	@priority = "5"
	test Product {
		var product = MathUtil.product("4", "2");

		TestUtils.assertEquals(actual = "${product}", expected = "8");

		var product = MathUtil.product("2", "3", "4");

		TestUtils.assertEquals(actual = "${product}", expected = "24");
	}

	@priority = "5"
	test Quotient {
		var quotient = MathUtil.quotient("6", "2");

		TestUtils.assertEquals(actual = "${quotient}", expected = "3");
	}

	@priority = "5"
	test Sum {
		var sum = MathUtil.sum("1", "2");

		TestUtils.assertEquals(actual = "${sum}", expected = "3");

		var sum = MathUtil.sum("1", "2", "3");

		TestUtils.assertEquals(actual = "${sum}", expected = "6");
	}
}