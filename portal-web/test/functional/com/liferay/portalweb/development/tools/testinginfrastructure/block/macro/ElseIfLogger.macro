definition {
	macro switchConditional {
		if ("${switch}" == "1") {
			var actual = "1st clause";
		}
		else if ("${switch}" == "2") {
			var actual = "2nd clause";
		}
		else if ("${switch}" == "3") {
			var actual = "3rd clause";
		}
		else if ("${switch}" == "4") {
			var actual = "4th clause";
		}
		else {
			var actual = "Last clause";
		}

		if ("${actual}" == "${expected}") {
			TestUtils.pass(message = "${expected} is true: PASS");
		}
		else {
			TestUtils.fail(message = "${actual} is not true: FAIL");
		}
	}
}