definition {
	macro loopContainingContainsIfConditional {
		echo("Test loops: loop containing contains if conditional");

		var letter = "a";

		for (var letters : list "abc,def,ghi,jkl") {
			if (contains("${letters}", "${letter}")) {
				TestUtils.pass();
			}
		}
	}

	macro loopContainingEchoStatement {
		echo("Test loops: loop containing echo statement");

		var list = "4,5";

		for (var param : list "1,2,3,${list}") {
			echo("${param}");
		}

		TestUtils.pass();
	}

	macro loopContainingEqualsIfConditional {
		echo("Test loops: loop containing equals if conditional");

		var numberFound = "";
		var numberToMatch = "4";

		for (var number : list "1,2,3,4,5") {
			if ("${number}" == "${numberToMatch}") {
				var numberFound = "${number}";
			}
		}

		TestUtils.assertEquals(actual = "${numberFound}", expected = "${numberToMatch}");
	}

	macro loopOnEmptyList {
		echo("Test loops: loop on empty list");

		var list = "";

		for (var param : list "${list}") {
			TestUtils.fail();
		}

		TestUtils.pass();
	}

	macro nestedForLoops {
		echo("Test loops: checking to make sure that you can have nested loops");

		var string = "";

		for (var number : list "1,2,3") {
			for (var letter : list "a,b,c") {
				var string = "${string}${number}${letter},";
			}
		}

		TestUtils.assertEquals(
			actual = "${string}",
			expected = "1a,1b,1c,2a,2b,2c,3a,3b,3c,"
		);
	}
}