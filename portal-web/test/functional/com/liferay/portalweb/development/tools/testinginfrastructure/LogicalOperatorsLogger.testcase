@component-name = "portal-tools"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Tools";

	setUp {
		echo("testing logical operators in a test case set-up element");

		if (("true" == "false") && ("true" == "true")) {
			TestUtils.pass();
		}
		else if (("true" == "true") || ("true" == "true")) {
			TestUtils.pass();
		}
		else if (!("true" == "true")) {
			TestUtils.pass();
		}
		else {
			if ((!("true" == "false")) && ("true" == "true") && ("true" == "true") && (("true" == "false") || ("true" == "true")) && (!(("true" == "false") && (("true" == "true") && ("true" == "true") && (("true" == "true") || ("true" == "false") || ("true" == "false")))))) {
				TestUtils.pass();
			}
		}
	}

	tearDown {
		echo("testing logical operators in a test case tear-down element");

		if (("true" == "false") && ("true" == "true")) {
			TestUtils.pass();
		}
		else if (("true" == "true") || ("true" == "true")) {
			TestUtils.pass();
		}
		else if (!("true" == "true")) {
			TestUtils.pass();
		}
		else {
			if ((!("true" == "false")) && ("true" == "true") && ("true" == "true") && (("true" == "false") || ("true" == "true")) && (!(("true" == "false") && (("true" == "true") && ("true" == "true") && (("true" == "true") || ("true" == "false") || ("true" == "false")))))) {
				TestUtils.pass();
			}
		}
	}

	@priority = "5"
	test MacroLogicalOperators {
		echo("testing logical operators defined inside a macro");

		LogicalOperators.macroLogicalOperators();
	}

	@priority = "5"
	test TestCaseLogicalOperators {
		echo("testing logical operators in a test case command element");

		if (("true" == "false") && ("true" == "true")) {
			TestUtils.pass();
		}
		else if (("true" == "true") || ("true" == "true")) {
			TestUtils.pass();
		}
		else if (!("true" == "true")) {
			TestUtils.pass();
		}
		else {
			if ((!("true" == "false")) && ("true" == "true") && ("true" == "true") && (("true" == "false") || ("true" == "true")) && (!(("true" == "false") && (("true" == "true") && ("true" == "true") && (("true" == "true") || ("true" == "false") || ("true" == "false")))))) {
				TestUtils.pass();
			}
		}
	}
}