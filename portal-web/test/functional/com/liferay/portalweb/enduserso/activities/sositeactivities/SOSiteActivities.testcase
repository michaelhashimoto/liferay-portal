@component-name = "social-office-site"
definition {
	property hook.plugins.includes = "deploy-listener-hook,portal-compat-hook,so-activities-hook,so-hook";
	property portlet.plugins.includes = "chat-portlet,contacts-portlet,events-display-portlet,microblogs-portlet,private-messaging-portlet,so-announcements-portlet,so-configurations-portlet,so-portlet,tasks-portlet,wysiwyg-portlet";
	property testray.main.component.name = "Social Office EE";
	property theme.plugins.includes = "so-theme";

	setUp {
		SOUser.firstLoginPG();

		SOUserBar.addSOSite(
			siteDescription = "Open Site Description",
			siteName = "Open Site Name",
			siteType = "Open"
		);
	}

	@priority = "5"
	test ViewDMFolderDocumentSiteActivitiesSite {
		var adminEmailAddress = "test@liferay.com";
		var adminName = "Joe Bloggs";
		var dmDocumentDescription = "DM Folder Document Description";
		var dmDocumentFile = "Document_1.doc";
		var dmDocumentSize = "21.5k";
		var dmDocumentTitle = "DM Folder Document Title";
		var dmFolderDescription = "DM Folder Description";
		var dmFolderName = "DM Folder Name";
		var number = "1";
		var siteDescription = "Open Site Description";
		var siteName = "Open Site Name";
		var siteType = "Open";

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolder.addPG(
			dmFolderDescription = "${dmFolderDescription}",
			dmFolderName = "${dmFolderName}",
			pageType = "Open Site"
		);

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolderDocument.addPG(
			dmDocumentDescription = "${dmDocumentDescription}",
			dmDocumentFile = "${dmDocumentFile}",
			dmDocumentTitle = "${dmDocumentTitle}",
			dmFolderName = "${dmFolderName}"
		);

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		var number = MathUtil.sum("${number}", "1");

		DMDocument.addPG(
			dmDocumentDescription = "${dmDocumentDescription}",
			dmDocumentTitle = "${dmDocumentTitle}"
		);

		Page.openURL(pageType = "Open Site");

		var documentTitleRow = "1";
		var row = "1";

		SOActivities.viewMultipleDocumentsActivityEntry(
			documentsAction = "Uploaded 2 new documents.",
			number = "${number}",
			userName = "Joe"
		);

		Click(
			locator1 = "SOActivities#ACTIVITIES_DOCUMENT_TITLE_INCREMENT",
			value1 = "${dmDocumentTitle}${documentTitleRow}"
		);

		SODocuments.viewPGDocumentDetailView(
			dmDocumentDescription = "${dmDocumentDescription}${documentTitleRow}",
			dmDocumentSize = "${dmDocumentSize}",
			dmDocumentTitle = "${dmDocumentTitle}${documentTitleRow}",
			dmDocumentUploader = "${adminName}",
			dmDocumentVersionNumber = "1.0"
		);

		Page.openURL(pageType = "Open Site");

		var documentTitleRow = MathUtil.sum("${documentTitleRow}", "1");

		Click(
			locator1 = "SOActivities#ACTIVITIES_DOCUMENT_TITLE_INCREMENT",
			value1 = "${dmDocumentTitle}${documentTitleRow}"
		);

		SODocuments.viewPGDocumentDetailView(
			dmDocumentDescription = "${dmDocumentDescription}${documentTitleRow}",
			dmDocumentSize = "${dmDocumentSize}",
			dmDocumentTitle = "${dmDocumentTitle}${documentTitleRow}",
			dmDocumentUploader = "${adminName}",
			dmDocumentVersionNumber = "1.0"
		);
	}

	@priority = "5"
	test ViewMBCategoryThreadMessageSiteActivitiesSite {
		var adminEmailAddress = "test@liferay.com";
		var adminFirstName = "Joe";
		var adminName = "Joe Bloggs";
		var categoryName = "MB Category Name";
		var forumsAction = "Wrote a new forum post in";
		var number = "1";
		var password = "test";
		var roleName = "Social Office";
		var siteDescription = "Open Site Description";
		var siteName = "Open Site Name";
		var siteType = "Open";
		var threadBody = "MB Category Thread Message Body";
		var threadSubject = "MB Category Thread Message Subject";

		Page.gotoPG(pageName = "Forums", pageType = "Open Site");

		MessageboardsCategory.addPG(
			categoryName = "${categoryName}",
			number = "${number}"
		);

		Page.gotoPG(pageName = "Forums", pageType = "Open Site");

		MessageboardsCategory.gotoPG(
			categoryName = "${categoryName}",
			number = "${number}"
		);

		MessageboardsThread.addPG(number = "${number}");

		var number = MathUtil.sum("${number}", "1");

		Page.gotoPG(pageName = "Forums", pageType = "Open Site");

		MessageboardsCategory.addPG(
			categoryName = "${categoryName}",
			number = "${number}"
		);

		Page.gotoPG(pageName = "Forums", pageType = "Open Site");

		MessageboardsCategory.gotoPG(
			categoryName = "${categoryName}",
			number = "${number}"
		);

		MessageboardsThread.addPG(number = "${number}");

		Page.openURL(pageType = "Open Site");

		SOActivities.viewForumsActivityEntry(
			action = "${forumsAction} ${categoryName}${number}.",
			number = "2",
			row = "01",
			userName = "${adminFirstName}"
		);

		SOActivities.viewForumsActivityEntry(
			action = "${forumsAction} ${categoryName}${number}.",
			number = "1",
			row = "02",
			userName = "${adminFirstName}"
		);
	}

	@priority = "5"
	test ViewSiteActivitiesDashboard {
		var adminEmailAddress = "test@liferay.com";
		var adminName = "Joe Bloggs";
		var bookmarksEntryDescription = "Bookmarks Entry Description";
		var bookmarksEntryName = "Bookmarks Entry Name";
		var bookmarksEntryUrl = "http://www.google.com";
		var categoryName = "MB Category Name";
		var dmDocumentDescription = "DM Folder Document Description";
		var dmDocumentFile = "Document_1.doc";
		var dmDocumentTitle = "DM Folder Document Title";
		var dmFolderDescription = "DM Folder Description";
		var dmFolderName = "DM Folder Name";
		var entryContent = "Blogs Entry Content";
		var entryTitle = "Blogs Entry Title";
		var eventDescription = "Calendar Event Description";
		var eventTitle = "Calendar Event Title";
		var password = "test";
		var roleName = "Social Office";
		var siteDescription = "Open Site Description";
		var siteName = "Open Site Name";
		var siteType = "Open";
		var threadBody = "MB Category Thread Message Body";
		var threadSubject = "MB Category Thread Message Subject";
		var wikiPageContent = "Wiki FrontPage Content";
		var wikiPageContentEdit = "Wiki FrontPage Content Edit";

		SOActivities.addSiteContent(
			bookmarksEntryDescription = "${bookmarksEntryDescription}",
			bookmarksEntryName = "${bookmarksEntryName}",
			bookmarksEntryUrl = "${bookmarksEntryUrl}",
			categoryName = "${categoryName}",
			dmDocumentDescription = "${dmDocumentDescription}",
			dmDocumentFile = "${dmDocumentFile}",
			dmDocumentTitle = "${dmDocumentTitle}",
			dmFolderDescription = "${dmFolderDescription}",
			dmFolderName = "${dmFolderName}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			eventDescription = "${eventDescription}",
			eventTitle = "${eventTitle}",
			siteName = "${siteName}",
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}",
			userName = "${adminName}",
			wikiPageContent = "${wikiPageContent}",
			wikiPageContentEdit = "${wikiPageContentEdit}"
		);

		SOUserBar.dashboardPG(userName = "${adminName}");

		SOActivities.viewSiteContent(
			blogsAction = "Wrote a new blog entry.",
			bookmarkAction = "Added a new bookmark.",
			calendarAction = "Added a new calendar event.",
			dmDocumentVersionNumber = "1.0",
			documentsAction = "Uploaded a new document in the DM Folder Name folder.",
			forumsAction = "Wrote a new forum post in MB Category Name.",
			userName = "Joe in ${siteName}",
			wikiAction = "Made 2 updates to a wiki page in the Main wiki.",
			wikiPageContent = "${wikiPageContentEdit}",
			wikiPageTitle = "FrontPage"
		);
	}

	@priority = "5"
	test ViewSiteActivitiesProfile {
		var adminEmailAddress = "test@liferay.com";
		var adminName = "Joe Bloggs";
		var bookmarksEntryDescription = "Bookmarks Entry Description";
		var bookmarksEntryName = "Bookmarks Entry Name";
		var bookmarksEntryUrl1 = "http://www.google.com";
		var bookmarksEntryUrl2 = "http://www.yahoo.com";
		var categoryName = "MB Category Name";
		var dmDocumentDescription = "DM Folder Document Description";
		var dmDocumentFile1 = "Document_1.doc";
		var dmDocumentFile2 = "Document_2.doc";
		var dmDocumentTitle = "DM Folder Document Title";
		var dmFolderDescription = "DM Folder Description";
		var dmFolderName = "DM Folder Name";
		var entryContent = "Blogs Entry Content";
		var entryTitle = "Blogs Entry Title";
		var eventDescription = "Calendar Event Description";
		var eventTitle = "Calendar Event Title";
		var password = "test";
		var roleName = "Social Office";
		var roleName2 = "Site Administrator";
		var roleType2 = "Site";
		var siteDescription = "Open Site Description";
		var siteName = "Open Site Name";
		var siteType = "Open";
		var threadBody = "MB Category Thread Message Body";
		var threadSubject = "MB Category Thread Message Subject";
		var userEmailAddress = "socialoffice01@liferay.com";
		var userFirstName = "Social01";
		var userLastName = "User01";
		var userListName = "User01, Social01";
		var userMiddleName = "Office01";
		var userName = "Social01 Office01 User01";
		var userScreenName = "socialoffice01";
		var wikiPageContent = "Wiki FrontPage Content";
		var wikiPageContentEdit1 = "Wiki FrontPage Content Edit1";
		var wikiPageContentEdit2 = "Wiki FrontPage Content Edit2";

		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUserBar.gotoCP(portletName = "Sites");

		Site.addMemberCP(
			siteName = "${siteName}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		SOUserBar.gotoCP(portletName = "Sites");

		Site.assignRoleCP(
			roleName = "${roleName2}",
			roleType = "${roleType2}",
			searchTerm = "${roleName2}",
			siteName = "${siteName}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		SOActivities.addSiteContent(
			number = "01",
			bookmarksEntryDescription = "${bookmarksEntryDescription}",
			bookmarksEntryName = "${bookmarksEntryName}",
			bookmarksEntryUrl = "${bookmarksEntryUrl1}",
			categoryName = "${categoryName}",
			dmDocumentDescription = "${dmDocumentDescription}",
			dmDocumentFile = "${dmDocumentFile1}",
			dmDocumentTitle = "${dmDocumentTitle}",
			dmFolderDescription = "${dmFolderDescription}",
			dmFolderName = "${dmFolderName}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			eventDescription = "${eventDescription}",
			eventTitle = "${eventTitle}",
			siteName = "${siteName1}",
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}",
			wikiPageContent = "${wikiPageContent}",
			wikiPageContentEdit = "${wikiPageContentEdit1}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOUserBar.myProfilePG(userName = "${userName}");

		AssertTextEquals(
			locator1 = "SOActivities#NO_ACTIVITIES",
			value1 = "There are no activities."
		);

		Click(locator1 = "SOActivities#NAVIGATION_ME");

		AssertTextEquals(
			locator1 = "SOActivities#NO_ACTIVITIES",
			value1 = "There are no activities."
		);

		SOActivities.addSiteContent(
			number = "02",
			bookmarksEntryDescription = "${bookmarksEntryDescription}",
			bookmarksEntryName = "${bookmarksEntryName}",
			bookmarksEntryUrl = "${bookmarksEntryUrl2}",
			categoryName = "${categoryName}",
			dmDocumentDescription = "${dmDocumentDescription}",
			dmDocumentFile = "${dmDocumentFile2}",
			dmDocumentTitle = "${dmDocumentTitle}",
			dmFolderDescription = "${dmFolderDescription}",
			dmFolderName = "${dmFolderName}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			eventDescription = "${eventDescription}",
			eventTitle = "${eventTitle}",
			siteName = "${siteName}",
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}",
			wikiEditOnly = "true",
			wikiPageContentEdit = "${wikiPageContentEdit2}"
		);

		SOUserBar.myProfilePG(userName = "${userName}");

		SOActivities.viewSiteContent(
			number = "02",
			blogsAction = "Wrote a new blog entry.",
			bookmarkAction = "Added a new bookmark.",
			bookmarksEntryDescription = "${bookmarksEntryDescription}",
			bookmarksEntryName = "${bookmarksEntryName}",
			calendarAction = "Added a new calendar event.",
			categoryName = "${categoryName}",
			dmDocumentDescription = "${dmDocumentDescription}",
			dmDocumentTitle = "${dmDocumentTitle}",
			dmDocumentVersionNumber = "1.0",
			documentsAction = "Uploaded a new document in the ${dmFolderName}${number} folder.",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			eventDescription = "${eventDescription}",
			forumsAction = "Wrote a new forum post in ${categoryName}${number}.",
			siteName = "${siteName}",
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}",
			userName = "${userFirstName} in ${siteName}",
			wikiAction = "Updated a wiki page in the Main wiki.",
			wikiPageContent = "${wikiPageContentEdit2}",
			wikiPageTitle = "FrontPage"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOUserBar.myProfilePG(userName = "${adminName}");

		SOActivities.viewSiteContent(
			number = "01",
			blogsAction = "Wrote a new blog entry.",
			bookmarkAction = "Added a new bookmark.",
			bookmarksEntryDescription = "${bookmarksEntryDescription}",
			bookmarksEntryName = "${bookmarksEntryName}",
			calendarAction = "Added a new calendar event.",
			categoryName = "${categoryName}",
			dmDocumentDescription = "${dmDocumentDescription}",
			dmDocumentTitle = "${dmDocumentTitle}",
			dmDocumentVersionNumber = "1.0",
			documentsAction = "Uploaded a new document in the ${dmFolderName}${number} folder.",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			eventDescription = "${eventDescription}",
			forumsAction = "Wrote a new forum post in ${categoryName}${number}.",
			siteName = "${siteName}",
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}",
			userName = "Joe in ${siteName}",
			wikiAction = "Made 2 updates to a wiki page in the Main wiki.",
			wikiPageContent = "${wikiPageContentEdit2}",
			wikiPageTitle = "FrontPage"
		);
	}

	@priority = "5"
	test ViewSiteActivitiesSites {
		var adminEmailAddress = "test@liferay.com";
		var adminName = "Joe Bloggs";
		var bookmarksEntryDescription = "Bookmarks Entry Description";
		var bookmarksEntryName = "Bookmarks Entry Name";
		var bookmarksEntryUrl = "http://www.google.com";
		var categoryName = "MB Category Name";
		var dmDocumentDescription = "DM Folder Document Description";
		var dmDocumentFile = "Document_1.doc";
		var dmDocumentTitle = "DM Folder Document Title";
		var dmFolderDescription = "DM Folder Description";
		var dmFolderName = "DM Folder Name";
		var entryContent = "Blogs Entry Content";
		var entryTitle = "Blogs Entry Title";
		var eventDescription = "Calendar Event Description";
		var eventTitle = "Calendar Event Title";
		var password = "test";
		var roleName = "Social Office";
		var siteDescription = "Open Site Description";
		var siteName = "Open Site Name";
		var siteType = "Open";
		var threadBody = "MB Category Thread Message Body";
		var threadSubject = "MB Category Thread Message Subject";
		var wikiPageContent = "Wiki FrontPage Content";
		var wikiPageContentEdit = "Wiki FrontPage Content Edit";

		SOActivities.addSiteContent(
			bookmarksEntryDescription = "${bookmarksEntryDescription}",
			bookmarksEntryName = "${bookmarksEntryName}",
			bookmarksEntryUrl = "${bookmarksEntryUrl}",
			categoryName = "${categoryName}",
			dmDocumentDescription = "${dmDocumentDescription}",
			dmDocumentFile = "${dmDocumentFile}",
			dmDocumentTitle = "${dmDocumentTitle}",
			dmFolderDescription = "${dmFolderDescription}",
			dmFolderName = "${dmFolderName}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			eventDescription = "${eventDescription}",
			eventTitle = "${eventTitle}",
			siteName = "${siteName}",
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}",
			userName = "${adminName}",
			wikiPageContent = "${wikiPageContent}",
			wikiPageContentEdit = "${wikiPageContentEdit}"
		);

		Page.openURL(pageType = "Open Site");

		SOActivities.viewSiteContent(
			blogsAction = "Wrote a new blog entry.",
			bookmarkAction = "Added a new bookmark.",
			calendarAction = "Added a new calendar event.",
			dmDocumentVersionNumber = "1.0",
			documentsAction = "Uploaded a new document in the DM Folder Name folder.",
			forumsAction = "Wrote a new forum post in MB Category Name.",
			userName = "Joe",
			wikiAction = "Made 2 updates to a wiki page in the Main wiki.",
			wikiPageContent = "${wikiPageContentEdit}",
			wikiPageTitle = "FrontPage"
		);
	}

	tearDown {
		SOUserBar.tearDownSites();

		SOUser.tearDownCP();
	}
}