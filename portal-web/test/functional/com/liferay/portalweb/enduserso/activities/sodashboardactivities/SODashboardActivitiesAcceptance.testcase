@component-name = "social-office-site"
definition {
	property hook.plugins.includes = "deploy-listener-hook,portal-compat-hook,so-activities-hook,so-hook";
	property portlet.plugins.includes = "chat-portlet,contacts-portlet,events-display-portlet,microblogs-portlet,private-messaging-portlet,so-announcements-portlet,so-configurations-portlet,so-portlet,tasks-portlet,wysiwyg-portlet";
	property testray.main.component.name = "Social Office EE";
	property theme.plugins.includes = "so-theme";

	setUp {
		SOUser.firstLoginPG();
	}

	@priority = "5"
	test ViewDashboardActivitiesDashboard {
		var adminEmailAddress = "test@liferay.com";
		var adminName = "Joe Bloggs";
		var microblogsEntryAuthorFirstName = "Joe";
		var microblogsEntryAuthorLastName = "Bloggs";
		var microblogsEntryAuthorScreenName = "joebloggs";
		var microblogsEntryCharacterCountdown1 = "141";
		var microblogsEntryCharacterCountdown2 = "134";
		var microblogsEntryContent = "Microblogs Post";
		var microblogsEntryViewableBy = "Everyone";
		var password = "test";
		var roleName = "Social Office";
		var userEmailAddress1 = "socialoffice01@liferay.com";
		var userEmailAddress2 = "socialoffice02@liferay.com";
		var userFirstName1 = "Social01";
		var userFirstName2 = "Social02";
		var userLastName1 = "User01";
		var userLastName2 = "User02";
		var userListName1 = "User01, Social01";
		var userListName2 = "User02, Social02";
		var userMiddleName1 = "Office01";
		var userMiddleName2 = "Office02";
		var userName1 = "Social01 Office01 User01";
		var userName2 = "Social02 Office02 User02";
		var userScreenName1 = "socialoffice01";
		var userScreenName2 = "socialoffice02";

		SOContactsCenter.addConnection(
			adminEmailAddress = "${adminEmailAddress}",
			senderName = "${adminName}",
			userEmailAddress = "${userEmailAddress1}",
			userFirstName = "${userFirstName1}",
			userLastName = "${userLastName1}",
			userListName = "${userListName1}",
			userMiddleName = "${userMiddleName1}",
			userName = "${userName1}",
			userScreenName = "${userScreenName1}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntryMention(
			mentionUserEmailAddress = "${userEmailAddress1}",
			mentionUserFirstName = "${userFirstName1}",
			mentionUserLastName = "${userLastName1}",
			mentionUserListName = "${userListName1}",
			mentionUserMiddleName = "${userMiddleName1}",
			mentionUserName = "${userName1}",
			mentionUserScreenName = "${userScreenName1}",
			microblogsEntryCharacterCountdown = "${microblogsEntryCharacterCountdown1}"
		);

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntryHashtag(
			microblogsEntryCharacterCountdown = "${microblogsEntryCharacterCountdown2}",
			microblogsEntryContent = "${microblogsEntryContent}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress1}");

		SOUserBar.dashboardPG(userName = "${userName1}");

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${microblogsEntryContent}",
			userName = "${adminName}"
		);

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${userName1}",
			number = "02",
			userName = "${adminName}"
		);

		Click(locator1 = "SOActivities#NAVIGATION_CONNECTIONS");

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${microblogsEntryContent}",
			userName = "${adminName}"
		);

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${userName1}",
			number = "02",
			userName = "${adminName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOContactsCenter.disconnectFromConnection(
			userEmailAddress = "${userEmailAddress1}",
			userListName = "${userListName1}",
			userName = "${userName1}",
			userScreenName = "${userScreenName1}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress1}");

		SOUserBar.dashboardPG(userName = "${userName1}");

		Click(locator1 = "SOActivities#NAVIGATION_ALL");

		AssertTextEquals(
			locator1 = "SOActivities#NO_ACTIVITIES",
			value1 = "There are no activities."
		);

		Click(locator1 = "SOActivities#NAVIGATION_CONNECTIONS");

		AssertTextEquals(
			locator1 = "SOActivities#NO_ACTIVITIES",
			value1 = "There are no activities."
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOContactsCenter.addFollower(
			adminEmailAddress = "${adminEmailAddress}",
			senderName = "${adminName}",
			userEmailAddress = "${userEmailAddress2}",
			userFirstName = "${userFirstName2}",
			userLastName = "${userLastName2}",
			userListName = "${userListName2}",
			userMiddleName = "${userMiddleName2}",
			userName = "${userName2}",
			userScreenName = "${userScreenName2}"
		);

		SOUserBar.dashboardPG(userName = "${userName2}");

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${microblogsEntryContent}",
			userName = "${adminName}"
		);

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${userName1}",
			number = "02",
			userName = "${adminName}"
		);

		Click(locator1 = "SOActivities#NAVIGATION_FOLLOWING");

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${microblogsEntryContent}",
			userName = "${adminName}"
		);

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${userName1}",
			number = "02",
			userName = "${adminName}"
		);

		SOContactsCenter.unfollowUser(
			adminEmailAddress = "${adminEmailAddress}",
			userEmailAddress = "${userEmailAddress2}",
			userName = "${userName2}"
		);

		SOUserBar.dashboardPG(userName = "${userName2}");

		Click(locator1 = "SOActivities#NAVIGATION_ALL");

		AssertTextEquals(
			locator1 = "SOActivities#NO_ACTIVITIES",
			value1 = "There are no activities."
		);

		Click(locator1 = "SOActivities#NAVIGATION_FOLLOWING");

		AssertTextEquals(
			locator1 = "SOActivities#NO_ACTIVITIES",
			value1 = "There are no activities."
		);
	}

	@priority = "5"
	test ViewDashboardActivitiesProfiles {
		var adminEmailAddress = "test@liferay.com";
		var adminName = "Joe Bloggs";
		var microblogsEntryAuthorFirstName = "Joe";
		var microblogsEntryAuthorLastName = "Bloggs";
		var microblogsEntryAuthorScreenName = "joebloggs";
		var microblogsEntryCharacterCountdown1 = "134";
		var microblogsEntryCharacterCountdown2 = "133";
		var microblogsEntryContent1 = "Microblogs Post1";
		var microblogsEntryContent2 = "Microblogs Post2";
		var microblogsEntryContent3 = "Microblogs Post3";
		var microblogsEntryContent4 = "Microblogs Post4";
		var microblogsEntryViewableBy = "Everyone";
		var password = "test";
		var roleName = "Social Office";
		var userEmailAddress = "socialoffice01@liferay.com";
		var userFirstName = "Social01";
		var userLastName = "User01";
		var userListName = "User01, Social01";
		var userMiddleName = "Office01";
		var userName = "Social01 Office01 User01";
		var userScreenName = "socialoffice01";

		SOContactsCenter.addConnection(
			adminEmailAddress = "${adminEmailAddress}",
			senderName = "${adminName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntry(
			microblogsEntryCharacterCountdown = "${microblogsEntryCharacterCountdown1}",
			microblogsEntryContent = "${microblogsEntryContent1}"
		);

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntryHashtag(
			microblogsEntryCharacterCountdown = "${microblogsEntryCharacterCountdown2}",
			microblogsEntryContent = "${microblogsEntryContent2}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOUserBar.myProfilePG(userName = "${userName}");

		Click(locator1 = "SOActivities#NAVIGATION_ALL");

		AssertTextEquals(
			locator1 = "SOActivities#NO_ACTIVITIES",
			value1 = "There are no activities."
		);

		Click(locator1 = "SOActivities#NAVIGATION_CONNECTIONS");

		AssertTextEquals(
			locator1 = "SOActivities#NO_ACTIVITIES",
			value1 = "There are no activities."
		);

		SOMicroblogs.addMicroblogsEntry(
			microblogsEntryCharacterCountdown = "${microblogsEntryCharacterCountdown1}",
			microblogsEntryContent = "${microblogsEntryContent3}"
		);

		SOMicroblogs.addMicroblogsEntryHashtag(
			microblogsEntryCharacterCountdown = "${microblogsEntryCharacterCountdown2}",
			microblogsEntryContent = "${microblogsEntryContent4}"
		);

		SOUserBar.myProfilePG(userName = "${userName}");

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${microblogsEntryContent4}"
		);

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${microblogsEntryContent3}",
			number = "02"
		);

		Click(locator1 = "SOActivities#NAVIGATION_CONNECTIONS");

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${microblogsEntryContent4}"
		);

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${microblogsEntryContent3}",
			number = "02"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOUserBar.myProfilePG(userName = "${adminName}");

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${microblogsEntryContent2}",
			userFirstName = "${microblogsEntryAuthorFirstName}"
		);

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${microblogsEntryContent1}",
			number = "02",
			userFirstName = "${microblogsEntryAuthorFirstName}"
		);

		Click(locator1 = "SOActivities#NAVIGATION_CONNECTIONS");

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${microblogsEntryContent2}",
			userFirstName = "${microblogsEntryAuthorFirstName}"
		);

		SOActivities.viewMicroblogsActivityEntry(
			microblogsEntryContent = "${microblogsEntryContent1}",
			number = "02",
			userFirstName = "${microblogsEntryAuthorFirstName}"
		);
	}

	tearDown {
		SOMicroblogs.tearDownMicroblogsEntry();

		SOUser.tearDownCP();
	}
}