@component-name = "social-office-dashboard"
definition {
	property hook.plugins.includes = "deploy-listener-hook,portal-compat-hook,so-activities-hook,so-hook";
	property portlet.plugins.includes = "chat-portlet,contacts-portlet,events-display-portlet,microblogs-portlet,private-messaging-portlet,so-announcements-portlet,so-configurations-portlet,so-portlet,tasks-portlet,wysiwyg-portlet";
	property testray.main.component.name = "Social Office EE";
	property theme.plugins.includes = "so-theme";
	var adminEmailAddress = "test@liferay.com";
	var adminFirstName = "Joe";
	var adminListName = "Bloggs, Joe";
	var adminName = "Joe Bloggs";
	var adminScreenName = "joebloggs";
	var contactEmailAddress = "socialofficecontact01@liferay.com";
	var contactName = "Social01 Office01 Contact01";
	var messageBody = "Message Body";
	var messageSubject = "Message Subject";
	var password = "test";
	var roleName = "Social Office";
	var userEmailAddress = "socialoffice01@liferay.com";
	var userEmailAddress2 = "socialoffice02@liferay.com";
	var userEmailAddress3 = "socialoffice03@liferay.com";
	var userFirstName = "Social01";
	var userFirstName2 = "Social02";
	var userFirstName3 = "Social03";
	var userLastName = "User01";
	var userLastName2 = "User02";
	var userLastName3 = "User03";
	var userListName = "User01, Social01";
	var userListName2 = "User02, Social02";
	var userListName3 = "User03, Social03";
	var userMiddleName = "Office01";
	var userMiddleName2 = "Office02";
	var userMiddleName3 = "Office03";
	var userName = "Social01 Office01 User01";
	var userName2 = "Social02 Office02 User02";
	var userName3 = "Social03 Office03 User03";
	var userScreenName = "socialoffice01";
	var userScreenName2 = "socialoffice02";
	var userScreenName3 = "socialoffice03";

	setUp {
		SOUser.firstLoginPG();
	}

	tearDown {
		SOUser.tearDownCP();

		SOContactsCenter.tearDownContacts();

		SOUserBar.tearDownNotifications();
	}

	@priority = "5"
	test AddConnection {
		SOContactsCenter.addConnection(
			adminEmailAddress = "${adminEmailAddress}",
			senderName = "${adminName}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userListName = "${userListName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOContactsCenter.disconnectFromConnection(
			userEmailAddress = "${userEmailAddress}",
			userListName = "${userListName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);
	}

	@priority = "5"
	test AddContact {
		SOContactsCenter.addContact(
			contactEmailAddress = "${contactEmailAddress}",
			contactName = "${contactName}"
		);

		SOContactsCenter.viewContact();
	}

	@priority = "5"
	test AddFollower {
		SOContactsCenter.addFollower(
			adminEmailAddress = "${adminEmailAddress}",
			adminListName = "${adminListName}",
			adminName = "${adminName}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userListName = "${userListName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOContactsCenter.unfollowUser();
	}

	@priority = "5"
	test SearchConnection {
		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${userFirstName}"
		);

		Select(
			locator1 = "SOContactscenter#CONTACTS_LIST_FILTER",
			value1 = "Connections"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_EMPTY",
			value1 = "There are no results."
		);

		SOContactsCenter.requestToConnect(
			userEmailAddress = "${userEmailAddress}",
			userListName = "${userListName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOContactsCenter.ignoreRequestToConnect(
			senderName = "${adminName}",
			userName = "${userName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${userFirstName}"
		);

		Select(
			locator1 = "SOContactscenter#CONTACTS_LIST_FILTER",
			value1 = "Connections"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_EMPTY",
			value1 = "There are no results."
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${userFirstName}"
		);

		Select(locator1 = "SOContactscenter#CONTACTS_LIST_FILTER", value1 = "All");

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_EMAIL",
			value1 = "${userEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONNECTIONS_LINK",
			value1 = "You have 0 connections."
		);

		Pause(value1 = "1000");

		Click(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_EMAIL",
			value1 = "${userEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONNECT_BUTTON",
			value1 = "Connect"
		);

		AssertElementNotPresent.assertNotVisible(
			locator1 = "SOContactscenter#DISCONNECT_BUTTON"
		);

		SOContactsCenter.requestToConnect(
			userEmailAddress = "${userEmailAddress}",
			userListName = "${userListName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOContactsCenter.confirmRequestToConnect(
			senderName = "${adminName}",
			userName = "${userName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${userFirstName}"
		);

		Select(
			locator1 = "SOContactscenter#CONTACTS_LIST_FILTER",
			value1 = "Connections"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_EMAIL",
			value1 = "${userEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONNECTIONS_LINK",
			value1 = "You have 1 connections."
		);

		Pause(value1 = "1000");

		Click(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_EMAIL",
			value1 = "${userEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#DISCONNECT_BUTTON",
			value1 = "Disconnect"
		);

		AssertElementNotPresent.assertNotVisible(
			locator1 = "SOContactscenter#CONNECT_BUTTON"
		);
	}

	@priority = "5"
	test SearchFollowing {
		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${adminFirstName}"
		);

		Select(locator1 = "SOContactscenter#CONTACTS_LIST_FILTER", value1 = "Following");

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_EMPTY",
			value1 = "There are no results."
		);

		SOContactsCenter.followUser(
			adminEmailAddress = "${adminEmailAddress}",
			adminListName = "${adminListName}",
			adminName = "${adminName}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${adminFirstName}"
		);

		Select(locator1 = "SOContactscenter#CONTACTS_LIST_FILTER", value1 = "Following");

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${adminListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_EMAIL",
			value1 = "${adminEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#FOLLOWING_LINK",
			value1 = "You are following 1 people."
		);

		Pause(value1 = "1000");

		Click(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${adminListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_NAME",
			value1 = "${adminName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_EMAIL",
			value1 = "${adminEmailAddress}"
		);
	}

	@priority = "5"
	test SearchUser {
		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Pause(value1 = "1000");

		Select(locator1 = "SOContactscenter#CONTACTS_LIST_FILTER", value1 = "All");

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${userFirstName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_EMAIL",
			value1 = "${userEmailAddress}"
		);

		Click(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_EMAIL",
			value1 = "${userEmailAddress}"
		);
	}

	@priority = "5"
	test ViewContactsCenterNotifications {
		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "${userEmailAddress2}",
			userFirstName = "${userFirstName2}",
			userLastName = "${userLastName2}",
			userMiddleName = "${userMiddleName2}",
			userScreenName = "${userScreenName2}"
		);

		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "${userEmailAddress3}",
			userFirstName = "${userFirstName3}",
			userLastName = "${userLastName3}",
			userMiddleName = "${userMiddleName3}",
			userScreenName = "${userScreenName3}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOContactsCenter.requestToConnect(
			userEmailAddress = "${adminEmailAddress}",
			userListName = "${adminListName}",
			userName = "${adminName}",
			userScreenName = "${adminScreenName}"
		);

		SOContactsCenter.sendMessage(
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}",
			userEmailAddress = "${adminEmailAddress}",
			userListName = "${adminListName}",
			userName = "${adminName}",
			userScreenName = "${adminScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress2}");

		SOContactsCenter.requestToConnect(
			userEmailAddress = "${adminEmailAddress}",
			userListName = "${adminListName}",
			userName = "${adminName}",
			userScreenName = "${adminScreenName}"
		);

		SOContactsCenter.sendMessage(
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}",
			userEmailAddress = "${adminEmailAddress}",
			userListName = "${adminListName}",
			userName = "${adminName}",
			userScreenName = "${adminScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress3}");

		SOContactsCenter.requestToConnect(
			userEmailAddress = "${adminEmailAddress}",
			userListName = "${adminListName}",
			userName = "${adminName}",
			userScreenName = "${adminScreenName}"
		);

		SOContactsCenter.sendMessage(
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}",
			userEmailAddress = "${adminEmailAddress}",
			userListName = "${adminListName}",
			userName = "${adminName}",
			userScreenName = "${adminScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertElementPresent.assertElementPresent(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "6");

		MouseOver(locator1 = "SOUserBar#NOTIFICATION");

		AssertClick.assertPartialTextClickAt(
			locator1 = "SOUserBar#NOTIFICATION_MENU_VIEW_ALL",
			value1 = "View All"
		);

		var row = "1";

		AssertTextEquals.assertPartialText(
			locator1 = "SONotifications#NOTIFICATIONS_ENTRY_INCREMENT",
			value1 = "${userName3} sent you a message."
		);

		var row = "2";

		AssertTextEquals.assertPartialText(
			locator1 = "SONotifications#NOTIFICATIONS_ENTRY_INCREMENT",
			value1 = "${userName3} would like to add you as a connection."
		);

		var row = "3";

		AssertTextEquals.assertPartialText(
			locator1 = "SONotifications#NOTIFICATIONS_ENTRY_INCREMENT",
			value1 = "${userName2} sent you a message."
		);

		var row = "4";

		AssertTextEquals.assertPartialText(
			locator1 = "SONotifications#NOTIFICATIONS_ENTRY_INCREMENT",
			value1 = "${userName2} would like to add you as a connection."
		);

		var row = "5";

		AssertTextEquals.assertPartialText(
			locator1 = "SONotifications#NOTIFICATIONS_ENTRY_INCREMENT",
			value1 = "${userName} sent you a message."
		);

		var row = "6";

		AssertTextEquals.assertPartialText(
			locator1 = "SONotifications#NOTIFICATIONS_ENTRY_INCREMENT",
			value1 = "${userName} would like to add you as a connection."
		);

		Select(
			locator1 = "SONotifications#NOTIFICATIONS_ENTRIES_PER_PAGE_SELECT",
			value1 = "5"
		);

		AssertTextEquals(
			locator1 = "SONotifications#SEARCH_RESULTS",
			value1 = "Showing 1 - 5 of 6 results."
		);

		var row = "1";

		AssertTextEquals.assertPartialText(
			locator1 = "SONotifications#NOTIFICATIONS_ENTRY_INCREMENT",
			value1 = "${userName3} sent you a message."
		);

		var row = "2";

		AssertTextEquals.assertPartialText(
			locator1 = "SONotifications#NOTIFICATIONS_ENTRY_INCREMENT",
			value1 = "${userName3} would like to add you as a connection."
		);

		var row = "3";

		AssertTextEquals.assertPartialText(
			locator1 = "SONotifications#NOTIFICATIONS_ENTRY_INCREMENT",
			value1 = "${userName2} sent you a message."
		);

		var row = "4";

		AssertTextEquals.assertPartialText(
			locator1 = "SONotifications#NOTIFICATIONS_ENTRY_INCREMENT",
			value1 = "${userName2} would like to add you as a connection."
		);

		var row = "5";

		AssertTextEquals.assertPartialText(
			locator1 = "SONotifications#NOTIFICATIONS_ENTRY_INCREMENT",
			value1 = "${userName} sent you a message."
		);

		var row = "6";

		AssertElementNotPresent(
			locator1 = "SONotifications#NOTIFICATIONS_ENTRY_INCREMENT"
		);

		Click(locator1 = "SONotifications#NEXT_BUTTON", value1 = "Next");

		AssertTextEquals(
			locator1 = "SONotifications#SEARCH_RESULTS",
			value1 = "Showing 6 - 6 of 6 results."
		);

		var row = "1";

		AssertTextEquals.assertPartialText(
			locator1 = "SONotifications#NOTIFICATIONS_ENTRY_INCREMENT",
			value1 = "${userName} would like to add you as a connection."
		);

		var row = "2";

		AssertElementNotPresent(
			locator1 = "SONotifications#NOTIFICATIONS_ENTRY_INCREMENT"
		);
	}

	@priority = "5"
	test ViewContactsCenterUserDetails {
		var adminEmailAddress = "${adminEmailAddress}";
		var adminName = "${adminName}";
		var password = "test";
		var roleName = "Social Office";
		var userAdditionalEmailAddress = "socialoffice02@liferay.com";
		var userAddressCity = "Ray of Light";
		var userAddressCountry = "United States";
		var userAddressPostalCode = "91234";
		var userAddressRegion = "California";
		var userAddressStreet1 = "123 Liferay Ln.";
		var userAddressType = "Personal";
		var userEmailAddress = "${userEmailAddress}";
		var userFirstName = "${userFirstName}";
		var userInstantMessengerAIM = "socialofficesn";
		var userInstantMessengerICQ = "socialofficesn";
		var userInstantMessengerJabber = "socialofficesn";
		var userInstantMessengerSkype = "socialofficesn";
		var userInstantMessengerWindowsLiveMessenger = "socialofficesn";
		var userInstantMessengerYM = "socialofficesn";
		var userIntroduction = "Introduction Content";
		var userLastName = "${userLastName}";
		var userListName = "${userListName}";
		var userMiddleName = "${userMiddleName}";
		var userName = "${userName}";
		var userPhoneNumberExtension = "123";
		var userPhoneNumberNumber = "123-123-1234";
		var userPhoneNumberType = "Business";
		var userProjectDescription = "Expertise Description";
		var userProjectTitle = "Expertise Title";
		var userScreenName = "${userScreenName}";
		var userSMS = "socialoffice@liferay.com";
		var userSocialNetworkFacebook = "socialoffice01";
		var userSocialNetworkMyspace = "socialoffice01";
		var userSocialNetworkTwitter = "socialoffice01";
		var userTag = "tag1";
		var userWebsiteType = "Personal";
		var userWebsiteURL = "http://www.socialoffice01.com";

		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "socialoffice01@liferay.com",
			userFirstName = "Social01",
			userLastName = "User01",
			userMiddleName = "Office01",
			userScreenName = "socialoffice01"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOProfile.addAdditionalEmailAddressProfile(
			userAdditionalEmailAddress = "${userAdditionalEmailAddress}"
		);

		SOProfile.addAddressProfile(
			userAddressCity = "${userAddressCity}",
			userAddressCountry = "${userAddressCountry}",
			userAddressPostalCode = "${userAddressPostalCode}",
			userAddressRegion = "${userAddressRegion}",
			userAddressStreet1 = "${userAddressStreet1}",
			userAddressType = "${userAddressType}"
		);

		SOProfile.addIntroductionProfile(userIntroduction = "${userIntroduction}");

		SOProfile.addInstantMessengerProfile(
			userInstantMessengerAIM = "${userInstantMessengerAIM}",
			userInstantMessengerICQ = "${userInstantMessengerICQ}",
			userInstantMessengerJabber = "${userInstantMessengerJabber}",
			userInstantMessengerSkype = "${userInstantMessengerSkype}",
			userInstantMessengerWindowsLiveMessenger = "${userInstantMessengerWindowsLiveMessenger}",
			userInstantMessengerYM = "${userInstantMessengerYM}"
		);

		SOProfile.addPhoneNumbersProfile(
			userPhoneNumberExtension = "${userPhoneNumberExtension}",
			userPhoneNumberNumber = "${userPhoneNumberNumber}",
			userPhoneNumberType = "${userPhoneNumberType}"
		);

		SOProfile.addProjectsProfile(
			userProjectDescription = "${userProjectDescription}",
			userProjectTitle = "${userProjectTitle}"
		);

		SOProfile.addSMSProfile(userSMS = "${userSMS}");

		SOProfile.addSocialNetworkProfile(
			userSocialNetworkFacebook = "${userSocialNetworkFacebook}",
			userSocialNetworkMyspace = "${userSocialNetworkMyspace}",
			userSocialNetworkTwitter = "${userSocialNetworkTwitter}"
		);

		SOProfile.addTagProfile(userTag = "${userTag}");

