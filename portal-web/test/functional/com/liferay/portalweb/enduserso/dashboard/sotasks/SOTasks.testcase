@component-name = "social-office-dashboard"
definition {
	property hook.plugins.includes = "deploy-listener-hook,portal-compat-hook,so-activities-hook,so-hook";
	property portlet.plugins.includes = "chat-portlet,contacts-portlet,events-display-portlet,microblogs-portlet,private-messaging-portlet,so-announcements-portlet,so-configurations-portlet,so-portlet,tasks-portlet,wysiwyg-portlet";
	property testray.main.component.name = "Social Office EE";
	property theme.plugins.includes = "so-theme";
	var adminEmailAddress = "test@liferay.com";
	var adminFirstName = "Joe";
	var adminListName = "Bloggs, Joe";
	var adminName = "Joe Bloggs";
	var contactEmailAddress = "socialofficecontact01@liferay.com";
	var contactName = "Social01 Office01 Contact01";
	var pageName = "Tasks Page";
	var password = "test";
	var portletName = "Tasks";
	var roleName = "Social Office";
	var taskDescription = "Task Description";
	var taskDescriptionEdit = "Task Description Edit";
	var userEmailAddress = "socialoffice01@liferay.com";
	var userFirstName = "Social01";
	var userLastName = "User01";
	var userListName = "User01, Social01";
	var userMiddleName = "Office01";
	var userName = "Social01 Office01 User01";
	var userScreenName = "socialoffice01";

	setUp {
		SOUser.firstLoginPG();
	}

	tearDown {
		SOTasks.tearDownTask();

		SOUser.tearDownCP();

		SOUserBar.tearDownNotifications();

		Page.tearDownPG();
	}

	@priority = "5"
	test AddTaskAssignedToConnection {
		SOContactsCenter.addConnection(
			adminEmailAddress = "${adminEmailAddress}",
			senderName = "${adminName}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userListName = "${userListName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SONavigation.gotoDashboardTasks();

		SOTasks.addTask(
			taskAssignee = "${userName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.viewTask(
			taskAssignee = "${userName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOTasks.viewTaskNotification(
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.viewTask(
			taskAssignee = "${userName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);
	}

	@priority = "5"
	test AddTaskAssignedToFollower {
		SOContactsCenter.addFollower(
			adminEmailAddress = "${adminEmailAddress}",
			adminListName = "${adminListName}",
			adminName = "${adminName}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userListName = "${userListName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SONavigation.gotoDashboardTasks();

		Click(locator1 = "SOTasks#ADD_TASK_BUTTON");

		Type(
			locator1 = "SOTasksAdd#TASK_DESCRIPTION_FIELD",
			value1 = "${taskDescription}"
		);

		AssertTextNotEquals.assertNotPartialText(
			locator1 = "SOTasksAdd#TASK_ASSIGNEE_SELECT_MENU",
			value1 = "${userName}"
		);
	}

	@priority = "5"
	test AddTaskAssignedToMe {
		SONavigation.gotoDashboardTasks();

		SOTasks.addTask(
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.viewTask(
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);
	}

	@priority = "5"
	test AddTaskAssignedToMeDueDate {
		SONavigation.gotoDashboardTasks();

		SONavigation.gotoDashboardTasks();

		SOTasks.addTask(
			dueDate = "true",
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.viewTask(
			dueDate = "true",
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);
	}

	@priority = "5"
	test AddTaskAssignedToMeTag {
		SONavigation.gotoDashboardTasks();

		SOTasks.addTask(
			numberOfTags = "3",
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.viewTask(
			numberOfTags = "3",
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);
	}

	@priority = "5"
	test CompleteTask100Percent {
		SONavigation.gotoDashboardTasks();

		SOTasks.addTask(
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.completeTask(
			percentCompletion = "100",
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.viewTask(
			percentCompletion = "100",
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);
	}

	@priority = "5"
	test CompleteTask60Percent {
		SONavigation.gotoDashboardTasks();

		SOTasks.addTask(
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.completeTask(
			percentCompletion = "60",
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.viewTask(
			percentCompletion = "60",
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);
	}

	@priority = "5"
	test DeleteTaskAssignedToMeDescription {
		SONavigation.gotoDashboardTasks();

		SOTasks.addTask(
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.deleteTask(
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);
	}

	@priority = "5"
	test EditTaskAssignedToMeDescription {
		SONavigation.gotoDashboardTasks();

		SOTasks.addTask(
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.editTask(taskDescriptionEdit = "${taskDescriptionEdit}");

		SONavigation.gotoDashboardTasks();

		SOTasks.viewTask(
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescriptionEdit}",
			taskReporter = "${adminName}"
		);
	}

	@priority = "5"
	test FilterTasksByPlace {
		SONavigation.gotoDashboardTasks();

		SOTasks.addTask(
			number = "01",
			tagNumber = "1",
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");

		Page.gotoPG(pageName = "${pageName}");

		SOTasks.addTask(
			number = "02",
			tagNumber = "2",
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		AssertClick(locator1 = "SOTasks#FILTER_BUTTON", value1 = "Filter");

		Pause(value1 = "1000");

		AssertTextEquals(
			locator1 = "SOTasks#FILTER_PLACE_HEADER",
			value1 = "Filter by Place"
		);

		Select(locator1 = "SOTasks#FILTER_PLACE_SELECT_MENU", value1 = "Liferay");

		var number = "02";

		AssertTextEquals(
			locator1 = "SOTasks#TASK_DESCRIPTION_NORMAL_INCREMENT",
			value1 = "${taskDescription}02"
		);

		AssertTextNotPresent(value1 = "${taskDescription}01");
	}

	@priority = "5"
	test FilterTasksByTag {
		SONavigation.gotoDashboardTasks();

		SOTasks.addTask(
			number = "01",
			tagNumber = "1",
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");

		Page.gotoPG(pageName = "${pageName}");

		SOTasks.addTask(
			number = "02",
			tagNumber = "2",
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		AssertClick(locator1 = "SOTasks#FILTER_BUTTON", value1 = "Filter");

		Pause(value1 = "1000");

		AssertTextEquals(
			locator1 = "SOTasks#FILTER_TAG_HEADER",
			value1 = "Filter by Tags"
		);

		var number = "01";

		AssertTextEquals(
			locator1 = "SOTasks#TASK_DESCRIPTION_NORMAL_INCREMENT",
			value1 = "${taskDescription}01"
		);

		var number = "02";
		var tagNumber = "2";

		AssertTextEquals(
			locator1 = "SOTasks#TASK_DESCRIPTION_NORMAL_INCREMENT",
			value1 = "${taskDescription}02"
		);

		AssertClick(locator1 = "SOTasks#FILTER_TAG_CHECKBOX", value1 = "tag2");

		AssertTextEquals(
			locator1 = "SOTasks#TASK_DESCRIPTION_NORMAL_INCREMENT",
			value1 = "${taskDescription}02"
		);

		AssertTextNotPresent(value1 = "${taskDescription}01");

		AssertClick(locator1 = "SOTasks#FILTER_TAG_CHECKBOX", value1 = "tag2");

		var number = "01";
		var tagNumber = "1";

		AssertClick(locator1 = "SOTasks#FILTER_TAG_CHECKBOX", value1 = "tag1");

		AssertTextEquals(
			locator1 = "SOTasks#TASK_DESCRIPTION_NORMAL_INCREMENT",
			value1 = "${taskDescription}01"
		);

		AssertTextNotPresent(value1 = "${taskDescription}02");
	}

	@priority = "5"
	test ResolveTaskAssignedToConnection {
		SOContactsCenter.addConnection(
			adminEmailAddress = "${adminEmailAddress}",
			senderName = "${adminName}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userListName = "${userListName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SONavigation.gotoDashboardTasks();

		SOTasks.addTask(
			taskAssignee = "${userName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOTasks.viewTaskNotification(
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.resolveTask(
			taskAssignee = "${userName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.viewTask(
			percentCompletion = "100",
			taskAssignee = "${userName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOTasks.viewResolveTaskNotification(
			taskAssignee = "${userName}",
			taskDescription = "${taskDescription}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.viewTask(
			percentCompletion = "100",
			taskAssignee = "${userName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);
	}

	@priority = "5"
	test ResolveTaskAssignedToMe {
		SONavigation.gotoDashboardTasks();

		SOTasks.addTask(
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.resolveTask(
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SONavigation.gotoDashboardTasks();

		SOTasks.viewTask(
			percentCompletion = "100",
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);
	}
}