@component-name = "social-office-dashboard"
definition {
	property hook.plugins.includes = "deploy-listener-hook,portal-compat-hook,so-activities-hook,so-hook";
	property portlet.plugins.includes = "chat-portlet,contacts-portlet,events-display-portlet,microblogs-portlet,private-messaging-portlet,so-announcements-portlet,so-configurations-portlet,so-portlet,tasks-portlet,wysiwyg-portlet";
	property testray.main.component.name = "Social Office EE";
	property theme.plugins.includes = "so-theme";

	setUp {
		SOUser.firstLoginPG();
	}

	var adminEmailAddress = "test@liferay.com";
	var adminFirstName = "Joe";
	var adminListName = "Bloggs, Joe";
	var adminName = "Joe Bloggs";
	var adminScreenName = "joebloggs";
	var distributionScope = "General";
	var entryContent = "Announcements Entry Content";
	var entryContentEdit = "Announcements Entry Content Edit";
	var entryTitle = "Announcements Entry Title";
	var entryTitleEdit = "Announcements Entry Title Edit";
	var entryURL = "http://www.liferay.com";
	var eventDescription = "Calendar Event Description";
	var eventTitle = "Calendar Event Title";
	var microblogsEntryAuthorFirstName = "Joe";
	var microblogsEntryAuthorLastName = "Bloggs";
	var microblogsEntryAuthorScreenName = "joebloggs";
	var microblogsEntryCommentContent = "Microblogs Post Comment";
	var microblogsEntryContent = "Microblogs Post";
	var microblogsEntryTagValue = "Microblogs";
	var pageName = "Calendar Page";
	var portletName = "Calendar";
	var taskDescription = "Task Description";
	var userEmailAddress = "socialoffice01@liferay.com";
	var userFirstName = "Social01";
	var userLastName = "User01";
	var userListName = "User01, Social01";
	var userMiddleName = "Office01";
	var userName = "Social01 Office01 User01";
	var userScreenName = "socialoffice01";
	var whatsHappeningEntryAuthorFirstName = "Joe";
	var whatsHappeningEntryAuthorLastName = "Bloggs";
	var whatsHappeningEntryAuthorScreenName = "joebloggs";
	var whatsHappeningEntryCharacterCountdown = "135";
	var whatsHappeningEntryContent = "Microblogs Post";

	@priority = "5"
	test AddSOAnnouncementsEntry {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		SOAnnouncementsEntry.addPG(
			distributionScope = "${distributionScope}",
			entryAuthor = "${entryContent}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			entryURL = "${entryURL}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		SOAnnouncementsEntry.viewPG(
			distributionScope = "${distributionScope}",
			entryAuthor = "${adminName}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			entryURL = "${entryURL}"
		);
	}

	@priority = "5"
	test AddWhatsHappeningEntryViewableByConnections {
		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "socialoffice01@liferay.com",
			userFirstName = "Social01",
			userLastName = "User01",
			userMiddleName = "Office01",
			userScreenName = "socialoffice01"
		);

		SODashboard.addWhatsHappeningEntry(
			whatsHappeningEntryCharacterCountdown = "${whatsHappeningEntryCharacterCountdown}",
			whatsHappeningEntryContent = "${whatsHappeningEntryContent}",
			whatsHappeningEntryViewableBy = "Connections"
		);

		SOMicroblogs.viewOwnMicroblogsEntry(
			microblogsEntryAuthorFirstName = "${whatsHappeningEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${whatsHappeningEntryAuthorLastName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOMicroblogs.viewMicroblogsEntryNone();

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOContactsCenter.requestToConnect(
			userEmailAddress = "${userEmailAddress}",
			userListName = "${userListName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOContactsCenter.confirmRequestToConnect(
			senderName = "${adminName}",
			userName = "${userName}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertClick.assertTextClickAt(
			locator1 = "SOActivities#NAVIGATION_CONNECTIONS",
			value1 = "Connections"
		);

		SOActivities.viewMicroblogsNotViewableByEveryoneActivityEntry(
			userFirstName = "${whatsHappeningEntryAuthorFirstName}",
			userName = "${whatsHappeningEntryAuthorFirstName} ${whatsHappeningEntryAuthorLastName}"
		);

		SOMicroblogs.viewMicroblogsEntryNotViewableByEveryone(
			microblogsEntryAuthorFirstName = "${whatsHappeningEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${whatsHappeningEntryAuthorLastName}",
			microblogsEntryContent = "${whatsHappeningEntryContent}"
		);
	}

	@priority = "5"
	test AddWhatsHappeningEntryViewableByEveryone {
		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "socialoffice01@liferay.com",
			userFirstName = "Social01",
			userLastName = "User01",
			userMiddleName = "Office01",
			userScreenName = "socialoffice01"
		);

		SODashboard.addWhatsHappeningEntry(
			whatsHappeningEntryCharacterCountdown = "${whatsHappeningEntryCharacterCountdown}",
			whatsHappeningEntryContent = "${whatsHappeningEntryContent}"
		);

		SOMicroblogs.viewOwnMicroblogsEntry(
			microblogsEntryAuthorFirstName = "${whatsHappeningEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${whatsHappeningEntryAuthorLastName}",
			microblogsEntryContent = "${whatsHappeningEntryContent}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOMicroblogs.viewMicroblogsEntryViewableByEveryone(
			microblogsEntryAuthorFirstName = "${whatsHappeningEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${whatsHappeningEntryAuthorLastName}",
			microblogsEntryAuthorScreenName = "${whatsHappeningEntryAuthorScreenName}",
			microblogsEntryContent = "${whatsHappeningEntryContent}"
		);
	}

	@priority = "5"
	test AddWhatsHappeningEntryViewableByFollowers {
		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "socialoffice01@liferay.com",
			userFirstName = "Social01",
			userLastName = "User01",
			userMiddleName = "Office01",
			userScreenName = "socialoffice01"
		);

		SODashboard.addWhatsHappeningEntry(
			whatsHappeningEntryCharacterCountdown = "${whatsHappeningEntryCharacterCountdown}",
			whatsHappeningEntryContent = "${whatsHappeningEntryContent}",
			whatsHappeningEntryViewableBy = "Followers"
		);

		SOMicroblogs.viewOwnMicroblogsEntry(
			microblogsEntryAuthorFirstName = "${whatsHappeningEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${whatsHappeningEntryAuthorLastName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOMicroblogs.viewMicroblogsEntryNone();

		SOContactsCenter.followUser(
			adminEmailAddress = "${adminEmailAddress}",
			adminListName = "${adminListName}",
			adminName = "${adminName}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertClick.assertTextClickAt(
			locator1 = "SOActivities#NAVIGATION_FOLLOWING",
			value1 = "Following"
		);

		SOActivities.viewMicroblogsNotViewableByEveryoneActivityEntry(
			userFirstName = "${whatsHappeningEntryAuthorFirstName}",
			userName = "${whatsHappeningEntryAuthorFirstName} ${whatsHappeningEntryAuthorLastName}"
		);

		SOMicroblogs.viewMicroblogsEntryNotViewableByEveryone(
			microblogsEntryAuthorFirstName = "${whatsHappeningEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${whatsHappeningEntryAuthorLastName}",
			microblogsEntryContent = "${whatsHappeningEntryContent}"
		);
	}

	@priority = "5"
	test DeleteSOAnnouncementsEntry {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		SOAnnouncementsEntry.addPG(
			distributionScope = "${distributionScope}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			entryURL = "${entryURL}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		SOAnnouncementsEntry.deletePG();
	}

	@priority = "5"
	test EditSOAnnouncementsEntry {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		SOAnnouncementsEntry.addPG(
			distributionScope = "${distributionScope}",
			entryAuthor = "${adminName}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			entryURL = "${entryURL}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		SOAnnouncementsEntry.editPG(
			distributionScope = "${distributionScope}",
			entryContentEdit = "${entryContentEdit}",
			entryTitleEdit = "${entryTitleEdit}",
			entryURL = "${entryURL}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		SOAnnouncementsEntry.viewPG(
			distributionScope = "${distributionScope}",
			entryAuthor = "${adminName}",
			entryContent = "${entryContentEdit}",
			entryTitle = "${entryTitleEdit}",
			entryURL = "${entryURL}"
		);
	}

	@priority = "5"
	test MarkAsReadSOAnnouncementsEntry {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		SOAnnouncementsEntry.addPG(
			distributionScope = "${distributionScope}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			entryURL = "${entryURL}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		SOAnnouncementsEntry.markAsReadPG(
			distributionScope = "${distributionScope}",
			entryAuthor = "${adminName}",
			entryContentEdit = "${entryContent}",
			entryTitleEdit = "${entryTitle}",
			entryURL = "${entryURL}"
		);
	}

	@priority = "5"
	test MarkAsUnreadSOAnnouncementsEntry {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		SOAnnouncementsEntry.addPG(
			distributionScope = "${distributionScope}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			entryURL = "${entryURL}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		SOAnnouncementsEntry.markAsReadPG(
			distributionScope = "${distributionScope}",
			entryAuthor = "${adminName}",
			entryContentEdit = "${entryContent}",
			entryTitleEdit = "${entryTitle}",
			entryURL = "${entryURL}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		SOAnnouncementsEntry.markAsUnreadPG(
			distributionScope = "${distributionScope}",
			entryAuthor = "${adminName}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			entryURL = "${entryURL}"
		);
	}

	@priority = "5"
	test ViewEventEventsDisplay {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		SODashboard.addPage(pageName = "${pageName}");

		SODashboard.addPortlet(pageName = "${pageName}");

		Event.addPG(
			eventDescription = "${eventDescription}",
			eventTitle = "${eventTitle}"
		);

		SODashboard.viewTodaysEvent(
			eventDescription = "${eventDescription}",
			eventTitle = "${eventTitle}",
			userName = "${adminName}"
		);

		AssertTextEquals(locator1 = "SODashboard#PROFILE_NAME", value1 = "${adminName}");
	}

	@priority = "5"
	test ViewLinkContactscenter {
		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		SODashboard.viewLinkContactscenter();
	}

	@priority = "5"
	test ViewLinkHome {
		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Click(locator1 = "SODashboard#NAVIGATION_DASHBOARD", value1 = "Dashboard");

		SODashboard.viewLinkHome();
	}

	@priority = "5"
	test ViewLinkMicroblogs {
		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MICROBLOGS",
			value1 = "Microblogs"
		);

		SODashboard.viewLinkMicroblogs();
	}

	@priority = "5"
	test ViewLinkMydocuments {
		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MY_DOCUMENTS",
			value1 = "My Documents"
		);

		SODashboard.viewLinkMydocuments();
	}

	@priority = "5"
	test ViewLinkPrivateMessaging {
		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		SODashboard.viewLinkPrivateMessaging();
	}

	@priority = "5"
	test ViewLinkTasks {
		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		AssertClick.assertTextClickAt(
			locator1 = "SODashboard#NAVIGATION_TASKS",
			value1 = "Tasks"
		);

		SODashboard.viewLinkTasks();
	}

	@priority = "5"
	test ViewSiteEventEventsDisplay {
		var siteDescription = "Open Site Description";
		var siteName = "Open Site Name";
		var siteType = "Open";

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription}",
			siteName = "${siteName}",
			siteType = "${siteType}"
		);

		Page.gotoPG(pageName = "Calendar", pageType = "Open Site");

		Event.addPG(
			eventDescription = "${eventDescription}",
			eventTitle = "${eventTitle}"
		);

		SODashboard.viewTodaysEventSiteEvent(
			eventDescription = "${eventDescription}",
			eventTitle = "${eventTitle}"
		);

		AssertTextEquals(locator1 = "SOSiteHome#SITE_NAME", value1 = "${siteName}");
	}

	@priority = "5"
	test ViewUpcomingTaskAssignedToConnection {
		SOContactsCenter.addConnection(
			adminEmailAddress = "${adminEmailAddress}",
			senderName = "${adminName}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userListName = "${userListName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SONavigation.gotoDashboardTasks();

		SOTasks.addTask(
			taskAssignee = "${userName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SODashboard.viewUpcomingTask(
			taskAssignee = "${userName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SODashboard.viewUpcomingTask(
			taskAssignee = "${userName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);
	}

	@priority = "5"
	test ViewUpcomingTaskAssignedToMe {
		SONavigation.gotoDashboardTasks();

		SOTasks.addTask(
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);

		SODashboard.viewUpcomingTask(
			taskAssignee = "${adminName}",
			taskDescription = "${taskDescription}",
			taskReporter = "${adminName}"
		);
	}

	@priority = "5"
	test ViewWhatsHappeningEntrySOUser {
		SOContactsCenter.addConnection(
			adminEmailAddress = "${adminEmailAddress}",
			senderName = "${adminName}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userListName = "${userListName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntryMention(
			mentionUserEmailAddress = "${userEmailAddress}",
			mentionUserFirstName = "${userFirstName}",
			mentionUserLastName = "${userLastName}",
			mentionUserListName = "${userListName}",
			mentionUserMiddleName = "${userMiddleName}",
			mentionUserName = "${userName}",
			mentionUserScreenName = "${userScreenName}"
		);

		SOMicroblogs.viewOwnMicroblogsEntryMention(
			mentionUserName = "${userName}",
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MICROBLOGS",
			value1 = "Microblogs"
		);

		SOMicroblogs.addMicroblogsEntryComment(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryCommentContent = "${microblogsEntryCommentContent}",
			microblogsEntryContent = "${userName}"
		);

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntry(
			microblogsEntryContent = "${microblogsEntryContent}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertTextEquals(
			locator1 = "SODashboard#WHATS_HAPPENING_ENTRY_CONTENT",
			value1 = "${microblogsEntryContent}"
		);

		AssertTextNotPresent(value1 = "Microblogs Post Comment");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MICROBLOGS",
			value1 = "Microblogs"
		);

		SOMicroblogs.viewMicroblogsEntryAuthor(
			microblogsEntryAuthorFirstName = "${userFirstName}",
			microblogsEntryAuthorLastName = "${userLastName}",
			microblogsEntryAuthorMiddleName = "${userMiddleName}"
		);

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT",
			value1 = "${microblogsEntryContent}"
		);

		SOMicroblogs.viewMicroblogsEntryCommentLink();

		AssertTextEquals(
			locator1 = "xpath=(//div[@class='user-name']/span/a)[2]",
			value1 = "${adminName}"
		);

		AssertTextEquals(
			locator1 = "xpath=(//div[@class='content'])[2]",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "xpath=(//span[@class='action comment']/a)[2]",
			value1 = "1 Comment"
		);

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_REPOST_LINK",
			value1 = "Repost"
		);
	}

	tearDown {
		SOMicroblogs.tearDownMicroblogsEntry();

		SOAnnouncementsEntry.tearDownPG();

		SOUser.tearDownCP();

		SOCalendar.tearDownCP();

		SODashboard.tearDownPG();

		SOUserBar.tearDownNotifications();

		SOTasks.tearDownTask();

		SOUserBar.tearDownSites();
	}
}