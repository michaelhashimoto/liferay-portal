@component-name = "social-office-dashboard"
definition {
	property hook.plugins.includes = "deploy-listener-hook,portal-compat-hook,so-activities-hook,so-hook";
	property portlet.plugins.includes = "chat-portlet,contacts-portlet,events-display-portlet,microblogs-portlet,private-messaging-portlet,so-announcements-portlet,so-configurations-portlet,so-portlet,tasks-portlet,wysiwyg-portlet";
	property testray.main.component.name = "Social Office EE";
	property theme.plugins.includes = "so-theme";

	setUp {
		SOUser.firstLoginPG();
	}

	var adminEmailAddress = "test@liferay.com";
	var adminFirstName = "Joe";
	var adminListName = "Bloggs, Joe";
	var adminName = "Joe Bloggs";
	var adminScreenName = "joebloggs";
	var microblogsEntryAuthorFirstName = "Joe";
	var microblogsEntryAuthorLastName = "Bloggs";
	var microblogsEntryAuthorScreenName = "joebloggs";
	var microblogsEntryCommentContent = "Microblogs Post Comment";
	var microblogsEntryContent = "Microblogs Post";
	var microblogsEntryTagValue = "Microblogs";
	var userEmailAddress = "socialoffice01@liferay.com";
	var userFirstName = "Social01";
	var userLastName = "User01";
	var userListName = "User01, Social01";
	var userMiddleName = "Office01";
	var userName = "Social01 Office01 User01";
	var userScreenName = "socialoffice01";

	@priority = "5"
	test AddMicroblogsEntriesTag {
		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntryHashtag(
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryTagValue = "${microblogsEntryTagValue}",
			number = "01"
		);

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntryHashtag(
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryTagValue = "${microblogsEntryTagValue}",
			number = "02"
		);

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntryHashtag(
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryTagValue = "${microblogsEntryTagValue}",
			number = "03"
		);

		SOMicroblogs.viewOwnMicroblogsEntryTag(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryTagValue = "${microblogsEntryTagValue}",
			number = "01",
			whatsHappeningNumber = "03"
		);

		SOMicroblogs.viewOwnMicroblogsEntryTag(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryTagValue = "${microblogsEntryTagValue}",
			number = "02",
			whatsHappeningNumber = "03"
		);

		SOMicroblogs.viewOwnMicroblogsEntryTag(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryTagValue = "${microblogsEntryTagValue}",
			number = "03",
			whatsHappeningNumber = "03"
		);
	}

	@priority = "5"
	test AddMicroblogsEntryMentions {
		SOContactsCenter.addConnection(
			adminEmailAddress = "${adminEmailAddress}",
			senderName = "${adminName}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userListName = "${userLastName}, ${userFirstName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntryMention(
			mentionUserEmailAddress = "${userEmailAddress}",
			mentionUserFirstName = "${userFirstName}",
			mentionUserLastName = "${userLastName}",
			mentionUserListName = "${userListName}",
			mentionUserMiddleName = "${userMiddleName}",
			mentionUserName = "${userName}",
			mentionUserScreenName = "${userScreenName}"
		);

		SOMicroblogs.viewOwnMicroblogsEntryMention(
			mentionUserName = "${userName}",
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOMicroblogs.viewMicroblogsEntryMention(
			mentionUserEmailAddress = "${userEmailAddress}",
			mentionUserName = "${userName}",
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}"
		);
	}

	@priority = "5"
	test AddMicroblogsEntryTag {
		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntryHashtag(
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryTagValue = "${microblogsEntryTagValue}"
		);

		SOMicroblogs.viewOwnMicroblogsEntryTag(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryTagValue = "${microblogsEntryTagValue}"
		);
	}

	@priority = "5"
	test AddMicroblogsEntryViewableByConnections {
		SOUser.addUserWithSORole(
			adminEmailAddress = "${adminEmailAddress}",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntry(
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryViewableBy = "Connections"
		);

		SOMicroblogs.viewOwnMicroblogsEntry(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOMicroblogs.viewMicroblogsEntryNone();

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOContactsCenter.requestToConnect(
			userEmailAddress = "${userEmailAddress}",
			userListName = "${userListName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOContactsCenter.confirmRequestToConnect(
			senderName = "${adminName}",
			userName = "${userName}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertClick.assertTextClickAt(
			locator1 = "SOActivities#NAVIGATION_CONNECTIONS",
			value1 = "Connections"
		);

		SOActivities.viewMicroblogsNotViewableByEveryoneActivityEntry(
			userFirstName = "${microblogsEntryAuthorFirstName}",
			userName = "${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}"
		);

		SOMicroblogs.viewMicroblogsEntryNotViewableByEveryone(
			microblogsEntryAuthor = "${microblogsEntryAuthor}",
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryContent = "${microblogsEntryContent}"
		);
	}

	@priority = "5"
	test AddMicroblogsEntryViewableByConnectionsComment {
		SOContactsCenter.addConnection(
			adminEmailAddress = "${adminEmailAddress}",
			senderName = "${adminName}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userListName = "${userListName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntry(
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryViewableBy = "Connections"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MICROBLOGS",
			value1 = "Microblogs"
		);

		SOMicroblogs.addMicroblogsEntryComment(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryCommentContent = "${microblogsEntryCommentContent}",
			microblogsEntryContent = "${microblogsEntryContent}"
		);

		SOMicroblogs.viewMicroblogsEntryNotViewableByEveryone(
			commentCount = "1",
			microblogsEntryAuthor = "${microblogsEntryAuthor}",
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryContent = "${microblogsEntryContent}"
		);

		SOMicroblogs.viewMicroblogsEntryComment(
			commentCount = "1",
			microblogsEntryCommentAuthorFirstName = "${userFirstName}",
			microblogsEntryCommentAuthorLastName = "${userLastName}",
			microblogsEntryCommentAuthorMiddleName = "${userMiddleName}",
			microblogsEntryCommentContent = "${microblogsEntryCommentContent}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOMicroblogs.viewOwnMicroblogsEntry(
			commentCount = "1",
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}"
		);

		SOMicroblogs.viewMicroblogsEntryComment(
			commentCount = "1",
			microblogsEntryCommentAuthorFirstName = "${userFirstName}",
			microblogsEntryCommentAuthorLastName = "${userLastName}",
			microblogsEntryCommentAuthorMiddleName = "${userMiddleName}",
			microblogsEntryCommentContent = "${microblogsEntryCommentContent}"
		);

		SOMicroblogs.viewMicroblogsEntryCommentNotification(
			microblogsEntryCommentAuthorFirstName = "${userFirstName}",
			microblogsEntryCommentAuthorLastName = "${userLastName}",
			microblogsEntryCommentAuthorMiddleName = "${userMiddleName}",
			microblogsEntryCommentContent = "${microblogsEntryCommentContent}"
		);
	}

	@priority = "5"
	test AddMicroblogsEntryViewableByEveryone {
		SOUser.addUserWithSORole(
			adminEmailAddress = "${adminEmailAddress}",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntry(
			microblogsEntryContent = "${microblogsEntryContent}"
		);

		SOMicroblogs.viewOwnMicroblogsEntry(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryContent = "${microblogsEntryContent}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOMicroblogs.viewMicroblogsEntryViewableByEveryone(
			microblogsEntryAuthor = "${microblogsEntryAuthor}",
			microblogsEntryContent = "${microblogsEntryContent}"
		);
	}

	@priority = "5"
	test AddMicroblogsEntryViewableByEveryoneCommentMention {
		SOContactsCenter.addConnection(
			adminEmailAddress = "${adminEmailAddress}",
			senderName = "${adminName}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userListName = "${userListName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntry(
			microblogsEntryContent = "${microblogsEntryContent}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		var profileScreenName = "${microblogsEntryAuthorScreenName}";

		Open(locator1 = "SOProfile#PROFILE_URL");

		Click(locator1 = "SOProfile#NAVIGATION_MICROBLOGS");

		SOMicroblogs.addMicroblogsEntryCommentMention(
			mentionUserEmailAddress = "${adminEmailAddress}",
			mentionUserFirstName = "${adminFirstName}",
			mentionUserName = "${adminName}",
			microblogsEntryCommentContent = "${microblogsEntryCommentContent}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		SOActivities.viewMicroblogsCommentActivityEntry(
			commentCount = "1",
			microblogsEntryCommentContent = "${microblogsEntryCommentContent} [@${adminScreenName}]"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOMicroblogs.viewMicroblogsEntryCommentNotification(
			microblogsEntryCommentAuthorFirstName = "${userFirstName}",
			microblogsEntryCommentAuthorLastName = "${userLastName}",
			microblogsEntryCommentAuthorMiddleName = "${userMiddleName}",
			microblogsEntryCommentContent = "${microblogsEntryCommentContent} [@${adminScreenName}]"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MICROBLOGS",
			value1 = "Microblogs"
		);

		AssertClick.assertTextClickAt(
			locator1 = "SOMicroblogs#TAB_MENTIONS",
			value1 = "Mentions"
		);

		SOMicroblogs.viewMicroblogsEntryAuthor(
			microblogsEntryAuthorFirstName = "${userFirstName}",
			microblogsEntryAuthorLastName = "${userLastName}",
			microblogsEntryAuthorMiddleName = "${userMiddleName}"
		);

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT",
			value1 = "${microblogsEntryCommentContent} ${adminName}"
		);

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_TAG",
			value1 = "${adminName}"
		);
	}

	@priority = "5"
	test AddMicroblogsEntryViewableByFollowers {
		SOUser.addUserWithSORole(
			adminEmailAddress = "${adminEmailAddress}",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntry(
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryViewableBy = "Followers"
		);

		SOMicroblogs.viewOwnMicroblogsEntry(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOMicroblogs.viewMicroblogsEntryNone();

		SOContactsCenter.followUser(
			adminEmailAddress = "${adminEmailAddress}",
			adminListName = "${adminListName}",
			adminName = "${adminName}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertClick.assertTextClickAt(
			locator1 = "SOActivities#NAVIGATION_FOLLOWING",
			value1 = "Following"
		);

		SOActivities.viewMicroblogsNotViewableByEveryoneActivityEntry(
			userFirstName = "${microblogsEntryAuthorFirstName}",
			userName = "${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}"
		);

		SOMicroblogs.viewMicroblogsEntryNotViewableByEveryone(
			microblogsEntryAuthor = "${microblogsEntryAuthor}",
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryContent = "${microblogsEntryContent}"
		);
	}

	@priority = "5"
	test AddMicroblogsEntryViewableByFollowersComment {
		SOContactsCenter.addFollower(
			adminEmailAddress = "${adminEmailAddress}",
			adminListName = "${adminListName}",
			adminName = "${adminName}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userListName = "${userListName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntry(
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryViewableBy = "Followers"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MICROBLOGS",
			value1 = "Microblogs"
		);

		SOMicroblogs.addMicroblogsEntryComment(
			microblogsEntryCommentContent = "${microblogsEntryCommentContent}",
			microblogsEntryContent = "${microblogsEntryContent}"
		);

		SOMicroblogs.viewMicroblogsEntryNotViewableByEveryone(
			commentCount = "1",
			microblogsEntryAuthor = "${microblogsEntryAuthor}",
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryContent = "${microblogsEntryContent}"
		);

		SOMicroblogs.viewMicroblogsEntryComment(
			commentCount = "1",
			microblogsEntryCommentAuthorFirstName = "${userFirstName}",
			microblogsEntryCommentAuthorLastName = "${userLastName}",
			microblogsEntryCommentAuthorMiddleName = "${userMiddleName}",
			microblogsEntryCommentContent = "${microblogsEntryCommentContent}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOMicroblogs.viewOwnMicroblogsEntry(
			commentCount = "1",
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}"
		);

		SOMicroblogs.viewMicroblogsEntryComment(
			commentCount = "1",
			microblogsEntryCommentAuthorFirstName = "${userFirstName}",
			microblogsEntryCommentAuthorLastName = "${userLastName}",
			microblogsEntryCommentAuthorMiddleName = "${userMiddleName}",
			microblogsEntryCommentContent = "${microblogsEntryCommentContent}"
		);

		SOMicroblogs.viewMicroblogsEntryCommentNotification(
			microblogsEntryCommentAuthorFirstName = "${userFirstName}",
			microblogsEntryCommentAuthorLastName = "${userLastName}",
			microblogsEntryCommentAuthorMiddleName = "${userMiddleName}",
			microblogsEntryCommentContent = "${microblogsEntryCommentContent}"
		);
	}

	@priority = "5"
	test DeleteMicroblogsEntry {
		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntry(
			microblogsEntryContent = "${microblogsEntryContent}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MICROBLOGS",
			value1 = "Microblogs"
		);

		SOMicroblogs.deleteMicroblogsEntry();

		AssertTextEquals(
			locator1 = "SOMicroblogs#INFO_MESSAGE",
			value1 = "You do not have any microblog entries."
		);

		AssertElementNotPresent(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT",
			value1 = "${microblogsEntryContent}"
		);
	}

	@priority = "5"
	test RepostMicroblogsEntry {
		SOUser.addUserWithSORole(
			adminEmailAddress = "${adminEmailAddress}",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntry(
			microblogsEntryContent = "${microblogsEntryContent}"
		);

		SOMicroblogs.viewOwnMicroblogsEntry(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryContent = "${microblogsEntryContent}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOMicroblogs.repostMicroblogsEntry(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryContent = "${microblogsEntryContent}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertClick(locator1 = "SOActivities#NAVIGATION_ME", value1 = "Me");

		SOActivities.viewMicroblogsRepostActivityEntry(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryRepostAuthorFirstName = "${userFirstName}",
			microblogsEntryRepostAuthorLastName = "${userLastName}",
			microblogsEntryRepostAuthorMiddleName = "${userMiddleName}"
		);

		SOMicroblogs.viewOwnMicroblogsRepost(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryRepostAuthorFirstName = "${userFirstName}",
			microblogsEntryRepostAuthorLastName = "${userLastName}",
			microblogsEntryRepostAuthorMiddleName = "${userMiddleName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOActivities.viewMicroblogsActivityEntryProfile(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryContent = "${microblogsEntryContent}"
		);

		SOActivities.viewMicroblogsRepostActivityEntryProfile(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryRepostAuthorFirstName = "${userFirstName}",
			microblogsEntryRepostAuthorLastName = "${userLastName}",
			microblogsEntryRepostAuthorMiddleName = "${userMiddleName}",
			profileScreenName = "${userScreenName}"
		);

		Click(locator1 = "SOProfile#NAVIGATION_MICROBLOGS");

		SOMicroblogs.viewMicroblogsEntryAuthor(
			microblogsEntryAuthorFirstName = "${microblogsEntryAuthorFirstName}",
			microblogsEntryAuthorLastName = "${microblogsEntryAuthorLastName}",
			microblogsEntryRepostAuthorFirstName = "${userFirstName}",
			microblogsEntryRepostAuthorLastName = "${userLastName}",
			microblogsEntryRepostAuthorMiddleName = "${userMiddleName}"
		);

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT",
			value1 = "${microblogsEntryContent}"
		);
	}

	@priority = "5"
	test ViewMicroblogsTimeline {
		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntry(
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryViewableBy = "Connections",
			number = "01"
		);

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntry(
			microblogsEntryContent = "${microblogsEntryContent}",
			microblogsEntryViewableBy = "Followers",
			number = "02"
		);

		SOMicroblogs.gotoMicroblogsContentField();

		SOMicroblogs.addMicroblogsEntry(
			microblogsEntryContent = "${microblogsEntryContent}",
			number = "03"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MICROBLOGS",
			value1 = "Microblogs"
		);

		AssertClick.assertTextClickAt(
			locator1 = "SOMicroblogs#TAB_TIMELINE",
			value1 = "Timeline"
		);

		Pause(value1 = "1000");

		var number = "01";

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_AUTHOR_INCREMENT",
			value1 = "${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}"
		);

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_INCREMENT",
			value1 = "${microblogsEntryContent}${number}"
		);

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_LINK_INCREMENT",
			value1 = "Comment"
		);

		var number = "02";

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_AUTHOR_INCREMENT",
			value1 = "${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}"
		);

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_INCREMENT",
			value1 = "${microblogsEntryContent}${number}"
		);

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_LINK_INCREMENT",
			value1 = "Comment"
		);

		var number = "03";

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_AUTHOR_INCREMENT",
			value1 = "${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}"
		);

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_CONTENT_INCREMENT",
			value1 = "${microblogsEntryContent}${number}"
		);

		AssertTextEquals(
			locator1 = "SOMicroblogs#MICROBLOGS_ENTRY_COMMENT_LINK_INCREMENT",
			value1 = "Comment"
		);
	}

	tearDown {
		SOMicroblogs.tearDownMicroblogsEntry();

		SOUser.tearDownCP();

		SOUserBar.tearDownNotifications();
	}
}