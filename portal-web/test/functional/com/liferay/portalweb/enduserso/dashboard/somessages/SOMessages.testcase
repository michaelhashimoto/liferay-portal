	@priority = "5"
	test SendMessagePortal {
		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");

		Page.gotoPG(pageName = "${pageName}");

		var key_recipientName = "${userName}";

		SOMessages.sendMessage(
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}",
			recipientName = "${userName}",
			recipientScreenName = "${userScreenName}",
			userName = "${adminName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		SOMessages.viewMessage(
			connectionName = "${userName}",
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}",
			senderName = "${adminName}",
			userName = "${adminName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		Page.gotoPG(pageName = "${pageName}");

		SOMessages.viewMessage(
			connectionName = "${adminName}",
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}",
			senderName = "${adminName}",
			userName = "${userName}"
		);
	}

	@priority = "5"
	test SendReplyMessage {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		var key_recipientName = "${userName}";

		SOMessages.sendMessage(
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}",
			recipientName = "${userName}",
			recipientScreenName = "${userScreenName}",
			userName = "${adminName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOMessages.viewMessageNotification(
			messageBody = "${messageBody}",
			senderName = "${adminName}"
		);

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		SOMessages.viewMessage(
			connectionName = "${adminName}",
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}",
			senderName = "${adminName}",
			userName = "${userName}"
		);

		SOMessages.sendReplyMessage(messageReplyBody = "${messageReplyBody}");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		SOMessages.viewReplyMessage(
			connectionName = "${adminName}",
			messageBody = "${messageBody}",
			messageReplyBody = "${messageReplyBody}",
			messageSubject = "${messageSubject}",
			replySenderName = "${userName}",
			senderName = "${adminName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOMessages.viewMessageNotification(
			messageBody = "${messageReplyBody}",
			senderName = "${userName}"
		);

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		SOMessages.viewReplyMessage(
			connectionName = "${userName}",
			messageBody = "${messageBody}",
			messageReplyBody = "${messageReplyBody}",
			messageSubject = "${messageSubject}",
			replySenderName = "${userName}",
			senderName = "${adminName}"
		);
	}

