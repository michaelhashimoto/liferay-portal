@component-name = "social-office-dashboard"
definition {
	property hook.plugins.includes = "deploy-listener-hook,portal-compat-hook,so-activities-hook,so-hook";
	property portlet.plugins.includes = "chat-portlet,contacts-portlet,events-display-portlet,microblogs-portlet,private-messaging-portlet,so-announcements-portlet,so-configurations-portlet,so-portlet,tasks-portlet,wysiwyg-portlet";
	property testray.main.component.name = "Social Office EE";
	property theme.plugins.includes = "so-theme";
	var adminEmailAddress = "test@liferay.com";
	var adminName = "Joe Bloggs";
	var attachmentFile = "Document_1.jpg";
	var messageBody = "Message Body";
	var messageReplyBody = "Message Reply Body";
	var messageSubject = "Message Subject";
	var pageName = "Private Messaging Page";
	var password = "test";
	var portletName = "Private Messaging";
	var userEmailAddress = "socialoffice01@liferay.com";
	var userEmailAddress2 = "socialoffice02@liferay.com";
	var userFirstName = "Social01";
	var userFirstName2 = "Social02";
	var userLastName = "User01";
	var userLastName2 = "User02";
	var userListName = "User01, Social01";
	var userListName2 = "User02, Social02";
	var userMiddleName = "Office01";
	var userMiddleName2 = "Office02";
	var userName = "Social01 Office01 User01";
	var userName2 = "Social02 Office02 User02";
	var userScreenName = "socialoffice01";
	var userScreenName2 = "socialoffice02";

	setUp {
		SOUser.firstLoginPG();

		SOContactsCenter.addConnection(
			adminEmailAddress = "${adminEmailAddress}",
			senderName = "${adminName}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userListName = "${userListName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");
	}

	tearDown {
		SOMessages.tearDownPG();

		SOUserBar.tearDownNotifications();

		SOUser.tearDownCP();

		Page.tearDownPG();
	}

	@priority = "5"
	test DeleteMessage {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		var key_recipientName = "${userName}";

		SOMessages.sendMessage(
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}",
			recipientName = "${userName}",
			recipientScreenName = "${userScreenName}",
			userName = "${adminName}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		SOMessages.viewMessageList(
			connectionName = "${userName}",
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}"
		);

		Check(locator1 = "SOMessages#MESSAGE_CHECKBOX");

		AssertClick.assertValueClickAt(
			locator1 = "SOMessages#DELETE_BUTTON",
			value1 = "Delete"
		);

		AssertTextEquals(
			locator1 = "SOMessages#INFO_MESSAGE",
			value1 = "No messages found."
		);
	}

	@priority = "5"
	test DeleteMessageBySOUser {
		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		var key_recipientName = "${userName}";

		SOMessages.sendMessage(
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}",
			recipientName = "${userName}",
			recipientScreenName = "${userScreenName}",
			userName = "${adminName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		SOMessages.viewMessage(
			connectionName = "${adminName}",
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}",
			senderName = "${adminName}",
			userName = "${userName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "SOMessagesMessage#DELETE_BUTTON",
			value1 = "Delete"
		);

		AssertTextEquals(
			locator1 = "SOMessagesMessage#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		AssertTextEquals(
			locator1 = "SOMessagesMessage#INFO_MESSAGE",
			value1 = "No messages found."
		);

		AssertTextNotPresent(value1 = "${messageSubject}");
	}

	@priority = "5"
	test DeleteMessageBySOUser2 {
		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "${userEmailAddress2}",
			userFirstName = "${userFirstName2}",
			userLastName = "${userLastName2}",
			userMiddleName = "${userMiddleName2}",
			userScreenName = "${userScreenName2}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOContactsCenter.requestToConnect(
			userEmailAddress = "${userEmailAddress2}",
			userListName = "${userListName2}",
			userName = "${userName2}",
			userScreenName = "${userScreenName2}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress2}");

		SOContactsCenter.confirmRequestToConnect(
			senderName = "${userName}",
			userName = "${userName2}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		var key_recipientName = "${userName}";

		SOMessages.sendMessage(
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}",
			recipientName = "${userName2}",
			recipientScreenName = "${userScreenName2}",
			userName = "${userName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress2}");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		SOMessages.viewMessage(
			connectionName = "${userName}",
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}",
			senderName = "${userName}",
			userName = "${userName2}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		SOMessages.viewMessageList(
			connectionName = "${userName}",
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}"
		);

		var senderName = "${userName}";

		Check(locator1 = "SOMessages#MESSAGE_CHECKBOX");

		AssertClick.assertValueClickAt(
			locator1 = "SOMessages#DELETE_BUTTON",
			value1 = "Delete"
		);

		AssertTextEquals(
			locator1 = "SOMessages#INFO_MESSAGE",
			value1 = "No messages found."
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		AssertTextEquals(
			locator1 = "SOMessages#INFO_MESSAGE",
			value1 = "No messages found."
		);

		AssertTextNotPresent(value1 = "Message Subject");

		AssertTextNotPresent(value1 = "Message Body");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertElementPresent.assertElementPresent(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "0");

		AssertTextNotPresent(value1 = "${senderName} sent you a message.");

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MESSAGES",
			value1 = "Messages"
		);

		SOMessages.viewMessage(
			connectionName = "${userName2}",
			messageBody = "${messageBody}",
			messageSubject = "${messageSubject}",
			senderName = "${userName}",
			userName = "${userName}"
		);
	}

