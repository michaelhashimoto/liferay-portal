			locator1 = "SODashboard#NAVIGATION_MY_DOCUMENTS",
			value1 = "My Documents"
		);

		DMFolderDocument.saveAsDraftPG();

		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MY_DOCUMENTS",
			value1 = "My Documents"
		);

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		SODocuments.viewPGDisplayView(workflow = "Draft");
	}

	@priority = "5"
	test SaveAsDraftEditDMFolderDocument {
		var dmDocumentDescription = "${dmDocumentDescription}";
		var dmDocumentDescriptionEdit = "${dmDocumentDescriptionEdit}";
		var dmDocumentFile = "${dmDocumentFile}";
		var dmDocumentSize = "${dmDocumentSize}";
		var dmDocumentTitle = "${dmDocumentTitle}";
		var dmDocumentTitleEdit = "${dmDocumentTitleEdit}";
		var dmDocumentUploader = "${dmDocumentUploader}";
		var dmDocumentVersionNumber = "${dmDocumentVersionNumber}";
		var dmDocumentVersionNumberEdit = "${dmDocumentVersionNumberEdit}";
		var dmFolderDescription = "${dmFolderDescription}";
		var dmFolderName = "${dmFolderName}";
		var key_siteName = "${key_siteName}";
		var pageName = "${pageName}";
		var pageType = "${pageType}";
		var siteName = "${siteName}";

		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MY_DOCUMENTS",
			value1 = "My Documents"
		);

		DMFolder.addPG();

		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MY_DOCUMENTS",
			value1 = "My Documents"
		);

		DMFolderDocument.addPG();

		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MY_DOCUMENTS",
			value1 = "My Documents"
		);

		DMFolderDocument.saveAsDraftEditDMFolderDocument();

		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MY_DOCUMENTS",
			value1 = "My Documents"
		);

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		DMFolderDocument.viewSaveAsDraftEditDMFolderDocumentPG(
			versionNumber = "${dmDocumentVersionNumberEdit}"
		);
	}
}