@component-name = "social-office-dashboard"
definition {
	property testray.main.component.name = "Social Office EE";
	var dmDocumentDescription = "DM Folder Document Description";
	var dmDocumentDescriptionEdit = "DM Folder Document Description Edit";
	var dmDocumentFile = "Document_1.doc";
	var dmDocumentFile2 = "Document_2.doc";
	var dmDocumentSize = "21.5k";
	var dmDocumentSize2 = "22.5k";
	var dmDocumentTitle = "DM Folder Document Title";
	var dmDocumentTitleEdit = "DM Folder Document Title Edit";
	var dmDocumentUploader = "Joe Bloggs";
	var dmDocumentVersionNumber = "1.0";
	var dmDocumentVersionNumberEdit = "1.1";
	var dmDocumentVersionNumberEdit2 = "2.0";
	var dmFolderDescription = "DM Folder Description";
	var dmFolderName = "DM Folder Name";
	var dmImageDescription = "DM Folder Image Description";
	var dmImageDescriptionEdit = "DM Folder Image Description Edit";
	var dmImageFile = "Document_1.jpeg";
	var dmImageFile2 = "Document_2.jpeg";
	var dmImageSize = "15.0k";
	var dmImageSize2 = "22.0k";
	var dmImageTitle = "DM Folder Image Title";
	var dmImageTitleEdit = "DM Folder Image Title Edit";

	setUp {
		SOUser.firstLoginPG();
	}

	tearDown {
		SODocuments.tearDownPG();
	}

	@priority = "5"
	test AddDMFolderImage {
		var dmDocumentDescription = "${dmImageDescription}";
		var dmDocumentFile = "${dmImageFile}";
		var dmDocumentSize = "${dmImageSize}";
		var dmDocumentTitle = "${dmImageTitle}";
		var dmDocumentUploader = "${dmDocumentUploader}";
		var dmFolderDescription = "${dmFolderDescription}";
		var dmFolderName = "${dmFolderName}";
		var key_siteName = "${key_siteName}";
		var pageName = "${pageName}";
		var siteName = "${siteName}";

		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MY_DOCUMENTS",
			value1 = "My Documents"
		);

		DMFolder.addPG();

		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MY_DOCUMENTS",
			value1 = "My Documents"
		);

		DMFolderDocument.addPG();

		SOUserBar.dashboardPG(userName = "Joe Bloggs");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_MY_DOCUMENTS",
			value1 = "My Documents"
		);

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		DMFolderDocument.viewPG(versionNumber = "${dmDocumentVersionNumber}");
	}

