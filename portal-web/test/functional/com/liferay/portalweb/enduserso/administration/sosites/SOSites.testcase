	@priority = "5"
	test AddSOSitesOpen {
		var siteDescription1 = "Open Site1 Description";
		var siteDescription2 = "Open Site2 Description";
		var siteDescription3 = "Open Site3 Description";
		var siteName1 = "Open Site1 Name";
		var siteName2 = "Open Site2 Name";
		var siteName3 = "Open Site3 Name";
		var siteType1 = "Open";
		var siteType2 = "Open";
		var siteType3 = "Open";

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription1}",
			siteName = "${siteName1}",
			siteType = "${siteType1}"
		);

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription2}",
			siteName = "${siteName2}",
			siteType = "${siteType2}"
		);

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription3}",
			siteName = "${siteName3}",
			siteType = "${siteType3}"
		);
	}

	@priority = "5"
	test ConfirmInviteSOSiteOpen {
		var siteDescription = "Open Site Description";
		var siteName = "Open Site Name";
		var siteType = "Open";

		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription}",
			siteName = "${siteName}",
			siteType = "${siteType}"
		);

		SOUserBar.searchSOSite(siteName = "${siteName}");

		Click(locator1 = "SOUserBar#GO_TO_SITE_NAME_LINK");

		Click.textClickAt(
			locator1 = "SOSiteHome#NAVIGATION_MEMBERS",
			value1 = "Members"
		);

		SOMembers.inviteMember(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOMembers.confirmMemberInvite(senderName = "${adminName}");

		SOSite.viewSOSiteMembership(
			siteDescription = "${siteDescription}",
			siteName = "${siteName}",
			siteType = "${siteType}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userListName = "${userListName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);
	}

