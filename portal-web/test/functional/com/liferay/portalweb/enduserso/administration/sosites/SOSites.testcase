	@priority = "5"
	test ViewSOSiteDirectory {
		var siteDescription1 = "Open Site1 Description";
		var siteDescription2 = "Public Restricted Site2 Description";
		var siteDescription3 = "Private Site3 Description";
		var siteDescription4 = "Private Restricted Site4 Description";
		var siteName1 = "Open Site1 Name";
		var siteName2 = "Public Restricted Site2 Name";
		var siteName3 = "Private Site3 Name";
		var siteName4 = "Private Restricted Site4 Name";
		var siteType1 = "Open";
		var siteType2 = "Public Restricted";
		var siteType3 = "Private";
		var siteType4 = "Private Restricted";

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription1}",
			siteName = "${siteName1}",
			siteType = "${siteType1}"
		);

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription2}",
			siteName = "${siteName2}",
			siteType = "${siteType2}"
		);

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription3}",
			siteName = "${siteName3}",
			siteType = "${siteType3}"
		);

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription4}",
			siteName = "${siteName4}",
			siteType = "${siteType4}"
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO_SITES_DIRECTORY_BUTTON");

		Select(
			locator1 = "SOUserBarSitesDirectory#SITE_CATEGORY_SELECT",
			value1 = "All Sites"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK_1",
			value1 = "${siteName1}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION_1",
			value1 = "${siteDescription1}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK_2",
			value1 = "${siteName2}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION_2",
			value1 = "${siteDescription2}"
		);

		AssertElementNotPresent(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK_3",
			value1 = "${siteName3}"
		);

		AssertElementNotPresent(
			locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION_3",
			value1 = "${siteDescription3}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK_4",
			value1 = "${siteName4}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION_4",
			value1 = "${siteDescription4}"
		);

		Select(
			locator1 = "SOUserBarSitesDirectory#SITE_CATEGORY_SELECT",
			value1 = "My Sites"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK_1",
			value1 = "${siteName1}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION_1",
			value1 = "${siteDescription1}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK_2",
			value1 = "${siteName2}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION_2",
			value1 = "${siteDescription2}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK_3",
			value1 = "${siteName3}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION_3",
			value1 = "${siteDescription3}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK_4",
			value1 = "${siteName4}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION_4",
			value1 = "${siteDescription4}"
		);

		var siteName = "${siteName1}";

		Type(
			locator1 = "SOUserBarSitesDirectory#SITE_SEARCH_FIELD",
			value1 = "${siteName1}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName1}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION",
			value1 = "${siteDescription1}"
		);

		Click(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName1}"
		);

		AssertTextEquals(locator1 = "SOSiteHome#SITE_NAME", value1 = "${siteName1}");

		var siteName = "${siteName2}";

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO_SITES_DIRECTORY_BUTTON");

		Select(
			locator1 = "SOUserBarSitesDirectory#SITE_CATEGORY_SELECT",
			value1 = "My Sites"
		);

		Type(
			locator1 = "SOUserBarSitesDirectory#SITE_SEARCH_FIELD",
			value1 = "${siteName2}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName2}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION",
			value1 = "${siteDescription2}"
		);

		Click(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName2}"
		);

		AssertTextEquals(locator1 = "SOSiteHome#SITE_NAME", value1 = "${siteName2}");

		var siteName = "${siteName3}";

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO_SITES_DIRECTORY_BUTTON");

		Select(
			locator1 = "SOUserBarSitesDirectory#SITE_CATEGORY_SELECT",
			value1 = "My Sites"
		);

		Type(
			locator1 = "SOUserBarSitesDirectory#SITE_SEARCH_FIELD",
			value1 = "${siteName3}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName3}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION",
			value1 = "${siteDescription3}"
		);

		Click(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName3}"
		);

		AssertTextEquals(locator1 = "SOSiteHome#SITE_NAME", value1 = "${siteName3}");

		var siteName = "${siteName4}";

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO");

		Click.pauseClickAt(locator1 = "SOUserBar#GO_TO_SITES_DIRECTORY_BUTTON");

		Select(
			locator1 = "SOUserBarSitesDirectory#SITE_CATEGORY_SELECT",
			value1 = "My Sites"
		);

		Type(
			locator1 = "SOUserBarSitesDirectory#SITE_SEARCH_FIELD",
			value1 = "${siteName4}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName4}"
		);

		AssertTextEquals(
			locator1 = "SOUserBarSitesDirectory#SITE_DESCRIPTION",
			value1 = "${siteDescription4}"
		);

		Click(
			locator1 = "SOUserBarSitesDirectory#SITE_NAME_LINK",
			value1 = "${siteName4}"
		);

		AssertTextEquals(locator1 = "SOSiteHome#SITE_NAME", value1 = "${siteName4}");
	}
