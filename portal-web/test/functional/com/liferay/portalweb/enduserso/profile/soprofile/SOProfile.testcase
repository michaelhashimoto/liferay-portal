@component-name = "social-office-profile"
definition {
	property hook.plugins.includes = "deploy-listener-hook,portal-compat-hook,so-activities-hook,so-hook";
	property portlet.plugins.includes = "chat-portlet,contacts-portlet,events-display-portlet,microblogs-portlet,private-messaging-portlet,so-announcements-portlet,so-configurations-portlet,so-portlet,tasks-portlet,wysiwyg-portlet";
	property testray.main.component.name = "Social Office EE";
	property theme.plugins.includes = "so-theme";
	var adminEmailAddress = "test@liferay.com";
	var adminListName = "Bloggs, Joe";
	var adminName = "Joe Bloggs";
	var password = "test";
	var userEmailAddress = "socialoffice01@liferay.com";
	var userFirstName = "Social01";
	var userLastName = "User01";
	var userListName = "User01, Social01";
	var userMiddleName = "Office01";
	var userName = "Social01 Office01 User01";
	var userScreenName = "socialoffice01";

	setUp {
		SOUser.firstLoginPG();

		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");
	}

	tearDown {
		SOUser.tearDownCP();

		SOUserBar.tearDownNotifications();
	}

	@priority = "5"
	test AddAdditionalEmailAddress {
		var userAdditionalEmailAddress = "socialoffice02@liferay.com";

		SOProfile.addAdditionalEmailAddressProfile(
			userAdditionalEmailAddress = "${userAdditionalEmailAddress}"
		);

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewAdditionalEmailAddressProfile(
			userAdditionalEmailAddress = "${userAdditionalEmailAddress}"
		);
	}

	@priority = "5"
	test AddAddress {
		var userAddressCity = "Ray of Light";
		var userAddressCountry = "United States";
		var userAddressPostalCode = "91234";
		var userAddressRegion = "California";
		var userAddressStreet1 = "123 Liferay Ln.";
		var userAddressType = "Personal";

		SOProfile.addAddressProfile(
			userAddressCity = "${userAddressCity}",
			userAddressCountry = "${userAddressCountry}",
			userAddressPostalCode = "${userAddressPostalCode}",
			userAddressRegion = "${userAddressRegion}",
			userAddressStreet1 = "${userAddressStreet1}",
			userAddressType = "${userAddressType}"
		);

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewAddressProfile(
			userAddressCity = "${userAddressCity}",
			userAddressCountry = "${userAddressCountry}",
			userAddressPostalCode = "${userAddressPostalCode}",
			userAddressRegion = "${userAddressRegion}",
			userAddressStreet1 = "${userAddressStreet1}",
			userAddressType = "${userAddressType}"
		);
	}

	@priority = "5"
	test AddCCConnectionProfile {
		var filterTypeCount = "1";
		var roleName = "Social Office";
		var userListName = "${userListName}";
		var userScreenName = "socialoffice01";

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOProfile.addConnection(senderName = "${adminName}");

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOUserBar.dashboardPG(userName = "${userName}");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		SOProfile.viewConnectionProfile(
			filterType = "Connections",
			filterTypeCount = "${filterTypeCount}",
			userEmailAddress = "${adminEmailAddress}",
			userListName = "${adminListName}",
			userName = "${adminName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOUserBar.dashboardPG(userName = "${adminName}");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		SOProfile.viewConnectionProfile(
			filterType = "Connections",
			filterTypeCount = "${filterTypeCount}",
			userEmailAddress = "${userEmailAddress}",
			userListName = "${userListName}",
			userName = "${userName}"
		);
	}

	@priority = "5"
	test AddInstantMessenger {
		var userInstantMessengerAIM = "socialofficesn";
		var userInstantMessengerICQ = "socialofficesn";
		var userInstantMessengerJabber = "socialofficesn";
		var userInstantMessengerSkype = "socialofficesn";
		var userInstantMessengerWindowsLiveMessenger = "socialofficesn";
		var userInstantMessengerYM = "socialofficesn";

		SOProfile.addInstantMessengerProfile(
			userInstantMessengerAIM = "${userInstantMessengerAIM}",
			userInstantMessengerICQ = "${userInstantMessengerICQ}",
			userInstantMessengerJabber = "${userInstantMessengerJabber}",
			userInstantMessengerSkype = "${userInstantMessengerSkype}",
			userInstantMessengerWindowsLiveMessenger = "${userInstantMessengerWindowsLiveMessenger}",
			userInstantMessengerYM = "${userInstantMessengerYM}"
		);

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewInstantMessengerProfile(
			userInstantMessengerAIM = "${userInstantMessengerAIM}",
			userInstantMessengerICQ = "${userInstantMessengerICQ}",
			userInstantMessengerJabber = "${userInstantMessengerJabber}",
			userInstantMessengerSkype = "${userInstantMessengerSkype}",
			userInstantMessengerWindowsLiveMessenger = "${userInstantMessengerWindowsLiveMessenger}",
			userInstantMessengerYM = "${userInstantMessengerYM}"
		);
	}

	@priority = "5"
	test AddIntroduction {
		var userIntroduction = "Introduction Content";

		SOProfile.addIntroductionProfile(userIntroduction = "${userIntroduction}");

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewIntroductionProfile(userIntroduction = "${userIntroduction}");
	}

	@priority = "5"
	test AddPhoneNumbers {
		var userPhoneNumberExtension = "123";
		var userPhoneNumberNumber = "123-123-1234";
		var userPhoneNumberType = "Business";

		SOProfile.addPhoneNumbersProfile(
			userPhoneNumberExtension = "${userPhoneNumberExtension}",
			userPhoneNumberNumber = "${userPhoneNumberNumber}",
			userPhoneNumberType = "${userPhoneNumberType}"
		);

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewPhoneNumbersProfile(
			userPhoneNumberExtension = "${userPhoneNumberExtension}",
			userPhoneNumberNumber = "${userPhoneNumberNumber}",
			userPhoneNumberType = "${userPhoneNumberType}"
		);
	}

	@priority = "5"
	test AddProjects {
		var userProjectDescription = "Expertise Description";
		var userProjectTitle = "Expertise Title";

		SOProfile.addProjectsProfile(
			userProjectDescription = "${userProjectDescription}",
			userProjectTitle = "${userProjectTitle}"
		);

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewProjectsProfile(
			userProjectDescription = "${userProjectDescription}",
			userProjectTitle = "${userProjectTitle}"
		);
	}

	@priority = "5"
	test AddSMS {
		var userSMS = "socialoffice@liferay.com";

		SOProfile.addSMSProfile(userSMS = "${userSMS}");

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewSMSProfile(userSMS = "${userSMS}");
	}

	@priority = "5"
	test AddSocialNetwork {
		var userSocialNetworkFacebook = "socialoffice01";
		var userSocialNetworkMyspace = "socialoffice01";
		var userSocialNetworkTwitter = "socialoffice01";

		SOProfile.addSocialNetworkProfile(
			userSocialNetworkFacebook = "${userSocialNetworkFacebook}",
			userSocialNetworkMyspace = "${userSocialNetworkMyspace}",
			userSocialNetworkTwitter = "${userSocialNetworkTwitter}"
		);

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewSocialNetworkProfile(
			userSocialNetworkFacebook = "${userSocialNetworkFacebook}",
			userSocialNetworkMyspace = "${userSocialNetworkMyspace}",
			userSocialNetworkTwitter = "${userSocialNetworkTwitter}"
		);
	}

	@priority = "5"
	test AddTag {
		var userTag = "tag1";

		SOProfile.addTagProfile(userTag = "${userTag}");

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewTagProfile(userTag = "${userTag}");
	}

	@priority = "5"
	test AddWebsite {
		var userWebsiteType = "Personal";
		var userWebsiteURL = "http://www.socialoffice01.com";

		SOProfile.addWebsiteProfile(
			userWebsiteType = "${userWebsiteType}",
			userWebsiteURL = "${userWebsiteURL}"
		);

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewWebsiteProfile(
			userWebsiteType = "${userWebsiteType}",
			userWebsiteURL = "${userWebsiteURL}"
		);
	}

	@priority = "5"
	test DisconnectCCConnectionProfile {
		var filterTypeCount = "1";
		var roleName = "Social Office";
		var userListName = "${userListName}";
		var userScreenName = "socialoffice01";

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOProfile.addConnection(senderName = "${adminName}");

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOUserBar.dashboardPG(userName = "${userName}");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		SOProfile.viewConnectionProfile(
			filterType = "Connections",
			filterTypeCount = "${filterTypeCount}",
			userEmailAddress = "${adminEmailAddress}",
			userListName = "${adminListName}",
			userName = "${adminName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOUserBar.dashboardPG(userName = "${adminName}");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		SOProfile.viewConnectionProfile(
			filterType = "Connections",
			filterTypeCount = "${filterTypeCount}",
			userEmailAddress = "${userEmailAddress}",
			userListName = "${userListName}",
			userName = "${userName}"
		);

		SOUserBar.dashboardPG(userName = "${adminName}");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		SOProfile.disconnectFromConnection(
			filterType = "Connections",
			filterTypeCount = "0",
			userEmailAddress = "${userEmailAddress}",
			userListName = "${userListName}",
			userName = "${userName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOUserBar.dashboardPG(userName = "${userName}");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		SOProfile.viewNoConnection(
			adminEmailAddress = "${adminEmailAddress}",
			adminListName = "${adminListName}",
			adminName = "${adminName}",
			filterTypeCount = "0",
			userEmailAddress = "${userEmailAddress}",
			userListName = "${userListName}",
			userName = "${userName}"
		);
	}

	@priority = "5"
	test SearchConnectionProfile {
		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOUserBar.gotoProfile(userName = "${adminName}");

		AssertTextEquals(
			locator1 = "SOProfile#CONTACTS_INFO_MESSAGE",
			value1 = "${adminName} has no contacts."
		);

		AssertTextNotPresent(value1 = "${userName}");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${userFirstName}"
		);

		Select(
			locator1 = "SOContactscenter#CONTACTS_LIST_FILTER",
			value1 = "Connections"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_EMPTY",
			value1 = "There are no results."
		);

		SOProfile.requestToConnect(
			userEmailAddress = "${userEmailAddress}",
			userListName = "${userListName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOContactsCenter.ignoreRequestToConnect(
			senderName = "${adminName}",
			userName = "${userName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOUserBar.gotoProfile(userName = "${adminName}");

		AssertTextEquals(
			locator1 = "SOProfile#CONTACTS_INFO_MESSAGE",
			value1 = "${adminName} has no contacts."
		);

		AssertTextNotPresent(value1 = "${userName}");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${userFirstName}"
		);

		Select(
			locator1 = "SOContactscenter#CONTACTS_LIST_FILTER",
			value1 = "Connections"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_EMPTY",
			value1 = "There are no results."
		);

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${userFirstName}"
		);

		Select(locator1 = "SOContactscenter#CONTACTS_LIST_FILTER", value1 = "All");

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_EMAIL",
			value1 = "${userEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONNECTIONS_LINK",
			value1 = "You have 0 connections."
		);

		Pause(value1 = "1000");

		Click(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_EMAIL",
			value1 = "${userEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONNECT_BUTTON",
			value1 = "Connect"
		);

		AssertElementNotPresent.assertNotVisible(
			locator1 = "SOContactscenter#DISCONNECT_BUTTON"
		);

		SOProfile.requestToConnect(
			userEmailAddress = "${userEmailAddress}",
			userListName = "${userListName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOContactsCenter.confirmRequestToConnect(
			senderName = "${adminName}",
			userName = "${userName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		SOUserBar.gotoProfile(userName = "${adminName}");

		AssertTextEquals(locator1 = "SOProfile#CONTACTS_NAME", value1 = "${userName}");

		AssertTextNotPresent(value1 = "${adminName} has no contacts.");

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		Click.textClickAt(
			locator1 = "SODashboard#NAVIGATION_CONTACTS_CENTER",
			value1 = "Contacts Center"
		);

		Type(
			locator1 = "SOContactscenter#CONTACTS_LIST_SEARCH",
			value1 = "${userFirstName}"
		);

		Select(
			locator1 = "SOContactscenter#CONTACTS_LIST_FILTER",
			value1 = "Connections"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONTACTS_LIST_EMAIL",
			value1 = "${userEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#CONNECTIONS_LINK",
			value1 = "You have 1 connections."
		);

		Pause(value1 = "1000");

		Click(
			locator1 = "SOContactscenter#CONTACTS_LIST_NAME",
			value1 = "${userListName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#USER_DETAILS_EMAIL",
			value1 = "${userEmailAddress}"
		);

		AssertTextEquals(
			locator1 = "SOContactscenter#DISCONNECT_BUTTON",
			value1 = "Disconnect"
		);

		AssertElementNotPresent.assertNotVisible(
			locator1 = "SOContactscenter#CONNECT_BUTTON"
		);
	}
}