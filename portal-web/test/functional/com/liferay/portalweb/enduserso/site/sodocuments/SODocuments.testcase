		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolder.addPG();

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolderDocument.saveAsDraftPG();

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolderDocument.publishDraftDMFolderDocument();

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		DMFolderDocument.viewPG(versionNumber = "${dmDocumentVersionNumber}");
	}

	@priority = "5"
	test SaveAndCheckinMajorDMFolderDocument {
		var dmDocumentFile = "${dmDocumentFile}";
		var dmDocumentSize = "${dmDocumentSize}";
		var dmDocumentTitle = "${dmDocumentTitle}";
		var dmDocumentDescription = "${dmDocumentDescription}";
		var dmDocumentUploader = "${dmDocumentUploader}";
		var dmFolderDescription = "${dmFolderDescription}";
		var dmFolderName = "${dmFolderName}";
		var key_siteName = "${key_siteName}";
		var pageName = "${pageName}";
		var pageType = "${pageType}";
		var siteName = "${siteName}";

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolder.addPG();

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolderDocument.addPG();

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolderDocument.checkoutPG();

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolderDocument.editPG(changeLog = "Major Revision", revision = "Major");

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		SODocuments.viewPGDisplayView(
			dmDocumentDescription = "${dmDocumentDescriptionEdit}",
			dmDocumentPreviousDescription = "${dmDocumentDescription}",
			dmDocumentPreviousSize = "${dmDocumentSize}",
			dmDocumentPreviousTitle = "${dmDocumentTitle}",
			dmDocumentPreviousUploader = "${dmDocumentUploader}",
			dmDocumentPreviousVersionNumber = "${dmDocumentVersionNumber}",
			dmDocumentSize = "${dmDocumentSize2}",
			dmDocumentTitle = "${dmDocumentTitleEdit}",
			dmDocumentUploader = "${dmDocumentUploader}",
			dmDocumentVersionNumber = "${dmDocumentVersionNumberEdit2}"
		);
	}

