	@priority = "5"
	test EditDMFolderDocument {
		var dmDocumentDescription = "${dmDocumentDescription}";
		var dmDocumentDescriptionEdit = "${dmDocumentDescriptionEdit}";
		var dmDocumentFile = "${dmDocumentFile}";
		var dmDocumentSize = "${dmDocumentSize}";
		var dmDocumentTitle = "${dmDocumentTitle}";
		var dmDocumentTitleEdit = "${dmDocumentTitleEdit}";
		var dmDocumentUploader = "${dmDocumentUploader}";
		var dmDocumentVersionNumber = "${dmDocumentVersionNumber}";
		var dmDocumentVersionNumberEdit = "${dmDocumentVersionNumberEdit}";
