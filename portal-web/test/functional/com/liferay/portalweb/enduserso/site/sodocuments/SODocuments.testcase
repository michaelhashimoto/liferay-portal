	@priority = "5"
	test ViewCheckoutDMFolderDocumentSOUser {
		var dmDocumentDescription = "${dmDocumentDescription}";
		var dmDocumentFile = "${dmDocumentFile}";
		var dmDocumentSize = "${dmDocumentSize}";
		var dmDocumentTitle = "${dmDocumentTitle}";
		var dmDocumentUploader = "${dmDocumentUploader}";
		var dmFolderDescription = "${dmFolderDescription}";
		var dmFolderName = "${dmFolderName}";
		var key_siteName = "${key_siteName}";
		var pageName = "${pageName}";
		var pageType = "${pageType}";
		var siteName = "${siteName}";
		var userEmailAddress = "socialoffice01@liferay.com";
		var userFirstName = "Social01";
		var userLastName = "User01";
		var userMiddleName = "Office01";
		var userScreenName = "socialoffice01";

		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "${password}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolder.addPG();

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolderDocument.addPG();

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolderDocument.checkoutPG();

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		SOSite.joinSitePG(siteName = "${siteName}");

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		SODocuments.viewPGDisplayView(workflow = "Locked");
	}

	@priority = "5"
	test ViewDraftDMFolderDocumentSOUser {
		var dmDocumentDescription = "${dmDocumentDescription}";
		var dmDocumentFile = "${dmDocumentFile}";
		var dmDocumentSize = "${dmDocumentSize}";
		var dmDocumentTitle = "${dmDocumentTitle}";
		var dmDocumentUploader = "${dmDocumentUploader}";
		var dmFolderDescription = "${dmFolderDescription}";
		var dmFolderName = "${dmFolderName}";
		var key_siteName = "${key_siteName}";
		var pageName = "${pageName}";
		var pageType = "${pageType}";
		var siteName = "${siteName}";
		var userEmailAddress = "socialoffice01@liferay.com";
		var userFirstName = "Social01";
		var userLastName = "User01";
		var userMiddleName = "Office01";
		var userScreenName = "socialoffice01";

		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "${password}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolder.addPG();

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolderDocument.saveAsDraftPG();

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		SOSite.joinSitePG(siteName = "${siteName}");

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		AssertTextEquals(
			locator1 = "PGDocumentsandmedia#PORTLET_INFO_MESSAGE",
			value1 = "There are no documents or media files in this folder."
		);
	}

	@priority = "5"
	test ViewDraftEditDMFolderDocumentSOUser {
		var dmDocumentDescription = "${dmDocumentDescription}";
		var dmDocumentDescriptionEdit = "${dmDocumentDescriptionEdit}";
		var dmDocumentFile = "${dmDocumentFile}";
		var dmDocumentSize = "${dmDocumentSize}";
		var dmDocumentTitle = "${dmDocumentTitle}";
		var dmDocumentTitleEdit = "${dmDocumentTitleEdit}";
		var dmDocumentUploader = "${dmDocumentUploader}";
		var dmDocumentVersionNumber = "${dmDocumentVersionNumber}";
		var dmDocumentVersionNumberEdit = "${dmDocumentVersionNumberEdit}";
		var dmFolderDescription = "${dmFolderDescription}";
		var dmFolderName = "${dmFolderName}";
		var key_siteName = "${key_siteName}";
		var pageName = "${pageName}";
		var pageType = "${pageType}";
		var siteName = "${siteName}";
		var userEmailAddress = "socialoffice01@liferay.com";
		var userFirstName = "Social01";
		var userLastName = "User01";
		var userMiddleName = "Office01";
		var userScreenName = "socialoffice01";

		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "${password}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolder.addPG();

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolderDocument.addPG();

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		DMFolderDocument.saveAsDraftEditDMFolderDocument();

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		SOSite.joinSitePG(siteName = "${siteName}");

		SONavigation.gotoSiteDocuments(pageType = "Open Site");

		Click(locator1 = "PGDocumentsandmedia#ENTRIES_FOLDER");

		DMFolderDocument.viewPGUser(versionNumber = "${dmDocumentVersionNumber}");
	}
}