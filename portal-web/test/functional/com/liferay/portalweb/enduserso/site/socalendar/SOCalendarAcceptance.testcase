@component-name = "social-office-site"
definition {
	property hook.plugins.includes = "deploy-listener-hook,portal-compat-hook,so-activities-hook,so-hook";
	property portlet.plugins.includes = "chat-portlet,contacts-portlet,events-display-portlet,microblogs-portlet,private-messaging-portlet,so-announcements-portlet,so-configurations-portlet,so-portlet,tasks-portlet,wysiwyg-portlet";
	property testray.main.component.name = "Social Office EE";
	property theme.plugins.includes = "so-theme";
	var eventDescription = "Calendar Event Description";
	var eventDescriptionEdit = "Calendar Event Description Edit";
	var eventTitle = "Calendar Event Title";
	var eventTitleEdit = "Calendar Event Title Edit";
	var key_siteName = "${siteName}";
	var pageName = "Calendar";
	var siteDescription = "Open Site Description";
	var siteName = "Open Site Name";
	var siteType = "Open";
	var userName = "Joe Bloggs";

	setUp {
		SOUser.firstLoginPG();

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription}",
			siteName = "${siteName}",
			siteType = "${siteType}"
		);
	}

	@priority = "5"
	test AddCalendarEvent {
		var eventDescription = "${eventDescription}";
		var eventTitle = "${eventTitle}";

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.addPG();

		Page.openURL(pageType = "Open Site");

		AssertTextEquals(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE",
			value1 = "${eventTitle}"
		);

		AssertElementPresent(
			locator1 = "SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TIME"
		);

		Click(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE",
			value1 = "${eventTitle}"
		);

		Event.viewDetailsPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.viewPG();
	}

	@priority = "5"
	test DeleteCalendarEvent {
		var eventDescription = "${eventDescription}";
		var eventTitle = "${eventTitle}";

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.addPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.deletePG();
	}

	@priority = "5"
	test EditCalendarEvent {
		var eventDescription = "${eventDescription}";
		var eventDescriptionEdit = "${eventDescriptionEdit}";
		var eventTitle = "${eventTitle}";
		var eventTitleEdit = "${eventTitleEdit}";

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.addPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.editPG();

		Page.openURL(pageType = "Open Site");

		AssertTextEquals(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE",
			value1 = "${eventTitleEdit}"
		);

		AssertElementPresent(
			locator1 = "SODashboard#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TIME"
		);

		Click(locator1 = "SOSiteHome#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE");

		Event.viewDetailsPG(
			eventDescription = "${eventDescriptionEdit}",
			eventTitle = "${eventTitleEdit}"
		);

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.viewPG(
			eventDescription = "${eventDescriptionEdit}",
			eventTitle = "${eventTitleEdit}"
		);
	}

	tearDown {
		SOUserBar.tearDownSites();
	}
}