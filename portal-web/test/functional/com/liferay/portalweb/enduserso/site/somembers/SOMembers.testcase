@component-name = "social-office-site"
definition {
	property hook.plugins.includes = "deploy-listener-hook,portal-compat-hook,so-activities-hook,so-hook";
	property portlet.plugins.includes = "chat-portlet,contacts-portlet,events-display-portlet,microblogs-portlet,private-messaging-portlet,so-announcements-portlet,so-configurations-portlet,so-portlet,tasks-portlet,wysiwyg-portlet";
	property testray.main.component.name = "Social Office EE";
	property theme.plugins.includes = "so-theme";
	var adminEmailAddress = "test@liferay.com";
	var adminName = "Joe Bloggs";
	var key_siteName = "${siteName}";
	var pageName = "Members";
	var password = "test";
	var siteDescription = "Open Site Description";
	var siteName = "Open Site Name";
	var siteType = "Open";
	var userEmailAddress = "socialoffice01@liferay.com";
	var userEmailAddress2 = "socialoffice02@liferay.com";
	var userFirstName = "Social01";
	var userFirstName2 = "Social02";
	var userLastName = "User01";
	var userLastName2 = "User02";
	var userListName = "User01, Social01";
	var userListName2 = "User02, Social02";
	var userMiddleName = "Office01";
	var userMiddleName2 = "Office02";
	var userName = "Social01 Office01 User01";
	var userName2 = "Social02 Office02 User02";
	var userScreenName = "socialoffice01";
	var userScreenName2 = "socialoffice02";

	setUp {
		SOUser.firstLoginPG();

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription}",
			siteName = "${siteName}",
			siteType = "${siteType}"
		);

		SOUser.addUserWithSORole(
			adminEmailAddress = "${adminEmailAddress}",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);
	}

	@priority = "5"
	test ConfirmMemberInviteSiteTest {
		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOMembers.inviteMember(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOMembers.confirmMemberInvite(senderName = "${adminName}");

		SOMembers.viewConfirmMemberInvite();

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOMembers.viewMember();
	}

	@priority = "5"
	test IgnoreMemberInviteSiteTest {
		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOMembers.inviteMember(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOMembers.ignoreMemberInvite(senderName = "${adminName}");

		SOMembers.viewIgnoreMemberInvite();

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOMembers.viewNonMember();
	}

	@priority = "5"
	test InviteConnectionSiteTest {
		SOContactsCenter.requestToConnect(
			userEmailAddress = "${userEmailAddress}",
			userListName = "${userListName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOContactsCenter.confirmRequestToConnect(
			senderName = "${adminName}",
			userName = "${userName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOMembers.inviteMember(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOMembers.confirmMemberInvite(senderName = "${adminName}");

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		AssertTextEquals(
			locator1 = "SOMembers#MEMBERS_LINK_ALL",
			value1 = "View all 2 users."
		);

		AssertClick(
			locator1 = "SOMembers#MEMBERS_LINK_CONNECTIONS",
			value1 = "You have 1 connections in this site."
		);

		AssertTextEquals(
			locator1 = "SOMembers#MEMBERS_LIST_NAME",
			value1 = "${userLastName}, ${userFirstName}"
		);

		AssertTextEquals(
			locator1 = "SOMembers#MEMBERS_LIST_EMAIL",
			value1 = "${userEmailAddress}"
		);

		Click.pauseTextClickAt(
			locator1 = "SOMembers#MEMBERS_LIST_NAME",
			value1 = "${userLastName}, ${userFirstName}"
		);

		AssertTextEquals(
			locator1 = "SOMembers#USER_DETAILS_NAME",
			value1 = "${userName}"
		);

		AssertTextEquals(
			locator1 = "SOMembers#USER_DETAILS_EMAIL",
			value1 = "${userEmailAddress}"
		);
	}

	@priority = "5"
	test InviteMembersSiteRolesSiteTest {
		SOUser.addUserWithSORole(
			adminEmailAddress = "${adminEmailAddress}",
			password = "test",
			userEmailAddress = "${userEmailAddress2}",
			userFirstName = "${userFirstName2}",
			userLastName = "${userLastName2}",
			userMiddleName = "${userMiddleName2}",
			userScreenName = "${userScreenName2}"
		);

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOMembers.inviteMember(
			siteRoleInvite = "Site Owner",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}"
		);

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOMembers.inviteMember(
			siteRoleInvite = "Site Administrator",
			userEmailAddress = "${userEmailAddress2}",
			userFirstName = "${userFirstName2}",
			userLastName = "${userLastName2}",
			userMiddleName = "${userMiddleName2}",
			userName = "${userName2}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOMembers.confirmMemberInvite(senderName = "${adminName}");

		SOMembers.viewConfirmMemberInvite(
			siteRoleInvite = "Site Owner",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userName = "${userName}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress2}");

		SOMembers.confirmMemberInvite(senderName = "${adminName}");

		SOMembers.viewConfirmMemberInvite(
			siteRoleInvite = "Site Administrator",
			userEmailAddress = "${userEmailAddress2}",
			userFirstName = "${userFirstName2}",
			userLastName = "${userLastName2}",
			userMiddleName = "${userMiddleName2}",
			userName = "${userName2}",
			userScreenName = "${userScreenName2}"
		);
	}

	tearDown {
		SOUser.tearDownCP();

		SOUserBar.tearDownSites();
	}
}