@component-name = "social-office-site"
definition {
	property hook.plugins.includes = "deploy-listener-hook,portal-compat-hook,so-activities-hook,so-hook";
	property portlet.plugins.includes = "chat-portlet,contacts-portlet,events-display-portlet,microblogs-portlet,private-messaging-portlet,so-announcements-portlet,so-configurations-portlet,so-portlet,tasks-portlet,wysiwyg-portlet";
	property testray.main.component.name = "Social Office EE";
	property theme.plugins.includes = "so-theme";
	var key_siteName = "${siteName}";
	var pageName = "Wiki";
	var pageType = "Open Site";
	var siteDescription = "Open Site Description";
	var siteName = "Open Site Name";
	var siteType = "Open";

	setUp {
		SOUser.firstLoginPG();

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription}",
			siteName = "${siteName}",
			siteType = "${siteType}"
		);
	}

	var wikiChildPageContent = "Wiki FrontPage Child Page Content";
	var wikiChildPageTitle = "Wiki FrontPage Child Page Title";
	var wikiPageAttachmentName = "Document_1.jpg";
	var wikiPageAttachmentSize = "12.9k";
	var wikiPageContent = "Wiki FrontPage Content";
	var wikiPageContentEdit = "Wiki FrontPage Content Edit";

	@priority = "5"
	test AddSOWikiFrontPage {
		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		WikiPage.addFrontPagePG(wikiPageContent = "${wikiPageContent}");
	}

	@priority = "5"
	test AddSOWikiFrontPageAttachment {
		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		WikiPage.addFrontPagePG(wikiPageContent = "${wikiPageContent}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		WikiPage.addFrontPageAttachmentPG(
			wikiPageAttachmentName = "${wikiPageAttachmentName}",
			wikiPageAttachmentSize = "${wikiPageAttachmentSize}",
			wikiPageContent = "${wikiPageContent}"
		);

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		WikiPage.viewFrontPageAttachmentPG(
			wikiPageAttachmentName = "${wikiPageAttachmentName}",
			wikiPageAttachmentSize = "${wikiPageAttachmentSize}",
			wikiPageContent = "${wikiPageContent}"
		);
	}

	@priority = "5"
	test AddSOWikiFrontPageChildPage {
		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		WikiPage.addFrontPagePG(wikiPageContent = "${wikiPageContent}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		WikiPage.addChildPagePG(
			wikiChildPageContent = "${wikiChildPageContent}",
			wikiChildPageTitle = "${wikiChildPageTitle}",
			wikiPageContent = "${wikiPageContent}",
			wikiPageTitle = "FrontPage"
		);
	}

	@priority = "5"
	test AddSOWikiFrontPageDraft {
		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		WikiPage.saveAsDraftFrontPagePG(wikiPageContent = "${wikiPageContent}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		WikiPage.viewSaveAsDraftFrontPagePG(wikiPageContent = "${wikiPageContent}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		WikiPage.addFrontPageDraftPG(wikiPageContent = "${wikiPageContent}");
	}

	@priority = "5"
	test EditSOWikiFrontPage {
		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		WikiPage.addFrontPagePG(wikiPageContent = "${wikiPageContent}");

		WikiPage.editFrontPagePG(
			pageName = "${pageName}",
			wikiPageContentEdit = "${wikiPageContentEdit}"
		);
	}

	tearDown {
		SOUserBar.tearDownSites();
	}
}