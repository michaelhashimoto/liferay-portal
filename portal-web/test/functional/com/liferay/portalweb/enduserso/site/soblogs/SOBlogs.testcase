@component-name = "social-office-site"
definition {
	property hook.plugins.includes = "deploy-listener-hook,portal-compat-hook,so-activities-hook,so-hook";
	property portlet.plugins.includes = "chat-portlet,contacts-portlet,events-display-portlet,microblogs-portlet,private-messaging-portlet,so-announcements-portlet,so-configurations-portlet,so-portlet,tasks-portlet,wysiwyg-portlet";
	property testray.main.component.name = "Social Office EE";
	property theme.plugins.includes = "so-theme";
	var key_siteName = "${siteName}";
	var pageName = "Blogs";
	var roleName = "Site Member";
	var siteDescription = "Open Site Description";
	var siteName = "Open Site Name";
	var siteType = "Open";
	var entryAuthorFirstName = "Joe";
	var entryAuthorLastName = "Bloggs";
	var entryContent = "Blogs Entry Content";
	var entryContentEdit = "Blogs Entry Content Edit";
	var entryTitle = "Blogs Entry Title";
	var entryTitleEdit = "Blogs Entry Title Edit";

	setUp {
		SOUser.firstLoginPG();

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription}",
			siteName = "${siteName}",
			siteType = "${siteType}"
		);
	}

	tearDown {
		SOUserBar.tearDownSites();

		SOUser.tearDownCP();

		Role.tearDownDefinePermissionCP();
	}

	@priority = "5"
	test AddSOBlogsEntry {
		var entryContent = "${entryContent}";
		var entryTitle = "${entryTitle}";
		var key_siteName = "${key_siteName}";
		var pageName = "${pageName}";
		var pageType = "${pageType}";
		var siteName = "${siteName}";

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		BlogsEntry.addPG();

		BlogsEntry.viewPG();

		AssertTextEquals(locator1 = "PGBlogs#ENTRY_COMMENTS_1", value1 = "0 Comments");

		AssertTextEquals(
			locator1 = "PGBlogs#ENTRY_AVERAGE_RATING_1",
			value1 = "Average (0 Votes)"
		);

		AssertTextEquals(
			locator1 = "PGBlogs#SEARCH_RESULTS",
			value1 = "Showing 1 result."
		);

		BlogsEntry.viewPGDetails();

		AssertTextEquals(
			locator1 = "PGBlogsEntry#ENTRY_COMMENTS",
			value1 = "0 Comments"
		);

		AssertTextEquals(
			locator1 = "PGBlogsEntry#ENTRY_AVERAGE_RATING",
			value1 = "Average (0 Votes)"
		);

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		BlogsEntry.viewPGDetails();

		AssertTextEquals.assertPartialText(
			locator1 = "PGBlogsEntry#ENTRY_VIEW_COUNT",
			value1 = "1 View"
		);

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		BlogsEntry.viewPGDetails();

		AssertTextEquals.assertPartialText(
			locator1 = "PGBlogsEntry#ENTRY_VIEW_COUNT",
			value1 = "2 Views"
		);

		Open(locator1 = "SOBlogs#OPEN_SITE_NAME_BLOGS_RSS_URL");

		AssertTextPresent(value1 = "${siteName}");

		AssertTextPresent(value1 = "${entryTitle}");

		AssertTextPresent(value1 = "${entryContent}");

		Click(locator1 = "PGBlogs#RSS_ENTRY_TITLE", value1 = "${entryTitle}");

		AssertTextEquals(
			locator1 = "PGBlogsEntry#ENTRY_TITLE",
			value1 = "${entryTitle}"
		);

		AssertTextEquals(
			locator1 = "PGBlogsEntry#ENTRY_CONTENT",
			value1 = "${entryContent}"
		);

		Page.openURL();
	}

	@priority = "5"
	test AddSOBlogsEntrySOUser {
		var adminEmailAddress = "test@liferay.com";
		var entryContent = "${entryContent}";
		var entryTitle = "${entryTitle}";
		var key_siteName = "${key_siteName}";
		var pageName = "${pageName}";
		var pageType = "${pageType}";
		var password = "test";
		var roleName = "${roleName}";
		var siteName = "${siteName}";
		var userEmailAddress = "socialoffice01@liferay.com";
		var userFirstName = "Social01";
		var userLastName = "User01";
		var userMiddleName = "Office01";
		var userScreenName = "socialoffice01";

		SOUser.addUserWithSORole(
			adminEmailAddress = "${adminEmailAddress}",
			password = "${password}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUserBar.gotoCP(portletName = "Roles");

		Role.definePermissionSiteMembersBlogsCP(
			permissions = "Blogs",
			roleName = "${roleName}",
			siteContentPermissions = "Blogs"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOSite.joinSitePG(siteName = "${siteName}");

		BlogsEntry.addPG();

		BlogsEntry.viewPG(
			entryAuthorFirstName = "${userFirstName}",
			entryAuthorLastName = "${userLastName}",
			entryAuthorMiddleName = "${userMiddleName}"
		);

		AssertTextEquals(locator1 = "PGBlogs#ENTRY_COMMENTS_1", value1 = "0 Comments");

		AssertTextEquals(
			locator1 = "PGBlogs#ENTRY_AVERAGE_RATING_1",
			value1 = "Average (0 Votes)"
		);

		AssertTextEquals(
			locator1 = "PGBlogs#SEARCH_RESULTS",
			value1 = "Showing 1 result."
		);

		BlogsEntry.viewPGDetails(
			entryAuthorFirstName = "${userFirstName}",
			entryAuthorLastName = "${userLastName}",
			entryAuthorMiddleName = "${userMiddleName}"
		);

		AssertTextEquals(
			locator1 = "PGBlogsEntry#ENTRY_COMMENTS",
			value1 = "0 Comments"
		);

		AssertTextEquals(
			locator1 = "PGBlogsEntry#ENTRY_AVERAGE_RATING",
			value1 = "Average (0 Votes)"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		BlogsEntry.viewPG(
			entryAuthorFirstName = "${userFirstName}",
			entryAuthorLastName = "${userLastName}",
			entryAuthorMiddleName = "${userMiddleName}"
		);

		AssertTextEquals(locator1 = "PGBlogs#ENTRY_COMMENTS_1", value1 = "0 Comments");

		AssertTextEquals(
			locator1 = "PGBlogs#ENTRY_AVERAGE_RATING_1",
			value1 = "Average (0 Votes)"
		);

		AssertTextEquals(
			locator1 = "PGBlogs#SEARCH_RESULTS",
			value1 = "Showing 1 result."
		);

		BlogsEntry.viewPGDetails(
			entryAuthorFirstName = "${userFirstName}",
			entryAuthorLastName = "${userLastName}",
			entryAuthorMiddleName = "${userMiddleName}"
		);

		AssertTextEquals(
			locator1 = "PGBlogsEntry#ENTRY_COMMENTS",
			value1 = "0 Comments"
		);

		AssertTextEquals(
			locator1 = "PGBlogsEntry#ENTRY_AVERAGE_RATING",
			value1 = "Average (0 Votes)"
		);
	}

	@priority = "5"
	test DeleteSOBlogsEntry {
		var entryContent = "${entryContent}";
		var entryTitle = "${entryTitle}";
		var key_siteName = "${key_siteName}";
		var siteName = "${siteName}";

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		BlogsEntry.addPG();

		BlogsEntry.deletePG();
	}

	@priority = "5"
	test DeleteSOBlogsEntrySOUser {
		var adminEmailAddress = "test@liferay.com";
		var entryContent = "${entryContent}";
		var entryTitle = "${entryTitle}";
		var key_siteName = "${key_siteName}";
		var pageName = "${pageName}";
		var pageType = "${pageType}";
		var password = "test";
		var roleName = "${roleName}";
		var siteName = "${siteName}";
		var userEmailAddress = "socialoffice01@liferay.com";
		var userFirstName = "Social01";
		var userLastName = "User01";
		var userMiddleName = "Office01";
		var userScreenName = "socialoffice01";

		SOUser.addUserWithSORole(
			adminEmailAddress = "${adminEmailAddress}",
			password = "${password}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUserBar.gotoCP(portletName = "Roles");

		Role.definePermissionSiteMembersBlogsCP(
			permissions = "Blogs",
			roleName = "${roleName}",
			siteContentPermissions = "Blogs"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOSite.joinSitePG(siteName = "${siteName}");

		BlogsEntry.addPG();

		BlogsEntry.deletePG();

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		AssertElementPresent(
			locator1 = "PGBlogs#ADD_ENTRY_BUTTON",
			value1 = "Add Blog Entry"
		);

		AssertElementPresent(
			locator1 = "PGBlogs#PERMISSIONS_BUTTON",
			value1 = "Permissions"
		);

		AssertTextEquals(locator1 = "PGBlogs#RSS_LINK", value1 = "RSS");

		AssertTextEquals(locator1 = "PGBlogs#SUBSCRIBE_LINK", value1 = "Subscribe");

		AssertElementNotPresent(locator1 = "PGBlogs#ENTRY_TITLE_1");

		AssertElementNotPresent(locator1 = "PGBlogs#ENTRY_CONTENT_1");
	}

	@priority = "5"
	test EditSOBlogsEntry {
		var entryContent = "${entryContent}";
		var entryContentEdit = "${entryContentEdit}";
		var entryTitle = "${entryTitle}";
		var entryTitleEdit = "${entryTitleEdit}";
		var key_siteName = "${key_siteName}";
		var siteName = "${siteName}";

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		BlogsEntry.addPG();

		BlogsEntry.editPG();
	}

	@priority = "5"
	test EditSOBlogsEntrySOUser {
		var adminEmailAddress = "test@liferay.com";
		var entryContent = "${entryContent}";
		var entryContentEdit = "${entryContentEdit}";
		var entryTitle = "${entryTitle}";
		var entryTitleEdit = "${entryTitleEdit}";
		var key_siteName = "${key_siteName}";
		var pageName = "${pageName}";
		var pageType = "${pageType}";
		var password = "test";
		var roleName = "${roleName}";
		var siteName = "${siteName}";
		var userEmailAddress = "socialoffice01@liferay.com";
		var userFirstName = "Social01";
		var userLastName = "User01";
		var userMiddleName = "Office01";
		var userScreenName = "socialoffice01";

		SOUser.addUserWithSORole(
			adminEmailAddress = "${adminEmailAddress}",
			password = "${password}",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUserBar.gotoCP(portletName = "Roles");

		Role.definePermissionSiteMembersBlogsCP(
			permissions = "Blogs",
			roleName = "${roleName}",
			siteContentPermissions = "Blogs"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOSite.joinSitePG(siteName = "${siteName}");

		BlogsEntry.addPG();

		BlogsEntry.editPG();

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		BlogsEntry.viewPG(
			entryAuthorFirstName = "${userFirstName}",
			entryAuthorLastName = "${userLastName}",
			entryAuthorMiddleName = "${userMiddleName}",
			entryContent = "${entryContentEdit}",
			entryTitle = "${entryTitleEdit}"
		);

		AssertTextEquals(
			locator1 = "PGBlogsEntry#ENTRY_COMMENTS",
			value1 = "0 Comments"
		);

		AssertTextEquals(
			locator1 = "PGBlogsEntry#ENTRY_AVERAGE_RATING",
			value1 = "Average (0 Votes)"
		);
	}

	@priority = "5"
	test ViewSOBlogsEntryRecentBlogs {
		var entryContent = "${entryContent}";
		var entryTitle = "${entryTitle}";
		var key_siteName = "${key_siteName}";
		var pageName = "${pageName}";
		var pageType = "${pageType}";
		var siteName = "${siteName}";

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		BlogsEntry.addPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOBlogs.viewBlogsEntryRecentBlogs();
	}
}