@component-name = "social-office-site"
definition {
	property hook.plugins.includes = "deploy-listener-hook,portal-compat-hook,so-activities-hook,so-hook";
	property portlet.plugins.includes = "chat-portlet,contacts-portlet,events-display-portlet,microblogs-portlet,private-messaging-portlet,so-announcements-portlet,so-configurations-portlet,so-portlet,tasks-portlet,wysiwyg-portlet";
	property testray.main.component.name = "Social Office EE";
	property theme.plugins.includes = "so-theme";
	var key_siteName = "${siteName}";
	var pageName = "Forums";
	var siteDescription = "Open Site Description";
	var siteName = "Open Site Name";
	var siteType = "Open";

	setUp {
		SOUser.firstLoginPG();

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription}",
			siteName = "${siteName}",
			siteType = "${siteType}"
		);
	}

	var categoryName = "MB Category Name";
	var threadBody = "MB Category Thread Message Body";
	var threadBodyEdit = "MB Category Thread Message Body Edit";
	var threadReplyBody = "MB Category Thread Message Reply Body";
	var threadSubject = "MB Category Thread Message Subject";
	var threadSubjectEdit = "MB Category Thread Message Subject Edit";
	var userName = "Joe Bloggs";

	@priority = "5"
	test AddMBCategoryThread {
		var categoryName = "${categoryName}";
		var key_siteName = "${key_siteName}";
		var pageName = "${pageName}";
		var pageType = "${pageType}";
		var siteName = "${siteName}";
		var threadBody = "${threadBody}";
		var threadSubject = "${threadSubject}";

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		MessageboardsCategory.addPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		MessageboardsCategory.gotoPG(categoryName = "${categoryName}");

		MessageboardsThread.addPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOForumsCategoryThread.viewPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOForumsCategoryThread.viewMyPostsPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOForumsCategoryThread.viewRecentPostsPG();
	}

	@priority = "5"
	test DeleteMBCategoryThread {
		var categoryName = "${categoryName}";
		var key_categoryName = "${categoryName}";
		var key_siteName = "${key_siteName}";
		var pageName = "${pageName}";
		var pageType = "${pageType}";
		var siteName = "${siteName}";
		var threadBody = "${threadBody}";
		var threadSubject = "${threadSubject}";

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		MessageboardsCategory.addPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		MessageboardsCategory.gotoPG(categoryName = "${categoryName}");

		MessageboardsThread.addPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		MessageboardsCategory.gotoPG(categoryName = "${categoryName}");

		SOForumsCategoryThread.deletePG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		AssertTextEquals(
			locator1 = "PGMessageboards#CATEGORY_TABLE_CATEGORY",
			value1 = "${categoryName}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboards#CATEGORY_TABLE_CATEGORIES",
			value1 = "0"
		);

		AssertTextEquals(
			locator1 = "PGMessageboards#CATEGORY_TABLE_THREADS",
			value1 = "0"
		);

		AssertTextEquals(
			locator1 = "PGMessageboards#CATEGORY_TABLE_POSTS",
			value1 = "0"
		);

		AssertClick(
			locator1 = "PGMessageboards#CATEGORY_TABLE_CATEGORY",
			value1 = "${categoryName}"
		);

		AssertTextEquals(
			locator1 = "PGMessageboards#INFO_MESSAGE",
			value1 = "There are no threads in this category."
		);

		AssertTextNotPresent(value1 = "${threadSubject}");
	}

	@priority = "5"
	test EditMBCategoryThread {
		var categoryName = "${categoryName}";
		var key_siteName = "${key_siteName}";
		var pageName = "${pageName}";
		var pageType = "${pageType}";
		var siteName = "${siteName}";
		var threadBody = "${threadBody}";
		var threadBodyEdit = "${threadBodyEdit}";
		var threadSubject = "${threadSubject}";
		var threadSubjectEdit = "${threadSubjectEdit}";

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		MessageboardsCategory.addPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		MessageboardsCategory.gotoPG(categoryName = "${categoryName}");

		MessageboardsThread.addPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		MessageboardsCategory.gotoPG(categoryName = "${categoryName}");

		MessageboardsThread.editPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOForumsCategoryThread.viewPG(
			threadBody = "${threadBodyEdit}",
			threadSubject = "${threadSubjectEdit}"
		);
	}

	@priority = "5"
	test ReplyMBCategoryThread {
		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		MessageboardsCategory.addPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		MessageboardsCategory.gotoPG(categoryName = "${categoryName}");

		MessageboardsThread.addPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		MessageboardsCategory.gotoPG(categoryName = "${categoryName}");

		MessageboardsThread.replyPG(
			threadBody = "${threadBody}",
			threadReplyBody = "${threadReplyBody}",
			threadSubject = "${threadSubject}"
		);

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		SOForumsCategoryThread.viewReplyPG();
	}

	tearDown {
		SOUserBar.tearDownSites();
	}
}