	@priority = "5"
	test ViewSOAnnouncementsEntryNotificationSOUser {
		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription}",
			siteName = "${siteName}",
			siteType = "${siteType}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOUserBar.joinSOSite(siteName = "${siteName}", siteType = "${siteType}");

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${adminEmailAddress}");

		Page.openURL(pageType = "Open Site");

		SOAnnouncementsEntry.addPG(
			distributionScope = "General",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			entryURL = "${entryURL}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		SOAnnouncementsEntry.viewNotificationPG(
			entryAuthor = "${adminName}",
			entryTitle = "${entryTitle}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		var entryAuthor = "${adminName}";

		Click.textClickAt(locator1 = "SOUserBar#DASHBOARD", value1 = "Dashboard");

		AssertElementPresent.assertElementPresent(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals(locator1 = "SOUserBar#NOTIFICATION_MENU_COUNT", value1 = "0");

		MouseOver(locator1 = "SOUserBar#NOTIFICATION");

		AssertTextEquals(
			locator1 = "SOUserBar#NOTIFICATION_MENU_EMPTY",
			value1 = "You have no new notifications."
		);

		AssertTextNotPresent(value1 = "${entryAuthor} sent a new announcement.");

		AssertElementNotPresent(
			locator1 = "SOUserBar#NOTIFICATION_MENU_ENTRY_SUBCONTENT",
			value1 = "${entryTitle}"
		);
	}
}