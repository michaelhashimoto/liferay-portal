	@priority = "5"
	test ViewCalendarEvent2GuestNoViewEventsDisplay {
		var eventDescription = "${eventDescription}";
		var eventTitle = "${eventTitle}";
		var key_eventTitle = "${eventTitle}";
		var pageName = "Calendar";

		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription}",
			siteName = "${siteName}",
			siteType = "${siteType}"
		);

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.addPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.addPG(daysIntoFuture = "1", number = "01");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.addPG(daysIntoFuture = "2", number = "02");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.addPG(daysIntoFuture = "3", number = "03");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		var key_number = "02";

		AssertClick.assertTextClickAt(
			locator1 = "PGCalendar#VIEW_EVENTS",
			value1 = "Events"
		);

		AssertElementPresent(locator1 = "PGCalendar#EVENTS_EVENT_TABLE_DATE_INCREMENT");

		AssertElementPresent(locator1 = "PGCalendar#EVENTS_EVENT_TABLE_TIME_INCREMENT");

		AssertTextEquals(
			locator1 = "PGCalendar#EVENTS_EVENT_TABLE_TITLE_INCREMENT",
			value1 = "${eventTitle}02"
		);

		AssertTextEquals(
			locator1 = "PGCalendar#EVENTS_EVENT_TABLE_TYPE_INCREMENT",
			value1 = "Anniversary"
		);

		Click(locator1 = "PGCalendar#EVENTS_EVENT_TABLE_ACTIONS_INCREMENT");

		Click(locator1 = "PGCalendar#EVENT_MENULIST_PERMISSIONS");

		Uncheck(locator1 = "//input[@id='guest_ACTION_VIEW']");

		Click(locator1 = "//input[@value='Save']");

		AssertTextEquals(
			locator1 = "PGCalendar#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully."
		);

		Page.openURL(pageType = "Open Site");

		SOEvents.configureEventsPortletDisplayDays(maxDisplayDays = "4");

		var number = "01";

		AssertTextEquals(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE",
			value1 = "${eventTitle}"
		);

		AssertElementPresent(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TIME"
		);

		AssertTextEquals(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TITLE_INCREMENT",
			value1 = "${eventTitle}01"
		);

		AssertElementPresent(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TIME_INCREMENT"
		);

		var number = "02";

		AssertTextEquals(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TITLE_INCREMENT",
			value1 = "${eventTitle}02"
		);

		AssertElementPresent(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TIME_INCREMENT"
		);

		var number = "03";

		AssertTextEquals(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TITLE_INCREMENT",
			value1 = "${eventTitle}03"
		);

		AssertElementPresent(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TIME_INCREMENT"
		);

		var number = "02";

		AssertClick.assertTextClickAt(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TITLE_INCREMENT",
			value1 = "${eventTitle}02"
		);

		Event.viewDetailsPG();

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		Page.openURL(pageType = "Open Site");

		var number = "01";

		AssertTextEquals(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE",
			value1 = "${eventTitle}"
		);

		AssertElementPresent(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TIME"
		);

		AssertTextEquals(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TITLE_INCREMENT",
			value1 = "${eventTitle}01"
		);

		AssertElementPresent(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TIME_INCREMENT"
		);

		AssertTextNotEquals.assertNotPartialText(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_TODAYS_EVENTS",
			value1 = "${eventTitle}02"
		);

		AssertTextNotEquals.assertNotPartialText(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_UPCOMING_EVENTS",
			value1 = "${eventTitle}02"
		);

		var number = "03";

		AssertTextEquals(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TITLE_INCREMENT",
			value1 = "${eventTitle}03"
		);

		AssertElementPresent(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TIME_INCREMENT"
		);
	}

	@priority = "5"
	test ViewCalendarEventsEventsDisplay {
		var eventDescription = "${eventDescription}";
		var eventTitle = "${eventTitle}";
		var pageName = "Calendar";

		SOUser.addUserWithSORole(
			adminEmailAddress = "test@liferay.com",
			password = "test",
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUserBar.addSOSite(
			siteDescription = "${siteDescription}",
			siteName = "${siteName}",
			siteType = "${siteType}"
		);

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.addPG();

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.addPG(daysIntoFuture = "1", number = "01");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.addPG(daysIntoFuture = "2", number = "02");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.addPG(daysIntoFuture = "3", number = "03");

		Page.gotoPG(pageName = "${pageName}", pageType = "Open Site");

		Event.addPG(daysIntoFuture = "4", number = "04");

		Page.openURL(pageType = "Open Site");

		AssertTextEquals(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE",
			value1 = "${eventTitle}"
		);

		AssertElementPresent(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TIME"
		);

		AssertElementNotPresent(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TITLE"
		);

		AssertElementNotPresent(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TIME"
		);

		AssertClick.assertTextClickAt(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE",
			value1 = "${eventTitle}"
		);

		Event.viewDetailsPG();

		Page.openURL(pageType = "Open Site");

		SOEvents.configureEventsPortletDisplayDays(maxDisplayDays = "2");

		var number = "01";

		AssertTextEquals(
			locator1 = "SOSiteHome#EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE",
			value1 = "${eventTitle}"
		);

