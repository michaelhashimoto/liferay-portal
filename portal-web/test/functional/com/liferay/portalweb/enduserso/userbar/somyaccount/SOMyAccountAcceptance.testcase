@component-name = "social-office-user-bar"
definition {
	property hook.plugins.includes = "deploy-listener-hook,portal-compat-hook,so-activities-hook,so-hook";
	property portlet.plugins.includes = "chat-portlet,contacts-portlet,events-display-portlet,microblogs-portlet,private-messaging-portlet,so-announcements-portlet,so-configurations-portlet,so-portlet,tasks-portlet,wysiwyg-portlet";
	property testray.main.component.name = "Social Office EE";
	property theme.plugins.includes = "so-theme";
	var userEmailAddress = "socialoffice01@liferay.com";
	var userFirstName = "Social01";
	var userLastName = "User01";
	var userMiddleName = "Office01";
	var userName = "Social01 Office01 User01";
	var userScreenName = "socialoffice01";

	setUp {
		SOUser.firstLoginPG();

		SOUserBar.gotoCP(portletName = "Users and Organizations");

		User.addCP(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userMiddleName = "${userMiddleName}",
			userScreenName = "${userScreenName}"
		);

		SOUserBar.gotoCP(portletName = "Roles");

		Role.assignRegRoleCP(
			roleName = "Social Office",
			userScreenName = "${userScreenName}"
		);

		SOUser.editPasswordCP(
			userEmailAddress = "${userEmailAddress}",
			userScreenName = "${userScreenName}"
		);

		SOUser.logoutPG();

		SOUser.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");
	}

	tearDown {
		SOUser.tearDownCP();
	}

	@priority = "5"
	test AddAdditionalEmailAddress {
		var userAdditionalEmailAddress = "socialoffice02@liferay.com";

		SOProfile.addAdditionalEmailAddressMyAccount(
			userAdditionalEmailAddress = "${userAdditionalEmailAddress}"
		);

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewAdditionalEmailAddressProfile(
			userAdditionalEmailAddress = "${userAdditionalEmailAddress}"
		);
	}

	@priority = "5"
	test AddAddress {
		var userAddressCity = "Ray of Light";
		var userAddressCountry = "United States";
		var userAddressPostalCode = "91234";
		var userAddressRegion = "California";
		var userAddressStreet1 = "123 Liferay Ln.";
		var userAddressType = "Personal";

		SOProfile.addAddressMyAccount(
			userAddressCity = "${userAddressCity}",
			userAddressCountry = "${userAddressCountry}",
			userAddressPostalCode = "${userAddressPostalCode}",
			userAddressRegion = "${userAddressRegion}",
			userAddressStreet1 = "${userAddressStreet1}",
			userAddressType = "${userAddressType}"
		);

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewAddressProfile(
			userAddressCity = "${userAddressCity}",
			userAddressCountry = "${userAddressCountry}",
			userAddressPostalCode = "${userAddressPostalCode}",
			userAddressRegion = "${userAddressRegion}",
			userAddressStreet1 = "${userAddressStreet1}",
			userAddressType = "${userAddressType}"
		);
	}

	@priority = "5"
	test AddInstantMessenger {
		var userInstantMessengerAIM = "socialofficesn";
		var userInstantMessengerICQ = "socialofficesn";
		var userInstantMessengerJabber = "socialofficesn";
		var userInstantMessengerSkype = "socialofficesn";
		var userInstantMessengerWindowsLiveMessenger = "socialofficesn";
		var userInstantMessengerYM = "socialofficesn";

		SOProfile.addInstantMessengerMyAccount(
			userInstantMessengerAIM = "${userInstantMessengerAIM}",
			userInstantMessengerICQ = "${userInstantMessengerICQ}",
			userInstantMessengerJabber = "${userInstantMessengerJabber}",
			userInstantMessengerSkype = "${userInstantMessengerSkype}",
			userInstantMessengerWindowsLiveMessenger = "${userInstantMessengerWindowsLiveMessenger}",
			userInstantMessengerYM = "${userInstantMessengerYM}"
		);

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewInstantMessengerProfile(
			userInstantMessengerAIM = "${userInstantMessengerAIM}",
			userInstantMessengerICQ = "${userInstantMessengerICQ}",
			userInstantMessengerJabber = "${userInstantMessengerJabber}",
			userInstantMessengerSkype = "${userInstantMessengerSkype}",
			userInstantMessengerWindowsLiveMessenger = "${userInstantMessengerWindowsLiveMessenger}",
			userInstantMessengerYM = "${userInstantMessengerYM}"
		);
	}

	@priority = "5"
	test AddIntroduction {
		var userIntroduction = "Introduction Content";

		SOProfile.addCommentsMyAccount(userIntroduction = "${userIntroduction}");

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewIntroductionProfile(userIntroduction = "${userIntroduction}");
	}

	@priority = "5"
	test AddPhoneNumbers {
		var userPhoneNumberExtension = "123";
		var userPhoneNumberNumber = "123-123-1234";
		var userPhoneNumberType = "Business";

		SOProfile.addPhoneNumbersMyAccount(
			userPhoneNumberExtension = "${userPhoneNumberExtension}",
			userPhoneNumberNumber = "${userPhoneNumberNumber}",
			userPhoneNumberType = "${userPhoneNumberType}"
		);

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewPhoneNumbersProfile(
			userPhoneNumberExtension = "${userPhoneNumberExtension}",
			userPhoneNumberNumber = "${userPhoneNumberNumber}",
			userPhoneNumberType = "${userPhoneNumberType}"
		);
	}

	@priority = "5"
	test AddProjects {
		var userProjectDescription = "Expertise Description";
		var userProjectTitle = "Expertise Title";

		SOProfile.addProjectsMyAccount(
			userProjectDescription = "${userProjectDescription}",
			userProjectTitle = "${userProjectTitle}"
		);

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewProjectsProfile(
			userProjectDescription = "${userProjectDescription}",
			userProjectTitle = "${userProjectTitle}"
		);
	}

	@priority = "5"
	test AddSMS {
		var userSMS = "socialoffice@liferay.com";

		SOProfile.addSMSMyAccount(userSMS = "${userSMS}");

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewSMSProfile(userSMS = "${userSMS}");
	}

	@priority = "5"
	test AddSocialNetwork {
		var userSocialNetworkFacebook = "socialoffice01";
		var userSocialNetworkMyspace = "socialoffice01";
		var userSocialNetworkTwitter = "socialoffice01";

		SOProfile.addSocialNetworkMyAccount(
			userSocialNetworkFacebook = "${userSocialNetworkFacebook}",
			userSocialNetworkMyspace = "${userSocialNetworkMyspace}",
			userSocialNetworkTwitter = "${userSocialNetworkTwitter}"
		);

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewSocialNetworkProfile(
			userSocialNetworkFacebook = "${userSocialNetworkFacebook}",
			userSocialNetworkMyspace = "${userSocialNetworkMyspace}",
			userSocialNetworkTwitter = "${userSocialNetworkTwitter}"
		);
	}

	@priority = "5"
	test AddTag {
		var userTag = "tag1";

		SOProfile.addTagMyAccount(userTag = "${userTag}");

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewTagProfile(userTag = "${userTag}");
	}

	@priority = "5"
	test AddWebsite {
		var userWebsiteType = "Personal";
		var userWebsiteURL = "http://www.socialoffice01.com";

		SOProfile.addWebsiteMyAccount(
			userWebsiteType = "${userWebsiteType}",
			userWebsiteURL = "${userWebsiteURL}"
		);

		SOUserBar.gotoProfile(userName = "${userName}");

		SOProfile.viewWebsiteProfile(
			userWebsiteType = "${userWebsiteType}",
			userWebsiteURL = "${userWebsiteURL}"
		);
	}
}