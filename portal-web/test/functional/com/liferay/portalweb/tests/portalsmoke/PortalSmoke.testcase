<definition component-name="portal-smoke">
	<property name="testray.main.component.name" value="Smoke" />

	<command description="Ensure that the super admin can add pages, add portlets, navigate to the product menu, use the WYSIWYG editor, and view alert messages." name="Smoke" priority="5">
		<property name="portal.acceptance" value="true" />
		<property name="portal.smoke" value="true" />
		<property name="portal.quick" value="true" />
		<property name="test.assert.warning.exceptions" value="true" />

		<execute macro="JSONGroup#_addGroup">
			<var name="groupName" value="Hello World" />
			<var name="groupDescription" value="Good Bye World" />
		</execute>

		<execute macro="JSONRole#_addRole">
			<var name="roleName" value="Hello World" />
			<var name="roleType" value="regular" />
			<var name="roleTitle" value="Good Bye World" />
			<var name="roleDescription" value="Crystal Son" />
		</execute>

		<execute macro="JSONRole#_addRole">
			<var name="roleName" value="Michael Hashimoto" />
			<var name="roleType" value="regular" />
		</execute>
	</command>
</definition>