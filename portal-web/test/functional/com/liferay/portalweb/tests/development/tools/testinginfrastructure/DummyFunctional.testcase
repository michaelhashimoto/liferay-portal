@component-name = "portal-tools"
definition {

	property portal.smoke = "dummy";
	property testray.main.component.name = "Tools";

	@priority = "5"
	test Dummy {
		Open(locator1 = "https://www.liferay.com/");
	}

	@priority = "5"
	test Dummy1 {
		property test.assert.warning.exceptions = "true";

		Open(locator1 = "https://www.liferay.com/");
	}

	@priority = "5"
	test Dummy2 {
		Open(locator1 = "https://www.liferay.com/");
	}

}