<definition component-name="portal-user-interface">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="setup.wizard.enabled" value="true" />
	<property name="testray.main.component.name" value="User Interface" />
	<property name="theme.plugins.includes" value="welcome-theme" />
	<property name="web.plugins.includes" value="resources-importer-web" />

	<set-up>
		<var name="administratorEmail" value="test@liferay.com" />
		<var name="administratorFirstName" value="Test" />
		<var name="administratorLastName" value="Test" />
		<var name="newPassword" value="test1" />
		<var name="pageName" value="Blogs Page" />
		<var name="passwordReminder" value="test" />
		<var name="portalDefaultLanguage" value="English (United States)" />
		<var name="portalName" value="Liferay" />
		<var name="portletName" value="Blogs" />

		<execute macro="Page#openURL" />

		<execute function="AssertTextEquals" locator1="Setupwizard#PORTAL_PORTAL_NAME_FIELD" value1="${portalName}" />
		<execute function="AssertSelectedLabel" locator1="Setupwizard#PORTAL_DEFAULT_LANGUAGE_SELECT" value1="${portalDefaultLanguage}" />
		<execute function="AssertTextEquals" locator1="Setupwizard#ADMINISTRATOR_USER_FIRST_NAME_FIELD" value1="${administratorFirstName}" />
		<execute function="AssertTextEquals" locator1="Setupwizard#ADMINISTRATOR_USER_LAST_NAME_FIELD" value1="${administratorLastName}" />
		<execute function="AssertTextEquals" locator1="Setupwizard#ADMINISTRATOR_USER_EMAIL_FIELD" value1="${administratorEmail}" />
		<execute function="AssertTextEquals" locator1="Setupwizard#DATABASE_CONFIGURED_JDBC_URL_LABEL" value1="JDBC URL" />
		<execute function="AssertTextEquals" locator1="Setupwizard#DATABASE_CONFIGURED_JDBC_DRIVER_CLASS_NAME_LABEL" value1="JDBC Driver Class Name" />
		<execute function="AssertTextEquals" locator1="Setupwizard#DATABASE_CONFIGURED_USER_NAME_LABEL" value1="User Name" />
		<execute function="AssertTextEquals" locator1="Setupwizard#DATABASE_CONFIGURED_PASSWORD_LABEL" value1="Password" />
		<execute function="AssertClick" locator1="Setupwizard#DATABASE_CHANGE_LINK" value1="(Change)" />
		<execute function="AssertTextEquals" locator1="Setupwizard#DATABASE_CHANGE_DATABASE_TYPE_LABEL" value1="Database Type" />
		<execute function="AssertTextEquals" locator1="Setupwizard#DATABASE_CHANGE_JDBC_URL_LABEL" value1="JDBC URL (Required)" />
		<execute function="AssertTextEquals" locator1="Setupwizard#DATABASE_CHANGE_JDBC_DRIVER_CLASS_NAME_LABEL" value1="JDBC Driver Class Name (Required)" />
		<execute function="AssertTextEquals" locator1="Setupwizard#DATABASE_CHANGE_USER_NAME_LABEL" value1="User Name" />
		<execute function="AssertTextEquals" locator1="Setupwizard#DATABASE_CHANGE_PASSWORD_LABEL" value1="Password" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="Setupwizard#FINISH_CONFIGURATION_BUTTON" value1="Finish Configuration" />

		<execute function="AssertTextEquals" locator1="SetupwizardFinishconfiguration#SUCCESS_MESSAGE" value1="Your configuration was saved successfully." />
		<execute function="AssertTextEquals#assertPartialText" locator1="SetupwizardFinishconfiguration#CONFIGURATION_SAVE_MESSAGE" value1="The configuration was saved in" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SetupwizardFinishconfiguration#CONFIGURATION_SAVE_LOCATION" value1="portal-setup-wizard.properties" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="SetupwizardFinishconfiguration#GO_TO_MY_PORTAL_BUTTON" value1="Go to My Portal" />

		<execute function="AssertClick#assertValueClickAtAndWait" locator1="PGLoginTermsofservice#I_AGREE_BUTTON" value1="I Agree" />

		<execute function="Type" locator1="PGLoginNewpassword#PASSWORD_FIELD" value1="${newPassword}" />
		<execute function="Type" locator1="PGLoginNewpassword#ENTER_AGAIN_FIELD" value1="${newPassword}" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="PGLoginNewpassword#SAVE_BUTTON" value1="Save" />

		<execute function="Type" locator1="PGLoginPasswordreminder#ANSWER_FIELD" value1="${passwordReminder}" />
		<execute function="AssertClick#assertValueClickAtAndWait" locator1="PGLoginPasswordreminder#SAVE_BUTTON" value1="Save" />
	</set-up>

	<command name="WelcomeThemeView" priority="5">
		<execute function="AssertElementPresent#assertVisible" locator1="PGWelcomePage1#GO_TO_LIFERAY" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage1#PAGE_1" value1="What We Do" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage1#PAGE_2" value1="Who Is Using Liferay" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage1#PAGE_3" value1="Liferay Benefits" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage1#MENU_TAGLINE" value1="Liferay helps you build feature-rich, easy-to-use web applications quickly." />
		<execute function="AssertTextEquals" locator1="PGWelcomePage1#MENU_PAGE_1" value1="A Foundation for Apps" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage1#MENU_PAGE_2" value1="Dynamic Websites" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage1#MENU_PAGE_3" value1="Centralized Document Management" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage1#MENU_PAGE_4" value1="Intuitive Team Collaboration" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage1#MENU_PAGE_5" value1="Tools for Business" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage1#MENU_PAGE_6" value1="Desktop &amp; Mobile Access" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage1#MENU_PAGE_7" value1="Liferay Marketplace" />
		<execute function="AssertElementPresent" locator1="PGWelcomePage1#INFO_LINK" value1="See how Liferay makes creating apps easier" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage1#SOCIAL_OFFICE" value1="Want Easy Social Collaboration?" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage1#GETTING_STARTED" value1="Need Help Getting Started?" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage1#DEVELOP_FASTER" value1="Develop Faster." />

		<execute function="Click#clickAtAndWait" locator1="PGWelcomePage1#PAGE_2" />

		<execute function="AssertElementPresent#assertVisible" locator1="PGWelcomePage2#CUSTOMERS_1" />
		<execute function="AssertElementPresent#assertVisible" locator1="PGWelcomePage2#CUSTOMERS_2" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage2#HEADER" value1="Liferay helps you build feature-rich, easy-to-use web applications quickly." />

		<execute function="Click#clickAtAndWait" locator1="PGWelcomePage1#PAGE_3" />

		<execute function="AssertTextEquals" locator1="PGWelcomePage3#HEADER" value1="See how Liferay can change the way you do business." />
		<execute function="AssertTextEquals" locator1="PGWelcomePage3#MENU_PAGE_1" value1="Open Source: A Better Way" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage3#MENU_PAGE_2" value1="Ready to Go" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage3#MENU_PAGE_3" value1="Ready to Grow" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage3#MENU_PAGE_4" value1="Approved by IT" />
		<execute function="AssertTextEquals" locator1="PGWelcomePage3#MENU_PAGE_5" value1="Open for Business" />
	</command>

	<tear-down>
		<execute function="Click" locator1="Dockbar#USER_SIGN_OUT" />
	</tear-down>
</definition>