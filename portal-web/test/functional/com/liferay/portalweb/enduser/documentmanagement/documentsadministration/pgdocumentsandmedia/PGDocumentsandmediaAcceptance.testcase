@component-name = "portal-document-management"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Documents Management";
	var pageName = "Documents and Media Page";
	var portletName = "Documents and Media";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");
	}

	@priority = "5"
	test AddDocument {
		var dmDocumentDescription = "DM Document Description";
		var dmDocumentFile = "Document_1.txt";
		var dmDocumentSize = "0.3k";
		var dmDocumentTitle = "DM Document Title";

		Page.gotoPG(pageName = "${pageName}");

		DMDocument.addPG(
			dmDocumentDescription = "${dmDocumentDescription}",
			dmDocumentFile = "${dmDocumentFile}",
			dmDocumentSize = "${dmDocumentSize}",
			dmDocumentTitle = "${dmDocumentTitle}"
		);

		DMDocument.viewPG(dmDocumentTitle = "${dmDocumentTitle}");
	}

	@priority = "5"
	test AddDocuments {
		var dmDocumentDescription1 = "DM Document1 Description";
		var dmDocumentDescription2 = "DM Document2 Description";
		var dmDocumentDescription3 = "DM Document3 Description";
		var dmDocumentFile1 = "Document_1.txt";
		var dmDocumentFile2 = "Document_2.txt";
		var dmDocumentFile3 = "Document_3.txt";
		var dmDocumentSize1 = "0.3k";
		var dmDocumentSize2 = "0.5k";
		var dmDocumentSize3 = "0.8k";
		var dmDocumentTitle1 = "DM Document1 Title";
		var dmDocumentTitle2 = "DM Document2 Title";
		var dmDocumentTitle3 = "DM Document3 Title";

		Page.gotoPG(pageName = "${pageName}");

		DMDocument.addPG(
			dmDocumentDescription = "${dmDocumentDescription1}",
			dmDocumentFile = "${dmDocumentFile1}",
			dmDocumentSize = "${dmDocumentSize1}",
			dmDocumentTitle = "${dmDocumentTitle1}"
		);

		DMDocument.viewPG(dmDocumentTitle = "${dmDocumentTitle1}");

		DMDocument.addPG(
			dmDocumentDescription = "${dmDocumentDescription2}",
			dmDocumentFile = "${dmDocumentFile2}",
			dmDocumentSize = "${dmDocumentSize2}",
			dmDocumentTitle = "${dmDocumentTitle2}"
		);

		DMDocument.viewPG(dmDocumentTitle = "${dmDocumentTitle2}");

		DMDocument.addPG(
			dmDocumentDescription = "${dmDocumentDescription3}",
			dmDocumentFile = "${dmDocumentFile3}",
			dmDocumentSize = "${dmDocumentSize3}",
			dmDocumentTitle = "${dmDocumentTitle3}"
		);

		DMDocument.viewPG(dmDocumentTitle = "${dmDocumentTitle3}");
	}

	@priority = "5"
	test AddFolder {
		var dmFolderDescription = "DM Folder Description";
		var dmFolderName = "DM Folder Name";

		Page.gotoPG(pageName = "${pageName}");

		DMFolder.addPG(
			dmFolderDescription = "${dmFolderDescription}",
			dmFolderName = "${dmFolderName}"
		);

		DMFolder.viewPG(dmFolderName = "${dmFolderName}");
	}

	@priority = "5"
	test DeleteDocument {
		var dmDocumentDescription = "DM Document Description";
		var dmDocumentFile = "Document_1.txt";
		var dmDocumentSize = "0.3k";
		var dmDocumentTitle = "DM Document Title";

		Page.gotoPG(pageName = "${pageName}");

		DMDocument.addPG(
			dmDocumentDescription = "${dmDocumentDescription}",
			dmDocumentFile = "${dmDocumentFile}",
			dmDocumentSize = "${dmDocumentSize}",
			dmDocumentTitle = "${dmDocumentTitle}"
		);

		DMDocument.deletePG(
			dmDocumentDescription = "${dmDocumentDescription}",
			dmDocumentTitle = "${dmDocumentTitle}"
		);
	}

	@priority = "5"
	test DeleteFolder {
		var dmFolderDescription = "DM Folder Description";
		var dmFolderName = "DM Folder Name";

		Page.gotoPG(pageName = "${pageName}");

		DMFolder.addPG(
			dmFolderDescription = "${dmFolderDescription}",
			dmFolderName = "${dmFolderName}"
		);

		DMFolder.deletePG(dmFolderName = "${dmFolderName}");
	}

	@priority = "5"
	test EditDocument {
		var dmDocumentDescription = "DM Document Description";
		var dmDocumentFile = "Document_1.txt";
		var dmDocumentSize = "0.3k";
		var dmDocumentTitle = "DM Document Title";

		Page.gotoPG(pageName = "${pageName}");

		DMDocument.addPG(
			dmDocumentDescription = "${dmDocumentDescription}",
			dmDocumentFile = "${dmDocumentFile}",
			dmDocumentSize = "${dmDocumentSize}",
			dmDocumentTitle = "${dmDocumentTitle}"
		);

		DMDocument.editPG(
			dmDocumentDescriptionEdit = "${dmDocumentDescription} Edit",
			dmDocumentTitle = "${dmDocumentTitle}",
			dmDocumentTitleEdit = "${dmDocumentTitle} Edit"
		);
	}

	@priority = "5"
	test EditFolder {
		var dmFolderDescription = "DM Folder Description";
		var dmFolderName = "DM Folder Name";

		Page.gotoPG(pageName = "${pageName}");

		DMFolder.addPG(
			dmFolderDescription = "${dmFolderDescription}",
			dmFolderName = "${dmFolderName}"
		);

		DMFolder.editPG(
			dmFolderDescriptionEdit = "${dmFolderDescription} Edit",
			dmFolderName = "${dmFolderName}",
			dmFolderNameEdit = "${dmFolderName} Edit"
		);
	}

	@priority = "5"
	test MoveFolderDocumentToFolder {
		var dmDocumentDescription = "DM Document Description";
		var dmDocumentFile = "Document_1.txt";
		var dmDocumentSize = "0.3k";
		var dmDocumentTitle = "DM Document Title";
		var dmFolderDescription1 = "DM Folder1 Description";
		var dmFolderDescription2 = "DM Folder2 Description";
		var dmFolderName1 = "DM Folder1 Name";
		var dmFolderName2 = "DM Folder2 Name";

		Page.gotoPG(pageName = "${pageName}");

		DMFolder.addPG(
			dmFolderDescription = "${dmFolderDescription1}",
			dmFolderName = "${dmFolderName1}"
		);

		DMFolder.addPG(
			dmFolderDescription = "${dmFolderDescription2}",
			dmFolderName = "${dmFolderName2}"
		);

		Page.gotoPG(pageName = "${pageName}");

		DMFolder.gotoPG(dmFolderName = "${dmFolderName1}");

		DMDocument.addPG(
			dmDocumentDescription = "${dmDocumentDescription}",
			dmDocumentFile = "${dmDocumentFile}",
			dmDocumentSize = "${dmDocumentSize}",
			dmDocumentTitle = "${dmDocumentTitle}"
		);

		Page.gotoPG(pageName = "${pageName}");

		DMFolderDocument.moveToFolderPG(
			dmDocumentTitle = "${dmDocumentTitle}",
			dmFolderName = "${dmFolderName1}"
		);
	}

	tearDown {
		DMDocument.tearDownPG(pageName = "${pageName}");

		Page.tearDownPG();
	}
}