@component-name = "portal-document-management"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Documents Management";
	var pageName = "Media Gallery Page";
	var portletName = "Media Gallery";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");

		MGPortlet.configureShowAllPG(pageName = "${pageName}");
	}

	@priority = "5"
	test AddFolder {
		var mgFolderDescription = "DM Folder Description";
		var mgFolderName = "DM Folder Name";

		Page.gotoPG(pageName = "${pageName}");

		DMFolder.addPGviaMG(
			mgFolderDescription = "${mgFolderDescription}",
			mgFolderName = "${mgFolderName}"
		);
	}

	@priority = "5"
	test AddFolderDocument {
		var mgDocumentDescription = "DM Document Description";
		var mgDocumentFile = "Document_1.jpg";
		var mgDocumentTitle = "DM Document Title";
		var mgFolderDescription = "DM Folder Description";
		var mgFolderName = "DM Folder Name";

		Page.gotoPG(pageName = "${pageName}");

		DMFolder.addPGviaMG(
			mgFolderDescription = "${mgFolderDescription}",
			mgFolderName = "${mgFolderName}"
		);

		DMFolderDocument.addPGviaMG(
			mgDocumentDescription = "${mgDocumentDescription}",
			mgDocumentFile = "${mgDocumentFile}",
			mgDocumentTitle = "${mgDocumentTitle}",
			mgFolderName = "${mgFolderName}"
		);
	}

	@priority = "5"
	test DeleteFolderDocument {
		var mgDocumentDescription = "DM Document Description";
		var mgDocumentFile = "Document_1.jpg";
		var mgDocumentTitle = "DM Document Title";
		var mgFolderDescription = "DM Folder Description";
		var mgFolderName = "DM Folder Name";

		Page.gotoPG(pageName = "${pageName}");

		DMFolder.addPGviaMG(
			mgFolderDescription = "${mgFolderDescription}",
			mgFolderName = "${mgFolderName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		DMFolderDocument.addPGviaMG(
			mgDocumentDescription = "${mgDocumentDescription}",
			mgDocumentFile = "${mgDocumentFile}",
			mgDocumentTitle = "${mgDocumentTitle}",
			mgFolderName = "${mgFolderName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		DMFolderDocument.deletePGviaMG(
			mgDocumentTitle = "${mgDocumentTitle}",
			mgFolderName = "${mgFolderName}"
		);
	}

	@priority = "5"
	test EditDMFolder {
		var mgFolderDescription = "DM Folder Description";
		var mgFolderName = "DM Folder Name";

		Page.gotoPG(pageName = "${pageName}");

		DMFolder.addPGviaMG(
			mgFolderDescription = "${mgFolderDescription}",
			mgFolderName = "${mgFolderName}"
		);

		DMFolder.editPGviaMG(
			mgFolderDescriptionEdit = "${mgFolderDescription} Edit",
			mgFolderName = "${mgFolderName}",
			mgFolderNameEdit = "${mgFolderName} Edit"
		);
	}

	@priority = "5"
	test EditFolderDocument {
		var mgDocumentDescription = "DM Document Description";
		var mgDocumentFile = "Document_1.jpg";
		var mgDocumentTitle = "DM Document Title";
		var mgFolderDescription = "DM Folder Description";
		var mgFolderName = "DM Folder Name";

		Page.gotoPG(pageName = "${pageName}");

		DMFolder.addPGviaMG(
			mgFolderDescription = "${mgFolderDescription}",
			mgFolderName = "${mgFolderName}"
		);

		DMFolderDocument.addPGviaMG(
			mgDocumentDescription = "${mgDocumentDescription}",
			mgDocumentFile = "${mgDocumentFile}",
			mgDocumentTitle = "${mgDocumentTitle}",
			mgFolderName = "${mgFolderName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		DMFolderDocument.editPGviaMG(
			mgDocumentDescriptionEdit = "${mgDocumentDescription} Edit",
			mgDocumentTitle = "${mgDocumentTitle}",
			mgDocumentTitleEdit = "${mgDocumentTitle} Edit",
			mgFolderName = "${mgFolderName}"
		);
	}

	@priority = "5"
	test RemovePortlet {
		Portlet.removePG(pageName = "${pageName}");
	}

	tearDown {
		DMFolder.tearDownPGviaMG(pageName = "${pageName}");

		Page.tearDownPG();
	}
}