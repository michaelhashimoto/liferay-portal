@component-name = "portal-document-management"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Documents Management";
	var pageName = "Documents and Media Display Page";
	var portletName = "Documents and Media Display";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");

		DMDPortlet.configureShowAllPG(pageName = "${pageName}");
	}

	@priority = "5"
	test AddDocument {
		var dmdDocumentFile = "Document_1.txt";
		var dmdDocumentSize = "0.3k";
		var dmdDocumentTitle = "DM Document Title";

		Page.gotoPG(pageName = "${pageName}");

		DMDocument.addPGviaDMD(
			dmdDocumentFile = "${dmdDocumentFile}",
			dmdDocumentSize = "${dmdDocumentSize}",
			dmdDocumentTitle = "${dmdDocumentTitle}"
		);
	}

	@priority = "5"
	test AddFolder {
		var dmdFolderName = "DM Folder Name";

		Page.gotoPG(pageName = "${pageName}");

		DMFolder.addPGviaDMD(dmdFolderName = "${dmdFolderName}");
	}

	@priority = "5"
	test DeleteDocuments {
		var dmdDocumentFile1 = "Document_1.txt";
		var dmdDocumentFile2 = "Document_2.txt";
		var dmdDocumentFile3 = "Document_3.txt";
		var dmdDocumentSize1 = "0.3k";
		var dmdDocumentSize2 = "0.5k";
		var dmdDocumentSize3 = "0.8k";
		var dmdDocumentTitle1 = "DM Document1 Title";
		var dmdDocumentTitle2 = "DM Document2 Title";
		var dmdDocumentTitle3 = "DM Document3 Title";

		Page.gotoPG(pageName = "${pageName}");

		DMDocument.addPGviaDMD(
			dmdDocumentFile = "${dmdDocumentFile1}",
			dmdDocumentSize = "${dmdDocumentSize1}",
			dmdDocumentTitle = "${dmdDocumentTitle1}"
		);

		Page.gotoPG(pageName = "${pageName}");

		DMDocument.addPGviaDMD(
			dmdDocumentFile = "${dmdDocumentFile2}",
			dmdDocumentSize = "${dmdDocumentSize2}",
			dmdDocumentTitle = "${dmdDocumentTitle2}"
		);

		Page.gotoPG(pageName = "${pageName}");

		DMDocument.addPGviaDMD(
			dmdDocumentFile = "${dmdDocumentFile3}",
			dmdDocumentSize = "${dmdDocumentSize3}",
			dmdDocumentTitle = "${dmdDocumentTitle3}"
		);

		Page.gotoPG(pageName = "${pageName}");

		DMDocument.deletePGviaDMD(dmdDocumentTitle = "${dmdDocumentTitle1}");

		DMDocument.deletePGviaDMD(dmdDocumentTitle = "${dmdDocumentTitle2}");

		DMDocument.deletePGviaDMD(dmdDocumentTitle = "${dmdDocumentTitle3}");

		AssertTextEquals(
			locator1 = "PGDocumentlibrarydisplay#INFO_MESSAGE",
			value1 = "There are no documents or media files in this folder."
		);
	}

	@priority = "5"
	test RemovePortlet {
		Portlet.removePG(pageName = "${pageName}");
	}

	@priority = "5"
	test SearchFolderDocument {
		var dmdDocumentFile = "Document_1.txt";
		var dmdDocumentSize = "0.3k";
		var dmdDocumentTitle = "DM Document Title";
		var dmdFolderName = "DM Folder Name";

		Page.gotoPG(pageName = "${pageName}");

		DMFolder.addPGviaDMD(dmdFolderName = "${dmdFolderName}");

		Page.gotoPG(pageName = "${pageName}");

		DMFolderDocument.addPGviaDMD(
			dmdDocumentFile = "${dmdDocumentFile}",
			dmdDocumentSize = "${dmdDocumentSize}",
			dmdDocumentTitle = "${dmdDocumentTitle}",
			dmdFolderName = "${dmdFolderName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		DMFolderDocument.searchPGviaDMD(
			dmdDocumentTitle = "${dmdDocumentTitle}",
			dmdDocumentTitleSearch = "${dmdDocumentTitle}",
			dmdFolderName = "${dmdFolderName}"
		);

		DMFolderDocument.searchNoPGviaDMD(
			dmdDocumentTitleSearch = "DM2 Document2 Title2"
		);

		DMFolderDocument.searchPGviaDMD(
			dmdDocumentTitle = "${dmdDocumentTitle}",
			dmdDocumentTitleSearch = "\&quot;${dmdDocumentTitle}\&quot;",
			dmdFolderName = "${dmdFolderName}"
		);

		DMFolderDocument.searchNoPGviaDMD(
			dmdDocumentTitleSearch = "\&quot;DM Document Title2\&quot;"
		);
	}

	tearDown {
		DMDocument.tearDownPGviaDMD(pageName = "${pageName}");

		DMFolder.tearDownPGviaDMD(pageName = "${pageName}");

		Page.tearDownPG();
	}
}