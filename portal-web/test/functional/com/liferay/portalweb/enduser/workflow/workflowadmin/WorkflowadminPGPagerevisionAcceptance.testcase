@component-name = "portal-workflow"
definition {
	property hook.plugins.includes = "kaleo-upgrade-hook";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Workflow";
	property web.plugins.includes = "kaleo-web";
	var siteName = "Site Name";
	var sitePageName = "Site Page Name";
	var sitePagePrivacy = "Public";
	var workflowAssetType = "Page Revision";

	setUp {
		User.firstLoginPG();

		Page.gotoCP(portletName = "Sites");

		Site.addCP(siteName = "${siteName}", siteType = "Blank");

		Page.gotoCP(portletName = "Sites");

		SitePage.addCP(
			siteName = "${siteName}",
			sitePageName = "${sitePageName}",
			sitePagePrivacy = "${sitePagePrivacy}"
		);

		Page.gotoCP(portletName = "Site Settings", siteScopeName = "${siteName}");

		Staging.activateStagingCP(
			pageVersioningEnabled = "true",
			siteName = "${siteName}"
		);

		Page.gotoCP(
			portletName = "Workflow Configuration",
			siteScopeName = "${siteName}"
		);

		Workflow.configureSiteWorkflow(
			workflowDefinition = "Single Approver (Version 1)",
			workflowResourceKey = "RESOURCE_TABLE_PAGE_REVISION_SELECT"
		);
	}

	@priority = "5"
	test ApprovePageRevisionPG {
		var pageName = "Page Revision Page";

		Page.addPGWithWorkflow(
			pageName = "${pageName}",
			pageStaging = "true",
			pageType = "Site"
		);

		Page.viewPGWithWorkflow(
			pageName = "${pageName}",
			pageStaging = "true",
			pageType = "Site",
			workflowStatus = "Pending (Review)"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.assignToMeTaskByActions(
			workflowAssetTitle = "${pageName}",
			workflowAssetType = "${workflowAssetType}",
			workflowTask = "Review"
		);

		Page.viewPGWithWorkflow(
			pageName = "${pageName}",
			pageStaging = "true",
			pageType = "Site",
			workflowStatus = "Pending (Review)"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.approveTaskByActions(
			workflowAssetTitle = "${pageName}",
			workflowAssetType = "${workflowAssetType}",
			workflowTask = "Review"
		);

		Page.viewPGWithWorkflow(
			pageName = "${pageName}",
			pageStaging = "true",
			pageType = "Site",
			workflowStatus = "Ready for Publication"
		);

		Page.gotoPG(pageName = "${pageName}", pageStaging = "true", pageType = "Site");

		Staging.publishToLiveNowPG();

		Page.viewPG(pageName = "${pageName}", pageType = "Site");
	}

	@priority = "5"
	test RejectPageRevisionPG {
		var pageName = "Page Revision Page";

		Page.addPGWithWorkflow(
			pageName = "${pageName}",
			pageStaging = "true",
			pageType = "Site"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.assignToMeTaskByActions(
			workflowAssetTitle = "${pageName}",
			workflowAssetType = "${workflowAssetType}",
			workflowTask = "Review"
		);

		Workflow.rejectTaskByActions(
			workflowAssetTitle = "${pageName}",
			workflowAssetType = "${workflowAssetType}",
			workflowTask = "Review"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.viewRejectTask(
			workflowAssetTitle = "${pageName}",
			workflowAssetType = "${workflowAssetType}"
		);

		Page.viewPGWithWorkflow(
			pageName = "${pageName}",
			pageStaging = "true",
			pageType = "Site",
			workflowStatus = "Pending (Update)"
		);

		Page.gotoPG(pageName = "${pageName}", pageStaging = "true", pageType = "Site");

		Staging.publishToLiveNowPG();

		Page.viewPGWithWorkflow(
			pageName = "${pageName}",
			pageStaging = "true",
			pageType = "Site",
			workflowStatus = "Pending (Update)"
		);
	}

	tearDown {
		Site.tearDownCP();

		Workflow.tearDownPortalWorkflow();

		Workflow.tearDownSiteWorkflow();
	}
}