@component-name = "portal-workflow"
definition {
	property hook.plugins.includes = "kaleo-upgrade-hook";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Workflow";
	property web.plugins.includes = "kaleo-web";

	setUp {
		User.firstLoginPG();

		Page.gotoCP(portletName = "Workflow Configuration");

		Workflow.configureSiteWorkflow(
			workflowDefinition = "Single Approver (Version 1)",
			workflowResourceKey = "RESOURCE_TABLE_WEB_CONTENT_SELECT"
		);
	}

	@priority = "5"
	test WithdrawTaskAssignedToMeByActions {
		var webContentContent = "WC WebContent Content";
		var webContentTitle = "WC WebContent Title";

		Page.gotoCP(portletName = "Web Content");

		WebContent.addCPWithWorkflow(
			webContentContent = "${webContentContent}",
			webContentTitle = "${webContentTitle}"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.assignToMeTaskByActions(
			workflowAssetTitle = "${webContentTitle}",
			workflowAssetType = "Web Content",
			workflowTask = "Review"
		);

		Page.gotoCP(portletName = "My Submissions");

		Workflow.withdrawTaskByActions(
			workflowAssetTitle = "${webContentTitle}",
			workflowAssetType = "Web Content",
			workflowDefinition = "Single Approver",
			workflowTask = "Review"
		);

		Page.gotoCP(portletName = "Web Content");

		WebContent.viewCPDraft(webContentTitle = "${webContentTitle}");
	}

	@priority = "5"
	test WithdrawTaskAssignedToMeByDetails {
		var webContentContent = "WC WebContent Content";
		var webContentTitle = "WC WebContent Title";

		Page.gotoCP(portletName = "Web Content");

		WebContent.addCPWithWorkflow(
			webContentContent = "${webContentContent}",
			webContentTitle = "${webContentTitle}"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.assignToMeTaskByDetails(
			workflowAssetContent = "${webContentContent}",
			workflowAssetTitle = "${webContentTitle}",
			workflowAssetType = "Web Content",
			workflowTask = "Review"
		);

		Page.gotoCP(portletName = "My Submissions");

		Workflow.withdrawTaskByDetails(
			workflowAssetContent = "${webContentContent}",
			workflowAssetTitle = "${webContentTitle}",
			workflowAssetType = "Web Content",
			workflowDefinition = "Single Approver",
			workflowTask = "Review"
		);

		Page.gotoCP(portletName = "Web Content");

		WebContent.viewCPDraft(webContentTitle = "${webContentTitle}");
	}

	@priority = "5"
	test WithdrawTaskAssignedToMyRolesByActions {
		var webContentContent = "WC WebContent Content";
		var webContentTitle = "WC WebContent Title";

		Page.gotoCP(portletName = "Web Content");

		WebContent.addCPWithWorkflow(
			webContentContent = "${webContentContent}",
			webContentTitle = "${webContentTitle}"
		);

		Page.gotoCP(portletName = "My Submissions");

		Workflow.withdrawTaskByActions(
			workflowAssetTitle = "${webContentTitle}",
			workflowAssetType = "Web Content",
			workflowDefinition = "Single Approver",
			workflowTask = "Review"
		);

		Page.gotoCP(portletName = "Web Content");

		WebContent.viewCPDraft(webContentTitle = "${webContentTitle}");
	}

	@priority = "5"
	test WithdrawTaskAssignedToMyRolesByDetails {
		var webContentContent = "WC WebContent Content";
		var webContentTitle = "WC WebContent Title";

		Page.gotoCP(portletName = "Web Content");

		WebContent.addCPWithWorkflow(
			webContentContent = "${webContentContent}",
			webContentTitle = "${webContentTitle}"
		);

		Page.gotoCP(portletName = "My Submissions");

		Workflow.withdrawTaskByDetails(
			workflowAssetContent = "${webContentContent}",
			workflowAssetTitle = "${webContentTitle}",
			workflowAssetType = "Web Content",
			workflowDefinition = "Single Approver",
			workflowTask = "Review"
		);

		Page.gotoCP(portletName = "Web Content");

		WebContent.viewCPDraft(webContentTitle = "${webContentTitle}");
	}

	@priority = "5"
	test WithdrawTaskCompletedNoByActions {
		var webContentContent = "WC WebContent Content";
		var webContentTitle = "WC WebContent Title";

		Page.gotoCP(portletName = "Web Content");

		WebContent.addCPWithWorkflow(
			webContentContent = "${webContentContent}",
			webContentTitle = "${webContentTitle}"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.assignToMeTaskByActions(
			workflowAssetTitle = "${webContentTitle}",
			workflowAssetType = "Web Content",
			workflowTask = "Review"
		);

		Workflow.approveTaskByActions(
			workflowAssetTitle = "${webContentTitle}",
			workflowAssetType = "Web Content",
			workflowTask = "Review"
		);

		Page.gotoCP(portletName = "My Submissions");

		Workflow.withdrawTaskCompletedNoByActions(
			workflowAssetTitle = "${webContentTitle}",
			workflowAssetType = "Web Content",
			workflowDefinition = "Single Approver",
			workflowTask = "Approved"
		);
	}

	@priority = "5"
	test WithdrawTaskCompletedNoByDetails {
		var webContentContent = "WC WebContent Content";
		var webContentTitle = "WC WebContent Title";

		Page.gotoCP(portletName = "Web Content");

		WebContent.addCPWithWorkflow(
			webContentContent = "${webContentContent}",
			webContentTitle = "${webContentTitle}"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.assignToMeTaskByDetails(
			workflowAssetContent = "${webContentContent}",
			workflowAssetTitle = "${webContentTitle}",
			workflowAssetType = "Web Content",
			workflowTask = "Review"
		);

		Workflow.approveTaskByDetails(
			workflowAssetContent = "${webContentContent}",
			workflowAssetTitle = "${webContentTitle}",
			workflowAssetType = "Web Content",
			workflowTask = "Review"
		);

		Page.gotoCP(portletName = "My Submissions");

		Workflow.withdrawTaskCompletedNoByDetails(
			workflowAssetContent = "${webContentContent}",
			workflowAssetTitle = "${webContentTitle}",
			workflowAssetType = "Web Content",
			workflowDefinition = "Single Approver",
			workflowTask = "Approved"
		);
	}

	tearDown {
		WebContent.tearDownCP();

		Workflow.tearDownPortalWorkflow();

		Workflow.tearDownSiteWorkflow();
	}
}