@component-name = "portal-workflow"
definition {
	property hook.plugins.includes = "kaleo-upgrade-hook";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Workflow";
	property web.plugins.includes = "kaleo-web";
	var pageName = "Message Boards Page";
	var portletName = "Message Boards";
	var workflowAssetType = "Message Boards Message";

	setUp {
		User.firstLoginPG();

		Page.gotoCP(portletName = "Workflow Configuration");

		Workflow.configureSiteWorkflow(
			workflowDefinition = "Single Approver (Version 1)",
			workflowResourceKey = "RESOURCE_TABLE_MESSAGE_BOARDS_MESSAGE_SELECT"
		);

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");
	}

	@priority = "5"
	test ApproveMessageBoardsThreadPG {
		var threadBody = "MB Thread Body";
		var threadSubject = "MB Thread Subject";

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.addPGWithWorkflow(
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}"
		);

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.viewPGWithWorkflow(
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}",
			workflowTask = "Review"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.assignToMeTaskByActions(
			workflowAssetTitle = "${threadSubject}",
			workflowAssetType = "${workflowAssetType}",
			workflowTask = "Review"
		);

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.viewPGWithWorkflow(
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}",
			workflowTask = "Review"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.approveTaskByActions(
			workflowAssetTitle = "${threadSubject}",
			workflowAssetType = "${workflowAssetType}",
			workflowTask = "Review"
		);

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.viewPG(
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}"
		);
	}

	@priority = "5"
	test RejectMessageBoardsThreadPG {
		var threadBody = "MB Thread Body";
		var threadSubject = "MB Thread Subject";

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.addPGWithWorkflow(
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.assignToMeTaskByActions(
			workflowAssetTitle = "${threadSubject}",
			workflowAssetType = "${workflowAssetType}",
			workflowTask = "Review"
		);

		Workflow.rejectTaskByActions(
			workflowAssetTitle = "${threadSubject}",
			workflowAssetType = "${workflowAssetType}",
			workflowTask = "Review"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.viewRejectTask(
			workflowAssetTitle = "${threadSubject}",
			workflowAssetType = "${workflowAssetType}"
		);

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.viewPGWithWorkflow(
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}",
			workflowTask = "Update"
		);
	}

	tearDown {
		MessageboardsThread.tearDownPG(pageName = "${pageName}");

		Page.tearDownPG();

		Workflow.tearDownPortalWorkflow();

		Workflow.tearDownSiteWorkflow();
	}
}