@component-name = "portal-workflow"
definition {
	property hook.plugins.includes = "kaleo-upgrade-hook";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Workflow";
	property web.plugins.includes = "kaleo-web";

	setUp {
		User.firstLoginPG();

		Page.gotoCP(portletName = "Workflow Configuration");

		Workflow.configureSiteWorkflow(
			workflowDefinition = "Single Approver (Version 1)",
			workflowResourceKey = "RESOURCE_TABLE_BLOGS_ENTRY_SELECT"
		);
	}

	@priority = "5"
	test ApproveTaskByDetails {
		var entryContent = "Blogs Entry Content";
		var entryTitle = "Blogs Entry Title";

		Page.gotoCP(portletName = "Blogs");

		BlogsEntry.addCPWithWorkflow(
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.assignToMeTaskByActions(
			workflowAssetTitle = "${entryTitle}",
			workflowAssetType = "Blogs Entry",
			workflowTask = "Review"
		);

		Workflow.approveTaskByDetails(
			workflowAssetContent = "${entryContent}",
			workflowAssetTitle = "${entryTitle}",
			workflowAssetType = "Blogs Entry",
			workflowTask = "Review"
		);

		Page.gotoCP(portletName = "Blogs");

		BlogsEntry.viewCP(
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}"
		);
	}

	@priority = "5"
	test AssignToMeTaskByDetails {
		var entryContent = "Blogs Entry Content";
		var entryTitle = "Blogs Entry Title";

		Page.gotoCP(portletName = "Blogs");

		BlogsEntry.addCPWithWorkflow(
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.assignToMeTaskByDetails(
			workflowAssetContent = "${entryContent}",
			workflowAssetTitle = "${entryTitle}",
			workflowAssetType = "Blogs Entry",
			workflowTask = "Review"
		);

		Page.gotoCP(portletName = "Blogs");

		BlogsEntry.viewCPWithWorkflow(
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}"
		);
	}

	@priority = "5"
	test RejectTaskByDetails {
		var entryContent = "Blogs Entry Content";
		var entryTitle = "Blogs Entry Title";

		Page.gotoCP(portletName = "Blogs");

		BlogsEntry.addCPWithWorkflow(
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.assignToMeTaskByActions(
			workflowAssetTitle = "${entryTitle}",
			workflowAssetType = "Blogs Entry",
			workflowTask = "Review"
		);

		Workflow.rejectTaskByDetails(
			workflowAssetContent = "${entryContent}",
			workflowAssetTitle = "${entryTitle}",
			workflowAssetType = "Blogs Entry",
			workflowTask = "Review"
		);

		Page.gotoCP(portletName = "My Workflow Tasks");

		Workflow.viewRejectTask(
			workflowAssetTitle = "${entryTitle}",
			workflowAssetType = "Blogs Entry"
		);

		Page.gotoCP(portletName = "Blogs");

		BlogsEntry.viewCPWithWorkflow(
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}"
		);
	}

	tearDown {
		BlogsEntry.tearDownCP();

		Workflow.tearDownPortalWorkflow();

		Workflow.tearDownSiteWorkflow();
	}
}