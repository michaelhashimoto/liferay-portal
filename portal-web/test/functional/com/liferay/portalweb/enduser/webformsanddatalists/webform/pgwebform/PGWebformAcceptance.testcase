@component-name = "portal-web-forms-and-data-lists"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property portlet.plugins.includes = "web-form-portlet";
	property testray.main.component.name = "Web Forms and Data Lists";
	var pageName = "Web Form Test Page";
	var portletName = "Web Form";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");
	}

	@priority = "5"
	test ConfigureWebform {
		var webFormFieldsComments = "Comments";
		var webFormFieldsCommentsEdit = "Additional Comments";
		var webFormFieldsName = "Name";
		var webFormFieldsNameEdit = "Your Name";
		var webFormFieldsRating = "Rating";
		var webFormFieldsRatingEdit = "Rate Us!";
		var webFormInformationDescription = "Your input is valuable to us. Please send us your suggestions.";
		var webFormInformationDescriptionEdit = "Please let us know what you think!";
		var webFormInformationTitle = "Suggestions";
		var webFormInformationTitleEdit = "Feed Back";

		Page.gotoPG(pageName = "${pageName}");

		WebformPortlet.configureWebformPG(
			webFormFieldsComments = "${webFormFieldsComments}",
			webFormFieldsCommentsEdit = "${webFormFieldsCommentsEdit}",
			webFormFieldsName = "${webFormFieldsName}",
			webFormFieldsNameEdit = "${webFormFieldsNameEdit}",
			webFormFieldsRating = "${webFormFieldsRating}",
			webFormFieldsRatingEdit = "${webFormFieldsRatingEdit}",
			webFormInformationDescription = "${webFormInformationDescription}",
			webFormInformationDescriptionEdit = "${webFormInformationDescriptionEdit}",
			webFormInformationTitle = "${webFormInformationTitle}",
			webFormInformationTitleEdit = "${webFormInformationTitleEdit}"
		);

		Page.gotoPG(pageName = "${pageName}");

		WebformPortlet.viewConfigureWebformPG(
			webFormFieldsComments = "${webFormFieldsComments}",
			webFormFieldsCommentsEdit = "${webFormFieldsCommentsEdit}",
			webFormFieldsName = "${webFormFieldsName}",
			webFormFieldsNameEdit = "${webFormFieldsNameEdit}",
			webFormFieldsRating = "${webFormFieldsRating}",
			webFormFieldsRatingEdit = "${webFormFieldsRatingEdit}",
			webFormInformationDescription = "${webFormInformationDescription}",
			webFormInformationDescriptionEdit = "${webFormInformationDescriptionEdit}",
			webFormInformationTitle = "${webFormInformationTitle}",
			webFormInformationTitleEdit = "${webFormInformationTitleEdit}"
		);
	}

	tearDown {
		Page.tearDownPG();
	}
}