@component-name = "portal-web-forms-and-data-lists"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Web Forms and Data Lists";

	setUp {
		User.firstLoginPG();
	}

	tearDown {
		List.tearDownCP();

		DataDefinition.tearDownCP();
	}

	@priority = "5"
	test AddDataDefinition {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionName = "Data Definition Name";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.viewCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);
	}

	@priority = "5"
	test AddList {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionName = "Data Definition Name";
		var listDescription = "List Description";
		var listName = "List Name";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoCP(portletName = "Dynamic Data Lists");

		List.addCP(
			dataDefinitionName = "${dataDefinitionName}",
			listDescription = "${listDescription}",
			listName = "${listName}"
		);

		List.viewCP(listDescription = "${listDescription}", listName = "${listName}");
	}

	@priority = "5"
	test AddRecord {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionName = "Data Definition Name";
		var listDescription = "List Description";
		var listName = "List Name";
		var recordText = "Text Field";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoCP(portletName = "Dynamic Data Lists");

		List.addCP(
			dataDefinitionName = "${dataDefinitionName}",
			listDescription = "${listDescription}",
			listName = "${listName}"
		);

		ListRecord.addCP(listName = "${listName}", recordText = "${recordText}");

		Page.gotoCP(portletName = "Dynamic Data Lists");

		ListRecord.viewCP(listName = "${listName}", recordText = "${recordText}");

		Page.gotoCP(portletName = "Dynamic Data Lists");

		ListRecord.spreadsheetViewCP(
			listName = "${listName}",
			recordText = "${recordText}"
		);
	}

	@priority = "5"
	test DeleteDataDefinition {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionName = "Data Definition Name";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.deleteCP(dataDefinitionName = "${dataDefinitionName}");
	}

	@priority = "5"
	test DeleteList {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionName = "Data Definition Name";
		var listDescription = "List Description";
		var listName = "List Name";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoCP(portletName = "Dynamic Data Lists");

		List.addCP(
			dataDefinitionName = "${dataDefinitionName}",
			listDescription = "${listDescription}",
			listName = "${listName}"
		);

		List.deleteCP(listName = "${listName}");
	}

	@priority = "5"
	test DeleteRecord {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionName = "Data Definition Name";
		var listDescription = "List Description";
		var listName = "List Name";
		var recordText = "Text Field";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoCP(portletName = "Dynamic Data Lists");

		List.addCP(
			dataDefinitionName = "${dataDefinitionName}",
			listDescription = "${listDescription}",
			listName = "${listName}"
		);

		ListRecord.addCP(listName = "${listName}", recordText = "${recordText}");

		Page.gotoCP(portletName = "Dynamic Data Lists");

		ListRecord.deleteCP(listName = "${listName}");
	}

	@priority = "5"
	test EditDataDefinition {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionDescriptionEdit = "Data Definition Description Edit";
		var dataDefinitionName = "Data Definition Name";
		var dataDefinitionNameEdit = "Data Definition Edit";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.editCP(
			dataDefinitionDescriptionEdit = "${dataDefinitionDescriptionEdit}",
			dataDefinitionName = "${dataDefinitionName}",
			dataDefinitionNameEdit = "${dataDefinitionNameEdit}"
		);

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.viewCP(
			dataDefinitionDescription = "${dataDefinitionDescriptionEdit}",
			dataDefinitionName = "${dataDefinitionNameEdit}"
		);
	}

	@priority = "5"
	test EditList {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionName = "Data Definition Name";
		var listDescription = "List Description";
		var listDescriptionEdit = "List Description Edit";
		var listName = "List Name";
		var listNameEdit = "List Name Edit";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoCP(portletName = "Dynamic Data Lists");

		List.addCP(
			dataDefinitionName = "${dataDefinitionName}",
			listDescription = "${listDescription}",
			listName = "${listName}"
		);

		List.editCP(
			listDescription = "${listDescription}",
			listDescriptionEdit = "${listDescriptionEdit}",
			listName = "${listName}",
			listNameEdit = "${listNameEdit}"
		);

		List.viewCP(
			listDescription = "${listDescriptionEdit}",
			listName = "${listNameEdit}"
		);
	}

	@priority = "5"
	test EditRecord {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionName = "Data Definition Name";
		var listDescription = "List Description";
		var listName = "List Name";
		var recordText = "Text Field";
		var recordTextEdit = "Text Field Edit";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoCP(portletName = "Dynamic Data Lists");

		List.addCP(
			dataDefinitionName = "${dataDefinitionName}",
			listDescription = "${listDescription}",
			listName = "${listName}"
		);

		ListRecord.addCP(listName = "${listName}", recordText = "${recordText}");

		Page.gotoCP(portletName = "Dynamic Data Lists");

		ListRecord.editCP(
			listName = "${listName}",
			recordTextEdit = "${recordTextEdit}"
		);

		Page.gotoCP(portletName = "Dynamic Data Lists");

		ListRecord.viewCP(listName = "${listName}", recordText = "${recordTextEdit}");
	}
}