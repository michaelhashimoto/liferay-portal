@component-name = "portal-web-forms-and-data-lists"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Web Forms and Data Lists";
	var pageName = "Dynamic Data List Display Page";
	var portletName = "Dynamic Data List Display";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");
	}

	tearDown {
		List.tearDownCP();

		DataDefinition.tearDownCP();

		Page.tearDownPG();
	}

	@priority = "5"
	test AddList {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionName = "Data Definition Name";
		var listDescription = "List Description";
		var listName = "List Name";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		List.addPG(
			dataDefinitionName = "${dataDefinitionName}",
			listDescription = "${listDescription}",
			listName = "${listName}",
			pageName = "${pageName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		List.viewPG(listName = "${listName}", pageName = "${pageName}");
	}

	@priority = "5"
	test AddRecord {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionName = "Data Definition Name";
		var listDescription = "List Description";
		var listName = "List Name";
		var recordText = "Text";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		List.addPG(
			dataDefinitionName = "${dataDefinitionName}",
			listDescription = "${listDescription}",
			listName = "${listName}",
			pageName = "${pageName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		ListRecord.addPG(
			listName = "${listName}",
			pageName = "${pageName}",
			recordText = "${recordText}"
		);

		ListRecord.viewPG(
			listName = "${listName}",
			pageName = "${pageName}",
			recordText = "${recordText}"
		);
	}

	@priority = "5"
	test DeleteList {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionName = "Data Definition Name";
		var listDescription = "List Description";
		var listDescriptionEdit = "List Description Edit";
		var listName = "List Name";
		var listNameEdit = "List Name Edit";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoCP(portletName = "Dynamic Data Lists");

		List.addCP(
			dataDefinitionName = "${dataDefinitionName}",
			listDescription = "${listDescription}",
			listName = "${listName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		List.deletePG(listName = "${listName}", pageName = "${pageName}");
	}

	@priority = "5"
	test DeleteRecord {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionName = "Data Definition Name";
		var listDescription = "List Description";
		var listName = "List Name";
		var recordText = "Text";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		List.addPG(
			dataDefinitionName = "${dataDefinitionName}",
			listDescription = "${listDescription}",
			listName = "${listName}",
			pageName = "${pageName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		ListRecord.addPG(
			listName = "${listName}",
			pageName = "${pageName}",
			recordText = "${recordText}"
		);

		ListRecord.deletePG(pageName = "${pageName}");
	}

	@priority = "5"
	test EditList {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionName = "Data Definition Name";
		var listDescription = "List Description";
		var listDescriptionEdit = "List Description Edit";
		var listName = "List Name";
		var listNameEdit = "List Name Edit";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		List.addPG(
			dataDefinitionName = "${dataDefinitionName}",
			listDescription = "${listDescription}",
			listName = "${listName}",
			pageName = "${pageName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		List.editPG(
			listDescriptionEdit = "${listDescriptionEdit}",
			listName = "${listName}",
			listNameEdit = "${listNameEdit}",
			pageName = "${pageName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		List.viewPG(listName = "${listNameEdit}", pageName = "${pageName}");
	}

	@priority = "5"
	test EditRecord {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionName = "Data Definition Name";
		var listDescription = "List Description";
		var listName = "List Name";
		var recordText = "Text";
		var recordTextEdit = "Text Edit";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		List.addPG(
			dataDefinitionName = "${dataDefinitionName}",
			listDescription = "${listDescription}",
			listName = "${listName}",
			pageName = "${pageName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		ListRecord.addPG(
			listName = "${listName}",
			pageName = "${pageName}",
			recordText = "${recordText}"
		);

		ListRecord.editPG(
			listName = "${listName}",
			pageName = "${pageName}",
			recordTextEdit = "${recordTextEdit}"
		);

		ListRecord.viewPG(
			listName = "${listName}",
			pageName = "${pageName}",
			recordText = "${recordTextEdit}"
		);
	}

	@priority = "5"
	test SelectList {
		var dataDefinitionDescription = "Data Definition Description";
		var dataDefinitionName = "Data Definition Name";
		var listDescription = "List Description";
		var listName = "List Name";

		Page.gotoCP(portletName = "Dynamic Data Lists");

		DataDefinition.addCP(
			dataDefinitionDescription = "${dataDefinitionDescription}",
			dataDefinitionName = "${dataDefinitionName}"
		);

		Page.gotoCP(portletName = "Dynamic Data Lists");

		List.addCP(
			dataDefinitionName = "${dataDefinitionName}",
			listDescription = "${listDescription}",
			listName = "${listName}"
		);

		Page.gotoPG(pageName = "${pageName}");

		List.selectPG(listName = "${listName}", pageName = "${pageName}");

		Page.gotoPG(pageName = "${pageName}");

		List.viewPG(listName = "${listName}", pageName = "${pageName}");
	}
}