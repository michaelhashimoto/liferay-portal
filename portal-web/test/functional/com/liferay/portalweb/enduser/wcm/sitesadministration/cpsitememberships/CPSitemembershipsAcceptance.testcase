@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "WCM";

	setUp {
		User.firstLoginPG();
	}

	@priority = "5"
	test AddMember {
		var siteName = "Site Name";
		var userEmailAddress = "userea@liferay.com";
		var userFirstName = "userfn";
		var userLastName = "userln";
		var userScreenName = "usersn";

		Page.gotoCP(portletName = "Users and Organizations");

		User.addCP(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Sites");

		Site.addMemberCP(
			siteName = "${siteName}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);
	}

	@priority = "5"
	test AddTeam {
		var siteName = "Site Name";
		var teamDescription = "Site Team Description";
		var teamName = "Site Team Name";

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Sites");

		Team.addCP(teamDescription = "${teamDescription}", teamName = "${teamName}");
	}

	@priority = "5"
	test AssignMembersSiteTeamUser {
		var siteName = "Site Name";
		var teamDescription = "Site Team Description";
		var teamName = "Site Team Name";
		var userEmailAddress = "userea@liferay.com";
		var userFirstName = "userfn";
		var userLastName = "userln";
		var userScreenName = "usersn";

		Page.gotoCP(portletName = "Users and Organizations");

		User.addCP(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Sites");

		Team.addCP(teamDescription = "${teamDescription}", teamName = "${teamName}");

		Page.gotoCP(portletName = "Sites");

		Site.addMemberCP(
			siteName = "${siteName}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Sites");

		Team.assignMembersCP(
			siteName = "${siteName}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);
	}

	@priority = "5"
	test RemoveMember {
		var siteName = "Site Name";
		var userEmailAddress = "userea@liferay.com";
		var userFirstName = "userfn";
		var userLastName = "userln";
		var userScreenName = "usersn";

		Page.gotoCP(portletName = "Users and Organizations");

		User.addCP(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Sites");

		Site.addMemberCP(
			siteName = "${siteName}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Sites");

		Site.removeMemberCP(
			siteName = "${siteName}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);
	}

	tearDown {
		Site.tearDownCP();

		User.tearDownCP();
	}
}