@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "WCM";

	setUp {
		User.firstLoginPG();
	}

	@priority = "5"
	test AddSitePrivateChildPage {
		var siteChildPageName = "Site Child Page";
		var siteGuestName = "Liferay";
		var siteName = "Site Name";
		var sitePageName = "Site Page";
		var sitePagePrivacy = "Private";
		var sitePageURL = "http://localhost:8080/group/site-name/site-child-page";

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Sites");

		SitePage.addCP(
			siteName = "${siteName}",
			sitePageName = "${sitePageName}",
			sitePagePrivacy = "${sitePagePrivacy}"
		);

		Page.gotoCP(portletName = "Sites");

		SitePage.addChildCP(
			siteChildPageName = "${siteChildPageName}",
			siteName = "${siteName}",
			sitePageName = "${sitePageName}",
			sitePagePrivacy = "${sitePagePrivacy}"
		);

		Page.gotoPG(
			pageAccess = "Private",
			pageName = "${sitePageName}",
			pageType = "Site"
		);

		SitePage.viewChildPG(
			siteChildPageName = "${siteChildPageName}",
			siteGuestName = "${siteGuestName}",
			siteName = "${siteName}",
			sitePageName = "${sitePageName}",
			sitePageURL = "${sitePageURL}"
		);
	}

	@priority = "5"
	test AddSitePrivatePage {
		var siteGuestName = "Liferay";
		var siteName = "Site Name";
		var sitePageName = "Site Page";
		var sitePagePrivacy = "Private";
		var sitePageURL = "http://localhost:8080/group/site-name/site-page";

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Sites");

		SitePage.addCP(
			siteName = "${siteName}",
			sitePageName = "${sitePageName}",
			sitePagePrivacy = "${sitePagePrivacy}"
		);

		Page.gotoPG(
			pageAccess = "Private",
			pageName = "${sitePageName}",
			pageType = "Site"
		);

		SitePage.viewPG(
			siteGuestName = "${siteGuestName}",
			siteName = "${siteName}",
			sitePageName = "${sitePageName}",
			sitePageURL = "${sitePageURL}"
		);
	}

	@priority = "5"
	test AddSitePrivatePagePortlet {
		var pageName = "Blogs Page";
		var portletName = "Blogs";
		var siteName = "Site Name";
		var sitePageName = "Site Page";
		var sitePagePrivacy = "Private";

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Sites");

		SitePage.addCP(
			siteName = "${siteName}",
			sitePageName = "${sitePageName}",
			sitePagePrivacy = "${sitePagePrivacy}"
		);

		Page.addPG(pageAccess = "Private", pageName = "${pageName}", pageType = "Site");

		Portlet.addPG(
			pageAccess = "Private",
			pageName = "${pageName}",
			pageType = "Site",
			portletName = "${portletName}"
		);
	}

	@priority = "5"
	test AddSitePublicChildPage {
		var siteChildPageName = "Site Child Page";
		var siteGuestName = "Liferay";
		var siteName = "Site Name";
		var sitePageName = "Site Page";
		var sitePagePrivacy = "Public";
		var sitePageURL = "http://localhost:8080/web/site-name/site-child-page";

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Sites");

		SitePage.addCP(
			siteName = "${siteName}",
			sitePageName = "${sitePageName}",
			sitePagePrivacy = "${sitePagePrivacy}"
		);

		Page.gotoCP(portletName = "Sites");

		SitePage.addChildCP(
			siteChildPageName = "${siteChildPageName}",
			siteName = "${siteName}",
			sitePageName = "${sitePageName}",
			sitePagePrivacy = "${sitePagePrivacy}"
		);

		Page.gotoPG(pageName = "${sitePageName}", pageType = "Site");

		SitePage.viewChildPG(
			siteChildPageName = "${siteChildPageName}",
			siteGuestName = "${siteGuestName}",
			siteName = "${siteName}",
			sitePageName = "${sitePageName}",
			sitePageURL = "${sitePageURL}"
		);
	}

	@priority = "5"
	test AddSitePublicPage {
		var siteGuestName = "Liferay";
		var siteName = "Site Name";
		var sitePageName = "Site Page";
		var sitePagePrivacy = "Public";
		var sitePageURL = "http://localhost:8080/web/site-name/site-page";

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Sites");

		SitePage.addCP(
			siteName = "${siteName}",
			sitePageName = "${sitePageName}",
			sitePagePrivacy = "${sitePagePrivacy}"
		);

		Page.gotoPG(pageName = "${sitePageName}", pageType = "Site");

		SitePage.viewPG(
			siteGuestName = "${siteGuestName}",
			siteName = "${siteName}",
			sitePageName = "${sitePageName}",
			sitePageURL = "${sitePageURL}"
		);
	}

	@priority = "5"
	test AddSitePublicPagePortlet {
		var pageName = "Blogs Page";
		var portletName = "Blogs";
		var siteName = "Site Name";
		var sitePageName = "Site Page";
		var sitePagePrivacy = "Public";

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Sites");

		SitePage.addCP(
			siteName = "${siteName}",
			sitePageName = "${sitePageName}",
			sitePagePrivacy = "${sitePagePrivacy}"
		);

		Page.addPG(pageName = "${pageName}", pageType = "Site");

		Portlet.addPG(
			pageName = "${pageName}",
			pageType = "Site",
			portletName = "${portletName}"
		);
	}

	tearDown {
		Site.tearDownCP();
	}
}