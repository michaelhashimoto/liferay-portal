@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "WCM";

	setUp {
		User.firstLoginPG();
	}

	@priority = "5"
	test AddSite {
		var siteName = "Site Name";

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Sites");

		Site.viewCP(siteName = "${siteName}");
	}

	@priority = "5"
	test CannotJoinPrivateSiteAsUser {
		var membershipType = "Private";
		var siteName = "Site Name";
		var userEmailAddress = "userea@liferay.com";
		var userFirstName = "userfn";
		var userLastName = "userln";
		var userScreenName = "usersn";

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(membershipType = "${membershipType}", siteName = "${siteName}");

		Page.gotoCP(portletName = "Users and Organizations");

		User.addCP(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Users and Organizations");

		User.editPasswordCP(
			userEmailAddress = "${userEmailAddress}",
			userScreenName = "${userScreenName}"
		);

		User.logoutPG();

		User.loginPG(password = "test", userEmailAddress = "${userEmailAddress}");

		Open(locator1 = "/user/${userScreenName}/home");

		AssertTextEquals(
			locator1 = "PGPersonalsiteMysites#MY_SITES_INFO_MESSAGE",
			value1 = "No sites were found."
		);

		AssertClick.assertTextClickAt(
			locator1 = "PGPersonalsiteMysites#MY_SITES_AVAILABLE_SITES",
			value1 = "Available Sites"
		);

		AssertTextNotPresent(value1 = "${siteName}");

		Type(
			locator1 = "PGPersonalsiteAvailablesites#AVAILABLE_SITES_SEARCH_FIELD",
			value1 = "${siteName}"
		);

		AssertClick.assertValueClickAt(
			locator1 = "PGPersonalsiteAvailablesites#AVAILABLE_SITES_SEARCH_BUTTON",
			value1 = "Search"
		);

		AssertTextNotPresent(value1 = "${siteName}");
	}

	@priority = "5"
	test DeleteSite {
		var siteName = "Site Name";

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Sites");

		Site.deleteCP(siteName = "${siteName}");
	}

	@priority = "5"
	test ImportLARSite {
		var file = "Sites_Public_Pages.lar";
		var pageName = "Message Boards Page";
		var portletName = "Message Boards";
		var siteName = "Site Name";
		var sitePageName = "Site Page";
		var sitePagePrivacy = "Public";
		var threadBody = "MB Thread Message Body";
		var threadReplyBody = "MB Thread Reply Body";
		var threadSubject = "MB Thread Message Subject";

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Sites");

		SitePage.addCP(
			siteName = "${siteName}",
			sitePageName = "${sitePageName}",
			sitePagePrivacy = "${sitePagePrivacy}"
		);

		Page.addPG(pageName = "${pageName}", pageType = "Site");

		Portlet.addPG(
			pageName = "${pageName}",
			pageType = "Site",
			portletName = "${portletName}"
		);

		Page.gotoPG(pageName = "${pageName}", pageType = "Site");

		MessageboardsThread.addPG(
			siteName = "${siteName}",
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}"
		);

		Page.gotoPG(pageName = "${pageName}", pageType = "Site");

		MessageboardsThread.replyPG(
			siteName = "${siteName}",
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}"
		);

		Page.gotoPG(pageName = "${pageName}", pageType = "Site");

		MessageboardsThread.viewReplyPG(
			threadBody = "${threadBody}",
			threadReplyBody = "${threadReplyBody}",
			threadSubject = "${threadSubject}"
		);

		Page.gotoCP(portletName = "Site Pages", siteScopeName = "${siteName}");

		SitePage.exportLarCP(file = "${file}", siteName = "${siteName}");

		Site.tearDownCP();

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Site Pages", siteScopeName = "${siteName}");

		SitePage.importLarCP(file = "${file}", siteName = "${siteName}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Site");

		MessageboardsThread.viewReplyPG(
			threadBody = "${threadBody}",
			threadReplyBody = "${threadReplyBody}",
			threadSubject = "${threadSubject}"
		);
	}

	tearDown {
		User.firstLoginPG();

		User.tearDownCP();

		Site.tearDownCP();
	}
}