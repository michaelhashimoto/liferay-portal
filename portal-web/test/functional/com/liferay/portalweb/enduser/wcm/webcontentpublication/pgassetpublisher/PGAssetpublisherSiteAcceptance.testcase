@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "WCM";

	setUp {
		User.firstLoginPG();
	}

	@priority = "5"
	test AddPortletAssetPublisherSite {
		var pageName = "Asset Publisher Page";
		var portletName = "Asset Publisher";
		var siteName = "Site Name";
		var sitePagePrivacy = "Public";

		Page.gotoCP(portletName = "Sites");

		Site.addBlankCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Sites");

		SitePage.addCP(
			siteName = "${siteName}",
			sitePageName = "${pageName}",
			sitePagePrivacy = "${sitePagePrivacy}"
		);

		Portlet.addPG(
			pageName = "${pageName}",
			pageType = "Site",
			portletName = "${portletName}"
		);
	}

	tearDown {
		Site.tearDownCP();
	}
}