@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property portlet.plugins.includes = "test-localized-portlet";
	property testray.main.component.name = "WCM";
	var pageName = "Test Localization";
	var portletName = "Test Localized Portlet";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");
	}

	@known-issues = "LPS-45313"
	@priority = "5"
	test CheckLocalizationChinese {
		Click(locator1 = "PGTestlocalization#CHINESE_LOCALIZATION");

		AssertTextEquals(
			locator1 = "PGTestlocalization#LOCALIZATION_TEST_1",
			value1 = "PASSED"
		);

		AssertTextEquals(
			locator1 = "PGTestlocalization#LOCALIZATION_TEST_2",
			value1 = "PASSED"
		);

		AssertTextEquals(
			locator1 = "PGTestlocalization#LOCALIZATION_TEST_3",
			value1 = "PASSED"
		);

		AssertTextEquals(
			locator1 = "PGTestlocalization#LOCALIZATION_TEST_4",
			value1 = "PASSED"
		);

		AssertTextEquals(
			locator1 = "PGTestlocalization#LOCALIZATION_TEST_5",
			value1 = "PASSED"
		);

		AssertTextEquals(
			locator1 = "PGTestlocalization#LOCALIZATION_TEST_6",
			value1 = "PASSED"
		);

		AssertTextEquals(
			locator1 = "PGTestlocalization#LOCALIZATION_TEST_7",
			value1 = "PASSED"
		);

		AssertTextEquals(
			locator1 = "PGTestlocalization#LOCALIZATION_TEST_8",
			value1 = "PASSED"
		);

		AssertTextEquals(
			locator1 = "PGTestlocalization#LOCALIZATION_TEST_9",
			value1 = "PASSED"
		);

		AssertTextEquals(
			locator1 = "PGTestlocalization#LOCALIZATION_TEST_10",
			value1 = "PASSED"
		);

		AssertTextEquals(
			locator1 = "PGTestlocalization#LOCALIZATION_TEST_11",
			value1 = "PASSED"
		);

		AssertTextEquals(
			locator1 = "PGTestlocalization#LOCALIZATION_TEST_12",
			value1 = "PASSED"
		);

		AssertTextEquals(
			locator1 = "PGTestlocalization#LOCALIZATION_TEST_13",
			value1 = "PASSED"
		);

		AssertTextEquals(
			locator1 = "PGTestlocalization#LOCALIZATION_TEST_14",
			value1 = "PASSED"
		);

		AssertTextNotPresent(value1 = "FAILED");
	}

