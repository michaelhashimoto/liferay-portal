@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "WCM";

	setUp {
		User.firstLoginPG();
	}

	tearDown {
		WebContent.tearDownCP();

		WebContentTemplates.tearDownCP();

		WebContentStructures.tearDownCP();
	}

	@priority = "5"
	test AddStructure {
		var structureDescription = "WC Structure Description";
		var structureName = "WC Structure Name";

		Page.gotoCP(portletName = "Web Content");

		WebContentStructures.addCP(
			structureDescription = "${structureDescription}",
			structureName = "${structureName}"
		);
	}

	@priority = "5"
	test AddTemplate {
		var templateDescription = "WC Template Description";
		var templateName = "WC Template Name";

		Page.gotoCP(portletName = "Web Content");

		WebContentTemplates.addCP(
			templateDescription = "${templateDescription}",
			templateName = "${templateName}"
		);
	}

	@priority = "5"
	test AddTemplateStructure {
		var structureDescription = "WC Structure Description";
		var structureName = "WC Structure Name";
		var templateDescription = "WC Template Description";
		var templateName = "WC Template Name";

		Page.gotoCP(portletName = "Web Content");

		WebContentStructures.addCP(
			structureDescription = "${structureDescription}",
			structureName = "${structureName}"
		);

		Page.gotoCP(portletName = "Web Content");

		WebContentTemplates.addCP(
			structureDescription = "${structureDescription}",
			structureName = "${structureName}",
			templateDescription = "${templateDescription}",
			templateName = "${templateName}"
		);
	}

	@priority = "5"
	test AddWebContent {
		var webContentContent = "WC WebContent Content";
		var webContentTitle = "WC WebContent Title";

		Page.gotoCP(portletName = "Web Content");

		WebContent.addCP(
			webContentContent = "${webContentContent}",
			webContentTitle = "${webContentTitle}"
		);
	}

	@priority = "5"
	test AddWebContentStructure {
		var structureDescription = "WC Structure Description";
		var structureName = "WC Structure Name";
		var templateDescription = "WC Template Description";
		var templateName = "WC Template Name";
		var webContentText = "WC WebContent Text";
		var webContentTitle = "WC WebContent Title";

		Page.gotoCP(portletName = "Web Content");

		WebContentStructures.addCP(
			structureDescription = "${structureDescription}",
			structureName = "${structureName}"
		);

		Page.gotoCP(portletName = "Web Content");

		WebContentTemplates.addCP(
			structureDescription = "${structureDescription}",
			structureName = "${structureName}",
			templateDescription = "${templateDescription}",
			templateName = "${templateName}"
		);

		Page.gotoCP(portletName = "Web Content");

		WebContent.addCPwithStructure(
			structureName = "${structureName}",
			templateName = "${templateName}",
			webContentText = "${webContentText}",
			webContentTitle = "${webContentTitle}"
		);
	}
}