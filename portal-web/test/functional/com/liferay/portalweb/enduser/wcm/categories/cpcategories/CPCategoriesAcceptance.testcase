@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "WCM";

	setUp {
		User.firstLoginPG();
	}

	@priority = "5"
	test AddCategory {
		var categoryName = "Category Name";
		var vocabularyName = "Vocabulary Name";

		Page.gotoCP(portletName = "Categories");

		Vocabulary.addCP(vocabularyName = "${vocabularyName}");

		Category.addCP(
			categoryName = "${categoryName}",
			vocabularyName = "${vocabularyName}"
		);
	}

	@priority = "5"
	test AddSubcategory {
		var categoryName = "Category Name";
		var subcategoryName = "Subcategory Name";
		var vocabularyName = "Vocabulary Name";

		Page.gotoCP(portletName = "Categories");

		Vocabulary.addCP(vocabularyName = "${vocabularyName}");

		Category.addCP(
			categoryName = "${categoryName}",
			vocabularyName = "${vocabularyName}"
		);

		Subcategory.addCP(subcategoryName = "${subcategoryName}");
	}

	@priority = "5"
	test AddVocabulary {
		var vocabularyName = "Vocabulary Name";

		Page.gotoCP(portletName = "Categories");

		Vocabulary.addCP(vocabularyName = "${vocabularyName}");
	}

	@priority = "5"
	test AddVocabularyAssetTypeWikiPage {
		var vocabularyName = "Vocabulary Name";

		Page.gotoCP(portletName = "Categories");

		Vocabulary.addAssetTypeWikiPageCP(vocabularyName = "${vocabularyName}");
	}

	@priority = "5"
	test DeleteCategory {
		var categoryName = "Category Name";
		var vocabularyName = "Vocabulary Name";

		Page.gotoCP(portletName = "Categories");

		Vocabulary.addCP(vocabularyName = "${vocabularyName}");

		Category.addCP(
			categoryName = "${categoryName}",
			vocabularyName = "${vocabularyName}"
		);

		Category.deleteCPByActions(categoryName = "${categoryName}");
	}

	@priority = "5"
	test DeleteSubcategory {
		var categoryName = "Category Name";
		var subcategoryName = "Subcategory Name";
		var vocabularyName = "Vocabulary Name";

		Page.gotoCP(portletName = "Categories");

		Vocabulary.addCP(vocabularyName = "${vocabularyName}");

		Category.addCP(
			categoryName = "${categoryName}",
			vocabularyName = "${vocabularyName}"
		);

		Subcategory.addCP(subcategoryName = "${subcategoryName}");

		Subcategory.deleteCPByActions(subcategoryName = "${subcategoryName}");
	}

	@priority = "5"
	test DeleteVocabulary {
		var vocabularyName = "Vocabulary Name";

		Page.gotoCP(portletName = "Categories");

		Vocabulary.addCP(vocabularyName = "${vocabularyName}");

		Vocabulary.deleteCPByActions(vocabularyName = "${vocabularyName}");
	}

	@priority = "5"
	test EditCategory {
		var categoryName = "Category Name";
		var categoryNameEdit = "Category Name Edit";
		var vocabularyName = "Vocabulary Name";

		Page.gotoCP(portletName = "Categories");

		Vocabulary.addCP(vocabularyName = "${vocabularyName}");

		Category.addCP(
			categoryName = "${categoryName}",
			vocabularyName = "${vocabularyName}"
		);

		Category.editCP(
			categoryName = "${categoryName}",
			categoryNameEdit = "${categoryNameEdit}"
		);
	}

	@priority = "5"
	test EditSubcategory {
		var categoryName = "Category Name";
		var subcategoryName = "Subcategory Name";
		var subcategoryNameEdit = "Subcategory Name Edit";
		var vocabularyName = "Vocabulary Name";

		Page.gotoCP(portletName = "Categories");

		Vocabulary.addCP(vocabularyName = "${vocabularyName}");

		Category.addCP(
			categoryName = "${categoryName}",
			vocabularyName = "${vocabularyName}"
		);

		Subcategory.addCP(subcategoryName = "${subcategoryName}");

		Subcategory.editCP(
			subcategoryName = "${subcategoryName}",
			subcategoryNameEdit = "${subcategoryNameEdit}"
		);
	}

	@priority = "5"
	test EditVocabulary {
		var vocabularyName = "Vocabulary Name";
		var vocabularyNameEdit = "Vocabulary Name Edit";

		Page.gotoCP(portletName = "Categories");

		Vocabulary.addCP(vocabularyName = "${vocabularyName}");

		Vocabulary.editCP(
			vocabularyName = "${vocabularyName}",
			vocabularyNameEdit = "${vocabularyNameEdit}"
		);
	}

	tearDown {
		Vocabulary.tearDownCP();
	}
}