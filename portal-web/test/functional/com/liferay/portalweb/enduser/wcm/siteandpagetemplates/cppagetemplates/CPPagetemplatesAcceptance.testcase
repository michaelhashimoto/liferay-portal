@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "WCM";

	setUp {
		User.firstLoginPG();
	}

	@priority = "5"
	test AddPageTemplate {
		var pageTemplateActive = "Yes";
		var pageTemplateName = "Page Template Name";

		Page.gotoCP(portletName = "Page Templates");

		PageTemplate.addCP(
			pageTemplateActive = "${pageTemplateActive}",
			pageTemplateName = "${pageTemplateName}"
		);
	}

	@priority = "5"
	test EditPageTemplate {
		var pageTemplateActive = "Yes";
		var pageTemplateActiveEdit = "No";
		var pageTemplateName = "Page Template Name";
		var pageTemplateNameEdit = "Page Template Name Edit";

		Page.gotoCP(portletName = "Page Templates");

		PageTemplate.addCP(
			pageTemplateActive = "${pageTemplateActive}",
			pageTemplateName = "${pageTemplateName}"
		);

		PageTemplate.editCP(
			pageTemplateActiveEdit = "${pageTemplateActiveEdit}",
			pageTemplateName = "${pageTemplateName}",
			pageTemplateNameEdit = "${pageTemplateNameEdit}"
		);
	}

	tearDown {
		PageTemplate.tearDownCP();
	}
}