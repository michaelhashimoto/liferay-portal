@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "WCM";

	setUp {
		User.firstLoginPG();
	}

	@priority = "5"
	test GotoControlPanel {
		Page.gotoCP(portletName = "Blogs");

		Page.gotoCP(portletName = "Users and Organizations");

		Page.gotoCP(portletName = "Wiki");
	}
}