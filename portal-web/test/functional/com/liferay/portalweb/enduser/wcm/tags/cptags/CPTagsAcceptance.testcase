<definition component-name="portal-wcm">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="WCM" />

	<set-up>
		<execute macro="User#firstLoginPG" />
	</set-up>

	<tear-down>
		<execute macro="Tag#tearDownCP" />
	</tear-down>

	<command name="AddTag" priority="5">
		<var name="tagName" value="blue" />

		<execute macro="Page#gotoCP">
			<var name="portletName" value="Tags" />
		</execute>

		<execute macro="Tag#addCP">
			<var name="tagName" value="${tagName}" />
		</execute>
	</command>

	<command name="AddTags" priority="5">
		<var name="tagName1" value="blue" />
		<var name="tagName2" value="red" />
		<var name="tagName3" value="yellow" />

		<execute macro="Page#gotoCP">
			<var name="portletName" value="Tags" />
		</execute>

		<execute macro="Tag#addCP">
			<var name="tagName" value="${tagName1}" />
		</execute>

		<execute macro="Tag#addCP">
			<var name="tagName" value="${tagName2}" />
		</execute>

		<execute macro="Tag#addCP">
			<var name="tagName" value="${tagName3}" />
		</execute>

		<execute macro="Page#gotoCP">
			<var name="portletName" value="Tags" />
		</execute>

		<execute function="AssertTextEquals" locator1="CPTags#ENTRY_TAG_1" value1="${tagName1}" />
		<execute function="AssertTextEquals" locator1="CPTags#ENTRY_TAG_2" value1="${tagName2}" />
		<execute function="AssertTextEquals" locator1="CPTags#ENTRY_TAG_3" value1="${tagName3}" />
	</command>

	<command name="DeleteTag" priority="5">
		<var name="tagName" value="blue" />

		<execute macro="Page#gotoCP">
			<var name="portletName" value="Tags" />
		</execute>

		<execute macro="Tag#addCP">
			<var name="tagName" value="${tagName}" />
		</execute>

		<execute macro="Tag#deleteCP">
			<var name="tagName" value="${tagName}" />
		</execute>
	</command>

	<command name="EditTag" priority="5">
		<var name="tagName" value="blue" />
		<var name="tagNameEdit" value="teal" />

		<execute macro="Page#gotoCP">
			<var name="portletName" value="Tags" />
		</execute>

		<execute macro="Tag#addCP">
			<var name="tagName" value="${tagName}" />
		</execute>

		<execute macro="Tag#editCP">
			<var name="tagNameEdit" value="${tagNameEdit}" />
		</execute>
	</command>
</definition>