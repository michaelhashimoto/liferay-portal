@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "WCM";

	setUp {
		User.firstLoginPG();
	}

	tearDown {
		Tag.tearDownCP();
	}

	@priority = "5"
	test AddTag {
		var tagName = "blue";

		Page.gotoCP(portletName = "Tags");

		Tag.addCP(tagName = "${tagName}");
	}

	@priority = "5"
	test AddTags {
		var tagName1 = "blue";
		var tagName2 = "red";
		var tagName3 = "yellow";

		Page.gotoCP(portletName = "Tags");

		Tag.addCP(tagName = "${tagName1}");

		Tag.addCP(tagName = "${tagName2}");

		Tag.addCP(tagName = "${tagName3}");

		Page.gotoCP(portletName = "Tags");

		AssertTextEquals(locator1 = "CPTags#ENTRY_TAG_1", value1 = "${tagName1}");

		AssertTextEquals(locator1 = "CPTags#ENTRY_TAG_2", value1 = "${tagName2}");

		AssertTextEquals(locator1 = "CPTags#ENTRY_TAG_3", value1 = "${tagName3}");
	}

	@priority = "5"
	test DeleteTag {
		var tagName = "blue";

		Page.gotoCP(portletName = "Tags");

		Tag.addCP(tagName = "${tagName}");

		Tag.deleteCP(tagName = "${tagName}");
	}

	@priority = "5"
	test EditTag {
		var tagName = "blue";
		var tagNameEdit = "teal";

		Page.gotoCP(portletName = "Tags");

		Tag.addCP(tagName = "${tagName}");

		Tag.editCP(
			tagName = "${tagName}",
			tagNameEdit = "${tagNameEdit}"
		);
	}
}