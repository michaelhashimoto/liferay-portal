@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "WCM";
	var pageName = "Asset Publisher Page";
	var portletName = "Asset Publisher";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");
	}

	@priority = "5"
	test AddWebContentViaAssetPublisher {
		var webContentContent = "WC WebContent Content";
		var webContentTitle = "WC WebContent Title";

		Page.gotoPG(pageName = "${pageName}");

		WebContent.addPGviaAP(
			webContentContent = "${webContentContent}",
			webContentTitle = "${webContentTitle}"
		);
	}

	tearDown {
		WebContent.tearDownCP();

		Page.tearDownPG();
	}
}