@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "WCM";
	var siteName = "Liferay";

	setUp {
		User.firstLoginPG();
	}

	tearDown {
		Page.gotoCP(portletName = "Site Settings");

		Staging.deactivateStagingCP(siteName = "${siteName}");

		Page.tearDownPG();
	}

	@priority = "5"
	test ActivateStaging {
		Page.gotoCP(portletName = "Site Settings");

		Staging.activateStagingCP(siteName = "${siteName}");
	}

	@priority = "5"
	test DeactivateStaging {
		Page.gotoCP(portletName = "Site Settings");

		Staging.activateStagingCP(siteName = "${siteName}");

		Page.gotoCP(portletName = "Site Settings");

		Staging.deactivateStagingCP(siteName = "${siteName}");
	}

	@priority = "5"
	test EnablePageVersioning {
		Page.gotoCP(portletName = "Site Settings");

		Staging.activateStagingCP(
			pageVersioningEnabled = "true",
			siteName = "${siteName}"
		);
	}

	@priority = "5"
	test StagingAddPortlet {
		var pageName = "Blogs Page";
		var portletName = "Blogs";

		Page.gotoCP(portletName = "Site Settings");

		Staging.activateStagingCP(siteName = "${siteName}");

		Page.addPG(pageName = "${pageName}", pageStaging = "true");

		Portlet.addPG(
			pageName = "${pageName}",
			pageStaging = "true",
			portletName = "${portletName}"
		);

		Page.gotoPG(pageStaging = "true");

		Staging.publishToLiveNowPG();

		AssertClick(locator1 = "Staging#LIVE_BUTTON", value1 = "Live");

		var key_pageName = "${pageName}";

		AssertClick.assertTextClickAt(locator1 = "Home#PAGE", value1 = "${pageName}");

		AssertElementPresent(locator1 = "Home#PORTLET_1");
	}

	@priority = "5"
	test StagingPublishToLive {
		Page.gotoCP(portletName = "Site Settings");

		Staging.activateStagingCP(siteName = "${siteName}");

		Page.gotoPG(pageName = "Welcome", pageStaging = "true");

		Staging.publishToLiveNowPG(pageName = "Welcome");
	}
}