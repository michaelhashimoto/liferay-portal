<definition component-name="portal-wcm">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="WCM" />

	<var name="siteName" value="Liferay" />

	<set-up>
		<execute macro="User#firstLoginPG" />
	</set-up>

	<tear-down>
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Site Settings" />
		</execute>

		<execute macro="Staging#deactivateStagingCP">
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Page#tearDownPG" />
	</tear-down>

	<command name="ActivateStaging" priority="5">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Site Settings" />
		</execute>

		<execute macro="Staging#activateStagingCP">
			<var name="siteName" value="${siteName}" />
		</execute>
	</command>

	<command name="DeactivateStaging" priority="5">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Site Settings" />
		</execute>

		<execute macro="Staging#activateStagingCP">
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Page#gotoCP">
			<var name="portletName" value="Site Settings" />
		</execute>

		<execute macro="Staging#deactivateStagingCP">
			<var name="siteName" value="${siteName}" />
		</execute>
	</command>

	<command name="EnablePageVersioning" priority="5">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Site Settings" />
		</execute>

		<execute macro="Staging#activateStagingCP">
			<var name="pageVersioningEnabled" value="true" />
			<var name="siteName" value="${siteName}" />
		</execute>
	</command>

	<command name="StagingAddPortlet" priority="5">
		<var name="pageName" value="Blogs Page" />
		<var name="portletName" value="Blogs" />

		<execute macro="Page#gotoCP">
			<var name="portletName" value="Site Settings" />
		</execute>

		<execute macro="Staging#activateStagingCP">
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Page#addPG">
			<var name="pageName" value="${pageName}" />
			<var name="pageStaging" value="true" />
		</execute>

		<execute macro="Portlet#addPG">
			<var name="pageName" value="${pageName}" />
			<var name="pageStaging" value="true" />
			<var name="portletName" value="${portletName}" />
		</execute>

		<execute macro="Page#gotoPG">
			<var name="pageStaging" value="true" />
		</execute>

		<execute macro="Staging#publishToLiveNowPG" />

		<execute function="AssertClick" locator1="Staging#LIVE_BUTTON" value1="Live" />

		<var name="key_pageName" value="${pageName}" />

		<execute function="AssertClick#assertTextClickAtAndWait" locator1="Home#PAGE" value1="${pageName}" />
		<execute function="AssertElementPresent" locator1="Home#PORTLET_1" />
	</command>

	<command name="StagingPublishToLive" priority="5">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Site Settings" />
		</execute>

		<execute macro="Staging#activateStagingCP">
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="Page#gotoPG">
			<var name="pageName" value="Welcome" />
			<var name="pageStaging" value="true" />
		</execute>

		<execute macro="Staging#publishToLiveNowPG">
			<var name="pageName" value="Welcome" />
		</execute>
	</command>
</definition>