@component-name = "portal-wcm"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "WCM";
	var pageName = "Web Content List Page";
	var portletName = "Web Content List";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");
	}

	@priority = "5"
	test ViewWebContentViaWCLDisplayURLNormal {
		var webContentContent = "WC WebContent Content";
		var webContentTitle = "WC WebContent Title";

		Page.gotoCP(portletName = "Web Content");

		WebContent.addCP(
			webContentContent = "${webContentContent}",
			webContentTitle = "${webContentTitle}"
		);

		Page.gotoPG(pageName = "${pageName}");

		WCLPortlet.configureSetupPG(webContentTitle = "${webContentTitle}");

		Page.gotoPG(pageName = "${pageName}");

		AssertTextEquals(
			locator1 = "PGWebcontentlist#WEB_CONTENT_TABLE_TITLE_1",
			value1 = "${webContentTitle}"
		);

		AssertClick.assertTextClickAt(
			locator1 = "PGWebcontentlist#WEB_CONTENT_TABLE_TITLE_1",
			value1 = "${webContentTitle}"
		);

		AssertTextEquals(
			locator1 = "PGWebcontentlistWebcontent#WEB_CONTENT_TITLE",
			value1 = "${webContentTitle}"
		);

		AssertTextEquals(
			locator1 = "PGWebcontentlistWebcontent#WEB_CONTENT_CONTENT",
			value1 = "${webContentContent}"
		);
	}

	tearDown {
		WebContent.tearDownCP();

		Page.tearDownPG();
	}
}