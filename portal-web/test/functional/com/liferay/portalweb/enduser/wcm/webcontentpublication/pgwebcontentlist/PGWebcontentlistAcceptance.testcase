<definition component-name="portal-wcm">
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="WCM" />

	<var name="pageName" value="Web Content List Page" />
	<var name="portletName" value="Web Content List" />

	<set-up>
		<execute macro="User#firstLoginPG" />

		<execute macro="Page#addPG">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="Portlet#addPG">
			<var name="pageName" value="${pageName}" />
			<var name="portletName" value="${portletName}" />
		</execute>
	</set-up>

	<command name="ViewWebContentViaWCLDisplayURLNormal" priority="5">
		<var name="webContentContent" value="WC WebContent Content" />
		<var name="webContentTitle" value="WC WebContent Title" />

		<execute macro="Page#gotoCP">
			<var name="portletName" value="Web Content" />
		</execute>

		<execute macro="WebContent#addCP">
			<var name="webContentContent" value="${webContentContent}" />
			<var name="webContentTitle" value="${webContentTitle}" />
		</execute>

		<execute macro="Page#gotoPG">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="WCLPortlet#configureSetupPG">
			<var name="webContentTitle" value="${webContentTitle}" />
		</execute>

		<execute macro="Page#gotoPG">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute function="AssertTextEquals" locator1="PGWebcontentlist#WEB_CONTENT_TABLE_TITLE_1" value1="${webContentTitle}" />
		<execute function="AssertClick#assertTextClickAtAndWait" locator1="PGWebcontentlist#WEB_CONTENT_TABLE_TITLE_1" value1="${webContentTitle}" />

		<execute function="AssertTextEquals" locator1="PGWebcontentlistWebcontent#WEB_CONTENT_TITLE" value1="${webContentTitle}" />
		<execute function="AssertTextEquals" locator1="PGWebcontentlistWebcontent#WEB_CONTENT_CONTENT" value1="${webContentContent}" />
	</command>

	<tear-down>
		<execute macro="WebContent#tearDownCP" />

		<execute macro="Page#tearDownPG" />
	</tear-down>
</definition>