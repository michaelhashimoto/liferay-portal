@component-name = "portal-search"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Search";
	var searchPageName = "Search Page";
	var searchPortletName = "Search";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${searchPageName}");

		Portlet.addPG(
			pageName = "${searchPageName}",
			portletName = "${searchPortletName}"
		);
	}

	@priority = "5"
	test SearchBlogsEntry {
		var entryContent = "Blogs Entry Content";
		var entryTitle = "Blogs Entry Title";
		var pageName = "Blogs Page";
		var portletName = "Blogs";

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");

		Page.gotoPG(pageName = "${pageName}");

		BlogsEntry.addPG(
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			portletName = "${portletName}"
		);

		Page.gotoPG(pageName = "${searchPageName}");

		Search.blogsEntryPG(
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}"
		);
	}

	@priority = "5"
	test SearchMessageBoardsThread {
		var pageName = "Message Boards Page";
		var portletName = "Message Boards";
		var threadBody = "MB Thread Message Body";
		var threadSubject = "MB Thread Message Subject";

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.addPG(
			pageName = "${pageName}",
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}"
		);

		Page.gotoPG(pageName = "${searchPageName}");

		Search.messageboardsThreadPG(
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}"
		);
	}

	@priority = "5"
	test SearchUser {
		var userEmailAddress = "userea@liferay.com";
		var userFirstName = "userfn";
		var userLastName = "userln";
		var userScreenName = "usersn";

		Page.gotoCP(portletName = "Users and Organizations");

		User.addCP(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoPG(pageName = "${searchPageName}");

		Search.userPG(
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}"
		);
	}

	@priority = "5"
	test SearchWikiPage {
		var pageName = "Wiki Test Page";
		var portletName = "Wiki";
		var wikiPageContent = "Wiki Page Content";
		var wikiPageTitle = "Wiki Page Title";

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");

		Page.gotoPG(pageName = "${pageName}");

		WikiPage.addPagePG(
			pageName = "${pageName}",
			wikiPageContent = "${wikiPageContent}",
			wikiPageTitle = "${wikiPageTitle}"
		);

		Page.gotoPG(pageName = "${searchPageName}");

		Search.wikiPagePG(
			wikiPageContent = "${wikiPageContent}",
			wikiPageTitle = "${wikiPageTitle}"
		);
	}

	tearDown {
		BlogsEntry.tearDownCP();

		MessageboardsThread.tearDownCP();

		User.tearDownCP();

		WikiPage.tearDownCP();

		Page.tearDownPG();
	}
}