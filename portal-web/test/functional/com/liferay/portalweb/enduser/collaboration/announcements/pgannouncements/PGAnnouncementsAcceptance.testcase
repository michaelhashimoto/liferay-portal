@component-name = "portal-collaboration"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Collaboration";
	var pageName = "Announcements Page";
	var portletName = "Announcements";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");
	}

	@priority = "5"
	test AddAnnouncementsEntry {
		var distributionScope = "General";
		var entryContent = "Announcements Entry Content";
		var entryTitle = "Announcements Entry Title";
		var entryURL = "http://www.liferay.com";

		Page.gotoPG(pageName = "${pageName}");

		AnnouncementsEntry.addPG(
			distributionScope = "${distributionScope}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			entryURL = "${entryURL}"
		);

		Page.gotoPG(pageName = "${pageName}");

		AnnouncementsEntry.viewPG(
			distributionScope = "${distributionScope}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			entryURL = "${entryURL}"
		);
	}

	@priority = "5"
	test DeleteAnnoucementsEntry {
		var distributionScope = "General";
		var entryContent = "Announcements Entry Content";
		var entryTitle = "Announcements Entry Title";
		var entryURL = "http://www.liferay.com";

		Page.gotoPG(pageName = "${pageName}");

		AnnouncementsEntry.addPG(
			distributionScope = "${distributionScope}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}"
		);

		Page.gotoPG(pageName = "${pageName}");

		AnnouncementsEntry.deletePG(
			distributionScope = "${distributionScope}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			entryURL = "${entryURL}"
		);
	}

	@priority = "5"
	test EditAnnouncementsEntry {
		var distributionScope = "General";
		var entryContent = "Announcements Entry Content";
		var entryContentEdit = "Announcements Entry Content Edit";
		var entryTitle = "Announcements Entry Title";
		var entryTitleEdit = "Announcements Entry Title Edit";
		var entryURL = "http://www.liferay.com";
		var entryURLEdit = "http://www.alloyui.com";

		Page.gotoPG(pageName = "${pageName}");

		AnnouncementsEntry.addPG(
			distributionScope = "${distributionScope}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			entryURL = "${entryURL}"
		);

		Page.gotoPG(pageName = "${pageName}");

		AnnouncementsEntry.editPG(
			distributionScope = "${distributionScope}",
			entryContent = "${entryContent}",
			entryContentEdit = "${entryContentEdit}",
			entryTitle = "${entryTitle}",
			entryTitleEdit = "${entryTitleEdit}",
			entryURL = "${entryURL}",
			entryURLEdit = "${entryURLEdit}"
		);

		AnnouncementsEntry.viewPG(
			distributionScope = "${distributionScope}",
			entryContent = "${entryContentEdit}",
			entryTitle = "${entryTitleEdit}",
			entryURL = "${entryURLEdit}"
		);
	}

	tearDown {
		AnnouncementsEntry.tearDownPG();

		Page.tearDownPG();
	}
}