@component-name = "portal-collaboration"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Collaboration";
	var pageName = "Message Boards Page";
	var portletName = "Message Boards";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");
	}

	@priority = "5"
	test AddMBCategory {
		var categoryName = "MB Category Name";

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsCategory.addPG(categoryName = "${categoryName}");

		MessageboardsCategory.viewPG(categoryName = "${categoryName}");
	}

	@priority = "5"
	test AddMBThread {
		var threadBody = "MB Thread Message Body";
		var threadSubject = "MB Thread Message Subject";

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.addPG(
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}"
		);

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.viewPG(
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}"
		);
	}

	@priority = "5"
	test DeleteMBCategory {
		var categoryName = "MB Category Name";

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsCategory.addPG(categoryName = "${categoryName}");

		MessageboardsCategory.deletePG(categoryName = "${categoryName}");
	}

	@priority = "5"
	test DeleteMBThread {
		var threadBody = "MB Thread Message Body";
		var threadSubject = "MB Thread Message Subject";

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.addPG(
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}"
		);

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.deletePG(threadSubject = "${threadSubject}");
	}

	@priority = "5"
	test EditMBCategory {
		var categoryName = "MB Category Name";
		var categoryNameEdit = "MB Category Name Edit";

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsCategory.addPG(categoryName = "${categoryName}");

		MessageboardsCategory.editPG(
			categoryName = "${categoryName}",
			categoryNameEdit = "${categoryNameEdit}"
		);
	}

	@priority = "5"
	test EditMBThreadBody {
		var threadBody = "MB Thread Message Body";
		var threadBodyEdit = "MB Thread Message Body Edit";
		var threadSubject = "MB Thread Message Subject";
		var threadSubjectEdit = "MB Thread Message Subject Edit";

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.addPG(
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}"
		);

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.editPG(
			threadBody = "${threadBody}",
			threadBodyEdit = "${threadBodyEdit}",
			threadSubject = "${threadSubject}",
			threadSubjectEdit = "${threadSubjectEdit}"
		);
	}

	@priority = "5"
	test ReplyMBThread {
		var threadBody = "MB Thread Message Body";
		var threadReplyBody = "MB Thread Reply Body";
		var threadSubject = "MB Thread Message Subject";

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.addPG(
			threadBody = "${threadBody}",
			threadSubject = "${threadSubject}"
		);

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.replyPG(
			threadBody = "${threadBody}",
			threadReplyBody = "${threadReplyBody}",
			threadSubject = "${threadSubject}"
		);

		Page.gotoPG(pageName = "${pageName}");

		MessageboardsThread.viewReplyPG(
			threadBody = "${threadBody}",
			threadReplyBody = "${threadReplyBody}",
			threadSubject = "${threadSubject}"
		);
	}

	tearDown {
		MessageboardsCategory.tearDownCP();

		MessageboardsThread.tearDownCP();

		Page.tearDownPG();
	}
}