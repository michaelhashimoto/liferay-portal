@component-name = "portal-collaboration"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Collaboration";
	var pageName = "Blogs Page";
	var portletName = "Blogs";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");
	}

	tearDown {
		BlogsEntry.tearDownCP();

		Page.tearDownPG();
	}

	@priority = "5"
	test AddBlogsEntry {
		var entryContent = "Blogs Entry Content";
		var entryTitle = "Blogs Entry Title";

		Page.gotoPG(pageName = "${pageName}");

		BlogsEntry.addPG(entryContent = "${entryContent}", entryTitle = "${entryTitle}");
	}

	@priority = "5"
	test AddBlogsEntryComment {
		var entryComment = "Blogs Entry Comment";
		var entryContent = "Blogs Entry Content";
		var entryTitle = "Blogs Entry Title";

		Page.gotoPG(pageName = "${pageName}");

		BlogsEntry.addPG(entryContent = "${entryContent}", entryTitle = "${entryTitle}");

		BlogsEntryComment.addPG(
			entryComment = "${entryComment}",
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}"
		);
	}

	@priority = "5"
	test DeleteBlogsEntry {
		var entryContent = "Blogs Entry Content";
		var entryTitle = "Blogs Entry Title";

		Page.gotoPG(pageName = "${pageName}");

		BlogsEntry.addPG(
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			pageName = "${pageName}"
		);

		BlogsEntry.deletePG(
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}",
			pageName = "${pageName}"
		);
	}

	@priority = "5"
	test EditBlogsEntry {
		var entryContent = "Blogs Entry Content";
		var entryContentEdit = "Blogs Entry ContentEdit";
		var entryTitle = "Blogs Entry Title";
		var entryTitleEdit = "Blogs Entry TitleEdit";

		Page.gotoPG(pageName = "${pageName}");

		BlogsEntry.addPG(entryContent = "${entryContent}", entryTitle = "${entryTitle}");

		BlogsEntry.editPG(
			entryContent = "${entryContent}",
			entryContentEdit = "${entryContentEdit}",
			entryTitle = "${entryTitle}",
			entryTitleEdit = "${entryTitleEdit}"
		);
	}
}