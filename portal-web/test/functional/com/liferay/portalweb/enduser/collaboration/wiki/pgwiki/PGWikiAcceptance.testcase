@component-name = "portal-collaboration"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Collaboration";
	var pageName = "Wiki Test Page";
	var portletName = "Wiki";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");
	}

	tearDown {
		WikiNode.tearDownCP();

		WikiPage.tearDownCP();

		Page.tearDownPG();
	}

	@priority = "5"
	test AddWikiFrontPage {
		var wikiPageContent = "Wiki FrontPage Content";

		Page.gotoPG(pageName = "${pageName}");

		WikiPage.addFrontPagePG(
			pageName = "${pageName}",
			wikiPageContent = "${wikiPageContent}"
		);
	}

	@priority = "5"
	test AddWikiFrontPageChildPage {
		var wikiChildPageContent = "Wiki Front Page Child Page Content";
		var wikiChildPageTitle = "Wiki Front Page Child Page Title";
		var wikiPageContent = "Wiki Front Page Content";
		var wikiPageTitle = "FrontPage";

		Page.gotoPG(pageName = "${pageName}");

		WikiPage.addFrontPagePG(
			pageName = "${pageName}",
			wikiPageContent = "${wikiPageContent}"
		);

		WikiPage.addChildPagePG(
			pageName = "${pageName}",
			wikiChildPageContent = "${wikiChildPageContent}",
			wikiChildPageTitle = "${wikiChildPageTitle}",
			wikiPageContent = "${wikiPageContent}",
			wikiPageTitle = "${wikiPageTitle}"
		);
	}

	@priority = "5"
	test DeleteWikiFrontPage {
		var wikiPageContent = "Wiki FrontPage Content";

		Page.gotoPG(pageName = "${pageName}");

		WikiPage.addFrontPagePG(
			pageName = "${pageName}",
			wikiPageContent = "${wikiPageContent}"
		);

		WikiPage.deleteFrontPagePG(pageName = "${pageName}");
	}
}