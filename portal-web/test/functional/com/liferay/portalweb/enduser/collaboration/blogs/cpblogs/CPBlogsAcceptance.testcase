@component-name = "portal-collaboration"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Collaboration";

	setUp {
		User.firstLoginPG();
	}

	@description = "Ensure that a user can add a Blogs Entry."
	@priority = "5"
	test AddBlogsEntry {
		property testray.component.names = "Blogs,Collaboration";
		property testray.main.component.name = "Blogs";
		var entryContent = "Blogs Entry Content";
		var entryTitle = "Blogs Entry Title";

		Page.gotoCP(portletName = "Blogs");

		BlogsEntry.addCP(entryContent = "${entryContent}", entryTitle = "${entryTitle}");
	}

	tearDown {
		BlogsEntry.tearDownCP();
	}
}