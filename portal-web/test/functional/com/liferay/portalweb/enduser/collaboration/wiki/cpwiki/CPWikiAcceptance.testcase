@component-name = "portal-collaboration"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Collaboration";

	setUp {
		User.firstLoginPG();
	}

	@priority = "5"
	test AddWikiNode {
		var wikiNodeDescription = "Wiki Node Description";
		var wikiNodeName = "Wiki Node Name";

		Page.gotoCP(portletName = "Wiki");

		WikiNode.addCP(
			wikiNodeDescription = "${wikiNodeDescription}",
			wikiNodeName = "${wikiNodeName}"
		);
	}

	@priority = "5"
	test DeleteWikiNode {
		var wikiNodeDescription = "Wiki Node Description";
		var wikiNodeName = "Wiki Node Name";

		Page.gotoCP(portletName = "Wiki");

		WikiNode.addCP(
			wikiNodeDescription = "${wikiNodeDescription}",
			wikiNodeName = "${wikiNodeName}"
		);

		WikiNode.deleteCP(wikiNodeName = "${wikiNodeName}");
	}

	@priority = "5"
	test EditWikiNode {
		var wikiNodeDescription = "Wiki Node Description";
		var wikiNodeDescriptionEdit = "Wiki Node Description Edit";
		var wikiNodeName = "Wiki Node Name";
		var wikiNodeNameEdit = "Wiki Node Name Edit";

		Page.gotoCP(portletName = "Wiki");

		WikiNode.addCP(
			wikiNodeDescription = "${wikiNodeDescription}",
			wikiNodeName = "${wikiNodeName}"
		);

		WikiNode.editCP(
			wikiNodeDescription = "${wikiNodeDescription}",
			wikiNodeDescriptionEdit = "${wikiNodeDescriptionEdit}",
			wikiNodeName = "${wikiNodeName}",
			wikiNodeNameEdit = "${wikiNodeNameEdit}"
		);
	}

	tearDown {
		WikiNode.tearDownCP();

		WikiPage.tearDownCP();
	}
}