@component-name = "portal-collaboration"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Collaboration";

	setUp {
		User.firstLoginPG();
	}

	@priority = "5"
	test AddCalendarEvent {
		var eventTitle = "Calendar Event Title";

		Page.gotoCP(portletName = "Calendar");

		Event.addCP(eventTitle = "${eventTitle}");
	}

	@priority = "5"
	test DeleteCalendarEvent {
		var eventTitle = "Calendar Event Title";

		Page.gotoCP(portletName = "Calendar");

		Event.addCP(eventTitle = "${eventTitle}");

		Event.deleteCP(eventTitle = "${eventTitle}");
	}

	@priority = "5"
	test EditCalendarEvent {
		var eventTitle = "Calendar Event Title";
		var eventTitleEdit = "Calendar Event Title Edit";

		Page.gotoCP(portletName = "Calendar");

		Event.addCP(eventTitle = "${eventTitle}");

		Event.editCP(eventTitle = "${eventTitle}", eventTitleEdit = "${eventTitleEdit}");
	}

	tearDown {
		Event.tearDownCP();
	}
}