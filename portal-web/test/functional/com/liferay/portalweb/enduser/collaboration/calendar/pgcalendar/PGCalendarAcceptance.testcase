@component-name = "portal-collaboration"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Collaboration";
	var pageName = "Calendar Page";
	var portletName = "Calendar";

	setUp {
		User.firstLoginPG();

		Page.addPG(pageName = "${pageName}");

		Portlet.addPG(pageName = "${pageName}", portletName = "${portletName}");
	}

	@priority = "5"
	test AddCalendarEvent {
		var eventTitle = "Calendar Event Title";

		Page.gotoCP(portletName = "Calendar");

		Event.addPG(eventTitle = "${eventTitle}");
	}

	@priority = "5"
	test DeleteCalendarEvent {
		var eventTitle = "Calendar Event Title";

		Page.gotoCP(portletName = "Calendar");

		Event.addPG(eventTitle = "${eventTitle}");

		Event.deletePG(eventTitle = "${eventTitle}");
	}

	@priority = "5"
	test EditCalendarEvent {
		var eventTitle = "Calendar Event Title";
		var eventTitleEdit = "Calendar Event Title Edit";

		Page.gotoCP(portletName = "Calendar");

		Event.addPG(eventTitle = "${eventTitle}");

		Event.editPG(eventTitle = "${eventTitle}", eventTitleEdit = "${eventTitleEdit}");
	}

	tearDown {
		Event.tearDownCP();

		Page.tearDownPG();
	}
}