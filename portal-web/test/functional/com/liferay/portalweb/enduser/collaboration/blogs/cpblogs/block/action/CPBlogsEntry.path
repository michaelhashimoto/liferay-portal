<html>
<head>
<title>CPBlogsEntry</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">CPBlogsEntry</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>CPBlogsEntry</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_TITLE_HEADER</td>
	<td>//h1[@class='header-title']/span</td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_WORKFLOW_STATUS</td>
	<td>//div[@class='entry pending']/div/h3</td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_TITLE_LINK</td>
	<td>//div[@class='entry-title']/h2/a</td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_CONTENT</td>
	<td>//div[@class='entry-body']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--COMMENTS-->
<tr>
	<td>COMMENTS</td>
	<td>//div[@class='lfr-panel-title']/span</td>
	<td></td>
</tr>
<tr>
	<td>COMMENTS_SUCCESS</td>
	<td>//div[@class='lfr-message-response portlet-msg-success']</td>
	<td></td>
</tr>
<tr>
	<td>COMMENTS_ADD</td>
	<td>//fieldset/div/a[contains(.,'Be the first.')]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENTS_BODY_FIELD</td>
	<td>//textarea[contains(@id,'_postReplyBody0')]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENTS_REPLY_BUTTON</td>
	<td>//input[@value='Reply']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--COMMENT-->
<tr>
	<td>COMMENT_1</td>
	<td>xpath=(//div[@class='lfr-discussion-message'])[1]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_2</td>
	<td>xpath=(//div[@class='lfr-discussion-message'])[2]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_3</td>
	<td>xpath=(//div[@class='lfr-discussion-message'])[3]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_DELETE</td>
	<td>//li[@class='lfr-discussion-delete']/span/a/span[contains(.,'Delete')]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_POST_REPLY</td>
	<td>//li[@class='lfr-discussion-reply-to']/span/a/span[contains(.,'Post Reply')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>