definition {
	macro showAdvancedSearch {
		if (IsElementPresent.isVisible(locator1 = "CPUsersandorganizationsViewusers#BASIC_SEARCH_ADVANCED", value1 = "Advanced")) {
			AssertClick.assertPartialTextClickAt(
				locator1 = "CPUsersandorganizationsViewusers#BASIC_SEARCH_ADVANCED",
				value1 = "Advanced"
			);
		}

		AssertElementPresent(
			locator1 = "CPUsersandorganizationsViewusers#ADVANCED_SEARCH_MATCH_SELECT"
		);
	}

	macro showBasicSearch {
		if (IsElementPresent.isVisible(locator1 = "CPUsersandorganizationsViewusers#ADVANCED_SEARCH_BASIC", value1 = "Basic")) {
			AssertClick.assertPartialTextClickAt(
				locator1 = "CPUsersandorganizationsViewusers#ADVANCED_SEARCH_BASIC",
				value1 = "Basic"
			);
		}

		AssertElementPresent(
			locator1 = "CPUsersandorganizationsViewusers#BASIC_SEARCH_FIELD"
		);
	}
}