@component-name = "portal-user-management-and-portal-configuration"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Administration";

	setUp {
		User.firstLoginPG();
	}

	@priority = "5"
	test AddUserGroup {
		var userGroupName = "UG UserGroup Name";

		Page.gotoCP(portletName = "User Groups");

		UserGroup.addCP(userGroupName = "${userGroupName}");
	}

	@priority = "5"
	test DeleteUserGroup {
		var userGroupName = "UG UserGroup Name";

		Page.gotoCP(portletName = "User Groups");

		UserGroup.addCP(userGroupName = "${userGroupName}");

		UserGroup.deleteCP();
	}

	@priority = "5"
	test EditUserGroup {
		var userGroupName = "UG UserGroup Name";
		var userGroupNameEdit = "UG UserGroup Name Edit";

		Page.gotoCP(portletName = "User Groups");

		UserGroup.addCP(userGroupName = "${userGroupName}");

		UserGroup.editCP(userGroupNameEdit = "${userGroupNameEdit}");
	}

	tearDown {
		UserGroup.tearDownCP();
	}
}