		);

		User.logoutPG();

		User.loginPG(userEmailAddress = "${userEmailAddress}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Site");

		BlogsEntry.addNoPermissionPG();

		User.logoutPG();

		User.loginPG(userEmailAddress = "test@liferay.com");
	}

	@priority = "5"
	test AddOrganizationRole {
		var roleName = "Roles Orgrole Name";
		var roleType = "Organization";

		Page.gotoCP(portletName = "Roles");

		Role.addCP(roleName = "${roleName}", roleType = "${roleType}");

		Role.viewCP(roleName = "${roleName}", roleType = "${roleType}");
	}

	@priority = "5"
	test AddRegularRole {
		var roleName = "Roles Regrole Name";

		Page.gotoCP(portletName = "Roles");

		Role.addCP(roleName = "${roleName}", roleType = "${roleType}");

		Role.viewCP(roleName = "${roleName}", roleType = "${roleType}");
	}

	@priority = "5"
	test AddSiteRole {
