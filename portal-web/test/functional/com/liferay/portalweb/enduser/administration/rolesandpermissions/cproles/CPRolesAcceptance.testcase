		Page.gotoCP(portletName = "Roles");

		Role.addCP(roleName = "${roleName}", roleType = "${roleType}");

		Page.gotoCP(portletName = "Sites");

		Site.assignRoleCP(
			roleName = "${roleName}",
			siteName = "${siteName}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		User.logoutPG();

		User.loginPG(userEmailAddress = "${userEmailAddress}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Site");

