		var roleType = "Site";

		Page.gotoCP(portletName = "Roles");

		Role.addCP(roleName = "${roleName}", roleType = "${roleType}");

		Role.viewCP(roleName = "${roleName}", roleType = "${roleType}");
	}

	@priority = "5"
	test DeleteBlogsEntryOrgRole {
		var entryContent = "Blogs Entry Content";
		var entryTitle = "Blogs Entry Title";
		var orgName = "Organization Name";
		var orgType = "Regular Organization";
		var pageName = "Blogs Page";
		var portletName = "Blogs";
		var roleName = "Roles Orgrole Name";
		var rolePermission = "Delete";
		var roleType = "Organization";
		var siteName = "Organization Name";
		var sitePageName = "${pageName}";
		var sitePagePrivacy = "Public";
		var userEmailAddress = "userea@liferay.com";
		var userFirstName = "userfn";
		var userLastName = "userln";
		var userScreenName = "usersn";

		Page.gotoCP(portletName = "Users and Organizations");

		User.addCP(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Users and Organizations");

		User.editPasswordCP(
			userEmailAddress = "${userEmailAddress}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.addCP(orgName = "${orgName}", orgType = "${orgType}");

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.addSiteCP(orgName = "${orgName}");

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.addMemberCP(
			orgName = "${orgName}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Sites");

		SitePage.addCP(
			siteName = "${siteName}",
			sitePageName = "${pageName}",
			sitePagePrivacy = "${sitePagePrivacy}"
		);

		Portlet.addPG(
			pageName = "${pageName}",
			pageType = "Organization",
			portletName = "${portletName}"
		);

		Page.gotoCP(portletName = "Roles");

		Role.addCP(roleName = "${roleName}", roleType = "${roleType}");

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.assignOrgRoleCP(
			orgName = "${orgName}",
			roleName = "${roleName}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoPG(pageName = "${pageName}", pageType = "Organization");

		BlogsEntry.addPG(entryContent = "${entryContent}", entryTitle = "${entryTitle}");

		User.logoutPG();

		User.loginPG(userEmailAddress = "${userEmailAddress}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Organization");

		BlogsEntry.deleteNoPermissionPG();

		User.logoutPG();

		User.loginPG(userEmailAddress = "test@liferay.com");

		Page.gotoCP(portletName = "Roles");

		Role.definePermissionBlogsEntryCP(
			roleName = "${roleName}",
			rolePermission = "${rolePermission}",
			roleType = "${roleType}"
		);

		User.logoutPG();

		User.loginPG(userEmailAddress = "${userEmailAddress}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Organization");

		BlogsEntry.deletePG(
			entryContent = "${entryContent}",
			entryTitle = "${entryTitle}"
		);

		User.logoutPG();

		User.loginPG(userEmailAddress = "test@liferay.com");

		Page.gotoCP(portletName = "Roles");

		Role.removePermissionBlogsEntryCP(
			roleName = "${roleName}",
			rolePermission = "${rolePermission}",
			roleType = "${roleType}"
		);

		Page.gotoPG(pageName = "${pageName}", pageType = "Organization");

		BlogsEntry.addPG(entryContent = "${entryContent}", entryTitle = "${entryTitle}");

		User.logoutPG();

		User.loginPG(userEmailAddress = "${userEmailAddress}");

		Page.gotoPG(pageName = "${pageName}", pageType = "Organization");

		BlogsEntry.deleteNoPermissionPG();

		User.logoutPG();

