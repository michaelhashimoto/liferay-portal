@component-name = "portal-user-management-and-portal-configuration"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Administration";

	setUp {
		User.firstLoginPG();
	}

	tearDown {
		Suborganization.tearDownCP();

		Organization.tearDownCP();

		User.tearDownCP();
	}

	@priority = "5"
	test AddMember {
		var orgName = "Organization Name";
		var orgType = "Regular Organization";
		var searchToken = "Organization";
		var userEmailAddress = "userea@liferay.com";
		var userFirstName = "userfn";
		var userLastName = "userln";
		var userScreenName = "usersn";

		Page.gotoCP(portletName = "Users and Organizations");

		User.addCP(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.addCP(orgName = "${orgName}", orgType = "${orgType}");

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.addMemberCP(
			orgName = "${orgName}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.viewAssignMemberCP(
			orgName = "${orgName}",
			searchToken = "${searchToken}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);
	}

	@priority = "5"
	test AddOrganization {
		var orgName = "Organization Name";
		var orgType = "Regular Organization";
		var searchToken = "Organization";

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.addCP(orgName = "${orgName}", orgType = "${orgType}");

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.viewCP(
			orgName = "${orgName}",
			orgType = "${orgType}",
			searchToken = "${searchToken}"
		);
	}

	@priority = "5"
	test AddOrganizationTeam {
		var orgName = "Organization Name";
		var orgType = "Regular Organization";
		var teamDescription = "Site Team Description";
		var teamName = "Site Team Name";

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.addCP(orgName = "${orgName}", orgType = "${orgType}");

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.addSiteCP(orgName = "${orgName}");

		Page.gotoCP(portletName = "Sites");

		Team.addCP(
			siteName = "Organization Name",
			teamDescription = "${teamDescription}",
			teamName = "${teamName}"
		);
	}

	@priority = "5"
	test AddSite {
		var orgName = "Organization Name";
		var orgType = "Regular Organization";
		var siteMember = "Organization";
		var siteName = "Organization Name";
		var siteType = "Private";

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.addCP(orgName = "${orgName}", orgType = "${orgType}");

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.addSiteCP(orgName = "${orgName}");

		Page.gotoCP(portletName = "Sites");

		Site.viewCP(
			siteMember = "${siteMember}",
			siteName = "${siteName}",
			siteType = "${siteType}"
		);
	}

	@priority = "5"
	test AddSuborganization {
		var orgName = "Organization Name";
		var orgType = "Regular Organization";
		var suborgName = "Suborganization Name";
		var suborgSearchName = "Suborganization";
		var suborgType = "Regular Organization";

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.addCP(orgName = "${orgName}", orgType = "${orgType}");

		Page.gotoCP(portletName = "Users and Organizations");

		Suborganization.addCP(
			orgName = "${orgName}",
			suborgName = "${suborgName}",
			suborgType = "${suborgType}"
		);

		Page.gotoCP(portletName = "Users and Organizations");

		Suborganization.viewCP(
			orgName = "${orgName}",
			orgType = "${orgType}",
			suborgName = "${suborgName}",
			suborgSearchName = "${suborgSearchName}",
			suborgType = "${suborgType}"
		);
	}

	@priority = "5"
	test AddUser {
		var userEmailAddress = "userea@liferay.com";
		var userFirstName = "userfn";
		var userLastName = "userln";
		var userScreenName = "usersn";

		Page.gotoCP(portletName = "Users and Organizations");

		User.addCP(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Users and Organizations");

		User.viewCP(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);
	}

	@priority = "5"
	test DeleteOrganization {
		var orgName = "Organization Name";
		var orgType = "Regular Organization";

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.addCP(orgName = "${orgName}", orgType = "${orgType}");

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.deleteCP(orgName = "${orgName}");
	}

	@priority = "5"
	test DeleteUser {
		var userEmailAddress = "userea@liferay.com";
		var userFirstName = "userfn";
		var userLastName = "userln";
		var userScreenName = "usersn";

		Page.gotoCP(portletName = "Users and Organizations");

		User.addCP(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Users and Organizations");

		User.deactivateCP(userFirstName = "${userFirstName}");

		Page.gotoCP(portletName = "Users and Organizations");

		User.deleteCP(userFirstName = "${userFirstName}");
	}

	@priority = "5"
	test RemoveMember {
		var orgName = "Organization Name";
		var orgType = "Regular Organization";
		var userEmailAddress = "userea@liferay.com";
		var userFirstName = "userfn";
		var userLastName = "userln";
		var userScreenName = "usersn";

		Page.gotoCP(portletName = "Users and Organizations");

		User.addCP(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.addCP(orgName = "${orgName}", orgType = "${orgType}");

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.addMemberCP(
			orgName = "${orgName}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.removeMemberCP(
			orgName = "${orgName}",
			userFirstName = "${userFirstName}",
			userScreenName = "${userScreenName}"
		);

		Page.gotoCP(portletName = "Users and Organizations");

		Organization.removeMemberCP(
			orgName = "${orgName}",
			userFirstName = "${userFirstName}"
		);
	}
}