<definition>
	<command name="showAdvancedSearch">
		<if>
			<condition function="IsElementPresent" locator1="CPUsersandorganizationsAssignmembers#BASIC_SEARCH_ADVANCED" value1="Advanced" />
			<then>
				<execute function="AssertClick" locator1="CPUsersandorganizationsAssignmembers#BASIC_SEARCH_ADVANCED" value1="Advanced" />
			</then>
		</if>

		<execute function="AssertElementPresent" locator1="CPUsersandorganizationsAssignmembers#ADVANCED_SEARCH_MATCH_SELECT" />
	</command>

	<command name="showBasicSearch">
		<if>
			<condition function="IsElementPresent" locator1="CPUsersandorganizationsAssignmembers#ADVANCED_SEARCH_BASIC" value1="Basic" />
			<then>
				<execute function="AssertClick" locator1="CPUsersandorganizationsAssignmembers#ADVANCED_SEARCH_BASIC" value1="Basic" />
			</then>
		</if>

		<execute function="AssertElementPresent" locator1="CPUsersandorganizationsAssignmembers#BASIC_SEARCH_FIELD" />
	</command>
</definition>