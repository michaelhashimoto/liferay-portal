@component-name = "marketplace"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Marketplace";
	property theme.plugins.includes = "welcome-theme";
	property web.plugins.includes = "resource-importer-web";

	setUp {
		User.firstLoginPG(welcomeTheme = "welcome-theme");
	}

	tearDown {
		SitePage.selectTheme(availableThemeName = "Classic", liferayVersion = "6102");

		Site.tearDownCP();

		BlogsEntry.tearDownCP();

		BookmarksFolder.tearDownCP();

		DMDocument.tearDownCP();

		Event.tearDownCP();

		MessageboardsCategory.tearDownCP();

		WikiPage.tearDownCP();

		Page.tearDownPG();
	}

	@priority = "5"
	test MarketplaceSmoke612 {
		Marketplace.smoke();
	}

	@priority = "5"
	test MarketplaceSmoke612Sites {
		var siteName = "Site Name";
		var sitePageName = "Public Site Page";

		Page.gotoCP(portletName = "Sites");

		Site.addCP(siteName = "${siteName}", siteType = "Blank");

		Page.gotoCP(portletName = "Sites");

		SitePage.addCP(sitePageName = "${sitePageName}", sitePagePrivacy = "Public");

		Marketplace.smoke(pageType = "Site");
	}
}