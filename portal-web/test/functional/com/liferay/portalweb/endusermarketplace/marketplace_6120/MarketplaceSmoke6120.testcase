@component-name = "marketplace"
definition {
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Marketplace";

	setUp {
		User.firstLoginPG();
	}

	tearDown {
		Site.tearDownCP();

		BlogsEntry.tearDownCP();

		BookmarksFolder.tearDownCP();

		DMDocument.tearDownCP();

		Event.tearDownCP();

		MessageboardsCategory.tearDownCP();

		WikiPage.tearDownCP();

		Page.tearDownPG();
	}

	@priority = "5"
	test MarketplaceSmoke6120 {
		Marketplace.smoke();
	}

	@priority = "5"
	test MarketplaceSmoke6120Sites {
		var siteName = "Site Name";
		var sitePageName = "Public Site Page";

		Page.gotoCP(portletName = "Sites");

		Site.addCP(siteName = "${siteName}", siteType = "Blank");

		Page.gotoCP(portletName = "Sites");

		SitePage.addCP(sitePageName = "${sitePageName}", sitePagePrivacy = "Public");

		Marketplace.smoke(pageType = "Site");
	}
}