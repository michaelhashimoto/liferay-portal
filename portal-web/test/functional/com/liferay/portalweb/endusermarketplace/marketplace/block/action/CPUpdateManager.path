<html>
<head>
<title>CPUpdateManager</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">CPUpdateManager</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>CPUpdateManager</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>PORTLET_TITLE</td>
	<td>//span[@class='portlet-title-text']</td>
	<td></td>
</tr>
<tr>
	<td>SUCCESS_MESSAGE</td>
	<td>//div[@class='portlet-msg-success']</td>
	<td></td>
</tr>
<tr>
	<td>PLUGIN_NAME</td>
	<td>//td[contains(@class,'plugin')]/strong[contains(.,'${pluginName}')]</td>
	<td></td>
</tr>
<tr>
	<td>UNINSTALL</td>
	<td>//strong[contains(.,'${portletName}')]/../..//span[contains(.,'Uninstall')]</td>
	<td></td>
</tr>
<tr>
	<td>INSTALL_MORE_PLUGINS_BUTTON</td>
	<td>//input[@value='Install More Plugins']</td>
	<td></td>
</tr>
<tr>
	<td>REFRESH_BUTTON</td>
	<td>//input[@value='Refresh']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>